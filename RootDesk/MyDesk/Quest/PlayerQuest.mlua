-- 플레이어 의뢰 진행. State: 0 미수락 / 1 진행 중 / 2 완료 보고 대기. Index > Count 이면 모두 완료.
-- 진행: ShadowSystem(처치)·ShadowOwner(추출)가 OnKill / OnExtract를 부른다. 수락·보고는 의뢰 NPC 근처에서만.
@Component
script PlayerQuest extends Component

    @Sync
    property integer Index = 1
    @Sync
    property integer State = 0
    @Sync
    property integer Progress = 0

    @ExecSpace("ServerOnly")
    method void OnKill(string sourceId)
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 1 or q.kind ~= "kill" or q.target ~= sourceId then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void OnRaise(string kind)
        -- 언데드를 일으킴 (의뢰 target = skeleton / mage / revive)
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 1 or q.kind ~= "raise" or q.target ~= kind then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void OnExtract()
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 1 or q.kind ~= "extract" then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void OnReach(string markerId)
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 1 or q.kind ~= "reach" or q.target ~= markerId then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void Advance(table q)
        self.Progress = math.min(q.count, self.Progress + 1)
        if self.Progress >= q.count then
            self.State = 2
            self:NotifyQuest("목표 달성", q.title .. " — 사제 오렌에게 보고", _GameData:GetUiIcon("q_done"), self.Entity.PlayerComponent.UserId)
        end
    end

    method boolean NearQuestNpc()
        return _Util:NearNpc(self.Entity, "quest")
    end

    @ExecSpace("Server")
    method void RequestAccept(integer expectedIndex)
        -- 화면에 표시된 의뢰만 수락한다. 늦게 도착한 이전 의뢰 입력은 다음 의뢰에 적용하지 않는다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.Index ~= expectedIndex or self.State ~= 0 or not _Util:IsAlive(self.Entity) or not self:NearQuestNpc() then return end
        local q = _QuestData:Get(self.Index)
        if q == nil then return end
        self.State = 1
        self.Progress = 0
        self:NotifyAccepted(q.title, pc.UserId)
    end

    @ExecSpace("Client")
    method void NotifyAccepted(string title)
        -- 의뢰를 받은 본인에게 기기에 맞는 다음 행동을 안내한다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local shortcut = Environment:IsMobilePlatform() and "메뉴 → 의뢰" or "퀘스트 창(Q)"
        _UXFeedback:Show("새 의뢰 · " .. title, "우측 목표를 따라가세요\n" .. shortcut .. "에서 자세히 보기", _GameData:GetUiIcon("icon_quest"))
    end

    @ExecSpace("Server")
    method void RequestTurnIn(integer expectedIndex)
        -- 보고 요청도 표시된 의뢰 번호에 묶어 재전송·연속 입력을 안전하게 무시한다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.Index ~= expectedIndex or self.State ~= 2 or not self:NearQuestNpc() then return end
        self:TurnIn()
    end

    @ExecSpace("ServerOnly")
    method void TurnIn()
        -- 보상: 경험치·골드 + (룬 / 장비 / 희귀 장비)
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 2 or not _Util:IsAlive(self.Entity) then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if stats == nil or inv == nil then return end
        -- 먼저 공간을 예약할 수 있는지 확인한다. 부족하면 진행·경험치·골드 모두 그대로 둔다.
        local slots = 0
        for key, val in string.gmatch(q.reward, "(%a+):([^,]+)") do
            if key == "item" or key == "gen" or (key == "rune" and _ItemData:GetRune(val) ~= nil) then slots = slots + 1 end
        end
        if #inv.Bag + slots > inv.BagSize then
            _Util:Notify("보상 받을 가방 공간 " .. tostring(slots) .. "칸이 필요합니다. 의뢰와 보상은 보관됩니다", self.Entity.PlayerComponent.UserId)
            return
        end
        local items = {}
        local lv = stats.Level
        local skillPoints = 0
        local statPoints = 0
        for key, val in string.gmatch(q.reward, "(%a+):([^,]+)") do
            if key == "rune" and _ItemData:GetRune(val) ~= nil then table.insert(items, _ItemData:MakeRuneString(val, lv))
            elseif key == "item" then table.insert(items, val)
            elseif key == "gen" then table.insert(items, _ItemData:Generate(lv + 2, (tonumber(val) or 0) >= 3 and "boss" or "quest", 300))
            elseif key == "skp" then skillPoints = skillPoints + (tonumber(val) or 0)
            elseif key == "stp" then statPoints = statPoints + (tonumber(val) or 0) end
        end
        -- 서버의 한 번의 실행에서 전부 지급하고 의뢰를 다음 단계로 넘긴다.
        inv:PutBagItems(items)
        stats.SkillPoints = stats.SkillPoints + skillPoints
        stats.StatPoints = stats.StatPoints + statPoints
        stats:GainExp(q.exp)
        stats:AddGold(q.gold)
        local rewardText = _QuestData:RewardText(q.reward)
        _Util:Notify("보상: 경험치 " .. tostring(q.exp) .. ", 골드 " .. tostring(q.gold) .. (rewardText ~= "" and (", " .. rewardText) or ""), self.Entity.PlayerComponent.UserId)
        local icon = _GameData:GetUiIcon("q_done")
        if #items > 0 then icon = _ItemData:IconFor(items[1]) end
        self:NotifyQuest("의뢰 보상 · " .. q.title, "경험치 +" .. tostring(q.exp) .. " · 골드 +" .. tostring(q.gold) .. (rewardText ~= "" and ("\n" .. rewardText) or ""), icon, self.Entity.PlayerComponent.UserId)
        log("[PlayerQuest] 완료 " .. q.title)
        self.Index = self.Index + 1
        self.State = 0
        self.Progress = 0
    end

    @ExecSpace("Client")
    method void NotifyQuest(string title, string detail, string icon)
        -- 의뢰 보상과 완료 알림은 해당 플레이어의 화면에만 표시한다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        _UXFeedback:Show(title, detail, icon)
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        return { i = self.Index, s = self.State, p = self.Progress }
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        if d == nil then return end
        self.Index = d.i or 1
        self.State = d.s or 0
        self.Progress = d.p or 0
    end


end
