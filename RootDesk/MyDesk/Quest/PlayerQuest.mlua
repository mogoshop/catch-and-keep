-- 플레이어 의뢰 진행. State: 0 미수락 / 1 진행 중 / 2 완료 보고 대기. Index > Count 이면 모두 완료.
-- 난이도마다 진행이 따로다 (D2): Index/State/Progress는 지금 난이도의 것, 다른 난이도는 ByDiff에 둔다. 보상은 난이도 배율(difficulty.csv questRewardMul).
-- 진행: QuestSystem이 게임 이벤트(처치·정리·봉인 상자·추출·소환·도달)를 넘긴다. 수락·보고는 의뢰인(giver) NPC 근처에서만.
-- 목표 종류 (14장 §6): kill / raise / extract / reach / clear(맵 전멸) / boss·ritual(이름 있는 적) / chest(열쇠 적 → 봉인 상자)
--   gate(문지기 → 보스, 10-23): 1단계 q.gate(문지기, 맵 map1)를 쓰러뜨리면 Progress 1 · 봉인 문(WarpGate.SealGate)이 열린다 → 2단계 q.target(맵 map) 처치
-- 영구 보상(스킬·능력치 포인트·그림자 배치)은 그 난이도에서 의뢰를 끝낼 때 한 번 → 난이도마다 1회.
@Component
script PlayerQuest extends Component

    @Sync
    property integer Index = 1
    @Sync
    property integer State = 0
    @Sync
    property integer Progress = 0
    @Sync
    property integer Goal = 0                 -- clear 의뢰: 지금 맵의 몬스터 수 (0이면 데이터 count)
    property integer Diff = 0                 -- 지금 Index/State/Progress가 속한 난이도
    property table ByDiff = {}                -- "0"/"1"/"2" → { i, s, p } (지금 난이도 것은 바꿀 때·저장할 때 채운다)
    property table Sealed = {}                -- "0"/"1"/"2" → ";hollow;cave;" 그 난이도에서 처음 연 봉인 상자
    @Sync
    property string SealedNow = ";"           -- 지금 난이도에서 연 봉인 상자 (맵 배너 표시용)
    @Sync
    property integer DeployBonus = 0          -- 의뢰 영구 보상 그림자 배치 + (난이도마다 1회)
    @Sync
    property integer PoisonBonus = 0          -- 의뢰 영구 보상 독 저항 + (「독침 여왕」 난이도마다 1회)
    property integer LightBonus = 0           -- 의뢰 영구 보상 번개 저항 + (「바위 집게 왕」 난이도마다 1회, 액트 3)
    property integer FireBonus = 0            -- 의뢰 영구 보상 화염 저항 + (「유황 여왕」 난이도마다 1회, 액트 4)
    @Sync
    property string StorySeen = ";"           -- 본 이야기 카드 ";prologue;act1;end1;" (StoryCard, 캐릭터마다 한 번)
    property table Cheered = {}               -- "0"/"1"/"2" → ";1:smith;2:shop;" 그 난이도에서 들은 액트 보스 격려 (docs/design/31 §7)
    @Sync
    property string CheerNow = ";"            -- 지금 난이도에서 들은 격려 (마을 사람 머리 위 「!」를 끈다)
    @Sync
    property string ChoicePicks = ";"         -- 10-28 선택 보상: 고른 축 ";1:command;2:soul;" (다시 고를 수 없다)
    @Sync
    property string ChoiceTiers = "0,0,0"     -- 선택 보상 단계: 그 의뢰(choice:N)를 끝낸 난이도 수 (보통 1 · 악몽 2 · 지옥 3) — RefreshPermanent

    -- ───────── 진행 (QuestSystem이 부른다) ─────────

    method any Current()
        if self.State ~= 1 then return nil end
        return _QuestData:Get(self.Index)
    end

    method boolean IsTarget(string target, string sourceId)
        -- 처치 대상: 하나 또는 '|'로 여러 종류 ("gate_brother|gate_brother_shield")
        return string.find("|" .. target .. "|", "|" .. sourceId .. "|", 1, true) ~= nil
    end

    method boolean SameDifficulty(Entity map)
        -- 다른 난이도 맵에서 일어난 일은 이 난이도 의뢰에 세지 않는다
        return isvalid(map) and _GameConst:DifficultyOfMap(map.Name) == self.Diff
    end

    @ExecSpace("ServerOnly")
    method void OnKill(string sourceId, Entity map)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if q.kind == "kill" and self:IsTarget(q.target, sourceId) then self:Advance(q) end
        if q.kind == "gate" then
            if q.gate == sourceId and self.Progress < 1 then
                self.Progress = 1
                self:GateFallen(_GameData:GetStory("gate_" .. sourceId), self.Entity.PlayerComponent.UserId)
                log("[VRF] quest gate open " .. sourceId)
            elseif self.Progress >= 1 and self:IsTarget(q.target, sourceId) then
                self:Advance(q)
            end
        end
        if q.kind == "chest" and q.target == sourceId and self.Progress < 1 then
            -- 열쇠 단계: 열쇠를 지닌 적을 쓰러뜨렸다 → 봉인 상자로
            self.Progress = 1
            local info = _GameData:GetMapInfo(q.map)
            local where = info ~= nil and string.gsub(info.name, "%s*%(Lv[^%)]*%)", "") or q.map
            self:NotifyQuest(_GameData:GetMonsterName(sourceId) .. "의 열쇠", where .. " 끝방의 봉인 상자를 여세요", _GameData:GetUiIcon("icon_quest"), self.Entity.PlayerComponent.UserId)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnNamedKilled(string namedId, Entity map)
        -- 이름 있는 적 (boss · ritual 의뢰)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if (q.kind == "boss" or q.kind == "ritual") and q.target == namedId then self:Complete(q) end
    end

    @ExecSpace("ServerOnly")
    method void OnMapCleared(string mapKey, Entity map)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if q.kind == "clear" and q.target == mapKey then
            self.Progress = math.max(self.Progress, self.Goal)
            self:Complete(q)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnChestOpened(string mapKey, Entity map)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if q.kind == "chest" and q.map == mapKey and self.Progress >= 1 then self:Complete(q) end
    end

    @ExecSpace("ServerOnly")
    method void ShowClearProgress(string mapKey, integer total, integer alive)
        -- 정리 맵 안에서 1초마다: 남은 수를 진행으로 보여 준다
        local q = self:Current()
        if q == nil or q.kind ~= "clear" or q.target ~= mapKey then return end
        self.Goal = total
        self.Progress = math.max(0, total - alive)
    end

    @ExecSpace("ServerOnly")
    method void OnRaise(string kind)
        -- 언데드를 일으킴 (의뢰 target = skeleton / mage / revive)
        local q = self:Current()
        if q == nil or q.kind ~= "raise" or q.target ~= kind then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void OnExtract(string sourceId, Entity map)
        -- 혼 추출. target이 있으면 그 몬스터만, map이 있으면 그 맵(같은 난이도)에서만 센다
        local q = self:Current()
        if q == nil or q.kind ~= "extract" then return end
        local here = isvalid(map) and map.Name or "?"
        if q.target ~= "" and q.target ~= sourceId then log("[VRF] extract skip target " .. sourceId .. " @" .. here) return end
        if q.map ~= "" and (not isvalid(map) or _GameConst:BaseMapName(map.Name) ~= q.map or not self:SameDifficulty(map)) then log("[VRF] extract skip map " .. sourceId .. " @" .. here) return end
        self:Advance(q)
        log("[VRF] extract counted " .. sourceId .. " @" .. here .. " " .. tostring(self.Progress) .. "/" .. tostring(q.count))
    end

    @ExecSpace("ServerOnly")
    method void OnReach(string markerId)
        local q = self:Current()
        if q == nil or q.kind ~= "reach" or q.target ~= markerId then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void Advance(table q)
        self.Progress = math.min(q.count, self.Progress + 1)
        if self.Progress >= q.count then self:Complete(q) end
    end

    @ExecSpace("ServerOnly")
    method void Complete(table q)
        if self.State ~= 1 then return end
        self.State = 2
        self:NotifyQuest("목표 달성", q.title .. " — " .. _QuestData:GiverName(q.giver) .. "에게 보고", _GameData:GetUiIcon("q_done"), self.Entity.PlayerComponent.UserId)
        log("[VRF] quest goal " .. q.title .. " diff=" .. tostring(self.Diff))
        if q.kind == "boss" and q.target == "apostate_archbishop" then
            -- 심장의 사도를 쓰러뜨린 그 자리에서: 오렌의 마지막 → 고르의 정체·재의 왕의 부활 (10-23 사용자: 「중요한 서사라 잡고 나서 바로」)
            -- 죽는 모습(약 0.7초)과 처치 알림을 본 뒤에 카드가 오게 잠깐 기다린다
            _TimerService:SetTimerOnce(function()
                if not isvalid(self.Entity) then return end
                self:SendStory("fall")
                self:SendStory("reveal")
            end, 2.5)
        end
    end

    method boolean IsActDone(integer act)
        -- 지금 난이도에서 그 액트의 마지막 의뢰까지 보고를 마쳤다
        local last = _QuestData:LastOfAct(act)
        return last > 0 and self.Index > last and _QuestData:ActClosed(act)
    end

    method boolean ActBossDown(integer act)
        -- 지금 난이도에서 그 액트 최종 보스를 쓰러뜨렸다 (보고 전 = 마지막 의뢰 목표 달성도 포함)
        if self:IsActDone(act) then return true end
        local last = _QuestData:LastOfAct(act)
        return last > 0 and self.Index == last and self.State == 2 and _QuestData:ActClosed(act)
    end

    method string StoryStage()
        -- 이야기 단계 (docs/design/31 §5): "0" 처음 · "1"~"4" 그 장을 끝냄 · "r" 고르의 정체가 드러남 (의뢰 23 보고 뒤)
        if self:IsActDone(4) then return "4" end
        -- 심장의 사도를 쓰러뜨린 순간(목표 달성)부터 드러난 것으로 친다 — 그 자리에서 「꺼져 가는 불씨」·「행상의 정체」가 나온다 (10-23)
        local reveal = _QuestData:IndexOf("boss", "apostate_archbishop")
        if reveal > 0 and (self.Index > reveal or (self.Index == reveal and self.State == 2)) then return "r" end
        for a = 3, 1, -1 do
            if self:IsActDone(a) then return tostring(a) end
        end
        return "0"
    end

    method string StoryLine(string prefix)
        -- 단계별 문구 (story.csv prefix_<단계>). 지금 단계에 없으면 앞 단계 것을 쓴다. 없으면 ""
        local order = { "0", "1", "2", "3", "r", "4" }
        local stage = self:StoryStage()
        local at = 1
        for i, k in ipairs(order) do if k == stage then at = i end end
        for i = at, 1, -1 do
            local line = _GameData:GetStory(prefix .. "_" .. order[i])
            if line ~= "" then return line end
        end
        return ""
    end

    method boolean CheerWaiting(integer act, string kind)
        -- 그 액트 보스를 쓰러뜨린 뒤 이 마을 사람에게 아직 격려를 듣지 않았다 (격려 문구가 있는 사람만)
        if act < 1 or not self:ActBossDown(act) then return false end
        if _GameData:GetStory("cheer_" .. tostring(act) .. "_" .. kind) == "" then return false end
        return string.find(self.CheerNow, ";" .. tostring(act) .. ":" .. kind .. ";", 1, true) == nil
    end

    @ExecSpace("Server")
    method void RequestCheer(integer act, string kind)
        -- 격려를 들었다 → 「!」를 끈다
        if senderUserId ~= self.Entity.PlayerComponent.UserId or string.match(kind, "^%a+$") == nil then return end
        local key = tostring(act) .. ":" .. kind
        if string.find(self.CheerNow, ";" .. key .. ";", 1, true) ~= nil then return end
        self.CheerNow = self.CheerNow .. key .. ";"
        self.Cheered[tostring(self.Diff)] = self.CheerNow
    end

    method integer CountFor(table q)
        -- 진행 표시용 목표 수: 정리 의뢰는 맵 안에서 센 몬스터 수, 나머지는 데이터 count
        if q.kind == "clear" then return self.Goal end
        return q.count
    end

    method string GoalMap(table q)
        -- 지금 단계의 목표 맵 (보통 맵 id). chest는 열쇠 단계(map1) → 상자(map)
        if (q.kind == "chest" or q.kind == "gate") and self.Progress < 1 and q.map1 ~= "" then return q.map1 end
        return q.map
    end

    method string MapLabel(string mapId)
        -- 맵 표시 이름 (레벨 괄호 없이)
        local info = _GameData:GetMapInfo(mapId)
        if info == nil then return mapId end
        return (string.gsub(info.name, "%s*%(Lv[^%)]*%)", ""))
    end

    method string PlaceLabel(string mapId)
        -- 곁가지 던전은 어느 필드에 붙었는지 함께 (「번개 절벽 · 밀수꾼 동굴 2층」 — 10-24 팀원: 밀수꾼 동굴이 어딘지 안 나왔다)
        local label = self:MapLabel(mapId)
        local info = _GameData:GetMapInfo(mapId)
        if info ~= nil and info.kind == "side" and (info.parent or "") ~= "" then return self:MapLabel(info.parent) .. " · " .. label end
        return label
    end

    method string ZoneText(table q)
        -- 의뢰 칸의 장소 줄: 곁가지 던전 목표인데 부모 필드 이름이 없으면 앞에 붙인다
        local info = _GameData:GetMapInfo(q.map)
        if info ~= nil and info.kind == "side" and (info.parent or "") ~= "" then
            local parent = self:MapLabel(info.parent)
            if string.find(q.zone, parent, 1, true) == nil then return parent .. " · " .. q.zone end
        end
        return q.zone
    end

    method string StepZone(table q)
        -- 지금 단계의 목적지 한 곳. 열쇠 → 상자 의뢰는 「교수대 숲 · 목매단 동굴」을 함께 보여 줘서
        -- 처형인을 찾아 동굴로 먼저 가는 일이 있었다 (10-11 QA) → 단계마다 그 맵만
        if q.kind == "gate" then
            if self.Progress < 1 then return "1단계 · " .. self:PlaceLabel(self:GoalMap(q)) .. " 끝" end
            return "2단계 · " .. self:PlaceLabel(q.map)
        end
        if q.kind ~= "chest" then return self:ZoneText(q) end
        if self.Progress < 1 then return "1단계 · " .. self:PlaceLabel(self:GoalMap(q)) end
        return "2단계 · " .. self:PlaceLabel(q.map) .. " 끝방"
    end

    method string StepGoal(table q)
        -- 지금 단계의 할 일 한 줄 (열쇠 → 상자 의뢰)
        if q.kind == "gate" then
            if self.Progress >= 1 then return "봉인 해제 → " .. _GameData:GetMonsterName(q.target) .. " 처치" end
            return _GameData:GetMonsterName(q.gate) .. " 처치 → 옥좌의 봉인 풀기"
        end
        if q.kind ~= "chest" then return q.objective end
        if self.Progress >= 1 then return "열쇠 획득 → 끝방 봉인 상자를 여세요" end
        return _GameData:GetMonsterName(q.target) .. " 처치 → 열쇠 얻기"
    end

    -- ───────── 봉인 상자·열쇠 ─────────

    method boolean HasChestKey(string mapKey)
        -- 그 맵 봉인 상자의 열쇠: 이 난이도에서 chest 의뢰 1단계를 마쳤거나 의뢰를 이미 끝냈다
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            if q.kind == "chest" and q.map == mapKey then
                return self.Index > i or (self.Index == i and self.State >= 1 and self.Progress >= 1)
            end
        end
        return true
    end

    method boolean GatePassed(string gateSourceId)
        -- 그 문지기의 봉인: 이 난이도에서 gate 의뢰 1단계를 마쳤거나 의뢰를 이미 끝냈다 (WarpGate.SealGate가 본다)
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            if q.kind == "gate" and q.gate == gateSourceId then
                return self.Index > i or (self.Index == i and self.State >= 1 and self.Progress >= 1)
            end
        end
        return true
    end

    method boolean IsSealedOpened(string mapKey)
        local opened = self.Sealed[tostring(self.Diff)] or ";"
        return string.find(opened, ";" .. mapKey .. ";", 1, true) ~= nil
    end

    @ExecSpace("ServerOnly")
    method void MarkSealedOpened(string mapKey)
        if self:IsSealedOpened(mapKey) then return end
        local key = tostring(self.Diff)
        self.Sealed[key] = (self.Sealed[key] or ";") .. mapKey .. ";"
        self.SealedNow = self.Sealed[key]
    end

    -- ───────── 수락·보고 ─────────

    method boolean NearGiver(table q)
        return _Util:NearNpc(self.Entity, q.giver)
    end

    @ExecSpace("Server")
    method void RequestAccept(integer expectedIndex)
        -- 화면에 표시된 의뢰만 수락한다. 늦게 도착한 이전 의뢰 입력은 다음 의뢰에 적용하지 않는다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.Index ~= expectedIndex or self.State ~= 0 or not _Util:IsAlive(self.Entity) then return end
        local q = _QuestData:Get(self.Index)
        if q == nil or not self:NearGiver(q) then return end
        self.State = 1
        self.Progress = 0
        self.Goal = 0
        self:NotifyAccepted(q.title, pc.UserId)
    end

    @ExecSpace("Client")
    method void NotifyAccepted(string title)
        -- 의뢰 수락 알림은 띄우지 않는다 — 오른쪽 의뢰 알림 카드가 「진행」 단계로 한 번 뜬다 (10-21 사용자: 화면 UI 줄이기)
        if self.Entity ~= _UserService.LocalPlayer then return end
        log("[VRF] quest accepted " .. title)
    end

    @ExecSpace("Server")
    method void RequestTurnIn(integer expectedIndex)
        -- 보고 요청도 표시된 의뢰 번호에 묶어 재전송·연속 입력을 안전하게 무시한다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.Index ~= expectedIndex or self.State ~= 2 then return end
        local q = _QuestData:Get(self.Index)
        if q == nil or not self:NearGiver(q) then return end
        self:TurnIn()
    end

    @ExecSpace("ServerOnly")
    method void TurnIn()
        -- 보상: 경험치·골드 + (룬 / 장비 / 희귀 장비 / 스킬·능력치 포인트 / 소켓권 / 그림자 배치)
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 2 or not _Util:IsAlive(self.Entity) then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if stats == nil or inv == nil then return end
        -- 먼저 공간을 예약할 수 있는지 확인한다. 부족하면 진행·경험치·골드 모두 그대로 둔다.
        local slots = 0
        for key, val in string.gmatch(q.reward, "(%a+):([^,]+)") do
            if key == "item" or key == "gen" or (key == "rune" and _ItemData:GetRune(val) ~= nil) then slots = slots + 1 end
            if key == "runes" or key == "unique" then slots = slots + (tonumber(val) or 0) end
        end
        if #inv.Bag + slots > inv.BagSize then
            _Util:Notify("보상 받을 가방 공간 " .. tostring(slots) .. "칸이 필요합니다. 퀘스트와 보상은 보관됩니다", self.Entity.PlayerComponent.UserId)
            return
        end
        local items = {}
        local lv = stats.Level
        local skillPoints = 0
        local statPoints = 0
        local sockets = 0
        for key, val in string.gmatch(q.reward, "(%a+):([^,]+)") do
            if key == "rune" and _ItemData:GetRune(val) ~= nil then table.insert(items, _ItemData:MakeRuneString(val, lv))
            elseif key == "runes" then
                -- 그 난이도·액트 몬스터 레벨(액트 보스 ~ +4)에 맞는 룬 N개. 캐릭터 레벨을 쓰면 보통에서 높은 레벨로 의뢰를 깨 상급 룬이 나왔다 (10-20)
                local monLv = _GameConst:DepthBand(math.max(1, q.act), stats.Difficulty).max
                for i = 1, (tonumber(val) or 0) do table.insert(items, _ItemData:MakeRune(monLv)) end
            elseif key == "item" then table.insert(items, val)
            elseif key == "gen" then
                -- 발견 확률만 높여서는 희귀 보상이 보장되지 않는다. 옵션도 보장 등급에 맞춰 생성한다.
                local rare = (tonumber(val) or 0) >= 3
                table.insert(items, _ItemData:GenerateWithMinimum(lv + 2, rare and "boss" or "quest", 300, rare and 2 or 1))
            elseif key == "unique" then
                -- 유니크 장비 보장 (어디서나 나오는 유니크 중 레벨에 맞는 것, 없으면 희귀 보장).
                -- 고르는 기준은 lv − 3: PickUnique는 요구 레벨 ≤ 기준 + 3까지 고르므로 지금 바로 낄 수 있는 것만 나온다 (예전 lv + 2는 Lv40 보상에 Lv44 유니크가 나왔다)
                -- 10-28 피드백 F1 #4-A: 액트 보스 의뢰(대상에 전용 유니크가 있는 의뢰)는 그 보스 전용 풀에서 — 「여왕의 왕관을 쓰고 사막으로」.
                -- 드롭표의 「첫 처치 확정 없음」(10-13)은 그대로, 의뢰 보상 쪽만. 보고 자리 바닥에 떨궈 유니크 빛기둥을 보여 준다
                for i = 1, (tonumber(val) or 0) do
                    local u = q.target ~= "" and _ItemData:PickUnique(math.max(1, lv - 3), q.target) or nil
                    if u ~= nil then
                        local made = _ItemData:MakeUnique(u, lv + 2)
                        _LootSystem:Spawn(_Util:Pos2(self.Entity), self.Entity.PlayerComponent.UserId, "item", made, 1, _ItemData:Parse(made).rarity)
                        _Util:Banner(u.name, _GameData:GetMonsterName(q.target) .. "이(가) 남긴 것 — 발밑에 떨어졌습니다", self.Entity.PlayerComponent.UserId)
                        log("[VRF] act boss unique " .. q.target .. " → " .. u.id)
                    else
                        u = _ItemData:PickUnique(math.max(1, lv - 3), "")
                        if u ~= nil then table.insert(items, _ItemData:MakeUnique(u, lv + 2))
                        else table.insert(items, _ItemData:GenerateWithMinimum(lv + 2, "boss", 300, 2)) end
                    end
                end
            elseif key == "skp" then skillPoints = skillPoints + (tonumber(val) or 0)
            elseif key == "stp" then statPoints = statPoints + (tonumber(val) or 0)
            elseif key == "socket" then sockets = sockets + (tonumber(val) or 0) end
        end
        -- 서버의 한 번의 실행에서 전부 지급하고 의뢰를 다음 단계로 넘긴다.
        inv:PutBagItems(items)
        stats.SkillPoints = stats.SkillPoints + skillPoints
        stats.StatPoints = stats.StatPoints + statPoints
        inv.SocketTokens = inv.SocketTokens + sockets
        -- 악몽·지옥에서 다시 하는 의뢰: 경험치는 그 난이도 레벨에 맞게(QuestData:ExpFor), 골드는 difficulty.csv 배율
        local mul = _GameData:GetDifficulty(self.Diff).questRewardMul or 1
        local exp = _QuestData:ExpFor(q, self.Diff)
        local gold = math.floor(q.gold * mul)
        if exp > 0 then stats:GainExp(exp) end
        stats:AddGold(gold)
        local rewardText = _QuestData:RewardText(q.reward)
        local head = (exp > 0 and ("경험치 +" .. tostring(exp) .. " · ") or "") .. "골드 +" .. tostring(gold)
        _Util:Notify("보상: " .. head .. (rewardText ~= "" and (", " .. rewardText) or ""), self.Entity.PlayerComponent.UserId)
        local icon = _GameData:GetUiIcon("q_done")
        if #items > 0 then icon = _ItemData:IconFor(items[1]) end
        self:NotifyQuest("퀘스트 보상 · " .. q.title, head .. (rewardText ~= "" and ("\n" .. rewardText) or ""), icon, self.Entity.PlayerComponent.UserId)
        log("[PlayerQuest] 완료 " .. q.title .. " diff=" .. tostring(self.Diff))
        _GameEvents:Emit("QuestCompleted", { player = self.Entity, index = self.Index })
        -- 액트 마지막 의뢰면 장 마무리 내레이션 (docs/design/18 §3-4)
        local actEnd = _QuestData:LastOfAct(q.act) == self.Index and _QuestData:ActClosed(q.act)
        self.Index = self.Index + 1
        self.State = 0
        self.Progress = 0
        self.Goal = 0
        self:RefreshPermanent()
        if actEnd then
            self:SendStory("end" .. tostring(q.act))
            -- 장 마무리 뒤 오렌과 고르의 장면 (docs/design/31 §4) — 4장은 결말 「문 아래로」
            local scene = q.act == 4 and "scene5" or ("scene" .. tostring(q.act))
            if _GameData:GetStory(scene) ~= "" then self:SendStory(scene) end
        end
    end

    -- ───────── 이야기 카드 (StoryCard) ─────────

    method boolean HasSeenStory(string key)
        return string.find(self.StorySeen, ";" .. key .. ";", 1, true) ~= nil
    end

    @ExecSpace("ServerOnly")
    method void AddStorySeen(string key)
        if string.match(key, "^%w+$") == nil or self:HasSeenStory(key) then return end
        self.StorySeen = self.StorySeen .. key .. ";"
    end

    @ExecSpace("Server")
    method void MarkStory(string key)
        -- 클라이언트가 띄운 카드 (장 표시)를 본 것으로 남긴다
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        self:AddStorySeen(key)
    end

    @ExecSpace("ServerOnly")
    method void SendStory(string key)
        -- 서버가 정하는 카드 (시작 내레이션 · 장 마무리): 처음 한 번만
        if self:HasSeenStory(key) then return end
        self:AddStorySeen(key)
        self:ShowStory(key, self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("ServerOnly")
    method void OnLoadFinished()
        -- 새 캐릭터(첫 의뢰를 아직 받지 않음)면 시작 내레이션
        if self.Diff == 0 and self.Index == 1 and self.State == 0 then self:SendStory("prologue") end
    end

    @ExecSpace("Client")
    method void ShowStory(string key)
        if self.Entity ~= _UserService.LocalPlayer then return end
        _StoryCard:Push(key)
    end

    @ExecSpace("ServerOnly")
    method void RefreshPermanent()
        -- 영구 보상 (그림자 배치 · 독 저항): 그 보상 의뢰를 끝낸 난이도 수만큼 (보통·악몽·지옥)
        self.ByDiff[tostring(self.Diff)] = { i = self.Index, s = self.State, p = self.Progress }
        local bonus = 0
        local poison = 0
        local light = 0
        local fire = 0
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            local n = tonumber(string.match("," .. q.reward, ",deploy:(%d+)")) or 0
            local r = tonumber(string.match("," .. q.reward, ",respoison:(%d+)")) or 0
            local l = tonumber(string.match("," .. q.reward, ",reslight:(%d+)")) or 0
            local f = tonumber(string.match("," .. q.reward, ",resfire:(%d+)")) or 0
            if n > 0 or r > 0 or l > 0 or f > 0 then
                for k = 0, 2 do
                    local d = self.ByDiff[tostring(k)]
                    if d ~= nil and d.i > i then
                        bonus = bonus + n
                        poison = poison + r
                        light = light + l
                        fire = fire + f
                    end
                end
            end
        end
        -- 선택 보상 단계 (10-28 사용자: 악몽·지옥에서 같은 의뢰를 끝내면 같은 선택이 한 단계 더 강해진다)
        local tiers = { 0, 0, 0 }
        for i = 1, _QuestData:Count() do
            local slot = tonumber(string.match("," .. _QuestData:Get(i).reward, ",choice:(%d+)")) or 0
            if slot >= 1 and slot <= 3 then
                for k = 0, 2 do
                    local d = self.ByDiff[tostring(k)]
                    if d ~= nil and d.i > i then tiers[slot] = tiers[slot] + 1 end
                end
            end
        end
        self.ChoiceTiers = tostring(tiers[1]) .. "," .. tostring(tiers[2]) .. "," .. tostring(tiers[3])
        self.DeployBonus = bonus + self:ChoiceTier(3, "command")   -- 선택 보상 3차 군단 「증원」
        if self.PoisonBonus ~= poison or self.LightBonus ~= light or self.FireBonus ~= fire then
            self.PoisonBonus = poison
            self.LightBonus = light
            self.FireBonus = fire
            ---@type PlayerStats
            local stats = self.Entity:GetComponent("script.PlayerStats")
            if stats ~= nil then stats:RefreshResists() end
        end
    end

    @ExecSpace("Client")
    method void GateFallen(string lastWords)
        -- 문지기가 쓰러졌다: 마지막 말 + 봉인이 풀렸다는 알림 (따로 이야기 카드를 띄우지 않는다 — 최종전으로 가는 흐름을 끊지 않게)
        if self.Entity ~= _UserService.LocalPlayer then return end
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then cam:ShakeCamera(0.3, 0.9) end
        _UXFeedback:ShowTinted("옥좌의 봉인이 풀렸다", lastWords, _GameData:GetUiIcon("q_done"), Color(1, 0.55, 0.45, 1))
    end

    @ExecSpace("Client")
    method void NotifyQuest(string title, string detail, string icon)
        -- 의뢰 보상과 완료 알림은 해당 플레이어의 화면에만 표시한다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        _UXFeedback:ShowKind("quest", title, detail, icon)
    end

    -- ───────── 선택 보상 (10-28 사용자 확정: 다시 고르기 불가 · 악몽·지옥은 같은 선택이 한 단계 강해짐 · 이미 끝낸 캐릭터도 접속하면 고른다) ─────────

    method integer TierOfSlot(integer slot)
        -- 그 선택 보상 의뢰를 끝낸 난이도 수 (0이면 아직)
        local i = 0
        for t in string.gmatch(self.ChoiceTiers, "%d+") do
            i = i + 1
            if i == slot then return tonumber(t) or 0 end
        end
        return 0
    end

    method string PickOf(integer slot)
        return string.match(self.ChoicePicks, ";" .. tostring(slot) .. ":(%a+);") or ""
    end

    method integer ChoiceTier(integer slot, string axis)
        -- 효과 쪽에서 부른다: 그 칸에서 이 축을 골랐으면 단계(1~3), 아니면 0
        if self:PickOf(slot) ~= axis then return 0 end
        return self:TierOfSlot(slot)
    end

    method integer PendingChoice()
        -- 고를 차례인 칸 (의뢰는 끝냈는데 아직 안 고름) — 없으면 0
        for slot = 1, 3 do
            if self:TierOfSlot(slot) > 0 and self:PickOf(slot) == "" then return slot end
        end
        return 0
    end

    method table ChoiceDef(integer slot, string axis)
        -- { name, desc(단계 1 — 카드 글 칸 폭 222에 맞춰 줄을 나눈다), next(악몽·지옥), skill(아이콘) }
        local defs = {
            ["1command"] = { "해골 하나 더", "해골 전사 최대 수 +1", "악몽 +2 · 지옥 +3", "raise_skeleton" },
            ["1soul"] = { "뼛조각 하나 더", "골편 투척 +1발\n(마나 그대로)", "악몽 +2발 · 지옥 +3발", "bone_shard" },
            ["1curse"] = { "긴 저주", "모든 저주 지속 +2초", "악몽 +3초 · 지옥 +4초", "enfeeble" },
            ["2command"] = { "정예로 서는 그림자", "그림자 1기가 정예로 선다\n(공격·생명 ×1.25)", "악몽 ×1.35 · 지옥 ×1.45", "elite_promote" },
            ["2soul"] = { "미리 쥔 뼈 창", "뼈 창 1랭크를 미리 쓴다\n(Lv15 전 · 포인트 없이)", "악몽 +1레벨 · 지옥 +2레벨", "bone_spear" },
            ["2curse"] = { "이중 저주", "저주를 걸면 낙인도 함께\n(받는 피해 +10%)", "악몽 +15% · 지옥 +20%", "mark_weakness" },
            ["3command"] = { "증원", "그림자 배치 +1", "악몽 +2 · 지옥 +3", "shadow_summon" },
            ["3soul"] = { "튀는 뼛조각", "골편이 맞힌 뒤\n가까운 적에게 한 번 더 튄다", "악몽 2번 · 지옥 3번", "bone_shard" },
            ["3curse"] = { "역병의 맛", "저주 걸린 적이 죽으면\n근처 1기에게 옮는다", "악몽 2기 · 지옥 3기", "plague_curse" },
        }
        local d = defs[tostring(slot) .. axis]
        if d == nil then return nil end
        return { name = d[1], desc = d[2], next = d[3], skill = d[4] }
    end

    method string ChoiceQuestTitle(integer slot)
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            if (tonumber(string.match("," .. q.reward, ",choice:(%d+)")) or 0) == slot then return q.title end
        end
        return ""
    end

    @ExecSpace("Server")
    method void RequestChoose(integer slot, string axis)
        -- 한 번만: 이미 고른 칸은 바꾸지 않는다
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if axis ~= "command" and axis ~= "soul" and axis ~= "curse" then return end
        if self:TierOfSlot(slot) <= 0 or self:PickOf(slot) ~= "" then return end
        self.ChoicePicks = self.ChoicePicks .. tostring(slot) .. ":" .. axis .. ";"
        self:RefreshPermanent()
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then book:RefreshDigest() end
        local def = self:ChoiceDef(slot, axis)
        local flat = string.gsub(def.desc, "\n", " ")   -- 카드용 줄바꿈은 알림에선 한 줄로
        self:NotifyQuest("선택 보상 · " .. def.name, flat, _SkillData:Get(def.skill).icon, self.Entity.PlayerComponent.UserId)
        log(string.format("[VRF] choice pick slot=%d axis=%s tier=%d", slot, axis, self:TierOfSlot(slot)))
    end

    @ExecSpace("ServerOnly")
    method void SwitchDifficulty(integer diff)
        -- 난이도를 바꾸면 지금 진행을 그 난이도 칸에 두고, 새 난이도의 진행을 꺼낸다 (처음이면 1번 의뢰부터)
        if diff == self.Diff then return end
        self.ByDiff[tostring(self.Diff)] = { i = self.Index, s = self.State, p = self.Progress }
        local d = self.ByDiff[tostring(diff)]
        self.Diff = diff
        self.Index = d ~= nil and d.i or 1
        self.State = d ~= nil and d.s or 0
        self.Progress = d ~= nil and d.p or 0
        self.Goal = 0
        self.SealedNow = self.Sealed[tostring(diff)] or ";"
        self.CheerNow = self.Cheered[tostring(diff)] or ";"
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        -- 보통은 예전처럼 i/s/p, 악몽·지옥은 "i,s,p" 문자열 d1/d2 (빈 표는 JSON으로 못 만들어서 문자열로)
        -- v = 의뢰 목록 판 (2 = 10-10 액트 1 개편). sc0~2 = 난이도별 처음 연 봉인 상자
        self.ByDiff[tostring(self.Diff)] = { i = self.Index, s = self.State, p = self.Progress }
        local n = self.ByDiff["0"] or { i = 1, s = 0, p = 0 }
        local out = { i = n.i, s = n.s, p = n.p, v = 2 }
        for k = 1, 2 do
            local d = self.ByDiff[tostring(k)]
            if d ~= nil then out["d" .. tostring(k)] = tostring(d.i) .. "," .. tostring(d.s) .. "," .. tostring(d.p) end
        end
        for k = 0, 2 do
            local sc = self.Sealed[tostring(k)]
            if sc ~= nil and sc ~= ";" then out["sc" .. tostring(k)] = sc end
        end
        if self.StorySeen ~= ";" then out.st = self.StorySeen end
        if self.ChoicePicks ~= ";" then out.cp = self.ChoicePicks end
        self.Cheered[tostring(self.Diff)] = self.CheerNow
        for k = 0, 2 do
            local ch = self.Cheered[tostring(k)]
            if ch ~= nil and ch ~= ";" then out["ch" .. tostring(k)] = ch end
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        -- 능력치(난이도)가 먼저 불러와진 뒤에 온다 (PlayerSave.Sections 순서) → 지금 난이도의 진행을 꺼낸다
        if d == nil then return end
        -- 예전 의뢰 목록(v 없음)의 진행 중 수치는 새 목표와 맞지 않으므로 그 의뢰를 처음부터 (수락·완료 상태는 그대로)
        local fresh = d.v ~= 2
        local function entry(i, st, p)
            if fresh and st == 1 then p = 0 end
            return { i = i, s = st, p = p }
        end
        self.ByDiff = { ["0"] = entry(d.i or 1, d.s or 0, d.p or 0) }
        for k = 1, 2 do
            local raw = d["d" .. tostring(k)]
            if type(raw) == "string" then
                local i, st, p = string.match(raw, "^(%d+),(%d+),(%d+)$")
                if i ~= nil then self.ByDiff[tostring(k)] = entry(tonumber(i), tonumber(st), tonumber(p)) end
            end
        end
        self.StorySeen = type(d.st) == "string" and d.st or ";"
        self.ChoicePicks = type(d.cp) == "string" and d.cp or ";"
        self.Cheered = {}
        for k = 0, 2 do
            local ch = d["ch" .. tostring(k)]
            if type(ch) == "string" then self.Cheered[tostring(k)] = ch end
        end
        self.Sealed = {}
        for k = 0, 2 do
            local sc = d["sc" .. tostring(k)]
            if type(sc) == "string" then self.Sealed[tostring(k)] = sc end
        end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local diff = stats ~= nil and stats.Difficulty or 0
        local cur = self.ByDiff[tostring(diff)]
        self.Diff = diff
        self.Index = cur ~= nil and cur.i or 1
        self.State = cur ~= nil and cur.s or 0
        self.Progress = cur ~= nil and cur.p or 0
        self.Goal = 0
        self.SealedNow = self.Sealed[tostring(diff)] or ";"
        self.CheerNow = self.Cheered[tostring(diff)] or ";"
        self:RefreshPermanent()
    end

end
