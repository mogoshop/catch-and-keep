-- 플레이어 의뢰 진행. State: 0 미수락 / 1 진행 중 / 2 완료 보고 대기. Index > Count 이면 모두 완료.
-- 난이도마다 진행이 따로다 (D2): Index/State/Progress는 지금 난이도의 것, 다른 난이도는 ByDiff에 둔다. 보상은 난이도 배율(difficulty.csv questRewardMul).
-- 진행: QuestSystem이 게임 이벤트(처치·정리·봉인 상자·추출·소환·도달)를 넘긴다. 수락·보고는 의뢰인(giver) NPC 근처에서만.
-- 목표 종류 (14장 §6): kill / raise / extract / reach / clear(맵 전멸) / boss·ritual(이름 있는 적) / chest(열쇠 적 → 봉인 상자)
-- 영구 보상(스킬·능력치 포인트·그림자 배치)은 그 난이도에서 의뢰를 끝낼 때 한 번 → 난이도마다 1회.
@Component
script PlayerQuest extends Component

    @Sync
    property integer Index = 1
    @Sync
    property integer State = 0
    @Sync
    property integer Progress = 0
    @Sync
    property integer Goal = 0                 -- clear 의뢰: 지금 맵의 몬스터 수 (0이면 데이터 count)
    property integer Diff = 0                 -- 지금 Index/State/Progress가 속한 난이도
    property table ByDiff = {}                -- "0"/"1"/"2" → { i, s, p } (지금 난이도 것은 바꿀 때·저장할 때 채운다)
    property table Sealed = {}                -- "0"/"1"/"2" → ";hollow;cave;" 그 난이도에서 처음 연 봉인 상자
    @Sync
    property string SealedNow = ";"           -- 지금 난이도에서 연 봉인 상자 (맵 배너 표시용)
    @Sync
    property integer DeployBonus = 0          -- 의뢰 영구 보상 그림자 배치 + (난이도마다 1회)
    @Sync
    property integer PoisonBonus = 0          -- 의뢰 영구 보상 독 저항 + (「독침 여왕」 난이도마다 1회)

    -- ───────── 진행 (QuestSystem이 부른다) ─────────

    method any Current()
        if self.State ~= 1 then return nil end
        return _QuestData:Get(self.Index)
    end

    method boolean SameDifficulty(Entity map)
        -- 다른 난이도 맵에서 일어난 일은 이 난이도 의뢰에 세지 않는다
        return isvalid(map) and _GameConst:DifficultyOfMap(map.Name) == self.Diff
    end

    @ExecSpace("ServerOnly")
    method void OnKill(string sourceId, Entity map)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if q.kind == "kill" and q.target == sourceId then self:Advance(q) end
        if q.kind == "chest" and q.target == sourceId and self.Progress < 1 then
            -- 열쇠 단계: 열쇠를 지닌 적을 쓰러뜨렸다 → 봉인 상자로
            self.Progress = 1
            local info = _GameData:GetMapInfo(q.map)
            local where = info ~= nil and string.gsub(info.name, "%s*%(Lv[^%)]*%)", "") or q.map
            self:NotifyQuest(_GameData:GetMonsterName(sourceId) .. "의 열쇠", where .. " 끝방의 봉인 상자를 여세요", _GameData:GetUiIcon("icon_quest"), self.Entity.PlayerComponent.UserId)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnNamedKilled(string namedId, Entity map)
        -- 이름 있는 적 (boss · ritual 의뢰)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if (q.kind == "boss" or q.kind == "ritual") and q.target == namedId then self:Complete(q) end
    end

    @ExecSpace("ServerOnly")
    method void OnMapCleared(string mapKey, Entity map)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if q.kind == "clear" and q.target == mapKey then
            self.Progress = math.max(self.Progress, self.Goal)
            self:Complete(q)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnChestOpened(string mapKey, Entity map)
        local q = self:Current()
        if q == nil or not self:SameDifficulty(map) then return end
        if q.kind == "chest" and q.map == mapKey and self.Progress >= 1 then self:Complete(q) end
    end

    @ExecSpace("ServerOnly")
    method void ShowClearProgress(string mapKey, integer total, integer alive)
        -- 정리 맵 안에서 1초마다: 남은 수를 진행으로 보여 준다
        local q = self:Current()
        if q == nil or q.kind ~= "clear" or q.target ~= mapKey then return end
        self.Goal = total
        self.Progress = math.max(0, total - alive)
    end

    @ExecSpace("ServerOnly")
    method void OnRaise(string kind)
        -- 언데드를 일으킴 (의뢰 target = skeleton / mage / revive)
        local q = self:Current()
        if q == nil or q.kind ~= "raise" or q.target ~= kind then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void OnExtract(string sourceId, Entity map)
        -- 혼 추출. target이 있으면 그 몬스터만, map이 있으면 그 맵(같은 난이도)에서만 센다
        local q = self:Current()
        if q == nil or q.kind ~= "extract" then return end
        local here = isvalid(map) and map.Name or "?"
        if q.target ~= "" and q.target ~= sourceId then log("[VRF] extract skip target " .. sourceId .. " @" .. here) return end
        if q.map ~= "" and (not isvalid(map) or _GameConst:BaseMapName(map.Name) ~= q.map or not self:SameDifficulty(map)) then log("[VRF] extract skip map " .. sourceId .. " @" .. here) return end
        self:Advance(q)
        log("[VRF] extract counted " .. sourceId .. " @" .. here .. " " .. tostring(self.Progress) .. "/" .. tostring(q.count))
    end

    @ExecSpace("ServerOnly")
    method void OnReach(string markerId)
        local q = self:Current()
        if q == nil or q.kind ~= "reach" or q.target ~= markerId then return end
        self:Advance(q)
    end

    @ExecSpace("ServerOnly")
    method void Advance(table q)
        self.Progress = math.min(q.count, self.Progress + 1)
        if self.Progress >= q.count then self:Complete(q) end
    end

    @ExecSpace("ServerOnly")
    method void Complete(table q)
        if self.State ~= 1 then return end
        self.State = 2
        self:NotifyQuest("목표 달성", q.title .. " — " .. _QuestData:GiverName(q.giver) .. "에게 보고", _GameData:GetUiIcon("q_done"), self.Entity.PlayerComponent.UserId)
        log("[VRF] quest goal " .. q.title .. " diff=" .. tostring(self.Diff))
    end

    method boolean IsActDone(integer act)
        -- 지금 난이도에서 그 액트의 마지막 의뢰까지 보고를 마쳤다
        local last = _QuestData:LastOfAct(act)
        return last > 0 and self.Index > last
    end

    method integer CountFor(table q)
        -- 진행 표시용 목표 수: 정리 의뢰는 맵 안에서 센 몬스터 수, 나머지는 데이터 count
        if q.kind == "clear" then return self.Goal end
        return q.count
    end

    method string GoalMap(table q)
        -- 지금 단계의 목표 맵 (보통 맵 id). chest는 열쇠 단계(map1) → 상자(map)
        if q.kind == "chest" and self.Progress < 1 and q.map1 ~= "" then return q.map1 end
        return q.map
    end

    -- ───────── 봉인 상자·열쇠 ─────────

    method boolean HasChestKey(string mapKey)
        -- 그 맵 봉인 상자의 열쇠: 이 난이도에서 chest 의뢰 1단계를 마쳤거나 의뢰를 이미 끝냈다
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            if q.kind == "chest" and q.map == mapKey then
                return self.Index > i or (self.Index == i and self.State >= 1 and self.Progress >= 1)
            end
        end
        return true
    end

    method boolean IsSealedOpened(string mapKey)
        local opened = self.Sealed[tostring(self.Diff)] or ";"
        return string.find(opened, ";" .. mapKey .. ";", 1, true) ~= nil
    end

    @ExecSpace("ServerOnly")
    method void MarkSealedOpened(string mapKey)
        if self:IsSealedOpened(mapKey) then return end
        local key = tostring(self.Diff)
        self.Sealed[key] = (self.Sealed[key] or ";") .. mapKey .. ";"
        self.SealedNow = self.Sealed[key]
    end

    -- ───────── 수락·보고 ─────────

    method boolean NearGiver(table q)
        return _Util:NearNpc(self.Entity, q.giver)
    end

    @ExecSpace("Server")
    method void RequestAccept(integer expectedIndex)
        -- 화면에 표시된 의뢰만 수락한다. 늦게 도착한 이전 의뢰 입력은 다음 의뢰에 적용하지 않는다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.Index ~= expectedIndex or self.State ~= 0 or not _Util:IsAlive(self.Entity) then return end
        local q = _QuestData:Get(self.Index)
        if q == nil or not self:NearGiver(q) then return end
        self.State = 1
        self.Progress = 0
        self.Goal = 0
        self:NotifyAccepted(q.title, pc.UserId)
    end

    @ExecSpace("Client")
    method void NotifyAccepted(string title)
        -- 의뢰를 받은 본인에게 기기에 맞는 다음 행동을 안내한다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local shortcut = Environment:IsMobilePlatform() and "메뉴 → 의뢰" or "퀘스트 창(Q)"
        _UXFeedback:Show("새 의뢰 · " .. title, "우측 목표를 따라가세요\n" .. shortcut .. "에서 자세히 보기", _GameData:GetUiIcon("icon_quest"))
    end

    @ExecSpace("Server")
    method void RequestTurnIn(integer expectedIndex)
        -- 보고 요청도 표시된 의뢰 번호에 묶어 재전송·연속 입력을 안전하게 무시한다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.Index ~= expectedIndex or self.State ~= 2 then return end
        local q = _QuestData:Get(self.Index)
        if q == nil or not self:NearGiver(q) then return end
        self:TurnIn()
    end

    @ExecSpace("ServerOnly")
    method void TurnIn()
        -- 보상: 경험치·골드 + (룬 / 장비 / 희귀 장비 / 스킬·능력치 포인트 / 소켓권 / 그림자 배치)
        local q = _QuestData:Get(self.Index)
        if q == nil or self.State ~= 2 or not _Util:IsAlive(self.Entity) then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if stats == nil or inv == nil then return end
        -- 먼저 공간을 예약할 수 있는지 확인한다. 부족하면 진행·경험치·골드 모두 그대로 둔다.
        local slots = 0
        for key, val in string.gmatch(q.reward, "(%a+):([^,]+)") do
            if key == "item" or key == "gen" or (key == "rune" and _ItemData:GetRune(val) ~= nil) then slots = slots + 1 end
            if key == "runes" or key == "unique" then slots = slots + (tonumber(val) or 0) end
        end
        if #inv.Bag + slots > inv.BagSize then
            _Util:Notify("보상 받을 가방 공간 " .. tostring(slots) .. "칸이 필요합니다. 의뢰와 보상은 보관됩니다", self.Entity.PlayerComponent.UserId)
            return
        end
        local items = {}
        local lv = stats.Level
        local skillPoints = 0
        local statPoints = 0
        local sockets = 0
        for key, val in string.gmatch(q.reward, "(%a+):([^,]+)") do
            if key == "rune" and _ItemData:GetRune(val) ~= nil then table.insert(items, _ItemData:MakeRuneString(val, lv))
            elseif key == "runes" then
                -- 그 난이도 몬스터 레벨에 맞는 룬 N개
                local monLv = lv + 2
                for i = 1, (tonumber(val) or 0) do table.insert(items, _ItemData:MakeRune(monLv)) end
            elseif key == "item" then table.insert(items, val)
            elseif key == "gen" then
                -- 발견 확률만 높여서는 희귀 보상이 보장되지 않는다. 옵션도 보장 등급에 맞춰 생성한다.
                local rare = (tonumber(val) or 0) >= 3
                table.insert(items, _ItemData:GenerateWithMinimum(lv + 2, rare and "boss" or "quest", 300, rare and 2 or 1))
            elseif key == "unique" then
                -- 유니크 장비 보장 (어디서나 나오는 유니크 중 레벨에 맞는 것, 없으면 희귀 보장)
                for i = 1, (tonumber(val) or 0) do
                    local u = _ItemData:PickUnique(lv + 2, "")
                    if u ~= nil then table.insert(items, _ItemData:MakeUnique(u, lv + 2))
                    else table.insert(items, _ItemData:GenerateWithMinimum(lv + 2, "boss", 300, 2)) end
                end
            elseif key == "skp" then skillPoints = skillPoints + (tonumber(val) or 0)
            elseif key == "stp" then statPoints = statPoints + (tonumber(val) or 0)
            elseif key == "socket" then sockets = sockets + (tonumber(val) or 0) end
        end
        -- 서버의 한 번의 실행에서 전부 지급하고 의뢰를 다음 단계로 넘긴다.
        inv:PutBagItems(items)
        stats.SkillPoints = stats.SkillPoints + skillPoints
        stats.StatPoints = stats.StatPoints + statPoints
        inv.SocketTokens = inv.SocketTokens + sockets
        -- 악몽·지옥에서 다시 하는 의뢰는 그 난이도 레벨에 맞게 경험치·골드를 늘린다
        local mul = _GameData:GetDifficulty(self.Diff).questRewardMul or 1
        local exp = math.floor(q.exp * mul)
        local gold = math.floor(q.gold * mul)
        if exp > 0 then stats:GainExp(exp) end
        stats:AddGold(gold)
        local rewardText = _QuestData:RewardText(q.reward)
        local head = (exp > 0 and ("경험치 +" .. tostring(exp) .. " · ") or "") .. "골드 +" .. tostring(gold)
        _Util:Notify("보상: " .. head .. (rewardText ~= "" and (", " .. rewardText) or ""), self.Entity.PlayerComponent.UserId)
        local icon = _GameData:GetUiIcon("q_done")
        if #items > 0 then icon = _ItemData:IconFor(items[1]) end
        self:NotifyQuest("의뢰 보상 · " .. q.title, head .. (rewardText ~= "" and ("\n" .. rewardText) or ""), icon, self.Entity.PlayerComponent.UserId)
        log("[PlayerQuest] 완료 " .. q.title .. " diff=" .. tostring(self.Diff))
        _GameEvents:Emit("QuestCompleted", { player = self.Entity, index = self.Index })
        self.Index = self.Index + 1
        self.State = 0
        self.Progress = 0
        self.Goal = 0
        self:RefreshPermanent()
    end

    @ExecSpace("ServerOnly")
    method void RefreshPermanent()
        -- 영구 보상 (그림자 배치 · 독 저항): 그 보상 의뢰를 끝낸 난이도 수만큼 (보통·악몽·지옥)
        self.ByDiff[tostring(self.Diff)] = { i = self.Index, s = self.State, p = self.Progress }
        local bonus = 0
        local poison = 0
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            local n = tonumber(string.match("," .. q.reward, ",deploy:(%d+)")) or 0
            local r = tonumber(string.match("," .. q.reward, ",respoison:(%d+)")) or 0
            if n > 0 or r > 0 then
                for k = 0, 2 do
                    local d = self.ByDiff[tostring(k)]
                    if d ~= nil and d.i > i then
                        bonus = bonus + n
                        poison = poison + r
                    end
                end
            end
        end
        self.DeployBonus = bonus
        if self.PoisonBonus ~= poison then
            self.PoisonBonus = poison
            ---@type PlayerStats
            local stats = self.Entity:GetComponent("script.PlayerStats")
            if stats ~= nil then stats:RefreshResists() end
        end
    end

    @ExecSpace("Client")
    method void NotifyQuest(string title, string detail, string icon)
        -- 의뢰 보상과 완료 알림은 해당 플레이어의 화면에만 표시한다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        _UXFeedback:Show(title, detail, icon)
    end

    @ExecSpace("ServerOnly")
    method void SwitchDifficulty(integer diff)
        -- 난이도를 바꾸면 지금 진행을 그 난이도 칸에 두고, 새 난이도의 진행을 꺼낸다 (처음이면 1번 의뢰부터)
        if diff == self.Diff then return end
        self.ByDiff[tostring(self.Diff)] = { i = self.Index, s = self.State, p = self.Progress }
        local d = self.ByDiff[tostring(diff)]
        self.Diff = diff
        self.Index = d ~= nil and d.i or 1
        self.State = d ~= nil and d.s or 0
        self.Progress = d ~= nil and d.p or 0
        self.Goal = 0
        self.SealedNow = self.Sealed[tostring(diff)] or ";"
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        -- 보통은 예전처럼 i/s/p, 악몽·지옥은 "i,s,p" 문자열 d1/d2 (빈 표는 JSON으로 못 만들어서 문자열로)
        -- v = 의뢰 목록 판 (2 = 10-10 액트 1 개편). sc0~2 = 난이도별 처음 연 봉인 상자
        self.ByDiff[tostring(self.Diff)] = { i = self.Index, s = self.State, p = self.Progress }
        local n = self.ByDiff["0"] or { i = 1, s = 0, p = 0 }
        local out = { i = n.i, s = n.s, p = n.p, v = 2 }
        for k = 1, 2 do
            local d = self.ByDiff[tostring(k)]
            if d ~= nil then out["d" .. tostring(k)] = tostring(d.i) .. "," .. tostring(d.s) .. "," .. tostring(d.p) end
        end
        for k = 0, 2 do
            local sc = self.Sealed[tostring(k)]
            if sc ~= nil and sc ~= ";" then out["sc" .. tostring(k)] = sc end
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        -- 능력치(난이도)가 먼저 불러와진 뒤에 온다 (PlayerSave.Sections 순서) → 지금 난이도의 진행을 꺼낸다
        if d == nil then return end
        -- 예전 의뢰 목록(v 없음)의 진행 중 수치는 새 목표와 맞지 않으므로 그 의뢰를 처음부터 (수락·완료 상태는 그대로)
        local fresh = d.v ~= 2
        local function entry(i, st, p)
            if fresh and st == 1 then p = 0 end
            return { i = i, s = st, p = p }
        end
        self.ByDiff = { ["0"] = entry(d.i or 1, d.s or 0, d.p or 0) }
        for k = 1, 2 do
            local raw = d["d" .. tostring(k)]
            if type(raw) == "string" then
                local i, st, p = string.match(raw, "^(%d+),(%d+),(%d+)$")
                if i ~= nil then self.ByDiff[tostring(k)] = entry(tonumber(i), tonumber(st), tonumber(p)) end
            end
        end
        self.Sealed = {}
        for k = 0, 2 do
            local sc = d["sc" .. tostring(k)]
            if type(sc) == "string" then self.Sealed[tostring(k)] = sc end
        end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local diff = stats ~= nil and stats.Difficulty or 0
        local cur = self.ByDiff[tostring(diff)]
        self.Diff = diff
        self.Index = cur ~= nil and cur.i or 1
        self.State = cur ~= nil and cur.s or 0
        self.Progress = cur ~= nil and cur.p or 0
        self.Goal = 0
        self.SealedNow = self.Sealed[tostring(diff)] or ";"
        self:RefreshPermanent()
    end

end
