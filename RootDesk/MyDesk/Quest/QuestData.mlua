-- 의뢰 목록 (순서대로 진행). kind: kill(원본 몬스터 처치) / extract(그림자 추출 성공)
@Logic
script QuestData extends Logic

    property table List = {}
    property boolean Built = false

    method void Build()
        if self.Built then return end
        self.Built = true
        self.List = {}
        self:Add("들쥐 소탕", "사냥터의 잿빛 들쥐 8마리를 처치하라.", "kill", "mob-568", 8, 150, 100, "")
        self:Add("첫 번째 그림자", "쓰러뜨린 적의 혼에서 그림자 3기를 추출하라. (E 키)", "extract", "", 3, 200, 150, "rune")
        self:Add("이끼 망령 정화", "이끼 망령 8마리를 처치하라.", "kill", "mob-1955", 8, 300, 200, "")
        self:Add("파수꾼의 무덤", "무덤 파수꾼 4마리를 처치하라.", "kill", "mob-1209", 4, 500, 300, "item")
        self:Add("부패한 버섯왕", "사냥터 깊은 곳의 부패한 버섯왕을 쓰러뜨려라.", "kill", "mob-6130101", 1, 1500, 1000, "rare")
    end

    method void Add(string title, string desc, string kind, string target, integer count, integer exp, integer gold, string reward)
        table.insert(self.List, { title = title, desc = desc, kind = kind, target = target, count = count, exp = exp, gold = gold, reward = reward })
    end

    method any Get(integer index)
        self:Build()
        return self.List[index]
    end

    method integer Count()
        self:Build()
        return #self.List
    end

end
