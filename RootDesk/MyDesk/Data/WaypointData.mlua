-- 자동 생성 파일: tools/gen_data.cjs 가 data/waypoints.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 웨이포인트 목록 (보통 난이도 맵 기준. 난이도 맵은 _GameConst:MapFor)
@Logic
script WaypointData extends Logic

    property boolean Built = false
    property table List = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { id = "camp", name = "잿불 야영지", map = "town", act = 1, x = -5, y = 1.7 })
        table.insert(self.List, { id = "marsh", name = "썩은 갈대 늪", map = "rotmarsh", act = 1, x = -16, y = -7.3 })
        table.insert(self.List, { id = "execution", name = "무너진 형장", map = "execution", act = 1, x = -20, y = 4.7 })
        table.insert(self.List, { id = "gallows", name = "교수대 숲", map = "gallows", act = 1, x = -20, y = -9.3 })
        table.insert(self.List, { id = "crypt1", name = "지하 납골당 1층", map = "crypt1", act = 1, x = -14, y = -7.3 })
        table.insert(self.List, { id = "crypt3", name = "지하 납골당 3층", map = "crypt3", act = 1, x = -15.6, y = 0 })
        table.insert(self.List, { id = "oasis", name = "오아시스 시장", map = "oasis", act = 2, x = -5, y = 1.7 })
        table.insert(self.List, { id = "canyon", name = "메마른 협곡", map = "canyon", act = 2, x = -20, y = 2.7 })
        table.insert(self.List, { id = "stormwaste", name = "바람 무덤 사막", map = "stormwaste", act = 2, x = -20, y = 2.7 })
        table.insert(self.List, { id = "sunkenroad", name = "가라앉은 대로", map = "sunkenroad", act = 2, x = -20, y = 2.7 })
        table.insert(self.List, { id = "temple1", name = "잊힌 사원 1층", map = "temple1", act = 2, x = -14, y = -7.3 })
        table.insert(self.List, { id = "temple3", name = "잊힌 사원 3층", map = "temple3", act = 2, x = -15.6, y = 0 })
    end

    method any Get(string id)
        self:Ensure()
        for _, w in ipairs(self.List) do if w.id == id then return w end end
        return nil
    end

    method table GetList()
        self:Ensure()
        return self.List
    end

    method table ListOfAct(integer act)
        -- 그 액트의 웨이포인트 (창의 액트 탭)
        self:Ensure()
        local out = {}
        for _, w in ipairs(self.List) do if w.act == act then table.insert(out, w) end end
        return out
    end

end
