-- 자동 생성 파일: tools/gen_data.cjs 가 data/waypoints.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 웨이포인트 목록 (보통 난이도 맵 기준. 난이도 맵은 _GameConst:MapFor)
@Logic
script WaypointData extends Logic

    property boolean Built = false
    property table List = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { id = "camp", name = "잿불 야영지", map = "town", x = -5, y = 1.7 })
        table.insert(self.List, { id = "marsh", name = "썩은 갈대 늪", map = "rotmarsh", x = -16, y = -7.3 })
        table.insert(self.List, { id = "execution", name = "무너진 형장", map = "execution", x = -20, y = 4.7 })
        table.insert(self.List, { id = "gallows", name = "교수대 숲", map = "gallows", x = -20, y = -9.3 })
        table.insert(self.List, { id = "crypt1", name = "지하 납골당 1층", map = "crypt1", x = -14, y = -7.3 })
        table.insert(self.List, { id = "crypt3", name = "지하 납골당 3층", map = "crypt3", x = -15.6, y = 0 })
    end

    method any Get(string id)
        self:Ensure()
        for _, w in ipairs(self.List) do if w.id == id then return w end end
        return nil
    end

    method table GetList()
        self:Ensure()
        return self.List
    end

end
