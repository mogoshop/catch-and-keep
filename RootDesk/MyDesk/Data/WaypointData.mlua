-- 자동 생성 파일: tools/gen_data.cjs 가 data/waypoints.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 웨이포인트 목록 (보통 난이도 맵 기준. 난이도 맵은 _GameConst:MapFor)
@Logic
script WaypointData extends Logic

    property boolean Built = false
    property table List = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { id = "camp", name = "잿불 야영지", map = "town", act = 1, x = -5.5, y = 1.2 })
        table.insert(self.List, { id = "wasteland", name = "피 묻은 황무지", map = "wasteland", act = 1, x = 2.5, y = -4.1 })
        table.insert(self.List, { id = "marsh", name = "썩은 갈대 늪", map = "rotmarsh", act = 1, x = -2.5, y = 5.2 })
        table.insert(self.List, { id = "execution", name = "무너진 형장", map = "execution", act = 1, x = -5.5, y = -4.8 })
        table.insert(self.List, { id = "gallows", name = "교수대 숲", map = "gallows", act = 1, x = -7.5, y = -4.8 })
        table.insert(self.List, { id = "crypt1", name = "지하 납골당 1층", map = "crypt1", act = 1, x = 2.5, y = -1.8 })
        table.insert(self.List, { id = "crypt3", name = "지하 납골당 3층", map = "crypt3", act = 1, x = -24.5, y = -2.8 })
        table.insert(self.List, { id = "oasis", name = "오아시스 시장", map = "oasis", act = 2, x = -5.5, y = 1.2 })
        table.insert(self.List, { id = "dunes", name = "뜨거운 모래 언덕", map = "dunes", act = 2, x = 1.5, y = 0.2 })
        table.insert(self.List, { id = "canyon", name = "메마른 협곡", map = "canyon", act = 2, x = -1.5, y = 0.2 })
        table.insert(self.List, { id = "stormwaste", name = "바람 무덤 사막", map = "stormwaste", act = 2, x = 1.5, y = -1.8 })
        table.insert(self.List, { id = "sunkenroad", name = "가라앉은 대로", map = "sunkenroad", act = 2, x = 3.5, y = -3.8 })
        table.insert(self.List, { id = "temple1", name = "잊힌 사원 1층", map = "temple1", act = 2, x = -6.5, y = 0.2 })
        table.insert(self.List, { id = "temple3", name = "잊힌 사원 3층", map = "temple3", act = 2, x = -25.5, y = 2.2 })
        table.insert(self.List, { id = "harbor", name = "소금바람 항구", map = "harbor", act = 3, x = -5.5, y = 1.2 })
        table.insert(self.List, { id = "saltflat", name = "소금 갯벌", map = "saltflat", act = 3, x = -2.5, y = -1.8 })
        table.insert(self.List, { id = "wreckcoast", name = "난파선 해안", map = "wreckcoast", act = 3, x = 1.5, y = 0.2 })
        table.insert(self.List, { id = "stormcliff", name = "번개 절벽", map = "stormcliff", act = 3, x = -1.5, y = 2.2 })
        table.insert(self.List, { id = "drownedvillage", name = "가라앉은 어촌", map = "drownedvillage", act = 3, x = 1.5, y = 0.2 })
        table.insert(self.List, { id = "lighthouse1", name = "폭풍 등대 1층", map = "lighthouse1", act = 3, x = -2.5, y = 1.2 })
        table.insert(self.List, { id = "lighthouse3", name = "폭풍 등대 3층", map = "lighthouse3", act = 3, x = 24.5, y = 2.2 })
        table.insert(self.List, { id = "outpost", name = "마지막 초소", map = "outpost", act = 4, x = -5.5, y = 1.2 })
        table.insert(self.List, { id = "embercanyon", name = "불탄 협곡", map = "embercanyon", act = 4, x = -0.5, y = 2.2 })
        table.insert(self.List, { id = "demonroad", name = "악마의 행군로", map = "demonroad", act = 4, x = 3.5, y = -1.8 })
        table.insert(self.List, { id = "sulfurmarsh", name = "유황 늪", map = "sulfurmarsh", act = 4, x = 1.5, y = 4.2 })
        table.insert(self.List, { id = "burningkeep", name = "불타는 성채 외곽", map = "burningkeep", act = 4, x = 3.5, y = -3.8 })
        table.insert(self.List, { id = "abyssgate1", name = "심연의 문 1층", map = "abyssgate1", act = 4, x = 6.5, y = 0.2 })
        table.insert(self.List, { id = "abyssgate3", name = "심연의 문 3층", map = "abyssgate3", act = 4, x = 24.5, y = -2.8 })
        table.insert(self.List, { id = "heartbridge", name = "심장의 다리", map = "heartbridge", act = 4, x = -29.5, y = -3.8 })
    end

    method any Get(string id)
        self:Ensure()
        for _, w in ipairs(self.List) do if w.id == id then return w end end
        return nil
    end

    method table GetList()
        self:Ensure()
        return self.List
    end

    method table ListOfAct(integer act)
        -- 그 액트의 웨이포인트 (창의 액트 탭)
        self:Ensure()
        local out = {}
        for _, w in ipairs(self.List) do if w.act == act then table.insert(out, w) end end
        return out
    end

end
