-- 자동 생성 파일: tools/gen_data.cjs 가 data/dailies.csv·achievements.csv·monsters.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 일지 데이터: 일일 의뢰 후보, 업적, 도감 몬스터 순서
@Logic
script JournalData extends Logic

    property boolean Built = false
    property table Dailies = {}
    property table Achievements = {}
    property table Monsters = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.Dailies = {}
        self.Achievements = {}
        self.Monsters = {}
        table.insert(self.Dailies, { id = "d_kill30", name = "몬스터 30마리 처치", kind = "kill", target = "", count = 30, gold = 120, expPct = 25 })
        table.insert(self.Dailies, { id = "d_kill60", name = "몬스터 60마리 처치", kind = "kill", target = "", count = 60, gold = 220, expPct = 40 })
        table.insert(self.Dailies, { id = "d_elite5", name = "정예·우두머리 5마리 처치", kind = "kill_elite", target = "", count = 5, gold = 180, expPct = 30 })
        table.insert(self.Dailies, { id = "d_boss1", name = "보스·고유 몬스터 처치", kind = "kill_boss", target = "", count = 1, gold = 260, expPct = 40 })
        table.insert(self.Dailies, { id = "d_capture2", name = "혼 추출 2회 성공", kind = "capture", target = "", count = 2, gold = 150, expPct = 25 })
        table.insert(self.Dailies, { id = "d_raise10", name = "해골·마법사 10번 일으키기", kind = "raise", target = "", count = 10, gold = 120, expPct = 20 })
        table.insert(self.Dailies, { id = "d_depth1", name = "심도 1개 층 정복", kind = "depth", target = "", count = 1, gold = 250, expPct = 40 })
        table.insert(self.Dailies, { id = "d_quest1", name = "의뢰 1개 완료", kind = "quest", target = "", count = 1, gold = 150, expPct = 20 })
        table.insert(self.Achievements, { id = "a_kill100", name = "망자 사냥꾼", desc = "몬스터 100마리 처치", kind = "kill", target = "", count = 100, gold = 300 })
        table.insert(self.Achievements, { id = "a_kill1000", name = "잿빛 학살자", desc = "몬스터 1000마리 처치", kind = "kill", target = "", count = 1000, gold = 2500 })
        table.insert(self.Achievements, { id = "a_capture1", name = "첫 그림자", desc = "혼 추출 첫 성공", kind = "capture", target = "", count = 1, gold = 100 })
        table.insert(self.Achievements, { id = "a_capture25", name = "그림자 수집가", desc = "혼 추출 25회 성공", kind = "capture", target = "", count = 25, gold = 1200 })
        table.insert(self.Achievements, { id = "a_species5", name = "군단의 시작", desc = "서로 다른 몬스터 5종의 그림자 포획", kind = "capture_species", target = "", count = 5, gold = 800 })
        table.insert(self.Achievements, { id = "a_raise50", name = "망자의 주인", desc = "해골·마법사 50번 일으키기", kind = "raise", target = "", count = 50, gold = 500 })
        table.insert(self.Achievements, { id = "a_level10", name = "깨어난 네크로맨서", desc = "10레벨 달성", kind = "level", target = "", count = 10, gold = 500 })
        table.insert(self.Achievements, { id = "a_level20", name = "잿빛의 군주", desc = "20레벨 달성", kind = "level", target = "", count = 20, gold = 2000 })
        table.insert(self.Achievements, { id = "a_depth5", name = "심연 하강", desc = "심도 5층 정복", kind = "depth", target = "", count = 5, gold = 1500 })
        table.insert(self.Achievements, { id = "a_depth10", name = "끝없는 아래", desc = "심도 10층 정복", kind = "depth", target = "", count = 10, gold = 4000 })
        table.insert(self.Achievements, { id = "a_elite50", name = "정예 사냥꾼", desc = "정예·우두머리 50마리 처치", kind = "kill_elite", target = "", count = 50, gold = 1200 })
        table.insert(self.Achievements, { id = "a_queen", name = "여왕의 몰락", desc = "묘지기 여왕 처치", kind = "kill_source", target = "grave_queen", count = 1, gold = 1500 })
        table.insert(self.Achievements, { id = "a_quests", name = "잿빛 변경의 해방자", desc = "잿빛 변경 의뢰 모두 완료", kind = "quest", target = "", count = 6, gold = 2000 })
        table.insert(self.Achievements, { id = "a_codex", name = "잿빛 변경 도감", desc = "잿빛 변경 몬스터 모두 처치해 도감 채우기", kind = "collection", target = "", count = 13, gold = 3000 })
        table.insert(self.Achievements, { id = "a_daily10", name = "성실한 사냥꾼", desc = "일일 의뢰 10개 완료", kind = "daily", target = "", count = 10, gold = 1000 })
        table.insert(self.Monsters, { id = "hellhound", name = "지옥견", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "graveworm", name = "무덤 구더기", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "ashendead", name = "잿빛 망자병", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "corpsecrow", name = "시체 까마귀", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "skelwarrior", name = "해골 전사", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "starvedwraith", name = "굶주린 악령", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "fallenimp", name = "타락 꼬마악마", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "rotzombie", name = "썩은 좀비", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "cultarcher", name = "광신 궁수", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "broodspider", name = "무덤 새끼거미", grade = 1, unique = false })
        table.insert(self.Monsters, { id = "headsman", name = "목 없는 처형인", grade = 2, unique = true })
        table.insert(self.Monsters, { id = "skelcaptain", name = "납골당 지휘관 바르그", grade = 2, unique = true })
        table.insert(self.Monsters, { id = "gravequeen", name = "묘지기 여왕", grade = 3, unique = true })
    end

    method table GetDailies()
        self:Ensure()
        return self.Dailies
    end

    method table GetAchievements()
        self:Ensure()
        return self.Achievements
    end

    method table GetMonsters()
        self:Ensure()
        return self.Monsters
    end

    method any GetDaily(string id)
        self:Ensure()
        for _, d in ipairs(self.Dailies) do if d.id == id then return d end end
        return nil
    end

end
