-- 자동 생성 파일: tools/gen_data.cjs 가 data/dailies.csv·achievements.csv·monsters.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 일지 데이터: 일일 의뢰 후보, 업적, 도감 몬스터 순서
@Logic
script JournalData extends Logic

    property boolean Built = false
    property table Dailies = {}
    property table Achievements = {}
    property table Monsters = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.Dailies = {}
        self.Achievements = {}
        self.Monsters = {}
        table.insert(self.Dailies, { id = "d_kill30", name = "몬스터 30마리 처치", kind = "kill", target = "", count = 30, gold = 120, expPct = 25 })
        table.insert(self.Dailies, { id = "d_kill60", name = "몬스터 60마리 처치", kind = "kill", target = "", count = 60, gold = 220, expPct = 40 })
        table.insert(self.Dailies, { id = "d_elite5", name = "정예·우두머리 5마리 처치", kind = "kill_elite", target = "", count = 5, gold = 180, expPct = 30 })
        table.insert(self.Dailies, { id = "d_boss1", name = "보스·고유 몬스터 처치", kind = "kill_boss", target = "", count = 1, gold = 260, expPct = 40 })
        table.insert(self.Dailies, { id = "d_capture2", name = "혼 추출 2회 성공", kind = "capture", target = "", count = 2, gold = 150, expPct = 25 })
        table.insert(self.Dailies, { id = "d_raise10", name = "해골·마법사 10번 일으키기", kind = "raise", target = "", count = 10, gold = 120, expPct = 20 })
        table.insert(self.Dailies, { id = "d_depth1", name = "심도 1개 층 정복", kind = "depth", target = "", count = 1, gold = 250, expPct = 40 })
        table.insert(self.Dailies, { id = "d_quest1", name = "의뢰 1개 완료", kind = "quest", target = "", count = 1, gold = 150, expPct = 20 })
        table.insert(self.Achievements, { id = "a_kill100", name = "망자 사냥꾼", desc = "몬스터 100마리 처치", kind = "kill", target = "", count = 100, gold = 300, title = false })
        table.insert(self.Achievements, { id = "a_kill1000", name = "잿빛 학살자", desc = "몬스터 1000마리 처치", kind = "kill", target = "", count = 1000, gold = 2500, title = true })
        table.insert(self.Achievements, { id = "a_capture1", name = "첫 그림자", desc = "혼 추출 첫 성공", kind = "capture", target = "", count = 1, gold = 100, title = false })
        table.insert(self.Achievements, { id = "a_capture25", name = "그림자 수집가", desc = "혼 추출 25회 성공", kind = "capture", target = "", count = 25, gold = 1200, title = true })
        table.insert(self.Achievements, { id = "a_species5", name = "군단의 시작", desc = "서로 다른 몬스터 5종의 그림자 포획", kind = "capture_species", target = "", count = 5, gold = 800, title = false })
        table.insert(self.Achievements, { id = "a_raise50", name = "망자의 주인", desc = "해골·마법사 50번 일으키기", kind = "raise", target = "", count = 50, gold = 500, title = false })
        table.insert(self.Achievements, { id = "a_level10", name = "깨어난 네크로맨서", desc = "10레벨 달성", kind = "level", target = "", count = 10, gold = 500, title = false })
        table.insert(self.Achievements, { id = "a_level20", name = "잿빛의 군주", desc = "20레벨 달성", kind = "level", target = "", count = 20, gold = 2000, title = true })
        table.insert(self.Achievements, { id = "a_depth5", name = "심연 하강", desc = "심도 5층 정복", kind = "depth", target = "", count = 5, gold = 1500, title = false })
        table.insert(self.Achievements, { id = "a_depth10", name = "끝없는 아래", desc = "심도 10층 정복", kind = "depth", target = "", count = 10, gold = 4000, title = true })
        table.insert(self.Achievements, { id = "a_elite50", name = "정예 사냥꾼", desc = "정예·우두머리 50마리 처치", kind = "kill_elite", target = "", count = 50, gold = 1200, title = false })
        table.insert(self.Achievements, { id = "a_queen", name = "여왕의 몰락", desc = "묘지기 여왕 오르넬라 처치", kind = "kill_source", target = "grave_queen", count = 1, gold = 1500, title = true })
        table.insert(self.Achievements, { id = "a_quests", name = "무덤 왕국의 해방자", desc = "무덤 왕국 의뢰 모두 완료", kind = "quest", target = "", count = 6, gold = 2000, title = true })
        table.insert(self.Achievements, { id = "a_codex", name = "무덤 왕국 도감", desc = "무덤 왕국 몬스터 모두 처치해 도감 채우기", kind = "collection", target = "", count = 13, gold = 3000, title = false })
        table.insert(self.Achievements, { id = "a_daily10", name = "성실한 사냥꾼", desc = "일일 의뢰 10개 완료", kind = "daily", target = "", count = 10, gold = 1000, title = false })
        table.insert(self.Achievements, { id = "a_grail_u10", name = "유니크 수집가", desc = "서로 다른 유니크 10종을 아이템 도감에 기록", kind = "grail_unique", target = "", count = 10, gold = 2000, title = false })
        table.insert(self.Achievements, { id = "a_grail_s10", name = "세트 조각 모으기", desc = "서로 다른 세트 조각 10종을 아이템 도감에 기록", kind = "grail_set", target = "", count = 10, gold = 2500, title = false })
        table.insert(self.Achievements, { id = "a_grail_full1", name = "완성된 유산", desc = "한 세트의 모든 조각을 아이템 도감에 기록", kind = "grail_fullset", target = "", count = 1, gold = 3000, title = false })
        table.insert(self.Achievements, { id = "a_grail_rw5", name = "룬 장인", desc = "서로 다른 룬워드 5종을 아이템 도감에 기록", kind = "grail_rw", target = "", count = 5, gold = 3000, title = false })
        table.insert(self.Achievements, { id = "a_grail_u30", name = "전설의 수집가", desc = "서로 다른 유니크 30종을 아이템 도감에 기록", kind = "grail_unique", target = "", count = 30, gold = 8000, title = true })
        table.insert(self.Achievements, { id = "a_grail_full3", name = "세 가문의 유산", desc = "세 세트의 모든 조각을 아이템 도감에 기록", kind = "grail_fullset", target = "", count = 3, gold = 6000, title = true })
        table.insert(self.Monsters, { id = "hellhound", name = "잿불 들개", grade = 1, unique = false, arch = "beast", lore = "불탄 마을의 들개가 잿불을 품은 채 일어났다. 무리를 지어 가장 약한 자부터 문다." })
        table.insert(self.Monsters, { id = "graveworm", name = "무덤 구더기", grade = 1, unique = false, arch = "soldier", lore = "관 조각을 뒤집어쓴 큰 구더기. 땅속을 파고 다니다 발밑에서 솟는다." })
        table.insert(self.Monsters, { id = "ashendead", name = "잿빛 망자병", grade = 1, unique = false, arch = "soldier", lore = "재를 뒤집어쓴 왕국의 옛 수비대. 죽어서도 초소를 떠나지 못한다." })
        table.insert(self.Monsters, { id = "corpsecrow", name = "시체 까마귀", grade = 1, unique = false, arch = "beast", lore = "무덤가 시체를 쪼던 까마귀. 조각의 기운을 먹고 죽지 않게 되었다." })
        table.insert(self.Monsters, { id = "skelwarrior", name = "납골당 해골 수비병", grade = 1, unique = false, arch = "guard", lore = "살이 다 빠진 수비대 병사. 녹슨 방패를 아직 놓지 않았다." })
        table.insert(self.Monsters, { id = "starvedwraith", name = "수의 망령", grade = 1, unique = false, arch = "assassin", lore = "수의째 떠오른 망자. 차가운 숨으로 산 자의 온기를 빨아들인다." })
        table.insert(self.Monsters, { id = "fallenimp", name = "굶주린 구울", grade = 1, unique = false, arch = "swarm", lore = "시체를 뜯어 먹으며 살아남은 망자. 불리하면 네 발로 기어 달아난다." })
        table.insert(self.Monsters, { id = "rotzombie", name = "역병 시체", grade = 1, unique = false, arch = "brute", lore = "역병으로 죽은 마을 사람. 부어오른 몸으로 느리게, 끝까지 따라온다." })
        table.insert(self.Monsters, { id = "cultarcher", name = "교단 광신 석궁병", grade = 1, unique = false, arch = "ranged", lore = "타락한 교단의 광신도. 여왕에게 혼을 바치며, 멀리서 쏘고 물러선다." })
        table.insert(self.Monsters, { id = "broodspider", name = "납골당 새끼거미", grade = 1, unique = false, arch = "swarm", lore = "납골당 거미줄 속에서 깨어난 새끼거미. 독니가 작지만 빠르다." })
        table.insert(self.Monsters, { id = "headsman", name = "목 없는 처형인 고드릭", grade = 2, unique = true, arch = "brute", lore = "여왕의 사형 집행인 고드릭. 역병 든 백성을 가장 먼저 매단 자. 목 대신 무덤의 불이 탄다." })
        table.insert(self.Monsters, { id = "skelcaptain", name = "근위대장 바르그", grade = 2, unique = true, arch = "guard", lore = "여왕의 근위대장 바르그. 납골당 3층에서 아직도 여왕의 길을 지킨다." })
        table.insert(self.Monsters, { id = "gravequeen", name = "묘지기 여왕 오르넬라", grade = 3, unique = true, arch = "boss", lore = "역병 속에 죽은 무덤 왕국의 여왕. 오렌의 의식으로 깨어나 첫 번째 조각을 삼켰다. 등불을 들어 왕국의 망자를 부른다." })
        table.insert(self.Monsters, { id = "bonenest", name = "뼈 둥지", grade = 2, unique = false, arch = "nest", lore = "뼈와 관 조각을 엮은 둥지. 안에서 새 망자가 계속 깨어난다." })
        table.insert(self.Monsters, { id = "jackal", name = "사막 자칼", grade = 1, unique = false, arch = "beast", lore = "대상을 습격하는 굶주린 사막 자칼. 무리로 몰려와 둘러싼다." })
        table.insert(self.Monsters, { id = "sandscorp", name = "모래 전갈", grade = 1, unique = false, arch = "guard", lore = "모래 속에 숨어 있다가 독침을 찌르는 전갈." })
        table.insert(self.Monsters, { id = "firecultist", name = "불꽃 사도", grade = 1, unique = false, arch = "ranged", lore = "대사제를 따르는 불꽃 사도. 손바닥 위의 불길을 던진다." })
        table.insert(self.Monsters, { id = "mummy", name = "모래 미라", grade = 1, unique = false, arch = "brute", lore = "혼이 묶인 채 일어난 옛 오아시스 사람들. 붕대 사이로 한쪽 눈이 빛난다." })
        table.insert(self.Monsters, { id = "sandwraith", name = "모래 망령", grade = 1, unique = false, arch = "assassin", lore = "모래폭풍에 흩어진 혼. 아래쪽은 모래가 되어 흩날린다." })
        table.insert(self.Monsters, { id = "scarabs", name = "풍뎅이", grade = 1, unique = false, arch = "swarm", lore = "묘실 벽을 갉아 먹는 청록 풍뎅이." })
        table.insert(self.Monsters, { id = "templeguard", name = "사원 수호상", grade = 2, unique = false, arch = "brute", lore = "사원을 지키던 유약 돌 석상. 금 간 틈으로 빛이 샌다." })
        table.insert(self.Monsters, { id = "serka", name = "독침 여왕 세르카", grade = 2, unique = true, arch = "beast", lore = "전갈 굴의 여왕. 땅에 고이는 독을 뿜는다." })
        table.insert(self.Monsters, { id = "tombking", name = "묘실 수호왕 아메네트", grade = 2, unique = true, arch = "guard", lore = "황금 가면을 쓴 옛 왕 아메네트. 대사제가 조각의 힘으로 깨웠다." })
        table.insert(self.Monsters, { id = "librarian", name = "불꽃 사서 이드리스", grade = 2, unique = true, arch = "ranged", lore = "불붙은 책을 지키는 해골 사서 이드리스. 순례자가 다녀간 기록만은 끝내 태우지 못했다." })
        table.insert(self.Monsters, { id = "gatebrother", name = "창의 문지기 아슈", grade = 2, unique = true, arch = "soldier", lore = "사자 투구를 쓴 쌍둥이 형 아슈. 동생 나슈가 쓰러지면 미쳐 날뛴다." })
        table.insert(self.Monsters, { id = "highpriest", name = "대사제 알하자르", grade = 3, unique = true, arch = "boss", lore = "끝나지 않는 왕국을 꿈꾼 대사제. 잿빛 순례자가 다녀간 밤부터 목소리를 들었다. 두 번째 조각으로 불길과 미라를 부른다." })
        table.insert(self.Monsters, { id = "gatebrother2", name = "방패의 문지기 나슈", grade = 2, unique = true, arch = "guard", lore = "사자 방패를 든 쌍둥이 동생 나슈. 형 아슈가 쓰러지면 미쳐 날뛴다." })
        table.insert(self.Monsters, { id = "morg", name = "썩은 사제 모르그", grade = 1, unique = false, arch = "brute", lore = "혼을 묶는 법을 반쯤만 배운 교단의 옛 사제. 오렌과 같은 제단에 섰다. 혼을 지팡이에 묶어 끌고 다닌다." })
        table.insert(self.Monsters, { id = "relickeeper", name = "유물 지기 테오", grade = 1, unique = false, arch = "soldier", lore = "옛 교단의 수도사 테오. 「다시는 모이지 않게」라 적힌 기록 상자를 끌어안고 죽었다." })
        table.insert(self.Monsters, { id = "bloodpriest", name = "피의 사제 사빈", grade = 1, unique = false, arch = "ranged", lore = "교수대 숲 피의 제단의 주인. 타락한 교단의 사제로, 아직도 여왕에게 혼을 바친다." })
        table.insert(self.Monsters, { id = "stormcrab", name = "폭풍 게", grade = 1, unique = false, arch = "guard", lore = "집게 사이로 작은 번개가 튀는 갯벌 게." })
        table.insert(self.Monsters, { id = "drownedsailor", name = "익사한 선원", grade = 1, unique = false, arch = "assassin", lore = "제독의 함대와 함께 가라앉은 선원. 검은 부스러기를 목에 걸고 있다." })
        table.insert(self.Monsters, { id = "brinewitch", name = "소금 마녀", grade = 1, unique = false, arch = "ranged", lore = "소금 결정이 박힌 머리칼의 마녀. 냉기 구슬을 던진다." })
        table.insert(self.Monsters, { id = "stormcaller", name = "폭풍 주술사", grade = 1, unique = false, arch = "ranged", lore = "머리 위에 먹구름을 이고 다니는 주술사. 번개가 사람 사이를 튕긴다." })
        table.insert(self.Monsters, { id = "sparkeel", name = "전기 뱀장어", grade = 1, unique = false, arch = "ranged", lore = "몸에 번개 무늬가 흐르는 뱀장어. 물가에서 전기를 내뿜는다." })
        table.insert(self.Monsters, { id = "stormgulls", name = "폭풍 갈매기", grade = 1, unique = false, arch = "swarm", lore = "폭풍 속을 나는 갈매기 떼. 청백으로 빛나는 눈으로 먹이를 노린다." })
        table.insert(self.Monsters, { id = "crabking", name = "바위 집게 왕 크라그", grade = 2, unique = true, arch = "guard", lore = "바위섬만 한 게 크라그. 생명이 줄면 껍질을 닫아 단단해진다." })
        table.insert(self.Monsters, { id = "wreckgolem", name = "난파선 골렘", grade = 2, unique = false, arch = "brute", lore = "난파선 판자와 닻, 사슬로 된 덩치. 선실 창 두 개가 눈이다." })
        table.insert(self.Monsters, { id = "smugglerboss", name = "밀수꾼 두목 렌", grade = 2, unique = true, arch = "assassin", lore = "난파선에서 건진 검은 부스러기를 팔아넘기는 밀수꾼 두목 렌." })
        table.insert(self.Monsters, { id = "drownedpriest", name = "물에 잠긴 사제 세드릭", grade = 2, unique = true, arch = "ranged", lore = "물에 잠긴 예배당의 사제 세드릭. 제독의 함대를 축복했던 자. 젖은 향로에서 푸른 불을 피운다." })
        table.insert(self.Monsters, { id = "madkeeper", name = "미친 등대지기 하울", grade = 2, unique = true, arch = "ranged", lore = "등대 불로 제독을 바닷속에 붙잡아 두던 등대지기. 불이 꺼진 밤 미쳤다고들 하지만, 그는 끝까지 무언가를 경고하고 있었다." })
        table.insert(self.Monsters, { id = "admiral", name = "익사한 제독 바렌", grade = 3, unique = true, arch = "boss", lore = "마지막 조각을 싣고 가라앉은 함대의 제독. 닻을 끌며 폭풍을 부른다." })
        table.insert(self.Monsters, { id = "demonaxe", name = "타락마족 도끼병", grade = 1, unique = false, arch = "berserker", lore = "문이 열린 날 협곡을 넘어온 악마 병사. 붉은 뿔 투구 안쪽에 교단 문장이 새겨져 있다." })
        table.insert(self.Monsters, { id = "demonshield", name = "타락마족 방패병", grade = 1, unique = false, arch = "guard", lore = "타락마족 행군의 맨 앞줄. 녹은 쇠로 붙인 방패가 아직 뜨겁다." })
        table.insert(self.Monsters, { id = "firebat", name = "화염 박쥐", grade = 1, unique = false, arch = "beast", lore = "불탄 협곡의 동굴에서 떼 지어 나오는 박쥐. 날개 끝이 타고 있다." })
        table.insert(self.Monsters, { id = "hellpriest", name = "지옥불 사제", grade = 1, unique = false, arch = "ranged", lore = "혼을 먹는 악마의 사제. 땅에 떨어진 혼을 붉은 실로 끌어가 삼킨다 — 먼저 쓰러뜨려라." })
        table.insert(self.Monsters, { id = "ashwraith", name = "재의 망령", grade = 1, unique = false, arch = "assassin", lore = "혼을 먹힌 자가 남긴 재. 유황 늪 위를 떠돌며 불씨를 던진다." })
        table.insert(self.Monsters, { id = "lavagolem", name = "용암 골렘", grade = 2, unique = false, arch = "brute", lore = "성채 대장간의 용암으로 빚은 덩치. 냉기에 약하다." })
        table.insert(self.Monsters, { id = "sulfurqueen", name = "유황 여왕 네르사", grade = 2, unique = true, arch = "beast", lore = "유황 동굴 가장 깊은 곳에 매달린 거대한 박쥐 네르사. 날개를 펴면 동굴이 불붙는다." })
        table.insert(self.Monsters, { id = "prisonwarden", name = "간수장 그림달", grade = 2, unique = true, arch = "soldier", lore = "혼 감옥의 열쇠를 쥔 간수 그림달. 옥좌에서 내려온 명령대로 갇힌 혼을 하나씩 꺼내 사제들에게 먹인다." })
        table.insert(self.Monsters, { id = "forgedemon", name = "대장장이 악마 베르카", grade = 2, unique = true, arch = "brute", lore = "용암 대장간의 주인. 타락마족의 무기는 모두 그의 모루에서 나왔다." })
        table.insert(self.Monsters, { id = "apostate", name = "심장의 사도 오렌", grade = 2, unique = true, arch = "ranged", lore = "세 조각을 몸에 품은 사제 오렌. 정화를 믿고 끝까지 목소리를 따랐다. 몸의 절반이 이미 재가 되었다." })
        table.insert(self.Monsters, { id = "archbishop", name = "배교한 대주교", grade = 2, unique = true, arch = "ranged", lore = "심장을 셋으로 쪼갠 교단의 마지막 대주교. 봉인을 지키지 못하자 무릎 꿇었고, 이제 옥좌로 가는 문을 지킨다." })
        table.insert(self.Monsters, { id = "fallenknight", name = "타락한 기사 이그나", grade = 2, unique = true, arch = "berserker", lore = "문을 지키다 문에 삼켜진 기사. 불붙은 검을 아직 놓지 않았다." })
        table.insert(self.Monsters, { id = "ashking", name = "재의 왕 고르바스", grade = 3, unique = true, arch = "boss", lore = "백 년 전 교단이 쓰러뜨린 재의 왕. 잿빛 행상 「고르」의 모습으로 마을을 떠돌며 사제의 귀에 속삭였다. 혼을 먹을수록 강해진다." })
        table.insert(self.Monsters, { id = "shadesmith", name = "하르크의 그림자", grade = 2, unique = true, arch = "soldier", lore = "재의 왕이 대장장이 하르크에게서 떼어 낸 그림자. 쓰러뜨리면 주인에게 돌아간다." })
        table.insert(self.Monsters, { id = "shadekeeper", name = "미라의 그림자", grade = 2, unique = true, arch = "soldier", lore = "재의 왕이 등대지기의 딸 미라에게서 떼어 낸 그림자. 아버지의 등불을 흉내 낸다. 쓰러뜨리면 주인에게 돌아간다." })
        table.insert(self.Monsters, { id = "shadedeserter", name = "엘리안의 그림자", grade = 2, unique = true, arch = "soldier", lore = "재의 왕이 교단 탈주자 엘리안에게서 떼어 낸 그림자. 쓰러뜨리면 주인에게 돌아간다." })
    end

    method table GetDailies()
        self:Ensure()
        return self.Dailies
    end

    method table GetAchievements()
        self:Ensure()
        return self.Achievements
    end

    method table GetMonsters()
        self:Ensure()
        return self.Monsters
    end

    method any GetDaily(string id)
        self:Ensure()
        for _, d in ipairs(self.Dailies) do if d.id == id then return d end end
        return nil
    end

    method any GetAchievement(string id)
        self:Ensure()
        for _, a in ipairs(self.Achievements) do if a.id == id then return a end end
        return nil
    end

end
