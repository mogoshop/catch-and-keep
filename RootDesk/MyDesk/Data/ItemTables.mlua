-- 자동 생성 파일: tools/gen_data.cjs 가 data/item_bases.csv, item_affixes.csv, item_uniques.csv, runes.csv, runewords.csv, stats.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 아이템 데이터 표 (규칙·생성 로직은 Item/ItemData)
@Logic
script ItemTables extends Logic

    property boolean Built = false
    property table StatNames = {}
    property table Bases = {}
    property table BaseOrder = {}
    property table Affixes = {}
    property table Uniques = {}
    property table Runes = {}
    property table RuneOrder = {}
    property table Runewords = {}

    method void Ensure()
