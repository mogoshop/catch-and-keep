        self.Skills["resist_break"] = { id = "resist_break", name = "저항 붕괴", tree = "curse", row = 50, kind = "curse", prereq = "decay", maxLv = 20, mana = 14, cooldown = 1, impl = false, nextLv = 0, desc = "모든 저항 감소", icon = "b93fce2e7d59482bb40aa34d0cf435c3" }
        table.insert(self.Order, "resist_break")
    end

    method any Get(string id)
        self:Ensure()
        return self.Skills[id]
    end

    method table GetOrder()
        self:Ensure()
        return self.Order
    end

    method string TreeName(string tree)
        if tree == "command" then return "군령" end
        if tree == "soul" then return "혼술" end
        return "저주"
    end

end
