        table.insert(self.Order, "soul_drain")
        self.Skills["poison_spread"] = { id = "poison_spread", name = "독 확산", tree = "soul", row = 30, kind = "passive", prereq = "poison_mist", maxLv = 20, mana = 0, cooldown = 0, impl = false, nextLv = 0, desc = "독 걸린 적 사망 시 확산", icon = "701e2b48d3f44e058d89cc65e51743ea" }
