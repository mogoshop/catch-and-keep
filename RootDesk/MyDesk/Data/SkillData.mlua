-- 자동 생성 파일: tools/gen_data.cjs 가 data/skills.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 네크로맨서 스킬 정의 (docs/design/04 3장). impl=false는 트리에만 보이는 준비 중 스킬
@Logic
script SkillData extends Logic

    property boolean Built = false
    property table Skills = {}
    property table Order = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.Skills = {}
        self.Order = {}
        self.Skills["shadow_summon"] = { id = "shadow_summon", name = "그림자 소환", tree = "command", row = 1, kind = "active", prereq = "", maxLv = 20, mana = 0, cooldown = 0, impl = true, desc = "보관함의 그림자를 소환한다 (Z)" }
        table.insert(self.Order, "shadow_summon")
        self.Skills["extract_mastery"] = { id = "extract_mastery", name = "추출 숙련", tree = "command", row = 1, kind = "passive", prereq = "", maxLv = 20, mana = 0, cooldown = 0, impl = true, desc = "혼 추출 확률 +1.5%/레벨" }
        table.insert(self.Order, "extract_mastery")
        self.Skills["rally"] = { id = "rally", name = "집결", tree = "command", row = 6, kind = "active", prereq = "shadow_summon", maxLv = 20, mana = 0, cooldown = 0, impl = true, desc = "소환수 전원을 곁으로 부른다 (C)" }
        table.insert(self.Order, "rally")
        self.Skills["command_mastery"] = { id = "command_mastery", name = "군령 숙련", tree = "command", row = 12, kind = "passive", prereq = "extract_mastery", maxLv = 20, mana = 0, cooldown = 0, impl = true, desc = "소환수 공격력·생명 +8%/레벨" }
        table.insert(self.Order, "command_mastery")
        self.Skills["deploy_expand"] = { id = "deploy_expand", name = "배치 확장", tree = "command", row = 18, kind = "passive", prereq = "command_mastery", maxLv = 20, mana = 0, cooldown = 0, impl = true, desc = "배치 한도 +1 (1·8·16레벨)" }
        table.insert(self.Order, "deploy_expand")
        self.Skills["soul_bond"] = { id = "soul_bond", name = "혼 결속", tree = "command", row = 24, kind = "aura", prereq = "command_mastery", maxLv = 20, mana = 0, cooldown = 0, impl = false, desc = "소환수 저항 증가, 피해 일부 분담" }
        table.insert(self.Order, "soul_bond")
        self.Skills["elite_promote"] = { id = "elite_promote", name = "정예 승격", tree = "command", row = 30, kind = "active", prereq = "deploy_expand", maxLv = 20, mana = 30, cooldown = 20, impl = true, desc = "가장 강한 소환수 1기를 정예로 (능력치 ×1.5)" }
        table.insert(self.Order, "elite_promote")
        self.Skills["shadow_sacrifice"] = { id = "shadow_sacrifice", name = "그림자 희생", tree = "command", row = 36, kind = "active", prereq = "elite_promote", maxLv = 20, mana = 10, cooldown = 10, impl = false, desc = "그림자를 소모해 피해 증가" }
        table.insert(self.Order, "shadow_sacrifice")
        self.Skills["revive"] = { id = "revive", name = "되살림", tree = "command", row = 42, kind = "active", prereq = "command_mastery", maxLv = 20, mana = 40, cooldown = 30, impl = false, desc = "처치한 정예를 20초간 부활" }
        table.insert(self.Order, "revive")
        self.Skills["command_aura"] = { id = "command_aura", name = "호령", tree = "command", row = 50, kind = "aura", prereq = "soul_bond", maxLv = 20, mana = 0, cooldown = 0, impl = false, desc = "아군 공격력·이동 속도 증가" }
        table.insert(self.Order, "command_aura")
        self.Skills["bone_shard"] = { id = "bone_shard", name = "골편 투척", tree = "soul", row = 1, kind = "active", prereq = "", maxLv = 20, mana = 4, cooldown = 0.5, impl = true, desc = "커서 방향으로 뼛조각을 꿰뚫어 날린다" }
        table.insert(self.Order, "bone_shard")
        self.Skills["poison_mist"] = { id = "poison_mist", name = "독안개", tree = "soul", row = 6, kind = "active", prereq = "bone_shard", maxLv = 20, mana = 8, cooldown = 3, impl = true, desc = "커서 위치에 독안개, 4초간 지속 피해" }
        table.insert(self.Order, "poison_mist")
        self.Skills["corpse_blast"] = { id = "corpse_blast", name = "망자 폭쇄", tree = "soul", row = 12, kind = "active", prereq = "bone_shard", maxLv = 20, mana = 10, cooldown = 1, impl = true, desc = "커서 근처의 혼을 터뜨려 범위 피해 (추출 대신 소모)" }
        table.insert(self.Order, "corpse_blast")
        self.Skills["bone_prison"] = { id = "bone_prison", name = "골격 감옥", tree = "soul", row = 18, kind = "active", prereq = "corpse_blast", maxLv = 20, mana = 12, cooldown = 8, impl = false, desc = "뼈 장벽으로 이동 제한" }
        table.insert(self.Order, "bone_prison")
        self.Skills["soul_drain"] = { id = "soul_drain", name = "혼 흡수", tree = "soul", row = 24, kind = "active", prereq = "poison_mist", maxLv = 20, mana = 12, cooldown = 4, impl = true, desc = "대상의 생명을 흡수해 자신과 소환수 회복" }
        table.insert(self.Order, "soul_drain")
        self.Skills["poison_spread"] = { id = "poison_spread", name = "독 확산", tree = "soul", row = 30, kind = "passive", prereq = "poison_mist", maxLv = 20, mana = 0, cooldown = 0, impl = false, desc = "독 걸린 적 사망 시 확산" }
        table.insert(self.Order, "poison_spread")
        self.Skills["bone_storm"] = { id = "bone_storm", name = "뼈 폭풍", tree = "soul", row = 36, kind = "active", prereq = "bone_prison", maxLv = 20, mana = 20, cooldown = 12, impl = true, desc = "6초간 주위를 도는 뼈가 적을 벤다" }
        table.insert(self.Order, "bone_storm")
        self.Skills["soul_torrent"] = { id = "soul_torrent", name = "영혼 격류", tree = "soul", row = 42, kind = "active", prereq = "soul_drain", maxLv = 20, mana = 25, cooldown = 6, impl = false, desc = "유도 영혼 다수 발사" }
        table.insert(self.Order, "soul_torrent")
        self.Skills["death_wave"] = { id = "death_wave", name = "죽음의 파동", tree = "soul", row = 50, kind = "active", prereq = "bone_storm", maxLv = 20, mana = 40, cooldown = 15, impl = false, desc = "전방위 대형 파동" }
        table.insert(self.Order, "death_wave")
        self.Skills["mark_weakness"] = { id = "mark_weakness", name = "약화의 낙인", tree = "curse", row = 1, kind = "curse", prereq = "", maxLv = 20, mana = 6, cooldown = 1, impl = true, desc = "범위의 적이 받는 피해 +30% (+3%/레벨), 8초" }
        table.insert(self.Order, "mark_weakness")
        self.Skills["enfeeble"] = { id = "enfeeble", name = "쇠약", tree = "curse", row = 6, kind = "curse", prereq = "mark_weakness", maxLv = 20, mana = 6, cooldown = 1, impl = true, desc = "범위의 적 공격력 -35%, 8초" }
        table.insert(self.Order, "enfeeble")
        self.Skills["thorn_curse"] = { id = "thorn_curse", name = "가시 저주", tree = "curse", row = 12, kind = "curse", prereq = "enfeeble", maxLv = 20, mana = 8, cooldown = 1, impl = false, desc = "적이 준 피해 일부 반사" }
        table.insert(self.Order, "thorn_curse")
        self.Skills["terror"] = { id = "terror", name = "공포", tree = "curse", row = 18, kind = "curse", prereq = "enfeeble", maxLv = 20, mana = 8, cooldown = 1, impl = false, desc = "적을 도망치게 함" }
        table.insert(self.Order, "terror")
        self.Skills["confusion"] = { id = "confusion", name = "혼란", tree = "curse", row = 24, kind = "curse", prereq = "terror", maxLv = 20, mana = 10, cooldown = 1, impl = false, desc = "적이 서로 공격" }
        table.insert(self.Order, "confusion")
        self.Skills["life_tap"] = { id = "life_tap", name = "생명 약탈", tree = "curse", row = 30, kind = "curse", prereq = "mark_weakness", maxLv = 20, mana = 10, cooldown = 1, impl = false, desc = "공격 시 생명 회복" }
        table.insert(self.Order, "life_tap")
        self.Skills["lure"] = { id = "lure", name = "유인", tree = "curse", row = 36, kind = "curse", prereq = "confusion", maxLv = 20, mana = 10, cooldown = 1, impl = false, desc = "적을 한곳에 모음" }
        table.insert(self.Order, "lure")
        self.Skills["decay"] = { id = "decay", name = "쇠퇴", tree = "curse", row = 42, kind = "curse", prereq = "thorn_curse", maxLv = 20, mana = 12, cooldown = 1, impl = false, desc = "속도·피해 대폭 감소" }
        table.insert(self.Order, "decay")
        self.Skills["resist_break"] = { id = "resist_break", name = "저항 붕괴", tree = "curse", row = 50, kind = "curse", prereq = "decay", maxLv = 20, mana = 14, cooldown = 1, impl = false, desc = "모든 저항 감소" }
        table.insert(self.Order, "resist_break")
    end

    method any Get(string id)
        self:Ensure()
        return self.Skills[id]
    end

    method table GetOrder()
        self:Ensure()
        return self.Order
    end

    method string TreeName(string tree)
        if tree == "command" then return "군령" end
        if tree == "soul" then return "혼술" end
        return "저주"
    end

end
