        table.insert(self.Order, "raise_mage")
        self.Skills["shadow_summon"] = { id = "shadow_summon", name = "그림자 소환", tree = "command", row = 5, kind = "active", prereq = "raise_skeleton", maxLv = 20, mana = 0, cooldown = 0, impl = true, nextLv = 15, desc = "혼 추출(E)과 그림자 소환(Z)을 연다. Lv5에 1레벨(그림자 1기만), 2레벨부터와 본격 배치는 Lv15", icon = "4be09a4fa7b241b9b2ef01a7eb72ff9a" }
