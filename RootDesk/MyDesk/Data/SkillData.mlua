    method any Get(string id)
        self:Ensure()
        return self.Skills[id]
    end

    method table GetOrder()
        self:Ensure()
        return self.Order
    end

    method table NodesOf(string parent)
        -- 메인 스킬에 붙은 강화 노드 id (표 순서)
        self:Ensure()
        local list = {}
        for _, id in ipairs(self.Order) do
            if self.Skills[id].parent == parent then table.insert(list, id) end
        end
        return list
    end

    method table GroupOf(string group)
        -- 46-5 택일 묶음의 노드 id (표 순서 · 「둘 중 하나」)
        self:Ensure()
        local list = {}
        if group == "" then return list end
        for _, id in ipairs(self.Order) do
            if self.Skills[id].group == group then table.insert(list, id) end
        end
        return list
    end

    method table Mains()
        -- 메인 스킬 id (해금 레벨 순 — 표가 이미 그 순서)
        self:Ensure()
        local list = {}
        for _, id in ipairs(self.Order) do
            if self.Skills[id].kind ~= "node" then table.insert(list, id) end
        end
        return list
    end

    method string TreeName(string tree)
        -- 계열 이름: 소환·영혼·저주·이동 (스킬 창·아이템 옵션 공통, docs/design/19 · 기동 10-20)
        if tree == "command" then return "소환" end
        if tree == "soul" then return "주문" end
        if tree == "move" then return "걸음" end
        return "저주"
    end

end
