-- 자동 생성 파일: tools/gen_data.cjs 가 data/skills.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 네크로맨서 스킬 정의 (docs/design/04 3장). impl=false는 트리에만 보이는 준비 중 스킬
@Logic
script SkillData extends Logic

    property boolean Built = false
    property table Skills = {}
    property table Order = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.Skills = {}
        self.Order = {}
        self.Skills["raise_skeleton"] = { id = "raise_skeleton", name = "해골 전사", tree = "command", row = 1, kind = "active", prereq = "", maxLv = 20, mana = 12, cooldown = 0.5, impl = true, nextLv = 0, desc = "커서 근처 혼으로 해골 전사를 일으킨다. 최대 수: 랭크 1·2·3 이후 3랭크마다 +1 (강화 「뼈 군단」으로 더)", icon = "28a05141071146c291d0593fe2dfcdd1", parent = "", need = 0 }
