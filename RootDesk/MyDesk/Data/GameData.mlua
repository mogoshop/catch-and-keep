        self.UiIcons["story_fall"] = "e33ee6afa2604e5d95d26f13ed6e690a"
        self.UiIcons["story_fall_4"] = "e33ee6afa2604e5d95d26f13ed6e690a"
        self.UiIcons["story_fall_1"] = "53d22c8951fe486ebe2945ca746cd555"
        self.UiIcons["story_reveal_6"] = "0962c1335bfe46fdb04564836c4ba91a"
        self.UiIcons["story_reveal_7"] = "427eefa0037a47f4a1ad17d4bb5ed135"
        self.UiIcons["story_reveal_8"] = "b779e86e7dd34f8982e941946fa0c0d5"
        self.UiIcons["story_reveal_4"] = "55da3004e7424ba6be60b389586e3b7a"
        self.Story = {}
        self.Story["prologue"] = "나는 그 땅을 살릴 수 있다고 믿었다.^역병과 전쟁이 지나간 {무덤 왕국}에는, 산 사람보다 무덤이 더 많았는데도./백 년 전, 교단은 [재의 왕]을 쓰러뜨리고 그 심장을 셋으로 쪼개 서로 다른 땅에 묻었다.^우리는 그 조각을 「혼각」이라 불렀다. 다시는 한곳에 모이지 않게 하라 — 그것이 교단의 맹세였다./그런데 묻어 둔 조각 하나가 다시 빛을 보았다.^그날부터 무덤이 들썩였고, 죽은 자들이 일어나 걸었다.^누가 그 무덤을 열었는지는… 나중에 말할게./그리고 네가 왔다. 마지막 네크로맨서.^죽은 자를 부리는 자가 아니라, 그들을 묶은 사슬을 끊어 주는 자.^사슬에서 풀려난 혼은 스스로 네 곁에 남아 네 그림자가 되었다./나는 {잿불 야영지}의 모닥불 앞에서 너를 기다렸다.^어깨 위의 숯을 쓰다듬으며, 오늘도 웃자고 다짐하면서.^꿈속의 목소리가 누구의 것인지도 모르고."
        self.Story["act1_title"] = "1장 · 깨어난 여왕"
        self.Story["act1_sub"] = "여왕이 잠들지 못한 땅, 무덤 왕국"
        self.Story["act2_title"] = "2장 · 끝나지 않는 왕국"
        self.Story["act2_sub"] = "모래에 묻힌 사원, 모래 폐허"
        self.Story["act3_title"] = "3장 · 꺼진 등대"
        self.Story["act3_sub"] = "가라앉은 함대의 바다, 폭풍 해안"
        self.Story["act4_title"] = "4장 · 심연의 문"
        self.Story["act4_sub"] = "세 조각이 모이는 곳, 심연의 땅"
        self.Story["act1_end"] = "여왕 오르넬라가 쓰러지자, 무덤 왕국에 처음으로 고요한 밤이 찾아왔다.^네가 관 속에서 꺼내 온 조각은 내 손 안에서 따뜻했다./이튿날 아침 황무지의 안개가 걷혔다. 사람들은 내 기도 덕이라 했고, 나도 그렇게 믿었다.^그날 밤 숯이 처음으로 내 손을 피했다. 그때는 그 이유를 묻지 않았다."
        self.Story["act2_end"] = "대사제 알하자르가 쓰러지자, 백 년 만에 사막에 비가 내렸다.^두 번째 조각을 쥔 뒤로 나는 잠들지 못했다. 눈을 감으면 목소리가 너무 가까이 들렸으니까./성소에 남은 마지막 기록에는 이렇게 적혀 있었다.^「마지막 조각은 제독 바렌의 함대에 실려 바다를 건넜다.」^나는 그 줄을 읽고 기뻐했다. 끝이 보였으니까."
        self.Story["act3_end"] = "폭풍이 걷히고, 등대에 다시 불이 켜졌다.^그날 밤 나는 아무에게도 알리지 않고 북쪽으로 가는 배에 올랐다. 너에게도.^숯은 카라반 편에 아빠에게 돌려보냈다./남긴 것은 쪽지 두 장뿐이었다. 「심연의 문에서 마지막 정화를 하겠다.」 「숯 밥은 하루 두 번.」^세 조각이 처음으로 한 사람의 손에 모였다. …내 손이었다."
        self.Story["act4_end"] = "재의 왕 고르바스가 무너지고, 심장은 재가 되어 흩어졌다.^아빠와 미라, 엘리안의 발밑에 그림자가 돌아왔다. 숯은 아빠 곁에서 북쪽만 보고 있었다./하지만 문 아래의 어둠은 닫히지 않았다.^나는 지금, 그 아래에서 이 이야기를 들려주고 있다."
        self.Story["all_done"] = "고르바스는 쓰러졌지만, 문 아래의 어둠은 끝나지 않았다.^그 어둠은 같은 밤을 몇 번이고 다시 꾼다. 더 깊은 악몽 속에서, 같은 길을 다시 걸어 다오./마을의 붉은 포탈은 봉인이 갈라진 틈으로 심연까지 이어진다.^나는 그 아래에서 기다리겠다."
        self.Story["lock_act2"] = "사막길은 아직 막혀 있다. {여왕의 무덤}의 [묘지기 여왕 오르넬라]가 첫 번째 조각을 쥐고 있다 — 여왕을 쓰러뜨리고 사제 오렌에게 알리면 카라반이 출발한다."
        self.Story["lock_act3"] = "바닷길은 아직 닫혀 있다. 마지막 조각을 실은 함대의 행방은 성소의 [대사제 알하자르]만 안다 — 대사제를 쓰러뜨리고 사원 학자 오빈에게 알리면 배가 뜬다."
        self.Story["lock_act4"] = "북쪽 길은 아직 닫혀 있다. 등대 꼭대기의 [익사한 제독 바렌]이 마지막 조각을 쥐고 있다 — 제독을 쓰러뜨리고 등대지기의 딸 미라에게 알리면 북쪽으로 가는 배가 뜬다."
        self.Story["scene1_title"] = "그날 밤, 모닥불 앞에서"
        self.Story["scene1"] = "|모두 잠든 야영지. 오렌이 홀로 모닥불 앞에 앉아 손 안의 조각을 내려다본다. 어깨 위에서 숯이 졸고 있다./고르|아직 안 주무십니까, 사제님? 그 조각… 손에 쥐고 계시면 따뜻하지요?/오렌|아, 행상 아저씨구나. …응, 따뜻해. 꿈에서 들은 목소리랑 똑같은 말을 하네.^이걸 쥐자마자 황무지의 안개가 걷혔어. 이 땅이 낫고 있는 거야./고르|사막에도 똑같은 조각이 하나 있다더군요. 모래 폐허의 대사제가 품고 있다고요.^저도 내일 카라반을 따라 그쪽으로 갑니다. 사제님도… 오시겠지요?/오렌|…아저씨가 그걸 어떻게 알아?/고르|장사꾼은 귀가 밝아야 먹고삽니다. 그럼, 사막에서 뵙겠습니다./|고르가 웃으며 돌아선다. 숯이 털을 곤두세우고 낮게 하악거린다.^모닥불 빛이 그의 발밑을 비추지만, 그곳에는 그림자가 없다."
        self.Story["scene2_title"] = "비 내리는 사막의 밤"
        self.Story["scene2"] = "|백 년 만에 사막에 비가 내린 밤. 오렌은 또 잠들지 못한다. 숯이 그녀의 품으로 파고든다./오렌|두 개째야. 그런데 이상해. 조각을 쥘 때마다… 내 안의 뭔가가 조금씩 비어 가는 것 같아./고르|좋은 일에는 값이 따르는 법이지요. 보십시오, 사막에 비가 오지 않습니까./오렌|오빈 할아버지가 기록을 보여 줬어. 여왕도 대사제도, 변하기 전에 잿빛 외투를 입은 순례자를 만났대./고르|…사막엔 잿빛 외투가 흔합니다. 모래바람을 맞으면 다들 그 색이 되지요.^마지막 조각은 바다에 있습니다. 사제님, 이제 거의 다 왔습니다./|오렌의 눈가에 재가 앉아 있다. 그녀는 그것을 눈물이라 여긴다."
        self.Story["scene3_title"] = "북쪽으로 떠나는 배"
        self.Story["scene3"] = "|등대에 다시 불이 켜진 밤. 부두 끝에서 잿빛 돛을 단 낡은 배가 닻을 올린다. 오렌의 어깨가 비어 있다./고르|배는 제가 구해 두었습니다. 날이 밝기 전에 떠나셔야 합니다./오렌|그 네크로맨서한테 말도 없이 가는 건 옳지 않아. 여기까지 온 건 다 그 사람 덕인데./고르|그분은 지치셨습니다. 마지막 정화는 사제님 몫이지요. 그분은 나중에 따라오시면 됩니다./오렌|등대지기의 혼이 그랬대. 조각을 사제한테 주지 말라고. …숯도 아저씨만 보면 하악거렸지./고르|미쳐서 죽은 사람의 말입니다. 고양이야 원래 낯을 가리지요.^사제님은 이미 세 땅을 살리셨습니다. …누가 옳은지는 사제님이 가장 잘 아시지 않습니까./|세 조각이 한 자루 안에서 처음으로 맞닿는다.^북쪽 하늘 끝에서, 무언가가 천천히 눈을 뜬다."
        self.Story["fall_title"] = "꺼져 가는 불씨"
        self.Story["fall_sub"] = "심장의 사도가 쓰러진 순간 · 배교자의 수도원"
        self.Story["fall"] = "|심장의 사도가 무릎을 꿇는다. 몸을 감싸던 재가 하나둘 떨어지고, 창백한 얼굴에 오렌의 표정이 돌아온다./오렌|…네크로맨서? 아, 너구나. 미안해… 많이 아팠지./오렌|이제 알겠어. 그건 신의 목소리가 아니었어.^조각을 쥘 때마다 들리던 그 다정한 목소리… 고르였어./오렌|아빠한테 미안하다고 전해 줘. 그리고… 숯은 밥을 하루 두 번 먹어. 잊지 마./|오렌의 몸이 재가 되어 흩어진다. 남은 것은 앞치마와 깨진 망치 펜던트뿐./|그 재 속에서 세 조각이 떠오른다. 조각은 서로를 부르듯 울리더니, 북쪽 옥좌를 향해 날아간다.^하늘이 붉게 갈라진다."
        self.Story["reveal_title"] = "행상의 정체"
        self.Story["reveal"] = "|세 조각이 북쪽 하늘을 가르던 그 시각, 마지막 초소.^좌판 앞에 서 있던 행상이 천천히 고개를 든다./고르|백 년이었다. 백 년 동안 교단의 봉인에 손끝 하나 댈 수 없었지.^그래서 사람의 손을 빌렸다. 믿음 깊은 사제와, 사슬을 끊을 줄 아는 네크로맨서./고르|정화? 그런 건 처음부터 없었다.^땅이 맑아진 건 네가 그 땅의 주인을 죽였기 때문이다. 그 사제는 그것을 제 기도 덕이라 믿었고./고르바스|너는 풀려난 혼을 그림자로 거느렸지. 나는 산 자의 그림자를 거두었다.^고맙다, 마지막 네크로맨서. 네 덕에 내 심장이 돌아온다./|잿빛 외투가 바닥에 떨어진다. 그 안에는 아무것도 없다.^재 한 줌이 북쪽 하늘로 흩날린다./|군주의 옥좌. 수도원에서 날아온 세 조각과, 초소에서 흩날린 재가 그 위에서 만난다.^오렌이 품었던 조각들이 하나로 붙더니, 붉게 뛰기 시작한다./|심장이 제자리를 찾자, 재가 살이 되고 갑옷이 된다.^백 년 만에, 재의 왕 고르바스가 눈을 뜬다./엘리안|…하르크 씨, 미라… 발밑을 봐요. 그림자가… 없어요. 제 것도요."
        self.Story["scene5_title"] = "문 아래에서 들려온 목소리"
        self.Story["scene5"] = "|심장이 재가 되어 흩어지고, 옥좌의 방에 정적이 내린다.^그때 바닥의 갈라진 틈 아래에서 사슬 끄는 소리가 들린다./오렌|…네크로맨서. 여기는… 춥네.^조각이 나를 이 아래로 끌고 내려왔어. 그가 남긴 게 아직 여기 있어./오렌|숯은… 밥 잘 먹고 있어? 아빠한테 미안하다고 전해 줘.^오지 마. …아니, 언젠가는 와 줘. 그때는 내가 옳은 쪽에 서 있을게./|목소리는 거기서 끊긴다. 붉은 포탈 너머로, 심연은 조금씩 더 깊어지고 있다."
        self.Story["idle_quest_1"] = "두 번째 조각이 사막 어딘가에서 울려. 목소리가 그랬어. …잠은 나중에 자면 돼. 그보다 숯이 요즘 밥을 안 먹네."
        self.Story["idle_quest_2"] = "마지막 조각은 바다 밑에 있대. 이것만 모으면 끝나, 네크로맨서. 이 땅도, 내 죄도. …그러니까 조금만 더 웃자."
        self.Story["idle_smith_0"] = "망치질이 필요하냐. 오렌이 데려온 손님이니 싸게 해 주마. 망자가 들고 있던 녹슨 칼도 손보면 쓸 만하다."
        self.Story["idle_smith_q3"] = "교단 기록에 「다시는 한곳에 모이지 않게」라고 적혀 있었다. …그런데 내 딸은 그걸 모으고 있군."
        self.Story["idle_smith_1"] = "오렌 녀석, 조각을 받고는 눈빛이 달라졌어. 웃고는 있는데… 애비 눈엔 낯설다."
        self.Story["idle_smith_2"] = "어젯밤 그 애가 잿빛 행상이랑 한참 얘기하더군. 숯이 털을 곤두세우고 하악거리는데도 말이야."
        self.Story["idle_smith_3"] = "오렌이 나한테 한마디 없이 배를 탔다. 숯만 카라반에 실어 보내고. 「밥은 하루 두 번」… 그 쪽지 한 장이 다다."
        self.Story["idle_smith_r"] = "발밑을 봐라. 그림자가 없다. 화로 불빛이 날 그냥 지나가. …고르, 그 자식. 숯은 처음부터 알고 있었던 거야."
        self.Story["idle_smith_4"] = "그림자가 돌아왔다. 화로가 다시 뜨거워. 숯이 아직도 북쪽만 본다. …그 애 몫까지 망치질하마."
        self.Story["idle_shop_0"] = "어서 오십시오, 길손. 상처엔 물약, 먼 길엔 두루마리… 운을 시험해 볼 상자도 있지요. 고르의 좌판엔 없는 게 없답니다."
        self.Story["idle_shop_1"] = "사막에서 또 뵙는군요. 장사꾼은 길이 빠르답니다. 사제님은 잘 지내시지요?"
        self.Story["idle_shop_2"] = "바닷바람이 차지요. 조각은 두 개… 아, 아닙니다. 물약이나 고르시지요."
        self.Story["idle_shop_3"] = "북쪽까지 오셨군요. 사제님은 먼저 와 계십니다. 곧, 모든 게 제자리로 돌아갈 겁니다."
        self.Story["idle_qm_r"] = "행상이 재가 됐다고요? …이 좌판은 카라반이 맡겠습니다. 물건이야 원래 우리 마차로 들여오던 거니까요."
        self.Story["idle_qm_4"] = "왕이 쓰러졌다지요. 이제야 손님 얼굴을 편히 보겠군요. 필요한 건 다 있습니다."
        self.Story["idle_merchant_0"] = "떠돌이 상인 사디크요. 짐은 자주 바뀌니 종종 들르시오."
        self.Story["idle_merchant_1"] = "그 잿빛 행상, 어떻게 매번 나보다 먼저 사막 소식을 아는지 모르겠소."
        self.Story["idle_caravan_0"] = "어디로 가겠나? 낙타 등에 짐은 다 실어 놨네."
        self.Story["idle_caravan_1"] = "자네 사제 친구 말일세, 밤마다 조각을 쥐고 뭐라고 중얼거리더군. 기도치곤 좀… 대화 같았네."
        self.Story["idle_caravan_2"] = "비 내린 사막을 다 보는군. 장사 삼십 년에 처음일세. 어디로 가겠나?"
        self.Story["idle_caravan_r"] = "고르가 고르바스였다고? 그 사람과 삼십 년을 같은 길을 다녔는데… 아니, 다녔다고 믿었는데."
        self.Story["idle_caravan_4"] = "카라반이 다시 북쪽 길을 다니네. 자네 덕일세. 어디로 가겠나?"
        self.Story["idle_captain_0"] = "어디로 가겠나? 폭풍이 거세도 이 배는 가라앉지 않네."
        self.Story["idle_captain_3"] = "그 사제가 탄 배? 내 배가 아니야. 잿빛 돛을 단 낡은 배였지. 밤새 소리도 없이 떠났어. 어디로 가겠나?"
        self.Story["idle_captain_4"] = "바다가 이렇게 잔잔한 건 처음 보는군. 어디로 가겠나?"
        self.Story["idle_scout_0"] = "어디로 가겠나? 협곡 아래 샛길은 나만 아네. 악마들 눈에 띄지 않게 데려다주지."
        self.Story["idle_scout_3"] = "협곡 아래 샛길은 나만 아네. …사흘 전 그 사제도 그 길로 올라갔지. 혼자서, 웃으면서. 어디로 가겠나?"
        self.Story["idle_scout_r"] = "옥좌 쪽 하늘이 붉게 뛰고 있군. 심장 소리 같아. 어디로 가겠나?"
        self.Story["idle_scout_4"] = "행군로가 텅 비었네. 정찰 나갈 일이 없으니 오랜만에 다리를 쉬겠군. 어디로 가겠나?"
        self.Story["idle_scholar_0"] = "사원의 비밀은 아직 모래 아래 잠들어 있다. 길이 열리면 자네에게 부탁할 일이 생길 걸세."
        self.Story["idle_scholar_2"] = "기록을 다시 읽어 봤네. 여왕도, 대사제도, 변하기 전에 잿빛 외투의 순례자를 만났더군. 자네 사제 친구에게 꼭 전해 주게."
        self.Story["idle_scholar_r"] = "잿빛 외투의 순례자가 행상 고르였다니. 기록은 처음부터 말하고 있었는데."
        self.Story["idle_apothecary_0"] = "사막에선 물 한 모금이 목숨이에요. 다치면 서두르지 말고 물약부터 챙기세요."
        self.Story["idle_apothecary_2"] = "빗물로 약을 달이게 될 줄은 몰랐어요. 바다로 가신다면 번개를 조심하세요 — 몸을 붙이고 있으면 한꺼번에 맞아요."
        self.Story["idle_harbormaster_0"] = "배가 들어오지 않은 지 한 달이 넘었네. 장부엔 빈칸뿐이야."
        self.Story["idle_harbormaster_3"] = "제독이 가라앉은 뒤로 바다가 잠잠하군. 선장 하그로가 북쪽 마지막 초소까지 데려다줄 걸세."
        self.Story["idle_keeperdaughter_0"] = "등대 불이 꺼진 날부터 아버지가 돌아오지 않았어요."
        self.Story["idle_keeperdaughter_3"] = "아버지 등불을 들고 왔어요. 북쪽 바람에도 꺼지지 않아요. …그런데 요즘 등불을 들어도 발밑이 허전해요."
        self.Story["idle_keeperdaughter_r"] = "등불을 들어도 제 그림자가 안 생겨요. 아버지가 경고한 게 이거였을까요."
        self.Story["idle_keeperdaughter_4"] = "그림자가 돌아왔어요. 이제 아버지 등불로 길 잃은 혼들을 비춰 줄게요."
        self.Story["idle_outpostcaptain_3"] = "울타리가 사흘째 버티고 있다. 대장이 할 일은 버티는 것뿐이지."
        self.Story["idle_outpostcaptain_4"] = "재의 왕이 쓰러진 뒤로 행군이 끊겼다. 그래도 문 아래 어둠은 그대로다 — 악몽에선 더 짙을 거다."
        self.Story["idle_deserter_3"] = "저는 교단을 버렸어요. 그들이 무엇을 나눠 숨겼는지 안 뒤로요. …그 사제가 무엇을 들고 갔는지도요."
        self.Story["idle_deserter_r"] = "제 발밑이 가벼워요. 그가 가져간 거예요. 하르크 씨와 미라의 것까지."
        self.Story["idle_deserter_4"] = "심장이 부서졌어요. 교단이 백 년 동안 못 한 일을… 당신이 했어요. 사제님 몫까지."
        self.Story["cheer_1_quest"] = "느껴져? 무덤들이 조용해졌어! 조각 가져와 줘 — 이 땅을 정화할게. 오늘은 아빠랑 오랜만에 한잔해야겠다."
        self.Story["cheer_1_smith"] = "여왕을 베었다고? 하하, 오늘은 망치 소리가 가볍겠군. 오렌 녀석도 오랜만에 활짝 웃더라. 칼날이 무뎌졌으면 가져와라."
        self.Story["cheer_1_shop"] = "축하드립니다. 여왕의 관에서 나온 돌은… 사제님께 드리셨겠지요? 잘하셨습니다. 정말로요."
        self.Story["cheer_1_merchant"] = "무덤 왕국이 잠들었다니! 이제 남쪽 상인들도 이 길로 올 거요. 장사가 되겠소."
        self.Story["cheer_1_caravan"] = "여왕을 쓰러뜨렸다고? 그럼 사막길을 열지. 내 마차는 언제든 준비돼 있네."
        self.Story["cheer_2_caravan"] = "비가 내린다네, 이 사막에! 내 평생 처음 보는 일일세. 자네 덕이야."
        self.Story["cheer_2_shop"] = "비가 오는군요. 사제님 기도가 효험이 있으신가 봅니다. …두 개째, 맞지요?"
        self.Story["cheer_2_apothecary"] = "비가 와요, 이 사막에! 빗물로 약을 달일 수 있게 됐어요. 고마워요, 정말로. 바다로 가시거든 몸조심하세요."
        self.Story["cheer_2_smith"] = "사막 쇠는 모래가 껴서 골치였는데, 비가 씻어 주는군. …그런데 우리 딸, 요즘 통 잠을 안 잔다. 숯이 밤새 그 애 곁을 지키더군."
        self.Story["cheer_2_scholar"] = "대사제의 성소가 무너졌다니! 기록을 정리해 보니… 잠깐, 순례자 이야기가 또 나오는군. 이상한 일일세."
        self.Story["cheer_2_quest"] = "두 번째 조각이야. 비 오는 거 봤어? 목소리가 옳았어… 옳아야 해."
        self.Story["cheer_3_captain"] = "폭풍이 걷혔어! 이제야 배다운 배를 띄울 수 있겠군. 북쪽이든 어디든 데려다주지."
        self.Story["cheer_3_shop"] = "등대 불이 다시 켜졌군요. 아름답습니다. …이제 세 개가 다 모였네요."
        self.Story["cheer_3_harbormaster"] = "부두에 배가 들어온다네! 장부의 빈칸이 채워지는 걸 이 눈으로 보다니."
