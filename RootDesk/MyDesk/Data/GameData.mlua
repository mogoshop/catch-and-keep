        self.MapInfo["wreckhold"] = { name = "난파선 선창 (Lv 24)", kind = "side", act = 3, w = 24, h = 16, maze = true, flavor = "가라앉은 배의 선창. 집에 돌아가지 못한 혼들이 갇혀 있다.", features = { { kind = "portal", x = -11, y = 0, label = "난파선 해안 (Lv 23~24)", targetMap = "wreckcoast" } } }
