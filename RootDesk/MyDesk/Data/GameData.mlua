-- 자동 생성 파일: tools/gen_data.cjs 가 data/config.csv, difficulty.csv, sounds.csv, monsters.csv, shop.csv, monster_ranks.csv, variants.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 게임 설정값(config.csv 각 행 = 속성), 난이도, 배경음, 몬스터 표시 이름
@Logic
script GameData extends Logic

    property boolean Built = false
    property number deployBase = 5    -- 배치 기본 한도
    property number hardCap = 8    -- 배치 절대 상한 (스킬·장비 보너스 포함)
    property number extractReach = 1.2    -- 혼 추출 가능 거리
    property number shadowStatMul = 0.6    -- 원본 대비 그림자 능력치 배율
    property number shadowLevelGrowth = 0.08    -- 그림자 레벨당 성장률
    property number shadowSourceAtk_g1 = 25    -- 그림자 계산용 원본 공격력 (일반)
    property number shadowSourceAtk_g2 = 50    -- (정예)
    property number shadowSourceAtk_g3 = 100    -- (보스)
    property number shadowSourceHp_g1 = 60    -- 그림자 계산용 원본 생명 (일반)
    property number shadowSourceHp_g2 = 150    -- (정예)
    property number shadowSourceHp_g3 = 600    -- (보스)
    property number respawnDelaySec = 10    -- 사망한 그림자 재소환 대기
    property number disassembleYield_g1 = 1    -- 등급1 분해 시 정수
    property number disassembleYield_g2 = 4    -- 등급2 분해 시 정수
    property number monsterHpPerLevel = 0.3    -- 몬스터 레벨당 체력 증가율 (선형)
    property number monsterDmgPerLevel = 0.2    -- 몬스터 레벨당 공격 증가율 (선형)
    property number eliteHpMul = 3    -- 정예 체력 배율 (최상위 제외)
    property number defConstPerLevel = 100    -- 방어 감소율 = def/(def+이 값×공격자레벨) (시뮬레이터)
    property number resistCap = 75    -- 플레이어 저항 상한 (%)
    property number expCurveCoef = 100    -- expToNext = round(coef × n^exp)
    property number expCurveExp = 2.4    -- 경험치 곡선 지수
    property number levelCap = 80    -- 레벨 상한
    property number statPerLevel = 5    -- 레벨업 능력치 포인트
    property number skillPerLevel = 1    -- 레벨업 스킬 포인트
    property number playerBaseDps = 10    -- 레벨1 플레이어 기본 DPS (시뮬레이터)
    property number playerDpsPerLevel = 0.12    -- 레벨당 DPS 증가율 (시뮬레이터)
    property number playerBaseHp = 60    -- 레벨1 생명
    property number playerHpPerLevel = 1.5    -- 레벨당 생명 (능력치 제외)
    property number aiTickSec = 0.5    -- AI 틱 주기 (시뮬레이터)
    property number depthBaseLevel = 12    -- 심도 1층 몬스터 레벨 기준 (난이도 가산·층 수 별도)
    property number depthMobBase = 8    -- 심도 층당 몬스터 수 = depthMobBase + 층 (최대 depthMobMax)
    property number depthMobMax = 24    -- 
    property number depthEliteBase = 0.15    -- 심도 정예 확률 = depthEliteBase + depthElitePerFloor × 층 (최대 depthEliteMax)
    property number depthElitePerFloor = 0.02    -- 
    property number depthEliteMax = 0.4    -- 
    property number depthUniqueLevelBonus = 3    -- 심도 최상위 몬스터 레벨 가산
    property number deathGoldPctCap = 20    -- 사망 골드 손실 % = 레벨 (최대 이 값) — D2 규칙
    property number deathExpRecover = 0.75    -- 시체를 되찾으면 잃은 경험치 중 회복되는 비율 — D2 규칙
    property number extractMasteryPerLv = 0.015    -- 추출 숙련 레벨당 추출 확률
    property number extractChanceCap = 0.75    -- 추출 확률 상한 (보스 포함)
    property number bossShadowDeployLimit = 1    -- 보스 그림자 동시 소환 수
    property number shadowRefHp = 60    -- 그림자 개성 기준: 일반 몬스터 평균 생명 (원본 생명 / 이 값 = 생명 배율)
    property number shadowRefDmg = 7    -- 그림자 개성 기준: 일반 몬스터 평균 공격 (원본 공격 / 이 값 = 공격 배율)
    property number shadowRatioMin = 0.5    -- 원본 배율 하한
    property number shadowRatioMax = 2.5    -- 원본 배율 상한
    property number shadowCooldownMul = 0.67    -- 그림자 공격 간격 = 원본 공격 간격 × 이 값
    property number shadowSpeedMin = 1    -- 그림자 이동 속도 하한 (주인을 따라가도록)
    property number shadowSpeedMax = 2    -- 그림자 이동 속도 상한
    property number skeletonAtkBase = 6    -- 해골 전사 공격 (스킬 1레벨)
    property number skeletonAtkPerLv = 2    -- 해골 전사 공격 증가/스킬 레벨
    property number skeletonHpBase = 40    -- 해골 전사 생명 (스킬 1레벨)
    property number skeletonHpPerLv = 10    -- 해골 전사 생명 증가/스킬 레벨
    property number skeletonCooldown = 1.1    -- 해골 전사 공격 간격(초)
    property number skeletonSpeed = 1.4    -- 해골 전사 이동 속도
    property number mageAtkBase = 5    -- 해골 마법사 공격 (전부 속성 피해)
    property number mageAtkPerLv = 2    -- 해골 마법사 공격 증가/스킬 레벨
    property number mageHpBase = 25    -- 해골 마법사 생명
    property number mageHpPerLv = 6    -- 해골 마법사 생명 증가/스킬 레벨
    property number mageCooldown = 1.6    -- 해골 마법사 공격 간격(초)
    property number mageRange = 3.5    -- 해골 마법사 사거리
    property number skeletonMasteryPct = 7    -- 해골 숙련 레벨당 공격·생명 %
    property number undeadCountMax = 8    -- 해골 전사·마법사 각각 최대 수 (D2: 스킬 20레벨 = 8)
    property number reviveSeconds = 180    -- 되살림 지속 (D2 180초)
    property number reviveCountMax = 5    -- 되살림 동시 최대 (D2는 스킬 레벨
    property number reviveStatMul = 1    -- 되살림 능력치 배율 (원본 몬스터 그대로)
    property number variantChance = 0.04    -- 스포너 몬스터가 변종 우두머리(오오라·특수 기술)로 나올 확률
    property number auraTickSec = 0.5    -- 오오라 갱신 간격
    property number auraHoldSec = 1.2    -- 오오라 유지 시간 (범위를 벗어나면 이만큼 뒤 사라짐)
    property number iasCap = 75    -- 공격 속도 상한 %
    property number fcrCap = 75    -- 시전 속도 상한 %
    property number baseAttackInterval = 0.45    -- 기본 공격 최소 간격(초) — 공격 속도로 줄어든다
    property number shadowCapBonusMax = 2    -- 세트로 늘릴 수 있는 그림자 상한 합계 최대 (hardCap 8 → 10)
    property number setChance_g1 = 1    -- 일반 몬스터 장비 드롭 중 세트 확률 %
    property number setChance_g2 = 3    -- 정예·변종 세트 확률 %
    property number setChance_g3 = 6    -- 보스 세트 확률 %
    property table Difficulties = {}
    property table Sounds = {}
    property table MonsterNames = {}
    property table DepthPool = {}
    property table Shop = {}
    property table Variants = {}
    property table VariantOrder = {}
    property table MonsterStats = {}
    property table Ranks = {}
    property table DepthUniques = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.Variants = {}
        self.VariantOrder = {}
        self.Variants["aura_might"] = { id = "aura_might", name = "광기 오오라", kind = "aura", effect = "dmg", value = 25, radius = 3, interval = 0, mult = 0, element = "", weight = 1 }
        table.insert(self.VariantOrder, "aura_might")
        self.Variants["aura_haste"] = { id = "aura_haste", name = "질풍 오오라", kind = "aura", effect = "haste", value = 20, radius = 3, interval = 0, mult = 0, element = "", weight = 1 }
        table.insert(self.VariantOrder, "aura_haste")
        self.Variants["aura_guard"] = { id = "aura_guard", name = "수호 오오라", kind = "aura", effect = "guard", value = 20, radius = 3, interval = 0, mult = 0, element = "", weight = 1 }
        table.insert(self.VariantOrder, "aura_guard")
        self.Variants["skill_nova"] = { id = "skill_nova", name = "충격파", kind = "skill", effect = "nova", value = 0, radius = 2, interval = 6, mult = 1.5, element = "", weight = 1 }
        table.insert(self.VariantOrder, "skill_nova")
        self.Variants["skill_frost"] = { id = "skill_frost", name = "냉기 파동", kind = "skill", effect = "nova", value = 0, radius = 2, interval = 7, mult = 1, element = "cold", weight = 1 }
        table.insert(self.VariantOrder, "skill_frost")
        self.Variants["skill_slam"] = { id = "skill_slam", name = "내려찍기", kind = "skill", effect = "nova", value = 0, radius = 2.2, interval = 6, mult = 1.6, element = "", weight = 0 }
        table.insert(self.VariantOrder, "skill_slam")
        self.Ranks = {}
        self.Ranks["normal"] = { name = "일반", hpMul = 1, dmgMul = 1, extract = 0.25, grade = 1 }
        self.Ranks["elite"] = { name = "정예", hpMul = 3, dmgMul = 1.3, extract = 0.15, grade = 2 }
        self.Ranks["champion"] = { name = "무리 우두머리", hpMul = 4, dmgMul = 1.5, extract = 0.15, grade = 2 }
        self.Ranks["unique"] = { name = "최상위", hpMul = 6, dmgMul = 1.8, extract = 0.1, grade = 2 }
        self.Ranks["boss"] = { name = "보스", hpMul = 20, dmgMul = 2, extract = 0.3, grade = 3 }
        self.Shop = {}
        self.Shop["hp"] = { name = "생명 물약", price = 25, perLevel = 0, hpPct = 40, manaPct = 0 }
        self.Shop["mp"] = { name = "마나 물약", price = 25, perLevel = 0, hpPct = 0, manaPct = 50 }
        self.Shop["rv"] = { name = "회복 물약", price = 120, perLevel = 0, hpPct = 35, manaPct = 35 }
        self.Shop["tp"] = { name = "귀환 두루마리", price = 40, perLevel = 0, hpPct = 0, manaPct = 0 }
        self.Shop["gamble"] = { name = "도박", price = 150, perLevel = 30, hpPct = 0, manaPct = 0 }
        self.Difficulties = {}
        self.Difficulties[0] = { id = "normal", name = "보통", suffix = "", levelBonus = 0, resistPenalty = 0, deathExpLossPct = 0 }
        self.Difficulties[1] = { id = "nightmare", name = "악몽", suffix = "_nm", levelBonus = 30, resistPenalty = 30, deathExpLossPct = 5 }
        self.Difficulties[2] = { id = "hell", name = "지옥", suffix = "_hell", levelBonus = 60, resistPenalty = 60, deathExpLossPct = 10 }
        self.Sounds = {}
        self.Sounds["town"] = "93147bcf77494841b8d4478791ed9282"
        self.Sounds["field"] = "8efc5a3200114606a71e907036fe920f"
        self.Sounds["gallows"] = "9ae18480bcc848c496263c4b057f8e6e"
        self.Sounds["crypt"] = "fec06ea8a4a943279acfdba9a1f3a1f8"
        self.Sounds["boss"] = "2a0257f832ee4a7c84c0a8efc9aa5bba"
        self.MonsterNames = {}
        self.MonsterNames["hellhound"] = "지옥견"
        self.MonsterNames["graveworm"] = "무덤 구더기"
        self.MonsterNames["ashen_dead"] = "잿빛 망자병"
        self.MonsterNames["corpse_crow"] = "시체 까마귀"
        self.MonsterNames["skel_warrior"] = "해골 전사"
        self.MonsterNames["starved_wraith"] = "굶주린 악령"
        self.MonsterNames["headsman"] = "목 없는 처형인"
        self.MonsterNames["skel_captain"] = "납골당 지휘관 바르그"
        self.MonsterNames["grave_queen"] = "묘지기 여왕"
        self.MonsterStats = {}
        self.MonsterStats["hellhound"] = { level = 1, hp = 40, dmg = 5, interval = 1.5, speed = 1.5, range = 0.8, element = "fire", ratio = 0.5, resists = "fire=50", behavior = "", stand = "c436866a4cda4f7b8614d2f0a6b36ae5", move = "d436b59499404682aebbb64fbb610a98", innate = "", rank = "normal" }
        self.MonsterStats["graveworm"] = { level = 1, hp = 50, dmg = 5, interval = 1.5, speed = 0.8, range = 0.8, element = "", ratio = 0, resists = "poison=75", behavior = "burrow", stand = "2eccc104f9114701b2bac18a8d7f3845", move = "f5f4d35b8e7f4c6599b6598ec1023c5a", innate = "", rank = "normal" }
        self.MonsterStats["ashen_dead"] = { level = 1, hp = 70, dmg = 7, interval = 1.5, speed = 1, range = 0.8, element = "", ratio = 0, resists = "poison=40,cold=20", behavior = "", stand = "9c27b5511689485ab1b3381a00fcfec6", move = "3799c5aea9dc45b09057cd1adba0e913", innate = "", rank = "normal" }
        self.MonsterStats["corpse_crow"] = { level = 1, hp = 35, dmg = 6, interval = 1.5, speed = 1.8, range = 0.8, element = "", ratio = 0, resists = "", behavior = "hitrun", stand = "5f1a018ca946468a8d3a6dac0d9c4ba8", move = "a408d61514e9476c933bdef0e9e2d0d2", innate = "", rank = "normal" }
        self.MonsterStats["skel_warrior"] = { level = 1, hp = 90, dmg = 9, interval = 1.5, speed = 1.1, range = 0.8, element = "", ratio = 0, resists = "poison=60,cold=30", behavior = "", stand = "0f7660bf15a14a379657c4f35fe10fd0", move = "d247c52315634dba95e5956ca057d06b", innate = "", rank = "normal" }
        self.MonsterStats["starved_wraith"] = { level = 1, hp = 70, dmg = 10, interval = 1.5, speed = 1.6, range = 0.8, element = "cold", ratio = 0.6, resists = "cold=60,magic=30", behavior = "", stand = "15e7b98cec434b269c09e97f550921c3", move = "2f11969b1f694825ac8ad13635711c5b", innate = "", rank = "normal" }
        self.MonsterStats["headsman"] = { level = 1, hp = 600, dmg = 14, interval = 1.5, speed = 1.2, range = 0.8, element = "fire", ratio = 0.4, resists = "fire=40,poison=30", behavior = "", stand = "c68c66cc812e4e4aa9a6f1ffcdc48985", move = "924e249ccb8747dbbe548dc5af908c4f", innate = "aura_might", rank = "unique" }
        self.MonsterStats["skel_captain"] = { level = 1, hp = 800, dmg = 16, interval = 1.5, speed = 1, range = 0.8, element = "cold", ratio = 0.4, resists = "poison=75,cold=40", behavior = "", stand = "ed882269a5d543318ad73e7032632960", move = "94003c3d90dd4fd4866c725b29704169", innate = "aura_guard", rank = "unique" }
        self.MonsterStats["grave_queen"] = { level = 12, hp = 2600, dmg = 18, interval = 1.5, speed = 1, range = 1.2, element = "poison", ratio = 0.5, resists = "poison=60,fire=25", behavior = "", stand = "f4a4aadb84bb4060af45a7ad23f189e5", move = "a97b63a93e6b4be2a6158acc573126bc", innate = "skill_slam", rank = "boss" }
        self.DepthPool = {}
        table.insert(self.DepthPool, "hellhound")
        table.insert(self.DepthPool, "graveworm")
        table.insert(self.DepthPool, "ashendead")
        table.insert(self.DepthPool, "corpsecrow")
        table.insert(self.DepthPool, "skelwarrior")
        table.insert(self.DepthPool, "starvedwraith")
        self.DepthUniques = {}
        table.insert(self.DepthUniques, { every = 10, id = "headsman" })
        table.insert(self.DepthUniques, { every = 5, id = "skelcaptain" })
    end

    method any GetDifficulty(integer index)
        self:Ensure()
        return self.Difficulties[math.max(0, math.min(#self.Difficulties, index))]
    end

    method string GetSound(string key)
        self:Ensure()
        return self.Sounds[key] or ""
    end

    method any GetRank(string rank)
        -- 몬스터 등급 표 (monster_ranks.csv). 모르는 등급은 normal
        self:Ensure()
        return self.Ranks[rank] or self.Ranks["normal"]
    end

    method any GetVariant(string id)
        -- 변종 능력 (variants.csv). 없으면 nil
        self:Ensure()
        if id == nil or id == "" then return nil end
        return self.Variants[id]
    end

    method string RollVariant()
        -- 무작위 변종 (weight 비례, 0은 고유 전용)
        self:Ensure()
        local total = 0
        for _, id in ipairs(self.VariantOrder) do total = total + self.Variants[id].weight end
        if total <= 0 then return "" end
        local roll = _UtilLogic:RandomDouble() * total
        for _, id in ipairs(self.VariantOrder) do
            roll = roll - self.Variants[id].weight
            if roll <= 0 and self.Variants[id].weight > 0 then return id end
        end
        return ""
    end

    method any GetShopItem(string key)
        -- 상점 품목 (shop.csv). 없으면 nil
        self:Ensure()
        return self.Shop[key]
    end

    method any GetMonsterStats(string sourceId)
        -- 원본 몬스터 능력치 (monsters.csv, sourceId 기준). 그림자 개성의 원천. 없으면 nil
        self:Ensure()
        return self.MonsterStats[sourceId]
    end

    method table GetDepthPool()
        -- 심도 던전에 나오는 몬스터 모델 id 목록 (monsters.csv depth=true)
        self:Ensure()
        return self.DepthPool
    end

    method string GetDepthUnique(integer floor)
        -- 이 층에 나올 최상위 몬스터 (monsters.csv depth=everyN, 큰 N 우선). 없으면 ""
        self:Ensure()
        for _, u in ipairs(self.DepthUniques) do
            if floor % u.every == 0 then return u.id end
        end
        return ""
    end

    method string GetMonsterName(string sourceId)
        self:Ensure()
        return self.MonsterNames[sourceId] or sourceId
    end

end
