        self.UiIcons["who_oren_act3"] = "9fb622b31d324e36bc45285846770545"
        self.UiIcons["npc_oren_act1"] = "798726eb974047fdb1bdc5520f23b760"
        self.UiIcons["npc_oren_act2"] = "6d25950646a94d4586fb10658fd5bc9c"
