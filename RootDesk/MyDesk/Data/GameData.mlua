    property table VariantOrder = {}
    property table Archetypes = {}
    property table MonsterStates = {}
    property table Weeklies = {}
    property table WeeklyOrder = {}
    property table MonsterSourceOf = {}
    property table MonsterStats = {}
    property table MonsterFrames = {}
    property table Ranks = {}
    property table DepthUniques = {}
    property table BossSkills = {}

