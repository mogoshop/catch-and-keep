-- 자동 생성 파일: tools/gen_data.cjs 가 data/config.csv, difficulty.csv, sounds.csv, monsters.csv, shop.csv, player_appearance.csv, monster_ranks.csv, variants.csv, maps.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 게임 설정값(config.csv 각 행 = 속성), 난이도, 배경음, 몬스터 표시 이름
@Logic
script GameData extends Logic

    property boolean Built = false
    property number deployBase = 5    -- 배치 기본 한도
    property number hardCap = 8    -- 배치 절대 상한 (스킬·장비 보너스 포함)
    property number extractReach = 1.2    -- 혼 추출 가능 거리
    property number shadowStatMul = 0.6    -- 원본 대비 그림자 능력치 배율
    property number summonGrowthMul = 0.6    -- 해골·마법사·그림자의 레벨 성장 = 몬스터 곡선 × 이 값 (1레벨 능력치는 그대로, Lv10에서 약 -30%)
    property number shadowHpMul = 1.2    -- 원본 대비 그림자 생명 배율 (공격은 shadowStatMul). 레벨 성장은 몬스터와 같은 곡선(monsterHpPerLevel·monsterDmgPerLevel)
    property number shadowSourceAtk_g1 = 25    -- 그림자 계산용 원본 공격력 (일반)
    property number shadowSourceAtk_g2 = 50    -- (정예)
    property number shadowSourceAtk_g3 = 100    -- (보스)
    property number shadowSourceHp_g1 = 60    -- 그림자 계산용 원본 생명 (일반)
    property number shadowSourceHp_g2 = 150    -- (정예)
    property number shadowSourceHp_g3 = 600    -- (보스)
    property number respawnDelaySec = 10    -- 사망한 그림자 재소환 대기
    property number disassembleYield_g1 = 1    -- 등급1 분해 시 정수
    property number disassembleYield_g2 = 4    -- 등급2 분해 시 정수
    property number monsterHpPerLevel = 0.3    -- 몬스터 레벨당 체력 증가율 (선형)
    property number monsterDmgPerLevel = 0.2    -- 몬스터 레벨당 공격 증가율 (선형)
    property number eliteHpMul = 3    -- 정예 체력 배율 (최상위 제외)
    property number defConstPerLevel = 100    -- 방어 감소율 = def/(def+이 값×공격자레벨) (시뮬레이터)
    property number resistCap = 75    -- 플레이어 저항 상한 (%)
    property number expCurveCoef = 100    -- expToNext = round(coef × n^exp)
    property number expCurveExp = 2.4    -- 경험치 곡선 지수
    property number levelCap = 80    -- 레벨 상한
    property number statPerLevel = 5    -- 레벨업 능력치 포인트
    property number skillPerLevel = 1    -- 레벨업 스킬 포인트
    property number playerBaseDps = 10    -- 레벨1 플레이어 기본 DPS (시뮬레이터)
    property number playerDpsPerLevel = 0.12    -- 레벨당 DPS 증가율 (시뮬레이터)
    property number playerBaseHp = 60    -- 레벨1 생명
    property number playerHpPerLevel = 1.5    -- 레벨당 생명 (능력치 제외)
    property number aiTickSec = 0.5    -- AI 틱 주기 (시뮬레이터)
    property number depthBaseLevel = 12    -- 심도 1층 몬스터 레벨 기준 (난이도 가산·층 수 별도)
    property number depthMobBase = 8    -- 심도 층당 몬스터 수 = depthMobBase + 층 (최대 depthMobMax)
    property number depthMobMax = 24    -- 
    property number depthEliteBase = 0.15    -- 심도 정예 확률 = depthEliteBase + depthElitePerFloor × 층 (최대 depthEliteMax)
    property number depthElitePerFloor = 0.02    -- 
    property number depthEliteMax = 0.4    -- 
    property number depthUniqueLevelBonus = 3    -- 심도 최상위 몬스터 레벨 가산
    property number depthMinLevel = 8    -- 심도 입장 최소 레벨 (그 아래는 입구가 막는다)
    property number depthEnterDwell = 2    -- 심도 입구·다음 층 문 위에 이만큼(초) 머물러야 이동 (지나가다 실수로 들어가지 않게)
    property number depthSafeRadius = 3.2    -- 심도 도착 지점(0,0)에서 이 거리 안에는 몬스터를 만들지 않는다
    property number deathGoldPctCap = 20    -- 사망 골드 손실 % = 레벨 (최대 이 값) — D2 규칙
    property number deathExpRecover = 0.75    -- 시체를 되찾으면 잃은 경험치 중 회복되는 비율 — D2 규칙
    property number earlyExpLevel = 5    -- 이 레벨 미만에서는 처치 경험치를 earlyExpMult배 (그림자 해금 Lv5까지 약 12분 — 핵심 재미를 빨리 보게)
    property number earlyExpMult = 1.5    -- 초반 처치 경험치 배율
    property number extractMasteryPerLv = 0.015    -- 추출 숙련 레벨당 추출 확률
    property number extractChanceCap = 0.75    -- 추출 확률 상한 (보스 포함)
    property number bossShadowDeployLimit = 1    -- 보스 그림자 동시 소환 수
    property number shadowRefHp = 60    -- 그림자 개성 기준: 일반 몬스터 평균 생명 (원본 생명 / 이 값 = 생명 배율)
    property number shadowRefDmg = 7    -- 그림자 개성 기준: 일반 몬스터 평균 공격 (원본 공격 / 이 값 = 공격 배율)
    property number shadowRatioMin = 0.5    -- 원본 배율 하한
    property number shadowRatioMax = 2.5    -- 원본 배율 상한
    property number shadowCooldownMul = 0.67    -- 그림자 공격 간격 = 원본 공격 간격 × 이 값
    property number shadowSpeedMin = 1    -- 그림자 이동 속도 하한 (주인을 따라가도록)
    property number shadowSpeedMax = 2    -- 그림자 이동 속도 상한
    property number skeletonAtkBase = 6    -- 해골 전사 공격 (스킬 1레벨)
    property number skeletonHpBase = 40    -- 해골 전사 생명 (스킬 1레벨)
    property number skeletonCooldown = 1.1    -- 해골 전사 공격 간격(초)
    property number skeletonSpeed = 1.4    -- 해골 전사 이동 속도
    property number mageAtkBase = 5    -- 해골 마법사 공격 (전부 속성 피해)
    property number mageHpBase = 25    -- 해골 마법사 생명
    property number undeadSkillLvPct = 10    -- 해골·마법사 스킬 레벨당 공격·생명 % (1레벨 기준). 기본값은 주인 레벨에 맞춰 몬스터와 같은 곡선으로 큰다
    property number mageCooldown = 1.6    -- 해골 마법사 공격 간격(초)
    property number mageRange = 3.5    -- 해골 마법사 사거리
    property number skeletonMasteryPct = 5    -- 해골 숙련 레벨당 공격·생명 %
    property number undeadCountMax = 8    -- 해골 전사·마법사 각각 최대 수 (D2: 스킬 20레벨 = 8)
    property number reviveSeconds = 180    -- 되살림 지속 (D2 180초)
    property number reviveCountMax = 5    -- 되살림 동시 최대 (D2는 스킬 레벨, 서버 부하로 5 제한)
    property number reviveStatMul = 1    -- 되살림 능력치 배율 (원본 몬스터 그대로)
    property number reviveStatPerLvPct = 3    -- 되살림 추가 스킬 레벨당 공격력·생명 증가율 (1레벨 기준)
    property number enfeebleBasePct = 25    -- 쇠약 1레벨 적 공격력 감소율
    property number enfeeblePerLvPct = 1    -- 쇠약 추가 스킬 레벨당 공격력 감소율 증가
    property number elitePromoteBaseMul = 1.35    -- 정예 승격 1레벨 공격력·생명 배율
    property number elitePromotePerLvMul = 0.035    -- 정예 승격 추가 스킬 레벨당 배율 증가
    property number commandMasteryPct = 5.5    -- 군령 숙련 레벨당 그림자 공격력·생명 증가율
    property number shadowSummonPerLvPct = 3    -- 그림자 소환 추가 스킬 레벨당 공격력·생명 증가율
    property number variantChance = 0.032    -- 스포너 몬스터가 변종 우두머리(오오라·특수 기술)로 나올 확률
    property number auraTickSec = 0.5    -- 오오라 갱신 간격
    property number auraHoldSec = 1.2    -- 오오라 유지 시간 (범위를 벗어나면 이만큼 뒤 사라짐)
    property number iasCap = 75    -- 공격 속도 상한 %
    property number fcrCap = 75    -- 시전 속도 상한 %
    property number baseAttackInterval = 0.45    -- 기본 공격 최소 간격(초) — 공격 속도로 줄어든다
    property number basicCritPerDex = 0.14    -- 민첩 1당 평타 치명타 확률 증가(%p) — 주문·소환수 제외 (10-09 30% 하향)
    property number basicCritChanceCap = 40    -- 평타 치명타 확률 상한(%)
    property number basicCritMultiplier = 1.5    -- 평타 치명타 피해 배율
    property number shadowCapBonusMax = 2    -- 세트로 늘릴 수 있는 그림자 상한 합계 최대 (hardCap 8 → 10)
    property number shadowFullLevel = 15    -- 이 캐릭터 레벨 전에는 그림자 배치가 shadowEarlyDeployLimit로 묶인다 (Lv5 맛보기 → Lv15 본격)
    property number shadowEarlyDeployLimit = 1    -- Lv15 전 그림자 동시 배치 수
    property number bossExclusiveShare = 0.5    -- 보스·최상위가 유니크를 떨굴 때 그 몬스터 전용 유니크일 확률
    property number townArrivalX = 0    -- 마을 도착 위치 x (귀환·사망 부활·포털)
    property number townArrivalY = -1.6    -- 마을 도착 위치 y (출구 안내 반경 1.8 밖 — 도착하자마자 출구 안내가 뜨지 않게)
    property number townExitY = -4    -- 마을 → 사냥터 출구 포털 y (맵 빌드)
    property number respawnHideRadius = 6    -- 리스폰 시 이 거리 안에 플레이어가 있으면 미룬다 (화면 밖에서만 되살아나게. 9칸은 사냥 중인 곳이 계속 비었다)
    property number packRadius = 1.4    -- 무리 몬스터가 무리 중심에서 흩어지는 반경
    property number packLeaderChance = 0.2    -- 무리 첫 몬스터가 정예 우두머리로 나올 확률 (나머지는 호위)
    property number packMixChance = 0.35    -- 무리에 같은 맵의 다른 종류가 섞일 확률 (3마리 중 1마리꼴)
    property number hordeChance = 0.06    -- 무리가 두 배 크기의 큰 무리로 나올 확률 (같은 출현 수 안에서)
    property number knockbackSec = 0.12    -- 넉백 시간(초)
    property number knockbackSpeed = 5    -- 넉백 중 이동 속도 (InputSpeed)
    property number knockbackMinionMul = 0    -- 소환수(그림자·언데드)가 친 넉백 배율 (0 = 없음. 다수 타격으로 몬스터가 묶이지 않게)
    property number hitRecoverPct = 0.125    -- 한 번에 최대 생명의 이 비율 이상 맞으면 경직 (D2 hit recovery)
    property number staggerSec = 0.3    -- 경직 시간(초): 피격 모션·이동·공격 멈춤
    property number heavyHitPct = 0.3    -- 최대 생명의 이 비율 이상 피해 = 강타 (큰 타격 이펙트·화면 흔들림)
    property number playerSpeedMul = 1.44    -- 플레이어 기본 이동 속도 배율 (모델 InputSpeed × 이 값)
    property number darkMinAmbient = 0.32    -- 어두운 맵 전체 밝기 하한 (0.2는 길·바닥이 거의 안 보임 — 메이커 확인 2026-10-09)
    property number darkMinLightRadius = 5.2    -- 플레이어 주변 밝은 범위 하한 (월드 단위)
    property number densityRewardMult = 0.72    -- 몬스터 수를 40% 늘린 만큼 일반·정예 몬스터의 처치 경험치·드롭 추첨을 줄이는 배율 (보스·고유는 그대로)
    property number strDmgPct = 0.7    -- 힘 1당 평타 물리 피해 % (10-09: 1 → 0.7)
    property number vitLife = 2    -- 활력 1당 최대 생명 (10-09: 3 → 2 · D2 네크로맨서와 같음)
    property number eneMana = 2    -- 정신 1당 최대 마나 (D2 네크로맨서와 같음)
    property number eneSpellPct = 0.7    -- 정신 1당 주문력 % (10-09: 1 → 0.7)
    property number dexPerDefense = 4    -- 민첩 이만큼마다 방어 +1 (D2 규칙)
    property number dexIasPct = 0.15    -- 민첩 1당 공격 속도 %
    property number gearMult = 0.7    -- 새로 생기는 장비 옵션·세트 조각·유니크 수치 배율 (10-09 30% 하향 · 이미 가진 장비는 그대로)
    property number gearTierNormal = 0.6    -- 아이템 레벨 30 이하(보통 난이도) 무작위 옵션 상한 배율 — D2처럼 난이도별 최대치
    property number gearTierNightmare = 0.8    -- 아이템 레벨 31~60(악몽) 무작위 옵션 상한 배율
    property number uniqueRollMin = 0.75    -- 유니크·세트 수치는 표기의 이 비율 ~ 100% 사이에서 무작위
    property number skillPowerMult = 0.7    -- 스킬 피해·비율 효과 배율 (10-09 30% 하향 · 지속 시간·수는 그대로)
    property number shadowPlusPct = 6    -- 그림자 강화 +1당 공격·생명 % (레벨과 별개)
    property number shadowPlusMax = 10    -- 그림자 강화 최대 +N
    property number shadowPlusCostBase = 3    -- 그림자 강화 비용 (정수) = base + step × 현재 강화
    property number shadowPlusCostStep = 2    -- 그림자 강화 비용 증가
    property number shadowExpBase = 40    -- 그림자 레벨 n→n+1 경험치 = base × n^exp
    property number shadowExpExp = 1.8    -- 그림자 경험치 곡선 지수
    property number shadowExpShare = 0.6    -- 처치 경험치 중 소환 중인 그림자가 각각 받는 비율
    property number punchChance = 0.5    -- 대장장이 골드 소켓 뚫기 성공 확률 (의뢰 소켓권은 항상 성공)
    property number merchantRefreshSec = 600    -- 떠돌이 상인 물건이 바뀌는 간격(초)
    property number merchantPriceMult = 5    -- 떠돌이 상인 가격 = 판매가 × 이 값
    property number shrineSeconds = 60    -- 신전 축복 지속(초)
    property number shrineRefreshSec = 180    -- 쓴 신전이 다시 빛나는 데 걸리는 시간(초)
    property number eventShrines = 2    -- 사냥터 하나의 신전 수 (곁가지 던전은 1)
    property number eventChests = 1    -- 사냥터 하나의 저주받은 상자 수
    property number eventNests = 1    -- 사냥터 하나의 뼈 둥지 수 (곁가지 던전은 0)
    property number rareUniqueChance = 0.2    -- 맵에 들어설 때 드문 최상위 몬스터(호위 3)가 나올 확률
    property number nestInterval = 7    -- 뼈 둥지가 졸개를 낳는 간격(초) — 플레이어가 가까이 있을 때만
    property number nestMaxAlive = 4    -- 뼈 둥지 하나가 동시에 거느리는 졸개 수
    property number chestAmbush = 4    -- 저주받은 상자를 열면 나오는 습격 무리 수 (+정예 우두머리 1)
    property table PlayerAppearance = {}
    property table Difficulties = {}
    property table Sounds = {}
    property table MonsterNames = {}
    property table DepthPool = {}
    property table MapSpawns = {}
    property table MapInfo = {}
    property table UiIcons = {}
    property table Shop = {}
    property table Variants = {}
    property table VariantOrder = {}
    property table MonsterSourceOf = {}
    property table MonsterStats = {}
    property table Ranks = {}
    property table DepthUniques = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.PlayerAppearance = {}
        self.PlayerAppearance["body"] = "f3ab6f5110294f03925699374cc467ac"
        self.PlayerAppearance["hair"] = "e3ceb481d2c441509650c004ca51f0ec"
        self.PlayerAppearance["face"] = "a0e3b1bb30d5497fbcac23a9c1027237"
        self.PlayerAppearance["ear"] = ""
        self.Variants = {}
        self.VariantOrder = {}
        self.Variants["aura_might"] = { id = "aura_might", name = "광기 오오라", kind = "aura", effect = "dmg", value = 25, radius = 3, interval = 0, mult = 0, element = "", weight = 0.6 }
        table.insert(self.VariantOrder, "aura_might")
        self.Variants["aura_haste"] = { id = "aura_haste", name = "질풍 오오라", kind = "aura", effect = "haste", value = 20, radius = 3, interval = 0, mult = 0, element = "", weight = 0.6 }
        table.insert(self.VariantOrder, "aura_haste")
        self.Variants["aura_guard"] = { id = "aura_guard", name = "수호 오오라", kind = "aura", effect = "guard", value = 20, radius = 3, interval = 0, mult = 0, element = "", weight = 0.6 }
        table.insert(self.VariantOrder, "aura_guard")
        self.Variants["skill_nova"] = { id = "skill_nova", name = "충격파", kind = "skill", effect = "nova", value = 0, radius = 2, interval = 6, mult = 1.5, element = "", weight = 1 }
        table.insert(self.VariantOrder, "skill_nova")
        self.Variants["skill_frost"] = { id = "skill_frost", name = "냉기 파동", kind = "skill", effect = "nova", value = 0, radius = 2, interval = 7, mult = 1, element = "cold", weight = 1 }
        table.insert(self.VariantOrder, "skill_frost")
        self.Variants["skill_slam"] = { id = "skill_slam", name = "내려찍기", kind = "skill", effect = "nova", value = 0, radius = 2.2, interval = 6, mult = 1.6, element = "", weight = 0 }
        table.insert(self.VariantOrder, "skill_slam")
        self.Variants["skill_fire"] = { id = "skill_fire", name = "화염 폭발", kind = "skill", effect = "nova", value = 0, radius = 2, interval = 6, mult = 1.4, element = "fire", weight = 1 }
