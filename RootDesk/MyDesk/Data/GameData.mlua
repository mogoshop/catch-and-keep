-- 자동 생성 파일: tools/gen_data.cjs 가 data/config.csv, difficulty.csv, sounds.csv, monsters.csv, shop.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 게임 설정값(config.csv 각 행 = 속성), 난이도, 배경음, 몬스터 표시 이름
@Logic
script GameData extends Logic

    property boolean Built = false
    property number deployBase = 5    -- 배치 기본 한도
    property number hardCap = 8    -- 배치 절대 상한 (스킬·장비 보너스 포함)
    property number extractChance_g1 = 0.35    -- 일반 몬스터 추출 확률 (능동 추출)
    property number extractChance_g2 = 0.2    -- 정예 추출 확률
    property number extractReach = 1.2    -- 혼 추출 가능 거리
    property number shadowStatMul = 0.6    -- 원본 대비 그림자 능력치 배율
    property number shadowLevelGrowth = 0.08    -- 그림자 레벨당 성장률
    property number shadowSourceAtk_g1 = 25    -- 그림자 계산용 원본 공격력 (일반)
    property number shadowSourceAtk_g2 = 50    -- (정예)
    property number shadowSourceAtk_g3 = 100    -- (보스)
    property number shadowSourceHp_g1 = 60    -- 그림자 계산용 원본 생명 (일반)
    property number shadowSourceHp_g2 = 150    -- (정예)
    property number shadowSourceHp_g3 = 600    -- (보스)
    property number respawnDelaySec = 10    -- 사망한 그림자 재소환 대기
    property number disassembleYield_g1 = 1    -- 등급1 분해 시 정수
    property number disassembleYield_g2 = 4    -- 등급2 분해 시 정수
    property number monsterHpPerLevel = 0.3    -- 몬스터 레벨당 체력 증가율 (선형)
    property number monsterDmgPerLevel = 0.2    -- 몬스터 레벨당 공격 증가율 (선형)
    property number eliteHpMul = 3    -- 정예 체력 배율 (최상위 제외)
    property number defConstPerLevel = 100    -- 방어 감소율 = def/(def+이 값×공격자레벨) (시뮬레이터)
    property number resistCap = 75    -- 플레이어 저항 상한 (%)
    property number expCurveCoef = 100    -- expToNext = round(coef × n^exp)
    property number expCurveExp = 2.4    -- 경험치 곡선 지수
    property number levelCap = 80    -- 레벨 상한
    property number statPerLevel = 5    -- 레벨업 능력치 포인트
    property number skillPerLevel = 1    -- 레벨업 스킬 포인트
    property number playerBaseDps = 10    -- 레벨1 플레이어 기본 DPS (시뮬레이터)
    property number playerDpsPerLevel = 0.12    -- 레벨당 DPS 증가율 (시뮬레이터)
    property number playerBaseHp = 60    -- 레벨1 생명
    property number playerHpPerLevel = 1.5    -- 레벨당 생명 (능력치 제외)
    property number aiTickSec = 0.5    -- AI 틱 주기 (시뮬레이터)
    property number depthBaseLevel = 12    -- 심도 1층 몬스터 레벨 기준 (난이도 가산·층 수 별도)
    property number depthMobBase = 8    -- 심도 층당 몬스터 수 = depthMobBase + 층 (최대 depthMobMax)
    property number depthMobMax = 24    -- 
    property number depthEliteBase = 0.15    -- 심도 정예 확률 = depthEliteBase + depthElitePerFloor × 층 (최대 depthEliteMax)
    property number depthElitePerFloor = 0.02    -- 
    property number depthEliteMax = 0.4    -- 
    property number depthUniqueLevelBonus = 3    -- 심도 최상위 몬스터 레벨 가산
    property number deathGoldPctCap = 20    -- 사망 골드 손실 % = 레벨 (최대 이 값) — D2 규칙
    property number deathExpRecover = 0.75    -- 시체를 되찾으면 잃은 경험치 중 회복되는 비율 — D2 규칙
    property table Difficulties = {}
    property table Sounds = {}
    property table MonsterNames = {}
    property table DepthPool = {}
    property table Shop = {}
    property table DepthUniques = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.Shop = {}
        self.Shop["hp"] = { name = "생명 물약", price = 25, perLevel = 0, hpPct = 40, manaPct = 0 }
        self.Shop["mp"] = { name = "마나 물약", price = 25, perLevel = 0, hpPct = 0, manaPct = 50 }
        self.Shop["rv"] = { name = "회복 물약", price = 120, perLevel = 0, hpPct = 35, manaPct = 35 }
        self.Shop["tp"] = { name = "귀환 두루마리", price = 40, perLevel = 0, hpPct = 0, manaPct = 0 }
        self.Shop["gamble"] = { name = "도박", price = 150, perLevel = 30, hpPct = 0, manaPct = 0 }
        self.Difficulties = {}
        self.Difficulties[0] = { id = "normal", name = "보통", suffix = "", levelBonus = 0, resistPenalty = 0, deathExpLossPct = 0 }
        self.Difficulties[1] = { id = "nightmare", name = "악몽", suffix = "_nm", levelBonus = 30, resistPenalty = 30, deathExpLossPct = 5 }
        self.Difficulties[2] = { id = "hell", name = "지옥", suffix = "_hell", levelBonus = 60, resistPenalty = 60, deathExpLossPct = 10 }
        self.Sounds = {}
        self.Sounds["town"] = "93147bcf77494841b8d4478791ed9282"
        self.Sounds["field"] = "8efc5a3200114606a71e907036fe920f"
        self.Sounds["gallows"] = "9ae18480bcc848c496263c4b057f8e6e"
        self.Sounds["crypt"] = "fec06ea8a4a943279acfdba9a1f3a1f8"
        self.Sounds["boss"] = "2a0257f832ee4a7c84c0a8efc9aa5bba"
        self.MonsterNames = {}
        self.MonsterNames["hellhound"] = "지옥견"
        self.MonsterNames["graveworm"] = "무덤 구더기"
        self.MonsterNames["ashen_dead"] = "잿빛 망자병"
        self.MonsterNames["corpse_crow"] = "시체 까마귀"
        self.MonsterNames["skel_warrior"] = "해골 전사"
        self.MonsterNames["starved_wraith"] = "굶주린 악령"
        self.MonsterNames["headsman"] = "목 없는 처형인"
        self.MonsterNames["skel_captain"] = "납골당 지휘관 바르그"
        self.MonsterNames["grave_queen"] = "묘지기 여왕"
        self.DepthPool = {}
        table.insert(self.DepthPool, "hellhound")
        table.insert(self.DepthPool, "graveworm")
        table.insert(self.DepthPool, "ashendead")
        table.insert(self.DepthPool, "corpsecrow")
        table.insert(self.DepthPool, "skelwarrior")
        table.insert(self.DepthPool, "starvedwraith")
        self.DepthUniques = {}
        table.insert(self.DepthUniques, { every = 10, id = "headsman" })
        table.insert(self.DepthUniques, { every = 5, id = "skelcaptain" })
    end

    method any GetDifficulty(integer index)
        self:Ensure()
        return self.Difficulties[math.max(0, math.min(#self.Difficulties, index))]
    end

    method string GetSound(string key)
        self:Ensure()
        return self.Sounds[key] or ""
    end

    method any GetShopItem(string key)
        -- 상점 품목 (shop.csv). 없으면 nil
        self:Ensure()
        return self.Shop[key]
    end

    method table GetDepthPool()
        -- 심도 던전에 나오는 몬스터 모델 id 목록 (monsters.csv depth=true)
        self:Ensure()
        return self.DepthPool
    end

    method string GetDepthUnique(integer floor)
        -- 이 층에 나올 최상위 몬스터 (monsters.csv depth=everyN, 큰 N 우선). 없으면 ""
        self:Ensure()
        for _, u in ipairs(self.DepthUniques) do
            if floor % u.every == 0 then return u.id end
        end
        return ""
    end

    method string GetMonsterName(string sourceId)
        self:Ensure()
        return self.MonsterNames[sourceId] or sourceId
    end

end
