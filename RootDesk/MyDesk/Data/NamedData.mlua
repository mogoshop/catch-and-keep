-- 자동 생성 파일: tools/gen_data.cjs 가 data/named.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 이름 있는 적 (곁가지 끝방 우두머리·의식의 주인)과 봉인 상자 배치. place: end(맵 끝방) / ritual(제단 의식 마지막)
@Logic
script NamedData extends Logic

    property boolean Built = false
    property table List = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { id = "", name = "", model = "", map = "hollow", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "" })
        table.insert(self.List, { id = "morg", name = "썩은 사제 모르그", model = "rotzombie", map = "cellar2", place = "end", levelAdd = 2, hpMul = 4, tint = "0.55,0.8,0.45", scale = 1.35, escort = "graveworm", escortCount = 4, chest = true, key = "" })
        table.insert(self.List, { id = "relic_keeper", name = "유물 지기", model = "ashendead", map = "pit2", place = "end", levelAdd = 2, hpMul = 4, tint = "0.95,0.8,0.45", scale = 1.35, escort = "ashendead", escortCount = 4, chest = true, key = "" })
        table.insert(self.List, { id = "", name = "", model = "", map = "cave", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "headsman" })
        table.insert(self.List, { id = "blood_priest", name = "피의 사제", model = "cultarcher", map = "gallows", place = "ritual", levelAdd = 3, hpMul = 9, tint = "1,0.35,0.35", scale = 1.4, escort = "skelwarrior", escortCount = 2, chest = false, key = "" })
    end

    method table ForMap(string mapId)
        -- 그 맵(보통 맵 id)의 행 목록
        self:Ensure()
        local out = {}
        for _, r in ipairs(self.List) do if r.map == mapId then table.insert(out, r) end end
        return out
    end

    method any Get(string id)
        self:Ensure()
        for _, r in ipairs(self.List) do if r.id == id and id ~= "" then return r end end
        return nil
    end

end
