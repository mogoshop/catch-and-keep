-- 자동 생성 파일: tools/gen_data.cjs 가 data/named.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 이름 있는 적 (곁가지 끝방 우두머리·의식의 주인)과 봉인 상자 배치. place: end(맵 끝방) / ritual(제단 의식 마지막)
@Logic
script NamedData extends Logic

    property boolean Built = false
    property table List = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { id = "", name = "", model = "", map = "hollow", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "" })
        table.insert(self.List, { id = "morg", name = "썩은 사제 모르그", model = "morg", map = "cellar2", place = "end", levelAdd = 2, hpMul = 4, tint = "", scale = 0.83, escort = "graveworm", escortCount = 4, chest = true, key = "" })
        table.insert(self.List, { id = "relic_keeper", name = "유물 지기", model = "relickeeper", map = "pit2", place = "end", levelAdd = 2, hpMul = 4, tint = "", scale = 0.83, escort = "ashendead", escortCount = 4, chest = true, key = "" })
        table.insert(self.List, { id = "", name = "", model = "", map = "cave", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "headsman" })
        table.insert(self.List, { id = "blood_priest", name = "피의 사제", model = "bloodpriest", map = "gallows", place = "ritual", levelAdd = 3, hpMul = 9, tint = "", scale = 1, escort = "skelwarrior", escortCount = 2, chest = false, key = "" })
        table.insert(self.List, { id = "serka", name = "독침 여왕 세르카", model = "serka", map = "scorpnest2", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.82, escort = "sandscorp", escortCount = 3, chest = true, key = "" })
        table.insert(self.List, { id = "", name = "", model = "", map = "drywell", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "" })
        table.insert(self.List, { id = "tombking", name = "묘실 수호왕", model = "tombking", map = "kingtomb2", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.85, escort = "mummy", escortCount = 4, chest = true, key = "tomb_king" })
        table.insert(self.List, { id = "librarian", name = "서고의 불꽃 사서", model = "librarian", map = "archive", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.88, escort = "firecultist", escortCount = 3, chest = true, key = "" })
        table.insert(self.List, { id = "", name = "", model = "", map = "vipernest", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "" })
        table.insert(self.List, { id = "crab_king", name = "바위 집게 왕", model = "crabking", map = "crabcave2", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.62, escort = "stormcrab", escortCount = 3, chest = true, key = "" })
        table.insert(self.List, { id = "", name = "", model = "", map = "wreckhold", place = "end", levelAdd = 0, hpMul = 1, tint = "", scale = 1, escort = "", escortCount = 0, chest = true, key = "" })
        table.insert(self.List, { id = "smuggler_boss", name = "밀수꾼 두목 렌", model = "smugglerboss", map = "smuggler2", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.8, escort = "drownedsailor", escortCount = 3, chest = true, key = "smuggler_boss" })
        table.insert(self.List, { id = "drowned_priest", name = "물에 잠긴 사제", model = "drownedpriest", map = "seachapel", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.95, escort = "brinewitch", escortCount = 3, chest = true, key = "" })
        table.insert(self.List, { id = "mad_keeper", name = "미친 등대지기 하울", model = "madkeeper", map = "keeperhouse", place = "end", levelAdd = 2, hpMul = 1, tint = "", scale = 0.75, escort = "stormcaller", escortCount = 2, chest = true, key = "" })
    end

    method table ForMap(string mapId)
        -- 그 맵(보통 맵 id)의 행 목록
        self:Ensure()
        local out = {}
        for _, r in ipairs(self.List) do if r.map == mapId then table.insert(out, r) end end
        return out
    end

    method any Get(string id)
        self:Ensure()
        for _, r in ipairs(self.List) do if r.id == id and id ~= "" then return r end end
        return nil
    end

end
