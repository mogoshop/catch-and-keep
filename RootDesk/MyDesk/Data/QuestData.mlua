-- 자동 생성 파일: tools/gen_data.cjs 가 data/quests.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 의뢰 목록 (순서대로 진행). kind: kill / extract / reach / raise / clear(맵 전멸) / boss(이름 있는 적) / ritual(제단 의식) / chest(열쇠 → 봉인 상자). act = 액트
@Logic
script QuestData extends Logic

    property boolean Built = false
    property table List = {}
    property table Givers = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { title = "굶주린 굴", desc = "피 묻은 황무지 곁가지 「굶주린 굴」에 숨어든 망자를 하나도 남김없이 쓰러뜨려라. (남은 수가 표시된다)", zone = "굶주린 굴", objective = "굴 안의 망자 모두 처치", kind = "clear", target = "hollow", map = "hollow", map1 = "", giver = "quest", act = 1, count = 1, exp = 1500, gold = 80, reward = "skp:1", intro = "…또 하나의 망자가 깨어났군. 아니, 넌 숨을 쉬고 있구나. 네크로맨서인가?/나는 오렌. 교단에서 쫓겨난 사제다. 피 묻은 황무지 북동쪽 바위틈에 「굶주린 굴」이 있다. 망자들이 거기서 기어 나오지./굴 안의 놈들을 하나도 남김없이 쓰러뜨려라. 죽은 자의 혼이 남거든 해골로 일으켜 부려도 좋다. 굴이 조용해지면 네 힘을 인정하지.", outro = "굴이 조용해졌군. 혼각의 기운이 너에게 응답하고 있다./배운 것을 정리할 시간을 주지. 네 기술이 한 단계 깊어질 거다." })
        table.insert(self.List, { title = "가라앉은 지하실의 수장", desc = "썩은 갈대 늪 곁가지 「가라앉은 지하실」 2층 끝의 「썩은 사제 모르그」를 쓰러뜨려라.", zone = "가라앉은 지하실 2층", objective = "썩은 사제 모르그 처치", kind = "boss", target = "morg", map = "cellar2", map1 = "", giver = "quest", act = 1, count = 1, exp = 0, gold = 200, reward = "deploy:1", intro = "늪 아래 가라앉은 지하실에서 교단의 옛 사제 하나가 망자들을 부리고 있다./모르그. 나와 같은 교단에 있던 자다. 놈은 죽은 자를 부리는 법을 반쯤만 배웠지./지하실 2층 끝에서 놈을 쓰러뜨려라. 놈의 지팡이에 묶인 혼들이 네 그림자 곁으로 오게 될 거다.", outro = "모르그가 쓰러졌군. 놈이 묶어 두던 혼들이 네 그림자 곁으로 모여든다./이제 그림자를 하나 더 거느릴 수 있다. 악몽과 지옥에서도 놈을 쓰러뜨리면 그때마다 하나씩 더 늘어날 거다." })
        table.insert(self.List, { title = "사라진 병사의 유물", desc = "무너진 형장 곁가지 「뼈 구덩이」 2층의 「유물 지기」를 쓰러뜨리고 교단의 유물을 되찾아라.", zone = "뼈 구덩이 2층", objective = "유물 지기 처치 → 교단의 유물 회수", kind = "boss", target = "relic_keeper", map = "pit2", map1 = "", giver = "smith", act = 1, count = 1, exp = 0, gold = 300, reward = "gen:3,socket:1", intro = "네가 오렌이 말하던 네크로맨서군. 나는 하르크, 이 야영지의 대장장이다./형장 아래 뼈 구덩이에 교단의 유물을 끌어안은 망자가 있다. 다들 「유물 지기」라 부르지./놈을 쓰러뜨리고 유물을 가져와라. 대가로 좋은 물건을 하나 골라 주고, 소켓도 하나 공짜로 뚫어 주마.", outro = "이게 교단의 유물인가… 무겁군. 망자의 손때가 묻었어./약속한 물건이다. 그리고 소켓권 한 장 — 아무 장비나 가져오면 뚫어 주지." })
        table.insert(self.List, { title = "피의 제단", desc = "교수대 숲의 피의 제단에 다가가 의식을 막아라. 세 번의 습격 뒤 나타나는 「피의 사제」를 쓰러뜨려야 한다.", zone = "교수대 숲", objective = "제단 의식 → 피의 사제 처치", kind = "ritual", target = "blood_priest", map = "gallows", map1 = "blood_altar", giver = "quest", act = 1, count = 1, exp = 8000, gold = 300, reward = "stp:5", intro = "교수대 숲에서 피 냄새가 짙어지고 있다. 누군가 숲 어딘가에 피의 제단을 세웠다./제단에 다가가면 의식이 깨어날 거다. 망자들이 몰려오고, 마지막엔 제단의 주인이 모습을 드러내겠지./피의 사제를 쓰러뜨려라. 그러면 제단의 힘을 네 편으로 돌려놓을 수 있다.", outro = "피의 사제가 죽었다니… 제단은 이제 네 편이다. 다가가면 피의 힘이 잠시 깃들 거다./네 몸에 혼의 기운이 더 쌓였을 거다. 능력치를 다듬어라." })
        table.insert(self.List, { title = "목 없는 처형인", desc = "교수대 숲의 「목 없는 처형인」을 쓰러뜨려 열쇠를 얻고, 「목매단 동굴」 끝방의 봉인 상자를 열어라.", zone = "교수대 숲 · 목매단 동굴", objective = "처형인 처치 → 동굴 봉인 상자", kind = "chest", target = "headsman", map = "cave", map1 = "gallows", giver = "quest", act = 1, count = 2, exp = 0, gold = 400, reward = "runes:2", intro = "제단을 지키던 자의 정체를 알아냈다. 목 없는 처형인. 교수대 숲의 사형 집행인이었지./놈의 허리춤에 열쇠가 매달려 있다. 숲 옆 「목매단 동굴」 끝방, 교단이 봉인한 상자의 열쇠다./처형인을 쓰러뜨리고 그 상자를 열어라. 상자를 열었다고 알려 주면 내가 모아 둔 룬도 나눠 주지.", outro = "봉인 상자를 열었군. 처형인에게 묶였던 혼들도 풀려났다./약속한 룬이다. 장비 소켓에 박으면 힘이 깨어난다." })
        table.insert(self.List, { title = "묘지기 여왕", desc = "지하 납골당 가장 깊은 곳, 여왕의 무덤에서 묘지기 여왕을 쓰러뜨려라.", zone = "여왕의 무덤", objective = "묘지기 여왕 처치", kind = "kill", target = "grave_queen", map = "queentomb", map1 = "", giver = "quest", act = 1, count = 1, exp = 20000, gold = 1500, reward = "rune:r_as,rune:r_ireun", intro = "모든 혼각의 기운이 한 곳으로 모이고 있다. 지하 납골당 가장 깊은 곳, 여왕의 무덤이다./묘지기 여왕. 이 땅의 망자를 모두 다스리던 자다. 여왕을 쓰러뜨리지 않으면 잿빛 변경은 영영 잠들지 못한다./준비가 되면 가라. 돌아오지 못할 수도 있다.", outro = "…해냈구나. 여왕의 저주가 걷혔다./하지만 혼각은 더 깊은 곳에서 울리고 있다. 이건 시작일 뿐이다, 네크로맨서./여왕의 관에서 나온 두 룬이다. 아스와 이른 — 등불에 함께 박으면 「첫 번째 군령」이 깨어난다." })
        table.insert(self.List, { title = "모래에 묻힌 대상", desc = "뜨거운 모래 언덕을 휩쓰는 사막 자칼 45마리를 쓰러뜨려 카라반 길을 열어라.", zone = "뜨거운 모래 언덕", objective = "사막 자칼 처치", kind = "kill", target = "jackal", map = "dunes", map1 = "", giver = "caravan", act = 2, count = 45, exp = 8000, gold = 600, reward = "gen:3", intro = "여왕을 쓰러뜨렸다고? 그렇다면 사막길도 뚫을 수 있겠군. 나는 카라반 대장 무하드다./오아시스 시장 너머 뜨거운 모래 언덕에 자칼 떼가 들끓어 대상 행렬이 모래에 묻히고 있다./놈들을 마흔다섯 마리쯤 쓰러뜨려 주게. 길이 열리면 대상들이 실어 온 좋은 물건 하나를 골라 주지.", outro = "자칼 울음소리가 잦아들었군. 대상들이 다시 길을 나설 수 있겠어./약속한 물건이다. 대상 짐 가운데 가장 좋은 걸로 골랐지." })
        table.insert(self.List, { title = "독침 여왕", desc = "뜨거운 모래 언덕 곁가지 「전갈 굴」 2층 끝의 「독침 여왕 세르카」를 쓰러뜨려라. 독 장판을 피하며 싸워야 한다.", zone = "전갈 굴 2층", objective = "독침 여왕 세르카 처치", kind = "boss", target = "serka", map = "scorpnest2", map1 = "", giver = "apothecary", act = 2, count = 1, exp = 0, gold = 700, reward = "respoison:15", intro = "어서 와, 네크로맨서. 난 오아시스 약사 야스민이야. 요즘 내 약초꾼들이 하나둘 독에 쓰러져 돌아오고 있어./모래 언덕 옆 「전갈 굴」 맨 아래에 독침 여왕 세르카가 둥지를 틀었대. 그 독은 땅에 고여서 한참을 남아./세르카를 쓰러뜨려 줘. 그 독침을 가져오면 독을 이기는 약을 달여 줄게 — 한 번 마시면 몸에 평생 남는 약이야.", outro = "세르카의 독침이구나… 손 조심해, 아직도 독이 배어 나와./자, 약속한 해독 약이야. 이제 독이 네 몸에 덜 스밀 거야. 악몽이나 지옥의 세르카 독침을 가져오면 그때마다 더 진하게 달여 줄게." })
        table.insert(self.List, { title = "메마른 우물의 혼", desc = "메마른 협곡 곁가지 「버려진 우물」에서 모래 미라의 혼 6개를 추출하라. (다른 곳의 미라는 세지 않는다)", zone = "버려진 우물", objective = "모래 미라의 혼 추출", kind = "extract", target = "sand_mummy", map = "drywell", map1 = "", giver = "apothecary", act = 2, count = 6, exp = 0, gold = 800, reward = "skp:1", intro = "하나 더 부탁해도 될까? 협곡의 「버려진 우물」에서 물 대신 미라가 올라오고 있어./우물에 묻힌 건 옛날 오아시스를 지키던 사람들이야. 미라가 된 채로 혼이 묶여 있지./네 등불로 그 혼을 여섯 개만 거둬 줘. 혼이 풀리면 우물도 다시 숨을 쉴 거야. 그 혼들이 네게 기술 하나를 가르쳐 줄지도 몰라.", outro = "우물에서 차가운 바람이 올라오기 시작했어. 혼들이 풀려난 거야./고마워. 네 그림자 곁에 선 혼들이 무언가 속삭이고 있네 — 새 기술을 하나 익힐 수 있을 거야." })
        table.insert(self.List, { title = "왕들의 봉인", desc = "바람 무덤 사막 곁가지 「왕들의 묘실」 2층 끝의 「묘실 수호왕」을 쓰러뜨리고, 그 끝방의 봉인 상자를 열어라.", zone = "왕들의 묘실 2층", objective = "수호왕 처치 → 봉인 상자", kind = "chest", target = "tomb_king", map = "kingtomb2", map1 = "kingtomb2", giver = "scholar", act = 2, count = 2, exp = 0, gold = 900, reward = "stp:5", intro = "자네가 그 네크로맨서로군. 나는 사원 학자 오빈일세. 잊힌 사원의 비밀을 쫓고 있지./바람 무덤 사막 아래 「왕들의 묘실」에 옛 왕들의 봉인 상자가 있네. 상자는 묘실 수호왕이 지키고 있지 — 수호왕을 쓰러뜨려야 봉인이 풀리네./수호왕을 쓰러뜨리고 상자를 열어 주게. 상자 속 기록이 사원으로 가는 길을 알려 줄 걸세.", outro = "봉인 상자를 열었군! 이 기록… 대사제가 사원 깊은 곳에서 무엇을 깨우려 하는지 적혀 있네./수고했네. 옛 왕들의 기록을 읽은 자는 몸과 마음이 단단해진다고 하지 — 능력치를 다섯 더 올릴 수 있을 걸세." })
        table.insert(self.List, { title = "사원의 두 문지기", desc = "잊힌 사원 2층을 지키는 「사원 문지기 형제」 둘을 모두 쓰러뜨려라. 한 명이 쓰러지면 남은 쪽이 분노한다.", zone = "잊힌 사원 2층", objective = "사원 문지기 형제 처치", kind = "kill", target = "gate_brother", map = "temple2", map1 = "", giver = "scholar", act = 2, count = 2, exp = 0, gold = 1000, reward = "runes:2", intro = "묘실의 기록 덕분에 사원으로 가는 길을 찾았네. 가라앉은 대로 끝, 모래에 반쯤 묻힌 잊힌 사원이지./2층 계단 앞에는 개의 머리를 한 문지기 둘이 서 있다고 하네. 쌍둥이 형제라더군 — 한쪽이 쓰러지면 남은 쪽이 미쳐 날뛴다고 기록돼 있어./둘을 한꺼번에 상대하지 말고, 한 명씩 떼어 놓고 싸우게. 둘 다 쓰러뜨리면 사원에 잠든 룬을 나눠 주지.", outro = "문지기 형제를 둘 다 쓰러뜨렸다고? 기록대로라면 그 둘은 천 년을 버텼다네./약속한 룬이네. 사원 깊은 곳의 힘이 깃든 것들이지." })
        table.insert(self.List, { title = "모래 폐허의 대사제", desc = "잊힌 사원 3층 너머 「대사제의 성소」에서 모래 폐허의 대사제를 쓰러뜨려라. 쓰러뜨리면 다음 난이도가 열린다.", zone = "대사제의 성소", objective = "모래 폐허의 대사제 처치", kind = "kill", target = "high_priest", map = "sanctum", map1 = "", giver = "scholar", act = 2, count = 1, exp = 60000, gold = 3000, reward = "unique:1", intro = "모든 기록이 한 사람을 가리키고 있네. 모래 폐허의 대사제 — 사원을 세운 자이자, 사막을 모래로 덮은 자일세./대사제는 성소에서 불길을 부르고, 쓰러진 자들을 미라로 일으키고, 끝내는 모래폭풍으로 앞을 가린다고 하네./폭풍이 일면 눈앞만 보고 싸워야 할 걸세. 대사제를 쓰러뜨리면 그가 지니던 보물을 자네에게 주겠네.", outro = "…대사제가 쓰러졌군. 사막의 바람이 달라졌어. 모래가 가라앉고 있네./약속한 보물이네. 대사제의 성소에서 나온 물건이지./하지만 망자의 혼각은 아직 멈추지 않았네. 더 짙은 어둠 — 악몽이 자네를 기다리고 있을 걸세." })
        self.Givers = {}
        self.Givers["quest"] = "파문당한 사제 오렌"
        self.Givers["smith"] = "대장장이 하르크"
        self.Givers["caravan"] = "카라반 대장 무하드"
        self.Givers["scholar"] = "사원 학자 오빈"
        self.Givers["apothecary"] = "오아시스 약사 야스민"
    end

    method any Get(integer index)
        self:Ensure()
        return self.List[index]
    end

    method integer Count()
        self:Ensure()
        return #self.List
    end

    method integer IndexOf(string kind, string target)
        -- 그 종류·대상의 의뢰 번호 (없으면 0)
        self:Ensure()
        for i, q in ipairs(self.List) do
            if q.kind == kind and q.target == target then return i end
        end
        return 0
    end

    method string GiverName(string giver)
        -- 의뢰인 NPC 종류 → 이름 (npcs.csv의 name)
        self:Ensure()
        return self.Givers[giver] or giver
    end

    method integer LastOfAct(integer act)
        -- 그 액트의 마지막 의뢰 번호 (액트 완료 = 이 의뢰까지 끝냄). 없으면 0
        self:Ensure()
        local last = 0
        for i, q in ipairs(self.List) do
            if q.act == act then last = i end
        end
        return last
    end

    method string RewardText(string reward)
        -- 보상 문자열("rune:r_as,item:...,skp:1,stp:5,gen:2,deploy:1,runes:2,socket:1") → 표시용
        local parts = {}
        for key, val in string.gmatch(reward, "(%a+):([^,]+)") do
            if key == "rune" then
                local r = _ItemData:GetRune(val)
                table.insert(parts, (r ~= nil and r.name or val) .. " 룬")
            elseif key == "item" then table.insert(parts, _ItemData:Parse(val).name)
            elseif key == "skp" then table.insert(parts, "스킬 포인트 " .. val)
            elseif key == "stp" then table.insert(parts, "능력치 포인트 " .. val)
            elseif key == "deploy" then table.insert(parts, "그림자 배치 +" .. val .. " (영구 · 난이도마다)")
            elseif key == "respoison" then table.insert(parts, "독 저항 +" .. val .. " (영구 · 난이도마다)")
            elseif key == "unique" then table.insert(parts, "유니크 장비 " .. val .. " (보장)")
            elseif key == "runes" then table.insert(parts, "룬 " .. val .. "개")
            elseif key == "socket" then table.insert(parts, "소켓권 " .. val .. "장")
            elseif key == "gen" then table.insert(parts, val == "3" and "희귀 장비 (보장)" or "마법 장비") end
        end
        return table.concat(parts, ", ")
    end

end
