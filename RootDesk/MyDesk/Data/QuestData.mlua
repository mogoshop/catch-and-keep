-- 자동 생성 파일: tools/gen_data.cjs 가 data/quests.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 의뢰 목록 (순서대로 진행). kind: kill / extract / reach / raise / clear(맵 전멸) / boss(이름 있는 적) / ritual(제단 의식) / chest(열쇠 → 봉인 상자). act = 액트
@Logic
script QuestData extends Logic

    property boolean Built = false
    property table List = {}
    property table Givers = {}
    property table Voices = {}
    property table Portraits = {}
    property table SpriteStands = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { title = "굶주린 굴", desc = "피 묻은 황무지 곁가지 「굶주린 굴」에 숨어든 망자를 하나도 남김없이 쓰러뜨려라.", zone = "굶주린 굴", objective = "굴 안의 망자 모두 처치", kind = "clear", target = "hollow", map = "hollow", map1 = "", giver = "quest", act = 1, count = 1, exp = 1500, level = 2, gate = "", gold = 50, reward = "skp:2,gen:3", intro = "어, 살아 있네! 다행이다. 나는 오렌, 교단에서 쫓겨난 사제야. 얘는 숯. 물지는 않으니까 걱정 마./백 년 전 교단은 재의 왕의 심장을 셋으로 쪼개 묻었어. 그 조각들의 봉인이 지금 새고 있대./꿈에서 목소리가 그러더라. 마지막 네크로맨서가 올 거고, 그와 함께 조각을 모아 정화하면 이 땅이 되살아난다고. …그게 너 맞지?/일단 {굶주린 굴}부터 부탁해. 황무지 북동쪽 바위틈에서 [굶주린 구울]들이 기어 나와. 야영지 애들이 무서워서 밤에 잠을 못 자.", outro = "굴이 조용해졌다! 봐, 풀려난 혼들이 네 등불 쪽으로 기울잖아./조각은 망자를 사슬로 묶어. 너는 그 사슬을 끊고. 풀려난 혼이 스스로 네 곁에 서는 건 그래서야./그 혼들이 너한테 뭔가 가르쳐 줄 거야. 숯도 네가 마음에 드나 봐." })
        table.insert(self.List, { title = "가라앉은 지하실의 수장", desc = "썩은 갈대 늪 곁가지 「가라앉은 지하실」 2층 끝의 「썩은 사제 모르그」를 쓰러뜨려라. 악몽·지옥에서 다시 쓰러뜨릴 때마다 거느릴 수 있는 그림자가 하나씩 는다.", zone = "가라앉은 지하실 2층", objective = "썩은 사제 모르그 처치", kind = "boss", target = "morg", map = "cellar2", map1 = "", giver = "quest", act = 1, count = 1, exp = 0, level = 5, gate = "", gold = 120, reward = "deploy:1,unique:1", intro = "늪 아래 {가라앉은 지하실}에서 교단의 옛 사제가 망자를 부리고 있어./[썩은 사제 모르그]. 나랑 같은 제단에 서던 사람이야. 언젠가부터 「목소리」를 듣는다고 하더니… 그건 거짓 목소리였어./모르그는 교단에서 혼을 묶는 법을 반쯤만 배우고 쫓겨났어. 그래서 망자의 혼을 지팡이에 묶어 끌고 다니지./{지하실 2층} 끝에서 그를 쓰러뜨려 줘. 묶인 혼들이 풀려서 네 그림자 곁으로 올 거야.", outro = "모르그가 쓰러졌구나. 지팡이에 묶였던 혼들이 네 곁으로 모여들어./죽기 전에 뭐라고 했어? …「너도 듣고 있지」? …미친 사람 헛소리야. 신경 쓰지 마. 정말로./이제 그림자를 하나 더 거느릴 수 있을 거야." })
        table.insert(self.List, { title = "사라진 병사의 유물", desc = "무너진 형장 곁가지 「뼈 구덩이」 2층의 「유물 지기 테오」를 쓰러뜨리고 교단의 유물을 되찾아라.", zone = "뼈 구덩이 2층", objective = "유물 지기 테오 처치 → 교단의 유물 회수", kind = "boss", target = "relic_keeper", map = "pit2", map1 = "", giver = "smith", act = 1, count = 1, exp = 0, level = 7, gate = "", gold = 180, reward = "gen:3,socket:1", intro = "네가 오렌이 데려온 네크로맨서군. 나는 하르크, 이 야영지 대장장이다. …오렌의 애비고./교단 놈들이 그 애를 쫓아냈지. 그 얘긴 녀석 앞에서 꺼내지 마라. 웃으면서 넘기지만 속까지 웃는 건 아니니까./교단이 무너지던 날, 한 수도사가 {교단의 유물} 상자를 끌어안고 {뼈 구덩이}로 뛰어들었다. 죽어서도 상자를 놓지 않아. 다들 [유물 지기 테오]라 부른다./상자를 가져와라. 쓸 만한 물건 하나 골라 주고, 네 장비에 소켓도 하나 뚫어 주마.", outro = "이게 교단의 유물인가… 상자 안에 옛 기록이 들었군./「심장을 셋으로 나누어 세 땅에 묻는다. 다시는 한곳에 모이지 않게.」/…다시는 모이지 않게, 라. 이걸 보여 주면 그 애는 또 웃으면서 괜찮다고 하겠지./약속한 물건이다. 소켓은 언제든 장비를 들고 오면 뚫어 주마." })
        table.insert(self.List, { title = "피의 제단", desc = "교수대 숲의 피의 제단에 다가가 의식을 막아라. 세 번의 습격 뒤 나타나는 「피의 사제 사빈」을 쓰러뜨려야 한다.", zone = "교수대 숲", objective = "제단 의식 → 피의 사제 사빈 처치", kind = "ritual", target = "blood_priest", map = "gallows", map1 = "blood_altar", giver = "quest", act = 1, count = 1, exp = 8000, level = 6, gate = "", gold = 180, reward = "stp:5", intro = "아빠가 기록을 보여 주더라. 「다시는 모이지 않게」… 옛 교단은 겁쟁이였어. 묻어 두기만 해서 이 땅이 이렇게 썩은 거야./그보다 {교수대 숲}이 급해. 타락한 교단 잔당이 숲에 {피의 제단}을 세웠어./그 사람들, 아직도 여왕에게 혼을 바치고 있어. 제단에 다가가면 의식이 깨어날 거야./망자가 세 번 몰려오고, 마지막엔 제단의 주인 [피의 사제 사빈]이 나와. 조심해 — 네가 다치면 나 속상하니까.", outro = "사빈이 쓰러졌다고? 제단은 이제 네 편이야. 다가가면 피의 힘이 잠깐 깃들 거야./혼의 기운이 네 몸에 더 쌓였을 거야. 느껴져?" })
        table.insert(self.List, { title = "목 없는 처형인", desc = "교수대 숲의 「목 없는 처형인 고드릭」을 쓰러뜨려 열쇠를 얻고, 「목매단 동굴」 끝방의 봉인 상자를 열어라.", zone = "교수대 숲 · 목매단 동굴", objective = "처형인 고드릭 처치 → 동굴 봉인 상자", kind = "chest", target = "headsman", map = "cave", map1 = "gallows", giver = "quest", act = 1, count = 2, exp = 0, level = 8, gate = "", gold = 240, reward = "runes:1", intro = "제단을 지키던 사람을 알아냈어. [목 없는 처형인 고드릭] — 여왕의 사형 집행인이었대./왕국이 무너질 때 역병 든 백성을 가장 먼저 매단 사람이야. 죽어서도 도끼를 놓지 않아./허리춤에 열쇠가 있어. {목매단 동굴} 끝방, 교단이 봉인한 상자의 열쇠야./처형인을 쓰러뜨리고 그 상자를 열어 줘. 내가 몰래 모아 둔 룬, 나눠 줄게. 아빠한테는 비밀.", outro = "봉인 상자를 열었구나. 고드릭에게 묶였던 혼들도 풀려났어./약속한 룬이야. 장비 소켓에 박으면 힘이 깨어나. …아빠가 보면 또 잔소리하겠다." })
        table.insert(self.List, { title = "묘지기 여왕", desc = "지하 납골당 가장 깊은 곳, 여왕의 무덤에서 묘지기 여왕 오르넬라를 쓰러뜨려라.", zone = "여왕의 무덤", objective = "묘지기 여왕 오르넬라 처치", kind = "kill", target = "grave_queen", map = "queentomb", map1 = "", giver = "quest", act = 1, count = 1, exp = 20000, level = 10, gate = "", gold = 900, reward = "unique:1", intro = "…고백할 게 있어. [묘지기 여왕 오르넬라]를 되살린 의식, 그 제단에 선 사제가… 나였어./역병이 야영지까지 번졌을 때, 목소리가 그랬어. 여왕이 깨어나야 조각이 드러나고, 조각을 모으면 역병이 끝난다고. 그 뒤로 왕국의 망자는 전부 여왕 것이 됐지./조각은 {지하 납골당} 가장 깊은 곳, {여왕의 무덤}에 있어. 3층엔 근위대장 [바르그]가 아직도 여왕의 길을 지키고 있고./여왕을 쓰러뜨리고 조각을 가져와 줘. 그걸 정화하면… 내 죄도 조금은 씻기겠지. …아빠한테는 내가 직접 말할게.", outro = "…해냈구나! 이게 첫 번째 조각이야? 손 안에서 따뜻해./봐, 황무지의 안개가 걷히고 있어. 목소리가 옳았어. 정화가 시작된 거야!/나머지 둘은 사막이랑 바다에 있대. {오아시스 시장}으로 가는 카라반 대장 무하드를 찾아가. 나도 숯이랑 곧 따라갈게./여왕의 관에 이것도 같이 묻혀 있었어. 네 손에 더 어울릴 거야." })
        table.insert(self.List, { title = "모래에 묻힌 대상", desc = "뜨거운 모래 언덕을 휩쓰는 사막 자칼 45마리를 쓰러뜨려 카라반 길을 열어라.", zone = "뜨거운 모래 언덕", objective = "사막 자칼 처치", kind = "kill", target = "jackal", map = "dunes", map1 = "", giver = "caravan", act = 2, count = 45, exp = 8000, level = 13, gate = "", gold = 360, reward = "gen:3", intro = "여왕을 쓰러뜨린 네크로맨서라고? 반갑네, 나는 카라반 대장 무하드./자네 얘기는 들었네. 잿빛 행상 고르가 먼저 와서 떠벌리더군. 우리 마차보다 늘 하루 빨라, 그 사람은./조각을 쫓는다고? 사막 장사꾼들 사이에선 「사원으로 들어간 검은 짐」 얘기가 오래된 소문이지./그 전에 길부터 뚫어야겠네. {뜨거운 모래 언덕}의 [사막 자칼] 떼가 대상을 모래에 묻고 있네. 놈들을 흩어 주게.", outro = "자칼 울음이 잦아들었군. 대상들이 다시 길을 나설 수 있겠네./약속한 물건일세. 오아시스의 약사와 학자도 자네를 찾더군. 자네 사제 친구도 와 있네 — 밤새 기도만 하더군." })
        table.insert(self.List, { title = "독침 여왕", desc = "뜨거운 모래 언덕 곁가지 「전갈 굴」 2층 끝의 「독침 여왕 세르카」를 쓰러뜨려라. 독 장판을 피하며 싸워야 한다.", zone = "전갈 굴 2층", objective = "독침 여왕 세르카 처치", kind = "boss", target = "serka", map = "scorpnest2", map1 = "", giver = "apothecary", act = 2, count = 1, exp = 0, level = 15, gate = "", gold = 420, reward = "respoison:15", intro = "어서 오세요, 네크로맨서. 저는 오아시스 약사 야스민이에요./요즘 약초꾼들이 독에 쓰러져 돌아와요. {전갈 굴} 맨 아래에 [독침 여왕 세르카]가 둥지를 틀었대요./그 독은 땅에 고여서 한참 남아요. 독침을 가져오시면 독을 이기는 약을 달여 드릴게요. 한번 먹으면 몸에 평생 남는 약이에요.", outro = "세르카의 독침이네요… 아직도 독이 배어 나와요. 손 조심하세요./약속한 해독 약이에요. 악몽이나 지옥의 독침을 가져오시면 그때마다 더 진하게 달여 드릴게요." })
        table.insert(self.List, { title = "메마른 우물의 혼", desc = "메마른 협곡 곁가지 「버려진 우물」에서 모래 미라의 혼 6개를 추출하라. (다른 곳의 미라는 세지 않는다)", zone = "버려진 우물", objective = "모래 미라의 혼 추출", kind = "extract", target = "sand_mummy", map = "drywell", map1 = "", giver = "apothecary", act = 2, count = 6, exp = 0, level = 15, gate = "", gold = 480, reward = "skp:2", intro = "하나 더 부탁드려도 될까요? {메마른 협곡}의 {버려진 우물}에서 물 대신 미라가 올라와요./우물에 묻힌 건 옛날 오아시스를 지키던 사람들이에요. 누군가 그 혼을 묶어서 [모래 미라]로 일으켰어요./당신의 등불로 그 혼들을 거둬 주세요. 혼이 풀리면 우물도 다시 숨을 쉴 거예요.", outro = "우물에서 차가운 바람이 올라와요. 혼들이 풀려난 거예요./그 혼들이 당신에게 뭔가 속삭이고 있네요. 새로운 힘을 깨우쳐 줄 거예요." })
        table.insert(self.List, { title = "왕들의 봉인", desc = "바람 무덤 사막 곁가지 「왕들의 묘실」 2층 끝의 「묘실 수호왕 아메네트」를 쓰러뜨리고, 그 끝방의 봉인 상자를 열어라.", zone = "왕들의 묘실 2층", objective = "수호왕 아메네트 처치 → 봉인 상자", kind = "chest", target = "tomb_king", map = "kingtomb2", map1 = "kingtomb2", giver = "scholar", act = 2, count = 2, exp = 0, level = 17, gate = "", gold = 540, reward = "stp:5", intro = "자네가 그 네크로맨서로군. 나는 사원 학자 오빈일세./[대사제 알하자르]가 사원에서 기이한 조각을 다룬다는 기록을 쫓고 있지. 자네가 쫓는 조각 같군./{바람 무덤 사막} 아래 {왕들의 묘실}에 옛 왕들의 봉인 상자가 있네. [묘실 수호왕 아메네트]가 지키고 있지./수호왕을 쓰러뜨리고 상자를 열어 주게. 상자 속 기록이 사원으로 가는 길을 알려 줄 걸세.", outro = "봉인 상자를 열었군! 이 기록… 대사제가 조각의 힘으로 옛 왕들을 깨우려 한다고 적혀 있네./「끝나지 않는 왕국」 — 죽은 왕들의 군대로 사막을 다스리겠다는 걸세./그런데 이상한 줄이 있군. 「잿빛 외투의 순례자가 다녀간 밤부터, 대사제는 목소리를 들었다.」/기록을 읽은 자는 몸과 마음이 단단해진다지. 이건 자네가 가지게." })
        table.insert(self.List, { title = "사원의 두 문지기", desc = "잊힌 사원 2층을 지키는 쌍둥이 문지기 「아슈」와 「나슈」를 모두 쓰러뜨려라. 한 명이 쓰러지면 남은 쪽이 분노한다.", zone = "잊힌 사원 2층", objective = "쌍둥이 문지기 아슈·나슈 처치", kind = "kill", target = "gate_brother|gate_brother_shield", map = "temple2", map1 = "", giver = "scholar", act = 2, count = 2, exp = 0, level = 18, gate = "", gold = 600, reward = "runes:1", intro = "기록 덕분에 사원 가는 길을 찾았네. {가라앉은 대로} 끝, 모래에 반쯤 묻힌 {잊힌 사원}일세./2층 계단 앞에 사자 투구를 쓴 쌍둥이 문지기 [아슈]와 [나슈]가 서 있다고 하네./한쪽이 쓰러지면 남은 쪽이 미쳐 날뛴다고 적혀 있어. 한 명씩 떼어 놓고 싸우게./둘 다 쓰러뜨리면 사원에 잠든 룬을 나눠 주지.", outro = "문지기 형제를 둘 다? 기록대로라면 그 둘은 천 년을 버텼다네./약속한 룬이네. 사원 깊은 곳의 힘이 깃든 것들이지." })
        table.insert(self.List, { title = "모래 폐허의 대사제", desc = "잊힌 사원 3층 너머 「대사제의 성소」에서 대사제 알하자르를 쓰러뜨려라. 쓰러뜨리면 바닷길(액트 3 「폭풍 해안」)이 열린다.", zone = "대사제의 성소", objective = "대사제 알하자르 처치", kind = "kill", target = "high_priest", map = "sanctum", map1 = "", giver = "scholar", act = 2, count = 1, exp = 60000, level = 20, gate = "", gold = 1800, reward = "unique:1", intro = "모든 기록이 한 사람을 가리키네. [대사제 알하자르] — 사원을 세우고, 사막을 모래로 덮은 자일세./대사제는 {대사제의 성소}에서 조각을 쥐고 불길과 미라를 부르지. 끝내는 모래폭풍으로 앞을 가린다고 하네./폭풍이 일면 눈앞만 보고 싸우게. 대사제를 쓰러뜨리면 그가 지니던 보물을 주겠네.", outro = "…대사제가 쓰러졌군. 보게, 하늘이 흐려지고 있네. 이 사막에 비가 온다니!/조각은 자네 사제 친구에게 건넸다지. 그 사제가 기도를 올리자 비가 쏟아지더군. 다들 기적이라 하네./성소의 마지막 기록일세. 「마지막 조각은 제독 바렌의 함대에 실려 바다를 건넜다.」/{소금바람 항구}로 가는 배가 다시 뜰 걸세. 약속한 보물이네. 성소에서 나온 물건이지." })
        table.insert(self.List, { title = "난파선의 망자들", desc = "소금바람 항구 너머 난파선 해안을 떠도는 익사한 선원 50마리를 쓰러뜨려 부두를 지켜라.", zone = "난파선 해안", objective = "익사한 선원 처치", kind = "kill", target = "drowned_sailor", map = "wreckcoast", map1 = "", giver = "harbormaster", act = 3, count = 50, exp = 16000, level = 23, gate = "", gold = 540, reward = "gen:3", intro = "사막에서 왔다고? 대사제를 쓰러뜨린 그 사람이군. 나는 이 항구의 관리인 브람일세./제독 바렌의 함대? 백 년 전에 이 앞바다에 통째로 가라앉았지. 뭘 싣고 있었는지는 아무도 몰라./그런데 요즘 {난파선 해안}에서 [익사한 선원]들이 일어나 부두까지 기어오네. 배가 못 들어온 지 한 달째야./놈들을 바다로 돌려보내 주게. 창고에 남은 물건 중 제일 나은 걸 내주지.", outro = "해안이 조용해졌군. 오늘 밤엔 부두에서 잠을 잘 수 있겠네./선원들 목에 걸린 이 검은 부스러기… 자네가 쫓는다는 조각과 닮았군. 잿빛 행상이 비싸게 사겠다던데, 팔지 말아야겠어./약속한 물건일세. 마지막으로 들어온 배의 짐에서 꺼낸 거야." })
        table.insert(self.List, { title = "바위 집게 왕", desc = "소금 갯벌 곁가지 「집게 동굴」 2층 끝의 「바위 집게 왕 크라그」를 쓰러뜨려라. 생명이 절반 아래로 떨어지면 껍질을 닫아 단단해진다.", zone = "집게 동굴 2층", objective = "바위 집게 왕 크라그 처치", kind = "boss", target = "crab_king", map = "crabcave2", map1 = "", giver = "harbormaster", act = 3, count = 1, exp = 0, level = 24, gate = "", gold = 660, reward = "reslight:15", intro = "{소금 갯벌} 동굴에 바위섬만 한 게가 산다네. 어부들은 [바위 집게 왕 크라그]라 부르지./놈이 게 떼를 몰아내는 통에 갯벌엔 아무도 못 나가. 껍질이 닫히면 칼도 안 들어가니 조심하게./쓰러뜨려 주면 내가 아끼는 번개막이 부적을 주겠네. 이 바다에선 번개가 사람을 가리지 않거든.", outro = "크라그가 쓰러졌다고? 이제 갯벌에 다시 그물을 칠 수 있겠군./약속한 부적일세. 몸에 지니면 번개가 비껴갈 거야." })
        table.insert(self.List, { title = "선창에 갇힌 혼", desc = "난파선 해안 곁가지 「난파선 선창」에서 익사한 선원의 혼 6개를 추출하라. (다른 곳의 선원은 세지 않는다)", zone = "난파선 선창", objective = "익사한 선원의 혼 추출", kind = "extract", target = "drowned_sailor", map = "wreckhold", map1 = "", giver = "keeperdaughter", act = 3, count = 6, exp = 0, level = 24, gate = "", gold = 720, reward = "skp:2", intro = "당신이 혼을 다룬다는 분이죠? 저는 등대지기의 딸 미라예요./아버지가 그러셨어요. 가라앉은 배의 선창엔 집에 돌아가지 못한 선원들의 혼이 갇혀 있다고./{난파선 선창}에서 그 혼들을 꺼내 주실 수 있나요? 그러면 바다도 조금은 조용해질 거예요.", outro = "선창이 조용해졌다고요? 고마워요./이건 아버지가 남긴 비망록이에요. 「등대 불이 꺼지면 제독이 깨어난다. 잿빛 외투의 상인에게는 등불 기름을 팔지 말 것.」/…그 행상, 지난달에 왔었어요. 아버지가 쫓아낸 그날 밤에, 불이 꺼졌어요." })
        table.insert(self.List, { title = "밀수꾼의 보물", desc = "번개 절벽 곁가지 「밀수꾼 동굴」 2층 끝의 「밀수꾼 두목 렌」을 쓰러뜨리고, 그 끝방의 봉인 상자를 열어라.", zone = "밀수꾼 동굴 2층", objective = "밀수꾼 두목 렌 처치 · 봉인 상자 열기", kind = "chest", target = "smuggler_boss", map = "smuggler2", map1 = "smuggler2", giver = "harbormaster", act = 3, count = 2, exp = 0, level = 26, gate = "", gold = 780, reward = "stp:5", intro = "{번개 절벽} 아래 동굴에 밀수꾼들이 숨어 있네. 두목 [렌]은 연기 속에 숨어 다니는 놈이지./놈이 난파선에서 건진 검은 부스러기를 비싸게 팔아넘기고 있다더군. 항구 창고 물건도 훔쳐 갔고./두목을 쓰러뜨리고 {밀수꾼 동굴} 끝방의 봉인 상자를 열어 주게. 상자 안 물건은 자네 몫이야.", outro = "렌이 쓰러졌다니 속이 다 시원하군. 그 부스러기들은 바다 깊이 다시 던져 버려야겠네./항구에서 주는 사례일세. 몸을 단련하는 데 쓰게." })
        table.insert(self.List, { title = "꺼진 등불", desc = "가라앉은 어촌 곁가지 「등대지기의 집」 끝방의 「미친 등대지기 하울」을 쓰러뜨려라. 번개가 그와 그림자 사이를 튕긴다.", zone = "등대지기의 집", objective = "미친 등대지기 하울 처치", kind = "boss", target = "mad_keeper", map = "keeperhouse", map1 = "", giver = "keeperdaughter", act = 3, count = 1, exp = 0, level = 28, gate = "", gold = 840, reward = "runes:1", intro = "등대 불이 꺼진 날, 아버지는 등불을 들고 집으로 들어가셨어요. 그 뒤로 아무도 나오지 않았고요./밤마다 {등대지기의 집} 창문에 번개가 번쩍여요. 사람들은 이제 아버지를 [미친 등대지기 하울]이라고 불러요./부탁이에요. 아버지를 편히 쉬게 해 주세요.", outro = "…그랬군요. 아버지는 마지막까지 등불을 놓지 않으셨나요./아버지 혼이 떠나기 전에 뭐라고 하셨다고요? 「조각을… 사제에게… 주지 마라」…/무슨 뜻일까요. 오렌 사제님은 좋은 분이잖아요./아버지가 모아 두신 룬이에요. 당신이 쓰길 바라실 거예요." })
        table.insert(self.List, { title = "익사한 제독", desc = "폭풍 등대 꼭대기 「폭풍의 눈」에서 익사한 제독 바렌을 쓰러뜨려라. 쓰러뜨리면 북쪽 「심연의 문」으로 가는 길이 열린다.", zone = "폭풍의 눈", objective = "익사한 제독 바렌 처치", kind = "kill", target = "admiral", map = "stormeye", map1 = "", giver = "keeperdaughter", act = 3, count = 1, exp = 120000, level = 30, gate = "", gold = 3000, reward = "unique:1", intro = "등대 꼭대기 {폭풍의 눈}에서 폭풍을 부르는 건 [익사한 제독 바렌]이에요./백 년 전 제독은 마지막 조각을 싣고 가다 함대째 가라앉았대요. 아버지는 등대 불로 제독을 바닷속에 붙잡아 두셨고요./불이 꺼지자 제독이 깨어났어요. 제독을 쓰러뜨리면 폭풍이 걷힐 거예요./부탁해요 — 이 항구의 마지막 등불이 되어 주세요.", outro = "폭풍이… 걷혔어요. 등대에 다시 불이 들어왔어요!/제독이 품고 있던 조각은 오렌 사제님 손에 들어갔어요. 사제님은 오늘 밤 배를 구해 먼저 북쪽으로 가신대요. 「심연의 문에서 마지막 정화를 하겠다」고요./아버지 비망록 마지막 장에도 「북쪽, 심연의 문」이라고만 적혀 있어요. …저도 따라갈래요. 아버지 등불을 들고요./제독의 함대에서 건져 올린 보물이에요. 가져가세요 — 아버지도 그러길 바라셨을 거예요." })
        table.insert(self.List, { title = "행군을 막아라", desc = "악마의 행군로를 따라 내려오는 타락마족 60마리를 쓰러뜨려 초소를 지켜라. (도끼병·방패병 모두 센다)", zone = "악마의 행군로", objective = "타락마족 처치", kind = "kill", target = "demon_axe|demon_shield", map = "demonroad", map1 = "", giver = "outpostcaptain", act = 4, count = 60, exp = 150000, level = 32, gate = "", gold = 900, reward = "gen:3", intro = "남쪽 바다에서 올라왔다고? 제독을 쓰러뜨린 그 사람이군. 나는 마지막 초소의 대장 그레이브다./사흘 전, 검은 자루를 멘 사제가 이곳을 지나 수도원 쪽으로 올라갔다. 그날 밤 협곡 너머 문이 열렸지./그 뒤로 붉은 뿔을 단 놈들이 줄지어 내려온다. {악마의 행군로}의 [타락마족]을 베어 다오. 놈들이 울타리에 닿기 전에./대가로 무기고에서 제일 좋은 걸 내주지.", outro = "행군이 끊겼다. 자네가 아니었으면 오늘 밤 초소는 불탔을 거다./놈들 투구 안쪽에 새겨진 문양… 교단 문장과 같군. 탈주자 엘리안에게 물어봐야겠어./약속한 물건이다. 초소에 남은 마지막 쓸 만한 무기지." })
        table.insert(self.List, { title = "유황 여왕", desc = "불탄 협곡 곁가지 「유황 동굴」 2층 끝의 「유황 여왕 네르사」를 쓰러뜨려라. 박쥐 떼를 부르고 발밑에 불을 지른다.", zone = "유황 동굴 2층", objective = "유황 여왕 네르사 처치", kind = "boss", target = "sulfur_queen", map = "sulfurcave2", map1 = "", giver = "outpostcaptain", act = 4, count = 1, exp = 100000, level = 33, gate = "", gold = 1000, reward = "resfire:15", intro = "{불탄 협곡} 박쥐들이 어디서 오는지 알아냈다. 동굴 깊은 곳에 거대한 박쥐, [유황 여왕 네르사]가 산다./놈이 날개를 펴면 협곡이 통째로 불붙는다. 초소 보급로가 그래서 끊겼지./쓰러뜨려 주면 내 화염막이 망토를 주겠다. 이 땅에선 불이 사람을 가리지 않거든.", outro = "네르사가 떨어졌다고? 오늘부터 보급 수레가 다시 협곡을 지날 수 있겠군./약속한 망토다. 걸치고 있으면 불길이 비껴갈 거다." })
        table.insert(self.List, { title = "갇힌 혼들", desc = "악마의 행군로 곁가지 「혼 감옥」에서 재의 망령의 혼 8개를 추출하라. 지옥불 사제가 혼을 빼앗기 전에 거둬야 한다. (다른 곳의 망령은 세지 않는다)", zone = "혼 감옥", objective = "재의 망령의 혼 추출", kind = "extract", target = "ash_wraith", map = "soulprison", map1 = "", giver = "deserter", act = 4, count = 8, exp = 100000, level = 33, gate = "", gold = 1100, reward = "skp:2", intro = "당신이 혼을 거두는 사람이군요. 저는 옛 교단에서 도망쳐 나온 엘리안이에요./…조각은 어디 있나요? 설마 그 사제에게 다 주셨어요? 사흘 전에 지나간 그 사람에게?/…아니에요, 지금은 이것부터. {혼 감옥}엔 혼을 빼앗긴 사람들이 재가 되어 갇혀 있어요. 타락한 사제들이 그 혼을 하나씩 꺼내 먹고요./[재의 망령]의 혼을 거둬 주세요. 붉은 실이 보이면 서둘러야 해요.", outro = "…다 거두셨군요. 고마워요. 적어도 그들은 먹히지 않았어요./간수장 그림달의 장부를 봤어요. 혼을 바치라는 명령은 옥좌에서 내려와요. 백 년 동안 비어 있던 옥좌에서요./교단에서 몰래 가지고 나온 기도문이에요. 혼을 다루는 사람에게 더 쓸모 있겠죠." })
        table.insert(self.List, { title = "악마의 모루", desc = "유황 늪 곁가지 「용암 대장간」 2층 끝의 「대장장이 악마 베르카」를 쓰러뜨리고, 그 끝방의 봉인 상자를 열어라.", zone = "용암 대장간 2층", objective = "대장장이 악마 베르카 처치 · 봉인 상자 열기", kind = "chest", target = "forge_demon", map = "forge2", map1 = "forge2", giver = "outpostcaptain", act = 4, count = 2, exp = 100000, level = 35, gate = "", gold = 1200, reward = "stp:5", intro = "타락마족 도끼가 왜 이렇게 질긴지 알았다. {유황 늪} 아래 대장간에서 [베르카]라는 악마가 두드린다./놈의 모루를 부수면 행군이 반으로 줄 거다. 끝방 봉인 상자엔 놈이 모아 둔 쇠붙이가 있다더군./베르카를 쓰러뜨리고 상자를 열어라. 상자 안 물건은 자네 몫이다.", outro = "모루가 식었다. 이제 놈들 도끼도 무뎌지겠지./초소에서 주는 사례다. 몸을 단련하는 데 쓰게." })
        table.insert(self.List, { title = "잿불의 사제", desc = "불타는 성채 외곽 곁가지 「배교자의 수도원」 끝방에서 세 조각을 품은 「심장의 사도 오렌」을 쓰러뜨려라.", zone = "배교자의 수도원", objective = "심장의 사도 오렌 처치", kind = "boss", target = "apostate_archbishop", map = "apostate", map1 = "", giver = "deserter", act = 4, count = 1, exp = 100000, level = 35, gate = "", gold = 1300, reward = "runes:1", intro = "이제 말해야겠어요. 정화 같은 건 없어요. 옛 교단이 심장을 셋으로 쪼갠 건, 다시는 한곳에 모이지 않게 하려던 거예요./세 조각이 모이면 재의 왕이 돌아와요. 사흘 전 문이 열린 건… 조각이 함께 이 땅에 들어왔기 때문이에요./오렌 사제님은 {배교자의 수도원}에 있어요. 조각을 몸에 품고, 마지막 정화를 하겠다며./가서 막아 주세요. 사제님이 아직 사제님일 때. [심장의 사도 오렌] — 수도원 사람들은 벌써 그렇게 불러요.", outro = "…사제님이 마지막에 뭐라고 하셨어요?/「목소리는… 고르였다」…? 고르라면, 마을마다 좌판을 펴던 그 잿빛 행상?/조각이 옥좌로 날아갔다면, 이제 막을 사람은 당신뿐이에요. 사제님이 지니던 룬이에요. 가져가세요." })
        table.insert(self.List, { title = "재의 왕", desc = "심연의 문 3층 끝, 옥좌로 가는 길을 봉인한 「배교한 대주교」를 쓰러뜨리고, 재의 회랑·심장의 다리·옥좌의 전실을 지나 「군주의 옥좌」에서 재의 왕 고르바스를 처단하라. 그가 불러내는 그림자 인형을 베어 주인에게 돌려보내라. 쓰러뜨리면 다음 난이도가 열린다.", zone = "심연의 문 3층 · 군주의 옥좌", objective = "배교한 대주교 처치 · 재의 왕 고르바스 처치", kind = "gate", target = "ash_king", map = "throne", map1 = "abyssgate3", giver = "deserter", act = 4, count = 2, exp = 500000, level = 40, gate = "fallen_archbishop", gold = 4000, reward = "unique:1", intro = "문 너머 {군주의 옥좌}에서 [재의 왕 고르바스]가 깨어났어요. 고르는… 처음부터 그였던 거예요./그가 마을을 오갈 때마다 무언가를 떼어 갔어요. 하르크 씨, 미라, 그리고 제 그림자까지./옥좌로 가는 문은 교단의 마지막 대주교가 지켜요. 백 년 전 심장을 쪼갰던 바로 그 사람이에요./봉인을 지키지 못하자 그분은 무릎을 꿇었어요. 그리고 이제는 왕의 문지기가 됐대요. …제가 교단을 떠난 이유예요./옥좌에서 그가 그 그림자로 무엇을 만들든… 베어 주세요. 그래야 그림자가 주인에게 돌아와요./가슴의 조각이 드러나면 그때가 기회예요. 혼을 빼앗기지 마세요 — 그는 혼을 먹을수록 강해져요.", outro = "…끝났군요. 보세요, 발밑에 그림자가 돌아왔어요./심장은 재가 되어 흩어졌어요. 그런데… 문 아래 어둠은 아직 숨을 쉬어요. 사제님의 혼도 그 아래 어딘가에 있을 거예요./교단의 마지막 보물이에요. 그리고… 고마워요, 마지막 네크로맨서." })
        self.Givers = {}
        self.Givers["quest"] = "파문당한 사제 오렌"
        self.Givers["smith"] = "대장장이 하르크"
