-- 자동 생성 파일: tools/gen_data.cjs 가 data/quests.csv 에서 만든다. 직접 수정 금지 (CSV를 고치고 다시 생성).
-- 의뢰 목록 (순서대로 진행). kind: kill / extract / reach / raise / clear(맵 전멸) / boss(이름 있는 적) / ritual(제단 의식) / chest(열쇠 → 봉인 상자)
@Logic
script QuestData extends Logic

    property boolean Built = false
    property table List = {}

    method void Ensure()
        if self.Built then return end
        self.Built = true
        self.List = {}
        table.insert(self.List, { title = "굶주린 굴", desc = "피 묻은 황무지 곁가지 「굶주린 굴」에 숨어든 망자를 하나도 남김없이 쓰러뜨려라. (남은 수가 표시된다)", zone = "굶주린 굴", objective = "굴 안의 망자 모두 처치", kind = "clear", target = "hollow", map = "hollow", map1 = "", giver = "quest", count = 1, exp = 1500, gold = 80, reward = "skp:1", intro = "…또 하나의 망자가 깨어났군. 아니, 넌 숨을 쉬고 있구나. 네크로맨서인가?/나는 오렌. 교단에서 쫓겨난 사제다. 피 묻은 황무지 북동쪽 바위틈에 「굶주린 굴」이 있다. 망자들이 거기서 기어 나오지./굴 안의 놈들을 하나도 남김없이 쓰러뜨려라. 죽은 자의 혼이 남거든 해골로 일으켜 부려도 좋다. 굴이 조용해지면 네 힘을 인정하지.", outro = "굴이 조용해졌군. 혼각의 기운이 너에게 응답하고 있다./배운 것을 정리할 시간을 주지. 네 기술이 한 단계 깊어질 거다." })
        table.insert(self.List, { title = "가라앉은 지하실의 수장", desc = "썩은 갈대 늪 곁가지 「가라앉은 지하실」 2층 끝의 「썩은 사제 모르그」를 쓰러뜨려라.", zone = "가라앉은 지하실 2층", objective = "썩은 사제 모르그 처치", kind = "boss", target = "morg", map = "cellar2", map1 = "", giver = "quest", count = 1, exp = 0, gold = 200, reward = "deploy:1", intro = "늪 아래 가라앉은 지하실에서 교단의 옛 사제 하나가 망자들을 부리고 있다./모르그. 나와 같은 교단에 있던 자다. 놈은 죽은 자를 부리는 법을 반쯤만 배웠지./지하실 2층 끝에서 놈을 쓰러뜨려라. 놈의 지팡이에 묶인 혼들이 네 그림자 곁으로 오게 될 거다.", outro = "모르그가 쓰러졌군. 놈이 묶어 두던 혼들이 네 그림자 곁으로 모여든다./이제 그림자를 하나 더 거느릴 수 있다. 악몽과 지옥에서도 놈을 쓰러뜨리면 그때마다 하나씩 더 늘어날 거다." })
        table.insert(self.List, { title = "사라진 병사의 유물", desc = "무너진 형장 곁가지 「뼈 구덩이」 2층의 「유물 지기」를 쓰러뜨리고 교단의 유물을 되찾아라.", zone = "뼈 구덩이 2층", objective = "유물 지기 처치 → 교단의 유물 회수", kind = "boss", target = "relic_keeper", map = "pit2", map1 = "", giver = "smith", count = 1, exp = 0, gold = 300, reward = "gen:3,socket:1", intro = "네가 오렌이 말하던 네크로맨서군. 나는 하르크, 이 야영지의 대장장이다./형장 아래 뼈 구덩이에 교단의 유물을 끌어안은 망자가 있다. 다들 「유물 지기」라 부르지./놈을 쓰러뜨리고 유물을 가져와라. 대가로 좋은 물건을 하나 골라 주고, 소켓도 하나 공짜로 뚫어 주마.", outro = "이게 교단의 유물인가… 무겁군. 망자의 손때가 묻었어./약속한 물건이다. 그리고 소켓권 한 장 — 아무 장비나 가져오면 뚫어 주지." })
        table.insert(self.List, { title = "피의 제단", desc = "교수대 숲의 피의 제단에 다가가 의식을 막아라. 세 번의 습격 뒤 나타나는 「피의 사제」를 쓰러뜨려야 한다.", zone = "교수대 숲", objective = "제단 의식 → 피의 사제 처치", kind = "ritual", target = "blood_priest", map = "gallows", map1 = "blood_altar", giver = "quest", count = 1, exp = 8000, gold = 300, reward = "stp:5", intro = "교수대 숲에서 피 냄새가 짙어지고 있다. 누군가 숲 어딘가에 피의 제단을 세웠다./제단에 다가가면 의식이 깨어날 거다. 망자들이 몰려오고, 마지막엔 제단의 주인이 모습을 드러내겠지./피의 사제를 쓰러뜨려라. 그러면 제단의 힘을 네 편으로 돌려놓을 수 있다.", outro = "피의 사제가 죽었다니… 제단은 이제 네 편이다. 다가가면 피의 힘이 잠시 깃들 거다./네 몸에 혼의 기운이 더 쌓였을 거다. 능력치를 다듬어라." })
        table.insert(self.List, { title = "목 없는 처형인", desc = "교수대 숲의 「목 없는 처형인」을 쓰러뜨려 열쇠를 얻고, 「목매단 동굴」 끝방의 봉인 상자를 열어라.", zone = "교수대 숲 · 목매단 동굴", objective = "처형인 처치 → 동굴 봉인 상자", kind = "chest", target = "headsman", map = "cave", map1 = "gallows", giver = "quest", count = 2, exp = 0, gold = 400, reward = "runes:2", intro = "제단을 지키던 자의 정체를 알아냈다. 목 없는 처형인. 교수대 숲의 사형 집행인이었지./놈의 허리춤에 열쇠가 매달려 있다. 숲 옆 「목매단 동굴」 끝방, 교단이 봉인한 상자의 열쇠다./처형인을 쓰러뜨리고 그 상자를 열어라. 상자를 열었다고 알려 주면 내가 모아 둔 룬도 나눠 주지.", outro = "봉인 상자를 열었군. 처형인에게 묶였던 혼들도 풀려났다./약속한 룬이다. 장비 소켓에 박으면 힘이 깨어난다." })
        table.insert(self.List, { title = "묘지기 여왕", desc = "지하 납골당 가장 깊은 곳, 여왕의 무덤에서 묘지기 여왕을 쓰러뜨려라.", zone = "여왕의 무덤", objective = "묘지기 여왕 처치", kind = "kill", target = "grave_queen", map = "queentomb", map1 = "", giver = "quest", count = 1, exp = 20000, gold = 1500, reward = "rune:r_as,rune:r_ireun", intro = "모든 혼각의 기운이 한 곳으로 모이고 있다. 지하 납골당 가장 깊은 곳, 여왕의 무덤이다./묘지기 여왕. 이 땅의 망자를 모두 다스리던 자다. 여왕을 쓰러뜨리지 않으면 잿빛 변경은 영영 잠들지 못한다./준비가 되면 가라. 돌아오지 못할 수도 있다.", outro = "…해냈구나. 여왕의 저주가 걷혔다./하지만 혼각은 더 깊은 곳에서 울리고 있다. 이건 시작일 뿐이다, 네크로맨서./여왕의 관에서 나온 두 룬이다. 아스와 이른 — 등불에 함께 박으면 「첫 번째 군령」이 깨어난다." })
    end

    method any Get(integer index)
        self:Ensure()
        return self.List[index]
    end

    method integer Count()
        self:Ensure()
        return #self.List
    end

    method integer IndexOf(string kind, string target)
        -- 그 종류·대상의 의뢰 번호 (없으면 0)
        self:Ensure()
        for i, q in ipairs(self.List) do
            if q.kind == kind and q.target == target then return i end
        end
        return 0
    end

    method string GiverName(string giver)
        -- 의뢰인 NPC 종류 → 이름 (npcs.csv와 같은 이름)
        if giver == "smith" then return "대장장이 하르크" end
        return "사제 오렌"
    end

    method string RewardText(string reward)
        -- 보상 문자열("rune:r_as,item:...,skp:1,stp:5,gen:2,deploy:1,runes:2,socket:1") → 표시용
        local parts = {}
        for key, val in string.gmatch(reward, "(%a+):([^,]+)") do
            if key == "rune" then
                local r = _ItemData:GetRune(val)
                table.insert(parts, (r ~= nil and r.name or val) .. " 룬")
            elseif key == "item" then table.insert(parts, _ItemData:Parse(val).name)
            elseif key == "skp" then table.insert(parts, "스킬 포인트 " .. val)
            elseif key == "stp" then table.insert(parts, "능력치 포인트 " .. val)
            elseif key == "deploy" then table.insert(parts, "그림자 배치 +" .. val .. " (영구 · 난이도마다)")
            elseif key == "runes" then table.insert(parts, "룬 " .. val .. "개")
            elseif key == "socket" then table.insert(parts, "소켓권 " .. val .. "장")
            elseif key == "gen" then table.insert(parts, val == "3" and "희귀 장비 (보장)" or "마법 장비") end
        end
        return table.concat(parts, ", ")
    end

end
