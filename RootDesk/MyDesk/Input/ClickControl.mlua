-- PC 마우스 조작 (디아블로2식). DefaultPlayer 모델에 붙고, 내 캐릭터에서만 동작한다.
--   바닥 클릭/누르고 있기 → 그 지점으로 이동
--   몬스터 클릭/누르고 있기 → 다가가서 공격 (공격 자체는 기존 PlayerAttack 경로를 그대로 쓴다)
--   방향키 입력 → 클릭 이동 취소 (키보드 조작과 함께 쓸 수 있다)
-- 모바일은 이 컴포넌트를 쓰지 않고 가상 스틱(ShadowHUD 모바일 패드)을 쓴다.
@Component
script ClickControl extends Component

    property boolean MouseMode = true       -- HUD의 조작 전환 버튼으로 끄고 켠다
    property number ArriveDistance = 0.12
    property number AttackReach = 0.9        -- PlayerAttack 범위(앞쪽 0.7 + 폭 1.6)에 맞춘 사거리
    property number PickRadius = 0.6         -- 클릭 지점에서 이 거리 안의 몬스터를 대상으로 본다
    property number AttackInterval = 0.45
    property number MoveSpeed = 1.0          -- 키보드 이동과 비슷한 체감 속도
    property boolean ModalHoldsController = false
    property boolean OwnsController = false
    property boolean PendingControllerRestore = false
    property boolean Moving = false
    property integer TimerId = 0
    property integer TimerGeneration = 0
    property boolean DebugLog = false
    property number LastTick = 0
    property number AttackRootUntil = 0      -- 평타 판정 전까지 제자리 (RootForAttack)

    property boolean HasDestination = false
    property Vector2 Destination = Vector2(0, 0)
    property Entity AttackTarget = nil
    property Entity ExtractTarget = nil
    property number AttackTimer = 0
    -- 막힘 미끄러지기: 움직이려는데 제자리면 잠깐 옆으로 비켜 간다 (벽·장애물 모서리)
    property Vector2 WantDir = Vector2(0, 0)
    property Vector2 LastPos = Vector2(0, 0)
    property number StuckTime = 0
    property number SlideUntil = 0
    property Vector2 SlideDir = Vector2(0, 0)
    property integer SlideSide = 1
    property integer SlideCount = 0           -- 비켜 가도 앞으로 못 나간 횟수 (3번이면 포기하고 멈춘다)
    property Vector2 StuckPos = Vector2(0, 0)
    property table Route = {}
    property integer RouteIndex = 1
    property Entity RouteMap = nil
    property Vector2 RouteGoal = Vector2(0, 0)
    property number RouteRecheckAt = 0
    property number RouteFoundAt = -99
    property number RouteMinInterval = 0.15   -- 경로 재탐색 최소 간격 (A*+다듬기 비용)
    property number NextBlockedHintAt = 0
    property boolean BlockedPick = false
    property Vector2 BlockedPoint = Vector2(0, 0)

    @ExecSpace("ClientOnly")
    method boolean IsActive()
        -- 내 캐릭터 + PC 마우스 모드. 모바일은 몬스터·혼을 터치해 다가가는 동안만 (바닥 이동은 조이스틱)
        if self.Entity ~= _UserService.LocalPlayer then return false end
        if not Environment:IsPCPlatform() then return isvalid(self.AttackTarget) or isvalid(self.ExtractTarget) end
        return self.MouseMode
    end

    @ExecSpace("ClientOnly")
    method void MobileTap(Vector2 screenPoint)
        -- 모바일 수동 조준: 터치한 몬스터를 대상으로 골라 다가가 친다. 적이 없는 곳의 내 혼이면 걸어가 추출한다.
        local world = _UILogic:ScreenToWorldPosition(screenPoint)
        -- 손가락은 마우스보다 덜 정확해서 판정 반경을 넓힌다
        local nearest = _Util:NearestMonster(self.Entity.CurrentMap, Vector2(world.x, world.y - 0.25), self.PickRadius * 1.5)
        local monster = nearest ~= nil and nearest.Entity or nil
        if monster ~= nil then
            self.ExtractTarget = nil
            self.HasDestination = false
            self.SlideCount = 0
            self.StuckTime = 0
            self:SelectAttackTarget(monster)
            return
        end
        local extractor = self:Extractor()
        local soul = extractor ~= nil and extractor:FindNearestSoul(Vector2(world.x, world.y - 0.25), self.PickRadius) or nil
        if soul ~= nil then
            self:SelectAttackTarget(nil)
            self.ExtractTarget = soul
        end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleScreenTouchEvent(ScreenTouchEvent event)
        -- 클릭한 순간: 대상/목적지 지정 + 클릭 표시
        if self.Entity ~= _UserService.LocalPlayer then return end
        if not Environment:IsPCPlatform() then
            if not _InputService:IsPointerOverUI() and not _UIKit:AnyWindowOpen() and _Util:IsAlive(self.Entity) then self:MobileTap(event.TouchPoint) end
            return
        end
        if event.TouchId ~= 1 or not self:IsActive() then return end
        if _InputService:IsPointerOverUI() or _UIKit:AnyWindowOpen() then return end
        if self:IsStationaryAttack() then
            self:Cancel()
            self:AttackAtCursor()
            return
        end
        self.BlockedPick = false
        self.SlideCount = 0
        self.StuckTime = 0
        local world = self:Pick(event.TouchPoint)
        -- 클릭 표시는 땅을 눌러 이동할 때만 (몬스터·혼을 누를 때는 표시 없음)
        if self.HasDestination then _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, Vector3(world.x, world.y, 0), 0, Vector3(0.25, 0.25, 1), false, nil) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleScreenTouchHoldEvent(ScreenTouchHoldEvent event)
        -- 누르고 있는 동안: 커서를 따라 목적지/대상 갱신
        if event.TouchId ~= 1 or not self:IsActive() then return end
        if _InputService:IsPointerOverUI() or _UIKit:AnyWindowOpen() then return end
        if self:IsStationaryAttack() then self:AttackAtCursor() return end
        self:Pick(event.TouchPoint)
    end

    @ExecSpace("ClientOnly")
    method boolean IsStationaryAttack()
        -- Shift+클릭은 이동 목적지를 만들지 않고 커서 방향으로 공격한다.
        return _InputService:IsKeyPressed(KeyboardKey.LeftShift) or _InputService:IsKeyPressed(KeyboardKey.RightShift)
    end

    @ExecSpace("ClientOnly")
    method void AttackAtCursor()
        -- 누른 채 커서를 옮겨도 서버 공격 간격과 기존 아바타 입력 경로를 지킨다.
        if self.AttackTimer > 0 or _UIKit:AnyWindowOpen() then return end
        local stats = self.Entity:GetComponent("script.PlayerStats")
        self.AttackTimer = self.AttackInterval
        if stats ~= nil then self.AttackTimer = stats:GetAttackInterval(self.AttackInterval) end
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil then attack:SubmitBasicInput() end
        self.Entity.PlayerControllerComponent:ActionAttack()
    end

    @ExecSpace("ClientOnly")
    method Vector2 Pick(Vector2 screenPoint)
        -- 화면 좌표 → 월드 좌표. 근처에 살아 있는 몬스터가 있으면 공격 대상, 없으면 이동 목적지
        local world = _UILogic:ScreenToWorldPosition(screenPoint)
        if self.BlockedPick and (world - self.BlockedPoint):Magnitude() < 0.35 then return world end
        self.BlockedPick = false
        -- 살아 있는 적과 혼이 겹치면 적을 먼저 고른다. 혼 추출이 평타 대상을 지우지 않게 한다.
        self.ExtractTarget = nil
        local monster = self:FindMonsterNear(world)
        if monster ~= nil then
            if self.AttackTarget ~= monster then self.SlideCount = 0 self.StuckTime = 0 end
            self:SelectAttackTarget(monster)
            self.HasDestination = false
            return world
        end
        -- 적이 없는 곳의 내 혼을 클릭했으면 기존처럼 걸어가서 추출한다.
        local extractor = self:Extractor()
        local soul = nil
        if extractor ~= nil then soul = extractor:FindNearestSoul(Vector2(world.x, world.y - 0.25), self.PickRadius) end
        if soul ~= nil then
            self.ExtractTarget = soul
            self:SelectAttackTarget(nil)
            self.HasDestination = false
            return world
        end
        if not self.HasDestination or (world - self.Destination):Magnitude() > 0.35 then self.SlideCount = 0 self.StuckTime = 0 end
        self:SelectAttackTarget(nil)
        self.Destination = world
        self.HasDestination = true
        return world
    end

    @ExecSpace("ClientOnly")
    method Entity FindMonsterNear(Vector2 point)
        -- 클릭 지점에 가장 가까운 살아 있는 몬스터 (발밑보다 몸통을 클릭하므로 y를 조금 내려 비교)
        local m = _Util:NearestMonster(self.Entity.CurrentMap, Vector2(point.x, point.y - 0.25), self.PickRadius)
        if m == nil then return nil end
        return m.Entity
    end

    method SoulExtractor Extractor()
        ---@type SoulExtractor
        local c = self.Entity:GetComponent("script.SoulExtractor")
        return c
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- OnUpdate에서 속도를 넣으면 같은 프레임에 기본 PlayerController가 0으로 덮어쓴다.
        -- 타이머 콜백은 그 뒤에 실행되므로 1/60초 반복 타이머로 진행한다 (메이커에서 확인)
        self:StopInputTimer()
        local generation = self.TimerGeneration
        self.LastTick = _UtilLogic.ElapsedSeconds
        self.TimerId = _TimerService:SetTimer(self, function()
            if not isvalid(self) or not isvalid(self.Entity) then return end
            if generation ~= self.TimerGeneration then return end
            local now = _UtilLogic.ElapsedSeconds
            local delta = now - self.LastTick
            self.LastTick = now
            self:Tick(delta)
        end, 1 / 60, true)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 컨트롤러·대상 정리보다 먼저 반복 작업을 끊어 종료 순서에 의한 누수를 막는다.
        self:StopInputTimer()
        if isvalid(self.Entity) and self.Entity == _UserService.LocalPlayer then
            self:Cancel()
            self:ReleaseWindowControl()
            self:RestoreController()
        end
    end

    @ExecSpace("ClientOnly")
    method void OnDestroy()
        -- 종료와 파괴가 연이어 와도 같은 타이머를 두 번 정리하지 않는다.
        self:StopInputTimer()
    end

    @ExecSpace("ClientOnly")
    method void StopInputTimer()
        -- 재초기화·종료 뒤 늦게 도착한 이전 콜백도 더 이상 입력을 처리하지 않는다.
        self.TimerGeneration = self.TimerGeneration + 1
        if self.TimerId ~= 0 then
            _TimerService:ClearTimer(self.TimerId)
            self.TimerId = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void Tick(number delta)
        -- 클릭 이동·공격 진행. 방향키를 누르면 즉시 취소
        if self.Entity ~= _UserService.LocalPlayer then return end
        if _UIKit:AnyWindowOpen() then
            self:Cancel()
            self:HoldWindowControl()
            return
        end
        -- 평타 준비~판정 사이에는 제자리에 선다 (D2처럼). 모션만 나오고 헛스윙하는 일을 막는다.
        if _UtilLogic.ElapsedSeconds < self.AttackRootUntil and _Util:IsAlive(self.Entity) then
            self:HoldWindowControl()
            return
        end
        self:ReleaseWindowControl()
        self:RestoreController()
        if not self:IsActive() or not _Util:IsAlive(self.Entity) then
            self:Cancel()
            return
        end
        self.AttackTimer = self.AttackTimer - delta
        if self:IsArrowPressed() then
            self:Cancel()
            return
        end
        local p = self.Entity.TransformComponent.WorldPosition
        local me = Vector2(p.x, p.y)
        self:CheckStuck(me, delta)

        if self.ExtractTarget ~= nil then
            if not isvalid(self.ExtractTarget) then
                self.ExtractTarget = nil
                self:StopMove()
                return
            end
            local s = self.ExtractTarget.TransformComponent.WorldPosition
            local toSoul = Vector2(s.x, s.y) - me
            if toSoul:Magnitude() > _ShadowConfig:GetExtractReach() * 0.8 then
                self:Navigate(Vector2(s.x, s.y))
            else
                self:StopMove()
                local extractor = self:Extractor()
                if extractor ~= nil then extractor:RequestExtract(self.ExtractTarget) end
                self.ExtractTarget = nil
            end
            return
        end

        if isvalid(self.AttackTarget) then
            ---@type Monster
            local m = self.AttackTarget:GetComponent("script.Monster")
            if m == nil or m.IsDead or not self.AttackTarget.Enable or self.AttackTarget.CurrentMap ~= self.Entity.CurrentMap then
                self:SelectAttackTarget(nil)
                self:StopMove()
                return
            end
            local t = self.AttackTarget.TransformComponent.WorldPosition
            local toTarget = Vector2(t.x, t.y) - me
            if toTarget:Magnitude() > self.AttackReach then
                self:Navigate(Vector2(t.x, t.y))
            else
                self:StopMove()
                self:Face(toTarget.x)
                if self.AttackTimer <= 0 then
                    ---@type PlayerStats
                    local stats = self.Entity:GetComponent("script.PlayerStats")
                    self.AttackTimer = self.AttackInterval
                    if stats ~= nil then self.AttackTimer = stats:GetAttackInterval(self.AttackInterval) end
                    local attack = self.Entity:GetComponent("script.PlayerAttack")
                    if attack ~= nil then attack:SubmitBasicInput() end
                    self.Entity.PlayerControllerComponent:ActionAttack()
                end
            end
            return
        end

        if self.AttackTarget ~= nil then self:SelectAttackTarget(nil) self:StopMove() end
        if self.HasDestination then
            local toDest = self.Destination - me
            if toDest:Magnitude() <= self.ArriveDistance then
                self.HasDestination = false
                self:StopMove()
            else
                self:Navigate(self.Destination)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsArrowPressed()
        return _InputService:IsKeyPressed(KeyboardKey.LeftArrow) or _InputService:IsKeyPressed(KeyboardKey.RightArrow)
            or _InputService:IsKeyPressed(KeyboardKey.UpArrow) or _InputService:IsKeyPressed(KeyboardKey.DownArrow)
    end

    @ExecSpace("ClientOnly")
    method void Cancel()
        -- 메뉴·맵 변경·포커스 해제에서 이전 클릭과 막힘 판정을 함께 지운다.
        self:ClearRoute()
        self.StuckTime = 0
        self.BlockedPick = false
        self.WantDir = Vector2(0, 0)
        self.SlideCount = 0
        self.SlideUntil = 0
        self.HasDestination = false
        self:SelectAttackTarget(nil)
        self.ExtractTarget = nil
        self:StopMove()
    end

    @ExecSpace("ClientOnly")
    method void SelectAttackTarget(Entity target)
        if self.AttackTarget == target then return end
        self.AttackTarget = target
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil then attack:RequestSelectTarget(target) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "ApplicationService")
    handler HandleApplicationFocusOutEvent(ApplicationFocusOutEvent event)
        if self.Entity == _UserService.LocalPlayer then self:Cancel() end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleEntityMapChangedEvent(EntityMapChangedEvent event)
        -- 포털 이외의 맵 이동에서도 이전 목적지·대상을 다음 맵으로 가져가지 않는다.
        if self.Entity == _UserService.LocalPlayer then self:Cancel() end
    end

    @ExecSpace("ClientOnly")
    method void RootForAttack(number seconds)
        -- 서버가 받아들인 평타의 판정 순간까지 이동 입력을 잠깐 멈춘다. 다음 Tick에서 풀린다.
        self.AttackRootUntil = math.max(self.AttackRootUntil, _UtilLogic.ElapsedSeconds + math.max(0, seconds))
    end

    @ExecSpace("ClientOnly")
    method void HoldWindowControl()
        -- 열린 메뉴 뒤에서는 키보드/가상 패드의 기본 컨트롤러도 걷지 못하게 한다.
        local controller = self.Entity.PlayerControllerComponent
        if controller.Enable then
            self.ModalHoldsController = true
            controller.Enable = false
        end
        self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
    end

    @ExecSpace("ClientOnly")
    method void ReleaseWindowControl()
        -- 이 컴포넌트가 창 때문에 끈 컨트롤러만, 살아난 뒤 복구한다.
        if not self.ModalHoldsController then return end
        self.ModalHoldsController = false
        self.PendingControllerRestore = true
    end

    @ExecSpace("ClientOnly")
    method void RestoreController()
        -- 죽은 동안 되살리지 않고, 부활 뒤 클릭 이동이 빌린 컨트롤러만 복구한다.
        if not self.PendingControllerRestore or not _Util:IsAlive(self.Entity) then return end
        if self.Entity.StateComponent.CurrentStateName == "DEAD" then return end
        self.Entity.PlayerControllerComponent.Enable = true
        self.PendingControllerRestore = false
    end

    @ExecSpace("ClientOnly")
    method void CheckStuck(Vector2 me, number delta)
        -- 이동 중인데 0.2초 동안 거의 안 움직였으면 0.35초 옆으로 비켜 간다 (번갈아 좌우)
        local moved = (me - self.LastPos):Magnitude()
        self.LastPos = me
        if not self.Moving or delta <= 0 then
            self.StuckTime = 0
            return
        end
        if moved < 0.25 * delta then self.StuckTime = self.StuckTime + delta else self.StuckTime = 0 end
        if self.StuckTime < 0.2 then return end
        self.StuckTime = 0
        local w = self.WantDir
        -- 지난번 막힌 곳에서 가려는 방향으로 0.3도 못 나갔으면 갈 수 없는 곳 (맵 밖·막힌 방)
        local progress = (me - self.StuckPos):Dot(w)
        if self.SlideCount > 0 and progress < 0.3 then self.SlideCount = self.SlideCount + 1 else self.SlideCount = 1 end
        self.StuckPos = me
        if self.SlideCount >= 3 then
            if self.DebugLog then log("[ClickControl] 갈 수 없는 곳 → 멈춤") end
            local point = self.Destination
            if isvalid(self.AttackTarget) then point = _Util:Pos2(self.AttackTarget) + Vector2(0, 0.25) end
            self:Cancel()
            self.BlockedPoint = point
            self.BlockedPick = true
            return
        end
        self.SlideDir = Vector2(-w.y, w.x) * self.SlideSide + w * 0.3
        self.SlideSide = -self.SlideSide
        self.SlideUntil = _UtilLogic.ElapsedSeconds + 0.35
        if self.DebugLog then log("[ClickControl] 막힘 → 옆으로") end
    end

    @ExecSpace("ClientOnly")
    method void ClearRoute()
        -- 오래된 맵의 타일·우회 점을 붙잡지 않는다.
        self.Route = {}
        self.RouteIndex = 1
        self.RouteMap = nil
        self.RouteRecheckAt = 0
    end

    @ExecSpace("ClientOnly")
    method void Navigate(Vector2 goal)
        -- 목적지가 움직이거나 지형이 바뀌었을 때만 제한된 경로를 다시 계산한다.
        local me = _Util:Pos2(self.Entity)
        local now = _UtilLogic.ElapsedSeconds
        -- 끌어서 이동하면 목적지가 매 프레임 바뀐다. 다시 찾기는 최소 RouteMinInterval 간격으로만 (모바일 끊김 방지).
        local goalMoved = (goal - self.RouteGoal):Magnitude() > 0.3 and now - self.RouteFoundAt >= self.RouteMinInterval
        if self.RouteMap ~= self.Entity.CurrentMap or goalMoved or now >= self.RouteRecheckAt then
            self.Route = _GroundPath:Find(self.Entity.CurrentMap, me, goal)
            self.RouteFoundAt = now
            self.RouteIndex = 1
            self.RouteMap = self.Entity.CurrentMap
            self.RouteGoal = goal
            self.RouteRecheckAt = now + 0.8
            if self.HasDestination and #self.Route > 0 and (self.Route[#self.Route] - goal):Magnitude() > self.ArriveDistance then
                self.BlockedPoint = goal
                self.BlockedPick = true
                self.Destination = self.Route[#self.Route]
                self.RouteGoal = self.Destination
            end
        end
        if #self.Route == 0 then
            local point = goal
            if isvalid(self.AttackTarget) or isvalid(self.ExtractTarget) then point = goal + Vector2(0, 0.25) end
            self:Cancel()
            self.BlockedPick = true
            self.BlockedPoint = point
            if now >= self.NextBlockedHintAt then
                self.NextBlockedHintAt = now + 2
                _ScreenMessageLogic:PrivateMsg("지나갈 수 없는 지점입니다")
                _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, Vector3(goal.x, goal.y, 0), 0, Vector3(0.25, 0.25, 1), false, {Color=Color(0.6,0.2,0.18,0.7)})
            end
            return
        end
        while self.RouteIndex <= #self.Route and (self.Route[self.RouteIndex] - me):Magnitude() <= self.ArriveDistance do self.RouteIndex = self.RouteIndex + 1 end
        if self.RouteIndex > #self.Route then
            self:StopMove()
            self.RouteRecheckAt = 0
            return
        end
        self:MoveToward(self.Route[self.RouteIndex] - me)
    end

    @ExecSpace("ClientOnly")
    method void MoveToward(Vector2 dir)
        -- 기본 PlayerController는 입력이 없으면 물리 계산 전에 속도를 0으로 덮어쓴다.
        -- 클릭 이동 중에만 컨트롤러를 끄고 MovementComponent로 직접 움직인다 (메이커에서 확인한 방식)
        local controller = self.Entity.PlayerControllerComponent
        if not self.Moving then
            if not controller.Enable then return end
            self.OwnsController = true
            controller.Enable = false
        end
        self.WantDir = dir:Normalize()
        local go = self.WantDir
        if _UtilLogic.ElapsedSeconds < self.SlideUntil then go = self.SlideDir:Normalize() end
        self.Entity.MovementComponent:MoveToDirection(go, 0)
        self:Face(dir.x)
        if not self.Moving then
            self.Moving = true
        end
        local state = self.Entity.StateComponent
        if state.CurrentStateName == "IDLE" then state:ChangeState("MOVE") end
        if self.DebugLog then log("[ClickControl] move " .. tostring(dir:Normalize())) end
    end

    @ExecSpace("ClientOnly")
    method void StopMove()
        -- 멈추고 기본 컨트롤러를 다시 켠다 (키보드 입력·공격 동작이 컨트롤러를 거치므로)
        if not self.Moving then return end
        self.Moving = false
        self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
        if self.OwnsController then
            self.PendingControllerRestore = true
            self.OwnsController = false
            self:RestoreController()
        end
        local state = self.Entity.StateComponent
        if state.CurrentStateName == "MOVE" then state:ChangeState("IDLE") end
    end

    @ExecSpace("ClientOnly")
    method void Face(number dx)
        -- 공격 판정이 LookDirectionX를 쓰므로 부호(±1)만 넣는다
        if math.abs(dx) < 0.05 then return end
        self.Entity.PlayerControllerComponent.LookDirectionX = dx >= 0 and 1 or -1
    end

    @ExecSpace("ClientOnly")
    method void SetMouseMode(boolean enabled)
        self.MouseMode = enabled
        self:Cancel()
        if not enabled then self:StopMove() end
    end

end
