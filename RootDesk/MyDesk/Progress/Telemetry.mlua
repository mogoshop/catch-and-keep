-- 테스트 플레이 기록 (10-20, 밸런스를 숫자로 깎기 위한 장치). 서버만 동작한다.
--   접속 한 번 = 세션 하나: 레벨업 시각 · 사망(레벨·맵·원인) · 처치 수(등급별) · 전리품(등급·룬 등급) · 물약 사용 · 의뢰 완료 시각 · 맵별 머문 시간
--   5분마다와 퇴장 때 GlobalDataStorage "PlayTelemetry"에 세션 하나를 JSON으로 쓴다 (태그 "tel"). 「[TEL]」 로그로도 남긴다
--   기간: config telemetryEndUnix(출시 10-25부터 한 달 — 2026-11-26 0시 한국 시간)가 지나면 새로 쓰지 않는다. 출시 서버에서는 「[TEL]」 로그를 끈다 (10-24 사용자 T-B)
--   읽기: 메이커 서버 스크립트에서 _Telemetry:Dump(20) → 최근 세션 요약을 로그로 (레벨당 걸린 분, 사망 원인 상위, 시간당 처치·전리품)
-- 게임 쪽은 _GameEvents로 알리기만 한다 (LevelUp · ItemLooted · PotionUsed · PlayerDied · MonsterKilled · QuestCompleted · ShadowExtracted)
-- M0 「처음」 시각 (기획서 39 §2 A · 부록 A M0 · 10-29 결정 #1A): 접속을 0초로 단계마다 처음 지난 초를 세션에 first.<단계>=초로 남긴다.
--   단계: load 불러오기 끝 · charSelect 캐릭터 선택 · prologue 프롤로그 끝 · guideOpen/guideClose 둘러보기 열림/닫힘(guideClosedPage = 몇 쪽) ·
--         guideLater 「나중에 보기」 · move 첫 이동 · kill 첫 처치 · taste 첫 일시 그림자 · shadow 첫 그림자(추출) · town 첫 마을 방문 · death 첫 사망
--   방(로비 → 게임 방 → 심연)마다 Logic이 따로라 같은 채널 방 사이 공유 메모리(TelFirstV1)로 접속 시각과 찍은 단계를 넘긴다.
--   캐릭터를 고르기 전에 나간 접속도 작은 기록(pre = 1)으로 남긴다. GM 요약: 채팅 「/tel [세션 수]」 (ChatFold → RequestFirstSummary) 또는 _Telemetry:FirstSummary(200)
@Logic
script Telemetry extends Logic

    property table Sessions = {}             -- userId → 세션 표
    property table Firsts = {}               -- userId → { join = 접속 유닉스 초, f = { 단계 = 초 }, field = 사냥터에 나간 적, lv = 고른 캐릭터 레벨 } (M0)
    property string FirstMemoryName = "TelFirstV1"
    property number FirstCarrySec = 120       -- 방을 떠난 뒤 이 안에 다른 방에 들어오면 같은 접속으로 잇는다
    property integer FirstReadCap = 1500      -- GM 요약이 읽는 저장 세션 최대 수 (DataStorage 읽기 비용 상한)
    property string GmProfileCodes = ""       -- GM 요약 명령을 쓸 프로필 코드 ","로 (승인 전 — 사용자가 채운다). 메이커 플레이는 늘 허용
    property number GmAskAt = -100            -- 서버: 마지막 GM 요약 시각 (10초에 한 번)
    property boolean MoveReported = false     -- 클라이언트: 첫 이동을 알렸다
    property number MoveCheckAt = 0
    property Vector2 MoveLastPos = Vector2(0, 0)
    property integer MoveSteps = 0
    property integer TickTimer = 0
    property integer FlushTimer = 0
    property number TickSec = 5               -- 맵 체류 시간 집계 간격
    property number FlushSec = 300            -- 저장 간격
    property string StorageName = "PlayTelemetry"
    property boolean Enabled = true
    property integer RoomTicks = 0            -- 방 부하 표본 간격 (TickSec × 12 = 1분)
    -- 성장 관측 (D P3·P5·P7 · 10-30): 실행 중 상태만 (저장 안 함)
    property any GrowthState = nil            -- uid → init·pos·kills·extracts·act·dealtAt · 퇴장 때 지운다
    property number DealtThrottleSec = 1      -- PlayerDealtDamage 사용자당 최소 간격 (ArmDealt로 바로 풀 수 있다)
    property integer A2Cap = 120              -- 액트 2 첫 10분 표본 상한 (5초 × 120 = 600초)
    property number A2Sec = 600
    -- 개발용 전투 계측 (I05): 기본 꺼짐 · Sessions 밖 · 저장 없음 (아래 「개발용 전투 계측」 절)
    property boolean DpsOn = false            -- DpsStart로만 켠다. Monster가 매 피해마다 이 값 하나만 본다
    property integer DpsRunId = 0
    property any Dps = nil                    -- 지금 실행의 원장·집계 (일반 Lua 표 — property table은 읽을 때 느리다 · Flush가 저장하는 Sessions와 따로 · 꺼지면 nil)
    property any DpsCollection = nil          -- 현재 시험 수집 1개만 소유 (원장 Dps와 별개 · 저장 안 함 · 타이머/시험대상 정리 함수)
    property string DpsFilter = ""             -- 비어 있지 않으면 엔티티 이름이 이 글자로 시작하는 몬스터만 기록 (시험 장면이 소환한 대상만 · 나머지는 filtered로 센다)
    property integer DpsRawCap = 4000         -- 원장 링 상한: 무리 장면 초당 ~60건 기준 약 1분치. 넘치면 오래된 것부터 덮고 dropped (집계는 계속)
    property integer DpsLifeCap = 600         -- 생명 표 상한 (넘치면 life_overflow — 원장·합계는 그대로)
    property integer DpsOwnerCap = 16         -- owner 상한 (파티 4명 + none + 여유)
    property integer DpsSourceCap = 32        -- owner별 출처 키 상한 (넘치면 overflow 키)
    property number DpsGapSec = 3             -- 전투 구간: 유효 피해 사이가 이보다 길면 끊는다 (해골 공격 간격 ~1초 · 짧은 재배치·이동은 잇고 다음 무리로의 이동은 끊는다)
    property number DpsMaxSec = 1800          -- 한 실행 최대 30분 (넘으면 기록만 멈춤)
    property number DpsSampleSec = 0.25       -- 마나·생명·소환수 표본 간격
    property integer DpsSampleTimer = 0
    property integer DpsFlushLineCap = 2000   -- DpsFlush 한 번의 로그 줄 상한

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        if not self:Active() then return end
        self.Sessions = {}
        self.Firsts = {}
        _GameEvents:Subscribe("LevelUp", "Telemetry", function(e) self:OnLevelUp(e) end)
        _GameEvents:Subscribe("PlayerDied", "Telemetry", function(e) self:OnDied(e) end)
        _GameEvents:Subscribe("MonsterKilled", "Telemetry", function(e) self:OnKill(e) end)
        _GameEvents:Subscribe("ItemLooted", "Telemetry", function(e) self:OnLoot(e) end)
        _GameEvents:Subscribe("PotionUsed", "Telemetry", function(e) self:Count(e.player, "potions", 1) end)
        _GameEvents:Subscribe("ShadowExtracted", "Telemetry", function(e)
            self:Count(e.player, "extracts", 1)
            self:First(e.player, "shadow")   -- M0: 첫 그림자 (혼 추출 성공)
        end)
        _GameEvents:Subscribe("QuestCompleted", "Telemetry", function(e) self:OnQuest(e) end)
        self.TickTimer = _TimerService:SetTimerRepeat(function() self:Tick() end, self.TickSec)
        self.FlushTimer = _TimerService:SetTimerRepeat(function() self:FlushAll() end, self.FlushSec)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.TickTimer ~= 0 then _TimerService:ClearTimer(self.TickTimer) end
        if self.FlushTimer ~= 0 then _TimerService:ClearTimer(self.FlushTimer) end
        self.TickTimer = 0
        self.FlushTimer = 0
        self:DpsCollectionStop("end_play")
        if self.DpsOn or self.DpsSampleTimer ~= 0 then self:DpsStop() end   -- 개발용 전투 계측도 함께 정리 (타이머 누수 없음)
    end

    -- ───────── 세션 ─────────

    @ExecSpace("ServerOnly")
    method any Session(Entity player)
        -- 그 플레이어의 지금 세션 (불러오기가 끝난 뒤에만 — 캐릭터 선택 화면·시험 캐릭터는 세지 않는다)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return nil end
        ---@type PlayerSave
        local save = player:GetComponent("script.PlayerSave")
        if save == nil or not save.IsLoadSuccess then return nil end
        local uid = player.PlayerComponent.UserId
        local s = self.Sessions[uid]
        if s == nil then
            local now = math.floor(DateTime.UtcNow.Elapsed / 1000)
            s = { uid = uid, start = now, t0 = _UtilLogic.ElapsedSeconds, lv0 = _GameConst:LevelOf(player), lv = _GameConst:LevelOf(player),
                diff = self:Diff(player), kills = 0, elite = 0, boss = 0, potions = 0, extracts = 0,
                maps = {}, levels = {}, deaths = {}, quests = {}, loot = { magic = 0, rare = 0, unique = 0, set = 0, runeword = 0, r1 = 0, r2 = 0, r3 = 0, r4 = 0 } }
            self.Sessions[uid] = s
            self:Say(string.format("[TEL] start uid=%s lv=%d diff=%d", uid, s.lv0, s.diff))
        end
        return s
    end

    method integer Diff(Entity player)
        ---@type PlayerStats
        local st = player:GetComponent("script.PlayerStats")
        return st ~= nil and st.Difficulty or 0
    end

    method number Minutes(any s)
        return math.floor((_UtilLogic.ElapsedSeconds - s.t0) / 6 + 0.5) / 10
    end

    method string MapName(Entity player)
        if not isvalid(player.CurrentMap) then return "?" end
        return _GameConst:BaseMapName(player.CurrentMap.Name)
    end

    @ExecSpace("ServerOnly")
    method void Count(Entity player, string field, integer n)
        local s = self:Session(player)
        if s ~= nil then s[field] = (s[field] or 0) + n end
    end

    @ExecSpace("ServerOnly")
    method void Tick()
        -- 맵별 머문 시간 (5초 단위)
        for _, player in pairs(_UserService.UserEntities) do
            local s = self:Session(player)
            if s ~= nil then
                local m = self:MapName(player)
                s.maps[m] = (s.maps[m] or 0) + self.TickSec
                self:GrowthTick(player, s)   -- P7 실활동 · P3 액트 2 첫 10분
            end
            self:CheckTownVisit(player)   -- M0 첫 마을 방문 (5초 단위)
        end
        -- 방 부하 (1분마다, 10-28 F7-4 빈 맵 정리 효과): 살아 있는 몬스터 수 · 잠든 맵 수 → 세션마다 최대·합·표본 수
        self.RoomTicks = self.RoomTicks + 1
        if self.RoomTicks % 12 ~= 0 then return end
        for uid, _ in pairs(self.Firsts) do self:SaveFirst(uid, false) end   -- M0: 1분마다 「아직 이 방에 있다」 (방 이동 때 접속 시각을 잇는 기준)
        local mobs, sleeping, maps, raid, inflow, pending = 0, 0, 0, 0, 0, 0
        local seen = {}
        for _, player in pairs(_UserService.UserEntities) do
            local root = isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Parent or nil
            if isvalid(root) and not seen[root.Id] then
                seen[root.Id] = true
                for _, map in ipairs(root.Children:ToTable()) do
                    maps = maps + 1
                    for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
                        if isvalid(c.Entity) and not c.IsDead then
                            mobs = mobs + 1
                            if c.Horde then raid = raid + 1 end   -- 습격의 떼 (기획서 41 L-E)
                            if c.Inflow then inflow = inflow + 1 end   -- 생성 D 유입으로 나온 몬스터 (10-29)
                        end
                    end
                    local sp = map:GetFirstChildComponentByTypeName("script.MonsterSpawner", true)
                    if sp ~= nil and sp.SpawnedAt <= 0 then sleeping = sleeping + 1 end
                    if sp ~= nil and sp.SpawnedAt > 0 then pending = pending + sp:PendingCount() end   -- 생성 D 깨우기 대기 무리의 몬스터 수
                end
            end
        end
        for _, player in pairs(_UserService.UserEntities) do
            local s = self:Session(player)
            if s ~= nil then
                s.roomMobMax = math.max(s.roomMobMax or 0, mobs)
                s.roomMobSum = (s.roomMobSum or 0) + mobs
                s.roomSamples = (s.roomSamples or 0) + 1
                s.roomSleepMax = math.max(s.roomSleepMax or 0, sleeping)
                s.raidMobMax = math.max(s.raidMobMax or 0, raid)
                s.inflowMax = math.max(s.inflowMax or 0, inflow)
                s.pendingMax = math.max(s.pendingMax or 0, pending)
            end
        end
        self:Say(string.format("[TEL] room mobs=%d raid=%d inflow=%d pending=%d sleeping=%d maps=%d", mobs, raid, inflow, pending, sleeping, maps))
    end

    @ExecSpace("ServerOnly")
    method void NoteRaid(Entity player, string key)
        -- 습격 지표 (RaidDirector): raidCount · raidWins · raidSkips — 출시 서버에서 상한 25/30/40·600을 맞추는 세 숫자 중 둘 (기획서 41 L-E)
        local s = self:Session(player)
        if s ~= nil then s[key] = (s[key] or 0) + 1 end
    end

    -- ───────── 이벤트 ─────────

    @ExecSpace("ServerOnly")
    method void OnLevelUp(table e)
        local s = self:Session(e.player)
        if s == nil then return end
        s.lv = e.level
        if #s.levels >= 60 then return end   -- 긴 세션도 저장값 크기 한도에 걸리지 않게 60개까지만 (10-24 출시 점검)
        table.insert(s.levels, { lv = e.level, min = self:Minutes(s), map = self:MapName(e.player) })
        self:Say(string.format("[TEL] levelup uid=%s lv=%d min=%.1f map=%s", s.uid, e.level, self:Minutes(s), self:MapName(e.player)))
    end

    @ExecSpace("ServerOnly")
    method void OnDied(table e)
        self:First(e.player, "death")   -- M0: 첫 사망
        local s = self:Session(e.player)
        if s == nil then return end
        local cause = e.cause or "?"
        if #s.deaths >= 60 then return end   -- 긴 세션도 저장값 크기 한도에 걸리지 않게 60개까지만 (10-24 출시 점검)
        table.insert(s.deaths, { lv = _GameConst:LevelOf(e.player), map = self:MapName(e.player), cause = cause, min = self:Minutes(s) })
        self:Say(string.format("[TEL] death uid=%s lv=%d map=%s cause=%s min=%.1f", s.uid, _GameConst:LevelOf(e.player), self:MapName(e.player), cause, self:Minutes(s)))
    end

    @ExecSpace("ServerOnly")
    method void OnKill(table e)
        -- 보상 받은 사람 모두 (파티 처치도 각자 센다). M0 첫 처치는 막타 친 사람만 (소환수 막타는 주인)
        if e.player ~= nil and isvalid(e.player) then self:First(e.player, "kill") end
        for _, p in ipairs(e.players or { e.player }) do
            local s = self:Session(p)
            if s ~= nil then
                s.kills = s.kills + 1
                if (e.grade or 1) == 2 then s.elite = s.elite + 1 elseif (e.grade or 1) >= 3 then s.boss = s.boss + 1 end
                if e.horde then s.raidKills = (s.raidKills or 0) + 1 end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void OnLoot(table e)
        local s = self:Session(e.player)
        if s == nil then return end
        if e.kind == "rune" then
            local item = _ItemData:Parse(e.item or "")
            local t = _ShadowConfig:GetRuneTier(item.base)
            if t >= 1 and t <= 4 then s.loot["r" .. tostring(t)] = s.loot["r" .. tostring(t)] + 1 end
            return
        end
        if e.kind ~= "item" then return end
        local r = e.rarity or 0
        if r == 1 then s.loot.magic = s.loot.magic + 1
        elseif r == 2 then s.loot.rare = s.loot.rare + 1
        elseif r == 3 then s.loot.unique = s.loot.unique + 1
        elseif r == 4 then s.loot.set = s.loot.set + 1 end
        if r >= 3 then self:Say(string.format("[TEL] loot uid=%s rarity=%d item=%s min=%.1f", s.uid, r, _ItemData:DisplayName(e.item or ""), self:Minutes(s))) end
    end

    @ExecSpace("ServerOnly")
    method void OnQuest(table e)
        local s = self:Session(e.player)
        if s == nil then return end
        if #s.quests >= 60 then return end   -- 긴 세션도 저장값 크기 한도에 걸리지 않게 60개까지만 (10-24 출시 점검)
        table.insert(s.quests, { index = e.index or 0, lv = _GameConst:LevelOf(e.player), min = self:Minutes(s) })
        self:Say(string.format("[TEL] quest uid=%s index=%s lv=%d min=%.1f", s.uid, tostring(e.index), _GameConst:LevelOf(e.player), self:Minutes(s)))
    end

    -- ───────── 저장 · 읽기 ─────────

    method boolean Active()
        -- 기록 중인가: 켜져 있고 끝나는 시각(config telemetryEndUnix, 0이면 끝없이) 전
        if not self.Enabled then return false end
        local endAt = _GameData.telemetryEndUnix
        -- DateTime.Elapsed는 서기 1년 1월 1일부터의 밀리초다 (메이커 실측 10-24) → 유닉스 초로 바꾼다 (1970-01-01 = 62135596800초)
        return endAt <= 0 or DateTime.UtcNow.Elapsed / 1000 - 62135596800 < endAt
    end

    method void Say(string text)
        -- 「[TEL]」 로그는 메이커 테스트에서만 (출시 서버 로그를 채우지 않게)
        if not Environment:IsPublishedPlay() then log(text) end
    end

    @ExecSpace("ServerOnly")
    method void Flush(string uid, boolean final)
        local s = self.Sessions[uid]
        if s == nil then return end
        if not self:Active() then
            -- 기록 기간이 끝났다: 쓰지 않고 세션만 버린다
            if final then self.Sessions[uid] = nil end
            return
        end
        s.minutes = self:Minutes(s)
        local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
        if storage == nil then return end
        local saved = {}
        for k, v in pairs(s) do if k ~= "t0" then saved[k] = v end end
        self:CopyFirsts(uid, saved)   -- M0 first.<단계>=초 (방마다 세션이 나뉘어도 firstJoin으로 한 접속으로 묶는다)
        local ok, json = pcall(function() return _HttpService:JSONEncode(saved) end)
        if not ok then return end
        local key = uid .. "_" .. tostring(s.start)
        storage:SetByInfoAsync(DataStorageKeyInfo(key, "", "tel"), json, function(code, info)
            if code ~= 0 then log_warning("[TEL] save failed code=" .. tostring(code)) end
        end)
        if final then
            self:Say(string.format("[TEL] end uid=%s min=%.1f lv %d→%d kills=%d deaths=%d roomMobMax=%d inflowMax=%d pendingMax=%d", uid, s.minutes, s.lv0, s.lv, s.kills, #s.deaths, s.roomMobMax or 0, s.inflowMax or 0, s.pendingMax or 0))
            self.Sessions[uid] = nil
        end
    end

    @ExecSpace("ServerOnly")
    method void FlushAll()
        for uid, _ in pairs(self.Sessions) do self:Flush(uid, false) end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        self:FlushPre(event.UserId)
        self:Flush(event.UserId, true)
        self:LeaveFirst(event.UserId)
        if self.GrowthState ~= nil then self.GrowthState[event.UserId] = nil end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserEnterEvent(UserEnterEvent event)
        -- M0 접속: 다른 방에서 막 옮겨 왔으면 그 접속 시각을 잇고, 아니면 지금이 접속
        -- 앞 방이 떠나며 쓰는 기록이 먼저 닿게 2초 뒤에 연다 (그 전에 단계가 찍히면 그때 연다)
        if not self:Active() then return end
        local uid = event.UserId
        _TimerService:SetTimerOnce(function()
            if _UserService:GetUserEntityByUserId(uid) == nil then return end
            local r = self:FirstRecord(uid)
            self:Say(string.format("[VRF] first enter uid=%s t=%d room=%s", uid, self:UnixNow() - r.join, _RoomService.RoomKey))
        end, 2)
    end

    -- ───────── M0 「처음」 시각 ─────────

    method integer UnixNow()
        -- DateTime.Elapsed(서기 1년부터 밀리초) → 유닉스 초 (Active와 같은 환산)
        return math.floor(DateTime.UtcNow.Elapsed / 1000 - 62135596800)
    end

    method table FirstStages()
        -- 요약에 쓰는 순서 · 이름 (guideClosedPage는 초가 아니라 쪽 번호라 따로)
        return {
            { "load", "불러오기 끝" }, { "charSelect", "캐릭터 선택" }, { "prologue", "프롤로그 끝" },
            { "guideOpen", "둘러보기 열림" }, { "guideClose", "둘러보기 닫힘" }, { "guideLater", "「나중에 보기」" },
            { "move", "첫 이동" }, { "kill", "첫 처치" }, { "taste", "첫 일시 그림자" }, { "shadow", "첫 그림자(추출)" },
            { "town", "첫 마을 방문" }, { "death", "첫 사망" },
            -- 성장 관측 (D P1 · 기록은 PlayerQuest·PlayerInventory가 First로 남긴다)
            { "gearReward", "첫 장비 의뢰 보고" }, { "gearEquip", "새 장비 첫 장착" }, { "gearUse", "새 장비로 첫 유효 피해" }, { "gearChangedAtCredit", "공동 처치 때 장비 바뀜" },
            { "q1accept", "의뢰 1 수락" }, { "q1report", "의뢰 1 보고" }, { "q2accept", "의뢰 2 수락" }, { "q2report", "의뢰 2 보고" },
            { "q3accept", "의뢰 3 수락" }, { "q3report", "의뢰 3 보고" }, { "q4accept", "의뢰 4 수락" }, { "q4report", "의뢰 4 보고" },
            { "q4reportField", "제단 현장 보고" }, { "q5accept", "의뢰 5 수락" }, { "q5acceptField", "제단 현장 수락" }, { "q5report", "의뢰 5 보고" },
            { "q6accept", "의뢰 6 수락" }, { "q6report", "의뢰 6 보고" }, { "act2Enter", "첫 액트 2 입장" },
        }
    end

    @ExecSpace("ServerOnly")
    method any FirstRecord(string uid)
        -- 이 방의 접속 기록. 처음 보면 공유 메모리에서 이어받거나(FirstCarrySec 안) 새로 연다
        local r = self.Firsts[uid]
        if r ~= nil then return r end
        local now = self:UnixNow()
        local code, memory = _RoomService:GetSharedMemory(self.FirstMemoryName)
        if code == SharedMemoryResultCode.OK and memory ~= nil then
            local res = memory:GetVariableAndWait(uid)
            if res ~= nil and res.Code == SharedMemoryResultCode.OK and res.Info ~= nil then
                local ok, data = pcall(function() return _HttpService:JSONDecode(res.Info.Value) end)
                if ok and type(data) == "table" and type(data.join) == "number" and type(data.at) == "number" and now - data.at <= self.FirstCarrySec then
                    r = { join = data.join, f = type(data.f) == "table" and data.f or {}, field = data.field == true, lv = tonumber(data.lv) or 0 }
                end
            end
        end
        if r == nil then
            r = { join = now, f = {}, field = false, lv = 0 }
            self:Say(string.format("[VRF] first join uid=%s (new connect)", uid))
        end
        self.Firsts[uid] = r
        return r
    end

    @ExecSpace("ServerOnly")
    method void SaveFirst(string uid, boolean wait)
        -- 다음 방이 이어받게 공유 메모리에 (단계가 찍힐 때 · 1분마다 · 방을 떠날 때 — 사람당 분당 1~2번)
        local r = self.Firsts[uid]
        if r == nil then return end
        local code, memory = _RoomService:GetSharedMemory(self.FirstMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil then return end
        local ok, json = pcall(function() return _HttpService:JSONEncode({ join = r.join, f = r.f, field = r.field, lv = r.lv, at = self:UnixNow() }) end)
        if not ok then return end
        if wait then
            memory:SetVariableAndWait(uid, json)   -- 방을 떠날 때: 다음 방이 읽기 전에 써 둔다
        else
            memory:SetVariableAsync(uid, json, function(res) end)
        end
    end

    @ExecSpace("ServerOnly")
    method void First(Entity player, string stage)
        -- 그 단계를 이 접속에서 처음 지났으면 접속 뒤 초를 남긴다 (두 번째부터는 무시)
        if not self:Active() or player == nil or not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local uid = player.PlayerComponent.UserId
        local r = self:FirstRecord(uid)
        if r.f[stage] ~= nil then return end
        local t = math.max(0, self:UnixNow() - r.join)
        r.f[stage] = t
        if stage == "charSelect" then r.lv = _GameConst:LevelOf(player) end
        self:SaveFirst(uid, false)
        self:Say(string.format("[VRF] first %s t=%d", stage, t))
    end

    @ExecSpace("ServerOnly")
    method void FirstValue(Entity player, string key, integer value)
        -- 초가 아닌 값(둘러보기 닫은 쪽 번호)을 처음 한 번만
        if not self:Active() or player == nil or not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local uid = player.PlayerComponent.UserId
        local r = self:FirstRecord(uid)
        if r.f[key] ~= nil then return end
        r.f[key] = value
        self:SaveFirst(uid, false)
        self:Say(string.format("[VRF] first %s t=%d", key, value))
    end

    @ExecSpace("ServerOnly")
    method void CheckTownVisit(Entity player)
        -- 게임 방에서 사냥터에 나갔다가 처음 마을로 돌아온 때 (게임 방은 마을에서 시작하므로 그 도착은 세지 않는다)
        if not isvalid(player) or not isvalid(player.PlayerComponent) or not isvalid(player.CurrentMap) or not _GameConst:InGameRoom() then return end
        local r = self.Firsts[player.PlayerComponent.UserId]
        if r == nil or r.f.town ~= nil then return end
        if not _GameConst:IsTown(player.CurrentMap) then
            if not r.field then
                r.field = true
                self:SaveFirst(player.PlayerComponent.UserId, false)
            end
        elseif r.field then
            self:First(player, "town")
        end
    end

    @ExecSpace("ServerOnly")
    method void CopyFirsts(string uid, table saved)
        local r = self.Firsts[uid]
        if r == nil then return end
        saved.firstJoin = r.join
        saved.firstLv = r.lv
        for k, v in pairs(r.f) do saved["first." .. k] = v end
    end

    @ExecSpace("ServerOnly")
    method void FlushPre(string uid)
        -- 캐릭터를 고르기 전에 나간 접속: 세션이 없으니 first.* 만 담은 작은 기록 (월드 입장 → 불러오기 → 만들기 이탈)
        if self.Sessions[uid] ~= nil or not self:Active() then return end
        local r = self.Firsts[uid]
        if r == nil or r.f.charSelect ~= nil then return end
        local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
        if storage == nil then return end
        local saved = { uid = uid, start = r.join, pre = 1, minutes = 0 }
        self:CopyFirsts(uid, saved)
        local ok, json = pcall(function() return _HttpService:JSONEncode(saved) end)
        if not ok then return end
        storage:SetByInfoAsync(DataStorageKeyInfo(uid .. "_" .. tostring(r.join) .. "_pre", "", "tel"), json, function(code, info)
            if code ~= 0 then log_warning("[TEL] pre save failed code=" .. tostring(code)) end
        end)
        self:Say(string.format("[VRF] first pre-session saved uid=%s load=%s", uid, tostring(r.f.load)))
    end

    @ExecSpace("ServerOnly")
    method void LeaveFirst(string uid)
        -- 방을 떠난다: 다음 방이 이어받게 시각을 새로 적고 이 방 기록은 버린다
        if self.Firsts[uid] == nil then return end
        self:SaveFirst(uid, true)
        self.Firsts[uid] = nil
    end

    @ExecSpace("Server")
    method void ReportFirst(string stage, integer page)
        -- 클라이언트가 아는 단계 (프롤로그 끝 · 둘러보기 열림/닫힘/나중에 보기 · 첫 이동). 서버 시계로 찍는다
        if stage ~= "prologue" and stage ~= "guideOpen" and stage ~= "guideClose" and stage ~= "guideLater" and stage ~= "move" then return end
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not isvalid(player) then return end
        if stage == "guideClose" or stage == "guideLater" then
            self:FirstValue(player, "guideClosedPage", math.max(0, page))
            self:First(player, "guideClose")
        end
        self:First(player, stage)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 첫 이동 (게임 방에서만): 0.25초 표본 두 번 이어서 걸음만큼 움직이면 (순간이동·방 이동 도착은 한 번에 1.5칸 넘게 뛰어 세지 않는다)
        if self.MoveReported then return end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.MoveCheckAt then return end
        self.MoveCheckAt = now + 0.25
        local p = _UserService.LocalPlayer
        if not isvalid(p) or _GameConst:RoomKind() ~= "game" or _StoryCard.Active then
            self.MoveSteps = 0
            return
        end
        local pos = _Util:Pos2(p)
        local d = (pos - self.MoveLastPos):Magnitude()
        self.MoveLastPos = pos
        if d > 0.05 and d < 1.5 then self.MoveSteps = self.MoveSteps + 1 else self.MoveSteps = 0 end
        if self.MoveSteps < 2 then return end
        self.MoveReported = true
        if self:Active() then self:ReportFirst("move", 0) end
        log("[VRF] first move reported (client)")
    end

    -- ───────── GM 요약 (M0) ─────────

    method boolean IsGm(Entity player)
        -- 메이커 플레이는 누구나, 출시 서버는 GmProfileCodes에 적힌 프로필만
        if Environment:IsMakerPlay() then return true end
        if self.GmProfileCodes == "" or not isvalid(player) or not isvalid(player.PlayerComponent) then return false end
        return string.find("," .. self.GmProfileCodes .. ",", "," .. player.PlayerComponent.ProfileCode .. ",", 1, true) ~= nil
    end

    @ExecSpace("Server")
    method void RequestFirstSummary(integer limit)
        -- 채팅 「/tel [수]」: GM에게만 최근 접속의 first.* 중앙값·표본 수
        local uid = senderUserId
        local player = _UserService:GetUserEntityByUserId(uid)
        if not self:IsGm(player) then
            log("[VRF] tel gm summary denied uid=" .. uid)
            return
        end
        local now = _UtilLogic.ElapsedSeconds
        if now - self.GmAskAt < 10 then return end
        self.GmAskAt = now
        local text = self:FirstSummary(math.max(10, math.min(1000, limit)))
        self:ShowFirstSummary(text, uid)
    end

    @ExecSpace("Client")
    method void ShowFirstSummary(string text)
        -- GM 화면: 게임 안내 창의 상황 카드 한 장으로 (글 칸이 가장 크다)
        _GuideWindow:ShowCard("M0 「처음」 요약 (GM)", text)
        log("[VRF] tel gm summary shown")
    end

    method string FormatSec(number sec)
        local s = math.floor(sec + 0.5)
        if s < 60 then return tostring(s) .. "초" end
        return string.format("%d분 %02d초", s // 60, s % 60)
    end

    method number Median(table list)
        if #list == 0 then return 0 end
        table.sort(list)
        local n = #list
        if n % 2 == 1 then return list[(n + 1) // 2] end
        return (list[n // 2] + list[n // 2 + 1]) / 2
    end

    @ExecSpace("ServerOnly")
    method string FirstSummary(integer limit)
        -- 저장된 세션(방마다 나뉜 것)을 접속(uid + firstJoin)으로 묶어 최근 limit개 접속의 단계별 중앙값 · 표본 수.
        -- 「새 캐릭터」 = 고를 때 Lv1. 메이커 서버 스크립트에서 직접 불러도 된다 (로그로도 남긴다)
        local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
        if storage == nil then return "기록 저장소를 열지 못했다" end
        local code, pages = storage:GetPagesAndWait("tel")
        if code ~= 0 or pages == nil then return "기록 읽기 실패 code=" .. tostring(code) end
        local stages = self:FirstStages()
        local joins = {}
        local order = {}
        local read = 0
        while true do
            local datas = pages:GetCurrentPageDatas()
            if datas == nil then break end
            for _, item in ipairs(datas) do
                read = read + 1
                local ok, s = pcall(function() return _HttpService:JSONDecode(item.Value) end)
                if ok and type(s) == "table" and tonumber(s.firstJoin) ~= nil then
                    local id = tostring(s.uid) .. "_" .. tostring(s.firstJoin)
                    local j = joins[id]
                    if j == nil then
                        j = { start = tonumber(s.firstJoin), f = {}, lv = 0 }
                        joins[id] = j
                        table.insert(order, j)
                    end
                    if (tonumber(s.firstLv) or 0) > 0 then j.lv = tonumber(s.firstLv) end
                    for _, st in ipairs(stages) do
                        local v = tonumber(s["first." .. st[1]])
                        if v ~= nil and (j.f[st[1]] == nil or v < j.f[st[1]]) then j.f[st[1]] = v end
                    end
                    local pg = tonumber(s["first.guideClosedPage"])
                    if pg ~= nil and j.page == nil then j.page = pg end
                end
            end
            if pages.IsLastPage or read >= self.FirstReadCap then break end
            if pages:LoadNextPageAndWait() ~= 0 then break end
            pages:MoveToNextPageAndWait()
        end
        table.sort(order, function(a, b) return a.start > b.start end)
        local n = math.min(limit, #order)
        local lines = {}
        local fresh, pre = 0, 0
        for i = 1, n do
            if order[i].lv == 1 then fresh = fresh + 1 end
            if order[i].f.charSelect == nil then pre = pre + 1 end
        end
        table.insert(lines, string.format("최근 접속 %d회 (새 캐릭터 %d · 캐릭터 고르기 전 이탈 %d · 읽은 세션 %d)", n, fresh, pre, read))
        for _, st in ipairs(stages) do
            local all, new = {}, {}
            for i = 1, n do
                local v = order[i].f[st[1]]
                if v ~= nil then
                    table.insert(all, v)
                    if order[i].lv == 1 then table.insert(new, v) end
                end
            end
            if #all > 0 then
                local line = string.format("%s  %s · %d명", st[2], self:FormatSec(self:Median(all)), #all)
                if #new > 0 then line = line .. string.format("  (새 캐릭터 %s · %d명)", self:FormatSec(self:Median(new)), #new) end
                table.insert(lines, line)
            else
                table.insert(lines, st[2] .. "  표본 없음")
            end
        end
        local pagesClosed = {}
        for i = 1, n do if order[i].page ~= nil then table.insert(pagesClosed, order[i].page) end end
        if #pagesClosed > 0 then
            table.insert(lines, string.format("둘러보기 닫은 쪽  중앙 %.1f쪽 · %d명", self:Median(pagesClosed), #pagesClosed))
        else
            table.insert(lines, "둘러보기 닫은 쪽  표본 없음")
        end
        local text = table.concat(lines, "\n")
        log("[VRF] tel first summary joins=" .. tostring(n) .. " read=" .. tostring(read))
        log("[TEL] first summary\n" .. text)
        return text
    end

    @ExecSpace("ServerOnly")
    method void Dump(integer limit)
        -- 저장된 세션을 읽어 요약을 로그로 (메이커 서버 스크립트에서 부른다). 레벨당 평균 분 · 사망 원인 상위 · 시간당 처치·전리품
        local storage = _DataStorageService:GetGlobalDataStorage(self.StorageName)
        if storage == nil then return end
        local code, pages = storage:GetPagesAndWait("tel")
        if code ~= 0 or pages == nil then
            log("[TEL] dump failed code=" .. tostring(code))
            return
        end
        local n, minutes, kills = 0, 0, 0
        local perLevel = {}     -- 레벨 → { 합, 수 }
        local causes = {}
        local loot = { magic = 0, rare = 0, unique = 0, set = 0, r1 = 0, r2 = 0, r3 = 0, r4 = 0 }
        while true do
            for _, item in ipairs(pages:GetCurrentPageDatas()) do
                if n < limit then
                    local ok, s = pcall(function() return _HttpService:JSONDecode(item.Value) end)
                    if ok and type(s) == "table" then
                        n = n + 1
                        minutes = minutes + (tonumber(s.minutes) or 0)
                        kills = kills + (tonumber(s.kills) or 0)
                        local prev = 0
                        for _, l in ipairs(s.levels or {}) do
                            local b = perLevel[l.lv] or { 0, 0 }
                            b[1] = b[1] + (l.min - prev)
                            b[2] = b[2] + 1
                            perLevel[l.lv] = b
                            prev = l.min
                        end
                        for _, d in ipairs(s.deaths or {}) do causes[d.cause] = (causes[d.cause] or 0) + 1 end
                        for k, _ in pairs(loot) do loot[k] = loot[k] + (tonumber((s.loot or {})[k]) or 0) end
                    end
                end
            end
            if pages.IsLastPage or n >= limit then break end
            pages:MoveToNextPageAndWait()
        end
        local hours = math.max(0.01, minutes / 60)
        self:Say(string.format("[TEL] dump sessions=%d hours=%.1f kills/h=%.0f · 마법 %d 레어 %d 유니크 %d 세트 %d · 룬 하%d 중%d 상%d 최%d", n, hours, kills / hours, loot.magic, loot.rare, loot.unique, loot.set, loot.r1, loot.r2, loot.r3, loot.r4))
        local lvls = {}
        for lv, b in pairs(perLevel) do table.insert(lvls, lv) end
        table.sort(lvls)
        local parts = {}
        for _, lv in ipairs(lvls) do table.insert(parts, string.format("Lv%d %.1f분", lv, perLevel[lv][1] / perLevel[lv][2])) end
        log("[TEL] dump 레벨당 평균: " .. table.concat(parts, " · "))
        local list = {}
        for c, k in pairs(causes) do table.insert(list, { c = c, k = k }) end
        table.sort(list, function(a, b) return a.k > b.k end)
        local top = {}
        for i = 1, math.min(8, #list) do table.insert(top, list[i].c .. " " .. tostring(list[i].k)) end
        log("[TEL] dump 사망 원인: " .. table.concat(top, " · "))
    end


    -- ───────── 성장 관측 (D 요청 P1·P3·P4·P5·P7 · 10-30) ─────────
    -- 모두 기존 세션 표(Sessions)의 작은 합계·상한 있는 글자 목록만 늘린다. 위치·처치 기준값 같은 실행 중 상태는 GrowthState(저장 안 함)에 둔다.
    -- PlayerDealtDamage: Monster.ApplyHpDamage(실제 HP 감소 유일 지점)에서 유효 피해 > 0일 때만 · 사용자당 DealtThrottleSec에 한 번 · 전투 계측(Dps) on/off와 무관 · 저장 없음

    method any GrowthOf(string uid)
        -- 접속자별 실행 중 상태 (저장하지 않는다 · 퇴장 때 지운다)
        if self.GrowthState == nil then self.GrowthState = {} end
        local g = self.GrowthState[uid]
        if g == nil then
            g = { init = false, pos = Vector2(0, 0), kills = 0, extracts = 0, act = false, dealtAt = -100 }
            self.GrowthState[uid] = g
        end
        return g
    end

    @ExecSpace("ServerOnly")
    method void DealtDamage(Monster m, Entity attacker, string path, string src)
        -- P5 본인 귀속 실제 전투 이벤트 PlayerDealtDamage: player(가해 주인 · 소환수면 주인) · sourceId · map · skill(확인된 skill.* 만, 모르면 빈 글자) · direct(본인 직접 타격) · path(hit·tick)
        -- 부르는 쪽(Monster)이 이미 「유효 피해 > 0 · 공격자 유효」를 확인했다. 활동 표본(P7) 표시는 매번, 이벤트는 사용자당 DealtThrottleSec에 한 번
        local owner = _Util:OwnerPlayerOf(attacker)
        if owner == nil or not isvalid(owner) or not isvalid(owner.PlayerComponent) then return end
        local g = self:GrowthOf(owner.PlayerComponent.UserId)
        g.act = true
        local now = _UtilLogic.ElapsedSeconds
        if now - g.dealtAt < self.DealtThrottleSec then return end
        g.dealtAt = now
        local skill = ""
        if string.find(src, "skill.", 1, true) == 1 then skill = src end
        local mapName = ""
        if isvalid(m.Entity) and isvalid(m.Entity.CurrentMap) then mapName = _GameConst:BaseMapName(m.Entity.CurrentMap.Name) end
        _GameEvents:Emit("PlayerDealtDamage", { player = owner, sourceId = m.SourceId, map = mapName, skill = skill, direct = owner == attacker, path = path })
    end

    @ExecSpace("ServerOnly")
    method void ArmDealt(Entity player)
        -- 다음 유효 피해를 간격 제한 없이 바로 PlayerDealtDamage로 알리게 (장착 직후 등 — 받는 쪽이 부른다)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        self:GrowthOf(player.PlayerComponent.UserId).dealtAt = -100
    end

    @ExecSpace("ServerOnly")
    method void NoteActivity(Entity player)
        -- P7 성공한 상호작용(대화 단추 등)을 이번 5초 구간의 활동으로 (호출 지점은 패치 요청)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        self:GrowthOf(player.PlayerComponent.UserId).act = true
    end

    @ExecSpace("ServerOnly")
    method void NoteRespec(Entity player, string what, integer level, integer cost, integer goldLeft, integer refund)
        -- P4 초기화 성공 (SkillBook.RequestRespec 끝 — 호출 한 줄은 B 패치 요청): 횟수·쓴 골드 합 + 처음 10건 「what|레벨|비용|잔액|돌려받은 포인트|분」
        local s = self:Session(player)
        if s == nil then return end
        s.respecs = (s.respecs or 0) + 1
        s.respecGold = (s.respecGold or 0) + math.max(0, cost)
        if s.respecList == nil then s.respecList = {} end
        if #s.respecList < 10 then table.insert(s.respecList, string.format("%s|%d|%d|%d|%d|%.1f", what, level, cost, goldLeft, refund, self:Minutes(s))) end
        self:Say(string.format("[TEL] respec uid=%s what=%s lv=%d cost=%d gold=%d", s.uid, what, level, cost, goldLeft))
    end

    @ExecSpace("ServerOnly")
    method void GrowthTick(Entity player, any s)
        -- 5초마다 (Tick): P7 실활동 구간 수 · P3 액트 2 첫 10분 표본
        local uid = player.PlayerComponent.UserId
        local g = self:GrowthOf(uid)
        local pos = _Util:Pos2(player)
        if not g.init then
            -- 첫 표본은 기준만 잡는다 (불러오기·방 이동 직후의 순간이동을 움직임으로 세지 않게)
            g.init = true
            g.pos = pos
            g.kills = s.kills
            g.extracts = s.extracts
            g.act = false
            return
        end
        local moved = (pos - g.pos):Magnitude() > 0.5
        g.pos = pos
        local kills = s.kills - g.kills   -- P3 파티 크레딧 포함 처치 수는 보존; P7 본인 활동 근거로 쓰지 않는다
        g.kills = s.kills
        local extracts = s.extracts - g.extracts
        g.extracts = s.extracts
        s.ticks = (s.ticks or 0) + 1
        -- 실제 본인/소환수 유효 피해는 DealtDamage가 g.act로 표시한다 (막타/파티 크레딧 중복 활동 없음).
        if moved or extracts > 0 or g.act then s.activeTicks = (s.activeTicks or 0) + 1 end
        g.act = false
        self:A2Tick(player, s, moved, kills)
    end

    @ExecSpace("ServerOnly")
    method void A2Tick(Entity player, any s, boolean moved, integer kills)
        -- P3: 첫 액트 2 맵 입장(First act2Enter — 접속 기준 초, 방을 옮겨도 이어진다) 뒤 A2Sec(600초) 동안 5초 표본
        --   「초|맵|움직임|구간 처치|의뢰 번호|의뢰 상태」 최대 A2Cap(120)개를 세션 a2.list에 · 넘치면 합계만 (over·overKills·overMoved)
        if not isvalid(player.CurrentMap) or not self:Active() then return end
        local uid = player.PlayerComponent.UserId
        local r = self:FirstRecord(uid)
        local base = _GameConst:BaseMapName(player.CurrentMap.Name)
        if r.f.act2Enter == nil then
            local info = _GameData:GetMapInfo(base)
            if info == nil or info.act ~= 2 then return end
            self:First(player, "act2Enter")
            if r.f.act2Enter == nil then return end
        end
        local t = (self:UnixNow() - r.join) - r.f.act2Enter
        if t < 0 or t > self.A2Sec then return end
        if s.a2 == nil then s.a2 = { at = self:Minutes(s), list = {}, over = 0, overKills = 0, overMoved = 0 } end
        local a2 = s.a2
        if #a2.list >= self.A2Cap then
            a2.over = a2.over + 1
            a2.overKills = a2.overKills + kills
            if moved then a2.overMoved = a2.overMoved + 1 end
            return
        end
        local qi = 0
        local qs = 0
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest ~= nil then
            qi = quest.Index
            qs = quest.State
        end
        local mv = 0
        if moved then mv = 1 end
        table.insert(a2.list, string.format("%d|%s|%d|%d|%d|%d", t, base, mv, kills, qi, qs))
    end

    -- ───────── 개발용 전투 계측 (I05 · 기본 꺼짐) ─────────
    -- 몬스터 HP 원장: Monster.ApplyHpDamage(피해 두 경로의 유일한 HP 감소) → DpsHit, 생명·회복·리셋·인원 보정·사망 → DpsNote.
    -- Sessions 밖의 Dps 표에만 쌓는다 → 5분·퇴장 Flush(DataStorage)에 섞이지 않는다. 저장·외부 전송 없음, 결과는 DpsFlush의 「[DPS]」 로그뿐.
    -- 상한: 원장 링 DpsRawCap(넘치면 오래된 것부터 덮고 dropped) · 생명 DpsLifeCap · owner DpsOwnerCap · owner별 출처 DpsSourceCap · 실행 길이 DpsMaxSec · 로그 줄 DpsFlushLineCap.
    -- 실행은 한 번에 하나: DpsStart(장면) → (전투) → DpsFlush(원장 줄 수) → DpsStop(메모리 비움). 꺼져 있으면 버퍼·타이머·구독이 없다.
    -- 출처는 확인되는 것만: 플레이어 직접 타격은 공격 쪽 꼬리표(Monster.DpsTag)가 정확히 맞을 때만 스킬 이름, 아니면 player.unknown · 틱 경로는 tick.unknown.

    method table DpsFresh(string scene)
        -- 새 실행 상태 (모든 표는 상한 안에서만 자란다)
        return { run = self.DpsRunId, scene = scene, t0 = _UtilLogic.ElapsedSeconds, stopped = false, stopReason = "", stoppedAt = 0,
            ring = {}, n = 0, dropped = 0, lives = {}, lifeCount = 0, lifeSeq = 0, lifeOverflow = 0,
            owners = {}, ownerCount = 0, ownerOverflow = 0, srcKeys = {},
            eff = 0, raw = 0, absorb = 0, over = 0, hitEvents = 0, active = 0, segs = 0, firstHit = -1, lastHit = -1,
            heal = 0, drift = 0, scale = 0, rebase = 0, reset = 0, tagHit = 0, tagMiss = 0, filtered = 0, filter = self.DpsFilter,
            sampleN = 0, sampleLate = 0, sampleMaxGap = 0, sampleAt = -1 }
    end

    @ExecSpace("ServerOnly")
    method void DpsStart(string scene)
        -- 개발용 계측 켜기 (메이커 서버 스크립트 또는 GM RequestDps). 이전 실행은 버린다 — 먼저 DpsFlush
        if self.DpsOn then self:DpsStop() end
        self.DpsRunId = self.DpsRunId + 1
        self.Dps = self:DpsFresh(string.sub(scene, 1, 40))
        self.DpsOn = true
        _GameEvents:Subscribe("PlayerDied", "TelemetryDps", function(e) self:DpsOnEvent("death", e) end)
        _GameEvents:Subscribe("UndeadRaised", "TelemetryDps", function(e) self:DpsOnEvent("raise", e) end)
        _GameEvents:Subscribe("ShadowExtracted", "TelemetryDps", function(e) self:DpsOnEvent("extract", e) end)
        _GameEvents:Subscribe("SkillCast", "TelemetryDps", function(e) self:DpsOnEvent("cast", e) end)
        _GameEvents:Subscribe("SummonLost", "TelemetryDps", function(e) self:DpsOnEvent("loss", e) end)
        _GameEvents:Subscribe("SoulLost", "TelemetryDps", function(e) self:DpsOnEvent("soul", e) end)
        if self.DpsSampleTimer ~= 0 then _TimerService:ClearTimer(self.DpsSampleTimer) end
        self.DpsSampleTimer = _TimerService:SetTimerRepeat(function() self:DpsSample() end, self.DpsSampleSec)
        log(string.format("[DPS] start run=%d scene=%s cap=%d lifeCap=%d gap=%.2f sample=%.2f maxSec=%d", self.DpsRunId, self.Dps.scene, self.DpsRawCap, self.DpsLifeCap, self.DpsGapSec, self.DpsSampleSec, math.floor(self.DpsMaxSec)))
    end

    @ExecSpace("ServerOnly")
    method void DpsCollectionStop(string reason)
        -- 관측만 끄는 DpsStop과 구분. 먼저 소유권을 내려 같은 종료가 재진입해도 한 번만 정리한다.
        local collection = self.DpsCollection
        if collection == nil then return end
        self.DpsCollection = nil
        if collection.stop ~= nil then collection.stop(reason) end
    end

    @ExecSpace("ServerOnly")
    method void DpsStop()
        -- 계측 끄기: 타이머·구독을 풀고 버퍼를 비운다 (요약은 그 전에 DpsFlush)
        if self.DpsSampleTimer ~= 0 then _TimerService:ClearTimer(self.DpsSampleTimer) end
        self.DpsSampleTimer = 0
        self:DpsUnsubscribe()
        local d = self.Dps
        if self.DpsOn and d ~= nil then log(string.format("[DPS] stop run=%d events=%d dropped=%d", self.DpsRunId, d.n, d.dropped)) end
        self.DpsOn = false
        self.Dps = nil
        self.DpsFilter = ""
    end

    @ExecSpace("ServerOnly")
    method void DpsUnsubscribe()
        -- 계측이 듣는 게임 이벤트 구독을 모두 푼다
        for _, name in ipairs({ "PlayerDied", "UndeadRaised", "ShadowExtracted", "SkillCast", "SummonLost", "SoulLost" }) do _GameEvents:Unsubscribe(name, "TelemetryDps") end
    end

    @ExecSpace("ServerOnly")
    method void DpsTaken(Entity defender, number amount)
        -- 몬스터 공격이 확정한 피해 (MonsterAttack.CalcDamage 끝 — 패치 요청). 플레이어면 그 owner의 피격, 소환수면 주인의 소환수 피격. 꺼져 있으면 부르는 쪽이 DpsOn으로 막는다
        if not self.DpsOn or not self:DpsLive() or not isvalid(defender) then return end
        local owner = _Util:OwnerPlayerOf(defender)
        if owner == nil or not isvalid(owner) or not isvalid(owner.PlayerComponent) then return end
        local o = self:DpsOwner(owner.PlayerComponent.UserId)
        if o == nil then return end
        o.takenSeen = true
        if owner == defender then
            o.takenHits = o.takenHits + 1
            o.taken = o.taken + amount
        else
            o.summonTakenHits = o.summonTakenHits + 1
            o.summonTaken = o.summonTaken + amount
        end
    end

    @ExecSpace("ServerOnly")
    method void DpsFinish(integer maxEvents)
        -- 요약을 내보내고 끈다 (장면 하나의 끝)
        if not self.DpsOn then return end
        self:DpsFlush(maxEvents)
        self:DpsStop()
    end

    @ExecSpace("ServerOnly")
    method void DpsHalt(string reason, number at)
        -- 상한(실행 길이)에 닿았다: 기록을 멈추고 수집 타이머·구독도 푼다. 모은 것은 DpsFlush까지 두고, 종료 시각은 at 하나로 고정
        local d = self.Dps
        if d.stopped then return end
        d.stopped = true
        d.stopReason = reason
        d.stoppedAt = at
        if self.DpsSampleTimer ~= 0 then _TimerService:ClearTimer(self.DpsSampleTimer) end
        self.DpsSampleTimer = 0
        self:DpsUnsubscribe()
        log(string.format("[DPS] halt run=%d reason=%s at=%.2f", d.run, reason, at - d.t0))
    end

    @ExecSpace("ServerOnly")
    method boolean DpsWants(Monster m)
        -- 시험 대상 거르기 (DpsFilter가 비어 있으면 모두). 이름 비교는 새 문자열을 만들지 않는다
        local d = self.Dps
        if d.filter == "" then return true end
        if isvalid(m.Entity) and string.find(m.Entity.Name, d.filter, 1, true) == 1 then return true end
        d.filtered = d.filtered + 1
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean DpsLive()
        -- 모든 기록 진입점(피해·HP 사건·게임 이벤트·표본)이 먼저 부르는 시간 상한 검사 (C-IF-01). 넘었으면 t0 + DpsMaxSec에 멈춘다
        local d = self.Dps
        if d.stopped then return false end
        if _UtilLogic.ElapsedSeconds - d.t0 > self.DpsMaxSec then
            self:DpsHalt("maxSec", d.t0 + self.DpsMaxSec)
            return false
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method any DpsOwner(string uid)
        -- owner 집계 (상한 DpsOwnerCap — 넘치면 nil, 피해는 실행 합계에만 들어간다)
        local d = self.Dps
        local o = d.owners[uid]
        if o ~= nil then return o end
        if d.ownerCount >= self.DpsOwnerCap then
            d.ownerOverflow = d.ownerOverflow + 1
            return nil
        end
        o = { uid = uid, eff = 0, raw = 0, absorb = 0, over = 0, hits = 0, active = 0, segs = 0, first = -1, last = -1,
            src = {}, srcCount = 0, deaths = 0, raised = 0, raisedMage = 0, extracts = 0, casts = 0, manaSpent = 0, castSeen = false,
            manaLast = -1, manaDrop = 0, manaRise = 0, hpLast = -1, hpDrop = 0, hpRise = 0,
            legNow = -1, legMax = 0, legLoss = 0, wipes = 0, wipeAt = -1, wipeFrom = 0, recover = {},
            takenSeen = false, takenHits = 0, taken = 0, summonTakenHits = 0, summonTaken = 0,
            lossSeen = false, loss = {}, lossKeys = 0, soulOtherSeen = false, soulOther = 0 }
        d.owners[uid] = o
        d.ownerCount = d.ownerCount + 1
        return o
    end

    method string DpsSummonKey(string kind)
        -- 소환 출처 키 (문자열은 종류마다 한 번만 만든다)
        local d = self.Dps
        local key = d.srcKeys[kind]
        if key == nil then
            key = "summon." .. kind
            d.srcKeys[kind] = key
        end
        return key
    end

    @ExecSpace("ServerOnly")
    method string DpsTakeTag(Monster m, Entity attacker, integer total)
        -- 공격 쪽 꼬리표에서 같은 공격자·같은 피해의 것을 꺼낸다. 맞는 것이 이름이 서로 다른 둘 이상이면 미상("")
        -- 만료(0.5초 넘은) 꼬리표는 소비할 때도 버린다. 이름이 서로 다른 후보가 겹치면 그 묶음을 전부 버리고 미상 — 남은 하나가 다음 타격에 거짓으로 확정되지 않게 (C-IF-02)
        local tags = m.DpsTags
        if tags == nil or #tags == 0 then return "" end
        local now = _UtilLogic.ElapsedSeconds
        local keep = {}
        local found = 0
        local info = ""
        local ambiguous = false
        for _, t in ipairs(tags) do
            if now - t.at <= 0.5 then
                if t.by == attacker and t.dmg == total then
                    if found == 0 then
                        found = #keep + 1
                        info = t.info
                    elseif t.info ~= info then
                        ambiguous = true
                    end
                end
                table.insert(keep, t)
            end
        end
        if found == 0 then
            m.DpsTags = keep
            return ""
        end
        if ambiguous then
            local rest = {}
            for _, t in ipairs(keep) do
                if not (t.by == attacker and t.dmg == total) then table.insert(rest, t) end
            end
            m.DpsTags = rest
            return ""
        end
        table.remove(keep, found)
        m.DpsTags = keep
        return info
    end

    @ExecSpace("ServerOnly")
    method any DpsLifeOf(Monster m, number before)
        -- 이 몬스터의 지금 생명 기록. 실행 밖이면 받아들이고(adopt · 첫 등장 시각 모름), 원장 밖에서 HP가 바뀌었으면 drift로 먼저 남긴다
        local d = self.Dps
        if m.DpsRun ~= d.run or m.DpsLife == 0 then
            self:DpsNewLife(m, -1)
            m.DpsLastHp = before
            local adopted = d.lives[m.DpsLife]
            if adopted ~= nil then adopted.startHp = before end
            self:DpsRecord(m, "adopt", "-", "none", "adopt", before, before, 0, 0)
            return adopted
        end
        local life = d.lives[m.DpsLife]
        if life ~= nil and life.death >= 0 and not m.IsDead then
            -- Respawn을 거치지 않고 다시 살아났다 (풀 재사용 등): 죽은 생명에 잇지 않고 새 생명으로 받는다
            self:DpsNewLife(m, -1)
            m.DpsLastHp = before
            local revived = d.lives[m.DpsLife]
            if revived ~= nil then revived.startHp = before end
            self:DpsRecord(m, "adopt", "-", "none", "adopt", before, before, 0, 0)
            return revived
        end
        local gap = before - m.DpsLastHp
        if gap > 0.001 or gap < -0.001 then
            local kind = "drift"
            if life ~= nil and life.dmgEvents == 0 then kind = "drift_setup" end   -- 첫 피해 전 HP 재설정 (생성 직후 MaxHp 배율 등)
            if life ~= nil then
                if kind == "drift" then life.drift = life.drift + gap else
                    life.setup = life.setup + gap
                    life.startHp = before
                    life.maxHp = m.MaxHp
                end
            end
            if kind == "drift" then d.drift = d.drift + gap end
            self:DpsRecord(m, kind, "-", "none", kind, m.DpsLastHp, before, 0, 0)
        end
        return life
    end

    @ExecSpace("ServerOnly")
    method void DpsNewLife(Monster m, number born)
        -- 새 생명 번호 (상한을 넘으면 번호만 주고 생명 표에는 넣지 않는다 — 원장·합계는 그대로)
        local d = self.Dps
        d.lifeSeq = d.lifeSeq + 1
        m.DpsRun = d.run
        m.DpsLife = d.lifeSeq
        m.DpsSeq = 0
        m.DpsAttempt = 1
        m.DpsLastHp = m.Hp
        m.DpsTags = nil
        if d.lifeCount >= self.DpsLifeCap then
            d.lifeOverflow = d.lifeOverflow + 1
            return
        end
        d.lifeCount = d.lifeCount + 1
        local mapName = "?"
        if isvalid(m.Entity) and isvalid(m.Entity.CurrentMap) then mapName = m.Entity.CurrentMap.Name end
        local entName = "?"
        if isvalid(m.Entity) then entName = m.Entity.Name end
        d.lives[d.lifeSeq] = { id = d.lifeSeq, name = entName, src = m.SourceId, grade = m.Grade, level = m.Level, map = mapName,
            born = born, maxHp = m.MaxHp, startHp = m.Hp, firstHit = -1, lastHit = -1, death = -1, deathAttempt = 0,
            eff = 0, absorb = 0, over = 0, dmgEvents = 0, heal = 0, drift = 0, setup = 0, scale = 0, rebase = 0, resets = 0, killCredit = "", lastOwner = "-" }
    end

    @ExecSpace("ServerOnly")
    method void DpsRecord(Monster m, string kind, string owner, string akind, string src, number before, number after, number raw, number absorbed)
        -- 원장 한 줄: 링 버퍼 칸을 재사용한다 (새 문자열은 만들지 않는다 — 이미 있는 키만 담는다)
        local d = self.Dps
        d.n = d.n + 1
        m.DpsSeq = m.DpsSeq + 1
        local slot = (d.n - 1) % self.DpsRawCap + 1
        if d.n > self.DpsRawCap then d.dropped = d.dropped + 1 end
        local e = d.ring[slot]
        if e == nil then
            e = {}
            d.ring[slot] = e
        end
        local eff = 0
        local over = 0
        if kind == "hit" or kind == "tick" then
            eff = math.min(math.max(0, before), math.max(0, before - after))
            over = math.max(0, before - after) - eff
        end
        e.n = d.n
        e.t = _UtilLogic.ElapsedSeconds - d.t0
        e.kind = kind
        e.life = m.DpsLife
        e.seq = m.DpsSeq
        e.att = m.DpsAttempt
        e.owner = owner
        e.ak = akind
        e.src = src
        e.b = before
        e.a = after
        e.raw = raw
        e.ab = absorbed
        e.eff = eff
        e.ov = over
        m.DpsLastHp = after
    end

    @ExecSpace("ServerOnly")
    method string DpsHit(Monster m, Entity attacker, string path, number before, number after, number raw, number absorbed)
        -- Monster.ApplyHpDamage에서 HP 감소 한 번마다 한 번. owner = 실제 공격 엔티티의 주인(파티 보상 수령자가 아니다), 모르면 none. 반환 = 원장 출처 키 (PlayerDealtDamage skill용)
        if not self:DpsLive() or not self:DpsWants(m) then return "" end
        local d = self.Dps
        local now = _UtilLogic.ElapsedSeconds
        local life = self:DpsLifeOf(m, before)
        local owner = "none"
        local akind = "none"
        local kind = path
        local src = "tick.unknown"
        if path == "hit" then src = "hit.none"
        elseif path ~= "tick" then
            kind = "tick"
            src = path   -- 호출 쪽이 밝힌 틱 출처 (TakeDamageAs의 고정 글자)
        end
        if isvalid(attacker) then
            if isvalid(attacker.PlayerComponent) then
                owner = attacker.PlayerComponent.UserId
                akind = "player"
                if path == "hit" then
                    src = self:DpsTakeTag(m, attacker, math.floor(raw + 0.5))
                    if src == "" then
                        src = "player.unknown"
                        d.tagMiss = d.tagMiss + 1
                    else
                        d.tagHit = d.tagHit + 1
                    end
                end
            else
                ---@type ShadowUnit
                local unit = attacker:GetComponent("script.ShadowUnit")
                if unit ~= nil then
                    akind = "summon"
                    if isvalid(unit.OwnerPlayer) and isvalid(unit.OwnerPlayer.PlayerComponent) then owner = unit.OwnerPlayer.PlayerComponent.UserId end
                    if path == "hit" then src = self:DpsSummonKey(unit.Kind) end
                elseif attacker:GetComponent("script.Monster") ~= nil then
                    akind = "monster"
                    if path == "hit" then src = "monster" end
                end
            end
        end
        self:DpsRecord(m, kind, owner, akind, src, before, after, raw, absorbed)
        local eff = math.min(math.max(0, before), math.max(0, before - after))
        local over = math.max(0, before - after) - eff
        d.hitEvents = d.hitEvents + 1
        d.eff = d.eff + eff
        d.raw = d.raw + raw
        d.absorb = d.absorb + absorbed
        d.over = d.over + over
        if eff > 0 then
            if d.lastHit >= 0 and now - d.lastHit <= self.DpsGapSec then d.active = d.active + (now - d.lastHit) else d.segs = d.segs + 1 end
            if d.firstHit < 0 then d.firstHit = now end
            d.lastHit = now
        end
        if life ~= nil then
            life.dmgEvents = life.dmgEvents + 1
            life.eff = life.eff + eff
            life.absorb = life.absorb + absorbed
            life.over = life.over + over
            if eff > 0 then
                if life.firstHit < 0 then life.firstHit = now end
                life.lastHit = now
                life.lastOwner = owner
            end
        end
        local o = self:DpsOwner(owner)
        if o == nil then return src end
        o.hits = o.hits + 1
        o.eff = o.eff + eff
        o.raw = o.raw + raw
        o.absorb = o.absorb + absorbed
        o.over = o.over + over
        if eff > 0 then
            if o.last >= 0 and now - o.last <= self.DpsGapSec then o.active = o.active + (now - o.last) else o.segs = o.segs + 1 end
            if o.first < 0 then o.first = now end
            o.last = now
        end
        local key = src
        if o.src[key] == nil and o.srcCount >= self.DpsSourceCap then key = "overflow" end
        local s = o.src[key]
        if s == nil then
            s = { hits = 0, raw = 0, absorb = 0, eff = 0, over = 0, first = now, last = now }
            o.src[key] = s
            o.srcCount = o.srcCount + 1
        end
        s.hits = s.hits + 1
        s.raw = s.raw + raw
        s.absorb = s.absorb + absorbed
        s.eff = s.eff + eff
        s.over = s.over + over
        s.last = now
        return src
    end

    @ExecSpace("ServerOnly")
    method void DpsNote(Monster m, string kind, number before)
        -- 피해가 아닌 HP 사건: spawn·respawn(새 생명) · rebase(레벨 적용 재설정) · scale(인원 보정) · reset(빈 맵 — 새 시도) · heal:<이유> · death
        if not self:DpsLive() or not self:DpsWants(m) then return end
        local d = self.Dps
        local now = _UtilLogic.ElapsedSeconds
        if kind == "spawn" or kind == "respawn" then
            self:DpsNewLife(m, now)
            self:DpsRecord(m, kind, "-", "none", kind, -1, m.Hp, 0, 0)
            return
        end
        local life = self:DpsLifeOf(m, before)
        if kind == "death" then
            if life ~= nil then
                life.death = now
                life.deathAttempt = m.DpsAttempt
                life.maxHp = m.MaxHp
                -- kill_credit_owner = 기존 보상 귀속(LastAttacker 기반, 정책 그대로) · terminal_damage_owner = 마지막 유효 HP 원장의 owner (뜻이 다르다)
                local killer = _Util:OwnerPlayerOf(m.LastAttacker)
                if killer ~= nil and isvalid(killer) and isvalid(killer.PlayerComponent) then life.killCredit = killer.PlayerComponent.UserId end
            end
            self:DpsRecord(m, kind, "-", "none", kind, before, m.Hp, 0, 0)
            return
        end
        local delta = m.Hp - before
        if kind == "reset" then
            m.DpsAttempt = m.DpsAttempt + 1
            d.reset = d.reset + 1
            if life ~= nil then
                life.resets = life.resets + 1
                life.firstHit = -1
            end
        elseif kind == "scale" then
            d.scale = d.scale + delta
            if life ~= nil then
                life.scale = life.scale + delta
                life.maxHp = m.MaxHp
            end
        elseif kind == "rebase" then
            d.rebase = d.rebase + delta
            if life ~= nil then
                life.rebase = life.rebase + delta
                life.maxHp = m.MaxHp
                if life.dmgEvents == 0 then life.startHp = m.Hp end
            end
        else
            d.heal = d.heal + delta
            if life ~= nil then life.heal = life.heal + delta end
        end
        self:DpsRecord(m, kind, "-", "none", kind, before, m.Hp, 0, 0)
    end

    @ExecSpace("ServerOnly")
    method void DpsOnEvent(string kind, table e)
        -- 기존 게임 이벤트: 사망 · 해골 일으킴(혼 1) · 추출(혼 1) · SkillCast(성공 시전의 실제 마나 — B 패치 전에는 오지 않아 mana_spent=unsupported)
        if not self.DpsOn or not self:DpsLive() then return end
        local p = e.player
        if p == nil or not isvalid(p) or not isvalid(p.PlayerComponent) then return end
        local o = self:DpsOwner(p.PlayerComponent.UserId)
        if o == nil then return end
        if kind == "death" then o.deaths = o.deaths + 1
        elseif kind == "raise" then
            o.raised = o.raised + 1
            if e.kind == "mage" then o.raisedMage = o.raisedMage + 1 end
        elseif kind == "extract" then o.extracts = o.extracts + 1
        elseif kind == "cast" then
            o.casts = o.casts + 1
            o.castSeen = true
            o.manaSpent = o.manaSpent + (tonumber(e.mana) or 0)
        elseif kind == "loss" then
            -- 소환수 손실 이유 (died·trimmed·expired·dismissed·bomb·travel …) — 키는 8개까지, 넘치면 other
            o.lossSeen = true
            local reason = tostring(e.reason or "?")
            if o.loss[reason] == nil then
                if o.lossKeys >= 8 then reason = "other" else o.lossKeys = o.lossKeys + 1 end
            end
            o.loss[reason] = (o.loss[reason] or 0) + 1
        elseif kind == "soul" then
            o.soulOtherSeen = true
            o.soulOther = o.soulOther + 1
        end
    end

    @ExecSpace("ServerOnly")
    method void DpsSample()
        -- 0.25초 표본: 마나·생명 오르내림(표본 사이 상쇄는 못 본다) · 살아 있는 소환수 수(전멸·복구) · 표본 간격(서버 지연 대용)
        if not self.DpsOn or not self:DpsLive() then return end
        local d = self.Dps
        local now = _UtilLogic.ElapsedSeconds
        if d.sampleAt >= 0 then
            local gap = now - d.sampleAt
            d.sampleN = d.sampleN + 1
            if gap > self.DpsSampleSec * 1.4 then d.sampleLate = d.sampleLate + 1 end
            if gap > d.sampleMaxGap then d.sampleMaxGap = gap end
        end
        d.sampleAt = now
        for _, player in pairs(_UserService.UserEntities) do
            if isvalid(player) and isvalid(player.PlayerComponent) then
                local o = self:DpsOwner(player.PlayerComponent.UserId)
                if o ~= nil then self:DpsSampleOwner(o, player, now) end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void DpsSampleOwner(table o, Entity player, number now)
        -- 한 플레이어 표본
        ---@type PlayerStats
        local st = player:GetComponent("script.PlayerStats")
        if st ~= nil then
            if o.manaLast >= 0 then
                local dm = st.Mana - o.manaLast
                if dm < 0 then o.manaDrop = o.manaDrop - dm else o.manaRise = o.manaRise + dm end
            end
            o.manaLast = st.Mana
        end
        local hp = player.PlayerComponent.Hp
        if o.hpLast >= 0 then
            local dh = hp - o.hpLast
            if dh < 0 then o.hpDrop = o.hpDrop - dh else o.hpRise = o.hpRise + dh end
        end
        o.hpLast = hp
        local count = 0
        if isvalid(player.CurrentMap) then
            for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
                ---@type ShadowUnit
                local u = c
                if u.OwnerPlayer == player and not u.Dead and u.Hp > 0 then count = count + 1 end
            end
        end
        if o.legNow >= 0 and count < o.legNow then o.legLoss = o.legLoss + (o.legNow - count) end
        if count == 0 and o.legNow > 0 and o.wipeAt < 0 then
            o.wipes = o.wipes + 1
            o.wipeAt = now
            o.wipeFrom = o.legNow
        elseif o.wipeAt >= 0 and count >= o.wipeFrom then
            if #o.recover < 20 then table.insert(o.recover, now - o.wipeAt) end
            o.wipeAt = -1
        end
        o.legNow = count
        if count > o.legMax then o.legMax = count end
    end

    method string DpsNum(number v)
        -- 로그용 숫자 (소수 둘째 자리)
        return string.format("%.2f", v)
    end

    method string DpsRel(number t)
        -- 실행 시작 기준 초 (없으면 -1)
        if t < 0 then return "-1" end
        return string.format("%.2f", t - self.Dps.t0)
    end

    @ExecSpace("ServerOnly")
    method integer DpsFlush(integer maxEvents)
        -- 지금 실행의 요약을 「[DPS]」 로그로 (저장하지 않는다). maxEvents > 0이면 원장 최근 그만큼도 「[DPS] ev|」 줄로. 반환 = 찍은 줄 수
        if not self.DpsOn then
            log("[DPS] flush skipped (off)")
            return 0
        end
        local d = self.Dps
        local tEnd = _UtilLogic.ElapsedSeconds
        if d.stopped then tEnd = d.stoppedAt end
        local list = {}
        local kept = math.min(d.n, self.DpsRawCap)
        local halted = "no"
        if d.stopped then halted = d.stopReason end
        table.insert(list, string.format("[DPS] window run=%d scene=%s dur=%s events=%d kept=%d dropped=%d hit_events=%d eff=%s raw=%s absorb=%s over=%s first=%s last=%s active=%s segs=%d gap=%.2f heal=%s drift=%s scale=%s rebase=%s resets=%d tag_hit=%d tag_miss=%d lives=%d life_overflow=%d owner_overflow=%d filter=%s filtered=%d halted=%s",
            d.run, d.scene, self:DpsNum(tEnd - d.t0), d.n, kept, d.dropped, d.hitEvents, self:DpsNum(d.eff), self:DpsNum(d.raw), self:DpsNum(d.absorb), self:DpsNum(d.over),
            self:DpsRel(d.firstHit), self:DpsRel(d.lastHit), self:DpsNum(d.active), d.segs, self.DpsGapSec, self:DpsNum(d.heal), self:DpsNum(d.drift), self:DpsNum(d.scale), self:DpsNum(d.rebase), d.reset,
            d.tagHit, d.tagMiss, d.lifeSeq, d.lifeOverflow, d.ownerOverflow, d.filter ~= "" and d.filter or "-", d.filtered, halted))
        for uid, o in pairs(d.owners) do
            local rec = {}
            for _, r in ipairs(o.recover) do table.insert(rec, self:DpsNum(r)) end
            local manaSpent = "unsupported"
            local casts = "unsupported"
            if o.castSeen then
                manaSpent = self:DpsNum(o.manaSpent)
                casts = tostring(o.casts)
            end
            local takenHits, taken, summonTakenHits, summonTaken = "unsupported", "unsupported", "unsupported", "unsupported"
            if o.takenSeen then
                takenHits = tostring(o.takenHits)
                taken = self:DpsNum(o.taken)
                summonTakenHits = tostring(o.summonTakenHits)
                summonTaken = self:DpsNum(o.summonTaken)
            end
            local soulOther = "unsupported"
            if o.soulOtherSeen then soulOther = tostring(o.soulOther) end
            local lossText = "unsupported"
            if o.lossSeen then
                local parts = {}
                for reason, count in pairs(o.loss) do table.insert(parts, reason .. ":" .. tostring(count)) end
                table.sort(parts)
                lossText = table.concat(parts, ",")
            end
            local recText = "-"
            if #rec > 0 then recText = table.concat(rec, ",") end
            local wipeOpen = "no"
            if o.wipeAt >= 0 then wipeOpen = self:DpsRel(o.wipeAt) end
            table.insert(list, string.format("[DPS] owner run=%d owner=%s hits=%d eff=%s raw=%s absorb=%s over=%s first=%s last=%s active=%s segs=%d deaths=%d hp_drop_sampled=%s hp_rise_sampled=%s hits_taken=%s taken=%s summon_hits_taken=%s summon_taken=%s mana_spent=%s casts=%s mana_drop_sampled=%s mana_rise_sampled=%s soul_raise=%d soul_raise_mage=%d soul_extract=%d soul_other=%s legion_now=%d legion_max=%d legion_loss=%d legion_loss_reason=%s wipes=%d recover=%s wipe_open=%s",
                d.run, uid, o.hits, self:DpsNum(o.eff), self:DpsNum(o.raw), self:DpsNum(o.absorb), self:DpsNum(o.over), self:DpsRel(o.first), self:DpsRel(o.last), self:DpsNum(o.active), o.segs, o.deaths,
                self:DpsNum(o.hpDrop), self:DpsNum(o.hpRise), takenHits, taken, summonTakenHits, summonTaken, manaSpent, casts, self:DpsNum(o.manaDrop), self:DpsNum(o.manaRise),
                o.raised, o.raisedMage, o.extracts, soulOther, math.max(0, o.legNow), o.legMax, o.legLoss, lossText, o.wipes, recText, wipeOpen))
            for key, s in pairs(o.src) do
                table.insert(list, string.format("[DPS] src run=%d owner=%s src=%s hits=%d eff=%s raw=%s absorb=%s over=%s first=%s last=%s",
                    d.run, uid, key, s.hits, self:DpsNum(s.eff), self:DpsNum(s.raw), self:DpsNum(s.absorb), self:DpsNum(s.over), self:DpsRel(s.first), self:DpsRel(s.last)))
            end
        end
        for id = 1, d.lifeSeq do
            local l = d.lives[id]
            if l ~= nil and (l.dmgEvents > 0 or l.death >= 0) then
                local ttk = "censored"
                if l.death >= 0 and l.firstHit >= 0 then ttk = self:DpsNum(l.death - l.firstHit) end
                local ttkSpawn = "censored"
                if l.death >= 0 and l.born >= 0 and l.resets == 0 then ttkSpawn = self:DpsNum(l.death - l.born) end
                local killCredit = "-"
                if l.killCredit ~= "" then killCredit = l.killCredit end
                table.insert(list, string.format("[DPS] life run=%d life=%d name=%s src=%s grade=%d lv=%d map=%s born=%s first=%s last=%s death=%s ttk=%s ttk_spawn=%s attempt=%d maxhp=%s start_hp=%s eff=%s absorb=%s over=%s heal=%s drift=%s setup=%s scale=%s rebase=%s resets=%d events=%d kill_credit_owner=%s terminal_damage_owner=%s",
                    d.run, l.id, l.name, l.src, l.grade, l.level, l.map, self:DpsRel(l.born), self:DpsRel(l.firstHit), self:DpsRel(l.lastHit), self:DpsRel(l.death), ttk, ttkSpawn, l.deathAttempt, self:DpsNum(l.maxHp), self:DpsNum(l.startHp),
                    self:DpsNum(l.eff), self:DpsNum(l.absorb), self:DpsNum(l.over), self:DpsNum(l.heal), self:DpsNum(l.drift), self:DpsNum(l.setup), self:DpsNum(l.scale), self:DpsNum(l.rebase), l.resets, l.dmgEvents, killCredit, l.lastOwner))
            end
        end
        table.insert(list, string.format("[DPS] sample run=%d n=%d late=%d max_gap=%s every=%.2f", d.run, d.sampleN, d.sampleLate, self:DpsNum(d.sampleMaxGap), self.DpsSampleSec))
        local want = math.min(math.max(0, maxEvents), kept)
        local evStart = #list
        for i = d.n - want + 1, d.n do
            local e = d.ring[(i - 1) % self.DpsRawCap + 1]
            if e ~= nil and e.n == i then
                table.insert(list, string.format("[DPS] ev|%d|%d|%s|%s|%d|%d|%d|%s|%s|%s|%s|%s|%s|%s|%s|%s", d.run, e.n, self:DpsNum(e.t), e.kind, e.life, e.seq, e.att, e.owner, e.ak, e.src,
                    self:DpsNum(e.b), self:DpsNum(e.a), self:DpsNum(e.raw), self:DpsNum(e.ab), self:DpsNum(e.eff), self:DpsNum(e.ov)))
            end
        end
        local cap = self.DpsFlushLineCap
        local shown = math.min(#list, cap)
        local evPrinted = 0
        for i = 1, shown do
            log(list[i])
            if i > evStart then evPrinted = evPrinted + 1 end
        end
        local truncated = #list - shown
        log(string.format("[DPS] end run=%d scene=%s lines=%d truncated=%d ev_requested=%d ev_kept=%d ev_printed=%d ev_omitted=%d", d.run, d.scene, shown, truncated, math.max(0, maxEvents), kept, evPrinted, want - evPrinted))
        return shown
    end

    @ExecSpace("Server")
    method void RequestDps(string cmd, string arg)
        -- GM 전용 (메이커 플레이는 누구나): "start <장면>" · "flush <원장 줄 수>" · "finish <원장 줄 수>" · "stop". 채팅 「/dps」 연결은 ChatFold 패치 요청
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        if not self:IsGm(player) then
            log("[DPS] request denied uid=" .. senderUserId)
            return
        end
        local n = math.max(0, math.min(self.DpsRawCap, math.floor(tonumber(arg) or 0)))
        if cmd == "start" then
            local scene = arg
            if scene == "" then scene = "gm" end
            self:DpsStart(scene)
        elseif cmd == "flush" then self:DpsFlush(n)
        elseif cmd == "finish" then self:DpsFinish(n)
        elseif cmd == "stop" then self:DpsStop() end
    end

end
