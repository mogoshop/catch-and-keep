-- 노말 끝 「다음 난이도 미리보기」 (기획서 43 §3-4 ④-a · §10 결정 7 · 구현 단계 43-0, 10-29). 글귀는 10-29 사용자 확정 (docs/requests/copy-approval-20261029.md).
--   ① 카드 1장: 보통의 재의 왕을 쓰러뜨려 악몽이 열렸거나(PlayerStats.MaxDifficulty ≥ 1 — ProgressionSystem이 올린다) Lv40에 닿으면,
--      마을에서 다른 창·이야기 카드가 모두 닫힌 뒤 한 번 띄운다. 양식은 스킬 추천·선택 보상 카드(GameHUD OfferWin)를 그대로 — PreviewWin (tools/build/ui.cjs).
--      한 번 본 것은 PlayerQuest.StorySeen의 "nmpreview"로 캐릭터 저장에 남는다 (이야기 카드와 같은 저장 · 닫을 때 MarkStory).
--   ② 웨이포인트 창 잠긴 난이도 말풍선·알림: UnlockConditionText (ProgressionSystem.OnMonsterKilled와 같은 조건을 코드 값으로 읽는다)
--   ③ 아이템 도감 「???」 → 보통에서 나오지 않는 물건은 「악몽부터」·「지옥부터」: GrailLockText
--   수치는 손으로 적지 않고 지금 데이터로 센다 — 기획서 43 §1-1(유니크 32 · 세트 조각 20 · 룬워드 19 · 정예 15% 능력 · 우두머리 둘 · 보스 기술 +1 · 선택 보상 2단)과
--   같은 규칙: 장비는 베이스 요구 레벨 ≤ 그 난이도 최고 몬스터 레벨 + 3 (ItemData.PickUnique), 룬은 minLevel ≤ 몬스터 레벨 (ItemData 룬 드롭).
--   최고 몬스터 레벨 = ScaleLevel(보통 levelTo, 난이도) + 1 (액트 보스 한 칸 위 — 보통 41 · 악몽 71 · 지옥 99 상한).
@Logic
script NightmarePreview extends Logic

    property string Win = "PreviewWin"
    property string SeenKey = "nmpreview"      -- PlayerQuest.StorySeen 키 (영문·숫자만 — AddStorySeen 규칙)
    property integer TriggerLevel = 40         -- 재의 왕을 아직 못 잡았어도 이 레벨이면 띄운다
    property number SettleSeconds = 2          -- 조건이 이만큼 이어진 뒤 띄운다 (보스 처치 연출·이야기 카드와 겹치지 않게)
    property number ReadySince = 0
    property boolean Shown = false             -- 이번 접속에서 띄움 (MarkStory가 동기화되기 전에 다시 뜨지 않게)
    property boolean Showing = false            -- 카드가 떠 있음
    property string Trigger = ""
    property integer TimerId = 0
    property table FirstDiffCache = {}         -- 도감 key → 처음 나오는 난이도 (0 보통 · 1 악몽 · 2 지옥)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 카드 창 등록 · 확인/닫기 연결 · 1초마다 조건 검사
        self.Shown = false
        self.Showing = false
        self.ReadySince = 0
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() self:Dismiss() end)
        _UIKit:Connect(self.Win .. "/BtnOk", function() self:Dismiss() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 1)
        log("[VRF] preview card ready key=" .. self.SeenKey)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 반복 검사 해제
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    -- ───────── 난이도별 첫 등장 (도감 · 카드 공용, 서버·클라이언트 모두) ─────────

    method integer TopMonsterLevel(integer diff)
        -- 그 난이도에서 가장 높은 몬스터 레벨 (보통 levelTo를 난이도 구간으로 옮긴 값 + 액트 보스 1)
        local normal = _GameData:GetDifficulty(0)
        local top = normal ~= nil and math.floor(normal.levelTo) or 40
        return _GameConst:ScaleLevel(top, diff) + 1
    end

    method integer FirstDiffForGear(integer reqLv)
        -- 장비(유니크·세트 조각): 베이스 요구 레벨 ≤ 몬스터 레벨 + 3 (ItemData.PickUnique 규칙)
        for d = 0, 1 do
            if reqLv <= self:TopMonsterLevel(d) + 3 then return d end
        end
        return 2
    end

    method integer FirstDiffForRune(integer minLevel)
        -- 룬: minLevel ≤ 몬스터 레벨 (ItemData 룬 드롭)
        for d = 0, 1 do
            if minLevel <= self:TopMonsterLevel(d) then return d end
        end
        return 2
    end

    method integer FirstDiffOfGrail(table g)
        -- 도감 줄(ItemData.GrailList 항목) → 처음 나오는 난이도. 모르면 0
        if g == nil or g.key == nil then return 0 end
        local cached = self.FirstDiffCache[g.key]
        if cached ~= nil then return cached end
        local t = _ItemData:T()
        local diff = 0
        if g.kind == "u" then
            local id = string.sub(g.key, 3)
            for _, u in ipairs(t.UniqueList) do
                if u.id == id then
                    local b = t.Bases[u.base]
                    if b ~= nil then diff = self:FirstDiffForGear(math.floor(b.reqLv)) end
                    break
                end
            end
        elseif g.kind == "s" then
            local b = t.Bases[string.sub(g.key, 3)]
            if b ~= nil then diff = self:FirstDiffForGear(math.floor(b.reqLv)) end
        elseif g.kind == "r" then
            local need = 1
            for id in string.gmatch(g.runes or "", "[^,]+") do
                local r = _ItemData:GetRune(id)
                if r ~= nil then need = math.max(need, math.floor(r.minLevel)) end
            end
            diff = self:FirstDiffForRune(need)
        end
        self.FirstDiffCache[g.key] = diff
        return diff
    end

    method string GrailLockText(table g)
        -- 아이템 도감 못 찾은 줄의 값 칸: 보통에서 나오는 것은 「???」, 아니면 「악몽부터」·「지옥부터」
        local d = self:FirstDiffOfGrail(g)
        if d <= 0 then return "???" end
        return _UIKit:Colored(d == 1 and "#B48CE0" or "#E07A6A", _GameConst:DifficultyName(d) .. "부터")
    end

    method table CountBeyondNormal()
        -- 보통에서 나오지 않는 도감 물건 수 { u, s, r } 와 난이도별 { u1, u2, … }
        local c = { u = 0, s = 0, r = 0, u1 = 0, u2 = 0, s1 = 0, s2 = 0, r1 = 0, r2 = 0 }
        for _, g in ipairs(_ItemData:GrailList()) do
            local d = self:FirstDiffOfGrail(g)
            if d > 0 and c[g.kind] ~= nil then
                c[g.kind] = c[g.kind] + 1
                local k = g.kind .. tostring(d)
                c[k] = c[k] + 1
            end
        end
        return c
    end

    method string UnlockConditionText(integer diff)
        -- 잠긴 난이도의 해금 조건 (ProgressionSystem.OnMonsterKilled: 이전 난이도에서 마지막 보스 처치 + 그 앞 액트 의뢰를 다 끝낸 사람만)
        if diff <= 0 then return "" end
        local boss = _GameData:GetMonsterName(_GameConst.FinalBossSourceId)
        local act = _GameConst:ActOfBossSource(_GameConst.FinalBossSourceId)
        local prev = _GameConst:DifficultyName(diff - 1)
        if act > 1 then
            return string.format("%s에서 액트 %d 퀘스트를 마치고 %s를 쓰러뜨리면 열립니다", prev, act - 1, boss)
        end
        return string.format("%s에서 %s를 쓰러뜨리면 열립니다", prev, boss)
    end

    -- ───────── 카드 ─────────

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 캐릭터를 다 불러왔고, 아직 안 봤고, 조건(악몽 열림 또는 Lv40)이 마을에서 SettleSeconds 이어지면 띄운다
        if self.Showing and not _UIKit:IsOpen(self.Win) then self:Dismiss() end   -- Esc·다른 메뉴로 닫혀도 본 것으로
        if self.Shown then return end
        local player = _UserService.LocalPlayer
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if not isvalid(player) or not isvalid(player.CurrentMap) or save == nil or st == nil or quest == nil then return end
        if not save.BootDone or save.Slot <= 0 or save.Selecting then
            self.ReadySince = 0
            return
        end
        if quest:HasSeenStory(self.SeenKey) then
            self.Shown = true
            return
        end
        local trigger = ""
        if st.MaxDifficulty >= 1 then trigger = "boss" elseif st.Level >= self.TriggerLevel then trigger = "level" end
        local calm = trigger ~= "" and _GameConst:IsTown(player.CurrentMap) and _Util:IsAlive(player)
            and not _UIKit:AnyWindowOpen() and not _StoryCard.Active and #_StoryCard.Queue == 0
        local now = _UtilLogic.ElapsedSeconds
        if not calm then
            self.ReadySince = 0
            return
        end
        if self.ReadySince <= 0 then self.ReadySince = now end
        if now - self.ReadySince < self.SettleSeconds then return end
        self:Show(trigger)
    end

    @ExecSpace("ClientOnly")
    method void Show(string trigger)
        -- 카드를 채워 연다. 숫자는 지금 데이터로 센다 (CountBeyondNormal · difficulty.csv · BossMoves 규칙)
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if st == nil then return end
        self.Shown = true
        self.Showing = true
        self.Trigger = trigger
        local c = self:CountBeyondNormal()
        local nm = _GameData:GetDifficulty(1)
        local dual = nm ~= nil and math.floor(nm.championDual or 0) > 0
        local elitePct = nm ~= nil and math.floor((nm.eliteVariantChance or 0) * 100 + 0.5) or 0
        local name = _GameConst:DifficultyName(1)
        local gold = "#E6C88A"
        -- 목록은 숫자 없이 (10-29 글귀 확정 58~62 — 개수는 도감에서 본다)
        local lines = {
            "· 노말에서는 나오지 않는 " .. _UIKit:Colored(gold, "유니크") .. "와 " .. _UIKit:Colored(gold, "세트"),
            "· 상급 룬으로 짜는 " .. _UIKit:Colored(gold, "룬워드"),
            "· 능력을 지닌 정예" .. (dual and (" — 우두머리는 " .. _UIKit:Colored(gold, "능력 둘") .. ",\n   붙잡으면 그대로 그림자로") or ""),   -- 한 줄이 칸보다 길어 「그림자로」가 글자 중간에서 접혔다 → 쉼표 뒤에서 줄을 나눈다
            "· 보스마다 " .. _UIKit:Colored(gold, "기술 하나 더"),
            "· 선택 보상이 " .. _UIKit:Colored(gold, "한 단계 더"),
        }
        local foot = st.MaxDifficulty >= 1 and "웨이포인트에서 난이도를 바꿀 수 있습니다" or self:UnlockConditionText(1)
        _UIKit:SetText(self.Win .. "/Title", name .. "에서 깨어나는 것들")
        _UIKit:SetText(self.Win .. "/Sub", "같은 밤, 더 깊이.")
        _UIKit:SetText(self.Win .. "/Card/Kind", name)
        _UIKit:SetText(self.Win .. "/Card/Name", "문 아래의 붉은 틈")
        _UIKit:SetText(self.Win .. "/List/Body", table.concat(lines, "\n"))
        _UIKit:SetText(self.Win .. "/Foot", foot)
        -- 그림 자리: 코덱스 그림(ui_icons preview_nightmare)이 들어오면 그것, 없으면 빌더가 깐 임시 그림 그대로
        local art = _GameData:GetUiIcon("preview_nightmare")
        if art ~= "" then _UIKit:SetIcon(self.Win .. "/Card/Art", art) end
        -- 46-6 (결정 8 V1): 목록 아래 거인 5종 실루엣 한 줄 (HUD 거인 아이콘을 어둡게 · 카드 그림은 그대로) + 한 줄 (글귀 승인 전)
        for i, kind in ipairs(_UndeadSystem:GiantFallback()) do
            local path = self.Win .. "/List/G" .. tostring(i)
            local icon = _GameData:GetUiIcon("ui_giant_" .. kind)
            _UIKit:SetEnabled(path, icon ~= "")
            if icon ~= "" then _UIKit:SetIcon(path, icon) end
            _UIKit:SetColor(path, Color(0.16, 0.1, 0.22, 1))
        end
        _UIKit:SetText(self.Win .. "/List/GiantNote", "무리가 정하는 " .. _UIKit:Colored(gold, "뼈 의식 거인") .. " 다섯")
        _UIKit:Open(self.Win)
        log(string.format("[VRF] preview card shown trigger=%s lv=%d maxDiff=%d unique=%d(%d/%d) set=%d(%d/%d) rw=%d(%d/%d) elite=%d%% dual=%s",
            trigger, st.Level, st.MaxDifficulty, c.u, c.u1, c.u2, c.s, c.s1, c.s2, c.r, c.r1, c.r2, elitePct, tostring(dual)))
    end

    @ExecSpace("ClientOnly")
    method void Dismiss()
        -- 확인·닫기: 창을 닫고 본 것으로 저장 (PlayerQuest.MarkStory → StorySeen, 캐릭터 저장)
        _UIKit:Close(self.Win)
        if not self.Showing then return end
        self.Showing = false
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest ~= nil then quest:MarkStory(self.SeenKey) end
        -- sent = 서버에 「봤음」을 보냈나 (실제 저장은 PlayerSave.Save 가드를 지나는 다음 자동 저장 · 10-29 45 부록 C 확인)
        log("[VRF] preview card dismiss trigger=" .. self.Trigger .. " sent=" .. tostring(quest ~= nil))
    end

end
