-- 지연 생성은 성공 확인 후 비용을 확정하고, 맵 이동·사망 시 취소한다.
-- 스킬 효과 구현 (SkillBook이 습득·마나·쿨다운을 확인한 뒤 Apply로 넘긴다). 스킬 하나 = 메서드 하나.
-- 타격 판정은 플레이어의 PlayerAttack(같은 엔티티에 AttackComponent는 하나만)을 빌려 HitEvent 경로로 보낸다.
-- 피해 공식: 기본 + 레벨당 증가 × 주문력. 속성은 PlayerAttack.SkillElement가 정한다.
@Component
script SkillEffects extends Component

    property integer StormTimer = 0
    property number StormUntil = 0
    property number StormDamage = 0
    property integer StormVisual = 0
    property table VisualTimers = {}
    property integer ShotCount = 0            -- 투사체 이름 번호 (맵 안에서 겹치지 않게)
    property integer EffectEpoch = 0
    property table MistVisuals = {}
    property table MistTimers = {}            -- 남아 있는 독안개 타이머
    property table DrainVisuals = {}           -- 짧은 흡수 궤적; 맵 이동·사망에서도 정리한다
    property table BlastVisuals = {}
    property integer BlastFxCount = 0
    -- 메이플 스킬 이펙트 (animationclip, 장식 모델 summonritual에 입혀 재생)
    property string FxShardShot = "423983c3b393414c8a8d91578b1fab9c"     -- 어두운 보라 궤적 (골편 투사체)
    property string FxShardLaunch = "072ed2b035d44caa9a463b8cdc8a0f07"   -- 해골 무리 발사
    property string FxShardHit = "5dbd9bf30819471b9375a5d8343ac780"      -- 보라 파열
    property string FxBlast = "22444db0645d47f48f300f36b3d90e4b"         -- 검붉은 피 폭발 (해골 폭탄)
    property string FxFlameShot = "40f0991c2e204ee888670cb3006382e5"     -- 불꽃 화살 (저주 불꽃)
    property string FxFrostShot = "d5a9e48c2d654726811db8b127699233"     -- 서리 혼
    property string FxOffering = "b92b4c5e6a8a47f7867204509ba9e4fe"      -- 초록 회복 고리 (뼈 성찬)
    property string FxBlink = "1212ff9a8bbf41d1a6798484e1aa20d6"         -- 푸른 고리 섬광 (망령 도약·질주)
    property string FxPoisonCloud = "71898bc523f441e39f00f25ac4989166"   -- 초록 독구름
    property string FxDrain = "07e92bf63fa44ba5a74507f96cb4e18c"         -- 보라 소용돌이
    property string FxStorm = "0d7381204f9b47869a705a16cf0344d1"         -- 보라 회오리 고리
    property string FxWave = "19fd8c7d47ec44aeb467bad744659899"          -- 보라 마법진 폭발
    property table ClipVisuals = {}           -- 클라이언트: 재생 중인 메이플 스킬 애니메이션 serial
    property integer StormClip = 0
    property number PredictedAt = -10         -- 클라이언트: 골편을 마지막으로 직접 그린 시각

    @ExecSpace("ServerOnly")
    method boolean Apply(string id, integer lv, Vector2 me, Vector2 target, number spell)
        -- 효과가 실제로 났으면 true. false면 SkillBook이 마나·쿨다운을 쓰지 않는다 (실패 이유는 각 효과가 알린다)
        local ok = false
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return false end
        local power = book:GetEffectPower(id, lv)
        local duration = book:GetCurseDuration(lv)   -- 저주 지속 (레벨이 오를수록 길어진다)
        power = power * book:GetCursePowerMult(id)   -- 수치형 저주: 강화 「깊은 저주」 + 장비 「저주 효과 %」
        if id == "bone_shard" then ok = self:BoneShardVolley(me, target, power * spell, book:GetBoneShardCount(lv), nil, nil, nil)
        elseif id == "poison_mist" then ok = self:PoisonMist(target, power * spell)
        elseif id == "bone_armor" then ok = self:BoneArmor(power)
        elseif id == "bone_spear" then ok = self:BoneSpear(me, target, power * spell)
        elseif id == "hex_flame" then ok = self:HexFlame(me, target, power * spell, 1 + self:Node("flame_twin"))
        elseif id == "frost_soul" then ok = self:FrostSoul(me, target, power * spell)
        elseif id == "skel_bomb" then ok = _UndeadSystem:SkeletonBomb(self.Entity, target, power * (1 + 0.2 * self:Node("bomb_marrow")), 1.6 * (1 + 0.15 * self:Node("bomb_wide")), 1 + self:Node("bomb_pair"))
        elseif id == "bone_offering" then ok = _UndeadSystem:BoneOffering(self.Entity, power * (1 + 0.2 * self:Node("offering_heal")), 4 * (1 + 0.25 * self:Node("offering_wide")), 10 * self:Node("offering_frenzy"))
        elseif id == "wraith_dash" then ok = self:WraithDash(me, target)
        elseif id == "wraith_blink" then ok = self:WraithBlink(me, target)
        elseif id == "soul_drain" then ok = self:SoulDrain(target, power * spell)
        elseif id == "bone_storm" then ok = self:BoneStorm(power * spell)
        elseif id == "mark_weakness" then ok = self:Curse(target, "amp", power, 1.5, duration)
        elseif id == "enfeeble" then ok = self:Curse(target, "weaken", power, 1.5, duration)
        elseif id == "thorn_curse" then ok = self:Curse(target, "thorn", power, 1.5, duration)
        elseif id == "terror" then ok = self:Curse(target, "terror", 0, 1.5, power)
        elseif id == "confusion" then ok = self:Curse(target, "confuse", 0, 1.5, power)
        elseif id == "life_tap" then ok = self:Curse(target, "lifetap", power, 1.5, duration)
        elseif id == "decay" then ok = self:Curse(target, "decay", power, 1.5, duration)
        elseif id == "resist_break" then ok = self:Curse(target, "resist", power, 1.5, duration)
        elseif id == "lure" then ok = self:Lure(target, power)
        elseif id == "bone_prison" then ok = self:BonePrison(target, power)
        elseif id == "soul_torrent" then ok = self:SoulTorrent(me, target, power * spell, book:GetTorrentCount(lv))
        elseif id == "death_wave" then ok = self:DeathWave(power * spell)
        elseif id == "shadow_sacrifice" then ok = self:ShadowSacrifice(target, power * spell)
        elseif id == "elite_promote" then ok = self:ElitePromote(power)
        elseif id == "shadow_summon" then ok = self:SummonShadow()
        elseif id == "rally" then ok = self:Rally()
        elseif id == "raise_skeleton" then ok = _UndeadSystem:Raise(self.Entity, "skeleton", lv, target, nil, nil)
        elseif id == "raise_mage" then ok = _UndeadSystem:Raise(self.Entity, "mage", lv, target, nil, nil) end
        if not ok then log("[SkillEffects] " .. id .. " 효과 없음 → 마나·쿨다운 보존") end
        return ok
    end

    method integer PierceCap(string id)
        -- 관통 투사체 한 발의 최대 적 수 (SkillBook.GetPierceCap, 장비 스킬 레벨 포함)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 1 end
        return book:GetPierceCap(book:GetPowerLevel(id))
    end

    method integer Node(string id)
        -- 강화 노드 랭크 (docs/design/16)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 0 end
        return book:Node(id)
    end

    @ExecSpace("ServerOnly")
    method void Fail(string reason)
        -- 시전 실패 안내 (마나·쿨다운은 쓰지 않는다)
        _Util:Warn(reason, self.Entity.PlayerComponent.UserId)
    end

    method ShadowCommander Commander()
        ---@type ShadowCommander
        local c = self.Entity:GetComponent("script.ShadowCommander")
        return c
    end

    @ExecSpace("ServerOnly")
    method void Hit(Vector2 center, Vector2 size, number angle, string info, number damage)
        -- angle < 0 이면 원(반지름 size.x), 아니면 회전 사각형
        ---@type PlayerAttack
        local atk = self.Entity:GetComponent("script.PlayerAttack")
        if atk ~= nil then atk:SkillAttack(center, size, angle, info, damage) end
    end

    @ExecSpace("ServerOnly")
    method table Targets(Vector2 center, number radius)
        return _Util:MonstersNear(self.Entity.CurrentMap, center, radius)
    end

    @ExecSpace("ServerOnly")
    method table FoePlayers(Vector2 center, number radius)
        -- 결투 상대 플레이어가 반경 안에 있으면 { 엔티티 } (저주·독안개·흡수·감옥이 플레이어에게도 — 지속은 몬스터의 PvpDurationMul배)
        return _Util:DuelFoesNear(self.Entity, self.Entity.CurrentMap, center, radius, true)
    end

    -- ───────── 혼술 ─────────

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 내 캐릭터면 스킬 애니메이션을 투명하게 한 번씩 틀어 미리 불러 둔다 (처음 쓸 때 불러오느라 짧은 연출이 안 보였다)
        if self.Entity ~= _UserService.LocalPlayer then return end
        local list = { self.FxShardShot, self.FxShardLaunch, self.FxShardHit, self.FxBlast, self.FxFlameShot, self.FxFrostShot, self.FxOffering, self.FxBlink, self.FxPoisonCloud, self.FxDrain, self.FxStorm, self.FxWave, _GameConst.FxAriseRing, _GameConst.FxAriseFlame, _GameConst.FxAriseBurst }
        local serials = {}
        for _, ruid in ipairs(list) do
            local serial = _EffectService:PlayEffectAttached(ruid, self.Entity, Vector3.zero, 0, Vector3(0.1, 0.1, 1), false, { Alpha = 0 })
            if serial ~= 0 then table.insert(serials, serial) end
        end
        self.VisualTimers["preload"] = _TimerService:SetTimerOnce(function()
            for _, serial in ipairs(serials) do _EffectService:RemoveEffect(serial) end
            self.VisualTimers["preload"] = nil
        end, 3)
    end

    @ExecSpace("Multicast")
    method void ClipFx(string ruid, Vector3 pos, number scale, number seconds, number angle)
        -- 메이플 스킬 애니메이션을 그 자리에 seconds 동안 재생한다. 서버가 바꾼 SpriteRUID는 클라이언트에 안 보여서 클라이언트마다 EffectService로 그린다
        local me = _UserService.LocalPlayer
        if ruid == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local serial = _EffectService:PlayEffect(ruid, self.Entity, pos, angle, Vector3(scale, scale, 1), seconds > 1.5, nil)
        if serial == 0 then return end
        self.ClipVisuals[serial] = true
        local key = "clip" .. tostring(serial)
        self.VisualTimers[key] = _TimerService:SetTimerOnce(function()
            _EffectService:RemoveEffect(serial)
            self.ClipVisuals[serial] = nil
            self.VisualTimers[key] = nil
        end, seconds)
    end

    @ExecSpace("Multicast")
    method void StormClipFx(number seconds)
        -- 뼈 폭풍 회오리 고리: 시전자에게 붙여 따라다니게 한다. 다시 쓰면 새 시간으로 다시 건다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        if self.StormClip ~= 0 then _EffectService:RemoveEffect(self.StormClip) end
        local oldTimer = self.VisualTimers["stormclip"]
        if oldTimer ~= nil then _TimerService:ClearTimer(oldTimer) end
        local serial = _EffectService:PlayEffectAttached(self.FxStorm, self.Entity, Vector3(0, 0.15, 0), 0, Vector3(0.65, 0.65, 1), true, { Alpha = 0.6 })
        self.StormClip = serial
        if serial == 0 then return end
        self.VisualTimers["stormclip"] = _TimerService:SetTimerOnce(function()
            _EffectService:RemoveEffect(serial)
            if self.StormClip == serial then self.StormClip = 0 end
            self.VisualTimers["stormclip"] = nil
        end, seconds)
    end

    method table ShardAngles(Vector2 dir, integer count)
        -- 골편 부채꼴 각도 (서버 발사·클라이언트 예측 공용, 디아2 멀티샷): 이웃한 발 사이 15°, 겨눈 방향을 가운데로 대칭.
        -- 홀수면 가운데 한 발이 정면(고른 적 추적), 짝수면 정면 양옆 7.5°씩 (2발 = 15°, 5발 = 60°)
        local base = math.atan(dir.y, dir.x)
        local spread = math.rad(15)
        local list = {}
        for i = 1, count do table.insert(list, base + (i - (count + 1) / 2) * spread) end
        return list
    end

    method Vector2 ShardAim(Vector2 me, Vector2 target)
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        return dir
    end

    @ExecSpace("ServerOnly")
    method boolean BoneShardVolley(Vector2 me, Vector2 target, number damage, integer count, any onComplete, any canCommit, Entity lock)
        -- 골편 투척: 한 번에 count발을 부채꼴로 동시에 (10-11 QA: 줄지어 나가지 않게). 홀수면 가운데 발이 고른 적을 따라가고
        -- 나머지는 곧게 날아 꿰뚫는다. 첫 발이 실제로 날아간 뒤(마나·쿨다운 확정) 나머지를 같은 프레임에 쏜다
        local dir = self:ShardAim(me, target)
        count = math.max(1, count)
        local angles = self:ShardAngles(dir, count)
        local center = count % 2 == 1 and (count + 1) // 2 or 0
        local aimAt = function(i) return me + Vector2(math.cos(angles[i]), math.sin(angles[i])) * 3 end
        local first = center > 0 and center or 1
        local rest = function(success)
            if onComplete ~= nil then onComplete(success) end
            if not success then return end
            for i = 1, #angles do
                if i ~= first then self:BoneShard(me, aimAt(i), damage, nil, nil, nil) end
            end
        end
        return self:BoneShard(me, center > 0 and target or aimAt(first), damage, rest, canCommit, center > 0 and lock or nil)
    end

    @ExecSpace("ClientOnly")
    method void PredictBoneShard(Vector2 target, integer count, Entity lock, integer maxHits)
        -- 10-11 QA 「누르자마자 안 나가고 0.5초쯤 늦다」: 서버 투사체는 왕복·생성 동기화만큼 늦게 보였다.
        -- 내 화면에서는 누르는 순간 서버와 같은 각도·속도·사거리로 뼛조각을 직접 그리고, 서버 투사체는 숨긴다 (판정·피해는 서버)
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local me = _Util:Pos2(self.Entity)
        local dir = self:ShardAim(me, target)
        count = math.max(1, count)
        local angles = self:ShardAngles(dir, count)
        local center = count % 2 == 1 and (count + 1) // 2 or 0
        self.PredictedAt = _UtilLogic.ElapsedSeconds
        for i, a in ipairs(angles) do
            local d = i == center and dir:Normalize() or Vector2(math.cos(a), math.sin(a))
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local e = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneShardView_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            local proj = isvalid(e) and e:GetComponent("script.Projectile") or nil
            if proj ~= nil then
                ---@type Projectile
                local p = proj
                p.MaxHits = maxHits   -- 서버와 같은 마릿수에서 멈춘다 (관통 상한)
                p:PlayLocal(self.Entity, d, 12, 6.5, self.FxShardShot, 0.55, i == center and lock or nil)
            elseif isvalid(e) then
                e:Destroy()
            end
        end
        if not Environment:IsPublishedPlay() then log("[VRF] bone shard predicted n=" .. tostring(#angles)) end   -- 시전·추출·소환마다 찍히므로 출시 서버에서는 끈다
    end

    method boolean RecentlyPredicted()
        -- 클라이언트: 방금(1.5초 안) 직접 그린 골편이 있으면 같은 시전의 서버 투사체를 숨긴다
        return _UtilLogic.ElapsedSeconds - self.PredictedAt < 1.5
    end

    @ExecSpace("ServerOnly")
    method boolean BoneArmor(number absorb)
        -- 뼈 갑옷: 흡수량을 가득 채운다 (남은 흡수량보다 클 때만 의미 — 다시 쓰면 새로 채운다)
        ---@type PlayerStats
        local st = self.Entity:GetComponent("script.PlayerStats")
        if st == nil then return false end
        st.BoneArmorMax = math.floor(absorb)
        st.BoneArmor = math.floor(absorb)
        local p = self.Entity.TransformComponent.WorldPosition
        _ParticleService:PlayBasicParticle(BasicParticleType.Buff, self.Entity, p, 0, Vector3(1, 1, 1), false, { Color = Color(0.9, 0.85, 0.7, 1) })
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean BoneSpear(Vector2 me, Vector2 target, number damage)
        -- 뼈 창: 조준 방향으로 길게 꿰뚫는 창 (초속 14, 사거리 9 × 「긴 창」). 「두 갈래」면 곧은 창 + 7° 옆 창 (둘 다 벌리면 정면 적을 비껴갔다). 모두에게 보이는 서버 투사체
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        local range = 9 * (1 + 0.2 * self:Node("spear_long"))
        local dirs = { dir }
        if self:Node("spear_twin") > 0 then
            local a = math.atan(dir.y, dir.x)
            dirs = { dir, Vector2(math.cos(a + 0.12), math.sin(a + 0.12)) }
        end
        local map = self.Entity.CurrentMap
        local owner = self.Entity
        for _, d in ipairs(dirs) do
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneSpear_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            if isvalid(shot) then
                local fly = d
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    proj:Skin(self.FxShardShot, 0.95)
                    proj:Tint(Color(0.95, 0.9, 0.78, 1))
                    proj.MaxHits = self:PierceCap("bone_spear")
                    proj:Launch(owner, fly, 14, range, damage, "skill.bone_spear", true)
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void ShardBounce(Vector2 from, table hitIds, number damage, integer bouncesLeft, number spikePct)
        -- 골편 강화 「튕김」: 맞힌 자리에서 4칸 안 아직 안 맞은 가장 가까운 적에게 뼛조각이 튄다 (모두에게 보이는 서버 투사체)
        local map = self.Entity.CurrentMap
        local best = nil
        local bestD = 4
        for _, m in ipairs(_Util:MonstersNear(map, from, 4)) do
            if not hitIds[m.Entity.Id] and not m.IsDead then
                local d = (_Util:Pos2(m.Entity) - from):Magnitude()
                if d < bestD then best, bestD = m, d end
            end
        end
        if best == nil then return end
        local dir = (_Util:Pos2(best.Entity) - from):Normalize()
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneBounce_" .. tostring(self.ShotCount), Vector3(from.x, from.y + 0.3, 0), map)
        if not isvalid(shot) then return end
        local owner = self.Entity
        local target = best.Entity
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
            proj:Skin(self.FxShardShot, 0.5)
            for id, v in pairs(hitIds) do proj.HitIds[id] = v end
            if isvalid(target) then proj.Lock = target end
            proj.SpikePct = spikePct
            proj.Bounces = bouncesLeft
            proj.MaxHits = 1   -- 튕긴 뼛조각은 한 마리만 (튕김 횟수는 강화 랭크가 정한다)
            proj:Launch(owner, dir, 12, bestD + 1.5, damage, "skill.bone_shard", true)
        end, function() if isvalid(shot) then shot:Destroy() end end)
    end

    @ExecSpace("ServerOnly")
    method void BoneShardImpact(Vector3 pos)
        -- 뼛조각 명중: 보라 파열
        self:ClipFx(self.FxShardHit, pos, 0.5, 0.6, 0)
    end

    @ExecSpace("ServerOnly")
    method boolean BoneShard(Vector2 me, Vector2 target, number damage, any onComplete, any canCommit, Entity lock)
        -- 조준 방향으로 뼛조각이 날아간다 (초속 12, 사거리 6.5). 스킬 레벨 구간만큼 꿰뚫고(PierceCap) 그 수를 채우면 멈춘다
        -- lock(고정 대상)이 있으면 그 몬스터를 따라가 닿는 순간 터진다 (가는 길의 적도 맞는다)
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        if lock ~= nil and not isvalid(lock) then lock = nil end
        local start = me + Vector2(0, 0.3) + dir * 0.35
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneShard_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), self.Entity.CurrentMap)
        if not isvalid(shot) then
            self:Fail("뼛조각을 만들지 못했다")
            return false
        end
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local finished = false
        local finish = function(success)
            if finished then return end
            finished = true
            if not success and isvalid(shot) then shot:Destroy() end
            if onComplete ~= nil then onComplete(success) end
        end
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if finished then if isvalid(shot) then shot:Destroy() end return end
            if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then finish(false) return end
            if canCommit ~= nil and not canCommit() then finish(false) return end
            -- 투사체 그림: 어두운 보라 궤적 (기본 화살 그림은 평범했다)
            proj:Skin(self.FxShardShot, 0.55)
            -- 쏜 사람 화면은 누르는 순간 PredictBoneShard가 그린 뼛조각을 보여 주고 이 서버 투사체는 숨긴다
            proj.ViewKind = "bone_shard"
            if isvalid(lock) then proj.Lock = lock end
            proj.SpikePct = 10 * self:Node("shard_spike")   -- 강화 「뼈 가시」
            proj.Bounces = self:Node("shard_bounce")        -- 강화 「튕김」
            proj.MaxHits = self:PierceCap("bone_shard")      -- 관통 상한 (스킬 레벨 구간)
            proj:Launch(owner, dir, 12, 6.5, damage, "skill.bone_shard", true)
            finish(true)
        end, function() finish(false) end)
        _TimerService:SetTimerOnce(function() if not finished then finish(false) end end, 1)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean PoisonMist(Vector2 target, number dps)
        -- 4초 동안 남는 독안개(반경 1.3): 0.5초마다 안에 있는 적에게 독(2초)을 건다. 나중에 들어온 적도 걸린다
        local epoch = self.EffectEpoch
        local map = self.Entity.CurrentMap
        local seconds = 4 + self:Node("mist_thick")            -- 강화 「짙은 독」
        local untilAt = _UtilLogic.ElapsedSeconds + seconds
        local radius = 1.3 * (1 + 0.2 * self:Node("mist_wide"))   -- 강화 「넓은 안개」
        local tick = function()
            for _, m in ipairs(_Util:MonstersNear(map, target, radius)) do m:ApplyPoison(dps, 2, self.Entity) end
            for _, foe in ipairs(self:FoePlayers(target, radius)) do
                ---@type PlayerStats
                local fs = foe:GetComponent("script.PlayerStats")
                if fs ~= nil then fs:ApplyPvpPoison(dps * _GameData.pvpDamageMult, 2, self.Entity) end
            end
        end
        tick()
        local timerId = 0
        timerId = _TimerService:SetTimerRepeat(function()
            if not _Util:IsAlive(self.Entity) or self.Entity.CurrentMap ~= map or epoch ~= self.EffectEpoch or _UtilLogic.ElapsedSeconds >= untilAt then
                _TimerService:ClearTimer(timerId)
                self.MistTimers[timerId] = nil
                return
            end
            tick()
        end, 0.5)
        self.MistTimers[timerId] = true
        self:MistFx(Vector3(target.x, target.y, 0), radius, seconds)
        self:ClipFx(self.FxPoisonCloud, Vector3(target.x, target.y + 0.3, 0), 1.25 * radius / 1.3, seconds, 0)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean HexFlame(Vector2 me, Vector2 target, number damage, integer count)
        -- 저주 불꽃: 조준 방향으로 불꽃 화살 count발 (가운데 정면, 15° 간격 부채꼴). 한 적에 맞으면 사라진다.
        -- 저주 걸린 적에게 +50%(「낙인 연소」 랭크마다 +20%p)는 PlayerAttack.CalcDamage가 맞는 순간 정한다
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local launched = 0
        for _, a in ipairs(self:ShardAngles(dir, math.max(1, count))) do
            local d = Vector2(math.cos(a), math.sin(a))
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "HexFlame_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            if isvalid(shot) then
                launched = launched + 1
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    proj:Skin(self.FxFlameShot, 0.45)
                    proj:Tint(Color(1, 0.75, 0.55, 1))
                    proj:Launch(owner, d, 11, 7, damage, "skill.hex_flame", false)
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        if launched == 0 then
            self:Fail("불꽃을 날리지 못했다")
            return false
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean FrostSoul(Vector2 me, Vector2 target, number damage)
        -- 서리 혼: 조준 방향으로 적을 꿰뚫고 날아간다 (초속 9, 사거리 8). 맞은 적의 둔화는 PlayerAttack.CalcDamage
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local start = me + Vector2(0, 0.3) + dir * 0.35
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "FrostSoul_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
        if not isvalid(shot) then
            self:Fail("서리 혼을 날리지 못했다")
            return false
        end
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
            proj:Skin(self.FxFrostShot, 0.6)
            proj:Tint(Color(0.85, 0.95, 1, 1))
            proj.MaxHits = self:PierceCap("frost_soul")
            proj:Launch(owner, dir, 9, 8, damage, "skill.frost_soul", true)
        end, function() if isvalid(shot) then shot:Destroy() end end)
        return true
    end

    @ExecSpace("ServerOnly")
    method void FrostShatter(Vector2 at, number damage)
        -- 강화 「파쇄」: 서리 혼에 느려진 적이 죽은 자리에서 냉기 파편 (반경 1.3)
        self:Hit(Vector2(at.x, at.y + 0.2), Vector2(1.3, 0), -1, "skill.frost_shatter", damage)
        self:ClipFx(self.FxFrostShot, Vector3(at.x, at.y + 0.4, 0), 0.5, 0.5, 0)
    end

    @ExecSpace("ServerOnly")
    method boolean WraithDash(Vector2 me, Vector2 dest)
        -- 망령 질주: 내 클라이언트가 이미 움직였다 (SkillBook.CastMove). 여기서는 무적·연출, 강화 「망령 자취」 피해·둔화만
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        local ghost = book ~= nil and book:Node("dash_ghost") or 0
        ---@type PlayerVitals
        local vitals = self.Entity:GetComponent("script.PlayerVitals")
        local seconds = 0.3 + 0.05 * ghost   -- 10-20 밸런스: 연속 3번이어도 무적이 너무 길지 않게 (최대 0.45초)
        if vitals ~= nil then
            vitals.InvincibleUntil = math.max(vitals.InvincibleUntil, _UtilLogic.ElapsedSeconds + seconds)
            vitals:Blink(seconds)
        end
        local trail = book ~= nil and book:Node("dash_trail") or 0
        if trail > 0 then
            local path = dest - me
            local len = path:Magnitude()
            if len > 0.1 then
                local mid = me + path * 0.5
                local hit = {}
                for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, mid, len * 0.5 + 0.6)) do
                    -- 지나간 길(선분)에서 0.6칸 안의 적
                    local unit = path * (1 / len)
                    local q = _Util:Pos2(m.Entity) - me
                    local along = math.max(0, math.min(len, q:Dot(unit)))
                    if (q - unit * along):Magnitude() <= 0.6 then table.insert(hit, m) end
                end
                ---@type PlayerAttack
                local atk = self.Entity:GetComponent("script.PlayerAttack")
                for _, m in ipairs(hit) do
                    if atk ~= nil and not m.IsDead then atk:SkillHitOne(m.Entity, "skill.dash_trail", book:DashTrailDamage(trail)) end
                    m:ApplyChill(1.5)
                end
            end
        end
        self:ClipFx(self.FxBlink, Vector3(me.x, me.y + 0.3, 0), 0.45, 0.4, 0)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean WraithBlink(Vector2 me, Vector2 dest)
        -- 망령 도약: 내 클라이언트가 이미 옮겼다. 떠난 자리·도착 자리에 섬광 (군단 질주가 있으면 소환수가 곁으로 따라온다 — ShadowUnit)
        self:ClipFx(self.FxBlink, Vector3(me.x, me.y + 0.3, 0), 0.6, 0.45, 0)
        self:ClipFx(self.FxBlink, Vector3(dest.x, dest.y + 0.3, 0), 0.6, 0.45, 0)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean SoulDrain(Vector2 target, number damage)
        -- 가장 가까운 적 하나의 생명을 흡수 → 피해의 50% 회복, 소환수도 30% 회복 (마법)
        local m = self:Targets(target, 1.5)[1]
        if m == nil then
            -- 결투 상대 플레이어 흡수 (마법 저항 · PvP 배율)
            local foe = self:FoePlayers(target, 1.5)[1]
            if foe == nil then
                self:Fail("흡수할 대상이 없다")
                return false
            end
            ---@type PlayerStats
            local fs = foe:GetComponent("script.PlayerStats")
            ---@type PlayerVitals
            local fv = foe:GetComponent("script.PlayerVitals")
            local dealt = damage * _GameData.pvpDamageMult * (fs ~= nil and fs:PvpTakenMult() or 1)
            if fv ~= nil then fv:TakeDuelDamage(dealt, self.Entity) end
            ---@type PlayerStats
            local mine = self.Entity:GetComponent("script.PlayerStats")
            if mine ~= nil then mine:Heal(dealt * 0.5, 0) end
            self:Fx("drain", foe.TransformComponent.WorldPosition, 0.8)
            self:ClipFx(self.FxDrain, foe.TransformComponent.WorldPosition + Vector3(0, 0.4, 0), 0.6, 0.7, 0)
            return true
        end
        damage = damage * math.max(0, 1 - m:GetResist("magic") / 100)
        m:TakeDamage(damage, self.Entity)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then stats:Heal(damage * 0.5, 0) end
        -- 보관함 그림자와 언데드 모두 같은 주인의 살아 있는 소환수다.
        for _, unit in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            if unit.OwnerPlayer == self.Entity and not unit.Dead and unit.Hp > 0 then
                unit.Hp = math.min(unit.MaxHp, unit.Hp + damage * 0.3 * (1 + 0.25 * self:Node("drain_share")))   -- 강화 「나눔」
            end
        end
        self:Fx("drain", m.Entity.TransformComponent.WorldPosition, 0.8)
        self:ClipFx(self.FxDrain, m.Entity.TransformComponent.WorldPosition + Vector3(0, 0.4, 0), 0.6, 0.7, 0)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean BoneStorm(number damage)
        -- 6초 동안 0.5초마다 주위 반경 1.2 (다시 쓰면 시간만 늘어난다)
        local map = self.Entity.CurrentMap
        self.StormUntil = _UtilLogic.ElapsedSeconds + 6
        self.StormDamage = damage
        self:Fx("storm", self.Entity.TransformComponent.WorldPosition, 1.2)
        self:StormClipFx(6)
        if self.StormTimer ~= 0 then return true end
        local interval = 0.5 * (1 - 0.15 * self:Node("storm_fast"))   -- 강화 「회전 가속」
        self.StormTimer = _TimerService:SetTimerRepeat(function()
            if _UtilLogic.ElapsedSeconds > self.StormUntil or not _Util:IsAlive(self.Entity) or self.Entity.CurrentMap ~= map then
                _TimerService:ClearTimer(self.StormTimer)
                self.StormTimer = 0
                return
            end
            local p = _Util:Pos2(self.Entity)
            self:Hit(Vector2(p.x, p.y + 0.3), Vector2(1.2, 0), -1, "skill.bone_storm", self.StormDamage)
        end, interval)
        return true
    end

    @ExecSpace("ServerOnly")
    method void CancelActiveEffects()
        self.EffectEpoch = self.EffectEpoch + 1
        if self.StormTimer ~= 0 then _TimerService:ClearTimer(self.StormTimer) end
        self.StormTimer = 0
        self.StormUntil = 0
        for id, _ in pairs(self.MistTimers) do _TimerService:ClearTimer(id) end
        self.MistTimers = {}
        local map = self.Entity.CurrentMap
        if isvalid(map) then
            for _, comp in ipairs(map:GetChildComponentsByTypeName("script.Projectile", true)) do
                if comp.Owner == self.Entity and isvalid(comp.Entity) then comp.Entity:Destroy() end
            end
        end
        self:ClearPersistentVisuals()
    end

    method void OnEndPlay()
        -- 서버 타격 타이머와 클라이언트 입자의 수명을 따로 정리한다.
        if self:IsServer() then
            if self.StormTimer ~= 0 then _TimerService:ClearTimer(self.StormTimer) self.StormTimer = 0 end
            for id, _ in pairs(self.MistTimers) do _TimerService:ClearTimer(id) end
            self.MistTimers = {}
        else self:ClearLocalVisuals() end
    end

    @ExecSpace("Multicast")
    method void ClearPersistentVisuals()
        -- 사망/이동에서는 남은 장판과 몸 주위 폭풍을 모두 지운다.
        self:ClearLocalVisuals()
    end

    @ExecSpace("ClientOnly")
    method void ClearLocalVisuals()
        -- 입자와 그 입자를 지울 예정이었던 타이머도 함께 해제한다.
        for serial, _ in pairs(self.MistVisuals) do _ParticleService:RemoveParticle(serial) end
        for serial, _ in pairs(self.DrainVisuals) do _ParticleService:RemoveParticle(serial) end
        for serial, _ in pairs(self.BlastVisuals) do _ParticleService:RemoveParticle(serial) end
        if self.StormVisual ~= 0 then _ParticleService:RemoveParticle(self.StormVisual) end
        for serial, _ in pairs(self.ClipVisuals) do _EffectService:RemoveEffect(serial) end
        if self.StormClip ~= 0 then _EffectService:RemoveEffect(self.StormClip) end
        self.ClipVisuals = {}
        self.StormClip = 0
        for _, timer in pairs(self.VisualTimers) do _TimerService:ClearTimer(timer) end
        self.MistVisuals = {}
        self.DrainVisuals = {}
        self.BlastVisuals = {}
        self.VisualTimers = {}
        self.StormVisual = 0
    end

    -- ───────── 저주·군령 ─────────

    @ExecSpace("ServerOnly")
    method boolean Curse(Vector2 target, string kind, number pct, number radius, number duration)
        -- 범위는 장비 「저주 범위 %」만큼 넓어진다. 범위 안에 적이 없으면 실패
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then radius = radius * (1 + stats.BonusCurse / 100 + 0.15 * self:Node("curse_area")) end   -- 장비 + 강화 「저주 범위」
        local list = self:Targets(target, radius)
        local foes = self:FoePlayers(target, radius)
        if #list == 0 and #foes == 0 then
            self:Fail("저주할 적이 범위 안에 없다")
            return false
        end
        for _, m in ipairs(list) do m:ApplyCurseFrom(kind, pct, duration, self.Entity) end
        for _, foe in ipairs(foes) do
            ---@type PlayerStats
            local fs = foe:GetComponent("script.PlayerStats")
            if fs ~= nil then fs:ApplyPvpCurse(kind, pct, duration * _GameData.pvpDurationMul, self.Entity) end
        end
        self:Fx(kind, Vector3(target.x, target.y, 0), radius)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean Lure(Vector2 target, number holdSeconds)
        -- 반경 3 안의 적을 조준점으로 세 번 끌어당긴 뒤 holdSeconds 묶는다 (보스·고유는 끌려오지 않고 짧게 묶인다)
        local list = self:Targets(target, 3)
        if #list == 0 then
            self:Fail("끌어올 적이 범위 안에 없다")
            return false
        end
        local epoch = self.EffectEpoch
        local map = self.Entity.CurrentMap
        local pull = function()
            for _, m in ipairs(self:Targets(target, 3.4)) do
                local to = target - _Util:Pos2(m.Entity)
                local status = m:Status()
                if status ~= nil and to:Magnitude() > 0.5 then status:Knockback(to, 0.9) end
            end
        end
        pull()
        for i = 1, 2 do
            _TimerService:SetTimerOnce(function()
                if epoch ~= self.EffectEpoch or self.Entity.CurrentMap ~= map then return end
                pull()
            end, 0.3 * i)
        end
        _TimerService:SetTimerOnce(function()
            if epoch ~= self.EffectEpoch or self.Entity.CurrentMap ~= map then return end
            for _, m in ipairs(self:Targets(target, 1.6)) do m:ApplyRoot(holdSeconds, self.Entity) end
        end, 0.75)
        self:Fx("lure", Vector3(target.x, target.y, 0), 3)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean BonePrison(Vector2 target, number seconds)
        -- 조준점 반경 1.3 안의 적을 뼈 장벽으로 묶는다 (이동만 막고 공격은 가능)
        local radius = 1.3 * (1 + 0.15 * self:Node("prison_wide"))   -- 강화 「넓은 감옥」
        local list = self:Targets(target, radius)
        local foes = self:FoePlayers(target, radius)
        if #list == 0 and #foes == 0 then
            self:Fail("가둘 적이 범위 안에 없다")
            return false
        end
        for _, m in ipairs(list) do m:ApplyRoot(seconds, self.Entity) end
        for _, foe in ipairs(foes) do
            ---@type PlayerStats
            local fs = foe:GetComponent("script.PlayerStats")
            if fs ~= nil then fs:ApplyRoot(seconds * _GameData.pvpDurationMul) end
        end
        self:Fx("prison", Vector3(target.x, target.y, 0), radius)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean SoulTorrent(Vector2 me, Vector2 target, number damage, integer count)
        -- 조준 방향 부채꼴로 유도 영혼 count발. 각자 가까운 적을 쫓아가 하나에 맞고 사라진다.
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        local base = math.atan(dir.y, dir.x)
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local launched = 0
        for i = 1, count do
            local spread = count > 1 and ((i - 1) / (count - 1) - 0.5) * math.rad(60) or 0
            local d = Vector2(math.cos(base + spread), math.sin(base + spread))
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "Soul_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            if isvalid(shot) then
                launched = launched + 1
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    proj.Homing = 5
                    proj:Skin(self.FxShardShot, 0.5)
                    proj:Launch(owner, d, 7, 7, damage, "skill.soul_torrent", false)
                    proj:Tint(Color(0.75, 0.6, 1, 1))
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        if launched == 0 then
            self:Fail("영혼을 날리지 못했다")
            return false
        end
        self:Fx("torrent", Vector3(me.x, me.y + 0.3, 0), 0.6)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean DeathWave(number damage)
        -- 내 주위 반경 3.5 전방위 파동. 범위에 적이 없어도 시전은 된다 (먼저 깔아 두는 용도)
        local p = _Util:Pos2(self.Entity)
        self:Hit(Vector2(p.x, p.y + 0.3), Vector2(3.5, 0), -1, "skill.death_wave", damage)
        self:Fx("wave", Vector3(p.x, p.y, 0), 3.5)
        self:ClipFx(self.FxWave, Vector3(p.x, p.y + 0.3, 0), 2.6, 0.6, 0)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean ShadowSacrifice(Vector2 target, number damage)
        -- 조준점에 가장 가까운 내 그림자 1기를 터뜨린다 (반경 1.8). 그림자는 죽은 것처럼 보관함으로 돌아가 재소환 대기
        local best = nil
        local bestDist = math.huge
        for _, unit in ipairs(self:Commander():GetUnits()) do
            if not unit.Dead and unit.Hp > 0 then
                local d = (_Util:Pos2(unit.Entity) - target):Magnitude()
                if d < bestDist then best = unit bestDist = d end
            end
        end
        if best == nil then
            self:Fail("희생할 그림자가 없다 — 그림자를 먼저 소환하세요")
            return false
        end
        local q = _Util:Pos2(best.Entity)
        local total = damage + best.Atk * 2
        self:Hit(Vector2(q.x, q.y + 0.2), Vector2(1.8, 0), -1, "skill.shadow_sacrifice", total)
        self:Fx("sacrifice", Vector3(q.x, q.y, 0), 1.8)
        self:Commander():OnUnitDied(best.ShadowId)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean ElitePromote(number multiplier)
        -- 소환 중인 그림자 중 공격력이 가장 높은 1기를 정예로 (한 번만). 정예는 동시에 1기 (강화 「정예 둘」이면 2기)
        local best = nil
        local promoted = 0
        for _, unit in ipairs(self:Commander():GetUnits()) do
            if unit.Promoted and not unit.Dead and unit.Hp > 0 then promoted = promoted + 1 end
            if not unit.Promoted and not unit.Dead and unit.Hp > 0 and (best == nil or unit.Atk > best.Atk) then best = unit end
        end
        local cap = 1 + self:Node("elite_twin")
        if promoted >= cap then
            self:Fail("정예는 동시에 " .. tostring(cap) .. "기까지" .. (cap == 1 and " — 강화 「정예 둘」로 2기" or ""))
            return false
        end
        if best == nil then
            self:Fail("승격할 그림자가 없다 — 그림자를 먼저 소환하세요")
            return false
        end
        best:Promote(multiplier)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean SummonShadow()
        -- 보관함에서 가장 강한 그림자 하나. 못 부르면 이유를 알린다
        local cmd = self:Commander()
        if cmd:DeployNext() > 0 then return true end
        self:Fail(cmd:DeployBlockReason())
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean Rally()
        -- 그림자·언데드를 곁으로. 따를 소환수가 없으면 실패
        if self:Commander():RallyAll() > 0 then return true end
        self:Fail("따라올 소환수가 없다")
        return false
    end

    -- ───────── 연출 (모든 클라이언트) ─────────

    @ExecSpace("Multicast")
    method void Fx(string kind, Vector3 pos, number radius)
        -- 다른 맵의 시전은 이 클라이언트에 그리지 않는다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local s = Vector3(radius, radius, 1)
        if kind == "poison" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, pos, 0, Vector3(radius, radius * 0.22, 1), false, { Color = Color(0.28, 0.55, 0.2, 0.28), ParticleCount = 12 })
        elseif kind == "drain" then
            -- 적의 혼 → 시전자의 회복을 작은 연결 궤적으로 보여 준다. 적 예고를 덮는 큰 붉은 구는 피한다.
            local from = pos + Vector3(0, 0.4, 0)
            local to = self.Entity.TransformComponent.WorldPosition + Vector3(0, 0.4, 0)
            for i = 0, 4 do
                local t = i / 4
                local point = from * (1 - t) + to * t
                local endpoint = i == 0 or i == 4
                local particle = endpoint and BasicParticleType.ChargeOrb or BasicParticleType.SparkExplosion
                local size = endpoint and 0.3 or 0.18
                local color = i == 4 and Color(0.3, 0.65, 0.45, 0.85) or Color(0.5, 0.35, 0.65, 0.85)
                local serial = _ParticleService:PlayBasicParticle(particle, self.Entity, point, 0, Vector3(size, size, 1), false, { Color = color })
                if serial ~= 0 then
                    self.DrainVisuals[serial] = true
                    self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                        _ParticleService:RemoveParticle(serial)
                        self.DrainVisuals[serial] = nil
                        self.VisualTimers[serial] = nil
                    end, 0.65)
                end
            end
        elseif kind == "storm" then
            if self.StormVisual ~= 0 then
                _ParticleService:RemoveParticle(self.StormVisual)
                local oldTimer = self.VisualTimers[self.StormVisual]
                if oldTimer ~= nil then _TimerService:ClearTimer(oldTimer) self.VisualTimers[self.StormVisual] = nil end
            end
            local serial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.SpinField, self.Entity, Vector3(0, 0.3, 0), 0, s * 0.55, true, { Color = Color(0.65, 0.6, 0.5, 0.45) })
            self.StormVisual = serial
            if serial ~= 0 then
                self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                    _ParticleService:RemoveParticle(serial)
                    self.VisualTimers[serial] = nil
                    if self.StormVisual == serial then self.StormVisual = 0 end
                end, 6)
            end
        elseif kind == "amp" then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = Color(0.7, 0.2, 1, 1) })
        elseif kind == "weaken" then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = Color(0.3, 0.6, 0.3, 1) })
        elseif kind == "thorn" or kind == "terror" or kind == "confuse" or kind == "lifetap" or kind == "decay" or kind == "resist" then
            -- 저주마다 색을 달리해 무엇을 걸었는지 바로 구분한다 (머리 위 아이콘과 같은 계열)
            local colors = { thorn = Color(0.95, 0.45, 0.2, 1), terror = Color(0.35, 0.1, 0.45, 1), confuse = Color(1, 0.85, 0.3, 1),
                lifetap = Color(0.9, 0.15, 0.25, 1), decay = Color(0.55, 0.45, 0.3, 1), resist = Color(0.3, 0.85, 1, 1) }
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = colors[kind] })
        elseif kind == "plague" then
            -- 역병 저주: 죽은 적 자리에서 초록 고리가 퍼진다
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos + Vector3(0, 0.2, 0), 0, Vector3(radius * 0.4, radius * 0.4, 1), false, { Color = Color(0.45, 0.9, 0.35, 0.85) })
        elseif kind == "lure" then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s * 0.6, false, { Color = Color(0.6, 0.3, 0.9, 1) })
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos, 0, Vector3(0.5, 0.5, 1), false, { Color = Color(0.7, 0.45, 1, 0.9) })
        elseif kind == "prison" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.2, 0), 0, Vector3(radius * 0.45, radius * 0.3, 1), false, { Color = Color(0.85, 0.8, 0.68, 0.95) })
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = Color(0.85, 0.8, 0.65, 1) })
        elseif kind == "torrent" then
            _ParticleService:PlayBasicParticle(BasicParticleType.ChargeOrb, self.Entity, pos, 0, Vector3(0.35, 0.35, 1), false, { Color = Color(0.65, 0.5, 1, 0.9) })
        elseif kind == "wave" then
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos + Vector3(0, 0.3, 0), 0, Vector3(radius * 0.5, radius * 0.5, 1), false, { Color = Color(0.55, 0.35, 0.8, 0.9) })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(radius * 0.35, radius * 0.15, 1), false, { Color = Color(0.5, 0.45, 0.55, 0.8) })
        elseif kind == "sacrifice" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.3, 0), 0, Vector3(radius * 0.4, radius * 0.4, 1), false, { Color = Color(0.6, 0.3, 1, 1) })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(radius * 0.35, radius * 0.18, 1), false, { Color = Color(0.35, 0.2, 0.5, 0.8) })
        end
    end

    @ExecSpace("Multicast")
    method void BlastFx(Vector3 pos, number radius, string mapId)
        -- 혼의 파열과 뼛가루를 낮게 펼친다. 연출 중심은 실제 피해 중심과 같다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not _Util:IsAlive(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap or self.Entity.CurrentMap.Id ~= mapId then return end
        local parts = {
            { particle = BasicParticleType.DustExplosion, scale = Vector3(radius * 0.4, radius * 0.18, 1) },
            { particle = BasicParticleType.SparkRadialExplosion, scale = Vector3(radius * 0.3, radius * 0.16, 1), tint = Color(0.78, 0.73, 0.62, 0.8) }
        }
        local played = false
        for _, part in ipairs(parts) do
            local serial = _ParticleService:PlayBasicParticle(part.particle, self.Entity, pos, 0, part.scale, false, part.tint ~= nil and { Color = part.tint } or nil)
            if serial ~= 0 then
                played = true
                self.BlastVisuals[serial] = true
                self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                    _ParticleService:RemoveParticle(serial)
                    self.BlastVisuals[serial] = nil
                    self.VisualTimers[serial] = nil
                end, 0.55)
            end
        end
        if played then self.BlastFxCount = self.BlastFxCount + 1 end
    end

    @ExecSpace("Multicast")
    method void MistFx(Vector3 pos, number radius, number seconds)
        -- 남는 독안개: 반복 입자를 seconds 동안 틀고 끈다. 맵 이탈 시 타이머도 해제한다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        -- 상승 연기 대신 낮은 회전 장판: 적의 몸과 공격 예고를 덮지 않는다.
        -- 같은 시전자의 장판은 최대 3개만 표시하고 오래된 입자/타이머를 함께 해제한다.
        local count = 0
        local oldest = 0
        local oldestUntil = math.huge
        for id, untilAt in pairs(self.MistVisuals) do
            count = count + 1
            if untilAt < oldestUntil then oldest = id oldestUntil = untilAt end
        end
        -- 독이 깔린 범위를 분명히 보이게 (예전 투명도 0.28은 어두운 바닥에서 거의 안 보였다)
        local s = Vector3(radius, radius * 0.3, 1)
        local serial = _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, pos, 0, s, true, { Color = Color(0.35, 0.85, 0.25, 0.55), ParticleCount = 22 })
        if serial == 0 then return end
        if count >= 3 and oldest ~= 0 then
            _ParticleService:RemoveParticle(oldest)
            self.MistVisuals[oldest] = nil
            local timer = self.VisualTimers[oldest]
            if timer ~= nil then _TimerService:ClearTimer(timer) self.VisualTimers[oldest] = nil end
        end
        self.MistVisuals[serial] = _UtilLogic.ElapsedSeconds + seconds
        self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
            if self.MistVisuals[serial] then
                _ParticleService:RemoveParticle(serial)
                self.MistVisuals[serial] = nil
            end
            self.VisualTimers[serial] = nil
        end, seconds)
    end

end
