-- 스킬 효과 구현 (SkillBook이 습득·마나·쿨다운을 확인한 뒤 Apply로 넘긴다). 스킬 하나 = 메서드 하나.
-- 타격 판정은 플레이어의 PlayerAttack(같은 엔티티에 AttackComponent는 하나만)을 빌려 HitEvent 경로로 보낸다.
-- 피해 공식: 기본 + 레벨당 증가 × 주문력. 속성은 PlayerAttack.SkillElement가 정한다.
@Component
script SkillEffects extends Component

    property integer StormTimer = 0
    property number StormUntil = 0

    @ExecSpace("ServerOnly")
    method boolean Apply(string id, integer lv, Vector2 me, Vector2 target, number spell)
        -- 구현된 스킬이면 true
        if id == "bone_shard" then self:BoneShard(me, target, (10 + 6 * (lv - 1)) * spell)
        elseif id == "poison_mist" then self:PoisonMist(target, (4 + 2 * lv) * spell)
        elseif id == "corpse_blast" then self:CorpseBlast(target, (30 + 12 * (lv - 1)) * spell)
        elseif id == "soul_drain" then self:SoulDrain(target, (15 + 8 * lv) * spell)
        elseif id == "bone_storm" then self:BoneStorm((8 + 4 * lv) * spell)
        elseif id == "mark_weakness" then self:Curse(target, "amp", 30 + 3 * lv, 1.5)
        elseif id == "enfeeble" then self:Curse(target, "weaken", 35, 1.5)
        elseif id == "elite_promote" then self:ElitePromote()
        elseif id == "shadow_summon" then return self:Commander():DeployNext() > 0
        elseif id == "rally" then self:Commander():RallyAll()
        elseif id == "raise_skeleton" then return _UndeadSystem:Raise(self.Entity, "skeleton", lv, target, nil)
        elseif id == "raise_mage" then return _UndeadSystem:Raise(self.Entity, "mage", lv, target, nil)
        elseif id == "revive" then return _UndeadSystem:Raise(self.Entity, "revive", lv, target, nil)
        else return false end
        return true
    end

    method ShadowCommander Commander()
        ---@type ShadowCommander
        local c = self.Entity:GetComponent("script.ShadowCommander")
        return c
    end

    @ExecSpace("ServerOnly")
    method void Hit(Vector2 center, Vector2 size, number angle, string info, number damage)
        -- angle < 0 이면 원(반지름 size.x), 아니면 회전 사각형
        ---@type PlayerAttack
        local atk = self.Entity:GetComponent("script.PlayerAttack")
        if atk ~= nil then atk:SkillAttack(center, size, angle, info, damage) end
    end

    @ExecSpace("ServerOnly")
    method table Targets(Vector2 center, number radius)
        return _Util:MonstersNear(self.Entity.CurrentMap, center, radius)
    end

    -- ───────── 혼술 ─────────

    @ExecSpace("ServerOnly")
    method void BoneShard(Vector2 me, Vector2 target, number damage)
        -- 조준 방향 5칸 직선, 관통
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        local len = 5
        local angle = math.deg(math.atan(dir.y, dir.x))
        if angle < 0 then angle = angle + 360 end
        self:Hit(me + dir * (len / 2) + Vector2(0, 0.3), Vector2(len, 0.6), angle, "skill.bone_shard", damage)
        self:LineFx(me + Vector2(0, 0.3), dir, len)
    end

    @ExecSpace("ServerOnly")
    method void PoisonMist(Vector2 target, number dps)
        -- 반경 1.3, 4초 독
        for _, m in ipairs(self:Targets(target, 1.3)) do m:ApplyPoison(dps, 4, self.Entity) end
        self:Fx("poison", Vector3(target.x, target.y, 0), 1.3)
    end

    @ExecSpace("ServerOnly")
    method void CorpseBlast(Vector2 target, number damage)
        -- 조준점 근처(1.5) 내 혼 하나를 소모해 반경 1.6 폭발. 피해는 원본 등급에 비례 (혼은 추출·해골·되살림과 배타)
        ---@type SoulOrb
        local orb = _Util:NearestComponent(self.Entity.CurrentMap, "script.SoulOrb", target, 1.5)
        if orb == nil or orb.Consumed or orb.OwnerUserId ~= self.Entity.PlayerComponent.UserId then
            _Util:Notify("근처에 혼이 없다", self.Entity.PlayerComponent.UserId)
            return
        end
        local q = orb.Entity.TransformComponent.WorldPosition
        self:Hit(Vector2(q.x, q.y + 0.2), Vector2(1.6, 0), -1, "skill.corpse_blast", damage * orb.Grade)
        self:Fx("blast", q, 1.6)
        orb:Consume()
    end

    @ExecSpace("ServerOnly")
    method void SoulDrain(Vector2 target, number damage)
        -- 가장 가까운 적 하나의 생명을 흡수 → 피해의 50% 회복, 소환수도 30% 회복 (마법)
        local m = self:Targets(target, 1.5)[1]
        if m == nil then return end
        damage = damage * math.max(0, 1 - m:GetResist("magic") / 100)
        m:TakeDamage(damage, self.Entity)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then stats:Heal(damage * 0.5, 0) end
        for _, unit in ipairs(self:Commander():GetUnits()) do unit.Hp = math.min(unit.MaxHp, unit.Hp + damage * 0.3) end
        self:Fx("drain", m.Entity.TransformComponent.WorldPosition, 0.8)
    end

    @ExecSpace("ServerOnly")
    method void BoneStorm(number damage)
        -- 6초 동안 0.5초마다 주위 반경 1.2
        self.StormUntil = _UtilLogic.ElapsedSeconds + 6
        self:Fx("storm", self.Entity.TransformComponent.WorldPosition, 1.2)
        if self.StormTimer ~= 0 then return end
        self.StormTimer = _TimerService:SetTimerRepeat(function()
            if _UtilLogic.ElapsedSeconds > self.StormUntil or not isvalid(self.Entity) then
                _TimerService:ClearTimer(self.StormTimer)
                self.StormTimer = 0
                return
            end
            local p = _Util:Pos2(self.Entity)
            self:Hit(Vector2(p.x, p.y + 0.3), Vector2(1.2, 0), -1, "skill.bone_storm", damage)
        end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.StormTimer ~= 0 then _TimerService:ClearTimer(self.StormTimer) end
    end

    -- ───────── 저주·군령 ─────────

    @ExecSpace("ServerOnly")
    method void Curse(Vector2 target, string kind, number pct, number radius)
        -- 범위는 장비 「저주 범위 %」만큼 넓어진다. 8초
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then radius = radius * (1 + stats.BonusCurse / 100) end
        for _, m in ipairs(self:Targets(target, radius)) do m:ApplyCurse(kind, pct, 8) end
        self:Fx(kind, Vector3(target.x, target.y, 0), radius)
    end

    @ExecSpace("ServerOnly")
    method void ElitePromote()
        -- 소환 중인 그림자 중 공격력이 가장 높은 1기를 정예로 (한 번만)
        local best = nil
        for _, unit in ipairs(self:Commander():GetUnits()) do
            if not unit.Promoted and (best == nil or unit.Atk > best.Atk) then best = unit end
        end
        if best ~= nil then best:Promote() end
    end

    -- ───────── 연출 (모든 클라이언트) ─────────

    @ExecSpace("Multicast")
    method void Fx(string kind, Vector3 pos, number radius)
        local s = Vector3(radius, radius, 1)
        if kind == "poison" then
            _ParticleService:PlayBasicParticle(BasicParticleType.RisingSteam, self.Entity, pos, 0, s, false, { Color = Color(0.4, 1, 0.3, 1) })
        elseif kind == "blast" then
            _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, self.Entity, pos, 0, s * 0.6, false, nil)
        elseif kind == "drain" then
            _ParticleService:PlayBasicParticle(BasicParticleType.ChargeOrb, self.Entity, pos, 0, s, false, { Color = Color(1, 0.2, 0.3, 1) })
        elseif kind == "storm" then
            _ParticleService:PlayBasicParticleAttached(BasicParticleType.SpinField, self.Entity, Vector3(0, 0.3, 0), 0, s, false, nil)
        elseif kind == "amp" then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = Color(0.7, 0.2, 1, 1) })
        elseif kind == "weaken" then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = Color(0.3, 0.6, 0.3, 1) })
        end
    end

    @ExecSpace("Multicast")
    method void LineFx(Vector2 from, Vector2 dir, number len)
        for i = 1, 5 do
            local p = from + dir * (len * i / 5)
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, Vector3(p.x, p.y, 0), 0, Vector3(0.3, 0.3, 1), false, nil)
        end
    end

end
