    property string FxGiantFireMeteor = "2384add09c94496fa5e69cc79577b166|4c4f6e2e26a84e2d8751ac1d4d6bb702|4de31d45fd6a4e48a521e108bae803aa|d47a296a7f1b4ed0b5b4cee006eef141|92a62312cd2e4b849a125ca02851480f|691eb3813c844076ae5f347344b32aec|8d09ca1fc0f84ca08fe72862de9be656|d748c8e984274f2f9c8027a3238b96a6|99c2cee23dad4469a1034d7468f49d39|7636aaaf7fcf4a48b78a79251bb24324|26596dd3d2c6412db7a1623fa9624aff|ac1da1d9d7f84f3fbd7873bc0aad0491"   -- 48 기도 메테오 · 10-31 갈래 F B 전체 프레임 (assets/codex-bone-giants-v1/prerender-B-full-20261031 · upload-full216): 12장 256×256 · 피벗 0.5/0.125 = 착지점 (128,224) · 0~5 낙하 · 6~11 착지·그을림 (FxGiantFireMeteorOpts impact 7) · 반경 2.0 = 4칸 기준
    property string FxGiantFireMeteorOpts = "w=256;h=256;ref=4.0;impact=7;ms=50,50,50,50,50,50,50,50,50,50,50,50"   -- B 메테오 계약: impact 7(index 6) 앞 = 낙하(fall 동안 · 마지막 낙하 장 유지) · 뒤 = 착지(scorch 동안 마지막 장 유지) · 장별 50ms · 비면 옛 6장 규칙(1~2 낙하 · 3~6 착지)
    property string FxGiantRoar = "082052d1846343ec93754a882ebe6d94"   -- 48 방패 도발 함성 고리 1장 64×32 (머리 위)
    property string FxGiantFlurry = "5f2f33dd813b4d069003f9f4d36ae531|74e8e23d6d444d57ae6813ba6ceff73c|f6c297b3193f41d2b02e2cdd66b6a151|8437905089a744e7b8c7764c1a036c61|931046d07df74d43bc38e6fc5f7f88ee|ec1d4df6f74446c7af96a6266974c05a|e6164623330d45dab26507ffddb35690|d26973471805466f8afa9ca0247aa841|6b57a2295a384497b0d548727b944924|c1aa87c27e5f48baa3af720002fd3886|8c2206cda87149d4828d828b0f451b75|ea16a49783564b3cac2a03a8fdc74963"   -- 48 쌍칼 연속 베기 X · 10-31 갈래 F B 전체 프레임 (assets/codex-bone-giants-v1/prerender-B-full-20261031 · upload-full216): 12장 192×192 (호출 = RiteGiantMoves 연속 베기 실제 타격 접점 · 접점 = 그림 (96,64) 그대로)
    property string FxGiantFlurryOpts = "w=192;h=192;ms=30,30,30,30,30,30,30,30,30,30,30,30"   -- B X 베기 계약: 장별 30ms (타격마다 한 번 · 0.36초) · 비면 옛 규칙(max(0.04, gap/장 수))
    property string FxGiantDashSeq = "28b2c6e7618841ab8c702439fbcf5cef|82b8d4b47e144192bced766e70bb566c|47505802c9504b228b212e6321be986f|bc1ce03cff4048faaa60fcbe66ddf1a5|9bf1da4880194bf78bd2ad7d8b109325|47f24c98af564ad191324242b472666d|8a803ab98a9845dabeb9e5f7597629d8|e6c9752e48af45df8f1a28fb1059440e|bd5c2cdc89c449e99591bcfe65ee351c|7e1ab51269724bc9b7e588d4a339cb5b|831b5f3c94394e1695958d3bfeb930ce|2958e213c1a44315a1f29b93364a9625"   -- 쌍칼 돌진 자취 · 10-31 갈래 F B 전체 프레임 (assets/codex-bone-giants-v1/prerender-B-full-20261031 · upload-full216): 12장 256×96 · 피벗 1.0/0.5 = 시전 시작점 · 그림 앞쪽(머리) = -x (기본 왼쪽) — 비면 GameConst.FxGiantDash(48 연속본 4장)
    property string FxGiantDashOpts = "w=256;h=96;px=0;rev=true;upright=true;ms=25,25,25,25,25,25,25,25,25,25,25,25"   -- B 돌진 계약: 피벗을 시작점에(px 0) · 그림 -x가 돌진 방향(rev = 각 +180) · 세운 채 좌우만(upright · FlipX) · 길이·폭으로 늘임(stretch) · 장별 25ms
    -- 48 연출 V2 (10-30 사용자 영상 피드백 · 갈래 B): 새 연속본 자리 — 비면 지금 그림(GameConst.FxGiantSpin·Rift·Slam · FxGiantRoar) 그대로. 「|」로 이은 RUID (장 수 제한 없음 · 같은 캔버스·피벗)
    --   *Opts = 「키=값;…」 그림 계약 (w·h = 원본 px · ref = 그림이 그려진 세계 지름(칸 · 56px=1칸) · impact = 타격 순간 칸(1부터) · span = 한 번 재생 길이(초) · sec = 고정 장 간격 · order = 1 몸 뒤 / 6 몸 앞 ·
    --     ax·ay = 앵커(접점) 위치 = 부르는 자리(거인 발 · 오른쪽 볼 때) + (ax × 방향, ay) 칸 · dy = ay와 같음(옛 이름) · face = 그림이 그려진 방향 right/left · flip = 거인 방향에 맞춰 좌우 뒤집기(true/false · 상하 뒤집기는 없음))
    property string FxGiantNovaOpts = "impact=6"   -- 노바 단일 폭발: impact 칸이 서버 타격 순간(폭발 시작 + burst 0.18초)에 오게 장 간격을 정하고 그 칸이 가장 진함 (지금 6장 = 마지막 장 최대 반경 · 새 16장은 「w=…;h=…;ref=7.5;impact=5」 식)
    -- 노바 V2 새 아트 (정본 assets/codex-bone-giants-v1/spectacle-v2-20261030 resource-mapping·world-registration-conditions · 16장 · 키 fx-giant-nova-v2-00..15 순서 · 캔버스 640×512 · 원점 (320,320) = 피벗 0.5/0.375 · 56px=1칸 · 내용 지름 420px = 7.5칸 →
    --   스프라이트 월드 11.43×9.14칸 · 장별 시간 ms 그대로 · 정점 7번째 장(index 6) = 160ms = 서버 타격 · 단발 · 둘째 파동 없음). RUID는 부모 통합 때 키 순서대로 채운다:
    --   FxGiantNovaV2 = layers/rear 16장(바닥 광선·외곽 파편 · 배우 뒤) · FxGiantNovaV2Front = layers/front 16장(작은 중앙 타원·흰 섬광 · 배우 앞) — 앞 층이 비면 FxGiantNovaV2에 원본 png/fx 16장을 넣어 한 층(몸 뒤)으로
    property string FxGiantNovaV2 = "065e1c5c5587491d813c2d7ec734103d|67f8b7a7c1e745f6a04a742494b910e4|57181bf81af34062b3a3fe35027d8de7|42cc71c6c2c54bff8a15503152c57e7c|4a48b86551c64fedbf7831459653c28b|e70f4e31d32f4a198e75d22e3027f8b7|5b207d8afe284e4ea3fb7430b2605d44|9418d56db9c04f798f9530bf300f1f05|47175530ab9f4b9db40fe93f16a31c50|349e5065016e453e9b072de2d053e3ba|ae01d75706244cbbbed3a47a353ea3b6|315e76122f4f4b63b5a10bd653b90015|ca6940309e14431a94eb89725a4cbca9|73fda76720b2482a9500df2eb0cc6430|fe7b3c50d4444db59beb3f3a02808b93|87118ed52ae748d2bb5443425bbc9b2b"   -- 48 V2 노바 자리 · 10-31 갈래 F B 전체 프레임 (assets/codex-bone-giants-v1/prerender-B-full-20261031 · upload-full216): 원본 png/fx 16장 한 층(몸 뒤 · B는 앞/뒤 파생 층 없음) · 640×512 · 피벗 0.5/0.375 · FxGiantNovaV2Opts 그대로(장별 ms 동일 · impact 7 = 160ms · 반경 3.75 · 단발)
