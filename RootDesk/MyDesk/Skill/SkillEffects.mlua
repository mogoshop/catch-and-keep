    property number ArmorArtDy = 0.45           -- 몸 가운데 = 발 + 0.45칸 (PlayerStats.ArmorRingDy와 같은 자리)
    property integer ArmorCastOrder = 5         -- 몸 앞 (예전 시전 입자와 같은 층)
    property string CurseCircleFitPx = "amp=58.5;weaken=56.7;terror=62.2;thorn=57.7;lifetap=55.5;resist=58.7"   -- 원형 판의 보이는 반경(px · 캔버스 가운데에서 알파>16 화소까지 가장 먼 거리 · 4장 중 최대 · 10-31 실측) → 이 반경 = 저주 반경 (CurseSigilFitPx와 같은 계산)
    property number CurseCircleHoldSec = 0.3    -- 원형 판 마지막 장 추가 유지 (문장 CurseSigilHoldSec와 같은 값)
    property number CurseCircleFadeSec = 0.3    -- 그 뒤 옅어짐
    property integer DashGhostCopies = 3        -- 망령 질주 잔상 복사본 수: 떠난 자리 → 도착 쪽 길 위 0 · 1/3 · 2/3 (도약 강화면 도착 자리 하나 더)
    property number DashGhostStepSec = 0.05     -- 복사본 사이 시차 (질주 0.16초 동안 몸이 지나간 순서대로 뜬다)
    property number DashGhostScale = 1.0        -- 128px = 1.28칸 · 보이는 형체 89~112×55~71px · 피벗 0.5/0.1 = 발
    property integer DashGhostOrder = 3         -- MapLayer0 3 (바닥 위 · 예전 섬광은 엔진 기본 층)
    property number RiteWhirlContentPx = 235    -- 뼈 회오리 8장 내용 폭 최대(px · 알파>16 · 256px 캔버스) → 이 폭 = 판정 지름 2×riteWhirlRadius
    property number RiteWhirlTraceContentPx = 240   -- 바닥 자국 내용 폭(px) → 이 폭 = 판정 지름
    property integer RiteWhirlOrder = 5         -- 회오리: 몸 앞 (뼈 폭풍 도는 골편 아래 반원과 같은 층)
    property integer RiteWhirlTraceOrder = 1    -- 바닥 자국: 바닥(0)과 몸(2) 사이
    property number RiteWhirlTraceFadeSec = 0.4 -- 자국이 옅어지는 시간 (회오리 시간 끝에 맞춘다)
    property number RiteArrowScale = 1.2        -- 의식 뼈 화살 4장 배율: 보이는 몸 93~94px → 1.13칸 (예전 보라 궤적 1.1배 = 꼬리 포함 1.96×0.61칸)
    property number RiteArrowLastMul = 1.25     -- 마지막 발(밀침) 한 단 크게 (예전 1.38/1.1)
    property number DustScale = 1.1             -- 소모 해골 뼛가루 배율(옛 ClipFx 0.5 기준): 96px 캔버스 1.06칸 (옛 보라 파열 1.14칸)
    property number DustDy = 0.3                -- 해골 발에서 그림 가운데까지 (코덱스 「ground_below_actor_at_feet」 · 가운데 피벗이라 위로) · 예전 +0.4
    property number DrainVortexScale = 0.8      -- 생기 앗기 소용돌이 배율: 128px = 1.02칸 · 내용 78~112px = 0.62~0.9칸 (예전 FxDrain 0.6)
    property number DrainVortexSec = 0.7        -- 소용돌이 반복 시간 (예전 ClipFx 0.7초)
    property number TorrentCastArtScale = 0.8   -- 영혼 격류 시전 4장 배율: 내용 79~112px = 0.63~0.9칸 (예전 혼 구슬 입자 0.6)
    -- 10-31 메이플 원본 교체 C 7종 (GameConst.FxSkillBlast·OfferingHeal·DeathWave·PoisonCloud — 투사체 2종은 MageBolts · 베기는 Util.SkillSlashFx): 그림 칸을 비우면 예전 메이플 원본 ClipFx 그대로
    --   크기 = 예전 클립의 보이는 폭에 맞춤: 새 배율 = 예전 배율 × C7OldW(예전 클립 배율 1일 때 폭 · audit skillfx-inventory 「크기w칸」 ÷ 코드 배율) ÷ C7FitPx(새 그림 내용 폭 · 알파>16 · 4장 중 최대)
    --   자리 = 발(지면 원점 · 피벗 0.5/0.25 = 그림 root) — 예전 클립은 가운데 피벗이라 발 + 0.2~0.5칸에 놓았다 (C7Clip이 예전 길에만 그 높이를 더한다)
    property string C7OldW = "blast=4.333;offering=1.327;wave=2.45;poison=2.144"   -- 예전 클립 배율 1의 폭(칸): FxBlast 3.25/0.75 (P38 · P36 1.95/0.45도 같음) · FxOffering 1.46/1.1 (P35) · FxWave 6.37/2.6 (P29) · FxPoisonCloud 2.68/1.25 (P12)
    property string C7FitPx = "blast=183;offering=183;wave=243;poison=244"   -- 새 그림 내용 폭 최대(px · 알파>16 · 10-31 실측): 폭발 01 183×123 · 성찬 02 183×127 · 파동 02 243×153 · 독 구름 02 244×134
    property string C7Orders = "blast=1;offering=1;wave=1;poison=1"   -- 층 MapLayer0 (1 = 바닥과 몸 사이 · 코덱스 합성판 기본 「behind」 · 몸 앞은 foreground-stress 판) — 메이커에서 다시 볼 값
    property number C7HoldSec = 0.2             -- 한 번 계열(폭발·성찬·파동) 마지막 장 유지 (100ms 대신 0.2초)
    property number C7FadeSec = 0.25            -- 그 뒤 옅어짐 → 0.3 + 0.2 + 0.25 = 0.75초 (4장 0.4초만이면 예전 클립 0.6~1.2초보다 짧다 — 「짧아서 안 보임」 반복 지적)

    @ExecSpace("ServerOnly")
    method boolean Apply(string id, integer lv, Vector2 me, Vector2 target, number spell)
        -- 효과가 실제로 났으면 true. false면 SkillBook이 마나·쿨다운을 쓰지 않는다 (실패 이유는 각 효과가 알린다)
        local ok = false
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return false end
        local power = book:GetEffectPower(id, lv)
        local duration = book:GetCurseDuration(lv)   -- 저주 지속 (레벨이 오를수록 길어진다)
        power = power * book:GetCursePowerMult(id)   -- 수치형 저주: 강화 「깊은 저주」 + 장비 「저주 효과 %」
        if id == "bone_shard" then ok = self:BoneShardVolley(me, target, power * spell, book:GetBoneShardCount(lv), nil, nil, nil)
        elseif id == "poison_mist" then ok = self:PoisonMist(target, power * spell)
        elseif id == "bone_armor" then ok = self:BoneArmor(power)
        elseif id == "bone_spear" then ok = self:BoneSpear(me, target, power * spell)
        elseif id == "hex_flame" then ok = self:HexFlame(me, target, power * spell, 1 + self:Node("flame_twin"))
        elseif id == "frost_soul" then ok = self:FrostSoul(me, target, power * spell)
        elseif id == "bone_offering" then ok = _UndeadSystem:BoneOffering(self.Entity, power * (1 + 0.2 * self:Node("offering_heal")), 4 * (1 + 0.25 * self:Node("offering_wide")), 10 * self:Node("offering_frenzy"))
        elseif id == "wraith_dash" then ok = self:WraithDash(me, target)
        elseif id == "soul_drain" then ok = self:SoulDrain(target, power * spell)
        elseif id == "bone_storm" then ok = self:BoneStorm(power * spell)
        elseif id == "mark_weakness" then ok = self:Curse(target, "amp", power, 1.5, duration)
        elseif id == "enfeeble" then
            -- 강화 「쇠퇴」(10-28 쇠퇴 스킬을 합침): 같은 자리 적에게 쇠퇴(이동·공격 −8%/랭크)도 건다
            local decayRank = self:Node("enfeeble_decay")
            local list = decayRank > 0 and self:CurseTargets(target, 1.5) or nil
            ok = self:Curse(target, "weaken", power, 1.5, duration)
            if ok and list ~= nil then for _, m in ipairs(list) do m:ApplyCurseFrom("decay", 8 * decayRank * book:GetCursePowerMult("enfeeble"), duration, self.Entity) end end
        elseif id == "thorn_curse" then ok = self:Curse(target, "thorn", power, 1.5, duration)
        elseif id == "terror" then
            -- 강화 「광란」(10-28 혼란 스킬을 합침): 공포가 끝나면 그 적들이 1.5초(+0.5초/랭크) 혼란
            -- 도주 초에도 「저주 지속」·장비 저주 지속·선택 보상 「긴 저주」를 붙인다 (44 §3-3 — 지속 자리에 도주 초를 그대로 넘겨 「모든 저주 지속」이 안 먹었다)
            local terrorSec = book:CurseDurationWithMods(power)
            local frenzy = self:Node("terror_frenzy")
            local list = frenzy > 0 and self:CurseTargets(target, 1.5) or nil
            ok = self:Curse(target, "terror", 0, 1.5, terrorSec)
            if ok then log(string.format("[VRF] terror sec base=%.2f mods=%.2f", power, terrorSec)) end
            if ok and list ~= nil then self:AfterTerror(list, terrorSec, 1 + 0.5 * frenzy) end
        elseif id == "life_tap" then ok = self:Curse(target, "lifetap", power, 1.5, duration)
        elseif id == "resist_break" then ok = self:Curse(target, "resist", power, 1.5, duration)
        elseif id == "bone_prison" then ok = self:BonePrison(target, power)
        elseif id == "soul_torrent" then ok = self:SoulTorrent(me, target, power * spell, book:GetTorrentCount(lv))
        elseif id == "death_wave" then ok = self:DeathWave(power * spell)
        elseif id == "shadow_sacrifice" then ok = self:ShadowSacrifice(target, power * spell)
        elseif id == "elite_promote" then ok = self:ElitePromote(power)
        elseif id == "shadow_summon" then ok = self:SummonShadow()
        elseif id == "rally" then ok = self:Rally()
        elseif id == "raise_skeleton" then ok = _UndeadSystem:Raise(self.Entity, "skeleton", lv, target, nil, nil)
        elseif id == "raise_mage" then ok = _UndeadSystem:Raise(self.Entity, "mage", lv, target, nil, nil) end
        -- 뼈 의식(10-29, 해골 폭탄 병합)은 단계가 있어 SkillBook.CastRite → UndeadSystem.SkeletonBomb / BoneRite로 따로 간다
        if not ok then log("[SkillEffects] " .. id .. " 효과 없음 → 마나·쿨다운 보존") end
        return ok
    end

    method integer PierceCap(string id)
        -- 관통 투사체 한 발의 최대 적 수 (SkillBook.GetPierceCap, 장비 스킬 레벨 포함)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 1 end
        return book:GetPierceCap(book:GetPowerLevel(id))
    end

    method integer ChoiceTier(integer slot, string axis)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        return book ~= nil and book:ChoiceTier(slot, axis) or 0
    end

    method integer Node(string id)
        -- 강화 노드 랭크 (docs/design/16)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 0 end
        return book:Node(id)
    end

    @ExecSpace("ServerOnly")
    method void Fail(string reason)
        -- 시전 실패 안내 (마나·쿨다운은 쓰지 않는다)
        _Util:Warn(reason, self.Entity.PlayerComponent.UserId)
    end

    method ShadowCommander Commander()
        ---@type ShadowCommander
        local c = self.Entity:GetComponent("script.ShadowCommander")
        return c
    end

    @ExecSpace("ServerOnly")
    method void Hit(Vector2 center, Vector2 size, number angle, string info, number damage)
        -- angle < 0 이면 원(반지름 size.x), 아니면 회전 사각형
        ---@type PlayerAttack
        local atk = self.Entity:GetComponent("script.PlayerAttack")
        if atk ~= nil then atk:SkillAttack(center, size, angle, info, damage) end
    end

    @ExecSpace("ServerOnly")
    method table Targets(Vector2 center, number radius)
        return _Util:MonstersNear(self.Entity.CurrentMap, center, radius)
    end

    @ExecSpace("ServerOnly")
    method table FoePlayers(Vector2 center, number radius)
        -- 결투 상대 플레이어가 반경 안에 있으면 { 엔티티 } (저주·독안개·흡수·감옥이 플레이어에게도 — 지속은 몬스터의 PvpDurationMul배)
        return _Util:DuelFoesNear(self.Entity, self.Entity.CurrentMap, center, radius, true)
    end

    -- ───────── 혼술 ─────────

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 내 캐릭터면 스킬 애니메이션을 투명하게 한 번씩 틀어 미리 불러 둔다 (처음 쓸 때 불러오느라 짧은 연출이 안 보였다)
        if self.Entity ~= _UserService.LocalPlayer then return end
        local list = { self.FxShardShot, self.FxShardLaunch, self.FxShardHit, self.FxBlast, self.FxFlameShot, self.FxFrostShot, self.FxOffering, self.FxBlink, self.FxPoisonCloud, self.FxDrain, self.FxStorm, self.FxWave, _GameConst.FxAriseRing, _GameConst.FxAriseFlame, _GameConst.FxAriseBurst }
        -- 10-31 갈래 E: 새로 연결한 코덱스 스킬 그림(저주 불꽃 폭발·파쇄·솟음·승격·뼈 폭풍 각 장 + 저주 바닥 문장 6종 × 4장)도 처음 쓸 때 늦게 뜨지 않게
        --   10-31 골편 20장: 골편 투척·폭풍 골편·중립 뼈 화살·명중 파편 각 4장도 (창 골편은 부르는 곳이 없어 뺀다)
        for _, ruids in ipairs({ _GameConst.FxSkillHexBurst, _GameConst.FxSkillShatter, _GameConst.FxSkillShadowRise, _GameConst.FxSkillElitePromote, _GameConst.FxSkillBoneStorm,
                _GameConst.FxSkillShardThrow, _GameConst.FxSkillStormShard, _GameConst.FxSkillBoneArrow, _GameConst.FxSkillShardHit }) do
            for _, r in ipairs(_Util:Frames(ruids)) do table.insert(list, r) end
        end
        for _, kind in ipairs({ "amp", "weaken", "terror", "thorn", "lifetap", "resist" }) do
            for _, r in ipairs(_Util:KeyFrames(_GameConst.FxSkillCurseSigils, kind)) do table.insert(list, r) end
        end
        -- 10-31 9계열: 자리마다 첫 장 (뼈 갑옷 3 · 잔상 · 회오리·자국 · 의식 화살 · 소용돌이 · 명중 저주·불·서리 · 격류 시전·명중 · 원형 판 6 · 표식 12)
        --   뼛가루·뼈 명중은 골편 명중(FxSkillShardHit)과 같은 RUID라 위에서 이미 들어 있다
        for _, ruids in ipairs({ _GameConst.FxSkillArmorCast, _GameConst.FxSkillArmorAbsorb, _GameConst.FxSkillArmorBreak, _GameConst.FxSkillDashGhost, _GameConst.FxSkillRiteWhirl, _GameConst.FxSkillRiteWhirlTrace,
                _GameConst.FxSkillRiteArrow, _GameConst.FxSkillDrainVortex, _GameConst.FxSkillHitCurse, _GameConst.FxSkillHitFire, _GameConst.FxSkillHitFrost, _GameConst.FxSkillTorrentCast, _GameConst.FxSkillTorrentHit }) do
            local first = _Util:Frames(ruids)[1]
            if first ~= nil then table.insert(list, first) end
        end
        -- 10-31 C 7종: 자리마다 첫 장 (폭발·성찬·파동·불꽃탄·서리탄·독 구름·베기)
        for _, ruids in ipairs({ _GameConst.FxSkillBlast, _GameConst.FxSkillOfferingHeal, _GameConst.FxSkillDeathWave, _GameConst.FxSkillFlameShot, _GameConst.FxSkillFrostShot, _GameConst.FxSkillPoisonCloud, _GameConst.FxSkillSlash }) do
            local first = _Util:Frames(ruids)[1]
            if first ~= nil then table.insert(list, first) end
        end
        -- 10-31 메테오 L2: 4자리 첫 장 (예고·낙하·착지·잔불)
        for _, ruids in ipairs({ _GameConst.FxGiantMeteorTelegraph, _GameConst.FxGiantMeteorFall, _GameConst.FxGiantMeteorImpact, _GameConst.FxGiantMeteorAfterglow }) do
            local first = _Util:Frames(ruids)[1]
            if first ~= nil then table.insert(list, first) end
        end
        for _, kind in ipairs({ "amp", "weaken", "terror", "thorn", "lifetap", "resist" }) do
            local first = _Util:KeyFrames(_GameConst.FxSkillCurseCircles, kind)[1]
            if first ~= nil then table.insert(list, first) end
        end
        for _, kind in ipairs({ "amp", "weaken", "thorn", "terror", "confuse", "lifetap", "decay", "resist", "root", "chill", "poison", "hex" }) do
            local first = _Util:KeyFrames(_GameConst.FxSkillMarks, kind)[1]
            if first ~= nil then table.insert(list, first) end
        end
        local serials = {}
        for _, ruid in ipairs(list) do
            local serial = _EffectService:PlayEffectAttached(ruid, self.Entity, Vector3.zero, 0, Vector3(0.1, 0.1, 1), false, { Alpha = 0 })
            if serial ~= 0 then table.insert(serials, serial) end
        end
        self.VisualTimers["preload"] = _TimerService:SetTimerOnce(function()
            for _, serial in ipairs(serials) do _EffectService:RemoveEffect(serial) end
            self.VisualTimers["preload"] = nil
        end, 3)
    end

    @ExecSpace("Multicast")
    method void ClipFx(string ruid, Vector3 pos, number scale, number seconds, number angle)
        -- 메이플 스킬 애니메이션을 그 자리에 seconds 동안 재생한다. 서버가 바꾼 SpriteRUID는 클라이언트에 안 보여서 클라이언트마다 EffectService로 그린다
        local me = _UserService.LocalPlayer
        if ruid == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local serial = _EffectService:PlayEffect(ruid, self.Entity, pos, angle, Vector3(scale, scale, 1), seconds > 1.5, nil)
        if serial == 0 then return end
        self.ClipVisuals[serial] = true
        local key = "clip" .. tostring(serial)
        self.VisualTimers[key] = _TimerService:SetTimerOnce(function()
            _EffectService:RemoveEffect(serial)
            self.ClipVisuals[serial] = nil
            self.VisualTimers[key] = nil
        end, seconds)
    end

    method number C7Opt(string text, string kind, number fallback)
        -- 「키=값;…」 숫자 표에서 kind 값 (C7OldW·C7FitPx·C7Orders) · 없으면 fallback
        for k, v in string.gmatch(text or "", "(%w+)=([%d%.]+)") do
            if k == kind then return tonumber(v) end
        end
        return fallback
    end

    method string C7Ruids(string kind)
        -- C 7종 바닥 4계열 그림 칸 (「|」 4장 · 비면 "")
        if kind == "blast" then return _GameConst.FxSkillBlast end
        if kind == "offering" then return _GameConst.FxSkillOfferingHeal end
        if kind == "wave" then return _GameConst.FxSkillDeathWave end
        if kind == "poison" then return _GameConst.FxSkillPoisonCloud end
        return ""
    end

    method string C7OldRuid(string kind)
        -- 같은 자리의 예전 메이플 원본 한 장짜리 클립 (칸이 빌 때)
        if kind == "blast" then return self.FxBlast end
        if kind == "offering" then return self.FxOffering end
        if kind == "wave" then return self.FxWave end
        if kind == "poison" then return self.FxPoisonCloud end
        return ""
    end

    method number C7Scale(string kind, number oldScale)
        -- 새 그림 배율 = 예전 배율 × 예전 폭(배율 1) ÷ 새 내용 폭 → 새 그림의 보이는 폭 = 예전 클립의 보이는 폭 (예전 배율에 반경이 들어 있으면 그대로 비례)
        local fit = self:C7Opt(self.C7FitPx, kind, 0)
        if fit <= 0 then return oldScale end
        return oldScale * self:C7Opt(self.C7OldW, kind, fit / 100) * 100 / fit
    end

    @ExecSpace("ServerOnly")
    method void C7Clip(string kind, Vector3 feet, number oldDy, number oldScale, number seconds)
        -- 메이플 원본 클립 자리(해골 폭탄·제물 폭발 blast · 뼈 성찬 offering · 죽음의 파동 wave · 독안개 poison) — 10-31 C 7종:
        --   칸이 차면 새 4장을 발(지면 원점)에 모든 클라이언트로(C7Fx) · 비면 예전 ClipFx(발 + oldDy · 예전 배율 · seconds) 그대로
        if self:C7Ruids(kind) == "" then
            self:ClipFx(self:C7OldRuid(kind), Vector3(feet.x, feet.y + oldDy, 0), oldScale, seconds, 0)
            return
        end
        self:C7Fx(kind, feet, self:C7Scale(kind, oldScale), seconds)
    end

    @ExecSpace("Multicast")
    method void C7Fx(string kind, Vector3 feet, number scale, number seconds)
        -- C 7종 바닥 그림 재생 (클라이언트 · 맵 엔티티에 붙임): 독 구름은 seconds 동안 반복(Util.PlayFramesLoop) · 나머지는 한 번(Util.PlayFramesMs · 마지막 장 C7HoldSec · C7FadeSec 옅어짐)
        local me = _UserService.LocalPlayer
        local ruids = self:C7Ruids(kind)
        if ruids == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local order = math.floor(self:C7Opt(self.C7Orders, kind, 1) + 0.5)
        local ms = math.max(20, _GameConst.FxSkillC7FrameMs)
        local s = Vector3(scale, scale, 1)
        local loop = kind == "poison"
        if loop then
            _Util:PlayFramesLoop(ruids, me.CurrentMap, feet, 0, s, ms / 1000, seconds, Color(1, 1, 1, 1), order)
        else
            _Util:PlayFramesMs(ruids, me.CurrentMap, feet, 0, s, tostring(ms), self.C7HoldSec, self.C7FadeSec, Color(1, 1, 1, 1), order)
        end
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] c7 fx kind=%s n=%d ms=%d scale=%.2f order=%d loop=%s sec=%.2f", kind, #_Util:Frames(ruids), ms, scale, order, tostring(loop), seconds)) end
    end

    @ExecSpace("Multicast")
    method void StormClipFx(number seconds)
        -- 뼈 폭풍 「주위를 도는 뼈」 (44-1 A): 예전 보라 회오리 고리(FxStorm)는 의식 2기 「뼈 회오리」와 같은 그림이라 뺐다.
        --   시전자 둘레를 도는 골편 StormShardCount개를 클라이언트 전용으로 만들어 OnUpdate(StormOrbit)가 돌린다. 다시 쓰면 새 시간으로 다시 건다.
        --   코덱스 H-3 뼈 폭풍 8프레임(GameConst.FxSkillBoneStorm)이 오면 그 한 장을 가운데에 두고 프레임만 넘긴다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        if self.StormClip ~= 0 then _EffectService:RemoveEffect(self.StormClip) self.StormClip = 0 end
        self:StopStormOrbit()
        local codex = _GameConst.FxSkillBoneStorm ~= ""
        local count = codex and 1 or self.StormShardCount
        -- 10-31 골편 20장: 회전본이 비면 도는 골편 6개 = 폭풍 골편 4장(GameConst.FxSkillStormShard · StormOrbit이 장을 넘김) · 그것도 비면 예전 보라 궤적
        local shardArt = not codex and _GameConst.FxSkillStormShard ~= ""
        local first = codex and _Util:Frames(_GameConst.FxSkillBoneStorm)[1] or (shardArt and _Util:Frames(_GameConst.FxSkillStormShard)[1] or self.FxShardShot)
        local ps = self.Entity.TransformComponent.Scale
        local psx, psy = math.max(0.1, math.abs(ps.x)), math.max(0.1, math.abs(ps.y))
        for i = 1, count do
            local e = _SpawnService:SpawnByModelId("artsprite", "StormBone" .. tostring(i), self.Entity.TransformComponent.WorldPosition, self.Entity)
            if isvalid(e) then
                -- artsprite 기본 그림(모래 바닥)이 보이지 않게 만들자마자 그림을 바꾼다 (MotionSmoother와 같은 함정)
                local sp = e.SpriteRendererComponent
                sp.SpriteRUID = first
                sp.SortingLayer = "MapLayer0"
                sp.OrderInLayer = 5
                if codex then
                    local s = 2 * self.StormRadius / 1.28
                    e.TransformComponent.Scale = Vector3(s / psx, s / psy, 1)
                elseif shardArt then
                    sp.Color = self.ShardHitTint
                    e.TransformComponent.Scale = Vector3(self.StormShardScale / psx, self.StormShardScale / psy, 1)
                else
                    sp.Color = Color(0.96, 0.92, 0.8, 0.95)
                    e.TransformComponent.Scale = Vector3(0.5 / psx, 0.32 / psy, 1)
                end
                table.insert(self.StormShards, e)
            end
        end
        self.StormOrbitAt = _UtilLogic.ElapsedSeconds
        self.StormOrbitUntil = _UtilLogic.ElapsedSeconds + seconds
        self:StormOrbit()
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] bone storm orbit shards=%d codex=%s shardArt=%s r=%.1f", #self.StormShards, tostring(codex), tostring(shardArt), self.StormRadius)) end
    end

    @ExecSpace("ClientOnly")
    method void StormOrbit()
        -- 도는 뼈 한 프레임: 골편마다 둘레 자리·진행 방향(접선)으로 돌리고, 위쪽 반원은 몸 뒤(OrderInLayer 3) · 아래쪽은 몸 앞(5)
        if self.StormOrbitUntil <= 0 then return end
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.StormOrbitUntil or not isvalid(self.Entity) then self:StopStormOrbit() return end
        local ps = self.Entity.TransformComponent.Scale
        local psx, psy = math.max(0.1, math.abs(ps.x)), math.max(0.1, math.abs(ps.y))
        local t = now - self.StormOrbitAt
        if _GameConst.FxSkillBoneStorm ~= "" then
            local list = _Util:Frames(_GameConst.FxSkillBoneStorm)
            local e = self.StormShards[1]
            if #list > 0 and isvalid(e) then
                e.TransformComponent.Position = Vector3(0, 0.3 / psy, -0.01)
                local ruid = list[math.floor(t / 0.08) % #list + 1]
                if e.SpriteRendererComponent.SpriteRUID ~= ruid then e.SpriteRendererComponent.SpriteRUID = ruid end
            end
            return
        end
        local spin = 2 * math.pi * t / math.max(0.2, self.StormSpinSeconds)
        local r = self.StormRadius * 0.85
        local n = #self.StormShards
        -- 10-31 골편 20장: 폭풍 골편 4장이면 FxSkillShardFrameMs마다 장을 넘기고(골편마다 한 칸씩 어긋나게) · 진행 방향(접선)이 왼쪽이면 FlipY(가로 거울)
        local shardList = _GameConst.FxSkillStormShard ~= "" and _Util:Frames(_GameConst.FxSkillStormShard) or {}
        local frameSec = math.max(0.02, _GameConst.FxSkillShardFrameMs / 1000)
        for i, e in ipairs(self.StormShards) do
            if isvalid(e) then
                local a = spin + (i - 1) * 2 * math.pi / math.max(1, n)
                local x, y = r * math.cos(a), r * math.sin(a) * 0.8
                e.TransformComponent.Position = Vector3(x / psx, (y + 0.3) / psy, y > 0 and 0.01 or -0.01)
                e.TransformComponent.ZRotation = math.deg(a) + 90
                local sp = e.SpriteRendererComponent
                local order = y > 0 and 3 or 5
                if sp.OrderInLayer ~= order then sp.OrderInLayer = order end
                if #shardList > 0 then
                    local ruid = shardList[(math.floor(t / frameSec) + i - 1) % #shardList + 1]
                    if sp.SpriteRUID ~= ruid then sp.SpriteRUID = ruid end
                    local flip = math.cos(a + math.pi / 2) < 0
                    if sp.FlipY ~= flip then sp.FlipY = flip end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void StopStormOrbit()
        -- 도는 뼈를 거둔다 (시간이 다 됨 · 다시 시전 · 맵 이동 · 사망 · 끝)
        for _, e in ipairs(self.StormShards) do if isvalid(e) then e:Destroy() end end
        self.StormShards = {}
        self.StormOrbitUntil = 0
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 클라이언트 매 프레임: 뼈 폭풍 도는 뼈(모든 시전자) · 내 땅 찍기 범위 원(내 캐릭터만)
        if self.StormOrbitUntil > 0 then self:StormOrbit() end
        if self.Entity == _UserService.LocalPlayer then self:UpdateRangeCircle() end
    end

    @ExecSpace("ClientOnly")
    method void UpdateRangeCircle()
        -- 44-3 A: 땅 찍기 스킬(독안개·골격 감옥·저주 6·의식 2기)을 누르고 있는 동안 조준점에 판정 반경 원 (SkillBook.RangePreview가 반경·자리를 정한다).
        --   PC = 키를 누르는 동안(떼면 시전) · 모바일 = 칸을 끄는 동안 · 의식 = 2기 문턱을 넘긴 동안. 원은 바닥(MapLayer0 · 1)에 깔려 몸을 덮지 않는다
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        local view = book ~= nil and book:RangePreview() or nil
        local map = self.Entity.CurrentMap
        if view == nil or not isvalid(map) then
            self:HideRangeCircle()
            return
        end
        if self.RangeMap ~= map then
            self:DropRangeCircle()
            self.RangeMap = map
        end
        local radii = { view.r, view.r2 or 0 }
        for i = 1, 2 do
            local rim = self.RangeRims[i]
            local r = radii[i]
            if r > 0 then
                if rim == nil or not isvalid(rim) then
                    rim = _SpawnService:SpawnByModelId("artsprite", "SkillRange" .. tostring(i), Vector3(view.center.x, view.center.y, 0), map)
                    if isvalid(rim) then
                        rim.SpriteRendererComponent.SpriteRUID = _GameConst.SpriteSkillRangeRim
                        rim.SpriteRendererComponent.SortingLayer = "MapLayer0"
                        rim.SpriteRendererComponent.OrderInLayer = 1
                        rim.SpriteRendererComponent.Color = i == 1 and Color(0.8, 0.66, 1, 0.9) or Color(0.8, 0.66, 1, 0.4)
                    end
                    self.RangeRims[i] = rim
                end
                if isvalid(rim) then
                    rim.Enable = true
                    rim.TransformComponent.WorldPosition = Vector3(view.center.x, view.center.y, 0.02)
                    local s = 2 * r / 2.56   -- 256px 그림 = 2.56칸
                    rim.TransformComponent.Scale = Vector3(s, s, 1)
                end
            elseif rim ~= nil and isvalid(rim) then
                rim.Enable = false
            end
        end
        local key = view.id .. string.format(":%.2f:%.2f", view.r, view.r2 or 0)
        if key ~= self.RangeKey then
            self.RangeKey = key
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] range circle %s r=%.2f r2=%.2f dist=%.2f", view.id, view.r, view.r2 or 0, (view.center - _Util:Pos2(self.Entity)):Magnitude())) end
        end
    end

    @ExecSpace("ClientOnly")
    method void HideRangeCircle()
        -- 누르기를 멈췄다: 원을 숨긴다 (엔티티는 다음 누름에 다시 쓴다)
        for _, rim in pairs(self.RangeRims) do if isvalid(rim) then rim.Enable = false end end
        if self.RangeKey ~= "" then
            self.RangeKey = ""
            if not Environment:IsPublishedPlay() then log("[VRF] range circle hide") end
        end
    end

    @ExecSpace("ClientOnly")
    method void DropRangeCircle()
        -- 맵을 옮기거나 끝날 때 범위 원 엔티티를 지운다
        for _, rim in pairs(self.RangeRims) do if isvalid(rim) then rim:Destroy() end end
        self.RangeRims = {}
        self.RangeMap = nil
        self.RangeKey = ""
    end

    -- ───────── 궁극기 연출 (44-2 · 결정 2 — 파동 · 폭풍 · 의식 5기 · 정예 승격) ─────────

    @ExecSpace("Client")
    method void ShowUltimate(string kind)
        -- 큰 기술을 쓴 순간: 내 화면만 0.25초 어둡게(AimHUD/UltDim) + 전용 소리. 카메라 펀치(살짝 당겼다 놓기 · ZoomTo)는 「화면 흔들림」 설정을 따른다
        --   (PC 켬 · 모바일 끔 — 모바일 멀미 · 38 #12). 남의 궁극기는 그 사람 화면에서만 (서버가 시전자에게만 보낸다)
        if self.Entity ~= _UserService.LocalPlayer or not _Util:IsAlive(self.Entity) then return end
        local dim = _EntityService:GetEntityByPath("/ui/AimHUD/UltDim")
        local dimmed = false
        if isvalid(dim) and isvalid(dim.SpriteGUIRendererComponent) then
            if self.UltTimer ~= 0 then _TimerService:ClearTimer(self.UltTimer) self.UltTimer = 0 end
            local peak = 0.42
            local seconds = 0.25
            local sprite = dim.SpriteGUIRendererComponent
            sprite.Color = Color(0, 0, 0, peak)
            dim.Enable = true
            dimmed = true
            local t = 0
            self.UltTimer = _TimerService:SetTimerRepeat(function()
                t = t + 0.03
                if not isvalid(dim) or t >= seconds then
                    if isvalid(dim) then dim.Enable = false end
                    _TimerService:ClearTimer(self.UltTimer)
                    self.UltTimer = 0
                    return
                end
                sprite.Color = Color(0, 0, 0, peak * (1 - t / seconds))
            end, 0.03)
        end
        local punch = _Util:ShakeEnabled()
        if punch then
            _CameraService:ZoomTo(_GameData.cameraZoom * 1.07, 0.06)
            local key = "ultzoom"
            local old = self.VisualTimers[key]
            if old ~= nil then _TimerService:ClearTimer(old) end
            self.VisualTimers[key] = _TimerService:SetTimerOnce(function()
                self.VisualTimers[key] = nil
                _CameraService:ZoomTo(_GameData.cameraZoom, 0.22)
            end, 0.1)
        end
        -- 정예 승격은 시전음(SoundDirector.PlaySkillCue)이 이미 같은 소환 파동이라, 임시 소리가 같을 때는 겹쳐 틀지 않는다
        if _GameConst.SfxUltimate ~= "" and not (kind == "elite_promote" and _GameConst.SfxUltimate == _GameConst.SfxSummon) then _SoundDirector:PlayEffect(_GameConst.SfxUltimate, 0.55) end
        log(string.format("[VRF] ultimate %s dim=%s punch=%s", kind, tostring(dimmed), tostring(punch)))
    end

    method table ShardAngles(Vector2 dir, integer count, number spreadDeg)
        -- 부채꼴 각도 (골편·저주 불꽃, 서버 발사·클라이언트 예측 공용, 디아2 멀티샷): 이웃한 발 사이 spreadDeg°, 겨눈 방향을 가운데로 대칭.
        -- 홀수면 가운데 한 발이 정면(고른 적 추적), 짝수면 정면 양옆 반 칸씩 (15°면 2발 = 15°, 5발 = 60°). 골편은 강화 「모인 뼈」만큼 좁다
        local base = math.atan(dir.y, dir.x)
        local spread = math.rad(spreadDeg)
        local list = {}
        for i = 1, count do table.insert(list, base + (i - (count + 1) / 2) * spread) end
        return list
    end

    method number ShardSpread()
        -- 골편 부채꼴 간격(도) — SkillBook.GetBoneShardSpread (강화 「모인 뼈」)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        return book ~= nil and book:GetBoneShardSpread() or 15
    end

    method Vector2 ShardAim(Vector2 me, Vector2 target)
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        return dir
    end

    @ExecSpace("ServerOnly")
    method boolean BoneShardVolley(Vector2 me, Vector2 target, number damage, integer count, any onComplete, any canCommit, Entity lock)
        -- 골편 투척: 한 번에 count발을 부채꼴로 동시에 (10-11 QA: 줄지어 나가지 않게). 홀수면 가운데 발이 고른 적을 따라가고
        -- 나머지는 곧게 날아 처음 맞은 적에서 멈춘다. 첫 발이 실제로 날아간 뒤(마나·쿨다운 확정) 나머지를 같은 프레임에 쏜다
        local dir = self:ShardAim(me, target)
        count = math.max(1, count)
        local spread = self:ShardSpread()
        local angles = self:ShardAngles(dir, count, spread)
        local center = count % 2 == 1 and (count + 1) // 2 or 0
        local aimAt = function(i) return me + Vector2(math.cos(angles[i]), math.sin(angles[i])) * 3 end
        local first = center > 0 and center or 1
        local rest = function(success)
            if onComplete ~= nil then onComplete(success) end
            if not success then return end
            log(string.format("[VRF] bone shard volley n=%d spread=%.1f", #angles, spread))
            for i = 1, #angles do
                if i ~= first then self:BoneShard(me, aimAt(i), damage, nil, nil, nil) end
            end
        end
        return self:BoneShard(me, center > 0 and target or aimAt(first), damage, rest, canCommit, center > 0 and lock or nil)
    end

    @ExecSpace("ClientOnly")
    method void PredictBoneShard(Vector2 target, integer count, Entity lock, integer maxHits)
        -- 10-11 QA 「누르자마자 안 나가고 0.5초쯤 늦다」: 서버 투사체는 왕복·생성 동기화만큼 늦게 보였다.
        -- 내 화면에서는 누르는 순간 서버와 같은 각도·속도·사거리로 뼛조각을 직접 그리고, 서버 투사체는 숨긴다 (판정·피해는 서버)
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local me = _Util:Pos2(self.Entity)
        local dir = self:ShardAim(me, target)
        count = math.max(1, count)
        local angles = self:ShardAngles(dir, count, self:ShardSpread())
        local center = count % 2 == 1 and (count + 1) // 2 or 0
        self.PredictedAt = _UtilLogic.ElapsedSeconds
        for i, a in ipairs(angles) do
            local d = i == center and dir:Normalize() or Vector2(math.cos(a), math.sin(a))
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local e = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneShardView_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            local proj = isvalid(e) and e:GetComponent("script.Projectile") or nil
            if proj ~= nil then
                ---@type Projectile
                local p = proj
                p.MaxHits = maxHits   -- 서버와 같은 마릿수에서 멈춘다 (관통 상한)
                p:PlayLocal(self.Entity, d, 12, 6.5, self:ShardSkinRuid(), self:ShardSkinScale(0.55), i == center and lock or nil)
            elseif isvalid(e) then
                e:Destroy()
            end
        end
        if not Environment:IsPublishedPlay() then log("[VRF] bone shard predicted n=" .. tostring(#angles)) end   -- 시전·추출·소환마다 찍히므로 출시 서버에서는 끈다
    end

    method boolean RecentlyPredicted()
        -- 클라이언트: 방금(1.5초 안) 직접 그린 골편이 있으면 같은 시전의 서버 투사체를 숨긴다
        return _UtilLogic.ElapsedSeconds - self.PredictedAt < 1.5
    end

    @ExecSpace("ServerOnly")
    method boolean BoneArmor(number absorb)
        -- 뼈 갑옷: 흡수량을 가득 채운다 (남은 흡수량보다 클 때만 의미 — 다시 쓰면 새로 채운다)
        ---@type PlayerStats
        local st = self.Entity:GetComponent("script.PlayerStats")
        if st == nil then return false end
        st.BoneArmorMax = math.floor(absorb)
        st.BoneArmor = math.floor(absorb)
        st.ArmorSoaked = 0   -- 새 갑옷: 「터지는 갑옷」이 셀 막은 피해 합을 새로
        -- 두르는 순간 연출은 모든 클라이언트에 (예전엔 서버에서만 불러 화면에 보이는지 알 수 없었다 — 44 §3-3). 남은 흡수량 고리는 PlayerStats.OnSyncProperty
        self:StatusFx("armor", self.Entity.TransformComponent.WorldPosition, 1)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean BoneSpear(Vector2 me, Vector2 target, number damage)
        -- 뼈 창: 조준 방향으로 길게 꿰뚫는 창 (초속 14, 사거리 9 × 「긴 창」). 「두 갈래」면 곧은 창 + 7° 옆 창 (둘 다 벌리면 정면 적을 비껴갔다). 모두에게 보이는 서버 투사체
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        local range = 9 * (1 + 0.2 * self:Node("spear_long"))
        local dirs = { dir }
        if self:Node("spear_twin") > 0 then
            local a = math.atan(dir.y, dir.x)
            dirs = { dir, Vector2(math.cos(a + 0.12), math.sin(a + 0.12)) }
        end
        local map = self.Entity.CurrentMap
        local owner = self.Entity
        for _, d in ipairs(dirs) do
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneSpear_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            if isvalid(shot) then
                local fly = d
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    -- 외형·속도 = 해골 마법사 뼈 창과 공용 (MageBolts.Configure · 48 §2-6) · 세기(관통 상한 · 가시 +10%)는 캐릭터 것
                    local speed = _MageBolts:Configure(proj, "bone")
                    proj.MaxHits = self:PierceCap("bone_spear")
                    proj.SpikePct = 10   -- 10-28 투사체 A안: 관통은 뼈 창의 몫 — 꿰뚫을 때마다 +10%
                    proj:Launch(owner, fly, speed, range, damage, "skill.bone_spear", true)
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean ShardBounce(Vector2 from, table hitIds, number damage, integer bouncesLeft, number spikePct)
        -- 골편 강화 「튕김」: 맞힌 자리에서 4칸 안 아직 안 맞은 가장 가까운 적에게 뼛조각이 튄다 (모두에게 보이는 서버 투사체). 튈 적이 있어 날렸으면 true
        local map = self.Entity.CurrentMap
        local best = nil
        local bestD = 4
        for _, m in ipairs(_Util:MonstersNear(map, from, 4)) do
            if not hitIds[m.Entity.Id] and not m.IsDead then
                local d = (_Util:Pos2(m.Entity) - from):Magnitude()
                if d < bestD then best, bestD = m, d end
            end
        end
        if best == nil then return false end
        local dir = (_Util:Pos2(best.Entity) - from):Normalize()
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneBounce_" .. tostring(self.ShotCount), Vector3(from.x, from.y + 0.3, 0), map)
        if not isvalid(shot) then return false end
        local owner = self.Entity
        local target = best.Entity
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
            proj:Skin(self:ShardSkinRuid(), self:ShardSkinScale(0.5))
            if isvalid(target) then proj.Lock = target end
            proj.SpikePct = spikePct
            proj.Bounces = bouncesLeft
            proj.MaxHits = 1   -- 튕긴 뼛조각은 한 마리만 (튕김 횟수는 강화 랭크가 정한다)
            proj:Launch(owner, dir, 12, bestD + 1.5, damage, "skill.bone_shard", true)
            -- Launch 초기화 뒤 이전 대상 이력을 물려받아 같은 적의 재명중을 막는다.
            for id, v in pairs(hitIds) do proj.HitIds[id] = v end
        end, function() if isvalid(shot) then shot:Destroy() end end)
        return true
    end

    @ExecSpace("ServerOnly")
    method void BoneShardImpact(Vector3 pos)
        -- 뼛조각 명중: 코덱스 골편 명중 4장 (10-31 · 비면 예전 보라 파열 0.5 · 0.6초)
        self:ShardHit(pos, 0.5, 0.6)
    end

    method string ShardSkinRuid()
        -- 골편 투사체 그림: 코덱스 골편 투척 4장(GameConst.FxSkillShardThrow · 비행 중 반복 · Projectile.FrameSec/MirrorSkin)이 차면 그것, 비면 예전 보라 궤적
        if _GameConst.FxSkillShardThrow ~= "" then return _GameConst.FxSkillShardThrow end
        return self.FxShardShot
    end

    method number ShardSkinScale(number oldScale)
        -- 예전 보라 궤적 배율(예측·서버 0.55 · 튕김 0.5) → 골편 투척 그림이면 ShardThrowScale × (oldScale / 0.55) · 비면 oldScale 그대로
        if _GameConst.FxSkillShardThrow ~= "" then return self.ShardThrowScale * oldScale / 0.55 end
        return oldScale
    end

    @ExecSpace("ServerOnly")
    method void ShardHit(Vector3 pos, number clipScale, number seconds)
        -- 골편 명중·뼛가루 자리 (10-31 골편 20장): 코덱스 골편 명중 4장(GameConst.FxSkillShardHit)이 차면 모든 클라이언트에 한 번(ShardHitFrames),
        --   비면 예전 보라 파열 ClipFx(FxShardHit, clipScale, seconds) 그대로
        if _GameConst.FxSkillShardHit == "" then
            self:ClipFx(self.FxShardHit, pos, clipScale, seconds, 0)
            return
        end
        self:ShardHitFrames(pos, clipScale)
    end

    @ExecSpace("Multicast")
    method void ShardHitFrames(Vector3 pos, number clipScale)
        -- 골편 명중 4장 한 번 (장마다 FxSkillShardFrameMs · 마지막 장도 같은 시간 · Util.PlayFrames) · 크기 = ShardHitScale × (옛 ClipFx 배율 / 0.5) · MapLayer0 ShardHitOrder · 클라이언트에서만 그린다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap or _GameConst.FxSkillShardHit == "" then return end
        local s = self.ShardHitScale * clipScale / 0.5
        local frameSec = math.max(0.02, _GameConst.FxSkillShardFrameMs / 1000)
        _Util:PlayFrames(_GameConst.FxSkillShardHit, self.Entity, pos, 0, Vector3(s, s, 1), frameSec, self.ShardHitTint, self.ShardHitOrder)
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] shard hit frames n=%d ms=%d scale=%.2f", #_Util:Frames(_GameConst.FxSkillShardHit), _GameConst.FxSkillShardFrameMs, s)) end
    end

    @ExecSpace("ServerOnly")
    method void ConsumedDust(Vector2 feet, number clipScale, number seconds)
        -- 소모된 해골이 사라지는 뼛가루 (S10·P40 · 10-31 9계열 GameConst.FxSkillConsumedDust = 골편 명중 4장과 같은 RUID): 차면 발 앵커(해골 발 + DustDy)로 모든 클라이언트에 한 번,
        --   비면 예전 길 = 골편 명중 ShardHit(해골 자리 +0.4 · 옛 배율) → 그것도 비면 보라 파열. 부르는 곳: 의식 2기·거인 합체(UndeadSystem) · 의식 3기 쏜 해골(RiteArrows)
        if _GameConst.FxSkillConsumedDust == "" then
            self:ShardHit(Vector3(feet.x, feet.y + 0.4, 0), clipScale, seconds)
            return
        end
        self:DustFrames(Vector3(feet.x, feet.y + self.DustDy, 0), clipScale)
    end

    @ExecSpace("Multicast")
    method void DustFrames(Vector3 pos, number clipScale)
        -- 뼛가루 4장 한 번 (장마다 FxSkillConsumedDustMs · 클라이언트 Util.PlayFrames) · 크기 = DustScale × (옛 ClipFx 배율 / 0.5) · 뼈 흰빛 · MapLayer0 ShardHitOrder
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap or _GameConst.FxSkillConsumedDust == "" then return end
        local s = self.DustScale * clipScale / 0.5
        _Util:PlayFrames(_GameConst.FxSkillConsumedDust, self.Entity, pos, 0, Vector3(s, s, 1), math.max(0.02, _GameConst.FxSkillConsumedDustMs / 1000), self.ShardHitTint, self.ShardHitOrder)
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] consumed dust frames n=%d ms=%d scale=%.2f shared=%s", #_Util:Frames(_GameConst.FxSkillConsumedDust), _GameConst.FxSkillConsumedDustMs, s, tostring(_GameConst.FxSkillConsumedDust == _GameConst.FxSkillShardHit))) end
    end

    @ExecSpace("ServerOnly")
    method boolean BoneShard(Vector2 me, Vector2 target, number damage, any onComplete, any canCommit, Entity lock)
        -- 조준 방향으로 뼛조각이 날아간다 (초속 12, 사거리 6.5). 처음 맞은 적에서 멈춘다 (10-28 투사체 A안 — 발 수는 BoneShardVolley 부채꼴)
        -- lock(고정 대상)이 있으면 그 몬스터를 따라가 닿는 순간 터진다 (가는 길의 적도 맞는다)
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        if lock ~= nil and not isvalid(lock) then lock = nil end
        local start = me + Vector2(0, 0.3) + dir * 0.35
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneShard_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), self.Entity.CurrentMap)
        if not isvalid(shot) then
            self:Fail("뼛조각을 만들지 못했습니다")
            return false
        end
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local finished = false
        local finish = function(success)
            if finished then return end
            finished = true
            if not success and isvalid(shot) then shot:Destroy() end
            if onComplete ~= nil then onComplete(success) end
        end
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if finished then if isvalid(shot) then shot:Destroy() end return end
            if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then finish(false) return end
            if canCommit ~= nil and not canCommit() then finish(false) return end
            -- 투사체 그림: 코덱스 골편 투척 4장(10-31 · 비면 어두운 보라 궤적 · 기본 화살 그림은 평범했다)
            proj:Skin(self:ShardSkinRuid(), self:ShardSkinScale(0.55))
            -- 쏜 사람 화면은 누르는 순간 PredictBoneShard가 그린 뼛조각을 보여 주고 이 서버 투사체는 숨긴다
            proj.ViewKind = "bone_shard"
            if isvalid(lock) then proj.Lock = lock end
            proj.SpikePct = 15 * self:Node("shard_spike")   -- 강화 「뼈 가시」: 튕길 때마다 +15%/랭크 (10-28 투사체 A안)
            proj.Bounces = self:Node("shard_bounce") + self:ChoiceTier(3, "soul")   -- 강화 「튕김」 + 선택 보상 3차 주문 「튀는 뼛조각」
            proj.MaxHits = 1                                 -- 10-28 투사체 A안: 골편은 관통하지 않고 부채꼴 발 수로 넓힌다
            proj:Launch(owner, dir, 12, 6.5, damage, "skill.bone_shard", true)
            finish(true)
        end, function() finish(false) end)
        _TimerService:SetTimerOnce(function() if not finished then finish(false) end end, 1)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean PoisonMist(Vector2 target, number dps)
        -- 4초 동안 남는 독안개(반경 1.3): 0.5초마다 안에 있는 적에게 독(2초)을 건다. 나중에 들어온 적도 걸린다
        local epoch = self.EffectEpoch
        local map = self.Entity.CurrentMap
        local seconds = 4 + self:Node("mist_thick")            -- 강화 「짙은 독」
        local untilAt = _UtilLogic.ElapsedSeconds + seconds
        local radius = 1.3 * (1 + 0.2 * self:Node("mist_wide"))   -- 강화 「넓은 안개」
        local tick = function()
            for _, m in ipairs(_Util:MonstersNear(map, target, radius)) do m:ApplyPoison(dps, 2, self.Entity) end
            for _, foe in ipairs(self:FoePlayers(target, radius)) do
                ---@type PlayerStats
                local fs = foe:GetComponent("script.PlayerStats")
                if fs ~= nil then fs:ApplyPvpPoison(dps * _GameData.pvpDamageMult, 2, self.Entity) end
            end
        end
        tick()
        local timerId = 0
        timerId = _TimerService:SetTimerRepeat(function()
            if not _Util:IsAlive(self.Entity) or self.Entity.CurrentMap ~= map or epoch ~= self.EffectEpoch or _UtilLogic.ElapsedSeconds >= untilAt then
                _TimerService:ClearTimer(timerId)
                self.MistTimers[timerId] = nil
                return
            end
            tick()
        end, 0.5)
        self.MistTimers[timerId] = true
        self:MistFx(Vector3(target.x, target.y, 0), radius, seconds)
        self:C7Clip("poison", Vector3(target.x, target.y, 0), 0.3, 1.25 * radius / 1.3, seconds)   -- 10-31 C 7종 독 구름 4장 반복 (비면 예전 메이플 독구름)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean HexFlame(Vector2 me, Vector2 target, number damage, integer count)
        -- 저주 불꽃: 조준 방향으로 불꽃 화살 count발 (가운데 정면, 15° 간격 부채꼴). 한 적에 맞으면 사라진다.
        -- 저주 걸린 적에게 +50%(「낙인 연소」 랭크마다 +20%p)는 PlayerAttack.CalcDamage가 맞는 순간 정한다
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local launched = 0
        ---@type SkillBook
        local book = owner:GetComponent("script.SkillBook")
        local burst = book ~= nil and book:GetHexBurstRadius(book:GetPowerLevel("hex_flame")) or 0
        for _, a in ipairs(self:ShardAngles(dir, math.max(1, count), 15)) do
            local d = Vector2(math.cos(a), math.sin(a))
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "HexFlame_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            if isvalid(shot) then
                launched = launched + 1
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    local speed = _MageBolts:Configure(proj, "fire")   -- 외형·속도 = 불꽃 마법사와 공용 (48 §2-6)
                    proj.BurstRadius = burst   -- 10-28 투사체 A안 「폭발」: 저주 걸린 적에 맞으면 둘레에 화염
                    proj:Launch(owner, d, speed, 7, damage, "skill.hex_flame", false)
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        if launched == 0 then
            self:Fail("불꽃을 날리지 못했습니다")
            return false
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean FrostSoul(Vector2 me, Vector2 target, number damage)
        -- 서리 혼: 조준 방향으로 날아가 처음 맞은 적에서 서리 파편으로 갈라진다 (초속 9, 사거리 8 · 10-28 투사체 A안 「쪼개짐」). 둔화는 PlayerAttack.SkillHitExtra
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        dir = dir:Normalize()
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local start = me + Vector2(0, 0.3) + dir * 0.35
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "FrostSoul_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
        if not isvalid(shot) then
            self:Fail("서리 혼을 날리지 못했습니다")
            return false
        end
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
            local speed = _MageBolts:Configure(proj, "cold")   -- 외형·속도 = 서리 마법사와 공용 (48 §2-6)
            ---@type SkillBook
            local book = owner:GetComponent("script.SkillBook")
            proj.MaxHits = 1
            proj.Splits = book ~= nil and book:GetFrostSplitCount(book:GetPowerLevel("frost_soul")) or 0
            proj:Launch(owner, dir, speed, 8, damage, "skill.frost_soul", true)
        end, function() if isvalid(shot) then shot:Destroy() end end)
        return true
    end

    @ExecSpace("ServerOnly")
    method void FrostSplit(Vector2 from, table hitIds, number damage, integer count)
        -- 서리 혼 「쪼개짐」: 맞은 자리에서 서리 파편 count개 — 4칸 안 아직 안 맞은 가까운 적부터 하나씩, 모자라면 고르게 퍼진 방향으로 (파편 피해 50% · 둔화 같음)
        local map = self.Entity.CurrentMap
        local foes = {}
        for _, m in ipairs(_Util:MonstersNear(map, from, 4)) do
            if not hitIds[m.Entity.Id] and not m.IsDead then table.insert(foes, { m = m, d = (_Util:Pos2(m.Entity) - from):Magnitude() }) end
        end
        table.sort(foes, function(a, b) return a.d < b.d end)
        local owner = self.Entity
        local seed = (self.ShotCount % 7) * 0.4
        for i = 1, count do
            local f = foes[i]
            local dir = f ~= nil and (_Util:Pos2(f.m.Entity) - from) or Vector2(math.cos(seed + i * 2 * math.pi / count), math.sin(seed + i * 2 * math.pi / count))
            if dir:Magnitude() < 0.01 then dir = Vector2(1, 0) end
            dir = dir:Normalize()
            local start = from + dir * 0.3
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "FrostSplit_" .. tostring(self.ShotCount), Vector3(start.x, start.y + 0.3, 0), map)
            if isvalid(shot) then
                local lock = f ~= nil and f.m.Entity or nil
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    local speed = _MageBolts:Configure(proj, "cold_shard")   -- 외형·속도 = 서리 마법사 파편과 공용 (48 §2-6)
                    if isvalid(lock) then proj.Lock = lock end
                    proj.MaxHits = 1
                    proj:Launch(owner, dir, speed, 4.2, damage * 0.5, "skill.frost_split", true)
                    -- Launch 초기화 뒤 이전 대상 이력을 물려받아 같은 적의 재명중을 막는다.
                    for id, v in pairs(hitIds) do proj.HitIds[id] = v end
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        log(string.format("[VRF] frost split %d (targets %d)", count, math.min(count, #foes)))
    end

    @ExecSpace("ServerOnly")
    method void HexBurst(Vector2 at, number damage, number radius, integer excludeId)
        -- 저주 불꽃 「폭발」: 저주 걸린 적에 맞은 자리 반경 radius 안 다른 적에게 화염 (불꽃 한 발 피해의 40%)
        ---@type PlayerAttack
        local atk = self.Entity:GetComponent("script.PlayerAttack")
        if atk == nil then return end
        local n = 0
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, at, radius)) do
            if m.Entity.Id ~= excludeId and not m.IsDead then
                atk:SkillHitOne(m.Entity, "skill.hex_burst", damage * 0.4)
                n = n + 1
            end
        end
        -- 코덱스 H-1 저주 불꽃 폭발 6프레임(GameConst.FxSkillHexBurst)이 오면 그 그림을 반경에 맞춰 한 번 (128px = 1.28칸 지름)
        if _GameConst.FxSkillHexBurst ~= "" then self:FramesFx(_GameConst.FxSkillHexBurst, Vector3(at.x, at.y + 0.3, 0), 2 * radius / 1.28, self.HexBurstFrameSec, self.HexBurstFrameSec + self.HexBurstHoldSec, self.HexBurstFadeSec, self.FramesFxOrder)
        else self:ClipFx(self.FxFlameShot, Vector3(at.x, at.y + 0.35, 0), 0.45 * radius, 0.45, 0) end
        log(string.format("[VRF] hex burst r=%.1f hit %d", radius, n))
    end

    @ExecSpace("ServerOnly")
    method void FrostShatter(Vector2 at, number damage)
        -- 강화 「파쇄」: 서리 혼에 느려진 적이 죽은 자리에서 냉기 파편 (반경 1.3)
        self:Hit(Vector2(at.x, at.y + 0.2), Vector2(1.3, 0), -1, "skill.frost_shatter", damage)
        if _GameConst.FxSkillShatter ~= "" then self:FramesFx(_GameConst.FxSkillShatter, Vector3(at.x, at.y + 0.3, 0), 2 * 1.3 / 1.28, self.ShatterFrameSec, self.ShatterFrameSec + self.ShatterHoldSec, self.ShatterFadeSec, self.FramesFxOrder)
        else self:ClipFx(self.FxFrostShot, Vector3(at.x, at.y + 0.4, 0), 0.5, 0.5, 0) end
    end

    @ExecSpace("Multicast")
    method void FramesFx(string ruids, Vector3 pos, number scale, number frameSec, number holdSec, number fadeSec, integer order)
        -- 코덱스 프레임 그림(「|」로 이은 RUID)을 그 자리에 한 번 (44 스킬 그림 바꿔 끼울 자리 — GameConst.FxSkill*)
        --   10-31 갈래 E: 첫 장부터 frameSec씩 · 마지막 장 max(frameSec, holdSec) 잡기 · fadeSec 옅어짐 (Util.PlayFramesHold)
        local me = _UserService.LocalPlayer
        if ruids == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _Util:PlayFramesHold(ruids, me.CurrentMap, pos, 0, Vector3(scale, scale, 1), frameSec, holdSec, fadeSec, Color(1, 1, 1, 1), order)
        if self.Entity == me and not Environment:IsPublishedPlay() then
            local n = #_Util:Frames(ruids)
            log(string.format("[VRF] frames fx n=%d sec=%.3f hold=%.2f fade=%.2f total=%.2f", n, frameSec, holdSec, fadeSec, _Util:FramePlan(n, frameSec, holdSec, fadeSec).clearAt))
        end
    end

    -- ───────── 46-4 · 48 뼈 의식 거인 기술 효과 (코덱스 J-6 · K-4 · GameConst.FxGiant* · 새 그림 자리는 위 FxGiant* 속성 · 48 연출 V2 10-30) ─────────

    method table FxOpts(string text)
        -- 그림 계약 문자열 「키=값;…」(FxGiant*Opts) → 표. 숫자는 숫자로, true/false는 참·거짓으로, 나머지는 글자 그대로
        local t = {}
        for pair in string.gmatch(text or "", "[^;]+") do
            local k, v = string.match(pair, "^%s*([%w_]+)%s*=%s*(.-)%s*$")
            if k ~= nil then
                if tonumber(v) ~= nil then t[k] = tonumber(v)
                elseif v == "true" then t[k] = true
                elseif v == "false" then t[k] = false
                else t[k] = v end
            end
        end
        return t
    end

    method number SpinCycle()
        -- 대검 회전 베기 한 바퀴 = 서버 타격 간격 gap (rite_giants.csv greatsword s1Opts · 이동형 휠윈드 0.3초) — 회전 그림 한 바퀴가 타격 한 번과 같은 주기로 돈다
        local g = _GameData:GetGiant("greatsword")
        local opt = g ~= nil and g.s1Opts or nil
        local gap = opt ~= nil and opt.gap or 0.3
        if gap == nil or gap <= 0 then gap = 0.3 end
        return gap
    end

    method table GiantFxSpec(string kind)
        -- 효과별 그림(「|」로 이은 연속본 · 장 수 제한 없음)·원본 크기(px)·장 간격 규칙·반복 여부 (48 연속본 66장 10-30 · 48 연출 V2 새 자리 10-30).
        --   코덱스 timing의 100ms는 검수 속도일 뿐 엔진 값이 아니다 → 기존 시전·타격 시각에 맞춰 여기서 정한다. 장 간격 규칙(GiantFxFrameSec · 위가 우선):
        --     sec = 고정 장 간격 · impact = 그 칸(1부터)이 부르는 쪽 seconds 뒤(= 서버 타격 순간)에 오게 · cycle = 한 바퀴(반복) 시간 ÷ 장 수 ·
        --     span = 한 번 재생 길이 ÷ 장 수 · fit = 부르는 쪽 seconds ÷ 장 수 · 아무것도 없으면 max(0.04, seconds ÷ 장 수)(옛 기본 바닥)
        --   hold = 마지막 장을 seconds 끝까지 붙잡음 · loop = seconds 동안 처음으로 되돌아 반복 · peak = 그 칸 불투명 1(타격 순간 강하게) 뒤로 옅어짐
        --   크기: ref = 그림이 그려진 세계 지름(칸 · 56px = 1칸) — 부르는 쪽 지름 width를 ref에 맞춰 같은 비율로 키운다 (ref가 없으면 캔버스 가로를 width로 · stretch = 길이·폭으로 늘임)
        --   order 1 = 몸 뒤 바닥(MapLayer0 · 발 기준) · 6 = 몸 앞 · own = 새 그림 자기 색(색조 대신 흰색 0.85) · dy = 앵커 위 높이(칸)
        --   V2 새 자리(FxGiantSpinBack/Front · RiftSeq · SlamSeq · RoarSeq)가 차면 그 그림 + *Opts 계약 (w·h·ref·impact·span·order·dy) · 비면 지금 그림 그대로
        local spec = nil
        if kind == "slam" then
            spec = { ruids = _GameConst.FxGiantSlam, w = 192, h = 128, ref = 3.2, hold = true, px = 0.5, order = 1, own = true }
            if self.FxGiantSlamSeq ~= "" then spec = { ruids = self.FxGiantSlamSeq, w = 192, h = 128, ref = 3.2, span = 0.6, ax = 0.8, ay = 0.1, px = 0.5, order = 1, own = true, v2 = true, flip = true } end
        elseif kind == "slam_front" then
            spec = { ruids = self.FxGiantSlamFront, w = 192, h = 128, ref = 3.2, span = 0.6, ax = 0.8, ay = 0.1, px = 0.5, order = 6, own = true, v2 = true, flip = true }
        elseif kind == "spin" then
            spec = { ruids = _GameConst.FxGiantSpin, w = 192, h = 192, ref = 3.2, cycle = self:SpinCycle(), loop = true, px = 0.5, order = 6, own = true }
        elseif kind == "spin_back" or kind == "spin_front" then
            -- 수평 360도 회전 베기 두 층: 뒤쪽 칼날 호는 몸 뒤(order 1) · 앞쪽 호는 몸 앞(order 6) — 같은 캔버스·피벗·장 수·주기로 함께 시작 (스프라이트 통째 회전·상하 뒤집기 없음: angle 0 · 배율 양수)
            local back = kind == "spin_back"
            spec = { ruids = back and self.FxGiantSpinBack or self.FxGiantSpinFront, w = 352, h = 176, cw = 352, cycle = self:SpinCycle(), loop = true, px = 0.5, order = back and 1 or 6, own = true, v2 = true }
        elseif kind == "rift" then
            spec = { ruids = _GameConst.FxGiantRift, w = 256, h = 96, sec = 0.25 / 3, hold = true, stretch = true, px = 0, order = 1, own = true }
            if self.FxGiantRiftSeq ~= "" then spec = { ruids = self.FxGiantRiftSeq, w = 256, h = 96, fit = true, stretch = true, px = 0, order = 1, own = true, v2 = true } end
        elseif kind == "dash" then
            spec = { ruids = _GameConst.FxGiantDash, w = self.GiantDashW, h = self.GiantDashH, stretch = true, px = 1, order = 1, own = true }
            -- 10-31 갈래 F B 돌진 자취 12장: 계약(FxGiantDashOpts)이 피벗 자리(시작점)·그림 방향(rev)·세운 채 좌우(upright)·장별 ms를 정한다 (길이·폭 늘임은 그대로)
            if self.FxGiantDashSeq ~= "" then spec = { ruids = self.FxGiantDashSeq, w = 256, h = 96, stretch = true, px = 1, order = 1, own = true, v2 = true } end
        elseif kind == "nova" or kind == "nova_front" then
            if self.FxGiantNovaV2 ~= "" then
                -- 노바 V2 (16장 · 장별 시간 · 두 층): 뒤 층 order 1(바닥 광선·파편 · 배우 뒤) · 앞 층 order 6(중앙 타원·섬광) — 같은 원점·시각
                local front = kind == "nova_front"
                spec = { ruids = front and self.FxGiantNovaV2Front or self.FxGiantNovaV2, w = 640, h = 512, ref = 7.5, px = 0.5, order = front and 6 or 1, own = true, v2 = true, novaV2 = true }
            elseif kind == "nova" then
                spec = { ruids = self.FxGiantNova, w = 384, h = 256, ref = 5.0, px = 0.5, dy = 0.1, order = 1, own = true, v2 = true }
            end
        elseif kind == "meteor_fall" then
            spec = { ruids = self.FxGiantFireMeteor, first = 1, last = 2, w = 256, h = 256, ref = 4.0, px = 0.5, order = 6, own = true }
            -- 10-31 갈래 F B 메테오 12장: 계약(FxGiantFireMeteorOpts)의 impact 칸 앞 = 낙하 (fall 동안 · 마지막 낙하 장을 착지 순간까지 유지)
            if self.FxGiantFireMeteorOpts ~= "" then spec = { ruids = self.FxGiantFireMeteor, w = 256, h = 256, ref = 4.0, hold = true, px = 0.5, order = 6, own = true, v2 = true, meteor = "fall" } end
        elseif kind == "meteor_land" then
            spec = { ruids = self.FxGiantFireMeteor, first = 3, last = 6, w = 256, h = 256, ref = 4.0, sec = 0.1, hold = true, px = 0.5, order = 1, own = true }
            -- B: impact 칸부터 끝까지 = 착지·그을림 (scorch 동안 마지막 장 유지)
            if self.FxGiantFireMeteorOpts ~= "" then spec = { ruids = self.FxGiantFireMeteor, w = 256, h = 256, ref = 4.0, hold = true, px = 0.5, order = 1, own = true, v2 = true, meteor = "land" } end
        elseif kind == "roar" then
            spec = { ruids = self.FxGiantRoar, w = 64, h = 32, hold = true, px = 0.5, order = 6, own = true }
            if self.FxGiantRoarSeq ~= "" then spec = { ruids = self.FxGiantRoarSeq, w = 256, h = 256, ref = 6.0, span = 0.6, px = 0.5, order = 6, own = true, v2 = true, flip = true } end
        elseif kind == "flurry" then
            spec = { ruids = self.FxGiantFlurry, w = 192, h = 192, px = 0.5, order = 6, own = true, v2 = self.FxGiantFlurryOpts ~= "" }   -- 10-31 갈래 F B 12장: 계약이 있으면 장별 ms
        end
        if spec == nil then return { ruids = "", w = 128, h = 128, sec = 0.1, loop = false } end
        if spec.v2 then
            -- 그림 계약 덮어쓰기 (부모가 새 그림을 등록할 때 RUID와 함께 채운다)
            local text = ""
            if spec.novaV2 then text = self.FxGiantNovaV2Opts
            elseif kind == "nova" then text = self.FxGiantNovaOpts
            elseif kind == "spin_back" then text = self.FxGiantSpinOpts .. ";" .. self.FxGiantSpinBackOpts   -- 10-31 갈래 F: 층별 앵커·층 (먼지 = 몸 root · 몸 뒤)
            elseif kind == "spin_front" then text = self.FxGiantSpinOpts .. ";" .. self.FxGiantSpinFrontOpts   -- 칼날 = 몸 root +80px 위 · 몸 앞
            elseif kind == "dash" then text = self.FxGiantDashOpts
            elseif kind == "flurry" then text = self.FxGiantFlurryOpts
            elseif kind == "meteor_fall" or kind == "meteor_land" then text = self.FxGiantFireMeteorOpts
            elseif kind == "rift" then text = self.FxGiantRiftOpts
            elseif kind == "slam" then text = self.FxGiantSlamOpts
            elseif kind == "slam_front" then text = self.FxGiantSlamFrontOpts
            elseif kind == "roar" then text = self.FxGiantRoarOpts end
            for k, v in pairs(self:FxOpts(text)) do spec[k] = v end
            -- 장별 목록 키 (쉼표): orders = 장별 정렬(앞/뒤 층) · gxpx·gypx = 장별 앵커 오프셋(몸 화소 · 방패 문양 좌표표) · gx·gy = 같은 것을 칸으로
            for _, key in ipairs({ "orders", "gxpx", "gypx", "gx", "gy" }) do
                local v = spec[key]
                if type(v) == "number" then v = tostring(v) end
                if type(v) == "string" then
                    local list = {}
                    for x in string.gmatch(v, "[^,]+") do table.insert(list, tonumber(x) or 0) end
                    spec[key .. "List"] = list
                end
            end
            if type(spec.ms) == "number" then spec.ms = tostring(spec.ms) end
            if type(spec.ms) == "string" then
                -- 장별 지속(ms · 쉼표) → 초 목록 (빠른 폭발·긴 잔광을 균등 간격으로 펴지 않는다)
                local d = {}
                for v in string.gmatch(spec.ms, "[^,]+") do table.insert(d, (tonumber(v) or 0) / 1000) end
                spec.durs = d
            end
            if kind == "nova" and spec.impact ~= nil and spec.peak == nil then spec.peak = spec.impact end   -- 노바: 최대 반경 칸 = 타격 순간이 가장 진하고 뒤 잔광은 옅어진다 (긴 불투명 원판 대신)
            if spec.meteor ~= nil then
                -- B 메테오: impact 칸(1부터) 앞 = 낙하 · impact부터 = 착지 (한 연속본을 두 장면으로 · 장별 ms는 같은 범위로 SeqFx가 자른다) · 칸 번호가 틀리면 옛 1~2 / 3~6
                local n = #_Util:Frames(spec.ruids)
                local imp = spec.impact or 0
                if imp > 1 and imp <= n then
                    if spec.meteor == "fall" then spec.first = 1 spec.last = imp - 1 else spec.first = imp spec.last = n end
                else
                    if spec.meteor == "fall" then spec.first = 1 spec.last = 2 else spec.first = 3 spec.last = 6 end
                end
                spec.impact = nil   -- 서버 타격 시각은 RiteGiantMoves(fall)가 정한다 · 그림 타격 칸 어긋남 로그 없음
                -- 10-31 갈래 F 임시 크기: 착지 = 내용 폭을 판정 지름에(MeteorLandRef) · 낙하 = 계약 크기 × MeteorFallMul (가로세로 비 유지)
                if spec.meteor == "land" and self.MeteorLandRef > 0 then spec.ref = self.MeteorLandRef end
                if spec.meteor == "fall" and self.MeteorFallMul > 0 then spec.mul = self.MeteorFallMul end
            end
        end
        return spec
    end

    method number GiantFxImpactSec(string kind)
        -- 그림 계약의 타격 칸 시각(초 · 장별 시간 ms가 있을 때만): 첫 장부터 impact 칸 앞까지 지속 합 — 서버(RiteGiantMoves)가 피해 시각을 그림 정점에 맞춘다. 모르면 -1
        local spec = self:GiantFxSpec(kind)
        if spec.ruids == "" or spec.durs == nil or spec.impact == nil then return -1 end
        local n = #_Util:Frames(spec.ruids)
        if #spec.durs ~= n or spec.impact < 1 or spec.impact > n then return -1 end
        local t = 0
        for i = 1, spec.impact - 1 do t = t + spec.durs[i] end
        return t
    end

    method table GiantFxFrameSec(table spec, integer n, number seconds)
        -- 장 간격 규칙 (48 연출 V2 · 코드 감사 summon48-spectacle-code-audit): spec 명시가 우선, 없으면 옛 기본 max(0.04, seconds/n).
        --   옛 기본은 장 수가 늘면 재생이 길어진다(16장 0.5초 → 0.64초+) — 새 연속본은 sec·impact·cycle·span·fit 중 하나를 정해 지정 시간 안에 모든 장이 나오게 한다
        if spec.durs ~= nil and #spec.durs == n and n > 0 then return { sec = spec.durs[1], rule = "durs" } end   -- 장별 지속이 장 수와 맞으면 그대로 (노바 V2 20…90ms)
        if spec.sec ~= nil and spec.sec > 0 then return { sec = spec.sec, rule = "sec" } end
        if spec.impact ~= nil and spec.impact > 1 and spec.impact <= n and seconds > 0 then return { sec = seconds / (spec.impact - 1), rule = "impact" } end
        if spec.cycle ~= nil and spec.cycle > 0 then return { sec = spec.cycle / n, rule = "cycle" } end
        if spec.span ~= nil and spec.span > 0 then return { sec = spec.span / n, rule = "span" } end
        if spec.fit and seconds > 0 then return { sec = seconds / n, rule = "fit" } end
        return { sec = math.max(0.04, seconds / n), rule = "floor" }
    end

    method number BodySign(Entity anchor)
        -- 실제 렌더 몸의 좌우 (48 V2 방패 몸 부착 FX · 코덱스 c4a6c285): 원 PNG +x가 세계 +x면 1, 거울이면 -1 —
        --   화면 몸 = MotionSmoother 그림 대역(없으면 본체)의 Scale.x 부호 × SpriteRenderer.FlipX 반전 (거인 기본 그림은 왼쪽 · 오른쪽을 볼 때 Scale.x 음수)
        if anchor == nil or not isvalid(anchor) then return 1 end
        local body = _MotionSmoother:VisOf(anchor)
        local sgn = body.TransformComponent.Scale.x < 0 and -1 or 1
        local sr = body.SpriteRendererComponent
        if isvalid(sr) and sr.FlipX then sgn = -sgn end
        return sgn
    end

    @ExecSpace("ClientOnly")
    method void PlaySeq(string ruids, table o)
        -- 연속본 재생 (클라이언트): 첫 장부터 o.frameSec 간격 · o.loopSec > 0이면 그 시간 동안 처음으로 되돌아 반복 · 아니면 마지막 장을 o.holdSec 동안.
        --   장마다 SetTimerOnce. 다음 장을 먼저 걸고 앞 장은 0.03초 뒤에 지운다 — 지우고 거는 순서면 새 효과가 한 화면 늦게 떠 빈 화면이 낀다
        --   (Util.PlayFrames/PlayFramesLoop: SetTimerRepeat 첫 호출이 바로 와 첫 장을 건너뛰고 한 장짜리는 안 보임 · 교체마다 빈 화면 — 메이커 10-30 실측 S48-SPIN-PLAYBACK-01 · 공용 함수는 그대로 두고 거인 효과만 여기서).
        --   48 연출 V2: 다음 장 시각을 시작 시각 + 장 번호 × 간격으로 잡는다(타이머가 화면 주기로 늦게 와도 밀림이 쌓이지 않음 · 장을 건너뛰지 않고 늦으면 다음 화면에 바로 다음 장) ·
        --   o.anchor가 있으면 장마다 그 거인의 화면 몸(MotionSmoother 그림 대역) 위치 + o.offset을 따라간다 · o.peak 칸 = 불투명 1, 뒤 칸은 옅어짐 · 끝나면 [VRF] 실제 장 수·시간
        local me = _UserService.LocalPlayer
        local list = _Util:Frames(ruids)
        if #list == 0 or not isvalid(me) then return end
        local map = me.CurrentMap
        local n = #list
        local base = o.tint
        local frameSec = math.max(0.001, o.frameSec)
        local holdSec = o.holdSec or 0
        local loopSec = o.loopSec or 0
        local peak = o.peak or 0
        local durs = o.durs
        if durs ~= nil and #durs ~= n then durs = nil end
        local function dur(idx)
            -- idx 장이 떠 있는 시간: 장별 지속(o.durs)이 있으면 그 값 · 아니면 고른 간격 · 한 번 재생의 마지막 장은 holdSec까지 붙잡음
            local d = durs ~= nil and math.max(0.001, durs[idx]) or frameSec
            if loopSec <= 0 and idx == n then d = math.max(d, holdSec) end
            return d
        end
        local t0 = _UtilLogic.ElapsedSeconds
        local endAt = t0 + math.max(frameSec, loopSec)
        local planned = 0
        for q = 1, n do planned = planned + dur(q) end
        if loopSec > 0 then planned = math.max(frameSec, loopSec) end
        local latched = nil
        local curSign = o.sign0 or 1
        local function raw(idx)
            -- 지금 자리: 앵커(화면 몸) + offset + 장별 오프셋(o.frameOff · 방패 문양 좌표표)
            --   o.mirror(몸 부착 FX · bodypx): x 오프셋(o.mx + 장별 x)은 원 PNG 기준 — 장마다 실제 렌더 몸 부호(BodySign)를 곱한다 (추적 중 몸이 돌면 바로 반영)
            local d = (o.frameOff ~= nil and o.frameOff[idx] ~= nil) and o.frameOff[idx] or Vector3(0, 0, 0)
            local dx = d.x
            if o.mirror then
                if o.anchor ~= nil and isvalid(o.anchor) then curSign = self:BodySign(o.anchor) end
                dx = curSign * ((o.mx or 0) + d.x)
            end
            if o.anchor ~= nil and isvalid(o.anchor) then
                local p = _MotionSmoother:VisOf(o.anchor).TransformComponent.WorldPosition
                return Vector3(p.x + o.offset.x + dx, p.y + o.offset.y + d.y, 0)
            end
            local tx = 0
            local ty = 0
            if o.travel ~= nil then
                -- 10-31 메테오 L2 낙하: 시작 = pos + travel → travelSec 동안 pos로 (장을 바꿀 때마다 그 시각의 자리 · 클라이언트)
                local f = math.min(1, math.max(0, (_UtilLogic.ElapsedSeconds - t0) / math.max(0.01, o.travelSec or 0.01)))
                tx = o.travel.x * (1 - f)
                ty = o.travel.y * (1 - f)
            end
            return Vector3(o.pos.x + dx + tx, o.pos.y + d.y + ty, 0)
        end
        local function where(idx)
            -- 고정 장(o.latchIdx)에 도달하고 고정 시각(o.latchAt)도 지난 뒤(둘 중 늦은 쪽) 그 장 좌표 raw(latchIdx)로 고정 —
            --   타이머가 늦어 앞 장(5번째)이 250ms 뒤에 와도 그 장 좌표로 고정하지 않는다 (방패 함성: 정본 문양 좌표 index 5 보장)
            if latched ~= nil then return latched end
            local li = o.latchIdx or 0
            if li > 0 and idx >= li and o.latchAt ~= nil and o.latchAt >= 0 and _UtilLogic.ElapsedSeconds - t0 >= o.latchAt - 0.001 then
                latched = raw(li)
                return latched
            end
            return raw(idx)
        end
        local function optsAt(idx)
            local c = base
            if peak > 0 and n > 1 and idx >= peak then
                if idx == peak then c = Color(base.r, base.g, base.b, 1)
                else c = Color(base.r, base.g, base.b, base.a * (1 - 0.55 * (idx - peak) / math.max(1, n - peak))) end
            end
            local ord = (o.frameOrder ~= nil and o.frameOrder[idx] ~= nil) and o.frameOrder[idx] or o.order   -- 장별 앞/뒤 층 (함성 축광 앞 · 방사 뒤)
            local flip = o.flipX == true
            if o.mirror then flip = o.flipSpec == true and curSign * (o.native or 1) < 0 end   -- 몸 부착 FX: 위치와 같은 부호로 좌우 (고정 뒤엔 고정 순간 부호)
            return { SortingLayer = "MapLayer0", OrderInLayer = ord, Color = c, FlipX = flip }
        end
        local i = 1
        local shown = 1
        local nextAt = t0 + dur(1)   -- 다음 장 예정 시각 (시작 + 앞 장 지속 합 · 타이머가 늦어도 밀림이 쌓이지 않는다)
        local serial = _EffectService:PlayEffect(list[1], map, where(1), o.angle, o.scale, true, optsAt(1))
        local function drop(old)
            if old ~= 0 then _TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(old) end, 0.03) end
        end
        local function finish(old)
            drop(old)
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] giant fx play kind=%s shown=%d n=%d loop=%s elapsed=%.3f planned=%.3f", o.kind or "", shown, n, tostring(loopSec > 0), _UtilLogic.ElapsedSeconds - t0, planned)) end
        end
        local step = nil
        step = function()
            local old = serial
            serial = 0
            local alive = isvalid(me) and me.CurrentMap == map
            if loopSec > 0 then
                if not alive or _UtilLogic.ElapsedSeconds >= endAt - 0.001 then finish(old) return end
                i = i % n + 1
            else
                i = i + 1
                if i > n or not alive then finish(old) return end
            end
            serial = _EffectService:PlayEffect(list[i], map, where(i), o.angle, o.scale, true, optsAt(i))
            shown = shown + 1
            drop(old)
            nextAt = nextAt + dur(i)
            local due = nextAt
            if loopSec > 0 then due = math.min(due, endAt) end
            _TimerService:SetTimerOnce(step, math.max(0.01, due - _UtilLogic.ElapsedSeconds))
        end
        _TimerService:SetTimerOnce(step, dur(1))
    end

    method Color GiantFxTint(string kind)
        -- 거인별 고유 색 (48 §4-1 · §4-3 절제): 방패 강철 은·청백 · 대검 흙·돌 · 쌍칼 진홍 · 마법사 화염 주황·노랑 — 보라는 혼 포인트에만 (지금 그림에 임시로 칠한다 · K-4 새 그림은 자기 색)
        if kind == "slam" or kind == "slam_front" or kind == "roar" then return Color(0.8, 0.9, 1, 0.85) end
        if kind == "spin" or kind == "rift" or kind == "spin_back" or kind == "spin_front" then return Color(0.9, 0.72, 0.5, 0.85) end
        if kind == "dash" or kind == "flurry" then return Color(0.95, 0.25, 0.3, 0.8) end
        if kind == "nova" or kind == "nova_front" or kind == "meteor_land" or kind == "meteor_fall" or kind == "warn_fire" then return Color(1, 0.62, 0.25, 0.85) end
        return Color(1, 1, 1, 0.85)
    end

    @ExecSpace("Multicast")
    method void GiantMoveFx(string kind, Vector3 pos, number width, number height, number angle, number seconds)
        -- 거인 기술 한 장면 (모든 클라이언트 · 다른 맵이면 그리지 않음): 그림을 world 크기 width × height 칸으로 늘여 pos에 angle(도)로 — 반복 그림은 seconds 동안 (땅에 고정)
        self:GiantFxLocal(kind, pos, nil, Vector3(0, 0, 0), 1, width, height, angle, seconds)
    end

    @ExecSpace("Multicast")
    method void GiantMoveFxOn(string kind, Entity anchor, Vector3 offset, number facing, number width, number height, number angle, number seconds)
        -- GiantMoveFx와 같지만 거인 몸을 따라간다 (48 연출 V2: 회전 베기 칼날 호 · 함성 문양 · 내려찍기 접점 — 걸어도 몸에 붙어 있게). 위치 = 화면 몸 + offset (+ 그림 계약 ax × facing, ay) ·
        --   facing = 거인이 보는 방향(1 오른쪽 · -1 왼쪽) — 계약에 flip이 있으면 좌우만 뒤집는다(FlipX · 상하 회전·뒤집기 없음)
        if not isvalid(anchor) then return end
        local p = anchor.TransformComponent.WorldPosition
        self:GiantFxLocal(kind, Vector3(p.x + offset.x, p.y + offset.y, 0), anchor, offset, facing, width, height, angle, seconds)
    end

    @ExecSpace("ClientOnly")
    method void GiantFxLocal(string kind, Vector3 pos, Entity anchor, Vector3 offset, number facing, number width, number height, number angle, number seconds)
        -- 거인 기술 그림 (이 클라이언트): 연속본이 있으면 SeqFx · 비면 있는 효과로 (내려찍기·균열 = 흙먼지 · 회전 = 베기 궤적 · 예고 = 주황 테 고리 · 노바 = 퍼지는 얇은 고리 · 메테오 = 떨어지는 불꽃 + 착지 폭발 · 도발 = 머리 위 작은 고리)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local tint = self:GiantFxTint(kind)
        if kind == "warn_fire" or kind == "meteor_fall" or kind == "meteor_land" then
            -- 10-31 메테오 L2: 그 단계 자리(GameConst.FxGiantMeteor*)가 차 있으면 L2로 · 비면 아래 예전 연출 그대로 (낙하 angle = 시전자 기준 표적 쪽 0/180 · RiteGiantMoves.FireMeteor)
            if self:MeteorL2Fx(kind, pos, width, angle, seconds) then return end
            angle = 0   -- 예전 연출은 각 0 그대로 (표적 쪽 표시는 L2 낙하에서만)
        end
        if kind == "warn_fire" then
            -- 기도 메테오 예고 (10-31 갈래 E · S22): 다른 범위 예고처럼 Util.Telegraph 화염 원 — 판정 반경 테두리 + 바깥으로 차오름이 테두리에 닿으면 떨어진다
            --   (예전: 보라 회오리 고리 FxStorm을 주황으로 칠해 씀 → 범위 원과 모양이 달랐다). 거인은 BossPattern이 없어 흐린 고리(보스 실금 아님)
            local tid = _Util:Telegraph(self.Entity, Vector2(pos.x, pos.y), width / 2, "fire", seconds)
            local rec = _Util.Telegraphs[tid]
            if self.MeteorTelegraphOnly and rec ~= nil and rec.decal ~= nil and rec.decal ~= 0 then
                -- 10-31 갈래 F: 예고는 원 하나만 — 화염 속성 바닥 그림(납작한 용암 고리)은 지운다 (테두리·차오름 = 다른 범위 예고와 같은 그림·같은 크기 규칙)
                _EffectService:RemoveEffect(rec.decal)
                rec.decal = 0
            end
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] giant meteor telegraph r=%.2f sec=%.2f", width / 2, seconds)) end
            return
        end
        if kind == "spin" and self.FxGiantSpinFront ~= "" then
            -- 48 연출 V2 수평 회전: 뒤쪽 호(몸 뒤) + 앞쪽 호(몸 앞)를 같은 시각·같은 주기로 (둘째 독립 재출발 없음 — 한 번 부름에 두 층이 함께 시작)
            if self.FxGiantSpinBack ~= "" then self:SeqFx("spin_back", self:GiantFxSpec("spin_back"), pos, anchor, offset, facing, width, height, angle, seconds) end
            self:SeqFx("spin_front", self:GiantFxSpec("spin_front"), pos, anchor, offset, facing, width, height, angle, seconds)
            return
        end
        if kind == "nova" and self.FxGiantNovaV2 ~= "" and self.FxGiantNovaV2Front ~= "" then
            -- 노바 V2 두 층: 바닥 광선·외곽 파편(배우 뒤 order 1) + 작은 중앙 타원·흰 섬광(배우 앞 order 6) — 같은 지면 원점·같은 장별 시간으로 함께 시작 (둘이 합쳐 원본 장과 같음)
            self:SeqFx("nova", self:GiantFxSpec("nova"), pos, anchor, offset, facing, width, height, angle, seconds)
            self:SeqFx("nova_front", self:GiantFxSpec("nova_front"), pos, anchor, offset, facing, width, height, angle, seconds)
            return
        end
        if kind == "slam" and self.FxGiantSlamFront ~= "" then
            -- 48 연출 V2 내려찍기 두 층: 큰 분출·바닥 충격(몸 뒤 · FxGiantSlamSeq) + 접점 광(몸 앞 · FxGiantSlamFront) — 같은 접점·같은 시각에 함께 시작
            if self.FxGiantSlamSeq ~= "" then self:SeqFx("slam", self:GiantFxSpec("slam"), pos, anchor, offset, facing, width, height, angle, seconds) end
            self:SeqFx("slam_front", self:GiantFxSpec("slam_front"), pos, anchor, offset, facing, width, height, angle, seconds)
            return
        end
        local spec = self:GiantFxSpec(kind)
        if spec.ruids ~= "" then
            self:SeqFx(kind, spec, pos, anchor, offset, facing, width, height, angle, seconds)
            return
        end
        if kind == "meteor_fall" then
            -- 불꽃 핵 + 꼬리가 떨어진다 (그림 없을 때: 불꽃 화살 그림을 위에서 아래로 · 0.5초)
            self:ClipFxLocal(self.FxFlameShot, Vector3(pos.x, pos.y + 1.4, 0), 1.1, seconds, -90, tint)
            return
        end
        if kind == "spin" or kind == "flurry" then
            _EffectService:PlayEffect(_GameConst.FxSlash, self.Entity, pos, angle, Vector3(width * 0.12, width * 0.12, 1), false, { PlayRate = 1.8, Color = tint })
        elseif kind == "nova" then
            -- 그림 없을 때: 얇은 고리가 반경 0.5 → width/2로 seconds 안에 한 번 퍼진다 (속이 빈 고리 세 장 · 큰 면 금지 · 둘째 파동 없음)
            local steps = 3
            for k = 1, steps do
                local r = 0.5 + (width / 2 - 0.5) * k / steps
                _TimerService:SetTimerOnce(function()
                    if isvalid(me) and me.CurrentMap == self.Entity.CurrentMap then self:ClipFxLocal(self.FxStorm, pos, r / 1.2, math.max(0.12, seconds / steps), 0, tint) end
                end, seconds * (k - 1) / steps)
            end
        elseif kind == "meteor_land" then
            if _GameConst.FxSkillHexBurst ~= "" then
                _Util:PlayFramesHold(_GameConst.FxSkillHexBurst, me.CurrentMap, pos, 0, Vector3(width / 1.28, width / 1.28, 1), self.HexBurstFrameSec, self.HexBurstFrameSec + self.HexBurstHoldSec, self.HexBurstFadeSec, tint, 6)
            else
                _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos, 0, Vector3(width * 0.3, width * 0.3, 1), false, { Color = tint })
            end
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(width * 0.2, 0.3, 1), false, { Color = Color(0.55, 0.4, 0.3, 0.8) })
        elseif kind == "roar" then
            self:ClipFxLocal(self.FxStorm, pos, 0.3, math.max(0.2, seconds), 0, tint)
        else
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(width * 0.2, math.max(0.2, height * 0.1), 1), false, { Color = tint })
        end
    end

    @ExecSpace("ClientOnly")
    method boolean MeteorL2Fx(string kind, Vector3 pos, number width, number angle, number seconds)
        -- 10-31 마법사 거인 메테오 L2 (코덱스 meteor-L2-full · 4계열 × 8장): 그 단계 자리가 차 있으면 이 클라이언트에서 장을 돌리고 true · 비면 false(예전 연출)
        --   서버 타이머·피해 판정·반경·시각은 그대로 (부르는 쪽 RiteGiantMoves.FireMeteor의 seconds를 그대로 쓴다) · 장 순환·잔불 이음은 모두 클라이언트 SetTimerOnce
        --   warn_fire = 예고 바닥 타원 (영창+낙하 seconds 동안 반복 · 몸 뒤) — MeteorL2Rim이면 false를 돌려 Util.Telegraph 테두리도 함께
        --   meteor_fall = 낙하 (seconds 동안 순환 · 축 MeteorL2FallDeg를 따라 MeteorL2FallDist 칸 위에서 표적으로 · angle 90~270 = 표적이 시전자 왼쪽 → 시작을 왼쪽 위로·FlipX · 몸 앞)
        --   meteor_land = 착지 한 번 → 잔불 반복(불바닥 seconds 끝까지 · 적어도 한 바퀴) → 잔불 마지막 장 MeteorL2FadeSec 옅어짐 (잔불이 비면 착지 마지막 장을 seconds 끝까지)
        --   크기: 바닥 3계열 = 내용 560px(MeteorL2LandRef 10.0 × 56)이 판정 지름 width · 낙하 = 암석 폭 MeteorL2FallCoreW × MeteorFallMul × width/3.6
        local slot = ""
        local ms = 0
        if kind == "warn_fire" then
            slot = _GameConst.FxGiantMeteorTelegraph
            ms = _GameConst.FxGiantMeteorTelegraphMs
        elseif kind == "meteor_fall" then
            slot = _GameConst.FxGiantMeteorFall
            ms = _GameConst.FxGiantMeteorFallMs
        elseif kind == "meteor_land" then
            slot = _GameConst.FxGiantMeteorImpact
            ms = _GameConst.FxGiantMeteorImpactMs
        end
        if slot == nil or slot == "" or ms == nil or ms <= 0 then return false end
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return false end
        local map0 = me.CurrentMap
        local n = #_Util:Frames(slot)
        local tint = Color(1, 1, 1, self.MeteorL2Alpha)
        local k = (100 / 56) * width / self.MeteorL2LandRef
        local frameSec = ms / 1000
        local o = { kind = "meteor_l2_" .. kind, pos = pos, offset = Vector3(0, 0, 0), angle = 0, scale = Vector3(k, k, 1), frameSec = frameSec, holdSec = frameSec, loopSec = 0, tint = tint, order = 1, peak = 0, flipX = false }
        local face = 1
        local afterLoop = 0
        if kind == "warn_fire" then
            o.loopSec = math.max(frameSec, seconds)
            self:PlaySeq(slot, o)
        elseif kind == "meteor_fall" then
            local a = angle % 360
            if a > 90 and a < 270 then face = -1 end
            local kf = self.MeteorFallMul * self.MeteorL2FallCoreW * (100 / self.MeteorL2FallCorePx) * width / 3.6
            local rad = math.rad(self.MeteorL2FallDeg)
            o.scale = Vector3(kf, kf, 1)
            o.order = 6
            o.flipX = face < 0
            o.loopSec = math.max(frameSec, seconds)
            o.travel = Vector3(face * math.cos(rad) * self.MeteorL2FallDist, math.sin(rad) * self.MeteorL2FallDist, 0)
            o.travelSec = math.max(0.01, seconds)
            self:PlaySeq(slot, o)
        else
            local after = _GameConst.FxGiantMeteorAfterglow
            local afterMs = _GameConst.FxGiantMeteorAfterglowMs
            local hasAfter = after ~= nil and after ~= "" and afterMs ~= nil and afterMs > 0
            local impactSec = frameSec * n
            if not hasAfter then o.holdSec = math.max(frameSec, seconds - frameSec * (n - 1)) end
            self:PlaySeq(slot, o)
            if hasAfter then
                local aList = _Util:Frames(after)
                local aSec = afterMs / 1000
                afterLoop = math.max(aSec * #aList, seconds - impactSec)
                local fade = self.MeteorL2FadeSec
                _TimerService:SetTimerOnce(function()
                    local me1 = _UserService.LocalPlayer
                    if not isvalid(me1) or me1.CurrentMap ~= map0 then return end
                    local o2 = { kind = "meteor_l2_afterglow", pos = pos, offset = Vector3(0, 0, 0), angle = 0, scale = Vector3(k, k, 1), frameSec = aSec, holdSec = aSec, loopSec = afterLoop, tint = tint, order = 1, peak = 0, flipX = false }
                    self:PlaySeq(after, o2)
                    if fade > 0 then
                        _TimerService:SetTimerOnce(function()
                            local me2 = _UserService.LocalPlayer
                            if not isvalid(me2) or me2.CurrentMap ~= map0 then return end
                            _Util:PlayFramesHold(aList[#aList], map0, pos, 0, Vector3(k, k, 1), 0.01, 0, fade, tint, 1)
                        end, afterLoop)
                    end
                end, impactSec)
            end
        end
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] meteor L2 kind=%s n=%d ms=%d scale=%.3f order=%d face=%d flip=%s loop=%.2f travel=%.2f after=%.2f sec=%.2f w=%.2f", kind, n, ms, o.scale.x, o.order, face, tostring(o.flipX), o.loopSec, kind == "meteor_fall" and self.MeteorL2FallDist or 0, afterLoop, seconds, width)) end
        return kind ~= "warn_fire" or not self.MeteorL2Rim
    end

    @ExecSpace("ClientOnly")
    method void SeqFx(string kind, table spec, Vector3 pos, Entity anchor, Vector3 offset, number facing, number width, number height, number angle, number seconds)
        -- 48 연속본 한 층: 장 목록(first..last) · 크기 · 간격 규칙(GiantFxFrameSec)대로 PlaySeq (피해·반경·시각은 부르는 쪽 그대로 · 그림만)
        local order = spec.order or 6
        local tint = self:GiantFxTint(kind)
        if spec.own then tint = Color(1, 1, 1, 0.85) end   -- 새 그림은 자기 색 · 겹침 불투명 0.85 유지
        local all = _Util:Frames(spec.ruids)
        local list = {}
        for i = spec.first or 1, math.min(#all, spec.last or #all) do table.insert(list, all[i]) end
        local n = math.max(1, #list)
        local ruids = table.concat(list, "|")
        local face = (facing ~= nil and facing < 0) and -1 or 1
        local angle0 = angle
        local bodyScale = 0
        if spec.bodypx == true and anchor ~= nil and isvalid(anchor) then
            -- 몸 화소 밀도로 그린 그림(방패 full): 몸 엔티티 배율 그대로 · 몸 화소 오프셋(axpx·aypx) → 칸 = 화소 × 배율 / 100
            bodyScale = math.abs(anchor.TransformComponent.Scale.x)
        end
        local ax = spec.ax or 0
        local ay = spec.ay or spec.dy or 0
        if bodyScale > 0 and spec.axpx ~= nil then ax = spec.axpx * bodyScale / 100 end
        if bodyScale > 0 and spec.aypx ~= nil then ay = spec.aypx * bodyScale / 100 end
        if spec.anchorpx == true and bodyScale <= 0 and anchor ~= nil and isvalid(anchor) then
            -- 10-31 갈래 F 휠윈드 층 앵커: 몸 화소 오프셋(axpx·aypx · 위가 +)만 몸 배율로 칸으로 (그림 크기는 ref·cw 규칙 그대로 · 좌우 대칭 없음 = x 0)
            local k = math.abs(anchor.TransformComponent.Scale.x) / 100
            if spec.axpx ~= nil then ax = spec.axpx * k end
            if spec.aypx ~= nil then ay = spec.aypx * k end
        end
        -- 몸 부착 FX(bodypx · 방패 함성·내려찍기): 원 PNG 화소 → 세계 x 부호는 대상 방향(facing)이 아니라 실제 렌더 몸(BodySign)에서 — PlaySeq가 장마다 곱한다
        local mirror = bodyScale > 0
        local sign0 = mirror and self:BodySign(anchor) or face
        local sx = mirror and 0 or ax * face   -- 그림 계약 앵커(접점) — bodypx가 아니면 지금처럼 대상 방향으로 좌우 대칭
        local sy = ay
        local native = spec.face == "left" and -1 or 1
        local flipX = spec.flip == true and sign0 * native < 0   -- 좌우만 (FlipX) · 상하 뒤집기·통째 회전 없음 · 몸 부착이면 몸 부호와 같이
        if spec.px ~= nil and spec.px ~= 0.5 then
            -- 가로 피벗이 끝(0 = 시작 끝 · 1 = 앞 끝)인 그림: 부르는 쪽은 가운데를 주므로 길이 방향으로 옮긴다 (땅 가르기 시작점 · 돌진 머리)
            local rad = math.rad(angle)
            local d = (spec.px - 0.5) * width
            sx = sx + math.cos(rad) * d
            sy = sy + math.sin(rad) * d
        end
        if spec.rev == true then angle = (angle + 180) % 360 end   -- 10-31 갈래 F 돌진 B: 그림 앞쪽이 -x (피벗 = 시작점 · 시작점 이동은 위에서 원래 각으로 이미 계산) — 아래 upright가 세운 채 좌우만으로 바꾼다
        if spec.upright == true then
            -- 지면 그림(균열)은 세운 채로: 왼쪽으로 향하면 각을 반 바퀴 접고 FlipX (통째로 뒤집혀 분출이 아래로 가지 않게) — 시작점 이동은 위에서 원래 각으로 이미 계산
            local a = angle % 360
            if a > 90 and a < 270 then
                angle = a - 180
                flipX = not flipX
            end
        end
        local scale = Vector3(1, 1, 1)
        if spec.scale ~= nil and spec.scale > 0 then
            scale = Vector3(spec.scale, spec.scale, 1)   -- 계약 절대 배율
        elseif bodyScale > 0 then
            scale = Vector3(bodyScale, bodyScale, 1)   -- 몸과 같은 화소 밀도
        elseif spec.ref ~= nil then
            local k = (100 / 56) * width / spec.ref   -- 56px = 1칸에 그린 그림을 지름 width에 맞춤 (가로세로 비 유지 · 상하 뒤집기 없음)
            scale = Vector3(k, k, 1)
        elseif spec.cw ~= nil and spec.cw > 0 then
            local k = width / (spec.cw / 100)   -- 내용 가로 cw px = 부르는 쪽 width 칸 (가로세로 같은 배율 · 캔버스 전체를 width로 줄이지 않음)
            scale = Vector3(k, k, 1)
        elseif spec.stretch then
            scale = Vector3(width / (spec.w / 100), height / (spec.h / 100), 1)
        else
            local k = width / (spec.w / 100)
            scale = Vector3(k, k, 1)
        end
        if spec.mul ~= nil and spec.mul > 0 then scale = Vector3(scale.x * spec.mul, scale.y * spec.mul, 1) end   -- 계약 크기에 곱하는 배율 (메테오 낙하 MeteorFallMul)
        if spec.padpx ~= nil and spec.padpx ~= 0 then
            -- 피벗과 보이는 내용 사이 빈 화소(균열 앞 12px): 그만큼 길이 방향 뒤로 당겨 내용 시작을 부르는 쪽 시작점에 맞춘다 (원래 각 기준)
            local rad0 = math.rad(angle0)
            local d = spec.padpx * scale.x / 100
            sx = sx - math.cos(rad0) * d
            sy = sy - math.sin(rad0) * d
        end
        local lead = 0
        local latchAt = -1
        local latchIdx = 0
        if spec.durs ~= nil then
            -- 첫 장을 건너뛴 층(방패 슬램 뒤 층 = 4번째 장부터)은 앞 장 시간만큼 늦게 시작 — 시각은 몸·앞 층과 같게 유지
            if spec.meteor == nil then for i = 1, math.min(#spec.durs, (spec.first or 1) - 1) do lead = lead + spec.durs[i] end end   -- B 메테오 착지(7~12)는 부르는 쪽이 이미 착지 순간에 부른다 → 앞 장 시간만큼 늦추지 않음
            if spec.latch ~= nil and spec.latch > (spec.first or 1) then
                latchIdx = spec.latch - (spec.first or 1) + 1   -- 이 층 안에서 고정할 장 번호 (함성 6 = 몸 index 5)
                latchAt = 0
                for i = spec.first or 1, math.min(#spec.durs, spec.latch - 1) do latchAt = latchAt + spec.durs[i] end
            end
        end
        local durs = nil
        if spec.durs ~= nil then
            -- 장별 지속도 같은 범위(first..last)로 자른다
            durs = {}
            for i = spec.first or 1, math.min(#spec.durs, spec.last or #spec.durs) do table.insert(durs, spec.durs[i]) end
            if #durs ~= n then durs = nil end
        end
        local timing = self:GiantFxFrameSec({ durs = durs, sec = spec.sec, impact = spec.impact, cycle = spec.cycle, span = spec.span, fit = spec.fit }, n, seconds)
        local frameSec = timing.sec
        local frameOff = nil
        local frameOrder = nil
        local first = spec.first or 1
        local gx = spec.gxpxList or spec.gxList
        local gy = spec.gypxList or spec.gyList
        if gx ~= nil or gy ~= nil then
            -- 장별 앵커 오프셋(방패 문양 좌표표): 몸 화소면 몸 배율 ÷100 · 거인 방향으로 좌우 대칭 · 목록보다 뒤 장은 마지막 값
            local unit = 1
            if spec.gxpxList ~= nil or spec.gypxList ~= nil then unit = bodyScale > 0 and bodyScale / 100 or 0.01 end
            frameOff = {}
            for i = 1, n do
                local j = first + i - 1
                local fx = gx ~= nil and (gx[math.min(j, #gx)] or 0) or 0
                local fy = gy ~= nil and (gy[math.min(j, #gy)] or 0) or 0
                frameOff[i] = Vector3(fx * unit * (mirror and 1 or face), fy * unit, 0)   -- 몸 부착이면 부호 없이 (PlaySeq가 몸 부호를 곱함)
            end
        end
        if spec.ordersList ~= nil then
            frameOrder = {}
            for i = 1, n do frameOrder[i] = spec.ordersList[math.min(first + i - 1, #spec.ordersList)] or order end
        end
        local o = { kind = kind, pos = Vector3(pos.x + sx, pos.y + sy, 0), anchor = anchor, offset = Vector3(offset.x + sx, offset.y + sy, 0), frameOff = frameOff, frameOrder = frameOrder,
            angle = angle, scale = scale, frameSec = frameSec, holdSec = frameSec, loopSec = 0, tint = tint, order = order, peak = spec.peak or 0, flipX = flipX, durs = durs, latchAt = latchAt, latchIdx = latchIdx,
            mirror = mirror, mx = mirror and ax or 0, sign0 = sign0, flipSpec = spec.flip == true, native = native }
        if spec.loop then o.loopSec = math.max(frameSec, seconds)
        elseif durs ~= nil then
            o.holdSec = durs[n]
            if spec.hold then
                -- 10-31 갈래 F (B 메테오): 장별 ms + hold = 마지막 장을 부르는 쪽 seconds 끝까지 (낙하 0.5초 · 그을림 scorch)
                local pre = 0
                for i = 1, n - 1 do pre = pre + durs[i] end
                o.holdSec = math.max(durs[n], seconds - pre)
            end
        elseif spec.hold then o.holdSec = seconds - frameSec * (n - 1) end
        if kind == "slam" and spec.v2 and not spec.loop then o.holdSec = math.max(o.holdSec, self.GiantSlamHoldSec) end   -- 10-31 갈래 E S18: 분출 잔광 마지막 장 0.15~0.2초
        if lead > 0 then
            -- 예약 재생(슬램 뒤 층 120ms): 예약한 맵을 잡아 두고 그 맵·유효한 앵커일 때만 (맵 이동 뒤 새 맵에 옛 좌표로 생기지 않게 · 정적 경계)
            local me0 = _UserService.LocalPlayer
            local map0 = isvalid(me0) and me0.CurrentMap or nil
            _TimerService:SetTimerOnce(function()
                local me1 = _UserService.LocalPlayer
                if map0 == nil or not isvalid(me1) or me1.CurrentMap ~= map0 or not isvalid(self.Entity) or self.Entity.CurrentMap ~= map0 then return end
                if anchor ~= nil and not isvalid(anchor) then return end
                self:PlaySeq(ruids, o)
            end, lead)
        else
            self:PlaySeq(ruids, o)
        end
        local impactAt = 0
        if spec.impact ~= nil and spec.impact > 1 then
            if spec.durs ~= nil and #spec.durs >= spec.impact - 1 then for i = 1, spec.impact - 1 do impactAt = impactAt + spec.durs[i] end
            else impactAt = frameSec * (spec.impact - 1) end
        end
        if spec.impact ~= nil and timing.rule ~= "impact" and spec.impact > 1 and seconds > 0 and math.abs(impactAt - seconds) > 0.02 and not Environment:IsPublishedPlay() then
            -- 타격 칸 시각이 서버 타격(seconds)과 0.02초 넘게 어긋남 — 그림 계약 확인용
            log(string.format("[VRF] giant fx impact drift kind=%s impact=%d at=%.3f hit=%.3f", kind, spec.impact, impactAt, seconds))
        end
        local total = frameSec * (n - 1) + math.max(frameSec, o.holdSec)
        if durs ~= nil then
            total = 0
            for i = 1, n - 1 do total = total + durs[i] end
            total = total + math.max(durs[n], o.holdSec)
        end
        if spec.loop then total = o.loopSec end
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] giant fx kind=%s seq n=%d sec=%.3f rule=%s total=%.3f loop=%s hold=%s order=%d w=%.2f scale=%.2f follow=%s flip=%s impact_at=%.3f lead=%.3f latch=%.3f", kind, n, frameSec, timing.rule, total, tostring(spec.loop == true), tostring(spec.hold == true), order, width, scale.x, tostring(anchor ~= nil), tostring(flipX), impactAt, lead, latchAt)) end
    end

    @ExecSpace("ClientOnly")
    method void ClipFxLocal(string ruid, Vector3 pos, number scale, number seconds, number angle, Color tint)
        -- ClipFx와 같지만 이 클라이언트에서만 (Multicast 안에서 부르는 판) · 색 지정
        if ruid == "" then return end
        local serial = _EffectService:PlayEffect(ruid, self.Entity, pos, angle, Vector3(scale, scale, 1), true, { Color = tint })
        if serial == 0 then return end
        _TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(serial) end, math.max(0.1, seconds))
    end

    @ExecSpace("Multicast")
    method void ClipFxRate(string ruid, Vector3 pos, number scale, number seconds, number angle, number rate, Color tint)
        -- ClipFx와 같지만 재생 빠르기(PlayRate)·색을 준다 — 한 번 도는 클립을 seconds 길이로 늘여 잔상처럼 (10-31 갈래 E · 망령 질주 P18)
        local me = _UserService.LocalPlayer
        if ruid == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local serial = _EffectService:PlayEffect(ruid, self.Entity, pos, angle, Vector3(scale, scale, 1), false, { PlayRate = math.max(0.1, rate), Color = tint })
        if serial == 0 then return end
        self.ClipVisuals[serial] = true
        local key = "clip" .. tostring(serial)
        self.VisualTimers[key] = _TimerService:SetTimerOnce(function()
            _EffectService:RemoveEffect(serial)
            self.ClipVisuals[serial] = nil
            self.VisualTimers[key] = nil
        end, math.max(0.1, seconds))
    end

    @ExecSpace("Multicast")
    method void RangeRimFx(Vector3 pos, number radius, number seconds, Color tint)
        -- 효과 반경 원(P42 땅 찍기 범위 원 그림 · 256px = 2.56칸)을 seconds 동안 바닥(MapLayer0 1)에 깐다 — 그림이 판정보다 작거나 납작한 스킬의 범위 표시
        --   (10-31 갈래 E: 의식 2기 뼈 회오리 P39 4초 · 뼈 성찬 P35 0.6초). 맵 이동·사망은 ClearLocalVisuals(ClipVisuals)가 지운다
        local me = _UserService.LocalPlayer
        if _GameConst.SpriteSkillRangeRim == "" or radius <= 0 or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local s = 2 * radius / 2.56
        local serial = _EffectService:PlayEffect(_GameConst.SpriteSkillRangeRim, self.Entity, Vector3(pos.x, pos.y, 0), 0, Vector3(s, s, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = tint })
        if serial == 0 then return end
        self.ClipVisuals[serial] = true
        local key = "rim" .. tostring(serial)
        self.VisualTimers[key] = _TimerService:SetTimerOnce(function()
            _EffectService:RemoveEffect(serial)
            self.ClipVisuals[serial] = nil
            self.VisualTimers[key] = nil
        end, math.max(0.1, seconds))
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] range rim fx r=%.2f sec=%.2f", radius, seconds)) end
    end

    @ExecSpace("Multicast")
    method void DashGhostFx(Vector3 from, Vector3 to, boolean arrive)
        -- 망령 질주 잔상 (P18 · 10-31 9계열 GameConst.FxSkillDashGhost): 떠난 자리 → 도착 쪽 길 위 DashGhostCopies개 자리(0 · 1/3 · 2/3)에 같은 4장을 한 번씩,
        --   몸이 지나간 순서대로 DashGhostStepSec씩 늦게 (코덱스: 경로는 Claude 몫 · 자리 복사본은 그림을 더 그리지 않는다) · arrive(강화 「망령 도약」)면 도착 자리에도 하나.
        --   왼쪽으로 가면 가로 배율 음수(거울) · 피벗 0.5/0.1 = 발이라 발 자리에 그대로 · 클라이언트 타이머만 (서버 일 없음) · 맵 엔티티에 붙여 맵을 나가면 함께 지워진다
        local me = _UserService.LocalPlayer
        if _GameConst.FxSkillDashGhost == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local map = me.CurrentMap
        local spots = self:DashGhostSpots(arrive)
        local sx = (to.x < from.x and -1 or 1) * self.DashGhostScale
        local scale = Vector3(sx, self.DashGhostScale, 1)
        local frameSec = math.max(0.02, _GameConst.FxSkillDashGhostMs / 1000)
        for i, t in ipairs(spots) do
            local pos = from * (1 - t) + to * t
            local delay = (i - 1) * self.DashGhostStepSec
            local play = function()
                if isvalid(map) then _Util:PlayFrames(_GameConst.FxSkillDashGhost, map, pos, 0, scale, frameSec, Color(1, 1, 1, 1), self.DashGhostOrder) end
            end
            if delay <= 0 then play() else _TimerService:SetTimerOnce(play, delay) end
        end
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] dash ghost frames n=%d copies=%d ms=%d mirror=%s", #_Util:Frames(_GameConst.FxSkillDashGhost), #spots, _GameConst.FxSkillDashGhostMs, tostring(sx < 0))) end
    end

    method table DashGhostSpots(boolean arrive)
        -- 잔상 자리 (길 위 비율 · 순수 계산): 0, 1/n, …, (n−1)/n · 도약 강화면 1(도착 자리)을 더한다
        local n = math.max(1, self.DashGhostCopies)
        local spots = {}
        for i = 0, n - 1 do table.insert(spots, i / n) end
        if arrive then table.insert(spots, 1) end
        return spots
    end

    @ExecSpace("ServerOnly")
    method boolean WraithDash(Vector2 me, Vector2 dest)
        -- 망령 질주: 내 클라이언트가 이미 움직였다 (SkillBook.CastMove). 여기서는 무적·연출, 강화 「망령 자취」 피해·둔화, 「군단 질주」 소환수 도약
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        ---@type PlayerVitals
        local vitals = self.Entity:GetComponent("script.PlayerVitals")
        local seconds = _GameData.dashInvulnSec   -- 10-29 44 결정 4: 무적 +0.05초/랭크(흐릿한 형체)는 「뼈 껍질」로 바뀌어 고정 0.3초
        if vitals ~= nil then
            vitals.InvincibleUntil = math.max(vitals.InvincibleUntil, _UtilLogic.ElapsedSeconds + seconds)
            vitals:Blink(seconds)
        end
        if book ~= nil then self:AfterDash(book) end
        local trail = book ~= nil and book:Node("dash_trail") or 0
        if trail > 0 then
            local path = dest - me
            local len = path:Magnitude()
            if len > 0.1 then
                local mid = me + path * 0.5
                local hit = {}
                for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, mid, len * 0.5 + 0.6)) do
                    -- 지나간 길(선분)에서 0.6칸 안의 적
                    local unit = path * (1 / len)
                    local q = _Util:Pos2(m.Entity) - me
                    local along = math.max(0, math.min(len, q:Dot(unit)))
                    if (q - unit * along):Magnitude() <= 0.6 then table.insert(hit, m) end
                end
                ---@type PlayerAttack
                local atk = self.Entity:GetComponent("script.PlayerAttack")
                for _, m in ipairs(hit) do
                    if atk ~= nil and not m.IsDead then atk:SkillHitOne(m.Entity, "skill.dash_trail", book:DashTrailDamage(trail)) end
                    m:ApplyChill(1.5)
                end
            end
        end
        if book ~= nil and book:Node("dash_legion") > 0 then
            -- 소환수는 주인 서버 위치(조금 늦다)를 따라 자리를 잡으므로, 0.8초 동안 3칸 밖이면 곁으로 도약한다 (ShadowUnit 끈)
            local untilAt = _UtilLogic.ElapsedSeconds + 0.8
            for _, c in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
                ---@type ShadowUnit
                local u = c
                if u.OwnerPlayer == self.Entity then u.LeapUntil = untilAt end
            end
        end
        -- 10-31 갈래 E P18: 떠난 자리 섬광을 느리게 틀어 DashAfterSec(0.6초) 잔상으로 (예전 0.4초 · 기존 그림 그대로)
        if _GameConst.FxSkillDashGhost ~= "" then
            -- 10-31 9계열 P18: 푸른 고리 섬광 대신 코덱스 망령 잔상 4장을 떠난 자리 → 도착 쪽 길 위에 (강화 「망령 도약」이면 도착 자리에도)
            self:DashGhostFx(Vector3(me.x, me.y, 0), Vector3(dest.x, dest.y, 0), book ~= nil and book:Node("dash_blink") > 0)
        elseif book ~= nil and book:Node("dash_blink") > 0 then
            -- 강화 「망령 도약」: 떠난 자리·도착 자리에 섬광
            self:ClipFxRate(self.FxBlink, Vector3(me.x, me.y + 0.3, 0), 0.6, self.DashAfterSec, 0, self.DashAfterRate, Color(1, 1, 1, 0.9))
            self:ClipFx(self.FxBlink, Vector3(dest.x, dest.y + 0.3, 0), 0.6, 0.45, 0)
        else
            self:ClipFxRate(self.FxBlink, Vector3(me.x, me.y + 0.3, 0), 0.45, self.DashAfterSec, 0, self.DashAfterRate, Color(1, 1, 1, 0.9))
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void DrainVortex(Vector3 body)
        -- 생기 앗기 몸 소용돌이 (10-31 9계열 GameConst.FxSkillDrainVortex): 차면 4장을 DrainVortexSec 동안 반복(모든 클라이언트) · 비면 예전 보라 소용돌이 ClipFx(FxDrain 0.6 · 0.7초)
        if _GameConst.FxSkillDrainVortex == "" then
            self:ClipFx(self.FxDrain, body, 0.6, 0.7, 0)
            return
        end
        self:DrainVortexFrames(body)
    end

    @ExecSpace("Multicast")
    method void DrainVortexFrames(Vector3 body)
        -- 소용돌이 4장 반복 (장마다 FxSkillDrainVortexMs · 클라이언트 Util.PlayFramesLoop · 맵 엔티티에 붙인다) · 몸 앞 MapLayer0 6
        local me = _UserService.LocalPlayer
        if _GameConst.FxSkillDrainVortex == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local k = self.DrainVortexScale
        _Util:PlayFramesLoop(_GameConst.FxSkillDrainVortex, me.CurrentMap, body, 0, Vector3(k, k, 1), math.max(0.02, _GameConst.FxSkillDrainVortexMs / 1000), self.DrainVortexSec, Color(1, 1, 1, 1), 6)
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] drain vortex frames n=%d ms=%d sec=%.2f scale=%.2f", #_Util:Frames(_GameConst.FxSkillDrainVortex), _GameConst.FxSkillDrainVortexMs, self.DrainVortexSec, k)) end
    end

    @ExecSpace("ServerOnly")
    method boolean SoulDrain(Vector2 target, number damage)
        -- 가장 가까운 적 하나의 생명을 흡수 → 피해의 50% 회복, 소환수도 30% 회복 (마법)
        local m = self:Targets(target, 1.5)[1]
        if m == nil then
            -- 결투 상대 플레이어 흡수 (마법 저항 · PvP 배율)
            local foe = self:FoePlayers(target, 1.5)[1]
            if foe == nil then
                self:Fail("흡수할 대상이 없습니다")
                return false
            end
            ---@type PlayerStats
            local fs = foe:GetComponent("script.PlayerStats")
            ---@type PlayerVitals
            local fv = foe:GetComponent("script.PlayerVitals")
            local dealt = damage * _GameData.pvpDamageMult * (fs ~= nil and fs:PvpTakenMult() or 1)
            if fv ~= nil then fv:TakeDuelDamage(dealt, self.Entity) end
            ---@type PlayerStats
            local mine = self.Entity:GetComponent("script.PlayerStats")
            if mine ~= nil then mine:Heal(dealt * 0.5, 0) end
            self:Fx("drain", foe.TransformComponent.WorldPosition, 0.8)
            self:DrainVortex(foe.TransformComponent.WorldPosition + Vector3(0, 0.4, 0))
            return true
        end
        -- 44 §3-3: 예전엔 TakeDamage(히트 판정 밖)라 번쩍·정지 · 분노 신전 · 오라 피해 · 생명 약탈 · 피해 숫자가 빠졌다 → 다른 스킬처럼 HitEvent 경로로
        --   (마법 저항·낙인·레벨 차이는 PlayerAttack.CalcDamage가 본다). 회복은 실제로 들어간 피해 기준
        local dealt = self:DrainHit(m, damage)
        self:Fx("drain", m.Entity.TransformComponent.WorldPosition, 0.8)
        self:DrainVortex(m.Entity.TransformComponent.WorldPosition + Vector3(0, 0.4, 0))
        -- 강화 「혼 사슬」(나눔 자리 · 44 결정 4): 앞 대상에서 drainChainRange 안 가장 가까운 적으로 랭크만큼 이어진다 (이어진 적 피해 drainChainPct%)
        local chain = self:Node("drain_share")
        local links = 0
        if chain > 0 then
            local hit = { [m.Entity.Id] = true }
            local from = m.Entity
            for i = 1, chain do
                local nextFoe = nil
                local bestD = _GameData.drainChainRange
                for _, f in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, _Util:Pos2(from), _GameData.drainChainRange)) do
                    if not hit[f.Entity.Id] and not f.IsDead then
                        local d = (_Util:Pos2(f.Entity) - _Util:Pos2(from)):Magnitude()
                        if d < bestD then nextFoe, bestD = f, d end
                    end
                end
                if nextFoe == nil then break end
                hit[nextFoe.Entity.Id] = true
                self:StatusFx2("chain", from.TransformComponent.WorldPosition, nextFoe.Entity.TransformComponent.WorldPosition)
                dealt = dealt + self:DrainHit(nextFoe, damage * _GameData.drainChainPct / 100)
                from = nextFoe.Entity
                links = links + 1
            end
        end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then stats:Heal(dealt * 0.5, 0) end
        -- 보관함 그림자와 언데드 모두 같은 주인의 살아 있는 소환수다.
        for _, unit in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            if unit.OwnerPlayer == self.Entity and not unit.Dead and unit.Hp > 0 then
                unit.Hp = math.min(unit.MaxHp, unit.Hp + dealt * 0.3)
            end
        end
        log(string.format("[VRF] soul drain hit dealt=%.0f links=%d/%d", dealt, links, chain))
        return true
    end

    @ExecSpace("ServerOnly")
    method number DrainHit(Monster m, number damage)
        -- 생기 앗기 한 대상: PlayerAttack 판정(HitEvent)으로 때리고 실제로 들어간 피해를 돌려준다 (회복 계산용)
        ---@type PlayerAttack
        local atk = self.Entity:GetComponent("script.PlayerAttack")
        if atk == nil or m == nil or m.IsDead then return 0 end
        atk.LastSkillFinal = 0
        atk:SkillHitOne(m.Entity, "skill.soul_drain", damage)
        return atk.LastSkillFinal
    end

    @ExecSpace("ServerOnly")
    method boolean BoneStorm(number damage)
        -- 6초 동안 0.5초마다 주위 반경 StormRadius(1.2) (다시 쓰면 시간만 늘어난다)
        local map = self.Entity.CurrentMap
        self.StormUntil = _UtilLogic.ElapsedSeconds + 6
        self.StormDamage = damage
        self:Fx("storm", self.Entity.TransformComponent.WorldPosition, self.StormRadius)
        self:StormClipFx(6)
        if self.StormTimer ~= 0 then return true end
        local interval = 0.5 * (1 - 0.15 * self:Node("storm_fast"))   -- 강화 「회전 가속」
        self.StormTimer = _TimerService:SetTimerRepeat(function()
            if _UtilLogic.ElapsedSeconds > self.StormUntil or not _Util:IsAlive(self.Entity) or self.Entity.CurrentMap ~= map then
                _TimerService:ClearTimer(self.StormTimer)
                self.StormTimer = 0
                return
            end
            local p = _Util:Pos2(self.Entity)
            self:Hit(Vector2(p.x, p.y + 0.3), Vector2(self.StormRadius, 0), -1, "skill.bone_storm", self.StormDamage)
        end, interval)
        return true
    end

    -- ───────── 뼈 의식 2·3기 (기획서 43 §3-1 · 그림은 코덱스 납품 전 임시) ─────────

    @ExecSpace("ServerOnly")
    method boolean RiteWhirl(Vector2 center, number damage)
        -- 2기 「뼈 회오리」: 조준점에 riteWhirlSeconds 머무는 자리 장판. 0.5초마다 반경 riteWhirlRadius 안 적에게 damage + 가운데로 살짝 끈다
        --   (골격 감옥 「끌어당기는 뼈」의 0.3배 · 보스·최상위는 MonsterStatus.Knockback이 막는다). 자리 장판이라 투사체 5종과 성질이 겹치지 않는다.
        --   맵 이동·사망·취소(CancelActiveEffects)는 독안개와 같은 MistTimers로 끊긴다
        local epoch = self.EffectEpoch
        local map = self.Entity.CurrentMap
        local radius = _GameData.riteWhirlRadius
        local seconds = _GameData.riteWhirlSeconds
        local total = math.max(1, math.floor(seconds / 0.5 + 0.001))
        local ticks = 0
        local pulled = 0
        local tick = function()
            ticks = ticks + 1
            self:Hit(Vector2(center.x, center.y + 0.3), Vector2(radius, 0), -1, "skill.bone_rite_whirl", damage)
            for _, m in ipairs(self:Targets(center, radius + 0.6)) do
                local to = center - _Util:Pos2(m.Entity)
                local status = m:Status()
                if status ~= nil and to:Magnitude() > 0.4 then
                    status:Knockback(to, _GameData.riteWhirlPull)
                    pulled = pulled + 1
                end
            end
        end
        tick()
        local timerId = 0
        timerId = _TimerService:SetTimerRepeat(function()
            if not _Util:IsAlive(self.Entity) or self.Entity.CurrentMap ~= map or epoch ~= self.EffectEpoch or ticks >= total then
                _TimerService:ClearTimer(timerId)
                self.MistTimers[timerId] = nil
                log(string.format("[VRF] rite whirl end ticks=%d/%d pulled=%d", ticks, total, pulled))
                return
            end
            tick()
        end, 0.5)
        self.MistTimers[timerId] = true
        -- 임시 그림: 뼈 폭풍 회오리 고리 + 끌어당김 오라 (코덱스 「뼈 회오리 회전 8프레임 + 바닥 자국」이 오면 바꾼다)
        self:Fx("lure", Vector3(center.x, center.y, 0), radius)
        if _GameConst.FxSkillRiteWhirl ~= "" then
            -- 10-31 9계열 P39: 코덱스 뼈 회오리 회전 8장 반복 + 바닥 자국 1장 (위에서 본 원 · 내용 폭 = 판정 지름) — 그림이 판정 원과 같은 크기라 임시 범위 원(P42)은 깔지 않는다
            self:RiteWhirlFx(Vector3(center.x, center.y, 0), radius, seconds)
        else
            self:ClipFx(self.FxStorm, Vector3(center.x, center.y + 0.15, 0), 0.8 * radius / 1.2, seconds, 0)
            -- 10-31 갈래 E P39: 회오리 그림(3.7×1.18칸)이 판정 원(지름 3)보다 납작하다 → 판정 반경 원을 같은 시간 동안 함께 (전용 그림 전 임시)
            self:RangeRimFx(Vector3(center.x, center.y, 0), radius, seconds, Color(0.8, 0.66, 1, self.WhirlRimAlpha))
        end
        log(string.format("[VRF] rite whirl start dmg=%.0f r=%.1f ticks=%d", damage, radius, total))
        return true
    end

    @ExecSpace("Multicast")
    method void RiteWhirlFx(Vector3 pos, number radius, number seconds)
        -- 의식 2기 뼈 회오리 그림 (10-31 9계열 GameConst.FxSkillRiteWhirl 8장 · FxSkillRiteWhirlTrace 1장): 회전 8장을 seconds 동안 반복(몸 앞) + 바닥 자국을 같은 시간 깔고 끝에 옅어짐.
        --   둘 다 내용 폭(RiteWhirlContentPx · RiteWhirlTraceContentPx)이 판정 지름(2×radius)이 되게 · 맵 엔티티에 붙인다 (클라이언트만 · 맵을 나가면 함께 지워진다)
        local me = _UserService.LocalPlayer
        if _GameConst.FxSkillRiteWhirl == "" or not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local map = me.CurrentMap
        local f = math.max(0.02, _GameConst.FxSkillRiteWhirlMs / 1000)
        if _GameConst.FxSkillRiteWhirlTrace ~= "" then
            local t = self:RiteWhirlScale(radius, self.RiteWhirlTraceContentPx)
            local fade = math.min(self.RiteWhirlTraceFadeSec, seconds * 0.5)
            _Util:PlayFramesHold(_GameConst.FxSkillRiteWhirlTrace, map, pos, 0, Vector3(t, t, 1), f, seconds - fade, fade, Color(1, 1, 1, 1), self.RiteWhirlTraceOrder)
        end
        local s = self:RiteWhirlScale(radius, self.RiteWhirlContentPx)
        _Util:PlayFramesLoop(_GameConst.FxSkillRiteWhirl, map, pos, 0, Vector3(s, s, 1), f, seconds, Color(1, 1, 1, 1), self.RiteWhirlOrder)
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] rite whirl frames n=%d ms=%d sec=%.1f scale=%.3f trace=%s", #_Util:Frames(_GameConst.FxSkillRiteWhirl), _GameConst.FxSkillRiteWhirlMs, seconds, s, tostring(_GameConst.FxSkillRiteWhirlTrace ~= ""))) end
    end

    method number RiteWhirlScale(number radius, number contentPx)
        -- 회오리·자국 배율 (가로세로 같은 값 · 순수 계산): 그림 내용 폭(px)이 판정 지름 2×radius(칸)와 같게
        return 2 * radius / (math.max(1, contentPx) / 100)
    end

    @ExecSpace("ServerOnly")
    method boolean RiteArrows(table used, Vector2 target, number damage, Entity lock)
        -- 3기 「뼈 화살」: 바친 해골 셋이 제자리에서 riteArrowGap 간격으로 큰 뼈 화살을 한 발씩 쏘고 무너진다.
        --   고른 적(lock — 시전 순간 정한 수동 조준)이 있으면 셋 다 그 적에게 몰려 꽂힌다 (관통·튕김 없음 — 뼈 창 관통·골편 부채꼴과 다른 「몰림 순간 화력」).
        --   마지막 발(skill.bone_rite_push)은 맞은 적을 약 0.5칸 밀친다 (PlayerAttack.SkillHitExtra). 대상이 없으면 조준점 쪽으로 곧게 날아 처음 맞은 적에서 멈춘다
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local count = #used
        for i, u in ipairs(used) do
            local index = i
            local from = u.pos
            ---@type ShadowUnit
            local unit = u.unit
            _TimerService:SetTimerOnce(function()
                if isvalid(unit.Entity) then
                    from = _Util:Pos2(unit.Entity)
                    self:ConsumedDust(from, 0.45, 0.5)   -- 쏜 해골이 무너지는 뼛가루 (10-31 9계열 FxSkillConsumedDust · 발 앵커 · 비면 골편 명중 → 보라 파열)
                    unit.Entity:Destroy()
                end
                if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then return end
                local aim = target
                if isvalid(lock) then aim = _Util:Pos2(lock) end
                local dir = aim - from
                if dir:Magnitude() < 0.01 then dir = Vector2(owner.PlayerControllerComponent.LookDirectionX >= 0 and 1 or -1, 0) end
                dir = dir:Normalize()
                local start = from + Vector2(0, 0.3) + dir * 0.3
                self.ShotCount = self.ShotCount + 1
                local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "BoneRiteArrow_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
                if not isvalid(shot) then return end
                local last = index == count
                local info = last and "skill.bone_rite_push" or "skill.bone_rite_arrow"
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    -- 44-1 A: 마지막 발은 한 단 크게 + 맞은 자리 큰 뼛가루 충격(Projectile.HitFx "rite_push")
                    if _GameConst.FxSkillRiteArrow ~= "" then
                        -- 10-31 9계열: 코덱스 의식 뼈 화살 4장 (오른쪽 기준 · 비행 중 FxSkillRiteArrowMs 순환 · 왼쪽 FlipY = Projectile.MirrorSkin) · 마지막 발 RiteArrowLastMul배
                        proj:Skin(_GameConst.FxSkillRiteArrow, self.RiteArrowScale * (last and self.RiteArrowLastMul or 1))
                    else
                        -- 예전 임시 그림: 골편 궤적을 크게 · 뼈 색
                        proj:Skin(self.FxShardShot, last and 1.38 or 1.1)
                    end
                    proj:Tint(Color(1, 0.95, 0.82, 1))
                    proj.Style = last and "rite_push" or "rite"
                    if not last then proj.HitKind = "bone" end   -- 10-31 9계열: 앞 두 발 명중 = 뼈 명중 2장 (마지막 발은 rite_push 충격 그대로)
                    if isvalid(lock) then proj.Lock = lock end
                    proj.MaxHits = 1
                    proj:Launch(owner, dir, 13, 7.5, damage, info, false)
                end, function() if isvalid(shot) then shot:Destroy() end end)
                log(string.format("[VRF] rite arrow %d/%d lock=%s dmg=%.0f info=%s", index, count, tostring(isvalid(lock)), damage, info))
            end, (i - 1) * _GameData.riteArrowGap + ((i == count and count > 1) and self.RiteLastArrowDelay or 0))
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void CancelActiveEffects()
        self.EffectEpoch = self.EffectEpoch + 1
        if self.StormTimer ~= 0 then _TimerService:ClearTimer(self.StormTimer) end
        self.StormTimer = 0
        self.StormUntil = 0
        for id, _ in pairs(self.MistTimers) do _TimerService:ClearTimer(id) end
        self.MistTimers = {}
        local map = self.Entity.CurrentMap
        if isvalid(map) then
            for _, comp in ipairs(map:GetChildComponentsByTypeName("script.Projectile", true)) do
                if comp.Owner == self.Entity and isvalid(comp.Entity) then comp.Entity:Destroy() end
            end
        end
        self:ClearPersistentVisuals()
    end

    method void OnEndPlay()
        -- 서버 타격 타이머와 클라이언트 입자의 수명을 따로 정리한다.
        if self:IsServer() then
            if self.StormTimer ~= 0 then _TimerService:ClearTimer(self.StormTimer) self.StormTimer = 0 end
            for id, _ in pairs(self.MistTimers) do _TimerService:ClearTimer(id) end
            self.MistTimers = {}
        else self:ClearLocalVisuals() end
    end

    @ExecSpace("Multicast")
    method void ClearPersistentVisuals()
        -- 사망/이동에서는 남은 장판과 몸 주위 폭풍을 모두 지운다.
        self:ClearLocalVisuals()
    end

    @ExecSpace("ClientOnly")
    method void ClearLocalVisuals()
        -- 입자와 그 입자를 지울 예정이었던 타이머도 함께 해제한다.
        for serial, _ in pairs(self.MistVisuals) do _ParticleService:RemoveParticle(serial) end
        for serial, _ in pairs(self.DrainVisuals) do _ParticleService:RemoveParticle(serial) end
        for serial, _ in pairs(self.BlastVisuals) do _ParticleService:RemoveParticle(serial) end
        if self.StormVisual ~= 0 then _ParticleService:RemoveParticle(self.StormVisual) end
        for serial, _ in pairs(self.ClipVisuals) do _EffectService:RemoveEffect(serial) end
        if self.StormClip ~= 0 then _EffectService:RemoveEffect(self.StormClip) end
        self.ClipVisuals = {}
        self.StormClip = 0
        self:StopStormOrbit()
        self:DropRangeCircle()
        if self.UltTimer ~= 0 then _TimerService:ClearTimer(self.UltTimer) self.UltTimer = 0 end
        local dim = _EntityService:GetEntityByPath("/ui/AimHUD/UltDim")
        if self.Entity == _UserService.LocalPlayer and isvalid(dim) then dim.Enable = false end
        -- 궁극기 카메라 펀치 도중에 끊겼으면 줌을 바로 되돌린다 (타이머를 아래에서 지운다)
        if self.VisualTimers["ultzoom"] ~= nil and self.Entity == _UserService.LocalPlayer then _CameraService:ZoomTo(_GameData.cameraZoom, 0.1) end
        for _, timer in pairs(self.VisualTimers) do _TimerService:ClearTimer(timer) end
        self.MistVisuals = {}
        self.DrainVisuals = {}
        self.BlastVisuals = {}
        self.VisualTimers = {}
        self.StormVisual = 0
    end

    -- ───────── 저주·군령 ─────────

    @ExecSpace("ServerOnly")
    method boolean Curse(Vector2 target, string kind, number pct, number radius, number duration)
        -- 범위는 장비 「저주 범위 %」만큼 넓어진다. 범위 안에 적이 없으면 실패
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then radius = radius * (1 + stats.BonusCurse / 100 + 0.15 * self:Node("curse_area")) end   -- 장비 + 강화 「저주 범위」
        local list = self:Targets(target, radius)
        local foes = self:FoePlayers(target, radius)
        if #list == 0 and #foes == 0 then
            self:Fail("저주할 적이 범위 안에 없습니다")
            return false
        end
        for _, m in ipairs(list) do m:ApplyCurseFrom(kind, pct, duration, self.Entity) end
        -- 선택 보상 2차 저주 「이중 저주」: 어느 저주든 걸면 약화의 낙인(받는 피해 +10 · 15 · 20%)이 함께 (낙인 자신은 제외)
        local twin = self:ChoiceTier(2, "curse")
        if twin > 0 and kind ~= "amp" then for _, m in ipairs(list) do m:ApplyCurseFrom("amp", 5 + 5 * twin, duration, self.Entity) end end
        for _, foe in ipairs(foes) do
            ---@type PlayerStats
            local fs = foe:GetComponent("script.PlayerStats")
            if fs ~= nil then fs:ApplyPvpCurse(kind, pct, duration * _GameData.pvpDurationMul, self.Entity) end
        end
        self:Fx(kind, Vector3(target.x, target.y, 0), radius)
        return true
    end

    @ExecSpace("ServerOnly")
    method table CurseTargets(Vector2 target, number radius)
        -- Curse와 같은 범위(장비 「저주 범위 %」 + 강화 「저주 범위」)의 몬스터 — 저주 강화가 같은 적에게 덧걸 때 쓴다
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then radius = radius * (1 + stats.BonusCurse / 100 + 0.15 * self:Node("curse_area")) end
        return self:Targets(target, radius)
    end

    @ExecSpace("ServerOnly")
    method void AfterTerror(table list, number terrorSeconds, number confuseSeconds)
        -- 강화 「광란」: 공포가 끝나는 순간 살아 있는 적에게 혼란 (보스는 MonsterStatus가 막는다). 맵을 옮기거나 다시 시전하면 취소
        local epoch = self.EffectEpoch
        local map = self.Entity.CurrentMap
        _TimerService:SetTimerOnce(function()
            if epoch ~= self.EffectEpoch or self.Entity.CurrentMap ~= map then return end
            local n = 0
            for _, m in ipairs(list) do
                if isvalid(m.Entity) and not m.IsDead and m.Entity.CurrentMap == map then
                    m:ApplyCurseFrom("confuse", 0, confuseSeconds, self.Entity)
                    n = n + 1
                end
            end
            log(string.format("[VRF] terror frenzy confuse %d for %.1fs", n, confuseSeconds))
        end, terrorSeconds)
    end

    @ExecSpace("ServerOnly")
    method boolean BonePrison(Vector2 target, number seconds)
        -- 조준점 반경 1.3 안의 적을 뼈 장벽으로 묶는다 (이동만 막고 공격은 가능)
        local radius = 1.3 * (1 + 0.15 * self:Node("prison_wide"))   -- 강화 「넓은 감옥」
        local pullRank = self:Node("prison_pull")
        if pullRank > 0 then return self:PullThenPrison(target, seconds, radius, 2.4 + 0.3 * pullRank) end
        local list = self:Targets(target, radius)
        local foes = self:FoePlayers(target, radius)
        if #list == 0 and #foes == 0 then
            self:Fail("가둘 적이 범위 안에 없습니다")
            return false
        end
        for _, m in ipairs(list) do m:ApplyRoot(seconds, self.Entity) end
        self:PrisonHeld(list, seconds)
        for _, foe in ipairs(foes) do
            ---@type PlayerStats
            local fs = foe:GetComponent("script.PlayerStats")
            if fs ~= nil then fs:ApplyRoot(seconds * _GameData.pvpDurationMul) end
        end
        self:Fx("prison", Vector3(target.x, target.y, 0), radius)
        return true
    end

    @ExecSpace("ServerOnly")
    method void PrisonHeld(table list, number seconds)
        -- 묶인 적마다 발밑 장벽 그림 (10-31 갈래 E2 P25): 실제 묶인 시간(보스는 절반 · MonsterStatus.RootUntil)만큼 — 묶이지 않은 적(이미 죽음)은 건너뜀
        if _GameConst.FxSkillPrisonHold == "" then return end
        local now = _UtilLogic.ElapsedSeconds
        for _, m in ipairs(list) do
            local status = m:Status()
            local held = status ~= nil and status.RootUntil - now or 0
            if held > 0.05 and isvalid(m.Entity) then self:PrisonFx(m.Entity, held) end
        end
    end

    @ExecSpace("Multicast")
    method void PrisonFx(Entity target, number seconds)
        -- 골격 감옥 묶임 (모든 클라이언트): 표적 발밑에 장벽 8장을 seconds 동안 반복(PrisonFrameSec) → 풀림 2장 한 번. 층 PrisonOrder(몸 앞 · 얼굴·가운데 창은 그림이 비움)
        --   instigator = 표적 — 표적이 사라지면 Util이 지운다
        local me = _UserService.LocalPlayer
        if _GameConst.FxSkillPrisonHold == "" or not isvalid(me) or not isvalid(target) or me.CurrentMap ~= target.CurrentMap then return end
        local p = target.TransformComponent.WorldPosition
        local pos = Vector3(p.x, p.y, 0)
        local s = Vector3(self.PrisonScale, self.PrisonScale, 1)
        _Util:PlayFramesLoop(_GameConst.FxSkillPrisonHold, target, pos, 0, s, self.PrisonFrameSec, seconds, Color(1, 1, 1, 1), self.PrisonOrder)
        local key = "prison" .. tostring(target.Id)
        if self.VisualTimers[key] ~= nil then _TimerService:ClearTimer(self.VisualTimers[key]) end
        self.VisualTimers[key] = _TimerService:SetTimerOnce(function()
            self.VisualTimers[key] = nil
            if _GameConst.FxSkillPrisonRelease == "" or not isvalid(target) then return end
            local me1 = _UserService.LocalPlayer
            if not isvalid(me1) or me1.CurrentMap ~= target.CurrentMap then return end
            local q = target.TransformComponent.WorldPosition
            _Util:PlayFramesHold(_GameConst.FxSkillPrisonRelease, target, Vector3(q.x, q.y, 0), 0, s, self.PrisonReleaseSec, self.PrisonReleaseSec, 0, Color(1, 1, 1, 1), self.PrisonOrder)
        end, math.max(0.05, seconds))
        if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] prison fx %s sec=%.2f", target.Name, seconds)) end
    end

    @ExecSpace("ServerOnly")
    method boolean PullThenPrison(Vector2 target, number seconds, number radius, number pullRadius)
        -- 강화 「끌어당기는 뼈」(10-28 유인 스킬을 합침): 반경 pullRadius 안 적을 조준점으로 두 번 끌어당긴 뒤 0.45초에 감옥 (보스는 Knockback이 막는다)
        local list = self:Targets(target, pullRadius)
        if #list == 0 and #self:FoePlayers(target, radius) == 0 then
            self:Fail("가둘 적이 범위 안에 없습니다")
            return false
        end
        local epoch = self.EffectEpoch
        local map = self.Entity.CurrentMap
        local pull = function()
            for _, m in ipairs(self:Targets(target, pullRadius + 0.4)) do
                local to = target - _Util:Pos2(m.Entity)
                local status = m:Status()
                if status ~= nil and to:Magnitude() > 0.5 then status:Knockback(to, 0.9) end
            end
        end
        pull()
        _TimerService:SetTimerOnce(function()
            if epoch ~= self.EffectEpoch or self.Entity.CurrentMap ~= map then return end
            pull()
        end, 0.25)
        _TimerService:SetTimerOnce(function()
            if epoch ~= self.EffectEpoch or self.Entity.CurrentMap ~= map then return end
            local held = self:Targets(target, radius + 0.3)
            for _, m in ipairs(held) do m:ApplyRoot(seconds, self.Entity) end
            self:PrisonHeld(held, seconds)
            for _, foe in ipairs(self:FoePlayers(target, radius)) do
                ---@type PlayerStats
                local fs = foe:GetComponent("script.PlayerStats")
                if fs ~= nil then fs:ApplyRoot(seconds * _GameData.pvpDurationMul) end
            end
            self:Fx("prison", Vector3(target.x, target.y, 0), radius)
            log(string.format("[VRF] prison pull %d → held %d", #list, #held))
        end, 0.45)
        self:Fx("lure", Vector3(target.x, target.y, 0), pullRadius)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean SoulTorrent(Vector2 me, Vector2 target, number damage, integer count)
        -- 조준 방향 부채꼴로 유도 영혼 count발. 각자 가까운 적을 쫓아가 하나에 맞고 사라진다.
        local dir = target - me
        if dir:Magnitude() < 0.01 then dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX, 0) end
        local base = math.atan(dir.y, dir.x)
        local owner = self.Entity
        local map = owner.CurrentMap
        local epoch = self.EffectEpoch
        local launched = 0
        for i = 1, count do
            local spread = count > 1 and ((i - 1) / (count - 1) - 0.5) * math.rad(60) or 0
            local d = Vector2(math.cos(base + spread), math.sin(base + spread))
            local start = me + Vector2(0, 0.3) + d * 0.35
            self.ShotCount = self.ShotCount + 1
            local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "Soul_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), map)
            if isvalid(shot) then
                launched = launched + 1
                _Util:AfterSpawn(shot, "script.Projectile", function(comp)
                    ---@type Projectile
                    local proj = comp
                    if epoch ~= self.EffectEpoch or not _Util:IsAlive(owner) or owner.CurrentMap ~= map then shot:Destroy() return end
                    -- 외형(혼 구슬 청록 · 촘촘한 혼 꼬리 · 유도 5)·속도 = 영혼 마법사와 공용 (MageBolts.Configure · 48 §2-6)
                    local speed = _MageBolts:Configure(proj, "soul")
                    proj:Launch(owner, d, speed, 7, damage, "skill.soul_torrent", false)
                end, function() if isvalid(shot) then shot:Destroy() end end)
            end
        end
        if launched == 0 then
            self:Fail("영혼을 날리지 못했습니다")
            return false
        end
        self:Fx("torrent", Vector3(me.x, me.y + 0.3, 0), 0.6)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean DeathWave(number damage)
        -- 내 주위 반경 3.5 전방위 파동. 범위에 적이 없어도 시전은 된다 (먼저 깔아 두는 용도)
        local p = _Util:Pos2(self.Entity)
        self:Hit(Vector2(p.x, p.y + 0.3), Vector2(3.5, 0), -1, "skill.death_wave", damage)
        self:Fx("wave", Vector3(p.x, p.y, 0), 3.5)
        self:C7Clip("wave", Vector3(p.x, p.y, 0), 0.3, 2.6, 0.6)   -- 10-31 C 7종 죽음의 파동 4장 (비면 예전 메이플 마법진 폭발)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean ShadowSacrifice(Vector2 target, number damage)
        -- 조준점에 가장 가까운 내 그림자 1기를 터뜨린다 (반경 1.8). 그림자는 죽은 것처럼 보관함으로 돌아가 재소환 대기
        -- 44-3 B 대상 고르기: 플레이어가 고른 그림자(PC 클릭 · 소환수 띠 카드 — ShadowCommander.PickedShadow)가 있으면 그것부터
        local best = self:Commander():PickedShadow()
        local picked = best ~= nil
        local bestDist = math.huge
        if best == nil then
            for _, unit in ipairs(self:Commander():GetUnits()) do
                if not unit.Dead and unit.Hp > 0 then
                    local d = (_Util:Pos2(unit.Entity) - target):Magnitude()
                    if d < bestDist then best = unit bestDist = d end
                end
            end
        end
        if best == nil then
            self:Fail("희생할 그림자가 없습니다 — 그림자를 먼저 소환하세요")
            return false
        end
        local q = _Util:Pos2(best.Entity)
        local total = damage + best.Atk * 2
        self:Hit(Vector2(q.x, q.y + 0.2), Vector2(1.8, 0), -1, "skill.shadow_sacrifice", total)
        -- 10-31 갈래 E2 P31: 희생 8장 — 판정 반경 1.8에 맞춘 바닥 중심(발 자리) · 배우 뒤 층 SacrificeOrder(1) · 75ms
        if _GameConst.FxSkillSacrifice ~= "" then self:FramesFx(_GameConst.FxSkillSacrifice, Vector3(q.x, q.y, 0), 2 * 1.8 / (self.SacrificeContentPx / 100), self.SacrificeFrameSec, self.SacrificeFrameSec + self.SacrificeHoldSec, self.SacrificeFadeSec, self.SacrificeOrder) end
        self:Fx("sacrifice", Vector3(q.x, q.y, 0), 1.8)
        log(string.format("[VRF] sacrifice target=%s picked=%s", best.ShadowId, tostring(picked)))
        self:Commander():ClearPick()
        self:Commander():OnUnitDied(best.ShadowId)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean ElitePromote(number multiplier)
        -- 소환 중인 그림자 중 공격력이 가장 높은 1기를 정예로 (한 번만). 정예는 동시에 1기 (강화 「정예 둘」이면 2기)
        -- 44-3 B 대상 고르기: 플레이어가 고른 그림자(아직 정예가 아니면)를 먼저 — 없으면 지금 규칙(공격력 최고)
        local best = nil
        local promoted = 0
        for _, unit in ipairs(self:Commander():GetUnits()) do
            if unit.Promoted and not unit.Dead and unit.Hp > 0 then promoted = promoted + 1 end
            if not unit.Promoted and not unit.Dead and unit.Hp > 0 and (best == nil or unit.Atk > best.Atk) then best = unit end
        end
        local picked = self:Commander():PickedShadow()
        if picked ~= nil and not picked.Promoted then best = picked else picked = nil end
        local cap = 1 + self:Node("elite_twin")
        if promoted >= cap then
            self:Fail("정예는 동시에 " .. tostring(cap) .. "기까지" .. (cap == 1 and " — 강화 「정예 둘」로 2기" or ""))
            return false
        end
        if best == nil then
            self:Fail("승격할 그림자가 없습니다 — 그림자를 먼저 소환하세요")
            return false
        end
        best:Promote(multiplier)
        -- 승격 순간 (코덱스 H-7 정예 승격 6프레임이 오면 그 그림 · 그 전엔 금빛 기둥 입자)
        local q = _Util:Pos2(best.Entity)
        if _GameConst.FxSkillElitePromote ~= "" then self:FramesFx(_GameConst.FxSkillElitePromote, Vector3(q.x, q.y, 0), 1.25, self.RiseFrameSec, self.RiseFrameSec + self.RiseHoldSec, self.RiseFadeSec, self.FramesFxOrder) end   -- 피벗 0.5/0.1 = 발밑 (그림자 뿌리 자리)
        self:Fx("promote", Vector3(q.x, q.y, 0), 1)
        log(string.format("[VRF] elite promote target=%s picked=%s", best.ShadowId, tostring(picked ~= nil)))
        if picked ~= nil then self:Commander():ClearPick() end
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean SummonShadow()
        -- 보관함에서 가장 강한 그림자 하나. 못 부르면 이유를 알린다
        local cmd = self:Commander()
        if cmd:DeployNext() > 0 then return true end
        self:Fail(cmd:DeployBlockReason())
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean Rally()
        -- 그림자·언데드를 곁으로. 따를 소환수가 없으면 실패
        if self:Commander():RallyAll() > 0 then return true end
        self:Fail("따라올 소환수가 없습니다")
        return false
    end

    -- ───────── 연출 (모든 클라이언트) ─────────

    @ExecSpace("Multicast")
    method void Fx(string kind, Vector3 pos, number radius)
        -- 다른 맵의 시전은 이 클라이언트에 그리지 않는다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        -- 내 큰 스킬은 내 화면만 흔든다 (10-28 F5 C-3: 골격 감옥 · 뼈 폭풍 · 영혼 격류 시전 · 죽음의 파동 · 그림자 희생)
        if kind == "prison" or kind == "storm" or kind == "wave" or kind == "sacrifice" then _Util:SkillShake(self.Entity, kind == "storm" and 0.05 or 0.1, kind == "storm" and 0.25 or 0.14) end
        local s = Vector3(radius, radius, 1)
        if kind == "poison" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, pos, 0, Vector3(radius, radius * 0.22, 1), false, { Color = Color(0.28, 0.55, 0.2, 0.28), ParticleCount = 12 })
        elseif kind == "drain" then
            -- 적의 혼 → 시전자의 회복을 작은 연결 궤적으로 보여 준다. 적 예고를 덮는 큰 붉은 구는 피한다.
            local from = pos + Vector3(0, 0.4, 0)
            local to = self.Entity.TransformComponent.WorldPosition + Vector3(0, 0.4, 0)
            for i = 0, 4 do
                local t = i / 4
                local point = from * (1 - t) + to * t
                local endpoint = i == 0 or i == 4
                local particle = endpoint and BasicParticleType.ChargeOrb or BasicParticleType.SparkExplosion
                local size = endpoint and 0.3 or 0.18
                local color = i == 4 and Color(0.3, 0.65, 0.45, 0.85) or Color(0.5, 0.35, 0.65, 0.85)
                local serial = _ParticleService:PlayBasicParticle(particle, self.Entity, point, 0, Vector3(size, size, 1), false, { Color = color })
                if serial ~= 0 then
                    self.DrainVisuals[serial] = true
                    self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                        _ParticleService:RemoveParticle(serial)
                        self.DrainVisuals[serial] = nil
                        self.VisualTimers[serial] = nil
                    end, 0.65)
                end
            end
        elseif kind == "storm" then
            if self.StormVisual ~= 0 then
                _ParticleService:RemoveParticle(self.StormVisual)
                local oldTimer = self.VisualTimers[self.StormVisual]
                if oldTimer ~= nil then _TimerService:ClearTimer(oldTimer) self.VisualTimers[self.StormVisual] = nil end
            end
            local serial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.SpinField, self.Entity, Vector3(0, 0.3, 0), 0, s * 0.55, true, { Color = self.StormAuraColor })
            self.StormVisual = serial
            if serial ~= 0 then
                self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                    _ParticleService:RemoveParticle(serial)
                    self.VisualTimers[serial] = nil
                    if self.StormVisual == serial then self.StormVisual = 0 end
                end, 6)
            end
        elseif kind == "amp" or kind == "weaken" or kind == "thorn" or kind == "terror" or kind == "confuse" or kind == "lifetap" or kind == "decay" or kind == "resist" then
            self:CurseShape(kind, pos, radius)
        elseif kind == "promote" then
            -- 정예 승격 순간: 금빛이 그림자 몸을 타고 솟는다 (코덱스 H-7 그림 전 임시 — 아군·위로 솟는 금빛 · 적 정예 파열과 다르게)
            _ParticleService:PlayBasicParticle(BasicParticleType.UpperCylinder, self.Entity, pos, 0, Vector3(0.45, 0.6, 1), false, { Color = Color(1, 0.82, 0.38, 0.9) })
            _ParticleService:PlayBasicParticle(BasicParticleType.PillarBurst, self.Entity, pos + Vector3(0, 0.4, 0), 0, Vector3(0.5, 0.5, 1), false, { Color = Color(1, 0.88, 0.5, 1) })
        elseif kind == "plague" then
            -- 역병 저주: 죽은 적 자리에서 초록 고리가 퍼진다
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos + Vector3(0, 0.2, 0), 0, Vector3(radius * 0.4, radius * 0.4, 1), false, { Color = Color(0.45, 0.9, 0.35, 0.85) })
        elseif kind == "lure" then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s * 0.6, false, { Color = Color(0.6, 0.3, 0.9, 1) })
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos, 0, Vector3(0.5, 0.5, 1), false, { Color = Color(0.7, 0.45, 1, 0.9) })
        elseif kind == "prison" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.2, 0), 0, Vector3(radius * 0.45, radius * 0.3, 1), false, { Color = Color(0.85, 0.8, 0.68, 0.95) })
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, s, false, { Color = Color(0.85, 0.8, 0.65, 1) })
        elseif kind == "torrent" then
            if _GameConst.FxSkillTorrentCast ~= "" then
                -- 10-31 9계열 P28: 코덱스 영혼 격류 시전 4장 한 번 (시전자 몸 가운데 = 발 +0.45 · pos는 발 +0.3) · 몸 앞
                local k = self.TorrentCastArtScale
                _Util:PlayFrames(_GameConst.FxSkillTorrentCast, self.Entity, pos + Vector3(0, 0.15, 0), 0, Vector3(k, k, 1), math.max(0.02, _GameConst.FxSkillTorrentMs / 1000), Color(1, 1, 1, 1), 5)
                if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] torrent cast frames n=%d ms=%d scale=%.2f", #_Util:Frames(_GameConst.FxSkillTorrentCast), _GameConst.FxSkillTorrentMs, k)) end
            else
                _ParticleService:PlayBasicParticle(BasicParticleType.ChargeOrb, self.Entity, pos, 0, Vector3(self.TorrentCastScale, self.TorrentCastScale, 1), false, { Color = Color(0.55, 0.95, 1, 0.9) })   -- 격류 혼 청록 (44-1 A · 10-31 갈래 E P28 0.35 → 0.6)
            end
        elseif kind == "wave" then
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos + Vector3(0, 0.3, 0), 0, Vector3(radius * 0.5, radius * 0.5, 1), false, { Color = Color(0.55, 0.35, 0.8, 0.9) })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(radius * 0.35, radius * 0.15, 1), false, { Color = Color(0.5, 0.45, 0.55, 0.8) })
        elseif kind == "sacrifice" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.3, 0), 0, Vector3(radius * 0.4, radius * 0.4, 1), false, { Color = Color(0.6, 0.3, 1, 1) })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(radius * 0.35, radius * 0.18, 1), false, { Color = Color(0.35, 0.2, 0.5, 0.8) })
        end
    end

    @ExecSpace("ClientOnly")
    method void CurseShape(string kind, Vector3 pos, number radius)
        -- 44-1 A 「저주 원」 끊기: 같은 Aura 원에 색만 바꾸던 저주 8가지를 저주마다 다른 입자 모양으로 (반경 radius에 맞춘다).
        --   낙인 = 사방으로 튀는 붉은 보라 불꽃 · 쇠약 = 위에서 아래로 흘러내리는 병든 김 · 공포 = 바깥으로 터지는 검보라 고리 · 가시 = 가시처럼 튀는 주황 불꽃 ·
        --   약탈 = 가운데로 빨려드는 핏빛 · 붕괴 = 금 가며 퍼졌다 모이는 하늘빛 · 혼란 = 머리 위를 도는 별 · 쇠퇴 = 바닥에서 피어오르는 흙빛.
        --   코덱스 H-2 바닥 문장(GameConst.FxSkillCurseSigils "kind=r0,…")이 오면 그 저주는 문장 4프레임을 바닥에 한 번 깐다
        --   10-31 갈래 E (audit M14~M19): 문장 4장을 CurseSigilFrameSec씩(0.7초) + 마지막 장 CurseSigilHoldSec(0.3초) 잡고 CurseSigilFadeSec 옅어짐 · 층 MapLayer0 CurseSigilOrder(1) ·
        --   입자 모양(문장이 없는 혼란·쇠퇴와 대체 경로)도 SortingLayer MapLayer0 CurseFxOrder를 준다 (예전 층 지정 없음)
        --   10-31 9계열: 코덱스 원형 판(GameConst.FxSkillCurseCircles 6종 × 4장 · 위에서 본 원)이 있으면 문장보다 먼저 — 보이는 반경(CurseCircleFitPx) = 저주 반경 · 장마다 FxSkillCurseCircleMs
        local circle = _Util:KeyFrames(_GameConst.FxSkillCurseCircles, kind)
        local sig = _Util:KeyFrames(_GameConst.FxSkillCurseSigils, kind)
        if self.Entity == _UserService.LocalPlayer and not Environment:IsPublishedPlay() then log(string.format("[VRF] curse shape %s r=%.2f codex=%s circle=%s", kind, radius, tostring(#sig > 0), tostring(#circle > 0))) end
        if #circle > 0 then
            local cf = math.max(0.02, _GameConst.FxSkillCurseCircleMs / 1000)
            local ck = self:CurseCircleScale(kind, radius)
            _Util:PlayFramesHold(table.concat(circle, "|"), self.Entity, pos, 0, Vector3(ck, ck, 1), cf, cf + self.CurseCircleHoldSec, self.CurseCircleFadeSec, Color(1, 1, 1, 1), self.CurseSigilOrder)
            return
        end
        if #sig > 0 then
            local f = self.CurseSigilFrameSec
            local k = self:CurseSigilScale(kind, radius)
            _Util:PlayFramesHold(table.concat(sig, "|"), self.Entity, pos, 0, Vector3(k, k, 1), f, f + self.CurseSigilHoldSec, self.CurseSigilFadeSec, Color(1, 1, 1, 1), self.CurseSigilOrder)
            return
        end
        local r = math.max(0.4, radius)
        local function opt(c) return { Color = c, SortingLayer = "MapLayer0", OrderInLayer = self.CurseFxOrder } end
        if kind == "amp" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.15, 0), 0, Vector3(r * 0.55, r * 0.36, 1), false, opt(Color(0.78, 0.22, 0.6, 1)))
        elseif kind == "weaken" then
            _ParticleService:PlayBasicParticle(BasicParticleType.RisingSteam, self.Entity, pos + Vector3(0, r * 0.7, 0), 180, Vector3(r * 0.5, r * 0.45, 1), false, opt(Color(0.42, 0.62, 0.36, 0.85)))
        elseif kind == "terror" then
            _ParticleService:PlayBasicParticle(BasicParticleType.CircleBurst, self.Entity, pos + Vector3(0, 0.15, 0), 0, Vector3(r * 0.6, r * 0.42, 1), false, opt(Color(0.4, 0.12, 0.55, 1)))
        elseif kind == "thorn" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, pos + Vector3(0, 0.2, 0), 0, Vector3(r * 0.6, r * 0.45, 1), false, opt(Color(0.98, 0.5, 0.18, 1)))
        elseif kind == "lifetap" then
            _ParticleService:PlayBasicParticle(BasicParticleType.ChargeOrb, self.Entity, pos + Vector3(0, 0.25, 0), 0, Vector3(r * 0.5, r * 0.5, 1), false, opt(Color(0.9, 0.12, 0.22, 1)))
        elseif kind == "resist" then
            _ParticleService:PlayBasicParticle(BasicParticleType.EnergyExplosion, self.Entity, pos + Vector3(0, 0.15, 0), 0, Vector3(r * 0.5, r * 0.36, 1), false, opt(Color(0.35, 0.85, 1, 1)))
        elseif kind == "confuse" then
            local k = self.ConfuseFxMul
            _ParticleService:PlayBasicParticle(BasicParticleType.StarVortex, self.Entity, pos + Vector3(0, 0.6, 0), 0, Vector3(r * 0.4 * k, r * 0.3 * k, 1), false, opt(Color(1, 0.86, 0.32, 1)))
        elseif kind == "decay" then
            -- 쇠퇴: 녹슨 주황 김 + 회색 먼지 (M21 · 예전 흙빛은 바닥과 같은 색)
            _ParticleService:PlayBasicParticle(BasicParticleType.RisingSteam, self.Entity, pos, 0, Vector3(r * 0.5, r * 0.4, 1), false, opt(self.DecayFxColor))
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(r * 0.45, r * 0.2, 1), false, opt(self.DecayDustColor))
        end
    end

    method number CurseCircleScale(string kind, number radius)
        -- 저주 원형 판 배율 (가로세로 같은 값 · 순수 계산 · 10-31 9계열): 보이는 반경(CurseCircleFitPx · px)이 저주 반경 radius(칸)와 같게 — CurseSigilScale과 같은 계산 · 표에 없으면 캔버스 반폭 64px
        local px = 64
        for k, v in string.gmatch(self.CurseCircleFitPx, "(%w+)=([%d%.]+)") do
            if k == kind then px = tonumber(v) or 64 end
        end
        return radius / (math.max(1, px) / 100)
    end

    method number CurseSigilScale(string kind, number radius)
        -- 저주 바닥 문장 배율 (가로세로 같은 값 · 순수 계산 · tests/quality/skillfx_e.lua): 그림의 보이는 반경(CurseSigilFitPx · px)이 저주 반경 radius(칸)와 같게 —
        --   문장 전체가 판정 원(지름 2×radius) 안에 들고 가장 먼 끝이 원에 닿는다. 반경이 장비·노드로 커지면 같은 비율로 커진다. 표에 없으면 캔버스 반폭 64px
        local px = 64
        for k, v in string.gmatch(self.CurseSigilFitPx, "(%w+)=([%d%.]+)") do
            if k == kind then px = tonumber(v) or 64 end
        end
        return radius / (math.max(1, px) / 100)
    end

    @ExecSpace("Multicast")
    method void BlastFx(Vector3 pos, number radius, string mapId)
        -- 혼의 파열과 뼛가루를 낮게 펼친다. 연출 중심은 실제 피해 중심과 같다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not _Util:IsAlive(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap or self.Entity.CurrentMap.Id ~= mapId then return end
        _Util:SkillShake(self.Entity, 0.12, 0.16)   -- 해골 폭탄: 내 화면만 (10-28 F5 C-3)
        local parts = {
            { particle = BasicParticleType.DustExplosion, scale = Vector3(radius * 0.4, radius * 0.18, 1) },
            { particle = BasicParticleType.SparkRadialExplosion, scale = Vector3(radius * 0.3, radius * 0.16, 1), tint = Color(0.78, 0.73, 0.62, 0.8) }
        }
        local played = false
        for _, part in ipairs(parts) do
            local serial = _ParticleService:PlayBasicParticle(part.particle, self.Entity, pos, 0, part.scale, false, part.tint ~= nil and { Color = part.tint } or nil)
            if serial ~= 0 then
                played = true
                self.BlastVisuals[serial] = true
                self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                    _ParticleService:RemoveParticle(serial)
                    self.BlastVisuals[serial] = nil
                    self.VisualTimers[serial] = nil
                end, 0.55)
            end
        end
        if played then self.BlastFxCount = self.BlastFxCount + 1 end
    end

    @ExecSpace("Multicast")
    method void MistFx(Vector3 pos, number radius, number seconds)
        -- 남는 독안개: 반복 입자를 seconds 동안 틀고 끈다. 맵 이탈 시 타이머도 해제한다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        -- 상승 연기 대신 낮은 회전 장판: 적의 몸과 공격 예고를 덮지 않는다.
        -- 같은 시전자의 장판은 최대 3개만 표시하고 오래된 입자/타이머를 함께 해제한다.
        local count = 0
        local oldest = 0
        local oldestUntil = math.huge
        for id, untilAt in pairs(self.MistVisuals) do
            count = count + 1
            if untilAt < oldestUntil then oldest = id oldestUntil = untilAt end
        end
        -- 독이 깔린 범위를 분명히 보이게 (예전 투명도 0.28은 어두운 바닥에서 거의 안 보였다)
        local s = Vector3(radius, radius * 0.3, 1)
        local serial = _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, pos, 0, s, true, { Color = Color(0.35, 0.85, 0.25, 0.55), ParticleCount = 22 })
        if serial == 0 then return end
        if count >= 3 and oldest ~= 0 then
            _ParticleService:RemoveParticle(oldest)
            self.MistVisuals[oldest] = nil
            local timer = self.VisualTimers[oldest]
            if timer ~= nil then _TimerService:ClearTimer(timer) self.VisualTimers[oldest] = nil end
        end
        self.MistVisuals[serial] = _UtilLogic.ElapsedSeconds + seconds
        self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
            if self.MistVisuals[serial] then
                _ParticleService:RemoveParticle(serial)
                self.MistVisuals[serial] = nil
            end
            self.VisualTimers[serial] = nil
        end, seconds)
    end

    -- ───────── 44 결정 4 교체 노드 · 44-1 B 상태 표시 (10-29) ─────────

    @ExecSpace("ServerOnly")
    method void AfterDash(SkillBook book)
        -- 질주를 받은 직후 (WraithDash): 강화 「잔걸음」 이동 속도 · 「뼈 껍질」 뼈 갑옷 채움
        ---@type PlayerStats
        local st = self.Entity:GetComponent("script.PlayerStats")
        if st == nil then return end
        local owner = self.Entity
        local step = book:AfterStepPct(book:Node("step_gale"))
        if step > 0 then
            -- 질주가 0.16초 걸리므로 그만큼 늘려 「질주 뒤」 afterStepSec초를 지킨다
            local sec = _GameData.afterStepSec + 0.2
            st:StartAfterStep(step, sec)
            self:StatusFxOn(owner, "afterstep", sec)
            log(string.format("[VRF] after step +%d%% %.1fs", step, sec))
        end
        local shell = book:BoneShellPct(book:Node("dash_ghost"))
        local armorLv = book:GetPowerLevel("bone_armor")
        if shell > 0 and armorLv > 0 then
            local map = owner.CurrentMap
            _TimerService:SetTimerOnce(function()
                -- 질주가 끝난 자리에서 (0.2초 뒤) 갑옷을 채운다. 갑옷을 한 번도 두르지 않았으면 지금 랭크의 최대치를 기준으로
                if not _Util:IsAlive(owner) or owner.CurrentMap ~= map then return end
                local max = math.max(st.BoneArmorMax, math.floor(book:GetEffectPower("bone_armor", armorLv)))
                local before = st.BoneArmor
                st.BoneArmorMax = max
                st.BoneArmor = math.min(max, st.BoneArmor + math.floor(max * shell / 100))
                if st.BoneArmor > before then self:StatusFx("shell", owner.TransformComponent.WorldPosition, 1) end
                log(string.format("[VRF] bone shell %d -> %d / %d (+%d%%)", math.floor(before), math.floor(st.BoneArmor), max, shell))
            end, 0.2)
        end
    end

    @ExecSpace("ServerOnly")
    method void ArmorBurst(number damage)
        -- 강화 「터지는 갑옷」: 뼈 갑옷이 다 깨진 순간 내 둘레 armorBurstRadius에 그 갑옷이 막은 피해 합 × 배율 (PlayerStats.SoakBoneArmor가 부른다)
        if not _Util:IsAlive(self.Entity) or damage <= 0 then return end
        local p = _Util:Pos2(self.Entity)
        local r = _GameData.armorBurstRadius
        self:Hit(Vector2(p.x, p.y + 0.3), Vector2(r, 0), -1, "skill.armor_burst", damage)
        self:StatusFx("armorburst", Vector3(p.x, p.y, 0), r)
        log(string.format("[VRF] armor burst dmg=%.0f r=%.1f", damage, r))
    end

    @ExecSpace("Multicast")
    method void StatusFx(string kind, Vector3 pos, number radius)
        -- 서버에서만 부르던 연출을 모든 클라이언트에 (44 §3-3 「서버 전용 파티클」) + 교체 노드 연출. 다른 맵이면 그리지 않는다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local bone = Color(0.9, 0.85, 0.7, 1)
        if kind == "armor" and _GameConst.FxSkillArmorCast ~= "" then
            -- 10-31 9계열 P14: 코덱스 뼈 갑옷 두름 4장 한 번 (몸 가운데 · 몸 앞) — 그 뒤 몸 고리(PlayerStats 뼈 갑옷 고리 · 그림 두 층)가 이어받는다
            local k = self.ArmorCastArtScale
            _Util:PlayFrames(_GameConst.FxSkillArmorCast, self.Entity, pos + Vector3(0, self.ArmorArtDy, 0), 0, Vector3(k, k, 1), math.max(0.02, _GameConst.FxSkillArmorFxMs / 1000), Color(1, 1, 1, 1), self.ArmorCastOrder)
            if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] bone armor cast frames n=%d ms=%d scale=%.2f", #_Util:Frames(_GameConst.FxSkillArmorCast), _GameConst.FxSkillArmorFxMs, k)) end
        elseif kind == "armor" then
            -- 10-31 갈래 E P14: 시전 입자 1.0 → ArmorCastScale(1.4) · 반복으로 ArmorCastSec(0.5초) 틀고 끈다 — 그동안 몸 고리(PlayerStats 뼈 갑옷 고리 · P15)가 이어받는다
            local cast = _ParticleService:PlayBasicParticle(BasicParticleType.Buff, self.Entity, pos, 0, Vector3(self.ArmorCastScale, self.ArmorCastScale, 1), true, { Color = Color(1, 0.97, 0.88, 1), SortingLayer = "MapLayer0", OrderInLayer = 5 })
            if cast ~= 0 then
                self.BlastVisuals[cast] = true
                self.VisualTimers[cast] = _TimerService:SetTimerOnce(function()
                    _ParticleService:RemoveParticle(cast)
                    self.BlastVisuals[cast] = nil
                    self.VisualTimers[cast] = nil
                end, self.ArmorCastSec)
            end
            if self.Entity == me and not Environment:IsPublishedPlay() then log(string.format("[VRF] bone armor cast scale=%.2f sec=%.2f", self.ArmorCastScale, self.ArmorCastSec)) end
        elseif kind == "shell" then
            -- 「뼈 껍질」: 질주 끝 자리에서 뼛조각이 몸에 붙는다 (뼈 갑옷 연출을 작게)
            _ParticleService:PlayBasicParticle(BasicParticleType.Buff, self.Entity, pos, 0, Vector3(0.7, 0.7, 1), false, { Color = Color(0.95, 0.9, 0.78, 0.9) })
        elseif kind == "armorburst" then
            -- 「터지는 갑옷」: 뼈 판이 바깥으로 튄다 (코덱스 fx-bone-armor-break가 오기 전 기본 입자 · 내 화면만 흔든다)
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.35, 0), 0, Vector3(radius * 0.45, radius * 0.45, 1), false, { Color = bone })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(radius * 0.35, radius * 0.16, 1), false, { Color = Color(0.75, 0.7, 0.6, 0.85) })
            _Util:SkillShake(self.Entity, 0.1, 0.14)
        elseif kind == "boneburst" or kind == "resonance" then
            -- 「무너지는 뼈」: 쓰러진 해골 자리 뼈 파열 (예전 UndeadSystem이 서버에서만 불렀다) · 뼈 공명 울림(SkeletonResonance)
            --   10-31 갈래 E S10: 0.6 → BoneBurstScale(0.8) + 뼛가루 (예전 공명은 보라 파열 FxShardHit — 「뼛가루」가 아니었다)
            local k = self.BoneBurstScale * (kind == "resonance" and math.max(0.6, radius / 1.5) or 1)
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos + Vector3(0, 0.3, 0), 0, Vector3(k, k, 1), false, { Color = Color(0.9, 0.86, 0.74, 0.95) })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(k * 0.7, k * 0.3, 1), false, { Color = self.BoneDustColor })
        end
    end

    @ExecSpace("Multicast")
    method void StatusFx2(string kind, Vector3 from, Vector3 to)
        -- 두 점을 잇는 연출: 「혼 사슬」 = 앞 대상에서 다음 대상으로 붉은 보라 궤적 (생기 앗기 연결 궤적과 같은 결)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        if kind ~= "chain" then return end
        local a = from + Vector3(0, 0.4, 0)
        local b = to + Vector3(0, 0.4, 0)
        for i = 0, 4 do
            local t = i / 4
            local endpoint = i == 0 or i == 4
            local particle = endpoint and BasicParticleType.ChargeOrb or BasicParticleType.SparkExplosion
            local size = endpoint and 0.26 or 0.16
            local serial = _ParticleService:PlayBasicParticle(particle, self.Entity, a * (1 - t) + b * t, 0, Vector3(size, size, 1), false, { Color = Color(0.75, 0.3, 0.55, 0.85) })
            if serial ~= 0 then
                self.DrainVisuals[serial] = true
                self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
                    _ParticleService:RemoveParticle(serial)
                    self.DrainVisuals[serial] = nil
                    self.VisualTimers[serial] = nil
                end, 0.65)
            end
        end
    end

    @ExecSpace("Multicast")
    method void StatusFxOn(Entity target, string kind, number seconds)
        -- 몸에 붙어 seconds 동안 남는 상태 연출: 「잔걸음」 잔상(옅은 푸른 기운) · 뼈 성찬 「피의 고양」(받은 소환수 붉은 기운 · 44 §3-2)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(target) or me.CurrentMap ~= target.CurrentMap then return end
        local color = kind == "frenzy" and Color(0.95, 0.25, 0.2, 0.7) or Color(0.6, 0.82, 1, 0.55)
        local height = kind == "frenzy" and 0.35 or 0.45
        local serial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.Enchant, target, Vector3(0, height, 0), 0, Vector3(0.8, 0.8, 1), true, { Color = color })
        if kind == "afterstep" then
            -- 떠난 자리에 흩어지는 잔상 한 번
            local p = target.TransformComponent.WorldPosition
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, target, p, 0, Vector3(0.45, 0.2, 1), false, { Color = Color(0.6, 0.75, 1, 0.6) })
        end
        if serial == 0 then return end
        self.BlastVisuals[serial] = true
        self.VisualTimers[serial] = _TimerService:SetTimerOnce(function()
            _ParticleService:RemoveParticle(serial)
            self.BlastVisuals[serial] = nil
            self.VisualTimers[serial] = nil
        end, math.max(0.2, seconds))
    end

end
