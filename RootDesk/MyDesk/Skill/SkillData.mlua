-- 네크로맨서 스킬 27종 정의 (docs/design/04-classes-and-skills.md 3장).
-- impl=true 인 스킬만 실제 효과가 있다. 나머지는 트리에 보이되 "준비 중"으로 표시된다.
@Logic
script SkillData extends Logic

    property table Skills = {}
    property table Order = {}

    property boolean Built = false

    method void Build()
        -- 서버·클라이언트 양쪽에서 같은 표를 만든다. OnInitialize 시점에 표가 남지 않아 첫 조회 때 만든다
        if self.Built then return end
        self.Built = true
        self.Skills = {}
        self.Order = {}
        -- id, 이름, 트리, 행(요구 레벨), 유형, 선행, 최대, 마나, 쿨다운, 구현, 설명
        self:Add("shadow_summon", "그림자 소환", "command", 1, "active", "", 20, 0, 0, true, "보관함의 그림자를 소환한다 (Z)")
        self:Add("extract_mastery", "추출 숙련", "command", 1, "passive", "", 20, 0, 0, true, "혼 추출 확률 +3%/레벨")
        self:Add("rally", "집결", "command", 6, "active", "shadow_summon", 20, 0, 0, true, "소환수 전원을 곁으로 부른다 (C)")
        self:Add("command_mastery", "군령 숙련", "command", 12, "passive", "extract_mastery", 20, 0, 0, true, "소환수 공격력·생명 +8%/레벨")
        self:Add("deploy_expand", "배치 확장", "command", 18, "passive", "command_mastery", 20, 0, 0, true, "배치 한도 +1 (1·8·16레벨)")
        self:Add("soul_bond", "혼 결속", "command", 24, "aura", "command_mastery", 20, 0, 0, false, "소환수 저항 증가, 피해 일부 분담")
        self:Add("elite_promote", "정예 승격", "command", 30, "active", "deploy_expand", 20, 30, 20, true, "가장 강한 소환수 1기를 정예로 (능력치 ×1.5)")
        self:Add("shadow_sacrifice", "그림자 희생", "command", 36, "active", "elite_promote", 20, 10, 10, false, "그림자를 소모해 피해 증가")
        self:Add("revive", "되살림", "command", 42, "active", "command_mastery", 20, 40, 30, false, "처치한 정예를 20초간 부활")
        self:Add("command_aura", "호령", "command", 50, "aura", "soul_bond", 20, 0, 0, false, "아군 공격력·이동 속도 증가")

        self:Add("bone_shard", "골편 투척", "soul", 1, "active", "", 20, 4, 0.5, true, "커서 방향으로 뼛조각을 꿰뚫어 날린다")
        self:Add("poison_mist", "독안개", "soul", 6, "active", "bone_shard", 20, 8, 3, true, "커서 위치에 독안개, 4초간 지속 피해")
        self:Add("corpse_blast", "망자 폭쇄", "soul", 12, "active", "bone_shard", 20, 10, 1, true, "커서 근처의 혼을 터뜨려 범위 피해 (추출 대신 소모)")
        self:Add("bone_prison", "골격 감옥", "soul", 18, "active", "corpse_blast", 20, 12, 8, false, "뼈 장벽으로 이동 제한")
        self:Add("soul_drain", "혼 흡수", "soul", 24, "active", "poison_mist", 20, 12, 4, true, "대상의 생명을 흡수해 자신과 소환수 회복")
        self:Add("poison_spread", "독 확산", "soul", 30, "passive", "poison_mist", 20, 0, 0, false, "독 걸린 적 사망 시 확산")
        self:Add("bone_storm", "뼈 폭풍", "soul", 36, "active", "bone_prison", 20, 20, 12, true, "6초간 주위를 도는 뼈가 적을 벤다")
        self:Add("soul_torrent", "영혼 격류", "soul", 42, "active", "soul_drain", 20, 25, 6, false, "유도 영혼 다수 발사")
        self:Add("death_wave", "죽음의 파동", "soul", 50, "active", "bone_storm", 20, 40, 15, false, "전방위 대형 파동")

        self:Add("mark_weakness", "약화의 낙인", "curse", 1, "curse", "", 20, 6, 1, true, "범위의 적이 받는 피해 +30% (+3%/레벨), 8초")
        self:Add("enfeeble", "쇠약", "curse", 6, "curse", "mark_weakness", 20, 6, 1, true, "범위의 적 공격력 -35%, 8초")
        self:Add("thorn_curse", "가시 저주", "curse", 12, "curse", "enfeeble", 20, 8, 1, false, "적이 준 피해 일부 반사")
        self:Add("terror", "공포", "curse", 18, "curse", "enfeeble", 20, 8, 1, false, "적을 도망치게 함")
        self:Add("confusion", "혼란", "curse", 24, "curse", "terror", 20, 10, 1, false, "적이 서로 공격")
        self:Add("life_tap", "생명 약탈", "curse", 30, "curse", "mark_weakness", 20, 10, 1, false, "공격 시 생명 회복")
        self:Add("lure", "유인", "curse", 36, "curse", "confusion", 20, 10, 1, false, "적을 한곳에 모음")
        self:Add("decay", "쇠퇴", "curse", 42, "curse", "thorn_curse", 20, 12, 1, false, "속도·피해 대폭 감소")
        self:Add("resist_break", "저항 붕괴", "curse", 50, "curse", "decay", 20, 14, 1, false, "모든 저항 감소")
    end

    method void Add(string id, string name, string tree, integer row, string kind, string prereq, integer maxLv, number mana, number cooldown, boolean impl, string desc)
        self.Skills[id] = { id = id, name = name, tree = tree, row = row, kind = kind, prereq = prereq, maxLv = maxLv, mana = mana, cooldown = cooldown, impl = impl, desc = desc }
        table.insert(self.Order, id)
    end

    method any Get(string id)
        self:Build()
        return self.Skills[id]
    end

    method table GetOrder()
        -- 트리 표시 순서 (id 목록)
        self:Build()
        return self.Order
    end

    method string TreeName(string tree)
        if tree == "command" then return "군령" end
        if tree == "soul" then return "혼술" end
        return "저주"
    end

end
