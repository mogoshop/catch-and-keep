-- 지연 생성은 성공 확인 후 비용을 확정하고, 맵 이동·사망 시 취소한다.
-- 스킬북: 습득·슬롯·입력·시전 조건(구현 여부·쿨다운·마나). 효과는 SkillEffects.
-- 입력: A S D F = 슬롯 1~4, 마우스 우클릭 = 오른쪽 스킬. 조준점은 커서(마우스 모드) 또는 가장 가까운 적.
@Component
script SkillBook extends Component

    property string StartSkills = "wraith_dash"   -- 거저 주는 시작 랭크 1 (11-03 저녁 사용자: 레이스 폼은 1랭크를 찍고 시작 · 포인트 1은 그대로 · 초기화해도 1랭크는 남는다 — docs/design/62 §13)
    property boolean StartGrantDone = false   -- 이번 불러오기에서 시작 랭크 이전(MigrateStartRank)을 이미 했다 (같은 저장으로 MigrateLevels를 다시 불러도 두 번 돌려주지 않게 · 저장 안 함)
    property table Levels = {}                -- id → 투자 레벨 (서버)
    property table PendingCasts = {}
    property number PendingMana = 0
    property integer CastEpoch = 0
    property integer PresentedCastCount = 0
    property number PredictedCastAt = -10     -- 클라이언트: 골편을 누르는 순간 그린 시각 (서버 확인 때 몸짓을 두 번 틀지 않게)
    property table ReadyAt = {}               -- id → 쿨다운 끝 시각 (서버)
    property table CdLen = {}                 -- id → 마지막 쿨다운 길이 (표시용)
    @Sync
    property string CdDigest = ""             -- "id:끝(서버 시각):길이;..." HUD 쿨다운 덮개용
    @Sync
    property string SkillDigest = ""          -- "id:lv;..." UI 표시용
    @Sync
    property string Slots = ",,,"             -- A S D F. 빈 칸으로 시작, 배운 스킬만 넣는다
    @Sync
    property string RightSkill = ""
    property boolean NeedRework = false       -- 10-11 스킬·능력치 개편 전 저장 (sv < 3): 불러오기 끝에 전부 돌려준다 (docs/design/16)
    property integer DashCharges = 1          -- 망령 질주 남은 횟수 (서버). 강화 「여분 숨」이면 최대 1 + 랭크
    property number DashRechargeAt = 0        -- 다음 한 번이 다시 차는 시각 (서버, ElapsedSeconds)
    property integer DashRefillTimer = 0      -- 다음 한 번을 채울 타이머 (서버 · 한 칸이 차면 다음 칸 타이머를 다시 건다)
    @Sync
    property integer DashShown = 1            -- HUD 질주 단추 숫자 (남은 횟수)
    property number MovePredictAt = -10       -- 클라이언트: 질주를 마지막으로 직접 움직인 시각 (연타로 두 번 움직이지 않게)
    property integer DashPending = 0          -- 클라이언트: 서버 확인을 아직 못 받은 질주 수 (남은 횟수에서 미리 뺀다 — 10-24 연타 두 번 질주)
    property integer DashSeen = -1            -- 클라이언트: 마지막으로 본 DashShown (줄어든 만큼 확인된 질주)
    property number RiteHoldAt = -1           -- 클라이언트: 뼈 의식 칸을 누르기 시작한 시각 (-1 = 안 누름 · 기획서 43 결정 1A)
    property integer RiteHoldSlot = 0         -- 클라이언트: 누르고 있는 칸 (1~4 = A S D F · 5 = 우클릭/모바일 큰 버튼)
    property integer GroundHoldSlot = 0       -- 클라이언트 PC: 누르고 있는 땅 찍기 스킬 칸 (44-3 A — 누르는 동안 범위 원, 떼면 시전 · 0 = 없음)
    property Entity GroundHoldMap = nil
    property number GroundCastRange = 6       -- 땅 찍기 조준점 최대 거리 (넘으면 그 방향 6칸에 놓는다 · 서버 Cast와 같은 값)
    property number MobileAimMinDist = 1      -- 모바일 끌기: 데드존을 막 넘었을 때 조준 거리(칸) — 끈 길이에 비례해 GroundCastRange까지
    @TargetUserSync
    property string RiteBanner = ""           -- 46-1 「바라는 거인」 깃발 (shield·greatsword·twin·mage·basic · "" = 안 고름 → fallback 순서) — 동률 최다 안에서만 이긴다 · 저장 skills.banner
    @TargetUserSync
    property integer GiantTips = 0            -- 46-6 거인이 서는 순간 안내 띠를 보인 횟수 (첫 3번만 · GuideCoach) — 저장 skills.giantTips
    @TargetUserSync
    property boolean ShadowGuide = false      -- 10-31 「그림자 소환」을 배운 뒤 게임 안내 창(군단 책갈피)을 저절로 한 번 열었다 (캐릭터마다 · GuideCoach) — 저장 skills.shadowGuide
    @TargetUserSync
    property boolean ShardHold = false        -- I04: 모바일에서 골편 칸을 누르고 있으면 반복 (기본 끔 · MobilePad.ShardTick) — 저장 skills.shardHold

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self.Levels = {}
        self.ReadyAt = {}
        self.CdLen = {}
        self.PendingCasts = {}
        self.PendingMana = 0
        for id in string.gmatch(self.StartSkills, "[^,]+") do self.Levels[id] = 1 end
        self:SanitizeSlots()
        self:RefreshDigest()
        if not Environment:IsPublishedPlay() then self:LogRankCurves() end
    end

    @ExecSpace("ServerOnly")
    method void LogRankCurves()
        -- 11-03 랭크 개편 자가 출력 (docs/design/62 §7·§8 · 메이커 확인용 · 발행판 제외): 메인 13개 R1/R10/R20 (Lv1 환산 · 노드 0 — 접속 직후라 표가 비어 있다) + 랭크 열림 규칙
        local parts = {}
        local fmt = function(v) return string.format("%.2f", v) end
        local triple = function(fn) return fmt(fn(1)) .. "/" .. fmt(fn(10)) .. "/" .. fmt(fn(20)) end
        local raw = function(id) return function(r) return self:RawEffectPower(id, r) end end
        for _, id in ipairs({ "bone_storm", "shadow_sacrifice", "soul_torrent", "death_wave" }) do
            table.insert(parts, id .. "=" .. triple(function(r) return self:DamageCurve(id, r) * _GameData.skillPowerMult * _GameData.skillDmgMult end))
        end
        table.insert(parts, "enfeeble=" .. triple(raw("enfeeble")))
        table.insert(parts, "bone_rite.bomb=" .. triple(raw("bone_rite")))
        table.insert(parts, "bone_rite.whirl=" .. triple(function(r) return self:RiteRankMul(r) * _GameData.riteWhirlMul * self:RiteWhirlTicks(0) end))
        table.insert(parts, "bone_giant=" .. triple(function(r) return 1 + self:RawEffectPower("bone_giant", r) / 100 end))
        table.insert(parts, "elite_promote=" .. triple(raw("elite_promote")))
        table.insert(parts, string.format("wraith_dash=%.2f/%.2f/%.2f cd=%.2f/%.2f/%.2f cap@1/5/30=%d/%d/%d next(5)=%d", self:RawEffectPower("wraith_dash", 1), self:RawEffectPower("wraith_dash", 5), self:RawEffectPower("wraith_dash", 10),
            self:DashCooldown(1), self:DashCooldown(5), self:DashCooldown(10), self:RankCap("wraith_dash", 1), self:RankCap("wraith_dash", 5), self:RankCap("wraith_dash", 30), self:NextRankLevel("wraith_dash", 5)))
        table.insert(parts, "bone_offering=" .. triple(raw("bone_offering")))
        table.insert(parts, "resist_break=" .. triple(function(r) return self:RawEffectPower("resist_break", r) * _GameData.skillPowerMult end))
        table.insert(parts, "bone_prison=" .. triple(raw("bone_prison")))
        table.insert(parts, "terror=" .. triple(raw("terror")))
        log("[VRF] rank curves " .. table.concat(parts, " "))
        local caps = {}
        for _, c in ipairs({ { "bone_rite", 52 }, { "bone_rite", 53 }, { "death_wave", 78 }, { "death_wave", 79 }, { "hex_flame", 47 }, { "bone_giant", 53 } }) do
            table.insert(caps, string.format("%s@%d=%d", c[1], c[2], self:RankCap(c[1], c[2])))
        end
        log(string.format("[VRF] rankcap rule step=%g lateRow=%d %s next(bone_rite,20)=%d next(death_wave,20)=%d giantNode(giant_gs_spin,1)=%d rite_fork(1)=%d rite_reach(1)=%d",
            _GameData.rankLateStep, math.floor(_GameData.rankLateRow), table.concat(caps, " "), self:NextRankLevel("bone_rite", 20), self:NextRankLevel("death_wave", 20),
            self:NodeLevel("giant_gs_spin", 1), self:NodeLevel("rite_fork", 1), self:NodeLevel("rite_reach", 1)))
    end

    method integer ChoiceTier(integer slot, string axis)
        -- 선택 보상 (PlayerQuest.ChoiceTier): 그 칸에서 이 축을 골랐으면 단계 1~3
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        return quest ~= nil and quest:ChoiceTier(slot, axis) or 0
    end

    method integer GetPowerLevel(string id)
        -- 효과에 쓰는 레벨: 배운 메인 스킬에만 장비의 「모든 스킬」·「계열 스킬」·「단일 스킬 +N」을 더한다 (docs/design/19). 강화 노드는 랭크 그대로. 배울 때·요구 조건은 GetLevel
        return self:PowerLevelAt(id, self:GetLevel(id))
    end

    method integer PowerLevelAt(string id, integer lv)
        -- 실제 계산과 현재/다음 미리보기가 같은 추가 랭크·강화 해금 규칙을 쓴다.
        if lv <= 0 then return 0 end
        local def = _SkillData:Get(id)
        if def == nil then return lv end
        if def.kind == "node" then
            ---@type PlayerStats
            local owner = self.Entity:GetComponent("script.PlayerStats")
            return owner ~= nil and self:NodeUsable(id, lv, owner.Level) or lv
        end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return lv end
        return lv + stats:GetSkillLevelBonus(id, def.tree)
    end

    method integer GetLevel(string id)
        -- 서버는 표, 클라이언트는 동기화 문자열 (11-01: 선택 보상 2차 주문이 「꿰뚫는 골편」으로 바뀌어 거저 주는 랭크는 없다)
        if self:IsServer() then return self.Levels[id] or 0 end
        local lv = string.match(";" .. self.SkillDigest, ";" .. id .. ":(%d+)")
        if lv == nil then return 0 end
        return tonumber(lv)
    end

    @ExecSpace("ServerOnly")
    method void RefreshDigest()
        local parts = {}
        for id, lv in pairs(self.Levels) do table.insert(parts, id .. ":" .. tostring(lv)) end
        table.sort(parts)
        self.SkillDigest = table.concat(parts, ";")
        if (self.Levels.wraith_dash or 0) > 0 then self:RefillDash() end   -- 질주 단추 숫자를 배우자마자 맞춘다
    end

    method integer RankCap(string id, integer playerLevel)
        -- 지금 올릴 수 있는 최대 랭크 (docs/design/16): 메인 = min(최대 20, 1 + (캐릭터 Lv − 해금 Lv) // 2), 강화 = 최대 랭크
        --   62 §8 · 11-03 Fable 결정 3: 해금 Lv ≥ rankLateRow(24) 메인 11개는 rankLateStep(1.5)레벨마다 1랭크 (본 노바 Lv53 · 데스 노바 Lv79에 20랭크)
        local def = _SkillData:Get(id)
        if def == nil then return 0 end
        if def.kind == "node" then return def.maxLv end
        if playerLevel < def.row then return 0 end
        -- 11-04 질주 개편: 표의 rankStep(질주 3)이 있으면 랭크 k = 캐릭터 Lv rankStep×k (랭크 1은 해금 Lv · Lv30에 10랭크) — 다른 스킬 rankStep 0 = 그대로
        if (def.rankStep or 0) > 0 then return math.min(def.maxLv, math.max(1, math.floor(playerLevel / def.rankStep + 1e-9))) end
        return math.min(def.maxLv, 1 + math.floor((playerLevel - def.row) / self:RankStep(def.row) + 1e-9))
    end

    method number RankStep(integer row)
        -- 메인 랭크 하나가 열리는 캐릭터 레벨 간격: 해금 Lv ≥ rankLateRow면 rankLateStep(1.5), 그 밖은 2 (62 §8)
        if row >= _GameData.rankLateRow then return _GameData.rankLateStep end
        return 2
    end

    method integer NextRankLevel(string id, integer rank)
        -- 메인 스킬을 rank까지 올리는 데 필요한 캐릭터 레벨
        local def = _SkillData:Get(id)
        if def == nil or def.kind == "node" then return 1 end
        if (def.rankStep or 0) > 0 then return rank <= 1 and math.floor(def.row) or math.max(math.floor(def.row), math.floor(def.rankStep * rank + 1e-9)) end   -- 11-04 질주: 랭크 k = Lv 3k (랭크 1 = 해금 Lv)
        return def.row + math.ceil(self:RankStep(def.row) * (math.max(1, rank) - 1) - 1e-9)   -- 해금 ≥ 24: 해금 + ⌈1.5 × (랭크 − 1)⌉ (62 §8-1)
    end

    method integer NodeNeed(string id, integer rank)
        -- 강화 rank랭크를 찍는 데 필요한 메인 스킬 랭크 = 표의 need 하나 (11-03 군령 삭제로 랭크마다 다른 need는 없다)
        --   (10-28 투사체 A안: 골편 발 수가 스킬 레벨 구간으로 들어가 「다중 투사체」 랭크 간격 규칙은 없앴다 — 그 자리는 강화 「모인 뼈」)
        local def = _SkillData:Get(id)
        if def == nil then return 0 end
        return def.need
    end

    method integer NodeLevel(string id, integer rank)
        -- 강화 rank랭크에 필요한 캐릭터 레벨 (0 = 조건 없음). 10-24 사용자: 강화는 열린 뒤 nodeLevelStep(4)레벨마다 한 랭크
        --   (예전엔 열리는 순간 모든 랭크를 한 번에 찍었다 — 단련된 뼈 Lv5에 5랭크). 처음 열리는 레벨 = 메인 스킬을 need 랭크로 올릴 수 있는 가장 이른 레벨
        -- 예외: 그림자 증원 Lv12·17·22
        --   62 §8-3: 처음 열리는 레벨 = 부모가 need 랭크에 닿는 가장 이른 레벨(NextRankLevel) — 해금 ≥ 24 부모(본 골렘 거인 노드 Lv38 등)는 1.5레벨 규칙을 따른다
        if id == "deploy_expand" then return math.floor(_GameData.deployExpandFromLv + _GameData.deployExpandStep * (math.max(1, rank) - 1)) end
        local def = _SkillData:Get(id)
        if def == nil or def.kind ~= "node" then return 0 end
        local parent = _SkillData:Get(def.parent)
        local first = parent ~= nil and self:NextRankLevel(def.parent, math.max(1, def.need)) or (1 + 2 * (math.max(1, def.need) - 1))
        --   11-04 질주 개편: 질주 강화도 부모 랭크 기준 (여분 숨 랭크 3 = Lv9 · 군단 질주 5 = Lv15 · 망령 도약 7 = Lv21) — 옛 「노드 row > 부모 row」 예외(11-03 저녁)는 없앴다
        return math.floor(first + _GameData.nodeLevelStep * (math.max(1, rank) - 1))
    end

    method integer NodeUsable(string id, integer rank, integer playerLevel)
        -- 찍은 랭크 중 지금 캐릭터 레벨에서 효과가 나는 랭크 (예전에 미리 찍어 둔 저장도 같은 규칙)
        local usable = rank
        while usable > 0 and playerLevel < self:NodeLevel(id, usable) do usable = usable - 1 end
        return usable
    end

    method integer Node(string id)
        -- 강화 노드 랭크 (효과 계산용): 찍은 랭크 중 지금 캐릭터 레벨에서 열린 랭크만 (예전에 한 번에 찍어 둔 저장도 같은 규칙 · 10-24)
        local lv = self:GetLevel(id)
        if lv <= 0 then return 0 end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return lv end
        return self:NodeUsable(id, lv, stats.Level)
    end

    method string CanLearn(string id, integer playerLevel, integer skillPoints)
        -- 가능하면 "", 아니면 이유
        local def = _SkillData:Get(id)
        if def == nil then return "없는 스킬" end
        -- 아직 효과가 없는 스킬은 배울 수 없다 (포인트를 헛쓰지 않게)
        if not def.impl then return "준비 중인 강화" end
        if def.hold then return "별도 검토 중" end   -- 46-5 보류 묶음 (방패 거인 갈림 · 결정 6)
        local lv = self:GetLevel(id)
        if lv >= def.maxLv then return "최대 랭크" end
        if def.kind == "node" then
            -- 11-05 사용자: 본 골렘·거인 강화의 「악몽부터」 제한을 없앴다 (노말에서도 배운다 · 레벨·필요 랭크 규칙은 그대로)
            -- 택일 묶음 (44 결정 5 · 46 §4-3): 같은 묶음에서 이미 하나를 골랐으면 다른 쪽은 못 배운다 (다시 고르기 불가 — 스킬 초기화로만)
            if (def.group or "") ~= "" then
                for _, other in ipairs(_SkillData:GroupOf(def.group)) do
                    if other ~= id and self:GetLevel(other) > 0 then
                        local od = _SkillData:Get(other)
                        return "이미 「" .. (od ~= nil and od.name or other) .. "」을(를) 골랐습니다"
                    end
                end
            end
            -- 강화: 메인 스킬을 그 랭크까지 올려야 열린다
            local parent = _SkillData:Get(def.parent)
            local name = parent ~= nil and parent.name or def.parent
            if self:GetLevel(def.parent) <= 0 then return "먼저 「" .. name .. "」을(를) 배우세요" end
            -- 선행 강화 (44 결정 4 · 「뼈 가시」는 「튕김」 1랭크부터 — 튕김 0이면 효과가 없던 노드)
            if def.prereq ~= "" and self:GetLevel(def.prereq) <= 0 then
                local pre = _SkillData:Get(def.prereq)
                return "먼저 「" .. (pre ~= nil and pre.name or def.prereq) .. "」을(를) 배우세요"
            end
            local need = self:NodeNeed(id, lv + 1)
            if self:GetLevel(def.parent) < need then return "「" .. name .. "」 " .. tostring(need) .. "랭크부터" end
            local needLv = self:NodeLevel(id, lv + 1)
            if playerLevel < needLv then return "캐릭터 Lv" .. tostring(needLv) .. "에 다음 랭크" end
        else
            if playerLevel < def.row then return "Lv" .. tostring(def.row) .. "에 열림" end
            if lv >= self:RankCap(id, playerLevel) then return "Lv" .. tostring(self:NextRankLevel(id, lv + 1)) .. "에 다음 랭크" end
        end
        if skillPoints <= 0 then return "스킬 포인트 부족" end
        return ""
    end

    @ExecSpace("Server")
    method void RequestLearn(string id)
        -- 서버가 승인한 투자만 결과와 실제 배정 칸을 소유자에게 알린다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return end
        local reason = self:CanLearn(id, stats.Level, stats.SkillPoints)
        if reason ~= "" then
            _Util:Warn(reason, pc.UserId)
            return
        end
        stats.SkillPoints = stats.SkillPoints - 1
        local first = self:GetLevel(id) == 0
        self.Levels[id] = self:GetLevel(id) + 1
        if first then self:AutoSlot(id) end
        self:RefreshDigest()
        local slot = 0
        for i = 1, 5 do if self:GetSlotSkill(i) == id then slot = i break end end
        self:NotifyLearned(id, self:GetLevel(id), self:GetRankSummary(id, self:GetLevel(id)), slot, pc.UserId)
    end

    @ExecSpace("Client")
    method void NotifyLearned(string id, integer level, string after, integer slot)
        -- RPC 인자로 투자 결과를 받아 동기화 문자열 도착 순서와 무관하게 표시한다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local def = _SkillData:Get(id)
        if def == nil then return end
        -- 알림 판은 두 줄뿐이라 「(Lv12 기준)」 같은 꼬리는 뺀다 (스킬 창 설명에는 그대로 있다)
        local detail = string.gsub(after, "%s*%([^%(%)]*기준%)", "")
        -- 11-05: 망령 도약 줄은 키 이름(스페이스·질주 단추)과 노리는 자리(커서·바라보는 방향)를 담는데 서버는 내 플랫폼·조작을 모르니 내 화면에서 다시 만든다
        --   도약 알림은 두 줄 판이라 키 이름은 아래 줄(hint)로만 · 잠긴 문 예외는 스킬 창 설명에만 (모바일 「바라보는 방향으로」가 길어 세 줄이 됐다)
        if id == "dash_blink" then detail = string.format("%s 최대 %g칸 순간이동 · 벽을 넘음", self:BlinkWhereText(), _GameData.dashBlinkRange)
        elseif id == "wraith_dash" and self:Node("dash_blink") > 0 then detail = self:GetRankSummary(id, level) end
        local hint = ""
        if def.kind == "passive" or def.kind == "node" or def.kind == "aura" then
            hint = "자동 적용"
            if id == "skel_legion" or id == "mage_legion" or string.sub(id, 1, 5) == "mage_" or id == "skel_greatsword" or id == "skel_twin" or id == "command_aura" or id == "dash_legion" then hint = "다음 소환부터 적용" end
        elseif id == "wraith_dash" then
            hint = self:DashKeyName() .. "로 사용"
        elseif slot > 0 then
            local keys = { "A", "S", "D", "F", "우클릭" }
            hint = keys[slot] .. " 배정"
            if Environment:IsMobilePlatform() then hint = slot == 5 and "큰 버튼 배정" or (tostring(slot) .. "번 칸 배정") end
        else hint = "스킬 창의 「스킬 편집」으로 칸에 넣으세요" end
        if id == "raise_skeleton" or id == "raise_mage" then
            if level == 1 and slot > 0 then hint = hint .. " · 처치 후 혼에 사용"
            elseif level > 1 then hint = "강화된 능력치는 다음 소환부터 적용" end
        end
        if id == "shadow_summon" and level > 1 then hint = "강화된 능력치는 다음 소환부터 적용" end
        if id == "dash_blink" then
            -- 11-05 사용자 「망령 질주는 스페이스를 써야 한다는 안내가 있나」: 도약도 질주와 같은 키라고 알린다
            hint = "질주와 같은 키 · " .. self:DashKeyName() .. "로 사용"
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] blink learn notice detail=%s hint=%s", detail, hint)) end
        end
        if id == "deploy_expand" then
            -- 작은 알림은 두 줄 안에 보너스와 다음 목표만 표시한다.
            detail = string.format("그림자 +%d기", _ShadowConfig:GetDeploySkillBonus(level))
            hint = "그림자 증원 최대 단계 달성"
            if level < def.maxLv then
                hint = string.format("다음 랭크는 캐릭터 Lv%d부터", self:NodeLevel(id, level + 1))
            end
        end
        -- 44-7 랭크 단계: 이번 랭크로 단계에 닿았거나 20랭크 「완성」이면 그 한 줄이 아래 줄을 차지한다 (알림 판은 두 줄)
        local stage = def.kind ~= "node" and self:StageReachedAt(id, level) or ""
        if self:IsComplete(id, level) then hint = "완성"
        elseif stage ~= "" then hint = "단계 도달 · " .. stage end
        if (stage ~= "" or self:IsComplete(id, level)) and not Environment:IsPublishedPlay() then log(string.format("[VRF] rank stage notice %s lv=%d stage=%s complete=%s", id, level, stage, tostring(self:IsComplete(id, level)))) end
        if detail ~= "" then detail = detail .. "\n" end
        _UXFeedback:Show((level == 1 and "새 스킬 · " or "스킬 강화 · ") .. def.name .. " Lv" .. tostring(level), detail .. hint, def.icon)
    end

    method number GetEffectPower(string id, integer level)
        -- 시전과 강화 미리보기에서 공유하는 저항 적용 전 수치. 피해·비율 효과는 skillPowerMult(10-09 30% 하향),
        -- 지속 시간·개수·반경·배율형(정예 승격)은 그대로 둔다.
        local raw = self:RawEffectPower(id, level)
        if id == "bone_armor" then
            -- 흡수량은 피해 배율 대신 캐릭터 레벨당 +10% (Lv12 · 6랭크 ≈ 생명 한 줄)
            ---@type PlayerStats
            local ast = self.Entity:GetComponent("script.PlayerStats")
            local alv = ast ~= nil and ast.Level or 1
            return math.floor(raw * (1 + 0.1 * (alv - 1)))
        end
        local flat = { terror = true, bone_prison = true, poison_spread = true, elite_promote = true, mark_weakness = true, enfeeble = true,
            bone_rite = true, bone_giant = true, bone_offering = true, swift_step = true, plague_curse = true, wraith_dash = true }
        if flat[id] then return raw end
        -- 공격 스킬 피해는 캐릭터 레벨을 따라 커진다 (몬스터 생명이 레벨마다 +30% 오르는데 스킬은 스킬 레벨만 따라가 금방 약해졌다)
        local scale = 1
        if self:IsDamageSkill(id) then scale = self:CharDamageScale() * _GameData.skillDmgMult end
        return math.floor(raw * _GameData.skillPowerMult * scale * 10 + 0.5) / 10
    end

    method boolean IsDamageSkill(string id)
        local ids = { bone_shard = true, poison_mist = true, bone_spikes = true, bone_storm = true, soul_torrent = true, death_wave = true, shadow_sacrifice = true, hex_flame = true, frost_soul = true }
        return ids[id] == true
    end

    method number CharDamageScale()
        -- 1 + skillDmgPerCharLevel × (캐릭터 레벨 - 1)
        ---@type PlayerStats
        local st = self.Entity:GetComponent("script.PlayerStats")
        local lv = st ~= nil and st.Level or 1
        return 1 + _GameData.skillDmgPerCharLevel * (math.max(1, lv) - 1)
    end

    method integer ProjectileTier(integer level)
        -- 투사체 스킬 레벨 구간 0~3 (config pierceTier2·3·4Lv = 5·8·12). 10-28 사용자 「모두 관통만 늘어 매력이 빠진다」 → 투사체 A안:
        --   골편 = 부채꼴 발 수 · 서리 혼 = 쪼개짐 · 저주 불꽃 = 폭발 반경이 같은 구간에서 커진다
        if level < _GameData.pierceTier2Lv then return 0 end
        if level < _GameData.pierceTier3Lv then return 1 end
        if level < _GameData.pierceTier4Lv then return 2 end
        return 3
    end

    method integer GetBoneShardCount(integer level)
        -- 골편 투척 발 수: 레벨 구간마다 1·2·3·4발 부채꼴 (10-28 투사체 A안 — 예전엔 강화 「다중 투사체」 랭크)
        if level <= 0 then return 0 end
        return math.min(math.floor(_GameData.boneShardMaxCount), 1 + self:ProjectileTier(level)) + self:ChoiceTier(1, "soul")   -- 선택 보상 1차 주문 「뼛조각 하나 더」
    end

    method number GetBoneShardSpread()
        -- 골편 부채꼴 이웃한 발 사이 각도(도): 15° − 강화 「모인 뼈」 랭크마다 25% (가까운 한 적에게 여러 발이 몰린다)
        return 15 * (1 - 0.25 * self:Node("shard_multi"))
    end

    method integer GetFrostSplitCount(integer level)
        -- 서리 혼 「쪼개짐」: 처음 맞은 적에서 갈라지는 파편 수 (구간마다 0·2·3·4)
        local t = self:ProjectileTier(level)
        if t <= 0 then return 0 end
        return t + 1
    end

    method number GetHexBurstRadius(integer level)
        -- 저주 불꽃 「폭발」: 저주 걸린 적에 맞으면 터지는 반경 (구간마다 0.9·1.1·1.3·1.6)
        --   11-03 강화 「피투성이 난장판」(옛 낙인 연소 자리 · Fable 결정 7): 폭발 범위 +15%/랭크
        local radii = { 0.9, 1.1, 1.3, 1.6 }
        return radii[self:ProjectileTier(level) + 1] * (1 + 0.15 * self:Node("flame_hex"))
    end

    method integer GetShardHits()
        -- 골편 한 발이 맞히는 적 수: 기본 1 (10-28 투사체 A안 — 관통 없이 발 수로 넓힌다) + 선택 보상 2차 주문 「꿰뚫는 골편」 단계
        --   (보통 +1 · 악몽 +2 · 지옥 +3 · 11-01 사용자 결정 · docs/design/49 — 지운 Lv15 관통 스킬 대신 · 튕긴 뼛조각은 1마리 그대로)
        return 1 + self:ChoiceTier(2, "soul")
    end

    -- ───────── 랭크 단계 (44-7 · 기획서 44 §4-6 A) ─────────
    -- 숨어 있던 「그 스킬에 포인트를 몰았을 때만 오는 사건」을 사다리·시간선·추천 카드·알림에 보이게 한다.
    -- 단계는 효과 레벨(장비 스킬 레벨 포함 · GetPowerLevel) 기준 — 투사체 3종은 pierceTier 5·8·12, 영혼 격류·역병 저주는 5레벨마다.

    method table RankStages(string id)
        -- { { lv = 효과 레벨, text = "4발" }, … } 낮은 레벨부터. 단계가 없는 스킬은 빈 표
        local list = {}
        local tiers = { math.floor(_GameData.pierceTier2Lv), math.floor(_GameData.pierceTier3Lv), math.floor(_GameData.pierceTier4Lv) }
        if id == "bone_shard" then
            for _, lv in ipairs(tiers) do table.insert(list, { lv = lv, text = tostring(self:GetBoneShardCount(lv)) .. "발" }) end
        elseif id == "frost_soul" then
            for _, lv in ipairs(tiers) do table.insert(list, { lv = lv, text = "파편 " .. tostring(self:GetFrostSplitCount(lv)) .. "개" }) end
        elseif id == "hex_flame" then
            for _, lv in ipairs(tiers) do table.insert(list, { lv = lv, text = string.format("폭발 %.1f칸", self:GetHexBurstRadius(lv)) }) end
        elseif id == "soul_torrent" then
            for lv = 5, 20, 5 do table.insert(list, { lv = lv, text = tostring(self:GetTorrentCount(lv)) .. "발" }) end
        elseif id == "plague_curse" then
            for lv = 5, 20, 5 do table.insert(list, { lv = lv, text = "옮는 적 " .. tostring(math.floor(self:RawEffectPower("plague_curse", lv))) }) end
        elseif id == "raise_skeleton" then
            -- 48 §1-2 · §9 「랭크 8: 방패 해골」
            table.insert(list, { lv = math.floor(_GameData.skelEvolveRank), text = "방패 해골" })
        elseif id == "raise_mage" then
            -- 48 §2-3 (§9 후보 2 「마법 강화」): 구간 6·11·16에서 관통·파편·폭발·영혼이 함께 커진다
            for _, lv in ipairs(self:MageTierLevels()) do table.insert(list, { lv = lv, text = "마법 강화" }) end
        end
        return list
    end

    method table MageTierLevels()
        -- 48 §2-3 해골 마법사 랭크 구간이 열리는 효과 레벨 (config mageTier2·3·4Lv = 6·11·16)
        local out = {}
        table.insert(out, math.floor(_GameData.mageTier2Lv))
        table.insert(out, math.floor(_GameData.mageTier3Lv))
        table.insert(out, math.floor(_GameData.mageTier4Lv))
        return out
    end

    method integer SkelGuardPct(integer level)
        -- 48 §1-2 진화 방패 해골 받는 피해 감소 % (효과 레벨 8·14·20 → 20·25·30 · config skelEvolve* 초안). 진화 전이면 0
        if level < math.floor(_GameData.skelEvolveRank) then return 0 end
        local step = 0
        if level >= math.floor(_GameData.skelEvolveGuardRank2) then step = 1 end
        if level >= math.floor(_GameData.skelEvolveGuardRank3) then step = 2 end
        return math.floor(_GameData.skelEvolveGuardPct + _GameData.skelEvolveGuardStep * step)
    end

    method integer MageTier(integer level)
        -- 48 §2-3 해골 마법사 랭크 구간 0~3 (효과 레벨 1·6·11·16 · config mageTier*Lv)
        if level < math.floor(_GameData.mageTier2Lv) then return 0 end
        if level < math.floor(_GameData.mageTier3Lv) then return 1 end
        if level < math.floor(_GameData.mageTier4Lv) then return 2 end
        return 3
    end

    method table MageSchoolAt(integer level)
        -- 48 §2-3 표 (표시용 · 실제 투사체 설정은 갈래 B MageBolts가 같은 config 값으로): 뼈 투척 관통 · 서리 파편 · 불꽃 폭발 반경 · 영혼 발 수 · 저주 낙인 %
        local t = self:MageTier(level)
        local rank = math.max(1, level)
        local out = {}
        out.pierce = math.floor(_GameData.magePierceBase) + t
        out.shards = math.floor(_GameData.mageShardsBase) + t
        out.burst = _GameData.mageBurstBase + _GameData.mageBurstStep * t
        out.torrent = math.floor(_GameData.mageTorrentBase) + t
        out.curse = math.floor((_GameData.mageCursePct + _GameData.mageCursePerRank * (rank - 1)) * 10 + 0.5) / 10
        return out
    end

    method string MeteorText(integer level)
        -- 48 §4-4 「큰 메테오」 지금/다음 줄: 착지 반경 +0.15칸/랭크 (상한 radiusMax 2.0 — 실제 타격·효과와 같은 상한) · 영창 −0.1초/랭크
        local opt = _GameData:GetGiant("mage").s2Opts or {}
        local base = opt.radius or 1.8
        local cap = opt.radiusMax or 2
        local chant = opt.chant or 1
        local r = math.min(cap, base + 0.15 * level)
        local tag = ""
        if r >= cap then tag = "(최대)" end
        return string.format("메테오 반경 %.2f칸%s · 영창 %.1f초", r, tag, math.max(0.4, chant - 0.1 * level))
    end

    method string NovaText()
        -- 48 V2 「폭발 증폭」(giant_mage_pull · 1랭크) 지금/다음 줄: 화염 노바는 한 번만 터진다 — 노드가 있으면 그 한 번이 ×novaAmpMul(1.5) · 반경은 s1Radius(3.75) 그대로
        --   (rite_giants.csv mage s1Radius·s1Opts novaAmpMul — 실제 타격과 같은 값 · 둘째 파동·흡인 없음)
        local spec = _GameData:GetGiant("mage")
        local opt = spec.s1Opts or {}
        return string.format("노바 폭발 피해 ×%g · 반경 %g칸", opt.novaAmpMul or 1.5, spec.s1Radius or 3.75)
    end

    method integer GearRanks(string id)
        -- 효과 레벨 − 찍은 랭크 (장비 「스킬 +N」·선택 보상) — 사다리의 단계 칸을 그만큼 앞으로 당긴다
        local lv = self:GetLevel(id)
        if lv <= 0 then return 0 end
        return math.max(0, self:GetPowerLevel(id) - lv)
    end

    method table StageRanks(string id)
        -- 사다리에 단계 점을 찍을 랭크 → 단계 글 ({ [랭크] = "4발" }). 장비로 당겨진 만큼 앞 칸 (1칸 아래로는 안 간다)
        local out = {}
        local gear = self:GearRanks(id)
        for _, s in ipairs(self:RankStages(id)) do
            local rank = math.max(1, s.lv - gear)
            if out[rank] == nil then out[rank] = s.text end
        end
        return out
    end

    method any NextStage(string id)
        -- 지금 효과 레벨 다음 단계 { lv, text, left = 남은 랭크 } (없으면 nil)
        local power = self:GetPowerLevel(id)
        for _, s in ipairs(self:RankStages(id)) do
            if s.lv > power then return { lv = s.lv, text = s.text, left = s.lv - power } end
        end
        return nil
    end

    method string StageReachedAt(string id, integer rank)
        -- 찍은 랭크가 rank가 되는 순간 도달하는 단계 글 (없으면 "") — 추천 카드 금 테두리 · 알림 한 줄
        local power = rank + self:GearRanks(id)
        for _, s in ipairs(self:RankStages(id)) do
            if s.lv == power then return s.text end
        end
        return ""
    end

    method boolean IsComplete(string id, integer rank)
        -- 20랭크 「완성」 (44-7 · 사용자 확정 글귀 99): 최대 랭크 20인 메인 스킬을 끝까지 찍었다
        local def = _SkillData:Get(id)
        return def ~= nil and def.kind ~= "node" and def.maxLv >= 20 and rank >= def.maxLv
    end

    -- ───────── 땅 찍기 범위 원 (44-3 A · 기획서 44 §4-2 A) ─────────

    method boolean IsGroundSkill(string id)
        -- 조준점에 장판·저주를 까는 스킬 (투사체·자기 중심·혼 스킬 제외). 뼈 의식은 2기 「뼈 회오리」 문턱을 넘긴 동안만 원을 그린다
        local ids = { poison_mist = true, bone_prison = true, mark_weakness = true, enfeeble = true, terror = true, thorn_curse = true, life_tap = true, resist_break = true }
        return ids[id] == true
    end

    method number GroundRadius(string id)
        -- 그 스킬의 판정 반경 — SkillEffects.PoisonMist · BonePrison · Curse와 같은 식 (바꾸면 둘 다)
        if id == "poison_mist" then return 1.3 * (1 + 0.2 * self:Node("mist_wide")) end
        if id == "bone_prison" then return 1.3 * (1 + 0.15 * self:Node("prison_wide")) end
        if id == "bone_rite" then return self:RiteWhirlRadius() end
        if self:IsGroundSkill(id) then
            ---@type PlayerStats
            local stats = self.Entity:GetComponent("script.PlayerStats")
            local bonus = stats ~= nil and stats.BonusCurse / 100 or 0
            local base = id == "enfeeble" and self:EnfeebleRadius() or 1.5   -- 11-03 강화 「약화의 오라」 위큰 범위 +20%/랭크
            return base * (1 + bonus + 0.15 * self:Node("curse_area"))
        end
        return 0
    end

    method Vector2 ClampGroundPoint(Vector2 me, Vector2 target)
        -- 땅 찍기 조준점: GroundCastRange(6칸)를 넘으면 그 방향 6칸 (예전엔 독안개·저주가 「시전할 곳이 너무 멉니다」로 실패)
        local ray = target - me
        if ray:Magnitude() > self.GroundCastRange then return me + ray:Normalize() * self.GroundCastRange end
        return target
    end

    @ExecSpace("ClientOnly")
    method any RangePreview()
        -- 지금 그릴 범위 원 { id, center, r, r2 } (없으면 nil): PC 땅 찍기 키 누름 · 모바일 칸 끌기 · 뼈 의식 2기 문턱
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() or not _Util:IsAlive(self.Entity) then
            if self.GroundHoldSlot ~= 0 then self:CancelGroundHold() end
            return nil
        end
        if _GameConst:IsTown(self.Entity.CurrentMap) then return nil end
        local id = ""
        if self.GroundHoldSlot ~= 0 then
            if self.GroundHoldMap ~= self.Entity.CurrentMap then self:CancelGroundHold() return nil end
            id = self:GetSlotSkill(self.GroundHoldSlot)
        elseif self.RiteHoldAt >= 0 then
            -- 11-03 C안: 2단계는 조준점 장판이 아니라 표적을 쫓는 돌진 회오리라 조준점 범위 원을 그리지 않는다 (머리 위 충전 고리만)
            return nil
        elseif Environment:IsMobilePlatform() and _MobilePad.GestureTouchId ~= 0 and not _MobilePad.GestureBasic and not _MobilePad.EditMode then
            if _MobilePad.CancelHover then return nil end   -- I04: 「취소」 위에 손가락이 있으면 놓아도 쓰지 않으므로 범위 원을 끈다
            id = self:GetSlotSkill(_MobilePad.GestureSlot)
        end
        if id == "" or (id ~= "bone_rite" and not self:IsGroundSkill(id)) or self:GetPowerLevel(id) <= 0 then return nil end
        local me = _Util:Pos2(self.Entity)
        local center = self:ClampGroundPoint(me, self:GetAimPoint(id))
        local r2 = 0
        if id == "bone_prison" and self:Node("prison_pull") > 0 then r2 = 2.4 + 0.3 * self:Node("prison_pull") end   -- 「끌어당기는 뼈」 끌어오는 반경 (SkillEffects.BonePrison)
        return { id = id, center = center, r = self:GroundRadius(id), r2 = r2 }
    end

    @ExecSpace("ClientOnly")
    method boolean BeginGroundHold(integer slot)
        -- PC 땅 찍기 키를 누른 순간: 범위 원을 띄운다 (떼면 HandleKeyUpEvent → CastSlot). 쿨다운 중이면 원 없이 바로 그 칸을 눌러 안내만
        if self.GroundHoldSlot ~= 0 then return true end   -- 키 반복 입력은 무시
        local id = self:GetSlotSkill(slot)
        if not self:IsGroundSkill(id) or self:GetPowerLevel(id) <= 0 or self:CooldownLeft(id) > 0.05 or _GameConst:IsTown(self.Entity.CurrentMap) then return false end
        self.GroundHoldSlot = slot
        self.GroundHoldMap = self.Entity.CurrentMap
        if not Environment:IsPublishedPlay() then log("[VRF] ground hold start " .. id .. " slot=" .. tostring(slot)) end
        return true
    end

    @ExecSpace("ClientOnly")
    method void CancelGroundHold()
        -- 창이 열리거나 죽거나 맵을 옮기면 누르던 땅 찍기를 버린다 (아무것도 쓰지 않는다)
        if self.GroundHoldSlot == 0 then return end
        self.GroundHoldSlot = 0
        self.GroundHoldMap = nil
        if not Environment:IsPublishedPlay() then log("[VRF] ground hold cancel") end
    end

    method number GetCurseDuration(integer level)
        -- 저주 지속: 1레벨 4초, 5레벨까지 +0.5초씩, 6레벨부터 +1초씩 (20레벨 21초)
        if level <= 0 then return 0 end
        local base = 4 + 0.5 * math.min(level - 1, 4) + 1 * math.max(0, level - 5)
        return self:CurseDurationWithMods(base)
    end

    method number CurseDurationWithMods(number base)
        -- 저주 지속 보정 공통 (낙인·쇠약·가시·약탈·붕괴의 레벨 지속, 공포의 도주 초): 강화 「저주 지속」 +15%/랭크 + 장비 「저주 지속 %」(docs/design/19)
        -- + 선택 보상 1차 저주 「긴 저주」 +2·+3·+4초. 44 §3-3: 공포는 지속 자리에 도주 초를 따로 넘겨 이 보정을 받지 못했다 (설명은 「모든 저주」)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local gear = 0
        if stats ~= nil then gear = stats.BonusCurseDur / 100 end
        local choice = self:ChoiceTier(1, "curse")
        return math.floor(base * (1 + 0.15 * self:Node("curse_duration") + gear) * 10 + 0.5) / 10 + (choice > 0 and choice + 1 or 0)
    end

    method number GetCursePowerMult(string id)
        -- 수치형 저주(낙인·쇠약(+강화 쇠퇴)·가시·약탈·저항 붕괴) 세기: 강화 「깊은 저주」 랭크당 +10% + 장비 「저주 효과 %」 (docs/design/19). 시전·툴팁 공통
        local pctCurse = { mark_weakness = true, enfeeble = true, thorn_curse = true, life_tap = true, resist_break = true }
        if not pctCurse[id] then return 1 end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local gear = 0
        if stats ~= nil then gear = stats.BonusCurseEff / 100 end
        return 1 + 0.1 * self:Node("curse_power") + gear
    end

    method number DamageCurve(string id, integer level)
        -- 공격 스킬 공통 곡선 (10-24 사용자 결정 A안): 늦게 배우는 스킬은 그동안 찍었을 랭크만큼 앞에서 출발한다.
        -- 가상 레벨 = 스킬 레벨 + (배우는 캐릭터 레벨 - 1) ÷ 2 → 기본 skillCurveBase + skillCurvePerLv × (가상 레벨 - 1), 여기에 스킬 성격 배율.
        -- 같은 캐릭터 레벨에서 다 찍었다면 늦게 배운 스킬이 더 세다 (예전: 1레벨 골편 투척이 9레벨 저주 불꽃보다 셌다)
        local role = { bone_shard = _GameData.boneShardDmgMul, hex_flame = 1.0, poison_mist = 0.35, bone_spikes = 1.2, frost_soul = 0.9,
            bone_storm = 0.3, shadow_sacrifice = 2.0, soul_torrent = 0.8, death_wave = 2.5 }
        local mul = role[id]
        if mul == nil then return 0 end
        local def = _SkillData:Get(id)
        local row = def ~= nil and def.row or 1
        local virtual = level + math.max(0, row - 1) // 2
        -- 62 §7-2 안 ②′ (11-03 Fable 결정 1): 해금 ≥ skillLateRow(24) 공격 스킬(본 스톰·세크리파이스·본 스피리트·데스 노바)만 랭크 램프 ×(1 + 1% × (랭크 − 1)) · R1 그대로
        local ramp = row >= _GameData.skillLateRow and (1 + _GameData.skillLateRampPct / 100 * (math.max(1, level) - 1)) or 1
        return mul * (_GameData.skillCurveBase + _GameData.skillCurvePerLv * (virtual - 1)) * ramp
    end

    method number RawEffectPower(string id, integer level)
        if level <= 0 then return 0 end
        -- 공격 스킬 한 발(독안개는 초당 · 뼈 폭풍은 0.5초당 · 그림자 희생은 + 희생한 그림자 공격력 ×2 · 혼 흡수는 피해의 절반 회복): 공통 곡선
        local curve = self:DamageCurve(id, level)
        if curve > 0 then return curve end
        if id == "bone_rite" then return 2.5 + 0.25 * (level - 1) end  -- 본 노바 1단계(해골 폭탄) 해골 공격력 배율 (62 §7-1: +0.15 → +0.25/랭크 · 해골 공격력이 이미 캐릭터 레벨을 따른다)
        if id == "bone_giant" then return _GameData.riteGiantRankPct * (level - 1) end   -- 11-02 본 골렘: 거인 공격·생명 + % (1랭크 = 0 = 예전 뼈 의식 5기 거인 그대로)
        if id == "bone_offering" then return 25 + 2.1 * (level - 1) end   -- 소환수 최대 생명 대비 회복 % (62 §7-1: +1.5 → +2.1/랭크 · 「진한 성찬」 삭제)
        if id == "swift_step" then return 8 + (level - 1) end          -- 이동 속도 % (10-24: 4 → 8 시작)
        if id == "plague_curse" then return 3 + level // 5 end         -- 저주가 옮는 적 수
        if id == "wraith_dash" then return self:Node("dash_blink") > 0 and _GameData.dashBlinkRange or (3 + 2 * (math.max(1, level) - 1) / 9) end  -- 질주 거리 (칸 · 11-04 질주 개편: 10랭크 5칸 · 랭크당 +0.222칸) · 강화 「망령 도약」이면 조준점까지 최대 dashBlinkRange(6)칸
        if id == "mark_weakness" then return 20 + 2 * (level - 1) end   -- 1레벨 20% → 20레벨 58%
        if id == "enfeeble" then return _GameData.enfeebleBasePct + _GameData.enfeeblePerLvPct * (level - 1) end   -- 62 §7-1: +2%p/랭크 (상한 enfeebleMaxPct는 저주 세기를 곱한 뒤 · EnfeebleCap)
        if id == "elite_promote" then return _GameData.elitePromoteBaseMul + _GameData.elitePromotePerLvMul * (level - 1) end
        local k = level - 1
        if id == "thorn_curse" then return 50 + 5 * k end            -- 반사 %
        if id == "terror" then return 3 + 0.2 * k end                -- 도주 초
        if id == "life_tap" then return 10 + 1 * k end               -- 흡혈 %
        if id == "resist_break" then return 25 + 2.3 * k end         -- 저항 감소 %p (62 §7-1: 원식 +1.5 → +2.3 · 표시 = × skillPowerMult 0.7)
        if id == "bone_prison" then return 2 + 0.15 * k end          -- 속박 초
        if id == "poison_spread" then return 1.25 + 0.25 * level end -- 확산 반경 (강화 노드 랭크 1~3: 1.5·1.75·2.0)
        if id == "command_aura" then return 10 + 2 * k end           -- 소환수 공격·생명 %
        if id == "bone_armor" then return 20 + 10 * k end   -- 흡수량 (캐릭터 레벨 비례는 GetEffectPower · 11-03 「두꺼운 뼈」 → 「급속 골화」로 흡수량 곱 없음)
        return 0
    end

    -- ───────── 뼈 쐐기 (11-04 사용자: 드레인 라이프 자리 · 기획 62 §14) ─────────

    method number ImpactStunSec(integer rank)
        -- 강화 「급작스러운 충격」 기절 + 초: 3랭크 = impactStunFullSec(0.5) · 랭크 r = 0.5 × r ÷ 3 (0.17·0.33·0.50 · 사용자 채택 문구 「기절 +0.5초」)
        if rank <= 0 then return 0 end
        return _GameData.impactStunFullSec * math.min(rank, 3) / 3
    end

    method integer PillarExtra(integer rank)
        -- 강화 「뼈 기둥」 주변 추가 대상 수: 반올림(2 × r ÷ 3) → 1·1·2기 (3랭크 = 「대상과 주변 2기」)
        if rank <= 0 then return 0 end
        return math.floor(_GameData.pillarExtraFull * math.min(rank, 3) / 3 + 0.5)
    end

    method number SpikeRadius(integer pillarRank)
        -- 판정 반지름: 1.2칸 + 「뼈 기둥」 0.2칸/랭크 (기본 1.2칸 안 적은 모두 · 그 밖에서 이 반지름 안 적을 가까운 순으로 PillarExtra기 — SkillEffects.BoneSpikes)
        return _GameData.spikeRadius + _GameData.pillarRadiusPerRank * math.max(0, pillarRank)
    end

    method number SpikeStunSec(integer level, integer impactRank)
        -- 기절 초: min(2.0, 1.0 + 0.05 × (레벨 − 1)) + 급작스러운 충격 → 상한 2.5
        if level <= 0 then return 0 end
        local base = math.min(_GameData.spikeStunMaxSec, _GameData.spikeStunBaseSec + _GameData.spikeStunPerRankSec * (level - 1))
        return math.min(_GameData.impactStunMaxSec, base + self:ImpactStunSec(impactRank))
    end

    method integer GetTorrentCount(integer level)
        -- 영혼 격류 발사 수: 3 + 5레벨마다 1
        return 3 + math.floor(math.max(0, level) / 5)
    end

    -- 44 결정 4 교체 노드 수치 (data/config.csv · 효과는 SkillEffects · PlayerStats · PlayerAttack)
    method integer AfterStepPct(integer rank)
        -- 「잔걸음」(질풍 걸음 자리): 질주 뒤 이동 속도 +15/20/25%
        if rank <= 0 then return 0 end
        return math.floor(_GameData.afterStepBasePct + _GameData.afterStepPerRankPct * rank)
    end

    method number ArmorBurstMul(integer rank)
        -- 「터지는 갑옷」(가시 갑옷 자리): 갑옷이 다 깨질 때 그 갑옷이 막은 피해 합 × 0.5/0.75/1.0
        if rank <= 0 then return 0 end
        return _GameData.armorBurstBaseMul + _GameData.armorBurstPerRankMul * rank
    end

    method integer FrostMarkPct(integer rank)
        -- 「서리 표식」(시린 혼 자리): 서리 혼에 느려진 적에게 골편 피해 +10/15/20%
        if rank <= 0 then return 0 end
        return math.floor(_GameData.frostMarkBasePct + _GameData.frostMarkPerRankPct * rank)
    end

    method table GetCommandAura()
        -- 호령(항상 켜짐): 소환수 공격·생명 %, 이동 속도 %, 모든 저항 %p. 다음 소환부터 적용한다.
        -- 질주 강화 「군단 질주」의 이동 %도 여기서 더한다 (소환할 때 확정 — 그림자·해골 공통)
        return self:CommandAuraAt(self:GetPowerLevel("command_aura"))
    end

    method table CommandAuraAt(integer lv)
        -- 가상 랭크를 받는 순수 미리보기. 현재 소환 공식도 이 함수를 쓴다.
        local rush = 5 * self:Node("dash_legion")
        if lv <= 0 then return { atk = 0, speed = rush, resist = 0 } end
        return { atk = self:GetEffectPower("command_aura", lv), speed = 5 + 0.5 * (lv - 1) + rush, resist = 5 + (lv - 1) }
    end

    method string GetRankSummary(string id, integer level)
        -- 효과 비교용 짧은 요약. 피해는 대상 저항·등급 보정 전, 소환수는 다음 소환 기준이다.
        if level <= 0 then return "" end
        local def = _SkillData:Get(id)
        if def == nil or not def.impl then return "" end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return "" end
        if id == "raise_skeleton" or id == "raise_mage" then
            local kind = id == "raise_skeleton" and "skeleton" or "mage"
            local values = _UndeadSystem:GetBaseStats(kind, level, 0, stats.Level)
            local equip = math.max(0.1, 1 + stats:GetMinionPct() / 100) * (1 + self:GetCommandAura().atk / 100)
            local count = _UndeadSystem:MaxFor(self.Entity, kind, level)
            local atk, hp = math.max(1, math.floor(values.atk * equip)), math.max(1, math.floor(values.hp * equip))
            if kind == "mage" then
                -- 48 §2-3 (글귀 §9 추천 1 「관통 · 파편 · 폭발 · 영혼」): 속성 넷의 특성이 랭크 구간 1·6·11·16에서 함께 커진다 · 저주 속성을 배웠으면 낙인 %
                local m = self:MageSchoolAt(level)
                local curse = self:Node("mage_curse") > 0 and string.format(" · 앰플리파이 +%g%%", m.curse) or ""
                return string.format("최대 %d기 · 공격 %d · 생명 %d · 관통 %d · 파편 %d · 폭발 %.1f칸 · 영혼 %d발%s (다음 소환 기준)", count, atk, hp, m.pierce, m.shards, m.burst, m.torrent, curse)
            end
            if level >= math.floor(_GameData.skelEvolveRank) then
                -- 48 §1-2: 효과 레벨 8부터 기본형이 방패 해골 (생명 ×1.1 · 받는 피해 감소 · 4초마다 도발)
                return string.format("최대 %d기 · 방패 해골 공격 %d · 생명 %d · 받는 피해 -%d%% · 4초마다 도발 (다음 소환 기준)", count, atk, math.max(1, math.floor(values.hp * 1.1 * equip)), self:SkelGuardPct(level))
            end
            return string.format("최대 %d기 · 일반형 공격 %d · 생명 %d (다음 소환 기준)", count, atk, hp)
        end
        if id == "shadow_summon" then
            if level == 1 then return "혼 추출·그림자 소환 해금" end
            return string.format("그림자 공격·생명 +%g%%", _GameData.shadowSummonPerLvPct * (level - 1))
        end
        if id == "extract_mastery" then return string.format("추출 확률 +%g%%p", _GameData.extractMasteryPerLv * level * 100) end
        if id == "deploy_expand" then
            -- 캐릭터 레벨이 모자라 아직 효과가 없는 랭크는 빼고 보여 준다 (실제 한도 GetDeployBonus와 같은 규칙)
            local bonus = _ShadowConfig:GetDeploySkillBonus(self:NodeUsable(id, level, stats.Level))
            ---@type ShadowCommander
            local cmd = self.Entity:GetComponent("script.ShadowCommander")
            local limit = cmd ~= nil and cmd:GetDeployLimit() or _ShadowConfig:GetDeployLimit(bonus + stats.BonusDeploy, stats.BonusShadowCap)
            return string.format("그림자 +%d기 · 지금 함께 다닐 수 있는 그림자 %d기", bonus, limit)
        end
        -- 강화 노드 (docs/design/16)
        local nodeText = {
            skel_legion = string.format("해골 전사 최대 수 +%d", level),
            skel_greatsword = string.format("대검 해골 %d기 · 범위 베기 피해 ×%.2f · 반경 ×1.8 · 공격 간격 ×1.4 · 생명 +20%%", level, 0.65 + 0.15 * level),
            skel_twin = string.format("쌍칼 해골 %d기 · 공격 속도 +%d%% · 생명 -15%%", level, 20 + 10 * level),
            shard_multi = string.format("부채꼴 각도 -%d%% (가까운 적에게 여러 발)", 25 * level),
            curse_area = string.format("모든 저주 범위 +%d%%", 15 * level),
            curse_duration = string.format("모든 저주 지속 +%d%%", 15 * level),
            curse_power = string.format("수치형 저주 효과 +%d%%", 10 * level),
            armor_thick = string.format("본 아머가 다 깨지면 2초 뒤 최대치의 %d%%로 다시 두름 (시전마다 한 번)", self:ArmorReformPct(level)),
            armor_thorns = string.format("갑옷이 깨질 때 반경 1.5에 막은 피해 합 ×%.2f", self:ArmorBurstMul(level)),
            skel_burst = string.format("쓰러질 때 반경 1.5에 해골 공격력 ×%.1f 피해", 0.5 * level + 0.5),
            shard_bounce = string.format("맞힌 뒤 가까운 적에게 %d번 튕김", level),
            shard_spike = string.format("튕김이 닿는 거리 %d칸", self:ShardBounceRange(level)),
            bomb_wide = string.format("해골 폭탄 범위 %.2f · 회오리 범위 %.2f", 1.6 * (1 + 0.15 * level), _GameData.riteWhirlRadius * (1 + 0.15 * level)),
            rite_fork = string.format("폭탄 돌진 해골 %d기 · 회오리 %d갈래 (갈래 피해 %d%%)", 1 + level, 1 + level, math.floor(_GameData.riteWhirlForkMul * 100 + 0.5)),
            rite_reach = string.format("회오리 돌진 거리 %.1f칸", self:RiteWhirlReach(level)),
            flame_hex = string.format("헥스블라스트 폭발 범위 +%d%%", 15 * level),
            flame_twin = string.format("불꽃 화살 %d발", 1 + level),
            frost_long = string.format("표식 남은 적에게 티스 피해 +%d%%", self:FrostMarkPct(level)),
            frost_shatter = string.format("느려진 적이 죽으면 프로즌 오브 피해의 %d%% 파편", 30 * level),
            offering_wide = string.format("본 오퍼링 범위 %.1f", 4 * (1 + 0.25 * level)),
            offering_frenzy = string.format("5초간 소환수 공격 속도 +%d%%", 10 * level),
            skel_resonance = string.format("해골 공격력 ×%.1f · 반경 %.1f칸 · 해골마다 %.1f초", _SkeletonResonance.AtkMult, _SkeletonResonance.Radius, _SkeletonResonance.Cooldown),
            dash_charge = string.format("질주 %d번 연달아", 1 + level),
            dash_legion = string.format("질주하면 3칸 밖 소환수가 곁으로 도약 · 소환수 이동 +%d%%", 5 * level),
            dash_blink = string.format("질주가 순간이동으로 · %s · %s 최대 %g칸 · 벽을 넘음 (잠긴 문은 못 넘음)", self:DashKeyName(), self:BlinkWhereText(), _GameData.dashBlinkRange),
            step_gale = string.format("질주 뒤 %.1f초간 이동 속도 +%d%%%s", _GameData.afterStepSec, self:AfterStepPct(level), self:GetLevel("wraith_dash") > 0 and "" or " (질주를 배우면)"),
            step_hunt = string.format("처치하면 3초간 이동 속도 +%d%%", 4 * level),
            storm_fast = string.format("타격 간격 %.2f초", 0.5 * (1 - 0.15 * level)),
            elite_twin = "정예 2기까지 유지",
            mist_wide = string.format("포이즌 미스트 범위 +%d%%", 20 * level),
            mist_thick = string.format("포이즌 미스트 지속 +%d초", level),
            mage_legion = string.format("해골 마법사 최대 수 +%d", level),
            -- 48 §2-4 「저주 속성」 (1랭크): 낙인 %는 해골 마법사 효과 레벨을 따른다 (8 + 0.6 × (랭크 − 1))
            mage_curse = string.format("저주 속성 · 맞은 적 4초 받는 피해 +%g%% (앰플리파이와 겹치면 큰 쪽)", self:MageSchoolAt(math.max(1, self:GetPowerLevel("raise_mage"))).curse),
            enfeeble_deep = string.format("위큰 범위 +%d%%", 20 * level),
            enfeeble_decay = string.format("위큰에 쇠퇴: 이동 속도·공격력 -%d%%", 8 * level),
            prison_wide = string.format("본 프리즌 범위 +%d%%", 15 * level),
            prison_pull = string.format("반경 %.1f 안 적을 끌어모은 뒤 가둠", 2.4 + 0.3 * level),
            terror_frenzy = string.format("하울이 끝나면 %.1f초 혼란 (보스 면역)", 1 + 0.5 * level),
            sudden_impact = string.format("뼈 쐐기 기절 +%.2f초 (최대 %g초)", self:ImpactStunSec(level), _GameData.impactStunMaxSec),
            bone_pillars = string.format("대상과 주변 %d기 · 반지름 %.1f칸", self:PillarExtra(level), self:SpikeRadius(level)),
            -- 46-5 거인 강화 (§4-3 「지금 / 다음 랭크」 · 수치 초안 · 글귀 승인 전)
            giant_shield_wall = string.format("도발 %.1f칸 · 받는 피해 -%d%%", 3 + 0.3 * level, 30 + 3 * level),
            giant_shield_alt = "별도 검토 중",
            giant_shield_phalanx = "거인 곁 2칸 아군 받는 피해 -15%",
            giant_gs_spin = string.format("회전 베기 %d번 · %.1f초", 5 + level, 0.3 * (5 + level)),   -- 10-30 이동형 휠윈드: 0.3초마다 5번(+1/랭크)
            giant_gs_scar = "갈린 땅이 3초 남아 둔화 · 0.5초마다 피해",
            giant_gs_twice = "땅 가르기 세 줄 · 옆 줄 ×0.6",
            giant_twin_flurry = string.format("연속 베기 %d번", 6 + level),
            giant_twin_reset = "돌진으로 쓰러뜨리면 바로 다시 돌진 · 최대 3번",
            giant_twin_echo = "돌진 뒤 잔상 둘이 같은 길을 벰",
            -- 48 §4-4 · 리뷰 정정: 큰 메테오 반경은 상한 2.0칸 (rite_giants.csv mage s2Opts radius·radiusMax) · 영창 감소는 그대로
            giant_mage_meteor = self:MeteorText(level),
            giant_mage_resist = "노바·메테오에 맞은 적 화염 저항 -15 · 4초",
            -- 48 V2: 「폭발 증폭」 = 노바 단발 ×1.5 (예전 「두 겹 고리」 0.4초 뒤 ×0.5를 한 번에 합침 · 같은 id·같은 투자 그대로)
            giant_mage_pull = self:NovaText(),
        }
        if nodeText[id] ~= nil then return nodeText[id] end
        local power = self:GetEffectPower(id, level)
        local cm = self:GetCursePowerMult(id)
        if cm ~= 1 then power = math.floor(power * cm * 10 + 0.5) / 10 end
        if id == "enfeeble" then power = self:EnfeebleCap(power) end
        if id == "elite_promote" then return string.format("그림자 1기 공격·생명 ×%.2f", power) end
        if id == "mark_weakness" then return string.format("받는 피해 +%g%% · %g초", power, self:GetCurseDuration(level)) end
        if id == "enfeeble" then return string.format("적 공격력 -%g%% · %g초", power, self:GetCurseDuration(level)) end
        if id == "thorn_curse" then return string.format("적이 준 피해의 %g%% 반사 · %g초", power, self:GetCurseDuration(level)) end
        if id == "terror" then return string.format("%.1f초간 도주·공격 안 함 (보스 면역)", self:CurseDurationWithMods(power)) end
        if id == "life_tap" then return string.format("때린 피해의 %g%% 회복 · %g초", power, self:GetCurseDuration(level)) end
        if id == "resist_break" then return string.format("모든 저항 -%g · %g초", power, self:GetCurseDuration(level)) end
        if id == "bone_prison" then return string.format("반경 1.3 안 적 %.1f초 묶음 (보스 절반)", power) end
        if id == "poison_spread" then return string.format("독 걸린 적 사망 시 반경 %.2f에 독 확산", power) end
        if id == "command_aura" then
            local aura = self:CommandAuraAt(level)
            return string.format("소환수 공격·생명 +%g%% · 이동 +%g%% · 저항 +%g", aura.atk, aura.speed, aura.resist)
        end
        if id == "bone_armor" then return string.format("흡수 %d (캐릭터 Lv%d 기준)", math.floor(power), stats.Level) end
        if id == "bone_rite" then
            -- 단계별 한 줄: 단계 이름으로 (10-29 글귀 확정 43 — 「1기·2기」가 해골 수인지 헷갈렸다). 11-02 거인 분리: 3단계(화살)까지 · 거인은 본 골렘 줄
            -- 11-03 C안 (62 §9): 3기 뼈 화살 삭제 · 2단계 = 해골 3기 회오리 돌진 (W2 표적 추적 · 한 적 최대 타수)
            local rank = self:RiteRankMul(level)
            local fork = self:Node("rite_fork")
            return string.format("폭탄 ×%.2f·반경 %.2f%s · 회오리 ×%.2f×%d타·반경 %.2f·거리 %.1f칸%s",
                power, 1.6 * (1 + 0.15 * self:Node("bomb_wide")), fork > 0 and string.format("·%d기 돌진", 1 + fork) or "",
                _GameData.riteWhirlMul * rank, self:RiteWhirlTicks(self:Node("rite_reach")), self:RiteWhirlRadius(), self:RiteWhirlReach(self:Node("rite_reach")), fork > 0 and string.format("·%d갈래", 1 + fork) or "")
        end
        if id == "bone_giant" then
            -- 11-02 거인 분리 (52 §2-2 안 ①): 지속 · 랭크 배율(2랭크부터) · 충전 칸 · 지금 무리로 서는 거인 (GiantPlan — 서버 StartGiant와 같은 계획 · 46-6)
            local text = string.format("거인 %d초%s · 충전 %d칸", math.floor(_GameData.riteGiantSeconds), power > 0 and string.format(" · 공격·생명 +%g%%", power) or "", math.floor(_GameData.riteGiantCharges))
            local plan = _UndeadSystem:GiantPlanFor(self.Entity)
            if plan ~= nil then text = text .. " · 지금 무리라면 " .. _GameData:GetGiant(plan.type).name end
            return text
        end
        if id == "bone_offering" then return string.format("소환수 생명 %g%% 회복 · 반경 %.1f · 3초간 받는 피해 -20%%", math.floor(power * 10 + 0.5) / 10, 4 * (1 + 0.25 * self:Node("offering_wide"))) end
        if id == "swift_step" then return string.format("이동 속도 +%g%%", power) end
        if id == "plague_curse" then return string.format("저주가 반경 2.5 안 적 %d기에게 옮음", math.floor(power)) end
        if id == "wraith_dash" then return string.format("%s · 무적 %.2f초 · 재사용 %.1f초%s", self:Node("dash_blink") > 0 and string.format("%s · %s 최대 %g칸 순간이동", self:DashKeyName(), self:BlinkWhereText(), power) or string.format("%.2f칸 질주", power), _GameData.dashInvulnSec, self:DashCooldown(level), self:Node("dash_charge") > 0 and string.format(" · %d번 연달아", 1 + self:Node("dash_charge")) or "") end
        if id == "hex_flame" then return string.format("불꽃 화살 %d발 · 발당 기준 피해 %.1f · 저주 걸린 적 +50%% · 그 자리 반경 %.2f 폭발", 1 + self:Node("flame_twin"), power * (1 + stats:GetSpellPowerPct() / 100), self:GetHexBurstRadius(level)) end
        if id == "frost_soul" then
            local splits = self:GetFrostSplitCount(level)
            return string.format("프로즌 오브 · %s · 기준 피해 %.1f · %g초 둔화", splits > 0 and string.format("맞으면 파편 %d개로 갈라짐", splits) or "1마리 명중", power * (1 + stats:GetSpellPowerPct() / 100), _GameData.frostSlowSec)
        end
        if id == "bone_shard" then return string.format("뼛조각 %d발 부채꼴 · 발마다 %d마리 · 발당 기준 피해 %.1f (Lv%d 기준)", self:GetBoneShardCount(level), self:GetShardHits(), power * (1 + stats:GetSpellPowerPct() / 100), stats.Level) end
        if id == "soul_torrent" then return string.format("유도 영혼 %d발 · 발당 기준 피해 %.1f", self:GetTorrentCount(level), power * (1 + stats:GetSpellPowerPct() / 100)) end
        if id == "bone_spikes" then
            -- 11-04 상세 줄(10-29 글귀 규칙): 한 적 피해 · 기절 초(급작스러운 충격 반영) · 반지름(뼈 기둥 반영 — 주변 대상 수 함께)
            local pillar = self:Node("bone_pillars")
            return string.format("한 적 피해 %d · 기절 %.2f초 · 반지름 %.1f칸%s", math.floor(power * (1 + stats:GetSpellPowerPct() / 100) + 0.5), self:SpikeStunSec(level, self:Node("sudden_impact")), self:SpikeRadius(pillar), pillar > 0 and string.format(" · 주변 %d기", self:PillarExtra(pillar)) or "")
        end
        if id == "shadow_sacrifice" then return string.format("그림자 1기 폭발 · 기준 피해 %.1f + 그림자 공격력×2", power * (1 + stats:GetSpellPowerPct() / 100)) end
        if power > 0 then
            local label = "기준 피해"
            if id == "poison_mist" then label = "초당 기준 피해"
            elseif id == "bone_storm" then label = "0.5초당 기준 피해" end
            return label .. " " .. string.format("%.1f", power * (1 + stats:GetSpellPowerPct() / 100))
        end
        return ""
    end

    method string DashKeyName()
        -- 질주·망령 도약 키 이름 (HudMain 질주 칸 툴팁과 같은 분기): 모바일 = 질주 단추 · 그 밖 = 스페이스
        return Environment:IsMobilePlatform() and "질주 단추" or "스페이스"
    end

    method string BlinkWhereText()
        -- 망령 도약이 노리는 자리 (BlinkAimPoint와 같은 규칙): PC 마우스 조작 = 커서 자리 · 키보드 조작·모바일 = 바라보는 방향
        ---@type ClickControl
        local cc = self.Entity:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then return "커서 자리로" end
        return "바라보는 방향으로"
    end

    method string UseHint(string id)
        -- 선투자는 허용하되 지금 발동하지 않는 조건을 선택 화면에서 알려 준다.
        if id == "step_gale" and self:GetLevel("wraith_dash") <= 0 then return "질주를 배워야 발동합니다" end
        if id == "shard_multi" and self:GetBoneShardCount(math.max(1, self:GetPowerLevel("bone_shard"))) <= 1 then return "티스가 2발 이상일 때 모이는 효과가 납니다" end
        local nodeForm = _UndeadSystem:NodeForm(id)
        if nodeForm.form ~= "" then return self:FormHint(id, nodeForm.kind, nodeForm.form) end
        local giant = self:GiantOfNode(id)
        if giant ~= "" then
            -- 46-5 「쓰는 곳」 (I03 UseHint 방식): 지금 무리로 서는 거인이 이 노드의 거인이 아니면 알린다 (§8 후보 1 「지금 무리로는 ○○ 거인」 · 승인 전)
            local plan = _UndeadSystem:GiantPlanFor(self.Entity)
            if plan ~= nil and plan.type ~= giant then return "지금 무리로는 " .. _GameData:GetGiant(plan.type).name end
        end
        return ""
    end

    method string GiantOfNode(string id)
        -- 46-5 거인 강화 노드 → 거인 종류 (아니면 "") · giant_basic_* = basic(48-0부터 줄 없음) · giant_shield_* · giant_gs_* = greatsword · giant_twin_* · giant_mage_*
        if string.sub(id, 1, 6) ~= "giant_" then return "" end
        if string.sub(id, 1, 12) == "giant_basic_" then return "basic" end
        if string.sub(id, 1, 13) == "giant_shield_" then return "shield" end
        if string.sub(id, 1, 9) == "giant_gs_" then return "greatsword" end
        if string.sub(id, 1, 11) == "giant_twin_" then return "twin" end
        if string.sub(id, 1, 11) == "giant_mage_" then return "mage" end
        return ""
    end

    method string FormHint(string id, string kind, string form)
        -- 해골 변이 노드 (11-02 랜덤 편성): 랭크는 세기와 그 변이 자리 수를 함께 올린다. 변이별 상한(UndeadSystem.SteadyRoster) = min(랭크, 서 있을 자리).
        -- 다음 랭크가 상한을 못 올리면 「세기만」, 변이 랭크 합이 정원보다 크면 소환마다 모자란 변이 중 무작위로 선다는 것을 알린다.
        -- 뼈 거인이 서 있으면(몸 고정 + 합쳐진 넷이 변이 자리를 씀) 그동안만 서지 못하는 경우를 따로 알린다
        local p = _UndeadSystem:RosterPreview(self.Entity, kind)
        if p.level <= 0 or p.max <= 0 then return "" end
        local def = _SkillData:Get(id)
        local level = self:GetLevel(id)
        local now = p.quota[form] or 0
        local nextQ = now
        if def ~= nil and level < def.maxLv then nextQ = self:PowerLevelAt(id, level + 1) end
        if nextQ <= 0 then return "" end   -- 캐릭터 레벨로 아직 못 쓰는 랭크는 Reason 줄이 설명한다
        local q = {}
        for _, f in ipairs(_UndeadSystem:FormOrder(kind)) do q[f] = p.quota[f] or 0 end
        q[form] = nextQ
        if p.giant and (_UndeadSystem:SteadyRoster(kind, p.max, q, p.list, p.extraReserved or 0)[form] or 0) <= 0 then   -- 46-0: p.list가 합쳐진 넷(~)을 담으므로 이름 없는 예약만 더한다
            return "뼈 거인이 서 있는 동안 0기 · 거인이 갈라진 뒤 섭니다"
        end
        if nextQ <= now then return "" end
        local before = _UndeadSystem:SteadyRoster(kind, p.max, p.quota, {}, 0)
        local after = _UndeadSystem:SteadyRoster(kind, p.max, q, {}, 0)
        if now > 0 and (after[form] or 0) <= (before[form] or 0) then
            return "다음 랭크는 세기만 오릅니다 (정원이 차 " .. tostring(before[form] or 0) .. "기 그대로)"
        end
        local sum = 0
        for _, f in ipairs(_UndeadSystem:FormOrder(kind)) do sum = sum + (q[f] or 0) end
        if sum > p.max then
            return "변이 합이 정원 " .. tostring(p.max) .. "기보다 많아 소환마다 섞여 섭니다"
        end
        return ""
    end

    method string RosterLine(string id)
        -- 편성 한 줄 (I03 · 글귀 승인 전): 해골 일으키기·변이·증원 노드 상세에 지금 편성과 다음 소환을 보인다.
        -- 계산은 UndeadSystem.RosterPreview (실제 일으키기의 MaxFor·PickForm·SlotPlan·TrimVictims와 같은 함수·같은 시드 · 기록을 만들지 않는다)
        -- 뼈 거인이 서 있으면 (INT1725-OBS-02: 거인 몸이 「일반 1」로, 합계가 「편성 6/5」로 보였다) 거인 몸은 「거인 본체」, 합쳐진 넷은 「거인에 N」으로 따로 세고
        --   정원은 분모 없이 「정원 N기」로 — 거인 몸은 정원 정리에서 빠지고(TrimVictims) 합쳐진 넷이 자리를 차지해 합계가 정원을 넘을 수 있다 (규칙·진단 수 p.have는 그대로)
        local kind = _UndeadSystem:NodeForm(id).kind
        if id == "raise_skeleton" or id == "skel_legion" then kind = "skeleton"
        elseif id == "raise_mage" or id == "mage_legion" then kind = "mage" end
        if kind == "" then return "" end
        local p = _UndeadSystem:RosterPreview(self.Entity, kind)
        if p.level <= 0 or p.max <= 0 then return "" end
        local parts = {}
        local forms = _UndeadSystem:ShownForms(kind)   -- 48 통합: 일반 → 진화한 방패 → 변이 (FormOrder만 읽으면 방패 수가 빠졌다)
        for _, f in ipairs(forms) do
            local n = p.units[f] or 0
            if n > 0 then table.insert(parts, (f == "" and "일반" or string.match(_UndeadSystem:FormName(kind, f), "^(%S+)")) .. " " .. tostring(n)) end
        end
        if p.bodies > 0 then table.insert(parts, "거인 본체 " .. tostring(p.bodies)) end
        if p.reserved > 0 then table.insert(parts, "거인에 " .. tostring(p.reserved)) end
        local line
        local head = "편성"
        if p.bodies > 0 or p.reserved > 0 then line = head .. ": " .. table.concat(parts, "·") .. " · 정원 " .. tostring(p.max) .. "기"
        else line = head .. " " .. tostring(p.have) .. "/" .. tostring(p.max) .. (#parts > 0 and (": " .. table.concat(parts, "·")) or "") end
        line = line .. " · 다음 소환: " .. _UndeadSystem:FormName(kind, p.nextForm)
        if #p.replaces == 1 then line = line .. "(가장 오래된 " .. _UndeadSystem:FormName(kind, p.replaces[1].form or "") .. " 교체)"
        elseif #p.replaces > 1 then line = line .. "(오래된 " .. tostring(#p.replaces) .. "기 교체)" end
        return line
    end

    @ExecSpace("Server")
    method void RequestGiantTip()
        -- 46-6 GuideCoach: 거인이 서는 순간 안내 띠를 한 번 보였다 (첫 3번만 — 저장)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or self.GiantTips >= 3 then return end
        self.GiantTips = self.GiantTips + 1
        if not Environment:IsPublishedPlay() then log("[VRF] giant tip shown n=" .. tostring(self.GiantTips)) end
    end

    @ExecSpace("Server")
    method void RequestShadowGuide()
        -- 10-31 GuideCoach: 그림자 소환을 배운 뒤 게임 안내 창을 한 번 열었다 (캐릭터마다 1회 — 저장)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or self.ShadowGuide then return end
        self.ShadowGuide = true
        if not Environment:IsPublishedPlay() then log("[VRF] shadow guide marked") end
    end

    @ExecSpace("Server")
    method void RequestRiteBanner(string kind)
        -- 46-1 「바라는 거인」 깃발 (공방 깃발 줄 · 포인트 없음): 아는 종류 또는 ""(안 고름)만. 같은 값이면 무시
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if kind ~= "" then
            local ok = false
            for _, k in ipairs(_UndeadSystem:GiantFallback()) do if k == kind then ok = true end end
            if not ok then return end
        end
        if self.RiteBanner == kind then return end
        self.RiteBanner = kind
        if not Environment:IsPublishedPlay() then log("[VRF] rite banner set kind=" .. (kind == "" and "none" or kind)) end
    end

    @ExecSpace("Server")
    method void RequestShardHold(boolean on)
        -- I04 설정: 모바일 골편 칸 누르고 있으면 반복 (기본 끔). 반복도 같은 시전 길(CastSlot → RequestCast → Cast)이라 서버 마나·재사용 검사는 그대로
        if senderUserId ~= self.Entity.PlayerComponent.UserId or self.ShardHold == on then return end
        self.ShardHold = on
        if not Environment:IsPublishedPlay() then log("[VRF] shard hold setting on=" .. tostring(on)) end
    end

    @ExecSpace("Server")
    method void RequestSetSlot(integer slot, string id)
        -- 1~4 = A S D F, 5 = 우클릭. 배운 액티브·저주만, id ""는 비우기
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if id ~= "" and not self:IsSlottable(id) then return end
        self:SetSlot(slot, id)
    end

    method number GetManaCost(string id, integer level)
        -- 실제 시전과 스킬 설명이 같은 비용 공식을 사용한다.
        local def = _SkillData:Get(id)
        if def == nil or def.kind == "passive" then return 0 end
        local cost = def.mana + math.floor(math.max(1, level) / 4)
        -- 질주는 늘 4
        if id == "wraith_dash" then cost = def.mana end
        -- 골편 투척: 부채꼴 발 수만큼 비싸다 (2발 +2 · 5발 +8)
        if id == "bone_shard" then cost = cost + _GameData.boneShardManaPerExtra * (self:GetBoneShardCount(math.max(1, level)) - 1 - self:ChoiceTier(1, "soul")) end   -- 선택 보상 발은 마나 그대로
        return cost
    end

    method boolean IsSlottable(string id)
        local def = _SkillData:Get(id)
        if def == nil or (def.kind ~= "active" and def.kind ~= "curse") then return false end
        return self:GetLevel(id) > 0
    end

    method table SlotList()
        local list = {}
        for s in string.gmatch(self.Slots .. ",", "([^,]*),") do table.insert(list, s) end
        while #list < 4 do table.insert(list, "") end
        return list
    end

    @ExecSpace("ServerOnly")
    method void SetSlot(integer slot, string id)
        if slot == 5 then
            self.RightSkill = id
            return
        end
        if slot < 1 or slot > 4 then return end
        local list = self:SlotList()
        -- 같은 스킬이 다른 칸에 있으면 옮긴다
        for i = 1, 4 do if id ~= "" and list[i] == id then list[i] = "" end end
        list[slot] = id
        self.Slots = table.concat(list, ",", 1, 4)
    end

    @ExecSpace("ServerOnly")
    method void AutoSlot(string id)
        -- 처음 배운 액티브·저주는 빈 칸(A S D F 순)에 자동으로 넣는다. 우클릭은 플레이어가 직접 지정할 때만
        -- (우클릭에 자동으로 들어가면 클릭 조작 중 마법이 저절로 나간다)
        if not self:IsSlottable(id) or id == "wraith_dash" then return end   -- 질주는 스페이스·모바일 질주 단추 (칸에 넣고 싶으면 직접)
        if self.RightSkill == id then return end
        local list = self:SlotList()
        for i = 1, 4 do if list[i] == id then return end end
        for i = 1, 4 do
            if list[i] == "" then
                self:SetSlot(i, id)
                return
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void SanitizeSlots()
        -- 옛 저장·기본값에 남은 "안 배운 스킬" 칸을 비운다
        local list = self:SlotList()
        local seen = {}
        for i = 1, 4 do
            -- 안 배운 스킬, 같은 스킬이 두 칸에 든 경우(옛 저장) 비운다
            if list[i] ~= "" and (not self:IsSlottable(list[i]) or seen[list[i]]) then list[i] = "" end
            if list[i] ~= "" then seen[list[i]] = true end
        end
        self.Slots = table.concat(list, ",", 1, 4)
        if self.RightSkill ~= "" and not self:IsSlottable(self.RightSkill) then self.RightSkill = "" end
    end

    -- ───────── 시전 (서버) ─────────

    @ExecSpace("Server")
    method void RequestCast(string id, Vector2 target)
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or pc.Hp <= 0 then return end
        if self:Cast(id, target) then
            -- 시전은 준비 중인 평타를 끊는다 (시전 순간 평타 궤적이 같이 나와 스킬 이펙트처럼 보였다, 10-11 QA)
            ---@type PlayerAttack
            local attack = self.Entity:GetComponent("script.PlayerAttack")
            if attack ~= nil then attack:InterruptSwing(0.35) end
        end
    end

    @ExecSpace("ServerOnly")
    method boolean Cast(string id, Vector2 target)
        -- 습득·구현·비용 확인 → 효과 성공 → 마나·쿨다운 확정
        if not _Util:IsAlive(self.Entity) then return false end
        local def = _SkillData:Get(id)
        local lv = self:GetPowerLevel(id)
        if def == nil or lv <= 0 then return false end
        local userId = self.Entity.PlayerComponent.UserId
        if _GameConst:IsTown(self.Entity.CurrentMap) then
            _Util:Warn("마을에서는 스킬을 쓸 수 없습니다", userId)
            return false
        end
        if def.kind == "passive" then return false end
        if not def.impl then
            _Util:Warn(def.name .. ": 준비 중인 스킬", userId)
            return false
        end
        -- 뼈 의식: 단계 없이 들어온 시전(예전 저장 칸·직접 호출)은 1기(해골 폭탄)로
        if id == "bone_rite" then return self:CastRite(1, target) end
        -- 11-02 본 골렘: 거인 소환 길 (충전 2칸 · 참여 다섯 · 랭크 배율)
        if id == "bone_giant" then return self:CastGiant(target) end
        local now = _UtilLogic.ElapsedSeconds
        if now < (self.ReadyAt[id] or 0) then return false end
        if id == "wraith_dash" and self:RefillDash() < 1 then return false end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return false end
        local cost = self:GetManaCost(id, lv)
        if self.PendingCasts[id] or stats.Mana - self.PendingMana < cost then
            if not self.PendingCasts[id] then _Util:Warn("마나 부족", userId) end
            return false
        end
        local me = _Util:Pos2(self.Entity)
        if target.x ~= target.x or target.y ~= target.y or math.abs(target.x) > 10000 or math.abs(target.y) > 10000 then return false end
        local selfCast = id == "shadow_summon" or id == "rally" or id == "elite_promote" or id == "bone_storm" or id == "death_wave" or id == "bone_armor" or id == "bone_offering"
        local move = id == "wraith_dash"
        local lock = nil
        if id == "bone_shard" or id == "bone_spikes" then
            -- 11-04 뼈 쐐기도 티스와 같은 조준: 고른 적 → 커서 근처(1.2) 적 → 없으면 커서 자리(6칸 넘으면 그 방향 6칸)
            -- 10-10 2차 QA: 커서가 몬스터 위가 아니면 오른쪽 몬스터를 두고 왼쪽으로 날아갔다.
            -- 플레이어가 고른 대상 → 없으면 커서 근처(1.2) 몬스터 순으로 고정해, 뼛조각이 그 몬스터까지 날아가 맞는다.
            -- (조준 쐐기 PlayerAttack.UpdateAimIndicator와 같은 우선순위)
            ---@type PlayerAttack
            local attack = self.Entity:GetComponent("script.PlayerAttack")
            if attack ~= nil and attack:IsLiveMonster(attack.SelectedTarget) and _Util:Distance(self.Entity, attack.SelectedTarget) <= 7.5 then
                lock = attack.SelectedTarget
            end
            local near = lock == nil and _Util:NearestMonster(self.Entity.CurrentMap, target, 1.2) or nil
            if near ~= nil and (_Util:Pos2(near.Entity) - me):Magnitude() <= 7.5 then lock = near.Entity end
            if lock ~= nil then target = _Util:Pos2(lock) end
        end
        local ray = target - me
        if selfCast then target = me
        elseif move then
            -- 질주(도약): 내 클라이언트가 이미 움직였고 target은 도착점이다. 서버 위치는 조금 늦으니 1.5칸 여유
            if ray:Magnitude() > self:GetEffectPower(id, lv) + 1.5 then return false end
            if self:Node("dash_blink") > 0 then
                -- 11-04 망령 도약: 서버도 같은 착지 규칙으로 확인 (맵 밖 · 걸어서 이어지지 않는 칸이면 거절)
                local check = self:BlinkLanding(self.Entity.CurrentMap, me, target, self:GetEffectPower(id, lv) + 1.5)
                if check.reason == "outside" or (check.pos - target):Magnitude() > 0.6 then
                    log(string.format("[VRF] blink rejected reason=%s want=%.2f,%.2f got=%.2f,%.2f", check.reason, target.x, target.y, check.pos.x, check.pos.y))
                    return false
                end
            end
        elseif lock ~= nil then -- 고정 대상은 사거리 7.5까지 그대로 겨눈다
        elseif (id == "bone_shard" or id == "soul_torrent" or id == "hex_flame" or id == "frost_soul") and ray:Magnitude() > 6 then target = me + ray:Normalize() * 6   -- 방향만 쓰는 투사체
        elseif self:IsGroundSkill(id) or id == "bone_spikes" then target = self:ClampGroundPoint(me, target)   -- 44-3 A: 땅 찍기는 6칸 넘으면 그 방향 6칸에 놓는다 (범위 원과 같은 자리)
        elseif ray:Magnitude() > 6 then _Util:Warn("시전할 곳이 너무 멉니다", userId) return false end
        local kind = ""
        if id == "raise_skeleton" then kind = "skeleton"
        elseif id == "raise_mage" then kind = "mage" end
        if kind ~= "" or id == "bone_shard" then
            local epoch = self.CastEpoch
            self.PendingCasts[id] = true
            self.PendingMana = self.PendingMana + cost
            local complete = function(success)
                if epoch ~= self.CastEpoch or not self.PendingCasts[id] then return end
                self.PendingCasts[id] = nil
                self.PendingMana = math.max(0, self.PendingMana - cost)
                if not success or not _Util:IsAlive(self.Entity) then return end
                if not stats:SpendMana(cost) then return end
                _GameEvents:Emit("SkillCast", { player = self.Entity, skill = id, rank = lv, mana = cost })
                self:SetCooldown(id, def.cooldown * stats:GetCastCooldownMult())
                self:PresentCast(id, target - me, userId)
                if not Environment:IsPublishedPlay() then log("[VRF] cast committed " .. id .. " mana=" .. tostring(cost)) end   -- 시전·추출·소환마다 찍히므로 출시 서버에서는 끈다
            end
            local canCommit = function()
                return epoch == self.CastEpoch and self.PendingCasts[id] == true and _Util:IsAlive(self.Entity) and stats.Mana >= cost
            end
            local accepted = false
            if kind ~= "" then
                accepted = _UndeadSystem:Raise(self.Entity, kind, lv, target, complete, canCommit)
            else
                local effects = self.Entity:GetComponent("script.SkillEffects")
                if effects ~= nil then accepted = effects:BoneShardVolley(me, target, self:GetEffectPower(id, lv) * (1 + stats:GetSpellPowerPct() / 100), self:GetBoneShardCount(lv), complete, canCommit, lock) end
            end
            if not accepted then complete(false) end
            return accepted
        end
        ---@type SkillEffects
        local effects = self.Entity:GetComponent("script.SkillEffects")
        if effects == nil or not effects:Apply(id, lv, me, target, 1 + stats:GetSpellPowerPct() / 100) then return false end
        local paid = stats:SpendMana(cost)
        if paid then _GameEvents:Emit("SkillCast", { player = self.Entity, skill = id, rank = lv, mana = cost }) end
        if id == "wraith_dash" then self:UseDashCharge(lv)
        else self:SetCooldown(id, self:SkillCooldown(id, lv) * stats:GetCastCooldownMult()) end
        self:PresentCast(id, target - me, userId)
        -- 44-2 궁극기 연출 (결정 2): 죽음의 파동 · 뼈 폭풍 · 정예 승격 (뼈 의식 5기는 CastRite) — 시전자 화면만
        if id == "death_wave" or id == "bone_storm" or id == "elite_promote" then effects:ShowUltimate(id, userId) end
        return true
    end

    method number SkillCooldown(string id, integer level)
        -- 재사용 시간 (시전 속도 적용 전)
        if id == "wraith_dash" then return self:DashCooldown(level) end
        local def = _SkillData:Get(id)
        return def ~= nil and def.cooldown or 0
    end

    method table BlinkLanding(Entity map, Vector2 me, Vector2 aim, number range)
        -- 11-04 망령 도약 착지 (사용자): 조준점까지 벽·장식 충돌을 무시하고 순간이동(최대 range칸).
        --   조준점 칸이 맵 밖(칸 없음)이면 거부(reason outside). 조준점이 벽·막힌 칸이면 조준 방향 선 위에서 조준점에 가장 가까운 걷는 칸(뒤쪽으로 탐색).
        --   그 칸은 지금 자리에서 걸어서 이어져야 한다(봉인 문·잠긴 문·막힌 둥지 너머 = 이어지지 않음 → 건너뜀 skipped · 그래서 문 앞까지만). 없으면 질주처럼 벽 앞(reason wall)
        --   { pos, reason = aim/nearest/wall/outside/open, over = 벽을 넘었나, skipped = 건너뛴 이어지지 않는 칸 수 } — 클라이언트(CastMove)·서버(Cast) 같은 식
        local ray = aim - me
        if ray:Magnitude() > range then aim = me + ray:Normalize() * range end
        local m = _Util:TerrainMemo(map)
        if m == nil then return { pos = aim, reason = "open", over = false, skipped = 0 } end
        local cx = function(q) return math.floor((q.x - m.ox) / m.gx + 0.5) end
        local cy = function(q) return math.floor((q.y - m.oy) / m.gy + 0.5) end
        if m.tiles:GetTile(Vector2Int(cx(aim), cy(aim))) == nil then return { pos = me, reason = "outside", over = false, skipped = 0 } end
        local margin = 0.25
        local free = function(q)
            return not _Util:CellBlocked(m, q) and not _Util:CellBlocked(m, q + Vector2(margin, 0)) and not _Util:CellBlocked(m, q - Vector2(margin, 0))
                and not _Util:CellBlocked(m, q + Vector2(0, margin)) and not _Util:CellBlocked(m, q - Vector2(0, margin))
        end
        -- 지금 자리에서 걸어서 이어지는 칸 (상하좌우 · 사방 range + 24칸 상자 · 최대 9000칸)
        local sx, sy = cx(me), cy(me)
        local lim = math.ceil(range / math.min(m.gx, m.gy)) + 24
        local seen = {}
        seen[sx * 100000 + sy] = true
        local queue = { { sx, sy } }
        local head = 1
        local dirs = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
        while head <= #queue and #queue < 9000 do
            local c = queue[head]
            head = head + 1
            for _, d in ipairs(dirs) do
                local nx, ny = c[1] + d[1], c[2] + d[2]
                local key = nx * 100000 + ny
                if not seen[key] and math.abs(nx - sx) <= lim and math.abs(ny - sy) <= lim then
                    if not _Util:CellBlocked(m, Vector2(m.ox + nx * m.gx, m.oy + ny * m.gy)) then
                        seen[key] = true
                        table.insert(queue, { nx, ny })
                    end
                end
            end
        end
        local offset = aim - me
        local count = math.max(1, math.ceil(offset:Magnitude() / 0.2))
        local skipped = 0
        for i = count, 1, -1 do
            local q = me + offset * (i / count)
            if free(q) then
                if seen[cx(q) * 100000 + cy(q)] then
                    return { pos = q, reason = i == count and "aim" or "nearest", over = not _Util:HasLineOfSight(map, me, q), skipped = skipped }
                end
                skipped = skipped + 1
            end
        end
        return { pos = _Util:ReachablePoint(map, me, aim, margin), reason = "wall", over = false, skipped = skipped }
    end

    method number DashCooldown(integer level)
        -- 질주 한 번이 다시 차는 시간 (11-04 사용자): 4.0 − 0.25 × 랭크 · 최저 1.5초 (랭크 1 = 3.75초 … 랭크 10 = 1.5초 · 「재빠른 숨」 삭제)
        return math.max(1.5, 4 - 0.25 * math.max(1, level))
    end

    -- ───────── 뼈 의식 (기획서 43 §3-1 · 10-29 결정 1A·2·3) ─────────
    -- 단추 하나: 짧게 = 1기 해골 폭탄, riteHold2(0.5초) 이상 = 해골 3기 회오리 돌진 (11-03 C안 · 62 §9: 3기 뼈 화살 단계 삭제 · 거인은 본 골렘 CastGiant).
    -- 해골·쿨다운·마나가 모자라면 할 수 있는 가장 높은 단계로 내려간다 (서버가 최종 결정). PC 키 누름·모바일 단추 길게 모두 같은 길

    method integer RiteStageForHold(number held)
        -- 누른 시간 → 바라는 단계 (1·2). 11-03 C안: 2단계(회오리)가 상한 — 더 눌러도 2단계
        if held >= _GameData.riteHold2 then return 2 end
        return 1
    end

    method string RiteCdKey(integer stage)
        -- 단계별 재사용 덮개 키 (1기는 스킬 칸 덮개 bone_rite 그대로 · 모든 단계가 bone_rite 1초도 함께 건다)
        if stage == 2 then return "rite_whirl" end
        return "bone_rite"
    end

    method number RiteCooldown(integer stage)
        -- 단계별 재사용(초, 시전 속도 적용 전)
        if stage == 2 then return _GameData.riteWhirlCd end
        local def = _SkillData:Get("bone_rite")
        return def ~= nil and def.cooldown or 1
    end

    method number RiteManaCost(integer stage, integer level)
        -- 단계별 마나 (+ 랭크 ÷ 4 — 다른 스킬과 같은 규칙). 1기는 표의 마나
        local base = 0
        if stage == 2 then base = _GameData.riteWhirlMana
        else
            local def = _SkillData:Get("bone_rite")
            base = def ~= nil and def.mana or 10
        end
        return base + math.floor(math.max(1, level) / 4)
    end

    method number RiteRankMul(integer level)
        -- 2단계(회오리) 피해의 랭크 배율 (1 + riteRankPct% × (랭크 − 1) · 62 §7-1 7%). 1기는 해골 폭탄 공식 그대로 · 거인은 GiantRankMul
        return 1 + _GameData.riteRankPct / 100 * (math.max(1, level) - 1)
    end

    method number RiteWhirlRadius()
        -- 해골 회오리 판정 반경 = riteWhirlRadius(0.9) × (1 + 15% × 「초거대」 랭크) (62 §9-3)
        return _GameData.riteWhirlRadius * (1 + 0.15 * self:Node("bomb_wide"))
    end

    method number RiteWhirlReach(integer reachRank)
        -- 해골 회오리 진행 거리(칸) = 속도 × 수명(5칸) + 「뼈의 길」 랭크 × riteWhirlReachPerRank(1.5)
        return _GameData.riteWhirlSpeed * _GameData.riteWhirlSeconds + _GameData.riteWhirlReachPerRank * math.max(0, reachRank)
    end

    method number RiteWhirlLife(integer reachRank)
        -- 해골 회오리 수명(초) = 거리 ÷ 속도 (기본 2초 · 「뼈의 길」 랭크당 +0.6초)
        return self:RiteWhirlReach(reachRank) / math.max(0.1, _GameData.riteWhirlSpeed)
    end

    method integer RiteWhirlTicks(integer reachRank)
        -- 한 적 기준 최대 타수 = 수명 ÷ 타격 간격 (기본 8 · 뼈의 길 1·2 = 10·12)
        return math.floor(self:RiteWhirlLife(reachRank) / math.max(0.05, _GameData.riteWhirlTick) + 1e-6)
    end

    method number EnfeebleRadius()
        -- 위큰 기본 범위(칸) = 1.5 × (1 + 20% × 「약화의 오라」 랭크) — 장비·「저주 범위」는 Curse·GroundRadius가 그 위에 곱한다 (11-03 Fable 결정 7)
        return 1.5 * (1 + 0.2 * self:Node("enfeeble_deep"))
    end

    method number EnfeebleCap(number pct)
        -- 위큰 공격력 감소 상한 (11-03 Fable 결정 5): 랭크 + 「저주의 무게」 + 장비 저주 효과를 곱한 값이 enfeebleMaxPct(75%)를 넘지 않게
        return math.min(_GameData.enfeebleMaxPct, pct)
    end

    method integer ArmorReformPct(integer rank)
        -- 강화 「급속 골화」(옛 두꺼운 뼈 자리 · 62 §10): 다 깨진 본 아머를 2초 뒤 최대치의 15%/랭크로 다시 두른다
        return 15 * math.max(0, rank)
    end

    method integer ShardBounceRange(integer rank)
        -- 강화 「유도탄」(옛 뼈 가시 자리 · 62 §10): 튕김이 닿는 거리 4 + 랭크칸
        return 4 + math.max(0, rank)
    end

    method integer RiteSkeletons()
        -- 바칠 수 있는 해골 전사 수: 서버 = UndeadSystem 목록(돌진·거인 제외), 클라이언트 = 동기화된 소환수 배지 수 (예측용)
        if self:IsServer() then return #_UndeadSystem:LiveUnits(self.Entity, "skeleton") end
        ---@type ShadowCommander
        local cmd = self.Entity:GetComponent("script.ShadowCommander")
        if cmd == nil then return 0 end
        return tonumber(string.match(cmd.MinionCounts, "^(%d+)")) or 0
    end

    method boolean RiteReady(string key)
        -- 재사용이 끝났나 (서버 = ReadyAt, 클라이언트 = 동기화된 덮개 요약)
        if self:IsServer() then return _UtilLogic.ElapsedSeconds >= (self.ReadyAt[key] or 0) end
        return self:CooldownLeft(key) <= 0.05
    end

    method integer RiteUnits5()
        -- 5기 재료 수 (46-1): 바칠 수 있는 해골 전사 + 마법사 (거인 몸·합쳐짐·아직 못 바침 제외) — 서버·클라이언트 같은 GiantPool (서버 RosterView · 클라이언트 UndeadRoster)
        if self:IsServer() then return _UndeadSystem:GiantPoolCount(_UndeadSystem:RosterView(self.Entity)) end
        return _UndeadSystem:GiantPoolCount(_UndeadSystem:RosterOf(self.Entity).list)
    end

    method integer GiantCount()
        -- 48 §3 (거인 2마리): 지금 서 있는 내 거인 수 — 갈래 A 공개 API(UndeadSystem.GiantCount · 서버 Giants 목록 / 클라이언트 GiantKind 쉼표 수)로 연결 (48 통합)
        return _UndeadSystem:GiantCount(self.Entity)
    end

    method boolean GiantCapReached()
        -- 48 §3-1 「5기 건너뜀」: 거인이 상한(config riteGiantMax 2)만큼 서 있으면 5기를 건너뛰고 3기로 내린다 (한 마리만 서 있으면 둘째를 세울 수 있다)
        return _UndeadSystem:GiantCapReached(self.Entity)
    end

    method boolean GiantStanding()
        -- 거인이 하나라도 서 있나 (46-1 · §2-5 뜻 그대로 — 「상한 도달」은 GiantCapReached)
        return _UndeadSystem:GiantStandingAny(self.Entity)
    end

    method integer RiteBestStage(integer want, number mana)
        -- 바라는 단계 이하에서 해골 수·재사용·마나가 되는 가장 높은 단계 (0 = 어느 단계도 안 됨). mana < 0 이면 마나는 보지 않는다
        -- 11-03 C안: 2단계(해골 riteWhirlSkel 3기 회오리)가 상한 (5기 재료·거인 상한 판단은 본 골렘 GiantReason)
        local skel = self:RiteSkeletons()
        local lv = self:GetPowerLevel("bone_rite")
        if not self:RiteReady("bone_rite") then return 0 end
        for _, s in ipairs({ 2, 1 }) do
            local need = s == 2 and math.floor(_GameData.riteWhirlSkel) or 1
            if s <= want and skel >= need and (s == 1 or self:RiteReady(self:RiteCdKey(s)))
                and (mana < 0 or mana >= self:RiteManaCost(s, lv)) then
                return s
            end
        end
        return 0
    end

    @ExecSpace("Server")
    method void RequestRite(integer want, Vector2 target)
        -- 클라이언트가 누른 시간으로 고른 단계(want)를 보낸다. 실제 단계는 서버가 해골 수·재사용·마나로 다시 정한다
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or pc.Hp <= 0 then return end
        if self:CastRite(want, target) then
            ---@type PlayerAttack
            local attack = self.Entity:GetComponent("script.PlayerAttack")
            if attack ~= nil then attack:InterruptSwing(0.35) end
        end
    end

    @ExecSpace("ServerOnly")
    method boolean CastRite(integer want, Vector2 target)
        -- 습득·마을·좌표 확인 → 가능한 가장 높은 단계 → 효과 성공 → 마나·재사용 확정 (실패면 아무것도 쓰지 않는다)
        if not _Util:IsAlive(self.Entity) then return false end
        local def = _SkillData:Get("bone_rite")
        local lv = self:GetPowerLevel("bone_rite")
        if def == nil or lv <= 0 then return false end
        local userId = self.Entity.PlayerComponent.UserId
        if _GameConst:IsTown(self.Entity.CurrentMap) then
            _Util:Warn("마을에서는 스킬을 쓸 수 없습니다", userId)
            return false
        end
        if target.x ~= target.x or target.y ~= target.y or math.abs(target.x) > 10000 or math.abs(target.y) > 10000 then return false end
        if want >= 2 then want = 2 else want = 1 end   -- 11-03 C안: 2단계 상한 (옛 클라이언트 3·5 요청도 2로 내린다)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return false end
        local skel = self:RiteSkeletons()
        local stage = self:RiteBestStage(want, stats.Mana - self.PendingMana)
        if stage == 0 then
            if not self:RiteReady("bone_rite") then return false end
            if skel <= 0 then _Util:Warn("바칠 해골 전사가 없습니다", userId)
            else _Util:Warn("마나 부족", userId) end
            log(string.format("[VRF] rite stage=0 skel=%d want=%d reason=%s", skel, want, skel <= 0 and "no_skeleton" or "mana"))
            return false
        end
        local me = _Util:Pos2(self.Entity)
        local ray = target - me
        if ray:Magnitude() > 6 then target = me + ray:Normalize() * 6 end   -- 조준점은 6칸까지 (폭탄 돌진·회오리 방향)
        local lock = nil
        if stage == 2 then
            -- 회오리 표적 (62 §9-2 · 11-03 Fable 결정 2 W2 · 11-03 후속 수정): 고른 적(7.5칸 안) → 없으면 조준·바라보는 방향과 무관하게 플레이어 반경 6칸 안 가장 가까운 살아 있는 적
            --   → 그것도 없을 때만 조준(바라보는) 방향 직진 (예전 조준 방향 ±30° 부채꼴은 뒤·옆 적을 놓쳐 target=false로 허공에 갔다)
            ---@type PlayerAttack
            local attack = self.Entity:GetComponent("script.PlayerAttack")
            if attack ~= nil and attack:IsLiveMonster(attack.SelectedTarget) and _Util:Distance(self.Entity, attack.SelectedTarget) <= 7.5 then lock = attack.SelectedTarget end
            if lock == nil then
                local m = _Util:NearestMonster(self.Entity.CurrentMap, me, 6)
                if m ~= nil then lock = m.Entity end
            end
        end
        local ok = false
        if stage == 1 then
            local power = self:GetEffectPower("bone_rite", lv)
            ok = _UndeadSystem:SkeletonBomb(self.Entity, target, power, 1.6 * (1 + 0.15 * self:Node("bomb_wide")), 1 + self:Node("rite_fork"))
        else
            ok = _UndeadSystem:BoneRite(self.Entity, stage, target, self:RiteRankMul(lv), lock)
        end
        if not ok then
            log(string.format("[VRF] rite stage=%d skel=%d want=%d failed", stage, skel, want))
            return false
        end
        local cost = self:RiteManaCost(stage, lv)
        local paid = stats:SpendMana(cost)
        if paid then _GameEvents:Emit("SkillCast", { player = self.Entity, skill = "bone_rite", rank = lv, mana = cost }) end
        local castMul = stats:GetCastCooldownMult()
        self:SetCooldown("bone_rite", (def.cooldown or 1) * castMul)
        if stage > 1 then self:SetCooldown(self:RiteCdKey(stage), self:RiteCooldown(stage) * castMul) end
        self:PresentCast("bone_rite", target - me, userId)
        log(string.format("[VRF] rite stage=%d skel=%d want=%d max=2 lv=%d mana=%d lock=%s", stage, skel, want, lv, math.floor(cost), tostring(lock ~= nil)))
        return true
    end

    -- ───────── 본 골렘 (11-02 사용자 결정 B · 기획서 52 §2-2 안 ① — 거인을 뼈 의식에서 떼어 낸 독립 액티브) ─────────
    -- 칸(A S D F·우클릭 · 모바일 4칸·큰 단추)에 넣고 누르면 바로 거인. 참여 다섯·종류 투표·깃발·충전 2칸·상한 2기는 예전 뼈 의식 5기 그대로 (UndeadSystem.BoneRite 5 → StartGiant)

    method number GiantRankMul(integer level)
        -- 거인 공격·생명 배율 = 1 + riteGiantRankPct% × (랭크 − 1) (46 §10-4에서 빼 둔 「랭크당 +3%」 · 1랭크 = 예전 거인 그대로)
        return 1 + self:GetEffectPower("bone_giant", math.max(1, level)) / 100
    end

    method string GiantReason(number mana)
        -- 본 골렘을 지금 세울 수 있나 ("" = 됨, 아니면 까닭). mana < 0 이면 마나는 보지 않는다 — 서버 CastGiant 앞 판단 · 클라이언트 예측이 같은 순서
        --   재료 = 바칠 수 있는 해골 전사 + 마법사 (RiteUnits5 · 46-1) · 거인이 상한(riteGiantMax 2)만큼 서 있으면 못 세운다 (GiantCapReached · 48 §3-1)
        local lv = self:GetPowerLevel("bone_giant")
        if lv <= 0 then return "배우지 않음" end
        if self:GiantCapReached() then return "거인 상한" end
        if not self:RiteReady("bone_giant") then return "충전 대기" end
        local short = 5 - self:RiteUnits5()
        if short > 0 then return "해골 " .. tostring(short) .. "기 부족" end
        if mana >= 0 and mana < self:GetManaCost("bone_giant", lv) then return "마나 부족" end
        return ""
    end

    @ExecSpace("ServerOnly")
    method boolean CastGiant(Vector2 target)
        -- 습득·마을·충전·마나 확인 → 거인 (StartGiant가 참여 다섯·상한·충전 칸을 마지막으로 본다) → 마나·덮개 확정 (실패면 아무것도 쓰지 않는다)
        if not _Util:IsAlive(self.Entity) then return false end
        local def = _SkillData:Get("bone_giant")
        local lv = self:GetPowerLevel("bone_giant")
        if def == nil or lv <= 0 then return false end
        local userId = self.Entity.PlayerComponent.UserId
        if _GameConst:IsTown(self.Entity.CurrentMap) then
            _Util:Warn("마을에서는 스킬을 쓸 수 없습니다", userId)
            return false
        end
        if target.x ~= target.x or target.y ~= target.y or math.abs(target.x) > 10000 or math.abs(target.y) > 10000 then return false end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return false end
        if not self:RiteReady("bone_giant") then return false end
        local cost = self:GetManaCost("bone_giant", lv)
        if stats.Mana - self.PendingMana < cost then
            _Util:Warn("마나 부족", userId)
            log(string.format("[VRF] cast bone_giant lv=%d reason=mana", lv))
            return false
        end
        local mul = self:GiantRankMul(lv)
        local me = _Util:Pos2(self.Entity)
        if not _UndeadSystem:BoneRite(self.Entity, 5, target, mul, nil) then
            log(string.format("[VRF] cast bone_giant lv=%d failed reason=%s units=%d", lv, self:GiantReason(-1), self:RiteUnits5()))
            return false
        end
        local paid = stats:SpendMana(cost)
        if paid then _GameEvents:Emit("SkillCast", { player = self.Entity, skill = "bone_giant", rank = lv, mana = cost }) end
        -- 48 Q2 C2: 충전 2칸 — StartGiant가 이미 한 칸 썼다. 칸이 남으면 덮개 0, 다 쓰면 다음 칸까지 (UndeadSystem.GiantChargeCover · ServerOnly)
        local cover = _UndeadSystem:GiantChargeCover(self.Entity)
        self:SetCooldown("bone_giant", cover)
        self:PresentCast("bone_giant", target - me, userId)
        -- 44-2 궁극기 연출 「뼈 거인」 (시전자 화면만 · 예전 뼈 의식 5기와 같은 연출 키)
        ---@type SkillEffects
        local fx = self.Entity:GetComponent("script.SkillEffects")
        if fx ~= nil then fx:ShowUltimate("rite_giant", userId) end
        log(string.format("[VRF] cast bone_giant lv=%d mul=%.2f mana=%d cover=%.1f giants=%d", lv, mul, math.floor(cost), cover, self:GiantCount()))
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean BeginRiteHold(integer slot)
        -- PC 키를 누른 순간 · 모바일 단추에 손가락이 닿은 순간: 충전 시작 (머리 위 고리는 HudMain.RenderRite가 그린다)
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return false end
        if self:GetSlotSkill(slot) ~= "bone_rite" or self:GetPowerLevel("bone_rite") <= 0 then return false end
        if self.RiteHoldAt >= 0 then return true end   -- 키 반복 입력은 무시
        if _GameConst:IsTown(self.Entity.CurrentMap) then
            _HudMain:ShowWarn("마을에서는 스킬을 쓸 수 없습니다")
            return false
        end
        if self:CooldownLeft("bone_rite") > 0.05 then return false end
        self.RiteHoldAt = _UtilLogic.ElapsedSeconds
        self.RiteHoldSlot = slot
        if not Environment:IsPublishedPlay() then log("[VRF] rite hold start slot=" .. tostring(slot)) end
        return true
    end

    @ExecSpace("ClientOnly")
    method void ReleaseRite()
        -- 손을 뗀 순간: 누른 시간 → 바라는 단계를 서버에 보낸다 (해골이 모자라면 서버가 한 단계씩 내려 쏜다)
        if self.RiteHoldAt < 0 then return end
        local held = _UtilLogic.ElapsedSeconds - self.RiteHoldAt
        self.RiteHoldAt = -1
        self.RiteHoldSlot = 0
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        local want = self:RiteStageForHold(held)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local predicted = self:RiteBestStage(want, stats ~= nil and stats.Mana or -1)
        self:RequestRite(want, self:GetAimPoint("bone_rite"))
        ---@type ClickControl
        local click = self.Entity:GetComponent("script.ClickControl")
        if click ~= nil then click.AttackTimer = math.max(click.AttackTimer, 0.6) end
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] rite release held=%.2f want=%d max=2 predicted=%d skel=%d", held, want, predicted, self:RiteSkeletons())) end
    end

    @ExecSpace("ClientOnly")
    method void CancelRiteHold()
        -- 창이 열리거나 죽거나 맵을 옮기면 모으던 의식을 버린다 (아무것도 쓰지 않는다)
        if self.RiteHoldAt < 0 then return end
        self.RiteHoldAt = -1
        self.RiteHoldSlot = 0
        if not Environment:IsPublishedPlay() then log("[VRF] rite hold cancel") end
    end

    @ExecSpace("ServerOnly")
    method integer RefillDash()
        -- 남은 질주 횟수를 시간에 맞춰 채운다 (최대 1 + 「여분 숨」)
        local max = 1 + self:Node("dash_charge")
        local now = _UtilLogic.ElapsedSeconds
        local cd = self:DashCooldown(self:GetPowerLevel("wraith_dash"))
        -- 다시 차는 중이 아니면 가득 (처음 · 「여분 숨」을 새로 찍었을 때도)
        if self.DashRechargeAt <= 0 or self.DashCharges > max then self.DashCharges = max end
        local before = self.DashCharges
        while self.DashCharges < max and self.DashRechargeAt > 0 and now >= self.DashRechargeAt do
            self.DashCharges = self.DashCharges + 1
            self.DashRechargeAt = self.DashCharges < max and (self.DashRechargeAt + cd) or 0
        end
        if self.DashCharges >= max then self.DashRechargeAt = 0 end   -- 가득이면 지난 충전 시각을 남기지 않는다 (다음 사용 때 바로 한 칸이 공짜로 차지 않게)
        if self.DashShown ~= self.DashCharges then self.DashShown = self.DashCharges end
        -- 11-05 사용자 「여분 숨을 찍었는데 1/2 이상 안 찬다」: 한 칸이 찬 뒤 다음 칸 타이머를 다시 걸지 않아, 연달아 쓰면 두 번째 칸부터는
        --   다음 시전(RefillDash)이 올 때까지 멈춰 있었다 → 남은 칸이 있으면 언제나 다음 칸 시각에 타이머를 다시 건다
        if self.DashCharges < max and self.DashRechargeAt > 0 then self:ScheduleDashRefill(now) end
        if self.DashCharges ~= before and not Environment:IsPublishedPlay() then log(string.format("[VRF] dash charges=%d max=%d rechargeAt=%.2f", self.DashCharges, max, self.DashRechargeAt > 0 and (self.DashRechargeAt - now) or -1)) end
        return self.DashCharges
    end

    @ExecSpace("ServerOnly")
    method void ScheduleDashRefill(number now)
        -- 다음 질주 한 칸이 차는 시각(DashRechargeAt)에 RefillDash 한 번 (앞 타이머는 지운다 — 같은 칸을 두 번 채우지 않게)
        if self.DashRefillTimer ~= 0 then _TimerService:ClearTimer(self.DashRefillTimer) end
        self.DashRefillTimer = _TimerService:SetTimerOnce(function()
            self.DashRefillTimer = 0
            if isvalid(self.Entity) then self:RefillDash() end
        end, math.max(0.05, self.DashRechargeAt - now + 0.05))
    end

    @ExecSpace("ServerOnly")
    method void UseDashCharge(integer level)
        -- 한 번 쓰고, 다 쓰면 다음 한 번이 찰 때까지 쿨다운 덮개를 건다
        local now = _UtilLogic.ElapsedSeconds
        self.DashCharges = math.max(0, self.DashCharges - 1)
        if self.DashRechargeAt <= 0 then self.DashRechargeAt = now + self:DashCooldown(level) end
        self.DashShown = self.DashCharges
        if self.DashCharges <= 0 then self:SetCooldown("wraith_dash", math.max(0.1, self.DashRechargeAt - now)) end
        local left = self.DashRechargeAt - now
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] dash charge used lv=%d cd=%.2f left=%.2f charges=%d", level, self:DashCooldown(level), left, self.DashCharges)) end
        self:ScheduleDashRefill(now)
    end

    @ExecSpace("ClientOnly")
    method void CastMove(string id)
        -- 질주(스페이스·모바일 질주 단추, 강화 「망령 도약」이면 순간이동): 내 화면에서 바로 움직이고 서버는 마나·쿨다운·무적만 맡는다.
        -- 플레이어 위치는 클라이언트가 쥐고 있어 서버가 옮길 수 없다 (메이커 실측 10-10). 벽은 ReachablePoint로 막는다
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() or not _Util:IsAlive(self.Entity) then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) or _GameConst:IsTown(map) then return end
        -- 11-05 포털: 포털·심도 문 반응 구역 안의 Space·질주 단추는 진입 몫 (NpcWindow.FindGate — 안내 버튼과 같은 판정). 충전·마나는 쓰지 않는다
        local gate = _NpcWindow:FindGate(self.Entity)
        if gate ~= nil then
            if not Environment:IsPublishedPlay() then
                ---@type PlayerStats
                local gs = self.Entity:GetComponent("script.PlayerStats")
                log(string.format("[VRF] dash held by gate=%s mana=%.1f charges=%d", gate.Name, gs ~= nil and gs.Mana or -1, self.DashShown))
            end
            return
        end
        local lv = self:GetPowerLevel(id)
        if lv <= 0 then
            if id == "wraith_dash" then
                -- 해금 레벨은 표에서 (10-28 사용자 #1: Lv25 → Lv9)
                local def = _SkillData:Get("wraith_dash")
                local need = def ~= nil and math.floor(def.row) or 9
                _HudMain:ShowWarn("질주는 Lv" .. tostring(need) .. "부터 스킬 창(K) 「걸음」에서 배울 수 있습니다")   -- 트리 이름 「걸음」 (10-29 확정 84)
            end
            return
        end
        -- 연타 방지 (10-24 사용자: 두 번 누르면 두 번 질주했다 — 서버는 두 번째를 거절하는데 내 화면은 이미 움직였다).
        -- 서버가 아직 확인하지 않은 질주 수를 남은 횟수에서 미리 빼고, 0.8초 안에 확인이 없으면 잊는다. 질주 사이 최소 0.3초
        local now = _UtilLogic.ElapsedSeconds
        if self.DashSeen >= 0 and self.DashShown < self.DashSeen then self.DashPending = math.max(0, self.DashPending - (self.DashSeen - self.DashShown)) end
        self.DashSeen = self.DashShown
        if now - self.MovePredictAt > 0.8 then self.DashPending = 0 end
        if self:CooldownLeft(id) > 0.05 or now - self.MovePredictAt < 0.3 or self.DashShown - self.DashPending < 1 then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or stats.Mana < self:GetManaCost(id, lv) then return end
        local me = _Util:Pos2(self.Entity)
        local range = self:GetEffectPower(id, lv)
        local dest
        local blink = self:Node("dash_blink") > 0
        if blink then
            -- 11-04 망령 도약: 벽을 넘는다 (BlinkLanding — 맵 밖 거부 · 걸어서 이어지지 않는 칸(봉인·잠긴 문 너머) 건너뜀 · 없으면 벽 앞)
            local landing = self:BlinkLanding(map, me, self:BlinkAimPoint(me, range), range)
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] blink landing reason=%s over=%s skipped=%d from=%.2f,%.2f to=%.2f,%.2f", landing.reason, tostring(landing.over), landing.skipped, me.x, me.y, landing.pos.x, landing.pos.y)) end
            if landing.reason == "outside" then
                _HudMain:ShowWarn("맵 밖으로는 도약할 수 없습니다")
                return
            end
            dest = landing.pos
        else
            local dir = self:MoveDirection()
            dest = _Util:ReachablePoint(map, me, me + dir * range, 0.25)
        end
        if (dest - me):Magnitude() < 0.3 then return end
        self.MovePredictAt = now
        self.DashPending = self.DashPending + 1
        self:RequestCast(id, dest)
        ---@type ClickControl
        local click = self.Entity:GetComponent("script.ClickControl")
        if click ~= nil then
            click:Cancel()
            click.AttackTimer = math.max(click.AttackTimer, 0.3)
        end
        if math.abs(dest.x - me.x) > 0.05 then self.Entity.PlayerControllerComponent.LookDirectionX = dest.x >= me.x and 1 or -1 end
        _SoundDirector:PlaySkillCue(blink and "wraith_blink" or id)
        if blink then
            self.Entity.MovementComponent:SetWorldPosition(dest)
            return
        end
        -- 질주: 0.16초 동안 미끄러지듯 (매 프레임 자리 쓰기)
        local steps = 8
        for i = 1, steps do
            local t = i / steps
            _TimerService:SetTimerOnce(function()
                if not _Util:IsAlive(self.Entity) or self.Entity.CurrentMap ~= map then return end
                local ease = 1 - (1 - t) * (1 - t)
                self.Entity.MovementComponent:SetWorldPosition(me + (dest - me) * ease)
            end, 0.02 * i)
        end
    end

    @ExecSpace("ClientOnly")
    method Vector2 BlinkAimPoint(Vector2 me, number range)
        -- 망령 도약이 노리는 자리. PC 마우스 모드 = 커서 (1칸보다 가까우면 커서 쪽으로 최대 거리) · 키보드·모바일 = 질주와 같은 방향(MoveDirection)으로 최대 거리
        --   11-05 사용자 「텔레포트가 안 된다」: 예전엔 키보드·모바일에서 주문 조준(GetAimPoint — 고른 적·앞쪽 가장 가까운 적)을 그대로 써서
        --   곁에 붙은 몬스터 자리로 0.1~0.4칸만 옮기거나(충전만 씀) 0.3칸 미만이면 아무 일도 없었다
        ---@type ClickControl
        local cc = self.Entity:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            local cursor = _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition())
            if (cursor - me):Magnitude() >= 1 then return cursor end
        end
        return me + self:MoveDirection() * range
    end

    @ExecSpace("ClientOnly")
    method Vector2 MoveDirection()
        -- 질주 방향: PC 마우스 모드는 커서 쪽, 아니면 모바일 조준 끌기 → 누르고 있는 방향키·마지막으로 움직인 쪽 → 바라보는 쪽
        local me = _Util:Pos2(self.Entity)
        ---@type ClickControl
        local cc = self.Entity:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            local d = _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition()) - me
            if d:Magnitude() > 0.2 then return d:Normalize() end
        end
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil and attack.LocalAimActive and attack.LocalAimDirection:Magnitude() > 0.1 then return attack.LocalAimDirection:Normalize() end
        if cc ~= nil and cc.FacingDir:Magnitude() > 0.5 then return cc.FacingDir:Normalize() end
        return Vector2(self.Entity.PlayerControllerComponent.LookDirectionX >= 0 and 1 or -1, 0)
    end

    @ExecSpace("Client")
    method void PresentCast(string id, Vector2 dir)
        -- 성공한 시전만 소유자 클라이언트에서 재생한다. 소환/집결은 바라보는 방향을 바꾸지 않는다.
        if self.Entity ~= _UserService.LocalPlayer or not _Util:IsAlive(self.Entity) then return end
        -- 골편은 누를 때 이미 재생했다 (PredictBoneShard). 질주·도약은 몸짓 없이 움직임만 (CastMove)
        if id == "bone_shard" and _UtilLogic.ElapsedSeconds - self.PredictedCastAt < 1.5 then return end
        if id == "wraith_dash" then return end
        self:PlayCastGesture(id, dir)
    end

    @ExecSpace("ClientOnly")
    method void PlayCastGesture(string id, Vector2 dir)
        -- 시전 소리·방향·몸짓 (서버 확인 후 PresentCast, 골편은 누르는 순간 PredictBoneShard)
        _SoundDirector:PlaySkillCue(id)
        local command = id == "raise_skeleton" or id == "raise_mage" or id == "bone_rite" or id == "bone_giant" or id == "bone_offering" or id == "shadow_summon" or id == "rally" or id == "elite_promote"
        if not command and math.abs(dir.x) > 0.05 then self.Entity.PlayerControllerComponent.LookDirectionX = dir.x >= 0 and 1 or -1 end
        if id == "bone_shard" then
            -- 10-11 QA 「발사 때 캐릭터 옆 파란 이펙트」: ATTACK 상태로 바꾸면 무기 휘두르기 동작과 그 잔상(검기)이 함께 나왔다.
            -- 골편은 공격 상태 없이 주문 몸짓만 한 번 틀고, 끝나면 지금 상태(서기·걷기)의 몸짓으로 되돌린다
            local avatar = self.Entity.AvatarRendererComponent
            local body = isvalid(avatar) and avatar:GetBodyEntity() or nil
            if isvalid(body) then body:SendEvent(ActionStateChangedEvent("heal", "heal", 1.6, SpriteAnimClipPlayType.Onetime)) end
            local count = self.PresentedCastCount + 1
            _TimerService:SetTimerOnce(function()
                if self.PresentedCastCount ~= count or not _Util:IsAlive(self.Entity) then return end
                local state = self.Entity.StateComponent.CurrentStateName
                if state == "MOVE" then self.Entity:SendEvent(BodyActionStateChangeEvent(true, MapleAvatarBodyActionState.Walk, 0, 2147483647, 1))
                elseif state == "IDLE" then self.Entity:SendEvent(BodyActionStateChangeEvent(true, MapleAvatarBodyActionState.Stand, 0, 2147483647, 1)) end
            end, 0.45)
        else
            self.Entity.StateComponent:ChangeState("ATTACK")
            self.Entity:SendEvent(BodyActionStateChangeEvent(true, MapleAvatarBodyActionState.Heal, 0, 2147483647, 1.25))
        end
        self.PresentedCastCount = self.PresentedCastCount + 1
    end

    @ExecSpace("ServerOnly")
    method void CancelPending()
        self.CastEpoch = self.CastEpoch + 1
        self.PendingCasts = {}
        self.PendingMana = 0
    end

    @ExecSpace("ServerOnly")
    method void SetCooldown(string id, number seconds)
        -- 쿨다운 시작 + 클라이언트 표시용 요약 (끝 시각은 서버 시각 ServerElapsedSeconds 기준)
        local now = _UtilLogic.ElapsedSeconds
        self.ReadyAt[id] = now + seconds
        self.CdLen[id] = seconds
        local snow = _UtilLogic.ServerElapsedSeconds
        local parts = {}
        for k, t in pairs(self.ReadyAt) do
            if t > now then table.insert(parts, k .. ":" .. string.format("%.2f", snow + (t - now)) .. ":" .. string.format("%.2f", self.CdLen[k] or seconds)) end
        end
        self.CdDigest = table.concat(parts, ";")
    end

    method number CooldownLeft(string id)
        -- 남은 쿨다운(초). 0이면 쓸 수 있다 (클라이언트·서버 공용, 요약 문자열 기준)
        if id == "" then return 0 end
        local untilAt = tonumber(string.match(";" .. self.CdDigest, ";" .. id .. ":([%d%.]+):"))
        if untilAt == nil then return 0 end
        return math.max(0, untilAt - _UtilLogic.ServerElapsedSeconds)
    end

    method number CooldownRatio(string id)
        -- 남은 비율 1→0 (덮개 채움)
        local total = tonumber(string.match(";" .. self.CdDigest, ";" .. id .. ":[%d%.]+:([%d%.]+)"))
        if total == nil or total <= 0 then return 0 end
        return math.min(1, self:CooldownLeft(id) / total)
    end

    -- ───────── 입력 (내 클라이언트) ─────────

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        local key = event.key
        if key == KeyboardKey.Space then
            -- 망령 질주 (10-20): 스킬 칸과 상관없이 스페이스 (마을에서는 NPC 대화가 스페이스를 쓴다 — CastMove가 마을을 건너뛴다)
            self:CastMove("wraith_dash")
            return
        end
        local slot = self:KeySlot(key)
        if slot <= 0 then return end
        -- 뼈 의식 칸: 누르는 동안 모으고 뗄 때 나간다 (HandleKeyUpEvent → ReleaseRite)
        if self:GetSlotSkill(slot) == "bone_rite" then
            self:BeginRiteHold(slot)
            return
        end
        -- 땅 찍기 칸 (44-3 A): 누르는 동안 조준점에 범위 원, 뗄 때 나간다 (짧게 눌러도 똑같이 한 번)
        if self:BeginGroundHold(slot) then return end
        self:CastSlot(slot)
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyUpEvent(KeyUpEvent event)
        -- 뼈 의식: 누르던 키를 떼면 그때까지 모은 단계로 나간다 · 땅 찍기: 떼는 순간 원이 있던 자리에 시전
        if self.Entity ~= _UserService.LocalPlayer then return end
        local slot = self:KeySlot(event.key)
        if self.RiteHoldAt >= 0 and slot == self.RiteHoldSlot then self:ReleaseRite() return end
        if self.GroundHoldSlot ~= 0 and slot == self.GroundHoldSlot then
            self.GroundHoldSlot = 0
            self.GroundHoldMap = nil
            if _UIKit:CanUseGameplayInput() then self:CastSlot(slot) end
            if not Environment:IsPublishedPlay() then log("[VRF] ground hold release slot=" .. tostring(slot)) end
        end
    end

    method integer KeySlot(KeyboardKey key)
        -- 스킬 칸 키: A S D F = 1~4, 마우스 우클릭 = 5 (그 밖 0)
        if key == KeyboardKey.A then return 1 end
        if key == KeyboardKey.S then return 2 end
        if key == KeyboardKey.D then return 3 end
        if key == KeyboardKey.F then return 4 end
        if key == KeyboardKey.Mouse1 then return 5 end
        return 0
    end

    method string GetSlotSkill(integer slot)
        if slot == 5 then return self.RightSkill end
        local i = 0
        for s in string.gmatch(self.Slots .. ",", "([^,]*),") do
            i = i + 1
            if i == slot then return s end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method void CastSlot(integer slot)
        -- 창/사망 상태에서는 단축키와 모바일 시전 요청을 함께 막는다.
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        -- 쿨다운 중이면 서버에 보내지 않는다 (칸의 덮개가 남은 시간을 보여 준다)
        local id = self:GetSlotSkill(slot)
        if id == "bone_rite" then
            -- 뼈 의식: 모으던 칸이면 뗀 것(모바일 단추를 놓음)으로 보고 내보낸다. 모으지 않고 들어온 입력은 1기(해골 폭탄) 바로
            if self.RiteHoldAt >= 0 and self.RiteHoldSlot == slot then self:ReleaseRite()
            elseif self.RiteHoldAt < 0 and self:CooldownLeft(id) <= 0.05 then
                self:RequestRite(1, self:GetAimPoint(id))
                if not Environment:IsPublishedPlay() then log("[VRF] rite tap slot=" .. tostring(slot)) end
            end
            return
        end
        if self.RiteHoldAt >= 0 then return end   -- 의식을 모으는 동안 다른 스킬은 못 쓴다 (걷기·기본 공격은 된다 · 기획서 43 §3-1-2 A)
        if id == "" or self:CooldownLeft(id) > 0.05 then return end
        if id == "wraith_dash" then self:CastMove(id) return end
        if id == "bone_shard" then
            -- 서버 쿨다운이 화면에 오기 전 연타로 예측만 더 나가지 않게, 방금 그린 시전의 쿨다운은 여기서 막는다
            local def = _SkillData:Get(id)
            ---@type PlayerStats
            local stats = self.Entity:GetComponent("script.PlayerStats")
            local cd = (def ~= nil and def.cooldown or 0.5) * (stats ~= nil and stats:GetCastCooldownMult() or 1)
            if _UtilLogic.ElapsedSeconds - self.PredictedCastAt < cd - 0.03 then return end
        end
        local aim = self:GetAimPoint(id)
        if id == "bone_shard" then self:PredictBoneShard(aim) end
        self:RequestCast(id, aim)
        -- 10-11 QA 「골편 쏠 때 캐릭터 옆 파란 이펙트」: 클릭으로 고른 옆 몬스터에게 자동 평타가 같이 나가 평타 궤적이 보였다.
        -- 스킬을 쓴 직후 잠깐은 자동 평타를 쉬게 한다 (Shift+클릭·Ctrl 평타는 그대로)
        ---@type ClickControl
        local click = self.Entity:GetComponent("script.ClickControl")
        if click ~= nil then click.AttackTimer = math.max(click.AttackTimer, 0.6) end
    end

    @ExecSpace("ClientOnly")
    method void PredictBoneShard(Vector2 aim)
        -- 골편은 누르는 순간 내 화면에서 바로 나간다 (서버 확인을 기다리면 0.5초쯤 늦어 보였다, 10-11 QA).
        -- 서버 Cast와 같은 조건(마을·마나·쿨다운·대상 우선순위)일 때만 그린다. 판정·피해·마나는 서버가 정한다
        if _GameConst:IsTown(self.Entity.CurrentMap) or not _Util:IsAlive(self.Entity) then return end
        local lv = self:GetPowerLevel("bone_shard")
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if lv <= 0 or stats == nil or stats.Mana < self:GetManaCost("bone_shard", lv) then return end
        local me = _Util:Pos2(self.Entity)
        local lock = nil
        ---@type ClickControl
        local click = self.Entity:GetComponent("script.ClickControl")
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if click ~= nil and attack ~= nil and attack:IsLiveMonster(click.AttackTarget) and _Util:Distance(self.Entity, click.AttackTarget) <= 7.5 then lock = click.AttackTarget end
        local near = lock == nil and _Util:NearestMonster(self.Entity.CurrentMap, aim, 1.2) or nil
        if near ~= nil and (_Util:Pos2(near.Entity) - me):Magnitude() <= 7.5 then lock = near.Entity end
        local target = aim
        if lock ~= nil then target = _Util:Pos2(lock)
        elseif (aim - me):Magnitude() > 6 then target = me + (aim - me):Normalize() * 6 end
        ---@type SkillEffects
        local effects = self.Entity:GetComponent("script.SkillEffects")
        if effects == nil then return end
        effects:PredictBoneShard(target, self:GetBoneShardCount(lv), lock, self:GetShardHits())
        self:PlayCastGesture("bone_shard", target - me)
        self.PredictedCastAt = _UtilLogic.ElapsedSeconds
    end

    @ExecSpace("ClientOnly")
    method Vector2 GetAimPoint(string id)
        -- PC 마우스 모드: 커서. 키보드·모바일 (10-11): 버튼 끌어 조준 → 고른 대상 → 바라보는 방향 ±40° 안 가장 가까운 적(7칸) → 바라보는 방향 앞.
        -- 바라보는 방향 = 마지막으로 움직인 쪽 (ClickControl.FacingDir, 방향키 ↓→면 오른쪽 아래 대각). 전에는 뒤쪽 적도 가장 가까우면 겨눴고 좌우로만 나갔다
        ---@type ClickControl
        local cc = self.Entity:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            return _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition())
        end
        local me = _Util:Pos2(self.Entity)
        local corpse = id == "raise_skeleton" or id == "raise_mage"
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil and attack.LocalAimActive then
            if corpse then
                local orb = _UndeadSystem:FindSoulInDirection(self.Entity, me, attack.LocalAimDirection, 5)
                if orb ~= nil then return _Util:Pos2(orb.Entity) end
            end
            -- 44-3 A 모바일 끌기 거리 비례: 땅 찍기(장판·저주·의식)는 손가락을 끈 길이만큼 — 데드존을 막 넘으면 MobileAimMinDist칸, 끝까지 끌면 GroundCastRange칸
            --   (예전엔 늘 5칸이라 가까운 무리에 독안개·감옥·저주를 놓을 수 없었다). 투사체는 방향만 쓰므로 그대로
            if id == "bone_rite" or self:IsGroundSkill(id) then
                local reach = math.max(0, math.min(1, _MobilePad.AimReach))
                return me + attack.LocalAimDirection * (self.MobileAimMinDist + (self.GroundCastRange - self.MobileAimMinDist) * reach)
            end
            return me + attack.LocalAimDirection * (corpse and 2.5 or 5)
        end
        local face = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX >= 0 and 1 or -1, 0)
        if cc ~= nil and cc.FacingDir:Magnitude() > 0.5 then face = cc.FacingDir end
        if corpse then
            -- 혼 스킬: 바라보는 방향의 혼을 먼저, 없으면 시전 거리(5) 안 가장 가까운 내 혼 (뒤쪽이어도 — 3칸 밖 뒤쪽 혼은 못 쓰던 문제)
            local orb = _UndeadSystem:FindSoulInDirection(self.Entity, me, face, 5)
            if orb == nil then orb = _UndeadSystem:FindSoul(self.Entity, me, 5, true) end   -- 일반 혼만 (정예·보스 혼은 추출용)
            if orb ~= nil then return _Util:Pos2(orb.Entity) end
            return me
        end
        if attack ~= nil and attack:IsLiveMonster(attack.SelectedTarget) and _Util:Distance(self.Entity, attack.SelectedTarget) <= 7 then
            return _Util:Pos2(attack.SelectedTarget)
        end
        local m = _Util:MonsterInCone(self.Entity.CurrentMap, me, face, 7, 0.766)
        if m ~= nil then return _Util:Pos2(m.Entity) end
        return me + face * 5
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method void MigrateLevels(integer sv)
        -- 삭제·미구현·상한 초과 투자를 환급한다. 레벨 조정 후 다시 호출해도 중복 환급하지 않는다. sv = 불러온 저장 판 (GetSaveData)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return end
        local refund = 0
        refund = refund + self:MigrateBombToRite(stats.Level)
        refund = refund + self:MigrateNodeSwap(sv)
        refund = refund + self:MigrateSpearToShard()
        refund = refund + self:MigrateDrainToSpikes()
        refund = refund + self:MigrateDash1104()
        refund = refund + self:MigrateNodes1103(sv)
        refund = refund + self:MigrateStartRank(sv)
        self:MigrateGiantSplit(sv)
        for id, lv in pairs(self.Levels) do
            local def = _SkillData:Get(id)
            if def == nil or not def.impl then
                refund = refund + lv
                self.Levels[id] = nil
            elseif lv > def.maxLv then
                refund = refund + lv - def.maxLv
                self.Levels[id] = def.maxLv
            end
        end
        -- 선행 강화를 안 찍은 채 남은 투자 (44 결정 4: 「뼈 가시」에 「튕김」 조건이 생겼다)는 돌려준다. 다시 불러도 이미 지운 칸이라 두 번 돌려주지 않는다
        for id, lv in pairs(self.Levels) do
            local def = _SkillData:Get(id)
            if def ~= nil and def.kind == "node" and def.prereq ~= "" and (self.Levels[def.prereq] or 0) <= 0 then
                refund = refund + lv
                self.Levels[id] = nil
                log("[VRF] node prereq refund " .. id .. "=" .. tostring(lv))
            end
        end
        local shadow = _SkillData:Get("shadow_summon")
        if shadow ~= nil and (self.Levels.shadow_summon or 0) > 0 and stats.Level < shadow.row then
            -- 그림자 소환은 시작 스킬이 아니다 (시작 스킬은 레이스 폼뿐). 대체 스킬을 주지 않으므로 제거한 투자 전부를 돌려준다.
            refund = refund + self.Levels.shadow_summon
            self.Levels.shadow_summon = nil
        end
        for id in string.gmatch(self.StartSkills, "[^,]+") do
            if (self.Levels[id] or 0) <= 0 then self.Levels[id] = 1 end
        end
        if refund > 0 then
            stats.SkillPoints = stats.SkillPoints + refund
            -- 돌려줬다는 알림은 띄우지 않는다 (10-29 사용자: 변경 해명·이전 안내 알림은 만들지 않는다 — 포인트만 늘어 있다)
            log("[VRF] skill migrate refund=" .. tostring(refund))
        end
    end

    @ExecSpace("ServerOnly")
    method integer MigrateSpearToShard()
        -- 11-01 사용자 결정 (docs/design/49 · 한 번만): 골편 투척과 같은 스킬이던 Lv15 혼 스킬과 그 강화 둘을 게임에서 뺐다. 돌려준 포인트 수
        --   배운 랭크만큼 포인트로 돌려주고 표에서 지운다 — 지운 칸이라 다시 불러도·다시 호출해도 두 번 돌려주지 않는다 (저장 판 번호와 무관)
        --   칸·우클릭에 걸린 옛 스킬은 LoadSaveData가 비운다. 알림은 띄우지 않는다 (10-29 글귀 규칙: 옛 저장 이전 안내·변경 해명 금지 — 포인트만 늘어 있다)
        --   옛 키 이름은 이 함수 · LoadSaveData 칸 정리에만 남긴다 (tools/check_data.cjs 「지운 스킬의 흔적」 검사가 이 자리만 허용)
        local back = 0
        local moved = {}
        for _, id in ipairs({ "bone_spear", "spear_long", "spear_twin" }) do
            local r = self.Levels[id] or 0
            if r > 0 then
                back = back + r
                table.insert(moved, id .. ":" .. tostring(r))
            end
            self.Levels[id] = nil
        end
        if back > 0 then log(string.format("[VRF] skill migrate bone_spear refund=%d nodes=%s", back, table.concat(moved, ","))) end
        return back
    end

    @ExecSpace("ServerOnly")
    method integer MigrateDrainToSpikes()
        -- 11-04 사용자 결정 (기획 62 §14 · 저장 sv 8 → 9): 드레인 라이프와 그 강화 「혼 사슬」을 빼고 뼈 쐐기를 넣었다. 돌려준 포인트 수
        --   찍은 랭크를 모두 포인트로 돌려주고 키를 지운다 — 지운 칸이라 다시 불러도·다시 호출해도 두 번 돌려주지 않는다 (저장 판 번호와 무관 · MigrateSpearToShard 선례)
        --   칸·우클릭의 옛 스킬은 LoadSaveData가 비운다(뼈 쐐기는 0랭크라 칸에 둘 수 없다). 2soul·장비 고유 효과에 옛 스킬 참조 없음(11-04 확인). 알림 없음 (10-29 글귀 규칙)
        --   옛 키 이름은 이 함수 · LoadSaveData · MigrateNodeSwap(44 결정 4 옛 목록)에만 남긴다 (tools/check_data.cjs 「지운 스킬(11-04)의 흔적」 허용 자리)
        local back = 0
        local moved = {}
        for _, id in ipairs({ "soul_drain", "drain_share" }) do
            local r = self.Levels[id] or 0
            if r > 0 then
                back = back + r
                table.insert(moved, id .. ":" .. tostring(r))
            end
            self.Levels[id] = nil
        end
        if back > 0 then log(string.format("[VRF] skill migrate drain→spikes refund=%d had=%s", back, table.concat(moved, ","))) end
        return back
    end

    @ExecSpace("ServerOnly")
    method integer MigrateDash1104()
        -- 11-04 질주 개편 (사용자 · 기획 62 §15 · 저장 sv 10): 질주 maxLv 20 → 10 · 강화 뼈 껍질·망령 자취·재빠른 숨 삭제. 돌려준 포인트 수
        --   삭제 노드 3개는 찍은 랭크를 돌려주고 키를 지운다 · 질주 11~20랭크는 10으로 내리고 넘친 랭크를 돌려준다 (키·상한 기준 · 한 번 · 다시 불러도 0). 알림 없음
        --   옛 키 이름은 이 함수와 MigrateNodeSwap(44 결정 4 옛 목록)에만 남긴다 (tools/check_data.cjs 「지운 노드(11-04)의 흔적」 허용 자리)
        local back = 0
        local moved = {}
        for _, id in ipairs({ "dash_ghost", "dash_trail", "dash_quick" }) do
            local r = self.Levels[id] or 0
            if r > 0 then
                back = back + r
                table.insert(moved, id .. ":" .. tostring(r))
            end
            self.Levels[id] = nil
        end
        local dash = self.Levels.wraith_dash or 0
        local def = _SkillData:Get("wraith_dash")
        if def ~= nil and dash > def.maxLv then
            back = back + dash - def.maxLv
            table.insert(moved, "wraith_dash:" .. tostring(dash) .. "→" .. tostring(def.maxLv))
            self.Levels.wraith_dash = def.maxLv
        end
        if back > 0 then log(string.format("[VRF] skill migrate dash1104 refund=%d had=%s", back, table.concat(moved, ","))) end
        return back
    end

    @ExecSpace("ServerOnly")
    method integer MigrateNodes1103(integer sv)
        -- 11-03 스킬 랭크 개편 (docs/design/62 §10-4 · §12): 돌려준 포인트 수. 알림 없음 (10-29 글귀 규칙 — 포인트만 늘어 있다)
        --   삭제 7개(진한 성찬·골수 화약·원소 집중·단련된 뼈·깊은 울림·군령 + 갈래가 흡수한 짝 폭탄): 키가 있으면 한 번 돌려주고 지운다 (지운 칸이라 다시 불러도 두 번 안 줌 · 저장 판 무관)
        --   축 바꾼 4개(급속 골화·피투성이 난장판·유도탄·약화의 오라 — 키 그대로): 저장 sv 7 전 판만 한 번 돌려주고 지운다 (sv 7 저장은 새 효과로 찍은 것)
        --   옛 키 이름은 이 함수에만 남긴다 (tools/check_data.cjs 「지운 스킬의 흔적」 허용 자리)
        local back = 0
        local pruned = {}
        for _, id in ipairs({ "offering_heal", "bomb_marrow", "mage_focus", "skeleton_mastery", "aura_deep", "command_mastery", "bomb_pair" }) do
            local r = self.Levels[id] or 0
            if r > 0 then
                back = back + r
                table.insert(pruned, id .. ":" .. tostring(r))
            end
            self.Levels[id] = nil
        end
        local swapped = {}
        if sv < 7 then
            for _, id in ipairs({ "armor_thick", "flame_hex", "shard_spike", "enfeeble_deep" }) do
                local r = self.Levels[id] or 0
                if r > 0 then
                    back = back + r
                    self.Levels[id] = nil
                    table.insert(swapped, id .. ":" .. tostring(r))
                end
            end
        end
        if back > 0 then log(string.format("[VRF] skill migrate nodes1103 refund=%d sv=%d prune=%s swap=%s", back, sv, table.concat(pruned, ","), table.concat(swapped, ","))) end
        return back
    end

    @ExecSpace("ServerOnly")
    method integer MigrateStartRank(integer sv)
        -- 11-03 저녁 사용자 결정 (docs/design/62 §13 · 저장 sv 7 → 8 · 한 번만): 레이스 폼 1랭크는 시작부터 거저 준다 (StartSkills). 돌려준 포인트 수
        --   옛 저장에 이미 1랭크 이상을 포인트로 찍었으면 랭크는 그대로 두고 포인트 1을 돌려준다 (그 1랭크가 이제 무료) · 0이면 1로 올린다 (포인트 그대로)
        --   sv 8 저장 · 이번 불러오기에서 이미 한 번 했으면 다시 돌지 않는다 (StartGrantDone — LoadSaveData가 불러올 때마다 지운다). 알림 없음 (10-29 글귀 규칙)
        if self.StartGrantDone then return 0 end
        self.StartGrantDone = true   -- sv 8 저장도 표시한다 (그 저장을 MigrateLevels로 다시 돌려도 옛 판으로 보지 않게)
        if sv >= 8 then return 0 end
        local back = 0
        local moved = {}
        for id in string.gmatch(self.StartSkills, "[^,]+") do
            local r = self.Levels[id] or 0
            if r >= 1 then back = back + 1 else self.Levels[id] = 1 end
            table.insert(moved, id .. ":" .. tostring(r))
        end
        log(string.format("[VRF] skill migrate start rank sv=%d refund=%d had=%s", sv, back, table.concat(moved, ",")))
        return back
    end

    @ExecSpace("ServerOnly")
    method integer MigrateGiantSplit(integer sv)
        -- 11-02 사용자 결정 B (기획서 52 §2-2 안 ① · 한 번만 · 저장 sv 5 → 6): 거인 노드 12개의 부모가 뼈 의식 → 본 골렘(bone_giant)으로 바뀌었다.
        --   노드 키는 그대로라 찍은 랭크는 그대로 둔다. 거인 노드에 1랭크라도 찍은 옛 저장은 본 골렘 1랭크를 거저 준다 (포인트 그대로 · 칸에는 넣지 않는다 —
        --   예전에는 뼈 의식 하나로 거인을 세웠으니 거인을 잃지 않게). 필요 랭크(10·14·17·20)는 이제 본 골렘 랭크라 다음 랭크는 본 골렘을 올려야 찍힌다 —
        --   이미 찍은 랭크의 효과는 지금처럼 캐릭터 레벨로만 잠긴다 (NodeUsable 그대로). 알림 없음 (10-29 글귀 규칙). 준 랭크 수 (환급 아님)
        --   sv 6 저장 · 이미 본 골렘이 있는 저장은 다시 돌지 않는다
        if sv >= 6 or (self.Levels.bone_giant or 0) > 0 then return 0 end
        local sum = 0
        local moved = {}
        for id, lv in pairs(self.Levels) do
            if string.sub(id, 1, 6) == "giant_" and lv > 0 then
                sum = sum + lv
                table.insert(moved, id .. ":" .. tostring(lv))
            end
        end
        if sum <= 0 then return 0 end
        self.Levels.bone_giant = 1
        table.sort(moved)
        log(string.format("[VRF] giant split migrate sv=%d grant bone_giant=1 nodes=%d (%s) slot=none", sv, sum, table.concat(moved, ",")))
        return 1
    end

    @ExecSpace("ServerOnly")
    method integer MigrateNodeSwap(integer sv)
        -- 44 결정 4 (한 번만 · 저장 sv 3 → 4): 효과가 통째로 바뀐 강화 5개(키는 그대로 · 코덱스 아이콘 node-<키>)의 투자를 돌려준다.
        --   질풍 걸음 → 잔걸음 · 흐릿한 형체 → 뼈 껍질 · 가시 갑옷 → 터지는 갑옷 · 나눔 → 혼 사슬 · 시린 혼 → 서리 표식. 돌려준 포인트 수
        --   (뼈 가시는 키·효과 방향이 그대로라 남기고, 「튕김」 조건만 MigrateLevels가 본다). sv 4 저장은 다시 돌지 않는다
        --   48-3 (한 번만 · 저장 sv 4 → 5): 마법사 거인 갈림 둘(원소 붕괴 · 끌어당기는 땅 → 두 겹 고리)은 저주 장판이 화염 노바로 바뀌어 효과가 통째로 바뀌었다 → 같은 방식으로 돌려준다.
        --   지운 노드 9개(skel_shield · mage_aura·twin·pierce·blast·hex · giant_quake·basic_split·basic_return)는 정의가 없어 MigrateLevels 본문이 돌려준다 (여기서 다시 세지 않는다)
        if sv >= 5 then return 0 end
        local swapped = {}
        if sv < 4 then swapped = { "step_gale", "dash_ghost", "armor_thorns", "drain_share", "frost_long" } end
        table.insert(swapped, "giant_mage_resist")
        table.insert(swapped, "giant_mage_pull")
        local back = 0
        local moved = {}
        for _, id in ipairs(swapped) do
            local r = self.Levels[id] or 0
            if r > 0 then
                back = back + r
                self.Levels[id] = nil
                table.insert(moved, id .. ":" .. tostring(r))
            end
        end
        if back > 0 then log(string.format("[VRF] node swap refund=%d sv=%d nodes=%s", back, sv, table.concat(moved, ","))) end
        return back
    end

    @ExecSpace("ServerOnly")
    method integer MigrateBombToRite(integer playerLevel)
        -- 10-29 기획서 43 결정 2 (한 번만): 해골 폭탄(skel_bomb, Lv10) → 뼈 의식(bone_rite, Lv24)의 1기 단계로 랭크·강화를 옮긴다. 돌려준 포인트 수
        --   메인 랭크: 지금 레벨의 의식 상한(RankCap — Lv24 전이면 0)까지 옮기고 넘는 몫은 포인트로 돌려준다.
        --   강화(큰 폭발 = 지금 초거대): 키는 그대로 의식 1기 강화가 됐다 (골수 화약·짝 폭탄은 11-03 삭제 — MigrateNodes1103이 돌려준다). 해금이 Lv10 → 24로 늦어져 지금 레벨·의식 랭크로 열리지 않은 랭크만 돌려준다.
        --   skel_bomb 키가 사라진 저장은 다시 돌지 않는다 (저장은 PlayerSave 자동 저장이 바뀐 값을 알아서 쓴다 — 따로 DataStorage를 부르지 않는다)
        local bomb = self.Levels.skel_bomb
        if bomb == nil then return 0 end
        self.Levels.skel_bomb = nil
        local rite = _SkillData:Get("bone_rite")
        local have = self.Levels.bone_rite or 0
        local keep = math.max(0, math.min(bomb, self:RankCap("bone_rite", playerLevel) - have, (rite ~= nil and rite.maxLv or 20) - have))
        if keep > 0 then self.Levels.bone_rite = have + keep end
        local back = bomb - keep
        local riteLv = self.Levels.bone_rite or 0
        local moved = {}
        for _, node in ipairs({ "bomb_wide" }) do
            local r = self.Levels[node] or 0
            if r > 0 then
                local ok = 0
                while ok < r and riteLv >= self:NodeNeed(node, ok + 1) and playerLevel >= self:NodeLevel(node, ok + 1) do ok = ok + 1 end
                back = back + (r - ok)
                if ok > 0 then self.Levels[node] = ok else self.Levels[node] = nil end
                table.insert(moved, node .. ":" .. tostring(r) .. ">" .. tostring(ok))
            end
        end
        log(string.format("[VRF] rite migrate bomb=%d rite=%d refund=%d lv=%d nodes=%s", bomb, riteLv, back, playerLevel, table.concat(moved, ",")))
        local userId = self.Entity.PlayerComponent.UserId
        -- 옮겼다는 알림은 띄우지 않는다 (10-29 사용자: 변경 해명·이전 안내 알림은 만들지 않는다)
        return back
    end

    -- ───────── 초기화 (docs/design/16: Lv15까지 무료, 그 뒤 사제 오렌에게 200×레벨 골드) ─────────

    @ExecSpace("ServerOnly")
    method integer ResetSkills()
        -- 모든 스킬·강화 투자를 돌려준다 (돌려준 포인트 수). 퀵슬롯도 비운다
        --   시작 랭크(StartSkills — 레이스 폼 1)는 거저 받은 것이라 돌려주지 않고 1랭크로 남긴다 (62 §13)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local refund = 0
        for _, lv in pairs(self.Levels) do refund = refund + lv end
        local keep = {}
        for id in string.gmatch(self.StartSkills, "[^,]+") do
            if (self.Levels[id] or 0) > 0 then refund = refund - 1 end
            keep[id] = 1
        end
        self.Levels = keep
        self.Slots = ",,,"
        self.RightSkill = ""
        if stats ~= nil then stats.SkillPoints = stats.SkillPoints + refund end
        self:SanitizeSlots()
        self:RefreshDigest()
        return refund
    end

    method integer RespecCost(integer playerLevel)
        -- 초기화 비용: Lv15까지 0, Lv16 respecGoldBase(5만) + 그 뒤 레벨마다 respecGoldPerLevel (10-24 사용자: 3200은 사실상 무제한이었다)
        if playerLevel <= _GameData.respecFreeLevel then return 0 end
        return math.floor(_GameData.respecGoldBase + _GameData.respecGoldPerLevel * (playerLevel - _GameData.respecFreeLevel - 1))
    end

    @ExecSpace("Server")
    method void RequestRespec(string what)
        -- 스킬("skills")·능력치("stats") 초기화. Lv16부터는 마을 의뢰인(사제 오렌·카라반 대장 무하드) 곁에서 골드를 낸다
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or not _Util:IsAlive(self.Entity) then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or (what ~= "skills" and what ~= "stats") then return end
        local cost = self:RespecCost(stats.Level)
        if cost > 0 then
            local npc = _Util:NearestComponent(self.Entity.CurrentMap, "script.WorldNPC", _Util:Pos2(self.Entity), 4)
            if npc == nil or (npc.Kind ~= "quest" and npc.Kind ~= "caravan" and npc.Kind ~= "captain" and npc.Kind ~= "scout") then
                _Util:Warn("Lv" .. tostring(math.floor(_GameData.respecFreeLevel) + 1) .. "부터는 마을의 사제 오렌·카라반 대장 무하드 곁에서 초기화할 수 있습니다 (" .. tostring(cost) .. " 골드)", pc.UserId)
                return
            end
            if stats.Gold < cost then
                _Util:Warn("골드가 부족합니다 (" .. tostring(cost) .. " 필요)", pc.UserId)
                return
            end
            stats.Gold = stats.Gold - cost
        end
        local refund = what == "skills" and self:ResetSkills() or stats:ResetStats()
        _Util:Banner((what == "skills" and "스킬" or "능력치") .. " 초기화", "포인트 " .. tostring(refund) .. "개를 돌려받았습니다" .. (cost > 0 and (" · " .. tostring(cost) .. " 골드") or " · 무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)"), pc.UserId)
        log("[VRF] respec " .. what .. " refund=" .. tostring(refund) .. " cost=" .. tostring(cost))
        _Telemetry:NoteRespec(self.Entity, what, stats.Level, cost, stats.Gold, refund)
    end

    @ExecSpace("ServerOnly")
    method void MigrateRework()
        -- 10-11 개편 전 캐릭터: 스킬·능력치를 모두 돌려주고, 새 규칙(레벨당 2 · 의뢰 skp 2배)만큼 더 준다 (한 번만)
        if not self.NeedRework then return end
        self.NeedRework = false
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return end
        local skill = self:ResetSkills()
        local extra = math.max(0, stats.Level - 1) * (math.floor(_GameData.skillPerLevel) - 1)
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        if quest ~= nil then
            for i = 1, _QuestData:Count() do
                local q = _QuestData:Get(i)
                if i < quest.Index and string.find("," .. q.reward, ",skp:", 1, true) ~= nil then extra = extra + 1 end
            end
        end
        stats.SkillPoints = stats.SkillPoints + extra
        local stat = stats:ResetStats()
        -- 10-29 저녁(코덱스 권장 승인): 「스킬·능력치가 새로 바뀌었습니다」 이전 안내 배너는 띄우지 않는다 — 글귀 규칙(copy-approval-20261029 「변경 해명·옛 저장 이전 안내 알림은 만들지 않음」)과 49·50번 삭제 방향에 맞춤.
        --   환급·추가 포인트·퀘스트 보정·저장은 그대로 (포인트는 스킬(K)·능력치(U) 창의 「남은 포인트」로 보인다)
        log(string.format("[VRF] skill rework migrate skill=%d+%d stat=%d → skp=%d statp=%d (banner off)", skill, extra, stat, stats.SkillPoints, stats.StatPoints))
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        local levels = {}
        for id, lv in pairs(self.Levels) do levels[id] = lv end
        -- sv 4 (10-29 44 결정 4): 효과가 바뀐 강화 5개를 한 번 돌려준 뒤의 저장 · sv 5 (48-3): 마법사 거인 갈림 둘을 한 번 돌려준 뒤 (MigrateNodeSwap)
        -- sv 6 (11-02 거인 분리): 거인 노드 부모가 본 골렘으로 바뀐 뒤 (MigrateGiantSplit) · sv 7 (11-03): 축 바꾼 노드 4개를 한 번 돌려준 뒤 (MigrateNodes1103)
        -- sv 8 (11-03 저녁): 레이스 폼 1랭크가 거저 주는 시작 랭크가 된 뒤 (MigrateStartRank) · sv 9 (11-04): 드레인 라이프 → 뼈 쐐기 (MigrateDrainToSpikes · 키 기준이라 판 번호와 무관)
        -- sv 10 (11-04): 질주 랭크 10 · 강화 3개 삭제 (MigrateDash1104 · 키·상한 기준)
        local saved = { levelCount = 0, slots = self.Slots, right = self.RightSkill, sv = 10 }
        for _ in pairs(levels) do saved.levelCount = saved.levelCount + 1 end
        if saved.levelCount > 0 then saved.levels = levels end
        -- I04 골편 홀드 반복 — 선택 칸 (없으면 끔 · 판 번호와 무관). 옛 희망 편성 칸 hope는 11-02 편성 자동 하나로 쓰지 않는다 (불러올 때 버림)
        if self.ShardHold then saved.shardHold = true end
        if self.RiteBanner ~= "" then saved.banner = self.RiteBanner end   -- 46-1 거인 깃발 (선택 칸 · 없으면 안 고름)
        if self.GiantTips > 0 then saved.giantTips = self.GiantTips end   -- 46-6 거인 안내 띠 횟수
        if self.ShadowGuide then saved.shadowGuide = true end   -- 10-31 그림자 소환 뒤 게임 안내 창 1회 (없으면 아직 안 봄 → 다음 접속에 한 번)
        return saved
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        if d == nil then return end
        if d.levels ~= nil or d.levelCount == 0 then
            self.Levels = {}
            for id, lv in pairs(d.levels or {}) do self.Levels[id] = lv end
            self.StartGrantDone = false   -- 불러온 저장마다 시작 랭크 이전을 한 번 (MigrateStartRank)
            self:MigrateLevels(math.floor(d.sv or 1))
        end
        if d.slots ~= nil then self.Slots = d.slots end
        if d.right ~= nil then self.RightSkill = d.right end
        -- 11-01 Lv15 혼 스킬 삭제 (docs/design/49 · MigrateSpearToShard): 칸·우클릭에 걸린 옛 스킬을 비운다 (SanitizeSlots도 정의 없는 스킬을 비우지만 이유를 여기 남긴다)
        local wrapped = string.gsub("," .. self.Slots .. ",", ",bone_spear,", ",,")   -- 다중 반환은 지역에 먼저 받는다 (LEA-1102)
        self.Slots = string.sub(wrapped, 2, -2)
        if self.RightSkill == "bone_spear" then self.RightSkill = "" end
        -- 11-04 드레인 라이프 삭제 (MigrateDrainToSpikes): 칸·우클릭의 옛 스킬을 비운다 (뼈 쐐기로 바꿔 넣어도 0랭크라 SanitizeSlots가 비운다)
        local drainWrapped = string.gsub("," .. self.Slots .. ",", ",soul_drain,", ",,")
        self.Slots = string.sub(drainWrapped, 2, -2)
        if self.RightSkill == "soul_drain" then self.RightSkill = "" end
        -- 10-29 해골 폭탄 → 뼈 의식: 칸에 든 폭탄은 의식으로 바꿔 둔다 (의식을 아직 못 배웠으면 SanitizeSlots가 비운다)
        self.Slots = (string.gsub(self.Slots, "skel_bomb", "bone_rite"))
        if self.RightSkill == "skel_bomb" then self.RightSkill = "bone_rite" end
        -- 옛 저장(sv 없음): 예전 기본값이 우클릭에 넣어 둔 스킬을 비운다 (평타 중 골편 투척이 저절로 나가던 문제)
        if (d.sv or 1) < 2 then self.RightSkill = "" end
        -- sv 3 = 메인 스킬 + 강화 (10-11). 그 전 저장은 PlayerSave.FinishLoad에서 MigrateRework로 전부 돌려준다
        if (d.sv or 1) < 3 then self.NeedRework = true end
        -- I04 골편 홀드 반복: 옛 저장(칸 없음) = 끔.
        -- 11-02 편성 자동 하나 (기획 52 §3-2 안 C): 옛 희망 편성 칸 d.hope(직접 편성 희망 수)는 읽고 버린다 — 포인트와 무관해 환급·알림 없음 · 다음 저장부터 칸이 사라진다
        self.ShardHold = d.shardHold == true
        self.GiantTips = math.max(0, math.min(3, math.floor(tonumber(d.giantTips) or 0)))
        self.ShadowGuide = d.shadowGuide == true
        self.RiteBanner = ""
        if type(d.banner) == "string" then
            for _, k in ipairs(_UndeadSystem:GiantFallback()) do if k == d.banner then self.RiteBanner = k end end
        end
        if not Environment:IsPublishedPlay() then log("[VRF] roster save restored oldHope=" .. (type(d.hope) == "string" and d.hope ~= "" and ("dropped:" .. d.hope) or "none") .. " shardHold=" .. tostring(self.ShardHold)) end
        self:SanitizeSlots()
        self:RefreshDigest()
    end

end
