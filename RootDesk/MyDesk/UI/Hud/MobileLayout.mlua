-- 모바일 HUD 배치 (디아블로 이모탈식, docs/ui/mobile-layout.md) — 모바일에서만, PC 배치는 빌드 값 그대로.
--   왼쪽 위: 캐릭터 틀(MFrame) · 버프 · 의뢰 추적(HudMap) · 파티 / 큰 알림 판(번갈아 — 판이 떠 있는 동안 파티는 숨는다, 11-01)
--   위 가운데: 대상 체력 → 맵 배너·여정 안내 → 출구 안내 (엔진 채팅 알림·전체 화면 단추 아래)
--   오른쪽 위: 지도 0.75배(HudMap) · 메뉴·일지 단추 · 지도 아래 안내 줄(NoticeFeed, 두 줄)
--   가운데 아래: 경험치 · 소환수 줄(CompanionHUD) · 대화 단추(NpcWindow) / 왼쪽 아래: 조이스틱 · 채팅
--   오른쪽 아래: 공격·둥근 스킬 호·맨 아래 물약 줄·그림자 명령(빌드: ShadowHUD/MobilePad)
-- 노치·홈 표시줄 여백은 엔진이 UI 전체에 준다 (아이폰 가로: 양옆 약 168px, 아래 약 55px — 10-13 실기기 화면에서 잼).
@Logic
script MobileLayout extends Logic

    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        if not _ApplicationService:IsMobilePlatform() then return end
        self:Apply()
        -- 다른 HUD가 OnBeginPlay에서 자리를 잡은 뒤에 한 번 더 (시작 순서와 무관하게)
        self.TimerId = _TimerService:SetTimerOnce(function() self:Apply() end, 1)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    @ExecSpace("ClientOnly")
    method void Apply()
        local top, topL, topR = AlignmentType.TopCenter, AlignmentType.TopLeft, AlignmentType.TopRight
        local bottom = AlignmentType.BottomCenter
        -- 왼쪽 위 (캐릭터 틀 24~124 아래)
        self:Place("/ui/GameHUD/Buffs", topL, Vector2(0, 1), Vector2(24, -132))
        self:Place("/ui/GameHUD/Party", topL, Vector2(0, 1), Vector2(24, -384))
        -- 파티는 채널 4명까지라 200이면 충분하다 (360이면 조이스틱 자리까지 내려온다) · 10-31 B-4: 실제 높이는 HudMain.RenderParty가 글 높이로 (모바일은 펼친 채)
        self:Size("/ui/GameHUD/Party", Vector2(400, 200))
        self:Size("/ui/GameHUD/Party/Text", Vector2(400, 200))
        -- 위 가운데 한 줄 (엔진 단추가 0~90을 차지)
        self:Place("/ui/GameHUD/Target", top, Vector2(0.5, 1), Vector2(0, -100))
        self:Place("/ui/GameHUD/Banner", top, Vector2(0.5, 1), Vector2(0, -224))
        self:Place("/ui/GameHUD/Tip", top, Vector2(0.5, 1), Vector2(0, -224))
        -- 여정 안내 폭 860: 오른쪽 안내 줄(폭 500)과 안 겹치게 (PC 900)
        self:Size("/ui/GameHUD/Tip", Vector2(860, 74))
        self:Size("/ui/GameHUD/Tip/Text", Vector2(820, 66))
        self:Place("/ui/GameHUD/GatePrompt", top, Vector2(0.5, 1), Vector2(0, -384))
        -- 큰 알림 판(UXFeedback 600×122)은 왼쪽 열 의뢰 추적(196~372) 바로 아래 384~506 — 파티 목록(384~584)과 같은 자리를 번갈아 쓴다 (HudMain.RenderParty가 UXFeedback.SlotBusy 동안 파티를 숨김)
        --   11-01 실기기(아이폰 17 가로): 위 가운데 392~514(가로 707~1307)였을 때 해골 사망 알림이 플레이어 머리 위(화면 가운데 위 ~400~510)를 덮었다 → PC처럼 「왼쪽 알림 판」으로
        --   아래 끝 506 = 아이폰 아래에서 519 > 조이스틱 위 끝 400 · 스킬 추천 띠(404~476) 위 · 출구 안내(가운데, 16:9에서 x 580~)와는 원래대로 번갈아 (UXFeedback.ShowNext가 끈다)
        --   파티를 판 아래로 내리면 384+122+12 = 518 → 파티 200이면 아래 끝 718 = 아이폰 아래에서 307로 조이스틱(~400)을 덮어 숨기는 쪽을 골랐다 (tools/check_mobile_layout.cjs TURNS)
        self:Place("/ui/RewardHUD/Toast", topL, Vector2(0, 1), Vector2(24, -384))
        local toast = _EntityService:GetEntityByPath("/ui/RewardHUD/Toast")
        if isvalid(toast) then
            local tt = toast.UITransformComponent
            log(string.format("[VRF] MobileLayout toast left align=%s pos=(%d,%d) size=%dx%d top=%d bottom=%d", tostring(tt.AlignmentOption), math.floor(tt.anchoredPosition.x), math.floor(tt.anchoredPosition.y), math.floor(tt.RectSize.x), math.floor(tt.RectSize.y), math.floor(-tt.anchoredPosition.y), math.floor(-tt.anchoredPosition.y + tt.RectSize.y)))
        end
        -- 「스킬 추천」 띠: 가운데 아래는 소환수 줄(172~284) · 대화 단추(296~392, NpcWindow)가 쓰고 오른쪽은 그림자 명령·스킬 편집 단추라
        --   대화 단추 위 왼쪽(540~980 · 404~476)으로 (10-29 45 1-26 A: 빌드 자리 236은 소환수 줄·대화 단추·추출 단추와 겹쳤다)
        --   10-29 UI-20261029-01: 긴 선택 보상 제목은 띠가 넓어진다(SkillOffer.BandMaxWMobile) → 오른쪽 끝 980에 붙이고 왼쪽으로만 넓힌다 (스킬 편집 단추 990~)
        self:Place("/ui/GameHUD/OfferBand", bottom, Vector2(1, 0), Vector2(20, 404))
        -- 오른쪽 위: 지도는 0.75배(HudMap) → 오른쪽 24~282, 펼쳐도 위 120~416. 메뉴 단추는 그 왼쪽, 일지 단추는 또 그 왼쪽(HudMap)
        self:Place("/ui/GameHUD/BtnMenu", topR, Vector2(1, 1), Vector2(-298, -120))
        self:Place("/ui/GameHUD/BtnJae", topR, Vector2(1, 1), Vector2(-298, -120 - 96 - 28 - 16))   -- 「재 받기」는 메뉴 단추 바로 아래
        -- 안내 줄은 펼친 지도 아래 (지도 위로 덮으면 금화 줍기마다 지도가 가려진다): 폭 500 (위 가운데 맵 배너와 안 겹치게) · 높이 104 = 두 줄 (아래 스킬 호와 안 겹치게)
        self:Place("/ui/RewardHUD/Feed", topR, Vector2(1, 1), Vector2(-24, -428))
        self:Size("/ui/RewardHUD/Feed", Vector2(500, 104))
        for i = 1, _NoticeFeed.MaxLines do
            local line = "/ui/RewardHUD/Feed/Line" .. tostring(i)
            local e = _EntityService:GetEntityByPath(line)
            if isvalid(e) then e.UITransformComponent.RectSize = Vector2(500, e.UITransformComponent.RectSize.y) end
            local t = _EntityService:GetEntityByPath(line .. "/Text")
            if isvalid(t) then t.UITransformComponent.RectSize = Vector2(470, t.UITransformComponent.RectSize.y) end
        end
        _NoticeFeed.TextWidth = 470
        _NoticeFeed.MaxHeight = 104   -- 한 줄 48 + 간격 6 + 한 줄 48 (채널 B 모바일 최대 2줄 — NoticeFeed.MobileKeepLines)
        -- 왼쪽 아래: 조이스틱(80~400) 오른쪽, 경험치(4~26) 위 채팅. 가운데 아래는 소환수 줄·대화 단추, 오른쪽 아래는 물약 줄
        self:Place("/ui/ChatHUD/Chat", AlignmentType.BottomLeft, Vector2(0, 0), Vector2(424, 34))
        self:Size("/ui/ChatHUD/Chat", Vector2(480, 128))
        log("[VRF] MobileLayout applied")
    end

    @ExecSpace("ClientOnly")
    method void Place(string path, any align, Vector2 pivot, Vector2 pos)
        local e = _EntityService:GetEntityByPath(path)
        if not isvalid(e) then
            log_warning("[MobileLayout] 없음: " .. path)
            return
        end
        local t = e.UITransformComponent
        t.AlignmentOption = align
        t.Pivot = pivot
        t.anchoredPosition = pos
    end

    @ExecSpace("ClientOnly")
    method void Size(string path, Vector2 size)
        local e = _EntityService:GetEntityByPath(path)
        if isvalid(e) then e.UITransformComponent.RectSize = size end
    end

end
