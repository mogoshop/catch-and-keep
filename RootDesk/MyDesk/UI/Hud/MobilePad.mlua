-- 모바일 패드 (모바일에서만 켜짐, ShadowHUD/MobilePad): 큰 공격 버튼 + 둘레 스킬 4칸 + 망령 질주 단추(배운 뒤) + 벨트 4칸(넣을 물건은 플레이어가 지정) + 그림자 명령(펼침, 배운 것만).
-- 스킬 칸 1~4 = 퀵슬롯 1~4, 큰 버튼 = 5번 칸(비우면 기본 공격, 스킬을 넣으면 그 스킬). PC의 A S D F·우클릭과 같은 칸.
-- I04 (10-29): 큰 버튼에 스킬을 넣은 고급 배치에서만 작은 「기본 공격」 단추(BasicAtk, 제스처 칸 번호 BasicSlot=6)가 공격 단추 오른쪽 위에 나온다 — PC 기본 공격과 같은 길.
--   스킬 칸을 끄는 동안 「취소」 표시(AimCancel)가 나오고, 그 위에서 손가락을 떼면 쓰지 않는다 (마나·재사용·해골 그대로).
-- I04 골편 홀드 반복 (10-30 · 코덱스 계약 · 설정 SkillBook.ShardHold 기본 끔): 골편 칸을 누른 채 ShardHoldDelay가 지나면 같은 시전 길(SkillBook.CastSlot)로
--   서버 재사용 간격마다 다시 보낸다. 골편만 (의식·희생·지면 반복 없음). 메뉴·사망·맵 이동·「취소」 조준·손가락 소유권(앱 전환·칸 바뀜·설정 끔)에서 바로 멈춘다.
--   반복을 한 번이라도 한 손가락은 뗄 때 한 발을 더 쏘지 않는다. 반복을 가진 동안 기본 공격 입력은 PlayerAttack.SubmitBasicInput 입구에서 막는다 (BlocksBasic · 동시 발동 금지)
-- 스킬 편집: 스킬 창의 「스킬 편집」으로 시작(칸마다 +), 칸이나 큰 버튼을 누르면 SkillPicker로 그 칸에 넣을 스킬을 고른다. 「편집 끝」으로 마친다.
-- 11-01 실기기(아이폰 가로) 터치 판정: 손가락이 어느 칸에 들어가는지는 엔진 UI 레이캐스트(단추 네모 RectSize)가 정하고 PadDown이 한 번 더 고른다.
--   ① 큰 단추(Attack 220 네모)는 보이는 원(Ring 지름/2 + PadHitSlack)만 받는다 — 네모 모서리(원 밖)는 버린다.
--   ② 큰 단추 네모 안이어도 작은 단추(기본 공격·둘레 칸) 원 + PadSmallSlack 안이면 작은 단추가 이긴다.
--   ③ 같은 손가락 번호로 새로 눌렀는데 옛 제스처가 남아 있으면(놓음 유실) 옛 제스처는 쏘지 않고 버린다 · UI up은 누른 단추에서 온 것만 받는다.
@Logic
script MobilePad extends Logic

    property string Root = "/ui/ShadowHUD/MobilePad"
    property number PollInterval = 0.1
    property integer TimerId = 0
    property boolean CmdsOpen = false
    property boolean EditMode = false
    property string RenderKey = ""
    property boolean Holding = false
    property number HoldNext = 0
    property integer GestureTouchId = 0
    property integer GestureSlot = 0
    property Vector2 GestureStart = Vector2(0, 0)
    property boolean GestureBasic = false
    property Entity GestureMap = nil
    property number AimDeadZone = 18
    property number AimMaxPx = 200           -- 44-3 A: 이만큼(1920 기준 px) 끌면 땅 찍기 조준이 최대 거리(SkillBook.GroundCastRange)
    property number AimReach = 0             -- 지금 끈 길이 비율 0~1 (데드존 = 0 · AimMaxPx = 1) — SkillBook.GetAimPoint가 땅 찍기 거리로 쓴다
    property boolean PickMode = false        -- 공격 단추가 「줍기」로 바뀐 상태 (10-28 사용자: 손으로 주울 장비 가까이 · 싸우는 중이 아닐 때)
    property number PickCheckAt = 0
    property integer BasicSlot = 6           -- I04: 고급 배치의 작은 기본 공격 단추가 제스처에 쓰는 칸 번호 (스킬 칸 아님)
    property boolean CancelShown = false     -- I04: 스킬 끌기 중 「취소」 표시가 떠 있다
    property boolean CancelHover = false     -- I04: 손가락이 「취소」 표시 위에 있다 (놓으면 쓰지 않는다 · SkillBook.RangePreview가 범위 원을 끈다)
    property number CancelSlack = 16         -- 「취소」 표시 판정 여유 (1920 기준 px, 손가락 끝이 가장자리에 걸칠 때)
    property boolean ShardActive = false     -- I04: 이 손가락이 골편 홀드 반복을 가졌다 (설정 켬 · 골편 칸 · 편집·줍기 아님) — 가진 동안 기본 공격 입력은 막힌다
    property boolean ShardRepeating = false  -- 누른 지 ShardHoldDelay가 지나 반복 중
    property boolean ShardUsed = false       -- 이번 손가락이 반복을 한 번이라도 했다 (뗄 때 한 발 더 쏘지 않는다 · ClearGesture에서만 지운다)
    property number ShardHoldAt = 0          -- 누른 시각
    property number ShardNextAt = 0          -- 다음 반복 요청 시각 (시전 속도 반영 재사용 간격 · 마나 부족·재사용 중이면 보내지 않는다)
    property integer ShardSent = 0           -- 이번 손가락이 보낸 반복 요청 수 ([VRF])
    property number ShardHoldDelay = 0.35    -- 이만큼 누르고 있어야 반복 시작 (짧게 떼면 예전처럼 놓을 때 한 번)
    property string ShardStopReason = ""     -- 마지막 중단 사유: release · menu · edit · dead · map · aim · focus · slot · toggle · owner
    property string GestureSkill = ""        -- B-IN-02: 손가락이 닿을 때 그 칸의 스킬 — 놓을 때 칸 스킬이 바뀌었으면 시전하지 않는다 (편집·기본 공격 제스처 제외)
    property Entity GesturePlayer = nil      -- B-IN-OBS-01: 손가락이 닿을 때의 내 캐릭터 — 바뀌면 골편 반복 소유를 끝낸다
    property integer GestureSource = 0       -- 11-01: 손가락을 받은 단추의 칸 번호 (큰 단추 모서리에서 작은 단추로 넘겨도 5) — UI drag·up은 이 단추에서 온 것만 받는다
    property number GestureSeenAt = 0        -- 11-01: 이 손가락의 마지막 down·drag·hold 시각 — 오래 소식이 없는데 다른 손가락이 누르면 옛 제스처를 버린다
    property number GestureStaleAfter = 1    -- 11-01: 위 「오래」 (초)
    property number PadHitSlack = 6          -- 11-01: 큰 단추 원형 판정 여유 (1920 기준 px) — 반지름 = Attack/Ring 지름/2(117) + 이것
    property number PadSmallSlack = 28       -- 11-01: 큰 단추 네모에 들어온 점이 작은 단추 원(Ring 지름/2) + 이만큼 안이면 작은 단추 우선
    property boolean AttackLabelFit = false   -- 11-02 큰 단추 이름 자동 축소를 한 번 걸었다 (FitAttackLabel)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        if not Environment:IsMobilePlatform() then return end
        -- 기본 공격은 누를 때 시작하고 유지 중 조준을 바꾼다. 스킬은 드래그 후 놓을 때 한 번 발동한다.
        self:BindAimButton(self.Root .. "/Attack", 5)
        self:BindAimButton(self.Root .. "/BasicAtk", self.BasicSlot)
        for i = 1, 4 do self:BindAimButton(self.Root .. "/Skills/S" .. tostring(i), i) end
        _UIKit:Connect(self.Root .. "/BtnSkillEdit", function() self:ToggleEdit() end)
        _UIKit:Connect(self.Root .. "/Dash", function()
            -- 망령 질주: 조이스틱 방향(없으면 바라보는 쪽)으로 (SkillBook.CastMove)
            ---@type SkillBook
            local book = _UIKit:Comp("script.SkillBook")
            if book ~= nil then book:CastMove("wraith_dash") end
        end)
        for i = 1, 4 do
            local index = i
            _UIKit:Connect(self.Root .. "/Potions/Belt" .. tostring(i), function() self:Belt(index) end)
        end
        _UIKit:Connect(self.Root .. "/Shadow/Toggle", function() self:ToggleCmds() end)
        _UIKit:Connect(self.Root .. "/Extract", function() self:Extract() end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Summon", function() self:Command("deploy") end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Recall", function() self:Command("recall") end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Rally", function() self:Command("rally") end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Focus", function() self:Command("focus") end)   -- 44-3 D 「저 적을」: 고른 적에게 모두 집중 (PC는 C 길게)
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds", false)
        _UIKit:SetEnabled(self.Root .. "/BtnSkillEdit", false)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        log("[MobilePad] 시작")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        self:ClearGesture()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "ApplicationService")
    handler HandleApplicationFocusOutEvent(ApplicationFocusOutEvent event)
        -- 앱 전환에서는 미발동 스킬과 반복 입력을 버린다.
        self:StopShardHold("focus")
        self:ClearGesture()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleAimHold(ScreenTouchHoldEvent event)
        -- 스틱을 누른 다른 손가락은 조준에 영향을 주지 않는다.
        self:UpdateGesture(event.TouchId, event.TouchPoint)
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleAimRelease(ScreenTouchReleaseEvent event)
        -- 버튼 밖에서 놓아도 같은 손가락의 캡처를 종료한다.
        self:EndGesture(event.TouchId, event.TouchPoint)
    end

    @ExecSpace("ClientOnly")
    method void BindAimButton(string path, integer slot)
        -- ButtonClick과 중복 연결하지 않아 한 번 놓으면 한 번만 발동한다.
        -- 11-01: 엔진이 고른 단추(slot) → PadDown이 원형 판정·작은 단추 우선으로 실제 칸을 다시 고른다
        _UIKit:ConnectAimControl(path,
            function(event) self:PadDown(slot, event.TouchId, event.TouchPoint) end,
            function(event) self:PadDrag(slot, event.TouchId, event.TouchPoint) end,
            function(event) self:PadUp(slot, event.TouchId, event.TouchPoint) end)
    end

    @ExecSpace("ClientOnly")
    method void PadDown(integer source, integer touchId, Vector2 point)
        -- 11-01 단추 down 입구. 같은 손가락 번호가 이미 제스처를 가졌다 = 그 손가락의 놓음을 못 받았다 → 옛 제스처는 쏘지 않고 버린다
        --   (예전: 남은 큰 단추 제스처가 다음 탭의 up에 끝나 둘레 칸·기본 공격을 눌러도 큰 단추 스킬이 나갔다)
        if self.GestureTouchId ~= 0 and (self:MatchesGesture(touchId) or _UtilLogic.ElapsedSeconds - self.GestureSeenAt > self.GestureStaleAfter) then
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] pad stale gesture cleared slot=%d old=%d new=%d", self.GestureSlot, self.GestureTouchId, touchId)) end
            self:ClearGesture()
        end
        local slot = self:ResolvePadSlot(source, point)
        if slot <= 0 then return end
        self:BeginGesture(slot, touchId, point)
        if self.GestureTouchId == touchId and self.GestureSlot == slot then self.GestureSource = source end
    end

    @ExecSpace("ClientOnly")
    method void PadDrag(integer source, integer touchId, Vector2 point)
        -- 다른 단추의 UI drag는 이 제스처와 상관없다 (같은 손가락의 화면 hold는 HandleAimHold가 따로 받는다)
        if self.GestureTouchId ~= 0 and source ~= self.GestureSource then return end
        self:UpdateGesture(touchId, point)
    end

    @ExecSpace("ClientOnly")
    method void PadUp(integer source, integer touchId, Vector2 point)
        -- 누른 단추의 UI up만 제스처를 끝낸다 (다른 단추의 up으로 남의 스킬이 나가지 않게 · 화면 release는 HandleAimRelease가 받는다)
        if self.GestureTouchId ~= 0 and source ~= self.GestureSource then return end
        self:EndGesture(touchId, point)
    end

    @ExecSpace("ClientOnly")
    method number PadHitRadius(string path)
        -- 단추의 보이는 원 반지름: 테두리(Ring) 그림 지름/2, 없으면 칸 짧은 변/2
        local ring = _UIKit:Get(path .. "/Ring")
        if isvalid(ring) then return ring.UITransformComponent.RectSize.x * 0.5 end
        local e = _UIKit:Get(path)
        if not isvalid(e) then return 0 end
        return math.min(e.UITransformComponent.RectSize.x, e.UITransformComponent.RectSize.y) * 0.5
    end

    @ExecSpace("ClientOnly")
    method number PadDistance(string path, Vector2 point)
        -- 화면 점에서 단추 가운데까지 거리 (1920 기준 px · 피벗 가운데) — 꺼진 단추는 -1
        local e = _UIKit:Get(path)
        if not isvalid(e) or not e.Enable then return -1 end
        local p = _UILogic:ScreenToLocalUIPosition(point, e.UITransformComponent)
        return p:Magnitude()
    end

    @ExecSpace("ClientOnly")
    method integer ResolvePadSlot(integer source, Vector2 point)
        -- 엔진이 고른 단추 → 실제 칸 (0 = 아무 칸도 아님). 작은 단추(둘레 칸·기본 공격)는 입력 네모(96·120)가 보이는 원(104·128)보다 작고
        --   서로 안 겹쳐 엔진 판정 그대로 둔다. 큰 단추는 네모(220)의 모서리가 보이는 원(234) 밖이고 그 모서리가 기본 공격·S3 쪽을 향한다
        if source ~= 5 then
            if not Environment:IsPublishedPlay() then
                local path = source == self.BasicSlot and (self.Root .. "/BasicAtk") or (self.Root .. "/Skills/S" .. tostring(source))
                log(string.format("[VRF] pad hit src=%d slot=%d dist=%.0f r=%.0f", source, source, self:PadDistance(path, point), self:PadHitRadius(path)))
            end
            return source
        end
        local best, bestRatio, bestD, bestR = 0, 0, 0, 0
        local cands = { { self.Root .. "/BasicAtk", self.BasicSlot } }
        for i = 1, 4 do table.insert(cands, { self.Root .. "/Skills/S" .. tostring(i), i }) end
        for _, c in ipairs(cands) do
            local d = self:PadDistance(c[1], point)
            local r = self:PadHitRadius(c[1]) + self.PadSmallSlack
            if d >= 0 and r > 0 and d <= r and (best == 0 or d / r < bestRatio) then
                best, bestRatio, bestD, bestR = c[2], d / r, d, r
            end
        end
        local dA = self:PadDistance(self.Root .. "/Attack", point)
        local rA = self:PadHitRadius(self.Root .. "/Attack") + self.PadHitSlack
        local slot = 0
        if best ~= 0 then slot = best
        elseif dA >= 0 and dA <= rA then slot = 5 end
        if not Environment:IsPublishedPlay() then
            log(string.format("[VRF] pad hit src=5 slot=%d dist=%.0f r=%.0f small=%d sdist=%.0f sr=%.0f", slot, dA, rA, best, bestD, bestR))
        end
        return slot
    end

    @ExecSpace("ClientOnly")
    method boolean MatchesGesture(integer touchId)
        -- UI의 PC 왼쪽 클릭(-1)과 화면 클릭(1)을 같은 입력으로 취급한다.
        if self.GestureTouchId == 0 then return false end
        return touchId == self.GestureTouchId or (self.GestureTouchId == -1 and touchId == 1)
    end

    @ExecSpace("ClientOnly")
    method void BeginGesture(integer slot, integer touchId, Vector2 point)
        -- 하나의 공격 손가락만 캡처한다. 빈/편집 칸도 놓을 때 선택창을 연다.
        local player = _UserService.LocalPlayer
        if slot <= 0 or self.GestureTouchId ~= 0 or not isvalid(player) or player.PlayerComponent.Hp <= 0 or _UIKit:AnyWindowOpen() then return end
        if slot == self.BasicSlot and self.EditMode then return end   -- 기본 공격 단추는 편집할 칸이 아니다 (편집 중에는 숨긴다)
        self.GestureTouchId = touchId
        self.GestureSlot = slot
        self.GestureStart = point
        self.GestureSeenAt = _UtilLogic.ElapsedSeconds
        self.GestureMap = player.CurrentMap
        local book = _UIKit:Comp("script.SkillBook")
        self.GestureBasic = slot == self.BasicSlot or (slot == 5 and not self.EditMode and (book == nil or book:GetSlotSkill(5) == ""))
        self.GestureSkill = (book ~= nil and not self.GestureBasic) and book:GetSlotSkill(slot) or ""
        self.GesturePlayer = player
        local attack = player:GetComponent("script.PlayerAttack")
        if attack ~= nil then attack.LocalAimActive = false end
        if self.GestureBasic then self:AttackDown() end
        -- 뼈 의식 칸: 손가락이 닿은 순간부터 모은다 → 놓으면(EndGesture → Cast → SkillBook.CastSlot) 모은 단계로 나간다 (PC 키 누름과 같은 길 · 기획서 43 결정 1A)
        if not self.EditMode and not self.GestureBasic and book ~= nil and book:GetSlotSkill(slot) == "bone_rite" then book:BeginRiteHold(slot) end
        -- I04 취소 표시: 놓으면 스킬이 나가는 끌기에만 (편집·기본 공격·빈 칸·「줍기」로 바뀐 큰 단추는 아님)
        if not self.EditMode and not self.GestureBasic and book ~= nil and book:GetSlotSkill(slot) ~= "" and not (slot == 5 and self.PickMode) then self:ShowCancel(true) end
        -- I04 골편 홀드 반복 (설정 켬 · 골편 칸만): 누른 채 ShardHoldDelay가 지나면 Poll(ShardTick)이 반복한다
        if not self.EditMode and not self.GestureBasic and book ~= nil and book.ShardHold and book:GetSlotSkill(slot) == "bone_shard" and not (slot == 5 and self.PickMode) then
            self.ShardActive = true
            self.ShardRepeating = false
            self.ShardHoldAt = _UtilLogic.ElapsedSeconds
            self.ShardNextAt = 0
            self.ShardSent = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateGesture(integer touchId, Vector2 point)
        -- 화면 이동량을 단위 방향으로 바꾼다. 중앙 데드존에서는 자동 조준한다.
        if not self:MatchesGesture(touchId) then return end
        self.GestureSeenAt = _UtilLogic.ElapsedSeconds
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMap ~= self.GestureMap or _UIKit:AnyWindowOpen() then
            if self.ShardActive then self:StopShardHold(self:ShardStopCheck()) end
            self:ClearGesture()
            return
        end
        local attack = player:GetComponent("script.PlayerAttack")
        if attack == nil then return end
        local offset = point - self.GestureStart
        local deadZone = math.max(12, self.AimDeadZone * _UILogic.ScreenWidth / 1920)
        attack.LocalAimActive = offset:Magnitude() >= deadZone
        if attack.LocalAimActive then attack.LocalAimDirection = offset:Normalize() end
        -- 끈 길이 비율 (땅 찍기 거리 비례 · 44-3 A): 데드존 끝 0 → AimMaxPx 1
        local full = math.max(deadZone + 1, self.AimMaxPx * _UILogic.ScreenWidth / 1920)
        self.AimReach = math.max(0, math.min(1, (offset:Magnitude() - deadZone) / (full - deadZone)))
        if self.CancelShown then self:SetCancelHover(self:IsOverCancel(point)) end
        if self.ShardActive and self.CancelHover then self:StopShardHold("aim") end   -- 「취소」 위로 끌면 반복을 바로 멈춘다 (다시 밖으로 끌어도 이어 가지 않는다)
    end

    @ExecSpace("ClientOnly")
    method void EndGesture(integer touchId, Vector2 point)
        -- UI up와 screen release가 함께 와도 첫 종료만 발동한다.
        if not self:MatchesGesture(touchId) then return end
        self:UpdateGesture(touchId, point)
        local player = _UserService.LocalPlayer
        if self.GestureTouchId ~= 0 and self.CancelShown and self:IsOverCancel(point) then
            -- I04: 「취소」 위에서 놓음 → 아무것도 쓰지 않는다 (모으던 뼈 의식은 ClearGesture가 버린다)
            self:StopShardHold("aim")
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] mobile aim cancel slot=%d", self.GestureSlot)) end
        elseif self.GestureTouchId ~= 0 and (self.ShardUsed or self.ShardRepeating) then
            -- I04 골편 홀드 반복을 한 손가락: 떼면 반복만 멈춘다 — 놓기 시전으로 한 발을 더 쏘지 않는다 (B-R07)
            self:StopShardHold("release")
        elseif self.GestureTouchId ~= 0 and not self.EditMode and not self.GestureBasic and self:GestureSkillChanged() then
            -- B-IN-02: 누르는 사이 그 칸의 스킬이 바뀌었다 (다음 Poll 전 즉시 놓아도) → 새 스킬을 쓰지 않는다
            self:StopShardHold("slot")
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] mobile aim release skipped slot=%d changed %s", self.GestureSlot, self.GestureSkill)) end
        elseif self.GestureTouchId ~= 0 and isvalid(player) and player.PlayerComponent.Hp > 0 and player.CurrentMap == self.GestureMap and not _UIKit:AnyWindowOpen() and not self.GestureBasic then
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] mobile aim release slot=%d reach=%.2f", self.GestureSlot, self.AimReach)) end
            if self.GestureSlot == 5 then self:Attack() else self:Cast(self.GestureSlot) end
        end
        self:StopShardHold("release")
        self:ClearGesture()
    end

    @ExecSpace("ClientOnly")
    method void ClearGesture()
        -- 앱 전환/창/사망/맵 전환에서 조준과 반복 공격을 함께 버린다.
        self.Holding = false
        self.GestureTouchId = 0
        self.GestureSlot = 0
        self.GestureSource = 0
        self.GestureMap = nil
        self.GestureBasic = false
        self.AimReach = 0
        self:StopShardHold("owner")   -- 이미 멈췄으면 아무 일 없다 (사유는 먼저 멈춘 쪽)
        self.ShardUsed = false
        self.GestureSkill = ""
        self.GesturePlayer = nil
        self:ShowCancel(false)
        local player = _UserService.LocalPlayer
        if isvalid(player) then
            local attack = player:GetComponent("script.PlayerAttack")
            if attack ~= nil then attack.LocalAimActive = false end
            -- 놓기 전에 끊긴 뼈 의식(창·사망·맵 이동·앱 전환)은 버린다. 정상으로 놓았으면 이미 나가서 아무 일 없다
            ---@type SkillBook
            local book = player:GetComponent("script.SkillBook")
            if book ~= nil then book:CancelRiteHold() end
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowCancel(boolean on)
        -- I04 「취소」 표시를 켜고 끈다 (끌 때 강조도 지운다)
        if self.CancelShown == on then return end   -- ClearGesture마다 불리므로 바뀔 때만 그린다
        self.CancelShown = on
        self.CancelHover = false
        _UIKit:SetEnabled(self.Root .. "/AimCancel", on)
        _UIKit:SetColor(self.Root .. "/AimCancel", Color(0.45, 0.08, 0.08, 0.62))
    end

    @ExecSpace("ClientOnly")
    method void SetCancelHover(boolean on)
        -- 손가락이 「취소」 위에 올라가면 진하게 (놓으면 쓰지 않는다는 표시)
        if self.CancelHover == on then return end
        self.CancelHover = on
        _UIKit:SetColor(self.Root .. "/AimCancel", on and Color(0.88, 0.2, 0.18, 0.92) or Color(0.45, 0.08, 0.08, 0.62))
    end

    @ExecSpace("ClientOnly")
    method boolean IsOverCancel(Vector2 point)
        -- 화면 좌표가 「취소」 표시 칸(+여유) 안인가. 칸 피벗이 가운데라 지역 좌표가 ±크기/2 안이면 안이다
        local e = _UIKit:Get(self.Root .. "/AimCancel")
        if not isvalid(e) or not e.Enable then return false end
        local t = e.UITransformComponent
        local p = _UILogic:ScreenToLocalUIPosition(point, t)
        local half = t.RectSize * 0.5
        return math.abs(p.x) <= half.x + self.CancelSlack and math.abs(p.y) <= half.y + self.CancelSlack
    end

    -- ───────── 동작 ─────────

    @ExecSpace("ClientOnly")
    method void ToggleEdit()
        -- 「편집 끝」 버튼: 편집 모드를 끝낸다 (편집 모드에서만 보인다)
        if _UIKit:AnyWindowOpen() then self:ClearGesture() return end
        self:SetEditMode(not self.EditMode)
    end

    @ExecSpace("ClientOnly")
    method void StartEdit()
        -- 스킬 창의 「스킬 편집」: 창이 닫힌 뒤 패드 칸마다 +를 띄운다
        if not Environment:IsMobilePlatform() then return end
        self:SetEditMode(true)
        _UXFeedback:Show("스킬 편집", "+가 붙은 칸을 눌러 넣을 스킬을 고르세요\n끝나면 「편집 끝」", _GameData:GetUiIcon("icon_skill"))
    end

    @ExecSpace("ClientOnly")
    method void SetEditMode(boolean on)
        -- 편집 모드: 칸마다 + 표시, 누르는 칸에 스킬을 넣는다. 「편집 끝」 버튼은 이때만 보인다
        self:ClearGesture()
        self.EditMode = on
        _UIKit:SetText(self.Root .. "/BtnSkillEdit", "편집 끝")
        _UIKit:SetEnabled(self.Root .. "/BtnSkillEdit", on)
        _UIKit:SetEnabled(self.Root .. "/Attack/Edit", on)
        for i = 1, 4 do
            _UIKit:SetEnabled(self.Root .. "/Skills/S" .. tostring(i) .. "/Edit", on)
            _UIKit:SetEnabled(self.Root .. "/Potions/Belt" .. tostring(i) .. "/Edit", on)
        end
        self.RenderKey = ""
        log("[VRF] MobilePad edit=" .. tostring(on))
    end

    @ExecSpace("ClientOnly")
    method void AttackDown()
        -- 누름: 바로 한 번. 기본 공격이면 누르고 있는 동안 반복 (Poll에서). 「줍기」면 한 번만
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        local basicBtn = self.GestureSlot == self.BasicSlot
        if basicBtn then
            self:BasicAttack()   -- I04 고급 배치의 기본 공격 단추: 큰 단추의 스킬·「줍기」와 상관없이 늘 기본 공격
        else
            self:Attack()
            if self.PickMode then return end
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        self.Holding = not self.EditMode and (basicBtn or book == nil or book:GetSlotSkill(5) == "")
        self.HoldNext = _UtilLogic.ElapsedSeconds + self:AttackInterval()
    end

    @ExecSpace("ClientOnly")
    method number AttackInterval()
        -- 공격 속도(ias)가 반영된 기본 공격 간격
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local base = _GameData.baseAttackInterval
        if st ~= nil then return st:GetAttackInterval(base) end
        return base
    end

    @ExecSpace("ClientOnly")
    method void HoldTick()
        -- 누르고 있는 동안 간격마다 공격 (손을 떼면 Holding = false)
        local player = _UserService.LocalPlayer
        local book = _UIKit:Comp("script.SkillBook")
        local basicBtn = self.GestureSlot == self.BasicSlot
        if self.ShardActive then self.Holding = false return end   -- I04: 골편 홀드 반복이 손가락을 가졌다 (기본 공격과 동시 발동 금지)
        if not isvalid(player) or player.PlayerComponent.Hp <= 0 or self.EditMode or _UIKit:AnyWindowOpen() or (not basicBtn and book ~= nil and book:GetSlotSkill(5) ~= "") then self.Holding = false return end
        if not self.Holding or _UtilLogic.ElapsedSeconds < self.HoldNext then return end
        self.HoldNext = _UtilLogic.ElapsedSeconds + self:AttackInterval()
        if basicBtn then self:BasicAttack() else self:Attack() end
    end

    @ExecSpace("ClientOnly")
    method string ShardStopCheck()
        -- I04 골편 홀드 반복을 멈출 사유 ("" = 계속). 메뉴(창·안내 창) · 편집 · 사망 · 맵 이동 · 「취소」 조준 · 손가락 소유권(뗌·칸 바뀜·설정 끔·큰 단추 줍기·기본 공격 반복)
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player ~= self.GesturePlayer then return "owner" end
        if player.PlayerComponent.Hp <= 0 then return "dead" end
        if player.CurrentMap ~= self.GestureMap then return "map" end
        if _UIKit:AnyWindowShown() or _UIKit:AnyWindowOpen() then return "menu" end
        if self.EditMode then return "edit" end
        if self.CancelHover then return "aim" end
        if self.GestureTouchId == 0 then return "owner" end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil or not book.ShardHold then return "toggle" end
        if book:GetSlotSkill(self.GestureSlot) ~= "bone_shard" then return "slot" end
        if (self.GestureSlot == 5 and self.PickMode) or self.Holding then return "owner" end
        return ""
    end

    @ExecSpace("ClientOnly")
    method boolean GestureSkillChanged()
        -- B-IN-02: 이 손가락이 누른 칸의 스킬이 닿은 때와 다른가 (칸 바꿈·초기화로 비거나 다른 스킬이 들어옴)
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return self.GestureSkill ~= "" end
        return book:GetSlotSkill(self.GestureSlot) ~= self.GestureSkill
    end

    @ExecSpace("ClientOnly")
    method void StopShardHold(string reason)
        -- 골편 홀드 반복을 끝낸다 (이미 끝났으면 아무 일 없다). 앞으로 보낼 반복 요청이 없어진다 — 이미 보낸 요청은 서버 규칙대로 확정되거나 거절된다
        if not self.ShardActive then return end
        if self.ShardRepeating then self.ShardUsed = true end
        self.ShardActive = false
        self.ShardRepeating = false
        self.ShardNextAt = 0
        self.ShardStopReason = reason
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] shard hold stop reason=%s sent=%d slot=%d", reason, self.ShardSent, self.GestureSlot)) end
    end

    @ExecSpace("ClientOnly")
    method boolean BlocksBasic()
        -- 기본 공격 입력 단일 소유권 (PlayerAttack.SubmitBasicInput 입구): 골편 홀드 반복이 손가락을 가진 동안 기본 공격(작은 단추·큰 단추·네이티브·탭 접근)은 나가지 않는다
        return self.ShardActive
    end

    @ExecSpace("ClientOnly")
    method void ShardTick()
        -- I04 골편 홀드 반복 (Poll마다): 같은 손가락·같은 칸을 누르고 있는 동안 골편 칸 시전(SkillBook.CastSlot → RequestCast → 서버 Cast)을 재사용 간격마다 다시 보낸다.
        -- 서버 마나·재사용·대기 중 시전(PendingCasts·CastEpoch) 검사는 그대로. 마나가 모자라거나 재사용 중이면 보내지 않고 기다린다 (요청·경고 남발 없음 · 별도 자동 쿨다운 없음)
        if not self.ShardActive then return end
        local reason = self:ShardStopCheck()
        if reason ~= "" then
            self:StopShardHold(reason)
            return
        end
        local now = _UtilLogic.ElapsedSeconds
        if now - self.ShardHoldAt < self.ShardHoldDelay or now < self.ShardNextAt then return end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        if not self.ShardRepeating then
            self.ShardRepeating = true
            self.ShardUsed = true
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] shard hold start slot=%d touch=%d", self.GestureSlot, self.GestureTouchId)) end
        end
        ---@type PlayerStats
        local stats = _UIKit:Comp("script.PlayerStats")
        if stats ~= nil and stats.Mana < book:GetManaCost("bone_shard", book:GetPowerLevel("bone_shard")) then return end
        if book:CooldownLeft("bone_shard") > 0.05 then return end
        local def = _SkillData:Get("bone_shard")
        local cd = (def ~= nil and def.cooldown or 0.5) * (stats ~= nil and stats:GetCastCooldownMult() or 1)
        self.ShardNextAt = now + math.max(0.1, cd)
        self.ShardSent = self.ShardSent + 1
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] shard hold cast n=%d slot=%d", self.ShardSent, self.GestureSlot)) end
        book:CastSlot(self.GestureSlot)
    end

    @ExecSpace("ClientOnly")
    method void UpdatePickMode(Entity player)
        -- 0.25초마다: 손으로 주울 장비(일반·마법)가 mobilePickRadius 안에 있고, mobilePickSafeRadius 안에 살아 있는 몬스터가 없으면 공격 단추 = 줍기
        local now = _UtilLogic.ElapsedSeconds
        if now < self.PickCheckAt then return end
        self.PickCheckAt = now + 0.25
        local want = false
        -- 가방이 가득 차면 주울 수 없으니 공격 단추 그대로 (줍기로 남아 싸우지 못하는 일 없게)
        ---@type PlayerInventory
        local inv = isvalid(player) and player:GetComponent("script.PlayerInventory") or nil
        local bagFull = inv ~= nil and inv.BagDigest ~= "" and select(2, string.gsub(inv.BagDigest, ";", "")) + 1 >= inv.BagSize
        if isvalid(player) and isvalid(player.CurrentMap) and not self.EditMode and not bagFull then
            local p = _Util:Pos2(player)
            local uid = player.PlayerComponent.UserId
            for _, d in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.LootDrop", false)) do
                ---@type LootDrop
                local drop = d
                if drop.Kind == "item" and drop.Rarity < 2 and not drop.Taken and (drop.OwnerUserId == "" or drop.OwnerUserId == uid)
                    and (_Util:Pos2(drop.Entity) - p):Magnitude() <= _GameData.mobilePickRadius then
                    want = true
                    break
                end
            end
            if want then
                for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.Monster", true)) do
                    ---@type Monster
                    local m = c
                    if isvalid(m.Entity) and m.Entity.Enable and not m.IsDead and (_Util:Pos2(m.Entity) - p):Magnitude() <= _GameData.mobilePickSafeRadius then
                        want = false
                        break
                    end
                end
            end
        end
        if want == self.PickMode then return end
        self.PickMode = want
        if want then
            -- 「줍기」로 바뀌는 것은 큰 공격 단추뿐: 그 단추로 누르던 반복만 멈춘다. 고급 배치의 기본 공격 단추(BasicSlot) 홀드는 그대로 (I04-R01)
            if self.GestureSlot ~= self.BasicSlot then self.Holding = false end
            _UIKit:SetIcon(self.Root .. "/Attack/Icon", _GameData:GetUiIcon("icon_pickup"))
            _UIKit:SetText(self.Root .. "/Attack/Label", "줍기")
        else
            self.RenderKey = ""   -- 다음 Poll에서 공격·스킬 아이콘으로 되돌린다
        end
        log("[VRF] mobile attack button pick=" .. tostring(want))
    end

    @ExecSpace("ClientOnly")
    method void Attack()
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        -- 「줍기」로 바뀐 공격 단추: 주변 장비를 줍는다 (10-28 사용자)
        if self.PickMode and not self.EditMode then
            self.Holding = false
            local player = _UserService.LocalPlayer
            ---@type PlayerInventory
            local inv = isvalid(player) and player:GetComponent("script.PlayerInventory") or nil
            if inv ~= nil then inv:RequestPickNearby() end
            log("[VRF] mobile pickup pressed")
            return
        end
        -- 편집 모드면 큰 버튼(5번 칸)에 넣을 스킬 고르기. 스킬이 들어 있으면 그 스킬, 아니면 기본 공격
        if self.EditMode then
            _SkillPicker:Open(5)
            return
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book ~= nil and book:GetSlotSkill(5) ~= "" then
            book:CastSlot(5)
            return
        end
        self:BasicAttack()
    end

    @ExecSpace("ClientOnly")
    method void BasicAttack()
        -- 기본 공격 한 번: 대상 선택과 방향은 서버 PlayerAttack에서 한 번만 결정한다 (PC ClickControl과 같은 길)
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.PlayerComponent.Hp <= 0 then self.Holding = false return end
        local attack = player:GetComponent("script.PlayerAttack")
        if attack ~= nil then attack:SubmitBasicInput() end
        player.PlayerControllerComponent:ActionAttack()
    end

    @ExecSpace("ClientOnly")
    method void Cast(integer slot)
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        -- 빈 칸이면 스킬 편집을 연다 (무엇을 넣을지 바로 고르게)
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        if self.EditMode or book:GetSlotSkill(slot) == "" then
            _SkillPicker:Open(slot)
            return
        end
        book:CastSlot(slot)
    end

    @ExecSpace("ClientOnly")
    method void Belt(integer index)
        -- 벨트 칸: 편집 중이거나 빈 칸이면 넣을 물건 고르기, 아니면 사용
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if belt == nil then return end
        if self.EditMode or belt:SlotKind(index) == "" then
            _SkillPicker:OpenBelt(index)
            return
        end
        belt:RequestUseSlot(index)
    end

    @ExecSpace("ClientOnly")
    method void Extract()
        -- 손 닿는 거리의 내 혼을 추출 (판정은 서버)
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        if extractor ~= nil then extractor:TryExtractNearby() end
    end

    @ExecSpace("ClientOnly")
    method void ToggleCmds()
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        self.CmdsOpen = not self.CmdsOpen
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds", self.CmdsOpen)
    end

    @ExecSpace("ClientOnly")
    method void Command(string action)
        if _UIKit:AnyWindowOpen() then self.Holding = false return end
        -- 단축키(Z X C)와 같은 서버 요청. 누르면 펼친 버튼은 접는다
        ---@type ShadowCommander
        local cmd = _UIKit:Comp("script.ShadowCommander")
        if cmd == nil then return end
        if action == "deploy" then cmd:RequestDeploy("")
        elseif action == "recall" then cmd:RequestRecall("")
        elseif action == "focus" then cmd:TryFocus()
        else cmd:RequestRally() end
        self.CmdsOpen = false
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds", false)
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void FitAttackLabel()
        -- 11-02 (기획 54 §1-1 · 56 R5): 큰 단추 이름 칸 120px · 28px 고정이면 「앰플리파이」(5em)·7자 메인이 칸 밖으로 나갔다 →
        --   글자 자동 축소(최대 28 · 최소 18) 한 번. 18px × 6.28em(공백 포함 7자) ≈ 113px < 120px · 「공격」「줍기」는 28 그대로
        if self.AttackLabelFit then return end
        local e = _UIKit:Get(self.Root .. "/Attack/Label")
        if not isvalid(e) or not isvalid(e.TextGUIRendererComponent) then return end
        local t = e.TextGUIRendererComponent
        t.MaxSize = 28
        t.MinSize = 18
        t.BestFit = true
        self.AttackLabelFit = true
        if not Environment:IsPublishedPlay() then log("[VRF] mobile attack label bestfit 18~28 clip 7") end
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 안내 창(웨이포인트 Passive)이 떠 있어도 패드·벨트를 숨긴다 (10-29 45 §2-6 #7: m-07에서 스킬 단추·벨트가 창 옆에 남아 오탭) — 그때는 X·바깥으로 닫는다
        local windowOpen = _UIKit:AnyWindowShown()
        local player = _UserService.LocalPlayer
        if self.ShardActive then
            local reason = self:ShardStopCheck()
            if reason ~= "" then self:StopShardHold(reason) end
        end
        if self.GestureTouchId ~= 0 and (windowOpen or not isvalid(player) or player.PlayerComponent.Hp <= 0 or player.CurrentMap ~= self.GestureMap) then self:ClearGesture() end
        local root = _UIKit:Get(self.Root)
        if isvalid(root) and root.Enable == windowOpen then log("[VRF] mobile pad shown=" .. tostring(not windowOpen)) end
        _UIKit:SetEnabled(self.Root, not windowOpen)
        if windowOpen then return end
        -- 스킬 아이콘·물약 개수·그림자 버튼(배운 것만). 바뀌었을 때만 그린다
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if book == nil or belt == nil then return end
        self:UpdatePickMode(player)
        self:HoldTick()
        self:ShardTick()
        -- 혼 추출 버튼: 손 닿는 거리에 내 혼이 있을 때만 (10-24: 그림자 소환을 배우지 않아도)
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        local canExtract = extractor ~= nil and isvalid(player)   -- 혼 추출은 Lv1부터 (10-24)
            and extractor:FindNearestSoul(_Util:Pos2(player), _ShadowConfig:GetExtractReach()) ~= nil
        _UIKit:SetEnabled(self.Root .. "/Extract", canExtract and not _UIKit:AnyWindowOpen())
        -- 쿨다운 덮개는 매번 (시간이 흐르므로)
        for i = 1, 4 do
            _UIKit:ShowCooldown(self.Root .. "/Skills/S" .. tostring(i) .. "/Cd", book, book:GetSlotSkill(i))
            _UIKit:ShowRiteStages(self.Root .. "/Skills/S" .. tostring(i) .. "/Stage", book, book:GetSlotSkill(i))   -- 뼈 의식 단계별 재사용 (44 §4-1 B)
        end
        _UIKit:ShowCooldown(self.Root .. "/Attack/Cd", book, book:GetSlotSkill(5))
        _UIKit:ShowRiteStages(self.Root .. "/Attack/Stage", book, book:GetSlotSkill(5))
        -- 망령 질주 단추: 배운 뒤에만, 남은 횟수는 「여분 숨」으로 2번 이상일 때만 숫자
        local dash = book:GetLevel("wraith_dash") > 0
        _UIKit:SetEnabled(self.Root .. "/Dash", dash)
        if dash then
            _UIKit:ShowCooldown(self.Root .. "/Dash/Cd", book, "wraith_dash")
            _UIKit:SetText(self.Root .. "/Dash/Count", book:GetLevel("dash_charge") > 0 and tostring(book.DashShown) or "")
        end
        local summon = book:GetLevel("shadow_summon") > 0
        local rally = book:GetLevel("rally") > 0
        local key = book.Slots .. "#" .. book.RightSkill .. "#" .. tostring(self.EditMode) .. "#" .. belt.Layout .. "#" .. tostring(belt.HpPot) .. "#" .. tostring(belt.MpPot) .. "#" .. (_UIKit:Comp("script.PlayerInventory") ~= nil and _UIKit:Comp("script.PlayerInventory").BagDigest or "") .. "#" .. tostring(belt:CountOf("tp")) .. "#" .. tostring(summon) .. tostring(rally)
        if key == self.RenderKey then return end
        self.RenderKey = key
        for i = 1, 4 do
            local id = book:GetSlotSkill(i)
            local icon = ""
            if id ~= "" then icon = _SkillData:Get(id).icon end
            _UIKit:SetIcon(self.Root .. "/Skills/S" .. tostring(i) .. "/Icon", icon)
        end
        -- 큰 버튼: 스킬이 들어 있으면 그 아이콘·이름, 아니면 칼·공격 (줍기로 바뀌어 있으면 그대로)
        local main = book:GetSlotSkill(5)
        self:FitAttackLabel()
        if self.PickMode then
            _UIKit:SetIcon(self.Root .. "/Attack/Icon", _GameData:GetUiIcon("icon_pickup"))
            _UIKit:SetText(self.Root .. "/Attack/Label", "줍기")
        elseif main ~= "" then
            local def = _SkillData:Get(main)
            _UIKit:SetIcon(self.Root .. "/Attack/Icon", def.icon)
            _UIKit:SetText(self.Root .. "/Attack/Label", _UIKit:Clip(def.name, 7))
        else
            _UIKit:SetIcon(self.Root .. "/Attack/Icon", _GameData:GetUiIcon("icon_sword"))
            _UIKit:SetText(self.Root .. "/Attack/Label", "공격")
        end
        -- I04 고급 배치: 큰 단추에 스킬이 있으면 작은 기본 공격 단추를 따로 (편집 중에는 숨김)
        _UIKit:SetEnabled(self.Root .. "/BasicAtk", main ~= "" and not self.EditMode)
        for i = 1, 4 do
            local path = self.Root .. "/Potions/Belt" .. tostring(i)
            local view = belt:SlotView(i)   -- 물약은 다음에 마실 등급(낮은 것부터)의 그림·개수
            _UIKit:SetIcon(path .. "/Icon", view.icon)
            _UIKit:SetColor(path .. "/Icon", view.count > 0 and Color(1, 1, 1, 1) or Color(1, 1, 1, 0.35))
            _UIKit:SetText(path .. "/Count", view.count < 0 and "" or tostring(view.count))
        end
        -- 그림자 명령 버튼은 그림자 소환을 배운 뒤에만, 집결은 「집결」을 배운 뒤에만
        _UIKit:SetEnabled(self.Root .. "/Shadow", summon)
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds/Rally", rally)
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds/Focus", rally)
    end

end
