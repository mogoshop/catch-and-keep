-- 모바일 패드 (모바일에서만 켜짐, ShadowHUD/MobilePad): 큰 공격 버튼 + 둘레 스킬 4칸 + 생명·마나 물약 + 그림자 명령(펼침, 배운 것만).
-- 스킬 칸 1~4 = 퀵슬롯 1~4, 큰 버튼 = 5번 칸(비우면 기본 공격, 스킬을 넣으면 그 스킬). PC의 A S D F·우클릭과 같은 칸.
-- 스킬 편집: 누르면 편집 모드(칸마다 +), 칸이나 큰 버튼을 누르면 SkillPicker로 그 칸에 넣을 스킬을 고른다.
@Logic
script MobilePad extends Logic

    property string Root = "/ui/ShadowHUD/MobilePad"
    property number PollInterval = 0.1
    property integer TimerId = 0
    property boolean CmdsOpen = false
    property boolean EditMode = false
    property string RenderKey = ""
    property boolean Holding = false
    property number HoldNext = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        if not Environment:IsMobilePlatform() then return end
        -- 큰 버튼: 누르는 순간 한 번, 누르고 있으면 공격 간격마다 계속 (기본 공격일 때만)
        _UIKit:ConnectHold(self.Root .. "/Attack", function() self:AttackDown() end, function() self.Holding = false end)
        for i = 1, 4 do
            local slot = i
            _UIKit:Connect(self.Root .. "/Skills/S" .. tostring(i), function() self:Cast(slot) end)
        end
        _UIKit:Connect(self.Root .. "/BtnSkillEdit", function() self:ToggleEdit() end)
        _UIKit:Connect(self.Root .. "/Potions/Hp", function() self:Potion("hp") end)
        _UIKit:Connect(self.Root .. "/Potions/Mp", function() self:Potion("mp") end)
        _UIKit:Connect(self.Root .. "/Shadow/Toggle", function() self:ToggleCmds() end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Summon", function() self:Command("deploy") end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Recall", function() self:Command("recall") end)
        _UIKit:Connect(self.Root .. "/Shadow/Cmds/Rally", function() self:Command("rally") end)
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds", false)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        log("[MobilePad] 시작")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        self.Holding = false
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "ApplicationService")
    handler HandleApplicationFocusOutEvent(ApplicationFocusOutEvent event)
        self.Holding = false
    end

    -- ───────── 동작 ─────────

    @ExecSpace("ClientOnly")
    method void ToggleEdit()
        -- 편집 모드: 칸마다 + 표시, 누르는 칸에 스킬을 넣는다. 다시 누르면 끝
        self.Holding = false
        self.EditMode = not self.EditMode
        _UIKit:SetText(self.Root .. "/BtnSkillEdit", self.EditMode and "편집 끝" or "스킬 편집")
        _UIKit:SetEnabled(self.Root .. "/Attack/Edit", self.EditMode)
        for i = 1, 4 do _UIKit:SetEnabled(self.Root .. "/Skills/S" .. tostring(i) .. "/Edit", self.EditMode) end
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void AttackDown()
        -- 누름: 바로 한 번. 기본 공격이면 누르고 있는 동안 반복 (Poll에서)
        self:Attack()
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        self.Holding = not self.EditMode and (book == nil or book:GetSlotSkill(5) == "")
        self.HoldNext = _UtilLogic.ElapsedSeconds + self:AttackInterval()
    end

    @ExecSpace("ClientOnly")
    method number AttackInterval()
        -- 공격 속도(ias)가 반영된 기본 공격 간격
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local base = _GameData.baseAttackInterval
        if st ~= nil then return st:GetAttackInterval(base) end
        return base
    end

    @ExecSpace("ClientOnly")
    method void HoldTick()
        -- 누르고 있는 동안 간격마다 공격 (손을 떼면 Holding = false)
        local player = _UserService.LocalPlayer
        local book = _UIKit:Comp("script.SkillBook")
        if not isvalid(player) or player.PlayerComponent.Hp <= 0 or self.EditMode or (book ~= nil and book:GetSlotSkill(5) ~= "") then self.Holding = false return end
        if not self.Holding or _UtilLogic.ElapsedSeconds < self.HoldNext then return end
        self.HoldNext = _UtilLogic.ElapsedSeconds + self:AttackInterval()
        self:Attack()
    end

    @ExecSpace("ClientOnly")
    method void Attack()
        -- 편집 모드면 큰 버튼(5번 칸)에 넣을 스킬 고르기. 스킬이 들어 있으면 그 스킬, 아니면 기본 공격
        if self.EditMode then
            _SkillPicker:Open(5)
            return
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book ~= nil and book:GetSlotSkill(5) ~= "" then
            book:CastSlot(5)
            return
        end
        -- 대상 선택과 방향은 서버 PlayerAttack에서 한 번만 결정한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.PlayerComponent.Hp <= 0 then self.Holding = false return end
        player.PlayerControllerComponent:ActionAttack()
    end

    @ExecSpace("ClientOnly")
    method void Cast(integer slot)
        -- 빈 칸이면 스킬 편집을 연다 (무엇을 넣을지 바로 고르게)
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        if self.EditMode or book:GetSlotSkill(slot) == "" then
            _SkillPicker:Open(slot)
            return
        end
        book:CastSlot(slot)
    end

    @ExecSpace("ClientOnly")
    method void Potion(string kind)
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if belt ~= nil then belt:RequestUsePotion(kind) end
    end

    @ExecSpace("ClientOnly")
    method void ToggleCmds()
        self.CmdsOpen = not self.CmdsOpen
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds", self.CmdsOpen)
    end

    @ExecSpace("ClientOnly")
    method void Command(string action)
        -- 단축키(Z X C)와 같은 서버 요청. 누르면 펼친 버튼은 접는다
        ---@type ShadowCommander
        local cmd = _UIKit:Comp("script.ShadowCommander")
        if cmd == nil then return end
        if action == "deploy" then cmd:RequestDeploy("")
        elseif action == "recall" then cmd:RequestRecall("")
        else cmd:RequestRally() end
        self.CmdsOpen = false
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds", false)
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 스킬 아이콘·물약 개수·그림자 버튼(배운 것만). 바뀌었을 때만 그린다
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if book == nil or belt == nil then return end
        self:HoldTick()
        -- 쿨다운 덮개는 매번 (시간이 흐르므로)
        for i = 1, 4 do _UIKit:ShowCooldown(self.Root .. "/Skills/S" .. tostring(i) .. "/Cd", book, book:GetSlotSkill(i)) end
        _UIKit:ShowCooldown(self.Root .. "/Attack/Cd", book, book:GetSlotSkill(5))
        local summon = book:GetLevel("shadow_summon") > 0
        local rally = book:GetLevel("rally") > 0
        local key = book.Slots .. "#" .. book.RightSkill .. "#" .. tostring(self.EditMode) .. "#" .. tostring(belt.HpPot) .. "#" .. tostring(belt.MpPot) .. "#" .. tostring(summon) .. tostring(rally)
        if key == self.RenderKey then return end
        self.RenderKey = key
        for i = 1, 4 do
            local id = book:GetSlotSkill(i)
            local icon = ""
            if id ~= "" then icon = _SkillData:Get(id).icon end
            _UIKit:SetIcon(self.Root .. "/Skills/S" .. tostring(i) .. "/Icon", icon)
        end
        -- 큰 버튼: 스킬이 들어 있으면 그 아이콘·이름, 아니면 칼·공격
        local main = book:GetSlotSkill(5)
        if main ~= "" then
            local def = _SkillData:Get(main)
            _UIKit:SetIcon(self.Root .. "/Attack/Icon", def.icon)
            _UIKit:SetText(self.Root .. "/Attack/Label", _UIKit:Clip(def.name, 5))
        else
            _UIKit:SetIcon(self.Root .. "/Attack/Icon", _GameData:GetUiIcon("icon_sword"))
            _UIKit:SetText(self.Root .. "/Attack/Label", "공격")
        end
        _UIKit:SetText(self.Root .. "/Potions/Hp/Count", tostring(belt.HpPot))
        _UIKit:SetText(self.Root .. "/Potions/Mp/Count", tostring(belt.MpPot))
        -- 그림자 명령 버튼은 그림자 소환을 배운 뒤에만, 집결은 「집결」을 배운 뒤에만
        _UIKit:SetEnabled(self.Root .. "/Shadow", summon)
        _UIKit:SetEnabled(self.Root .. "/Shadow/Cmds/Rally", rally)
    end

end
