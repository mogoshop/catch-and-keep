-- 소환수 종류별 초상 하나 + 「×N」·합친 생명·내뿜는 오오라 아이콘 (해골 3마리 = 해골 초상 ×3). 다른 창에서는 숨긴다.
-- 공격·추격 같은 행동 글자와 오오라 이름 글자는 뺐다 (10-24 사용자) — 오오라는 칸 오른쪽 위 작은 아이콘.
-- 위치: PC는 생명 오브 위(왼쪽 아래), 모바일은 의뢰 추적·일지 버튼과 겹치지 않게 가운데 아래 생명·마나 오브 위.
@Logic
script CompanionHUD extends Logic

    property string Strip = "/ui/CompanionHUD/SafeArea/Strip"
    property integer Page = 0
    property integer TimerId = 0
    property integer UnitCount = 0
    property string LastMapId = ""
    property table Units = {}
    property table LossHints = {}

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 페이지 버튼을 연결하고 낮은 주기로 소환수의 동기화된 정보만 읽는다.
        self.Page = 0
        self.Units = {}
        self.LossHints = {}
        _UIKit:SetEnabled(self.Strip, false)
        local strip = _UIKit:Get(self.Strip)
        if isvalid(strip) then
            local t = strip.UITransformComponent
            if Environment:IsMobilePlatform() then
                t.AlignmentOption = AlignmentType.BottomCenter
                t.Pivot = Vector2(0.5, 0)
                t.anchoredPosition = Vector2(-60, 172)   -- 가운데 아래: 경험치·채팅 위, 대화 버튼 아래. 왼쪽으로 조금 — 오른쪽 혼 추출 단추와 안 겹치게 (docs/ui/mobile-layout.md)
            else
                -- PC: 채팅창(왼쪽 아래 16~536 · 210~510) 오른쪽, 아래 메뉴 줄(150~234) 위 (예전 (24,236)은 채팅창 위에 겹쳤다 — 10-13)
                t.anchoredPosition = Vector2(550, 244)
            end
        end
        _UIKit:Connect(self.Strip .. "/Page", function() self:NextPage() end)
        for i = 1, 4 do
            local index = i
            _UIKit:Connect(self.Strip .. "/Unit" .. tostring(i) .. "/Frame", function() self:PickCard(index) end)
        end
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
        log("[VRF] CompanionHUD ready pageSize=4")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 반복 갱신과 이전 세션의 엔티티 참조를 정리한다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self.Units = {}
        self.UnitCount = 0
        self.LossHints = {}
        _UIKit:SetEnabled(self.Strip, false)
    end

    @ExecSpace("Client")
    method void NotifyLoss(Entity owner, string kind, string mapId)
        -- 종류별 첫 사망에만 아이콘과 복구 방법을 알린다. 같은 종류의 반복 알림을 쌓지 않는다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player ~= owner or not _Util:IsAlive(player) or not isvalid(player.CurrentMap) then return end
        if player.CurrentMap.Id ~= mapId or self.LossHints[kind] then return end
        local name = ""
        local detail = ""
        if kind == "skeleton" then
            name = "해골 전사"
            detail = "몬스터가 남긴 혼을 조준해\n해골 전사를 다시 소환하세요."
        elseif kind == "mage" then
            name = "해골 마법사"
            detail = "몬스터가 남긴 혼을 조준해\n해골 마법사를 다시 소환하세요."
        elseif kind == "revive" then
            name = "되살린 몬스터"
            detail = "다른 혼을 조준해\n되살림을 다시 사용하세요."
        elseif kind == "shadow" then
            name = "그림자"
            detail = "그림자는 보관함에 남아 있습니다.\n회복 후 메뉴 → 그림자에서 다시 소환하세요."
        else return end
        self.LossHints[kind] = true
        _UXFeedback:Show(name .. "가 쓰러졌습니다", detail, self:FallbackIcon(kind))
        log("[VRF] companion loss hint kind=" .. kind)
    end

    @ExecSpace("ClientOnly")
    method void PickCard(integer index)
        -- 44-3 B 대상 고르기 (모바일 · PC 공용): 그림자 칸을 누르면 그 칸의 그림자(×N이면 첫 개체)를 고른다 — 다시 누르면 풀림.
        --   해골·마법사·되살림 칸은 승격·희생 대상이 아니라 안내만
        if not _UIKit:CanUseGameplayInput() then return end
        local g = self.Units[self.Page * 4 + index]
        if g == nil then return end
        if g.kind ~= "shadow" or not isvalid(g.entity) then
            _HudMain:ShowWarn("그림자만 고를 수 있습니다")
            return
        end
        ---@type ShadowCommander
        local cmd = _UIKit:Comp("script.ShadowCommander")
        if cmd == nil then return end
        cmd:RequestPickShadow(g.entity)
        log("[VRF] companion card pick " .. g.entity.Name)
    end

    @ExecSpace("ClientOnly")
    method void NextPage()
        -- 소환수 수가 줄면 남은 페이지 범위 안에서만 순환한다.
        local pages = math.max(1, math.ceil(self.UnitCount / 4))
        self.Page = (self.Page + 1) % pages
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 내 소유·현재 맵·생존 조건을 모두 만족하는 실제 소환수만 표시한다.
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.CurrentMap) or not _Util:IsAlive(p) then
            self.Units = {}
            self.UnitCount = 0
            _UIKit:SetEnabled(self.Strip, false)
            return
        end
        if p.CurrentMap.Id ~= self.LastMapId then self.LastMapId = p.CurrentMap.Id self.Page = 0 end
        -- 같은 종류는 한 칸으로 묶는다: 수·생명 합계·가장 약한 개체의 체력 비율·승격 여부 · 고른 그림자(44-3 B)가 든 칸
        local groups = {}
        local byKind = {}
        ---@type ShadowCommander
        local cmd = p:GetComponent("script.ShadowCommander")
        local picked = (cmd ~= nil and isvalid(cmd.PickedLocal) and _UtilLogic.ElapsedSeconds < cmd.PickedLocalUntil) and cmd.PickedLocal or nil
        for _, c in ipairs(p.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            ---@type ShadowUnit
            local u = c
            if isvalid(u.Entity) and u.Entity.Enable and u.OwnerPlayer == p and u.Hp > 0 and u.MaxHp > 0 then
                -- 그림자는 원본 몬스터별로 따로 묶는다 (자칼·전갈이 한 칸에 섞이지 않게). 엔티티 이름 = Shadow_원본id
                local src = string.match(u.Entity.Name, "^Shadow_(.+)$") or ""
                -- 해골 전사는 필드 해골 전사(skel_warrior)의 초상으로 (발밑 피벗 프레임 그림을 그대로 쓰면 칸 위로 작게 밀렸다 — 10-13)
                if src == "" and u.Kind == "skeleton" then src = self:SkeletonForm(u.StandRUID) end
                if src == "" and u.Kind == "mage" then src = self:MageForm(u.StandRUID) end
                local key = u.Kind == "shadow" and ("shadow:" .. src) or ((u.Kind == "skeleton" or u.Kind == "mage") and (u.Kind .. ":" .. src) or u.Kind)
                local g = byKind[key]
                if g == nil then
                    g = { kind = u.Kind, src = src, count = 0, hp = 0, maxHp = 0, lowest = 1, promoted = false, state = u.CommandState, portrait = u.StandRUID, first = u.Entity.Id, entity = u.Entity, picked = false }
                    byKind[key] = g
                    table.insert(groups, g)
                end
                if u.Entity == picked then g.picked = true end
                g.count = g.count + 1
                g.hp = g.hp + u.Hp
                g.maxHp = g.maxHp + u.MaxHp
                g.lowest = math.min(g.lowest, u.Hp / math.max(1, u.MaxHp))
                if u.Promoted then g.promoted = true end
                if u.Entity.Id < g.first then g.first = u.Entity.Id g.state = u.CommandState g.portrait = u.StandRUID g.entity = u.Entity end
                local v = u.Variant ~= "" and _GameData:GetVariantOf(u.Variant, "aura") or nil
                if v ~= nil and (g.auraValue == nil or v.value > g.auraValue) then g.aura = v.effect g.auraName = v.label g.auraValue = v.value end
            end
        end
        table.sort(groups, function(a, b) return self:KindOrder(a.kind) < self:KindOrder(b.kind) end)
        self.Units = groups
        self.UnitCount = #groups
        self.Page = math.min(self.Page, math.max(0, math.ceil(#groups / 4) - 1))
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- 체력 막대는 왼쪽 고정 폭으로 줄이고 저체력일 때만 경고색을 쓴다.
        local show = self.UnitCount > 0 and not _UIKit:AnyWindowOpen()
        _UIKit:SetEnabled(self.Strip, show)
        if not show then return end
        local pages = math.max(1, math.ceil(self.UnitCount / 4))
        _UIKit:SetText(self.Strip .. "/Page", tostring(self.Page + 1) .. " / " .. tostring(pages))
        _UIKit:SetEnabled(self.Strip .. "/Page", pages > 1)
        -- 모바일은 가운데 정렬이므로 보이는 칸 수만큼 띠 폭을 맞춘다
        local strip = _UIKit:Get(self.Strip)
        local shown = math.min(4, self.UnitCount)
        if isvalid(strip) and Environment:IsMobilePlatform() then strip.UITransformComponent.RectSize = Vector2(shown * 112 - 16, 112) end
        for i = 1, 4 do
            local base = self.Strip .. "/Unit" .. tostring(i)
            local g = self.Units[self.Page * 4 + i]
            local live = g ~= nil and g.count > 0
            _UIKit:SetEnabled(base, live)
            if live then
                -- 막대는 무리 전체 생명, 경고색·테두리는 가장 약한 한 마리 기준
                local ratio = math.max(0, math.min(1, g.hp / math.max(1, g.maxHp)))
                local color = Color(0.4, 0.58, 0.51, 1)
                if g.kind == "shadow" then color = Color(0.52, 0.43, 0.67, 1) end
                if g.lowest <= 0.25 then color = Color(0.78, 0.23, 0.22, 1) end
                _UIKit:SetColor(base .. "/HP/Fill", color)
                _UIKit:SetFill(base .. "/HP/Fill", ratio)   -- 경험치 막대와 같은 그림 (tools/build/companion.cjs, 10-28)
                local portrait = g.portrait ~= "" and ("thumbnail://" .. g.portrait) or self:FallbackIcon(g.kind)
                -- 메이플식 프레임 몬스터는 캔버스가 몸보다 넓어 초상이 작아진다 → 몸만 잘라 둔 초상 그림 (monsters.csv portrait)
                local pst = g.src ~= "" and _GameData:GetMonsterStats(g.src) or nil
                if pst ~= nil and pst.portrait ~= nil and pst.portrait ~= "" then portrait = pst.portrait end
                -- 해골 변이: 몸만 잘라 둔 정사각형 초상 (프레임 그림은 캔버스가 넓고 피벗이 발밑이라 칸에서 찌그러졌다)
                if string.sub(g.src, 1, 9) == "skelform_" or string.sub(g.src, 1, 9) == "mageform_" then
                    local icon = _GameData:GetUiIcon(g.src .. "_portrait")
                    if icon ~= "" then portrait = icon end
                end
                -- 뼈 거인 3종: HUD 아이콘 ui_giant_(종류) (코덱스 J7-HUD3 · 미등록이면 거인 서기 그림 초상 그대로 — 10-30 갈래 E)
                if string.sub(g.src, 1, 6) == "giant_" then
                    local icon = _GameData:GetUiIcon("ui_" .. g.src)
                    if icon ~= "" then portrait = icon end
                end
                _UIKit:SetIcon(base .. "/Portrait", portrait)
                self:FitPortrait(base .. "/Portrait", g.src)
                local frame = Color(1, 1, 1, 1)
                if g.promoted then frame = Color(1, 0.86, 0.56, 1) end
                if g.lowest <= 0.25 then frame = Color(1, 0.65, 0.65, 1) end
                if g.picked then frame = Color(0.55, 0.9, 1, 1) end   -- 고른 그림자 칸 (44-3 B · 승격·희생이 이 그림자를 먼저 쓴다)
                _UIKit:SetColor(base .. "/Frame", frame)
                _UIKit:SetText(base .. "/State", "")
                -- 오오라는 오른쪽 위 작은 아이콘 + 등급 테두리 (설명은 생명 오브 위 버프 칩 · 10-24 사용자). 아이콘이 없으면 오오라 색 원
                _UIKit:SetEnabled(base .. "/Aura", g.aura ~= nil)
                if g.aura ~= nil then
                    local icon = _GameData:GetUiIcon("aura_" .. g.aura)
                    _UIKit:SetIcon(base .. "/Aura", icon ~= "" and icon or _GameData:GetUiIcon("circle"))
                    _UIKit:SetColor(base .. "/Aura", icon ~= "" and Color(1, 1, 1, 1) or _GameConst:AuraColor(g.aura))
                    local tier = _GameData:GetUiIcon("aura_tier" .. tostring(_GameData:AuraTier(g.auraValue or 0)))
                    _UIKit:SetEnabled(base .. "/Aura/Tier", tier ~= "")
                    if tier ~= "" then _UIKit:SetIcon(base .. "/Aura/Tier", tier) end
                end
                _UIKit:SetPos(base .. "/Count", Vector2(g.aura ~= nil and -34 or -6, -4))
                _UIKit:SetText(base .. "/Count", g.count > 1 and ("×" .. tostring(g.count)) or "")
            end
        end
    end

    method string MageForm(string stand)
        -- 해골 마법사 변이(광기·저주·쌍발·관통·폭발)도 서기 첫 프레임으로 알아내 따로 묶는다. 일반 마법사는 ""
        for _, form in ipairs({ "aura", "hex", "twin", "pierce", "blast" }) do
            local f = _GameData:GetMonsterFrames("mageform_" .. form)
            if f ~= nil and f.stand ~= nil and f.stand.r[1] == stand then return "mageform_" .. form end
        end
        return ""
    end

    method string SkeletonForm(string stand)
        -- 해골 변이(방패·쌍칼·대검)는 서기 첫 프레임으로 알아내 따로 묶는다 (10-24 코덱스 전용 그림) — 아니면 필드 해골 전사의 초상
        -- 뼈 거인 3종 그림이 등록돼 서기 그림이 거인 것이면 「giant_(종류)」 (10-30 갈래 E · 미등록이면 거인 몸은 변이 그림이라 아래 그대로)
        for _, form in ipairs({ "shield", "twin", "greatsword" }) do
            local g = _GameData:GetMonsterFrames("giant_" .. form)
            if g ~= nil and g.stand ~= nil and g.stand.r[1] == stand then return "giant_" .. form end
        end
        for _, form in ipairs({ "shield", "twin", "greatsword" }) do
            local f = _GameData:GetMonsterFrames("skelform_" .. form)
            if f ~= nil and f.stand ~= nil and f.stand.r[1] == stand then return "skelform_" .. form end
        end
        return "skel_warrior"
    end

    @ExecSpace("ClientOnly")
    method void FitPortrait(string rel, string src)
        -- 초상 칸(62) 안에 그림 비율대로 맞춘다. 코덱스 프레임 그림은 피벗이 발밑이라 비율 유지(AspectOnly)면 칸 위로 밀렸다 (10-10 QA 전갈)
        -- 크기 맞춤은 UIKit.SetMonsterPortrait와 같다. 그림(해골·마법사 기본 아이콘 등)은 호출부가 이미 넣었으므로 크기만 맞춘다
        local e = _UIKit:Get(rel)
        if not isvalid(e) then return end
        local stats = src ~= "" and _GameData:GetMonsterStats(src) or nil
        local sprite = e.SpriteGUIRendererComponent
        if stats == nil or stats.w == nil or stats.w <= 0 or stats.h <= 0 or not isvalid(sprite) then
            if isvalid(sprite) then sprite.PreserveSprite = PreserveSpriteType.AspectOnly end
            e.UITransformComponent.RectSize = Vector2(62, 62)
            return
        end
        sprite.PreserveSprite = PreserveSpriteType.None
        local w = (stats.pw ~= nil and stats.pw > 0) and stats.pw or stats.w
        local h = (stats.ph ~= nil and stats.ph > 0) and stats.ph or stats.h
        local k = 62 / math.max(w, h)
        e.UITransformComponent.RectSize = Vector2(w * k, h * k)
    end

    method integer KindOrder(string kind)
        -- 띠 순서: 해골 전사 → 해골 마법사 → 되살린 몬스터 → 그림자
        if kind == "skeleton" then return 1 end
        if kind == "mage" then return 2 end
        if kind == "revive" then return 3 end
        return 4
    end

    method string FallbackIcon(string kind)
        -- 원본 초상 동기화가 아직 도착하지 않았을 때도 종류별 제작 아이콘을 쓴다.
        if kind == "mage" then return "2b7b45e6527b45ddbc3e5962e637649b" end
        if kind == "revive" then return "f5c27a5d48c145129117e41e264df8df" end
        if kind == "shadow" then return "3ad12e3a900e44648d683a541f801ef2" end
        return "28a05141071146c291d0593fe2dfcdd1"
    end
end
