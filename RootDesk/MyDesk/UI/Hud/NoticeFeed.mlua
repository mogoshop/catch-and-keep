-- 안내 줄 (획득·경고 문구) = 알림 채널 B 「왼쪽 알림 더미」 (10-31 실플레이 피드백 B-4 · docs/evidence/2026-10-31-playfeedback-B/notice-channels.md).
--   엔진 화면 메시지(상단 가운데 큰 띠)는 전투 화면을 가려 왼쪽 아래 짧은 줄로 옮겼다 (10-10 QA).
--   · 위가 최신, 동시에 최대 KeepLines(3)줄 · 모바일 MobileKeepLines(2)줄, 한 줄은 3.5초 뒤 0.5초 동안 흐려진다 (모두 4초)
--   · 같은 글(숫자만 다른 글 포함 — ShapeKey)이 MergeSec(10)초 안에 또 오면 새 줄 대신 한 줄에 「×N」으로 합치고 맨 위로 올린다
--   · 상한·경고류(LimitPatterns — 「최대 N기」·「한도」·「가방이 가득」 등)는 같은 키를 LimitSec(60)초에 한 번만 (보이는 동안 다시 오면 ×N만)
--   · 골드 획득("골드 +N")은 보이는 줄 하나에 합친다 (줍기는 채널 D 발밑 글씨로 옮겼다 — 창이 떠 있을 때만 여기로)
--   · PC 평소 자리: 채팅 창 바로 위(채팅이 펼쳐지면 그만큼 위로) · 위로는 파티 목록·큰 알림 판 아래 끝까지만 쌓는다 (겹치지 않게 넘치는 옛 줄은 숨김) — PlaceHome
--   · 창이 떠 있으면 줄을 창 밖 가장자리로 옮긴다 (10-29 45 결정 1-A): 창 위 빈 곳 → 없으면 창 아래 → 그것도 없으면 화면 맨 위 한 줄.
--     자리 높이는 최신 줄의 실제 글 높이로 잡는다 — 두 줄짜리 결과도 화면 위로 잘리지 않게 (10-29 UI-20261029-02)
--     창을 닫으면 평소 자리(PC 왼쪽 아래 · 모바일 지도 아래 — MobileLayout)로 돌아간다
@Logic
script NoticeFeed extends Logic

    property integer MaxLines = 4
    property number LineHeight = 44      -- 한 줄 문구 판 높이 (빌드 기본값)
    property number LineGap = 6
    property number TextWidth = 590      -- 글 칸 폭 (줄바꿈 계산용)
    property number MaxHeight = 250      -- 쌓을 수 있는 높이 (Feed 바닥 -170 ~ 위쪽 알림 판 바닥 +89)
    property number LineSeconds = 3.5
    property number FadeSeconds = 0.5
    property any Lines = nil          -- { text, key, count, gold, at } 아래(최신)부터
    property integer TimerId = 0
    property boolean Edge = false        -- 창이 떠 있어 창 밖 가장자리에 줄을 세웠다
    property any Home = nil              -- 평소 자리 { align, pivot, pos, size } (가장자리로 옮길 때 지금 자리를 적어 둔다)
    property integer EdgeMaxLines = 2
    property number EdgeMaxHeight = 0    -- 가장자리에서 쌓을 수 있는 높이 (자리마다 다시 잰다)
    property number EdgeWindowGap = 28   -- 창 바탕에서 띄우는 거리 (창 테두리 그림이 바탕 밖으로 20 넘친다 — ui-tokens FRAME.rimOut)
    property number EdgeScreenTop = 8    -- 화면 위 끝 여백 (PC)
    property number EdgeScreenTopMobile = 96   -- 모바일은 엔진 단추 줄(위 0~90) 아래
    property number EdgeScreenBottom = 40      -- 화면 아래 끝 여백 (경험치 줄 위)
    property string EdgeSide = ""        -- above · below · top (메이커 확인용)
    property integer EdgeNeed = 0        -- 가장자리 자리를 잡을 때 잰 최신 줄 높이 (메이커 확인용)
    property integer EdgeCount = 0
    -- 10-31 B-4 채널 B 규칙 (되돌리기 쉽게 상수로)
    property integer KeepLines = 3           -- 동시에 보이는 줄 (PC)
    property integer MobileKeepLines = 2     -- 모바일
    property number MergeSec = 10            -- 같은 글을 한 줄 「×N」으로 합치는 시간
    property number LimitSec = 60            -- 상한·경고류 같은 키는 이 초에 한 번
    property table LimitPatterns = { "최대 ", "한도", "상한", "가방이 가득" }   -- 저절로 반복되는 상한·경고 (방·채널 「가득 찼습니다」처럼 직접 누른 결과는 넣지 않는다)
    property table Recent = {}               -- 키 → { n, at } (줄이 사라진 뒤에도 MergeSec 안이면 이어 센다)
    property table LimitSeen = {}            -- 상한·경고류 키 → 처음 띄운 시각
    property integer MergeCount = 0
    property integer DropCount = 0
    property boolean HomeOn = true           -- PC 평소 자리를 채팅·파티·큰 알림 판에 맞춰 잡는다 (false = 빌드 자리 그대로)
    property string ChatPath = "/ui/ChatHUD/Chat"
    property string PartyPath = "/ui/GameHUD/Party"
    property string ToastPath = "/ui/RewardHUD/Toast"
    property number ChatTopDefault = 510     -- 채팅 창 위 끝 (화면 아래에서 · chat.cjs 210 + 300) — 채팅을 못 찾으면
    property number ChatOpenExtra = 0        -- 채팅이 펼쳐졌을 때 더 띄우는 높이 (메이커 실측으로 조정 · 펼친 크기는 RectSize로 읽는다)
    property number ChatGap = 12
    property number StackGap = 12            -- 파티 목록·큰 알림 판 아래 끝과의 간격
    property string HomeLog = ""
    property boolean GoldToFeet = true       -- 10-31 B-4 후속: 「골드 +N」은 창이 없으면 어느 경로로 와도 채널 D(발밑 글씨)로 — 안내 줄에는 창이 떠 있을 때만

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.Lines = {}
        self.Edge = false
        self.Home = nil
        for i = 1, self.MaxLines do _UIKit:SetEnabled("/ui/RewardHUD/Feed/Line" .. tostring(i), false) end
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Tick() end, 0.1)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        self.Lines = {}
    end

    @ExecSpace("ClientOnly")
    method void Push(string text)
        if text == nil or text == "" then return end
        if self.Lines == nil then self.Lines = {} end
        if self.Recent == nil then self.Recent = {} end
        if self.LimitSeen == nil then self.LimitSeen = {} end
        local now = _UtilLogic.ElapsedSeconds
        local gold = tonumber(string.match(text, "^골드 %+(%d+)$"))
        -- 메이커 B1(10-31): 서버 _Util:Notify("골드 +N")로 온 골드가 이 안내 줄에서 「골드 +225」로 합쳐져 보였다 → 창이 없으면 발밑으로 넘긴다
        --   (HudMain.PickupPop은 창이 떠 있을 때만 여기로 되돌려 보내므로 서로 돌지 않는다 — 둘 다 UIKit.AnyWindowOpen을 본다)
        if gold ~= nil and self.GoldToFeet and not _UIKit:AnyWindowOpen() then
            _HudMain:PickupPop(text)
            return
        end
        if gold ~= nil then
            for _, line in ipairs(self.Lines) do
                if line.gold ~= nil then
                    line.gold = line.gold + gold
                    line.text = "골드 +" .. tostring(line.gold)
                    line.at = now
                    -- 합친 글이 길어져 줄 높이가 바뀔 수 있다: 가장자리 자리를 먼저 다시 잡고 그린다 (10-29 UI-NOTICE-R01 · 새 줄 경로와 같은 순서)
                    self:SyncEdge()
                    self:Render()
                    return
                end
            end
        end
        local key = gold ~= nil and "골드" or self:ShapeKey(text)
        if gold == nil then
            -- 같은 글이 MergeSec 안에 또 오면: 보이는 줄에 「×N」을 올리고 맨 위로 (10-31 B-4 · 예전엔 두 줄까지 새로 띄웠다)
            for i, line in ipairs(self.Lines) do
                if line.key == key and now - line.at <= self.MergeSec then
                    line.count = line.count + 1
                    line.text = text
                    line.at = now
                    if i > 1 then
                        table.remove(self.Lines, i)
                        table.insert(self.Lines, 1, line)
                    end
                    self.Recent[key] = { n = line.count, at = now }
                    self.MergeCount = self.MergeCount + 1
                    -- 「×N」이 붙어 줄이 넘어가면 높이가 커진다: 자리를 먼저 다시 잡고 그린다 (10-29 UI-NOTICE-R01)
                    self:SyncEdge()
                    self:Render()
                    return
                end
            end
            -- 상한·경고류: 같은 키는 LimitSec에 한 번만 (줄이 이미 사라졌으면 버린다)
            if self:IsLimit(text) then
                local seen = self.LimitSeen[key]
                if seen ~= nil and now - seen < self.LimitSec then
                    self.DropCount = self.DropCount + 1
                    log("[VRF] feed limit drop " .. key)
                    return
                end
                self.LimitSeen[key] = now
            end
        end
        -- 줄이 사라진 뒤라도 MergeSec 안에 같은 글이면 센 수를 이어 간다
        local count = 1
        local recent = self.Recent[key]
        if gold == nil and recent ~= nil and now - recent.at <= self.MergeSec then count = recent.n + 1 end
        self.Recent[key] = { n = count, at = now }
        table.insert(self.Lines, 1, { text = text, key = key, count = count, gold = gold, at = now })
        while #self.Lines > self.MaxLines do table.remove(self.Lines) end
        self:SyncEdge()
        self:Render()
    end

    method string ShapeKey(string text)
        -- 숫자만 다른 글은 같은 글 (「해골 전사는 지금 최대 4기」 ↔ 「… 5기」)
        return (string.gsub(text, "%d+", "#"))
    end

    method boolean IsLimit(string text)
        -- 상한·경고류 (자주 반복되지만 한 번 읽으면 되는 글)
        for _, pat in ipairs(self.LimitPatterns) do
            if string.find(text, pat, 1, true) ~= nil then return true end
        end
        return false
    end

    method integer KeepLimit()
        if _ApplicationService:IsMobilePlatform() then return self.MobileKeepLines end
        return self.KeepLines
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        self:SyncEdge()
        if self.Lines == nil or #self.Lines == 0 then return end
        local now = _UtilLogic.ElapsedSeconds
        local changed = false
        for i = #self.Lines, 1, -1 do
            if now - self.Lines[i].at > self.LineSeconds + self.FadeSeconds then
                table.remove(self.Lines, i)
                changed = true
            end
        end
        if changed then
            -- 만료로 첫 줄이 바뀌면 높이도 바뀐다: 남은 목록 기준으로 가장자리 자리를 다시 잡고 그린다 (10-29 UI-NOTICE-R01 Tick 만료 경계)
            self:SyncEdge()
            self:Render()
        else
            self:Fade(now)
        end
    end

    -- ───────── 창 밖 가장자리 ─────────

    @ExecSpace("ClientOnly")
    method void SyncEdge()
        -- 창이 떠 있는지 보고 자리를 바꾼다. 떠 있는 동안은 매번 다시 재서 창 크기·모바일 배치가 바뀌어도 따라간다
        local want = _UIKit:AnyWindowShown()
        if want ~= self.Edge then
            local feed = _UIKit:Get("/ui/RewardHUD/Feed")
            if not isvalid(feed) then return end
            local t = feed.UITransformComponent
            if want then
                self.Home = { align = t.AlignmentOption, pivot = t.Pivot, pos = t.anchoredPosition, size = t.RectSize }
                self.Edge = true
                self.EdgeCount = self.EdgeCount + 1
            else
                self.Edge = false
                if self.Home ~= nil then
                    t.AlignmentOption = self.Home.align
                    t.Pivot = self.Home.pivot
                    t.anchoredPosition = self.Home.pos
                    t.RectSize = self.Home.size
                end
                log("[VRF] feed home lines=" .. tostring(self.Lines ~= nil and #self.Lines or 0))
            end
            if want then self:PlaceEdge(true) end
            self:Render()
            return
        end
        if self.Edge then self:PlaceEdge(false) else self:PlaceHome() end
    end

    @ExecSpace("ClientOnly")
    method void PlaceHome()
        -- PC 평소 자리 (10-31 B-4): 바닥 = 채팅 창 위 끝 + ChatGap (펼쳤으면 ChatOpenExtra 더) · 쌓는 높이 = 파티 목록·큰 알림 판 아래 끝까지
        --   모바일은 MobileLayout이 지도 아래에 놓는다 (여기서 옮기지 않는다)
        if not self.HomeOn or _ApplicationService:IsMobilePlatform() then return end
        local feed = _UIKit:Get("/ui/RewardHUD/Feed")
        local root = _UIKit:Get("/ui/RewardHUD")
        if not isvalid(feed) or not isvalid(root) then return end
        local rootH = root.UITransformComponent.RectSize.y
        local base = self.ChatTopDefault
        local expand = false
        local chat = _UIKit:Get(self.ChatPath)
        if isvalid(chat) and chat.Enable and chat.UITransformComponent.AlignmentOption == AlignmentType.BottomLeft then
            local ct = chat.UITransformComponent
            base = ct.anchoredPosition.y + (1 - ct.Pivot.y) * ct.RectSize.y
            expand = isvalid(chat.ChatComponent) and chat.ChatComponent.Expand
            if expand then base = base + self.ChatOpenExtra end
        end
        local bottom = base + self.ChatGap
        local top = rootH - self.EdgeScreenTop
        local partyBottom, toastBottom = -1, -1
        local party = _UIKit:Get(self.PartyPath)
        if isvalid(party) and party.Enable and party.UITransformComponent.AlignmentOption == AlignmentType.TopLeft then
            local pt = party.UITransformComponent
            partyBottom = rootH + pt.anchoredPosition.y - pt.RectSize.y * pt.Pivot.y
            top = math.min(top, partyBottom - self.StackGap)
        end
        local toast = _UIKit:Get(self.ToastPath)
        if isvalid(toast) and toast.Enable and toast.UITransformComponent.AlignmentOption == AlignmentType.Left then
            local tt = toast.UITransformComponent
            toastBottom = rootH * 0.5 + tt.anchoredPosition.y - tt.RectSize.y * tt.Pivot.y
            top = math.min(top, toastBottom - self.StackGap)
        end
        local t = feed.UITransformComponent
        if t.AlignmentOption ~= AlignmentType.BottomLeft then t.AlignmentOption = AlignmentType.BottomLeft end
        if t.Pivot.x ~= 0 or t.Pivot.y ~= 0 then t.Pivot = Vector2(0, 0) end
        if math.abs(t.anchoredPosition.y - bottom) > 0.5 then t.anchoredPosition = Vector2(t.anchoredPosition.x, bottom) end
        local h = math.max(self.LineHeight, top - bottom)
        if math.abs(t.RectSize.y - h) > 0.5 then t.RectSize = Vector2(t.RectSize.x, h) end
        self.MaxHeight = h
        local key = string.format("%d/%d/%s/%d/%d", math.floor(bottom), math.floor(h), tostring(expand), math.floor(partyBottom), math.floor(toastBottom))
        if key ~= self.HomeLog then
            self.HomeLog = key
            log(string.format("[VRF] feed home bottom=%d h=%d chatExpand=%s partyBottom=%d toastBottom=%d", math.floor(bottom), math.floor(h), tostring(expand), math.floor(partyBottom), math.floor(toastBottom)))
        end
    end

    @ExecSpace("ClientOnly")
    method void PlaceEdge(boolean first)
        -- 화면·창 네 귀퉁이(화면 좌표)를 이 UI 단위로 바꿔, 창 위 빈 곳 → 창 아래 빈 곳 → 화면 맨 위 순으로 줄 묶음을 세운다
        local feed = _UIKit:Get("/ui/RewardHUD/Feed")
        local root = _UIKit:Get("/ui/RewardHUD")
        if not isvalid(feed) or not isvalid(root) then return end
        local rt = root.UITransformComponent
        local rc = rt:GetWorldCorners()
        if rc == nil or #rc < 4 then return end
        local rb = self:Bounds(rc)
        local rMinY, rMaxY = rb.minY, rb.maxY
        local scale = rt.RectSize.y / math.max(1, rMaxY - rMinY)   -- 화면 좌표 → RewardHUD 단위
        local h = rt.RectSize.y
        local w = rt.RectSize.x
        local top = h - (_ApplicationService:IsMobilePlatform() and self.EdgeScreenTopMobile or self.EdgeScreenTop)
        -- 자리는 최신 줄의 실제 높이로 잡는다 (10-29 UI-20261029-02: 한 줄 높이 44만 잡고 두 줄 글은 위로 자라 화면 위로 잘렸다 — 재련 결과·업적 받기 줄)
        local need = self:NewestLineHeight()
        local stack = math.max(need, self.LineHeight * self.EdgeMaxLines + self.LineGap * (self.EdgeMaxLines - 1))
        local side = "top"
        local bottomY = top - need
        local avail = need
        local win = _UIKit:ShownWindowEntity()
        if isvalid(win) then
            local wc = win.UITransformComponent:GetWorldCorners()
            if wc ~= nil and #wc >= 4 then
                local wb = self:Bounds(wc)
                local winTop = (wb.maxY - rMinY) * scale
                local winBottom = (wb.minY - rMinY) * scale
                local above = top - (winTop + self.EdgeWindowGap)
                local below = (winBottom - self.EdgeWindowGap) - self.EdgeScreenBottom
                if above >= need then
                    side = "above"
                    bottomY = winTop + self.EdgeWindowGap
                    avail = above
                elseif below >= need then
                    side = "below"
                    avail = math.min(below, stack)
                    bottomY = winBottom - self.EdgeWindowGap - avail
                end
            end
        end
        self.EdgeMaxHeight = math.max(need, math.min(avail, stack))
        local t = feed.UITransformComponent
        local size = self.Home ~= nil and self.Home.size or t.RectSize
        local pos = Vector2(math.floor((w - size.x) * 0.5), math.floor(bottomY))
        if t.AlignmentOption ~= AlignmentType.BottomLeft then t.AlignmentOption = AlignmentType.BottomLeft end
        if t.Pivot.x ~= 0 or t.Pivot.y ~= 0 then t.Pivot = Vector2(0, 0) end
        if math.abs(t.anchoredPosition.x - pos.x) > 0.5 or math.abs(t.anchoredPosition.y - pos.y) > 0.5 then t.anchoredPosition = pos end
        if math.abs(t.RectSize.y - self.EdgeMaxHeight) > 0.5 then t.RectSize = Vector2(size.x, self.EdgeMaxHeight) end
        if first or side ~= self.EdgeSide or math.floor(need) ~= self.EdgeNeed then
            self.EdgeSide = side
            self.EdgeNeed = math.floor(need)
            log(string.format("[VRF] feed edge side=%s y=%d h=%d need=%d topY=%d screenTop=%d win=%s", side, math.floor(bottomY), math.floor(self.EdgeMaxHeight), math.floor(need), math.floor(bottomY + need), math.floor(h), isvalid(win) and win.Name or "-"))
        end
    end

    @ExecSpace("ClientOnly")
    method number NewestLineHeight()
        -- 가장 최근 줄(Line1)이 차지할 높이 = 글 높이 + 12 (Render와 같은 계산). 줄이 없으면 한 줄 높이
        local h = self.LineHeight
        if self.Lines == nil or #self.Lines == 0 then return h end
        local line = self.Lines[1]
        local text = line.text
        if line.count > 1 then text = text .. "  ×" .. tostring(line.count) end
        local t = _UIKit:Get("/ui/RewardHUD/Feed/Line1/Text")
        local r = isvalid(t) and t.TextGUIRendererComponent or nil
        if isvalid(r) then h = math.max(self.LineHeight, math.ceil(r:GetPreferredHeight(text, self.TextWidth)) + 12) end
        return h
    end

    method table Bounds(table corners)
        -- 네 귀퉁이 → { minX, maxX, minY, maxY } (귀퉁이 순서에 기대지 않는다)
        local b = { minX = corners[1].x, maxX = corners[1].x, minY = corners[1].y, maxY = corners[1].y }
        for _, c in ipairs(corners) do
            b.minX = math.min(b.minX, c.x)
            b.maxX = math.max(b.maxX, c.x)
            b.minY = math.min(b.minY, c.y)
            b.maxY = math.max(b.maxY, c.y)
        end
        return b
    end

    -- ───────── 그리기 ─────────

    @ExecSpace("ClientOnly")
    method void Fade(number now)
        for i, line in ipairs(self.Lines) do
            local e = _UIKit:Get("/ui/RewardHUD/Feed/Line" .. tostring(i))
            if isvalid(e) and isvalid(e.CanvasGroupComponent) then
                local left = self.LineSeconds + self.FadeSeconds - (now - line.at)
                e.CanvasGroupComponent.GroupAlpha = math.max(0, math.min(1, left / self.FadeSeconds))
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- 10-10 3차 QA: 두 줄로 넘어가는 문구가 위 줄과 겹쳤다 → 줄마다 글 높이에 맞춰 판을 늘리고 쌓는다.
        -- 10-31 B-4: 위가 최신. 최신부터 자리(MaxHeight · 줄 수)에 들어가는 만큼만 고르고, 고른 것 중 가장 오래된 줄을 바닥(0)에 놓아 위로 쌓는다.
        --   들어가지 않는 오래된 줄은 숨긴다 (파티 목록·큰 알림 판과 겹치지 않게). 가장자리에서는 그 자리 높이 · 최대 2줄
        if self.Lines == nil then self.Lines = {} end
        local maxH = self.Edge and self.EdgeMaxHeight or self.MaxHeight
        local maxLines = self.Edge and self.EdgeMaxLines or self:KeepLimit()
        local picked = {}
        local total = 0
        for i = 1, self.MaxLines do
            local path = "/ui/RewardHUD/Feed/Line" .. tostring(i)
            local line = self.Lines[i]
            local e = _UIKit:Get(path)
            if line == nil or not isvalid(e) then break end
            local text = line.text
            if line.count > 1 then text = text .. "  ×" .. tostring(line.count) end
            _UIKit:SetText(path .. "/Text", text)
            local h = self.LineHeight
            local t = _UIKit:Get(path .. "/Text")
            local r = isvalid(t) and t.TextGUIRendererComponent or nil
            if isvalid(r) then h = math.max(self.LineHeight, math.ceil(r:GetPreferredHeight(text, self.TextWidth)) + 12) end
            local need = h
            if #picked > 0 then need = total + self.LineGap + h end
            if #picked >= maxLines or (#picked > 0 and need > maxH) then break end
            table.insert(picked, { i = i, h = h, t = t })
            total = need
        end
        local shown = {}
        local y = 0
        for j = #picked, 1, -1 do
            local v = picked[j]
            local path = "/ui/RewardHUD/Feed/Line" .. tostring(v.i)
            local e = _UIKit:Get(path)
            e.UITransformComponent.RectSize = Vector2(e.UITransformComponent.RectSize.x, v.h)
            e.UITransformComponent.anchoredPosition = Vector2(0, y)
            if isvalid(v.t) then v.t.UITransformComponent.RectSize = Vector2(v.t.UITransformComponent.RectSize.x, v.h - 4) end
            _UIKit:SetEnabled(path, true)
            shown[v.i] = true
            y = y + v.h + self.LineGap
        end
        for i = 1, self.MaxLines do
            if not shown[i] then _UIKit:SetEnabled("/ui/RewardHUD/Feed/Line" .. tostring(i), false) end
        end
        self:Fade(_UtilLogic.ElapsedSeconds)
    end
end
