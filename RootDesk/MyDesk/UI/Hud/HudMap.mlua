-- 위치 안내 HUD (클라이언트): 맵 이름(D2처럼 들어올 때 상단 가운데 2.5초) · 미니맵(포털·웨이포인트·NPC·입구 + 나·파티) ·
-- 의뢰 NPC 머리 위 표시(새 의뢰 !, 완료 보고 ?). 맵 표시물은 GameData.MapInfo (maps.csv → 맵 빌드와 같은 위치).
-- 안개 (D2 자동 지도): 지형을 RevealCell 칸 단위로 나눠 그리고, 지나간 곳(주변 RevealRadius)만 밝힌다. 표시물·목표 원도 밝혀진 곳에서만.
--   밝혀진 칸은 접속 중에만 기억한다. 마을은 처음부터 다 보인다.
@Logic
script HudMap extends Logic

    property number PollInterval = 0.1
    property number BannerSeconds = 2.5
    property integer FeatureCount = 12
    property integer TimerId = 0
    property integer PulseTimerId = 0
    property string LastMap = ""
    property number BannerUntil = 0
    property number BannerLength = 0           -- 이번 맵 배너를 띄울 시간 (이동 화면이 걷힌 뒤 다시 센다 — MapTransition)
    property number MiniRadius = 96          -- 264px 테두리의 투명 반경 약111px에서 표식 여백 확보
    property number Scale = 1
    property Vector2 QuestPos = Vector2(0, 0)
    property boolean HasQuestNpc = false
    property table NpcPos = {}                -- NPC 종류 → 위치 (의뢰인 머리 위 「!」)
    property table NpcLabel = {}              -- NPC 종류 → 이름 (화면 밖 「!」 옆에 붙인다)
    property table Gates = {}               -- 이 맵의 포털 { pos, label }
    property number GateLabelRange = 9
    property integer TerrainCount = 256
    property integer TerrainUsed = 0
    property string LastMapId = ""
    property Vector2 MapCenter = Vector2(0, 0)
    property table Features = {}
    property boolean Expanded = true
    property string LayoutKey = ""
    property string RouteKey = ""
    property string RouteWaypoint = ""
    property string LastFeatureKey = ""
    property number NextFeatureRefresh = 0
    property number FeatureRefreshInterval = 1.2   -- 늦게 생기는 포털·파티 표시 반영 (맵 전체 검색 5종이라 자주 돌리지 않는다)
    property number NextFocusAt = 0
    property number CombatUntil = 0            -- 모바일 전투 중 의뢰 추적 접기 (InMobileCombat)
    property Vector2 LastMePos = Vector2(0, 0)
    property integer ShownFloor = 0
    property integer ZoomLevel = 2             -- 1 맵 전체 · 2 기본(가까이, 나를 따라감) · 3 더 가까이
    property number FitScale = 1               -- 맵 전체가 원 안에 들어가는 축척
    property Vector2 ViewCenter = Vector2(0, 0) -- 원 가운데에 오는 월드 위치 (확대 시 내 위치)
    property Vector2 PlacedCenter = Vector2(99999, 99999)
    property number TerrainHalf = 132          -- 바닥을 자르는 테두리 사각형 절반 (원 밖 모서리는 Area/Frame 테두리 그림이 덮는다)
    property table TerrainRects = {}           -- 월드 기준 바닥 사각형 { x, y, w, h, block } — 확대 단계가 바뀌면 크기만 다시 계산
    property number RevealCell = 4             -- 안개 칸 크기 (월드 단위, 실제는 타일 크기에 맞춰 반올림)
    property number RevealRadius = 6           -- 내 주변 이 거리 안의 칸이 밝혀진다
    property any Blocks = nil                  -- 이 맵의 안개 칸 목록 { key, x, y } (월드 가운데)
    property number BlockSize = 4              -- 실제 칸 크기 (월드 단위)
    property any Revealed = nil                -- 맵 키 → { 칸 key → true } (접속 중에만)
    property boolean RevealAll = false         -- 마을은 처음부터 다 보인다
    property string MapSub = ""                -- 미니맵 머리글 기본 문구 (사냥터 · 악몽 …)
    property string BossShown = ""             -- 머리글에 지금 보이는 보스 남은 시간 (바뀔 때만 다시 쓴다)
    property number NextBossAt = 0

    property integer CheerMarkCount = 8     -- 격려 「!」 칸 수 (ui.cjs CheerMark1~8)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 플레이 재시작 시 이전 맵과 동적 포털 캐시를 이어 쓰지 않는다.
        self.LastMapId = ""
        self.LastFeatureKey = ""
        self.NextFeatureRefresh = 0
        self.RouteKey = ""
        self.RouteWaypoint = ""
        -- 별도 내비게이션 HUD를 사용하며 이전 표시물은 중복되지 않게 숨긴다.
        _UIKit:SetEnabled("/ui/GameHUD/MiniMap", false)
        _UIKit:SetEnabled("/ui/GameHUD/QuestTrack", false)
        -- 모바일도 지도를 펼친 채 시작한다 (접힌 채라 「미니맵이 없어졌다」고 보였다)
        self.Expanded = true
        _UIKit:Connect("MiniMap/Toggle", function() self:ToggleMap() end)
        _UIKit:Connect("MiniMap/Body/ZoomIn", function() self:SetZoom(self.ZoomLevel + 1) end)
        _UIKit:Connect("MiniMap/Body/ZoomOut", function() self:SetZoom(self.ZoomLevel - 1) end)
        self:RenderZoomButtons()
        _UIKit:SetEnabled("Banner", false)
        _UIKit:SetEnabled("NpcMark", false)
        for i = 1, self.CheerMarkCount do _UIKit:SetEnabled("CheerMark" .. tostring(i), false) end
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        self.PulseTimerId = _TimerService:SetTimerRepeat(function() self:PulseFocus() end, 0.05)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        if self.PulseTimerId ~= 0 then _TimerService:ClearTimer(self.PulseTimerId) end
        self.TimerId = 0
        self.PulseTimerId = 0
    end

    @ExecSpace("ClientOnly")
    method void PulseFocus()
        -- 목표 점 둘레 고리가 1.2초마다 18 → 46px로 퍼지며 흐려진다 (레이더 펄스)
        local ring = _UIKit:Get("MiniMap/Body/Area/Focus/Ring")
        if not isvalid(ring) or not isvalid(ring.Parent) or not ring.Parent.Enable then return end
        local t = (_UtilLogic.ElapsedSeconds % 1.2) / 1.2
        local size = 18 + 28 * t
        ring.UITransformComponent.RectSize = Vector2(size, size)
        local sprite = ring.SpriteGUIRendererComponent
        if isvalid(sprite) then sprite.Color = Color(1, 0.83, 0.42, 0.9 * (1 - t)) end
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local map = player.CurrentMap
        if map.Id ~= self.LastMapId then
            self.LastMapId = map.Id
            self.LastMap = map.Name
            self.NextFocusAt = 0
            self:OnMapChanged(map.Name)
        end
        -- 심도 층 번호가 늦게 동기화되면 이름을 다시 그린다
        if self:DepthFloor() ~= self.ShownFloor then self:OnMapChanged(map.Name) end
        self:RefreshFeatures(map)
        self:RenderLayout()
        -- 의뢰 경로 강조(경로 탐색 포함)는 0.5초마다면 충분하다. 내 위치 점만 0.1초마다 옮긴다.
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.NextFocusAt then
            self.NextFocusAt = now + 0.5
            self:RenderFocus(player)
        end
        self:TickBanner()
        if now >= self.NextBossAt then
            self.NextBossAt = now + 0.5
            self:RenderBossTimer(map.Name)
        end
        local me = _Util:Pos2(player)
        self:UpdateView(me)
        -- 새로 밝혀진 칸이 있으면 지형·표시물을 다시 놓는다
        if self:UpdateReveal(me) then
            self:LayoutTerrain()
            self:PlaceFeatures()
            self.NextFocusAt = 0
        end
        _UIKit:SetPos("MiniMap/Body/Area/Me", self:ToMini(me))
        -- 내 화살표는 움직인 방향을 가리킨다
        local moved = me - self.LastMePos
        if moved:Magnitude() > 0.03 then
            local arrow = _UIKit:Get("MiniMap/Body/Area/Me")
            -- 새 그림이 위(+90°)를 보므로 -90°를 더해 움직인 방향으로 돌린다
            if isvalid(arrow) then arrow.UITransformComponent.UIRotation = Vector3(0, 0, math.deg(math.atan(moved.y, moved.x)) - 90) end
        end
        self.LastMePos = me
        self:RenderParty(player)
        self:RenderNpcMark(player)
        self:RenderCheerMarks(player)
        self:RenderGates(player)
    end

    -- ───────── 맵이 바뀔 때 ─────────

    method integer DepthFloor()
        -- 지금 맵의 심도 층 (심도가 아니면 0)
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return 0 end
        -- 감독은 심도 맵 엔티티 자체에 붙어 있다
        local director = player.CurrentMap:GetComponent("script.DepthDirector")
        if director == nil then return 0 end
        return director.Floor
    end

    @ExecSpace("ClientOnly")
    method void RenderBossTimer(string mapName)
        -- 미니맵 머리글: 쓰러진 보스가 있으면 「목 없는 처형인 4:32」(주황), 없으면 맵 종류
        local boss = _BossRespawn:LabelFor(mapName)
        if boss == self.BossShown then return end
        self.BossShown = boss
        if boss == "" then
            _UIKit:SetText("MiniMap/Toggle/Kind", self.MapSub)
        else
            _UIKit:SetText("MiniMap/Toggle/Kind", _UIKit:Colored("#FF8A6B", boss))
        end
    end

    @ExecSpace("ClientOnly")
    method void OnMapChanged(string mapName)
        local base = _GameConst:BaseMapName(mapName)
        local info = _GameData:GetMapInfo(base)
        -- 난이도는 맵 이름(_nm/_hell)으로 판단한다. 캐릭터 난이도 값은 이동 직후 늦게 동기화될 수 있다
        -- (심도 인스턴스 맵은 접미사가 없으니 캐릭터 난이도로)
        local diff = _GameConst:DifficultyOfMap(mapName)
        if diff == 0 and info ~= nil and info.kind == "instance" then
            ---@type PlayerStats
            local st = _UIKit:Comp("script.PlayerStats")
            if st ~= nil then diff = st.Difficulty end
        end
        local title = base
        local sub = ""
        local chestNote = ""
        local floor = self:DepthFloor()
        self.ShownFloor = floor
        if info ~= nil then
            title = _GameConst:LevelText(info.name, mapName)
            if info.kind == "town" then sub = "마을" elseif info.kind == "side" then sub = "곁가지 던전" elseif info.kind == "instance" then sub = "심도 던전" else sub = "사냥터" end
            -- 곁가지 끝방 봉인 상자: 이 난이도에서 열었는지 (14장 §4)
            if info.kind == "side" then
                for _, row in ipairs(_NamedData:ForMap(base)) do
                    if row.chest then
                        ---@type PlayerQuest
                        local quest = _UIKit:Comp("script.PlayerQuest")
                        local opened = quest ~= nil and string.find(quest.SealedNow, ";" .. base .. ";", 1, true) ~= nil
                        chestNote = opened and " · 봉인 상자 열었음" or " · 끝방에 봉인 상자"
                    end
                end
            end
            -- 심도: 층 번호 (DepthDirector.Floor 동기화)
            if info.kind == "instance" and floor > 0 then title = "심도 " .. tostring(floor) .. "층" end
        end
        if diff > 0 then
            -- 제목 앞에도 난이도를 붙여 보통 맵과 바로 구분되게 (악몽 주황 · 지옥 빨강)
            local tag = _UIKit:Colored(diff == 1 and "#FF9A4D" or "#FF5050", "[" .. _GameConst:DifficultyName(diff) .. "]")
            title = tag .. " " .. title
            if sub ~= "" then sub = sub .. " · " end
            sub = sub .. _GameConst:DifficultyName(diff)
        end
        -- 쓰러진 보스가 다시 나오기까지 남은 시간 (BossRespawn, 10-11)
        local boss = _BossRespawn:LabelFor(mapName)
        if boss ~= "" then chestNote = chestNote .. " · " .. _UIKit:Colored("#FF8A6B", _BossRespawn:OncePerGame() and boss or (boss .. " 뒤 다시 등장")) end
        -- 레벨 표시는 괄호 안 그대로 이름에 붙어 있다 ("피 묻은 황무지 (Lv 1~3)")
        _UIKit:SetText("Banner/Title", title)
        -- 10-22 사용자: 배너 아래 부제(마을·사냥터·봉인 상자·보스 재등장)는 글이 배너 밖으로 넘쳐 뺀다 — 맵 종류·보스 시간은 미니맵 머리글에 있다
        _UIKit:SetText("Banner/Sub", "")
        _UIKit:SetEnabled("Banner/Sub", false)
        -- 맵 한 줄 소개 (maps.csv flavor, docs/design/18 §3-4). 읽을 시간만큼 배너를 더 띄운다
        local flavor = (info ~= nil and info.kind ~= "instance") and (info.flavor or "") or ""
        _UIKit:SetText("Banner/FlavorBg/Text", flavor)
        _UIKit:SetEnabled("Banner/FlavorBg", flavor ~= "")
        _UIKit:SetEnabled("Banner", true)
        self.BannerLength = self.BannerSeconds + (flavor ~= "" and 1.5 or 0)
        self.BannerUntil = _UtilLogic.ElapsedSeconds + self.BannerLength
        self:SetBannerAlpha(1)
        -- 미니맵 머리글은 좁다 (206px): 괄호 속 레벨·부제는 빼고 이름만 ("폭풍의 눈 (등대 꼭대기)"가 두 줄로 넘쳐 「사냥터」와 겹쳤다, 10-11)
        local shortName = string.gsub(title, "%s*%b()", "")
        _UIKit:SetText("MiniMap/Toggle/Name", shortName)
        self.MapSub = sub
        self.BossShown = "-"
        self:RenderBossTimer(mapName)
        self:BuildTerrain(_UserService.LocalPlayer.CurrentMap, info)
        self:BuildMiniMap(info)
        self:UpdateReveal(_Util:Pos2(_UserService.LocalPlayer))
        self:LayoutTerrain()
        self:PlaceFeatures()
        log("[VRF] Navigation ready terrain=" .. tostring(self.TerrainUsed) .. " features=" .. tostring(#self.Features))
        log("[HudMap] 맵 " .. mapName .. " → " .. title)
    end

    @ExecSpace("ClientOnly")
    method void BuildMiniMap(any info)
        -- 원형 미니맵 안에 맵 전체가 들어가게 축소. 표시물 점 색: 포털 하늘·웨이포인트 청록·의뢰 노랑·NPC 흰·입구 보라·제단 빨강·보스 주황
        self.HasQuestNpc = false
        self.NpcPos = {}
        self.Gates = {}
        self.Features = {}
        self.LastFeatureKey = ""
        self.NextFeatureRefresh = _UtilLogic.ElapsedSeconds + self.FeatureRefreshInterval
        if info == nil then
            self.Scale = 8
            for i = 1, self.FeatureCount do _UIKit:SetEnabled("MiniMap/Body/Area/F" .. tostring(i), false) end
            return
        end
        -- 지형에서 계산한 축척을 표식에도 그대로 적용한다. 표식은 그림 대신 색 점 + 짧은 이름 (와우·이모탈 미니맵)
        local n = 0
        local features = self:MapFeatures(_UserService.LocalPlayer.CurrentMap, info)
        self.LastFeatureKey = self:FeatureKey(features)
        for _, f in ipairs(features) do
            table.insert(self.Features, { kind = f.kind, x = f.x, y = f.y, label = f.label, targetMap = f.targetMap or "", waypointId = f.waypointId or "", npcKind = f.npcKind or "" })
            if n < self.FeatureCount then
                n = n + 1
                local path = "MiniMap/Body/Area/F" .. tostring(n)
                _UIKit:SetEnabled(path, true)
                _UIKit:SetIcon(path, _GameData:GetUiIcon(f.kind == "portal" and "minimap_exit" or "dot"))
                _UIKit:SetColor(path, self:FeatureColor(f.kind))
            end
            if (f.kind == "portal" or f.kind == "depth") and (f.label or "") ~= "" then table.insert(self.Gates, { pos = Vector2(f.x, f.y), label = f.label, radius = f.radius or 0.6 }) end
            if f.kind == "quest" then
                self.HasQuestNpc = true
                self.QuestPos = Vector2(f.x, f.y)
            end
            if f.npcKind ~= nil and f.npcKind ~= "" then
                self.NpcPos[f.npcKind] = Vector2(f.x, f.y)
                self.NpcLabel[f.npcKind] = f.label or ""
            end
        end
        for i = n + 1, self.FeatureCount do _UIKit:SetEnabled("MiniMap/Body/Area/F" .. tostring(i), false) end
        self:PlaceFeatures()
    end

    @ExecSpace("ClientOnly")
    method void PlaceFeatures()
        -- 표식 위치 + 이름. 이름끼리 겹치면 덜 중요한 쪽 이름을 숨긴다 (의뢰 > 출구 > 웨이포인트 > 심도 > 보스 > 제단 > NPC)
        self.PlacedCenter = self.ViewCenter
        local order = {}
        for i, f in ipairs(self.Features) do
            if i > self.FeatureCount then break end
            local pos = self:ToMini(Vector2(f.x, f.y))
            local path = "MiniMap/Body/Area/F" .. tostring(i)
            -- 안개 속(아직 안 가본 곳)의 출구·보스·제단 등은 점도 이름도 숨긴다
            local seen = self:IsRevealedPos(Vector2(f.x, f.y))
            _UIKit:SetEnabled(path, seen)
            _UIKit:SetPos(path, pos)
            if seen then table.insert(order, { index = i, f = f, pos = pos, rank = self:FeatureRank(f.kind) }) end
        end
        table.sort(order, function(a, b) if a.rank ~= b.rank then return a.rank < b.rank end return a.index < b.index end)
        local placed = {}
        for _, o in ipairs(order) do
            local label = self:FeatureLabel(o.f)
            -- 원 가장자리에 붙은 표식(멀리 있는 것)은 출구·의뢰만 이름을 단다
            if label ~= "" and o.pos:Magnitude() >= self.MiniRadius - 0.5 and o.f.kind ~= "portal" and o.f.kind ~= "quest" then label = "" end
            if label ~= "" then
                local w = _UIKit:CharCount(label) * 15 + 8
                local cx = o.pos.x
                local cy = o.pos.y - 17
                for _, r in ipairs(placed) do
                    if math.abs(cx - r.x) < (w + r.w) / 2 and math.abs(cy - r.y) < 19 then
                        label = ""
                        break
                    end
                end
                if label ~= "" then table.insert(placed, { x = cx, y = cy, w = w }) end
            end
            _UIKit:SetText("MiniMap/Body/Area/F" .. tostring(o.index) .. "/Label", label)
        end
    end

    method integer FeatureRank(string kind)
        local ranks = { quest = 1, portal = 2, waypoint = 3, depth = 4, boss = 5, altar = 6, npc = 7 }
        return ranks[kind] or 8
    end

    method number ZoomFactor()
        -- 확대 단계별 배율. 2단계(기본)는 맵 전체보다 2배 가까이 보고 나를 따라간다
        local factors = { 1, 2, 3.2 }
        return factors[math.max(1, math.min(3, self.ZoomLevel))]
    end

    @ExecSpace("ClientOnly")
    method void SetZoom(integer level)
        -- + / − 버튼: 1(전체) ~ 3(가까이)
        level = math.max(1, math.min(3, level))
        if level == self.ZoomLevel then return end
        self.ZoomLevel = level
        self.Scale = self.FitScale * self:ZoomFactor()
        self.PlacedCenter = Vector2(99999, 99999)
        local player = _UserService.LocalPlayer
        if isvalid(player) then self:UpdateView(_Util:Pos2(player)) end
        self:LayoutTerrain()
        self:PlaceFeatures()
        self.NextFocusAt = 0
        self:RenderZoomButtons()
        log("[VRF] minimap zoom=" .. tostring(level) .. " scale=" .. string.format("%.2f", self.Scale))
    end

    @ExecSpace("ClientOnly")
    method void RenderZoomButtons()
        -- 끝 단계 버튼은 흐리게
        _UIKit:SetText("MiniMap/Body/ZoomIn/Text", self.ZoomLevel >= 3 and "<color=#6E6658>+</color>" or "+")
        _UIKit:SetText("MiniMap/Body/ZoomOut/Text", self.ZoomLevel <= 1 and "<color=#6E6658>−</color>" or "−")
    end

    @ExecSpace("ClientOnly")
    method void UpdateView(Vector2 me)
        -- 전체 보기는 맵 가운데 고정, 확대하면 내 위치를 가운데로 (지형은 묶음째 옮긴다)
        local center = self.ZoomLevel <= 1 and self.MapCenter or me
        self.ViewCenter = center
        if (center - self.PlacedCenter):Magnitude() > 0.05 then
            self:LayoutTerrain()
            self:PlaceFeatures()
        end
    end

    method Color FeatureColor(string kind)
        -- 출구 빨강 · 의뢰 노랑 · 웨이포인트 파랑 · NPC 흰색 · 심도 보라 · 제단 주황 · 보스 진홍
        if kind == "portal" then return Color(1, 0.35, 0.29, 1) end
        if kind == "quest" then return Color(1, 0.82, 0.25, 1) end
        if kind == "waypoint" then return Color(0.44, 0.7, 1, 1) end
        if kind == "depth" then return Color(0.72, 0.45, 1, 1) end
        if kind == "altar" then return Color(1, 0.6, 0.25, 1) end
        if kind == "boss" then return Color(0.9, 0.15, 0.2, 1) end
        return Color(0.91, 0.88, 0.83, 1)
    end

    method string FeatureLabel(table f)
        -- 점 아래 짧은 이름: 출구는 갈 곳(레벨 표기 뺌), NPC는 이름 끝말, 나머지는 종류
        local label = f.label or ""
        if f.kind == "portal" then
            label = string.gsub(label, "%s*%(Lv[^%)]*%)", "")
            return _UIKit:Clip(label, 6)
        end
        if f.kind == "npc" or f.kind == "quest" then
            local last = string.match(label, "(%S+)$") or label
            return f.kind == "quest" and ("! " .. last) or last
        end
        if f.kind == "waypoint" then return "웨이포인트" end
        if f.kind == "depth" then return (f.label ~= nil and f.label ~= "") and f.label or "심도" end
        if f.kind == "altar" then return "제단" end
        if f.kind == "boss" then return "보스" end
        return ""
    end

    method string FeatureKey(table features)
        -- 생성·소멸·이동·소유권 동기화를 감지하되 엔티티 열거 순서 변화만으로 다시 그리지 않는다.
        local keys = {}
        for _, f in ipairs(features) do
            table.insert(keys, table.concat({ f.kind, tostring(f.x), tostring(f.y), f.label or "", f.targetMap or "", f.waypointId or "", tostring(f.radius or 0.6) }, "|"))
        end
        table.sort(keys)
        return table.concat(keys, "\n")
    end

    @ExecSpace("ClientOnly")
    method void RefreshFeatures(Entity map)
        -- 늦게 생기는 귀환 포털과 파티 변경을 반영한다. 지형은 다시 계산하지 않는다.
        local now = _UtilLogic.ElapsedSeconds
        if now < self.NextFeatureRefresh then return end
        self.NextFeatureRefresh = now + self.FeatureRefreshInterval
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        if info == nil then return end
        local features = self:MapFeatures(map, info)
        if self:FeatureKey(features) == self.LastFeatureKey then return end
        self:BuildMiniMap(info)
        log("[VRF] Navigation features refreshed map=" .. map.Name .. " features=" .. tostring(#self.Features))
    end

    @ExecSpace("ClientOnly")
    method table MapFeatures(Entity map, any info)
        -- 메이커에서 옮긴 배치도 현재 맵의 실제 엔티티 위치로 표시한다.
        local result = {}
        local liveKinds = {}
        local player = _UserService.LocalPlayer
        for _, spec in ipairs({ { "script.WarpGate", "portal" }, { "script.WorldNPC", "npc" }, { "script.Waypoint", "waypoint" }, { "script.QuestMarker", "altar" }, { "script.DepthGate", "depth" } }) do
            for _, component in ipairs(map:GetChildComponentsByTypeName(spec[1], true)) do
                -- 숨겨진 심도 문(해금 전)도 「실제 문이 있다」로 쳐서 맵 표의 고정 표식이 대신 나오지 않게 한다 (10-20 점검: Lv1에 「심도」 점이 보였다)
                if isvalid(component.Entity) and spec[2] == "depth" then liveKinds["depth"] = true end
                -- 이야기 진행으로 숨긴 마을 사람(StoryPresence — 다른 마을로 떠난 오렌 등)도 맵 표의 고정 「! 오렌」이 대신 나오지 않게 한다
                if isvalid(component.Entity) and spec[2] == "npc" then
                    liveKinds["npc"] = true
                    liveKinds["quest"] = true
                end
                if isvalid(component.Entity) and component.Entity.Enable then
                    local kind = spec[2]
                    local label = ""
                    local target = ""
                    local waypointId = ""
                    local radius = 0.6
                    local show = true
                    local npcKind = ""
                    if kind == "portal" then
                        label = _GameConst:LevelText(component.Label, map.Name)
                        target = component.TargetMap
                        radius = component.Radius
                        show = component:CanUse(player)
                    elseif kind == "npc" then
                        npcKind = component.Kind
                        kind = component.Kind == "quest" and "quest" or "npc"
                        label = component.NpcName
                    elseif kind == "waypoint" then
                        waypointId = component.WaypointId
                    elseif kind == "depth" then
                        -- 심도 문: 마을 입구는 「심도 입구」, 심도 안에서는 「심도 N층」(더 깊이) · 「야영지」(귀환)
                        label = component.Label ~= "" and component.Label or (component.Action == "enter" and "심도 입구" or "")
                    end
                    if show then
                        local pos = _Util:Pos2(component.Entity)
                        table.insert(result, { kind = kind, x = pos.x, y = pos.y, label = label, targetMap = target, waypointId = waypointId, radius = radius, npcKind = npcKind })
                        liveKinds[kind] = true
                    end
                end
            end
        end
        -- 보스 자리는 맵 표의 고정 표시라, 쓰러져 다시 나오기를 기다리는 동안(머리글에 「이름 0:28」)은 뺀다 (10-13 지적)
        local bossDown = _BossRespawn:LabelFor(map.Name) ~= ""
        for _, f in ipairs(info.features) do
            if not liveKinds[f.kind] and not (f.kind == "boss" and bossDown) then table.insert(result, f) end
        end
        return result
    end

    -- 실제 타일의 통행 가능한 구간을 가로로 합치고, 같은 구간은 세로로 병합한다.
    -- 맵 진입 때 한 번만 계산하며 점/이름보다 뒤에 표시한다.
    @ExecSpace("ClientOnly")
    method void BuildTerrain(Entity map, any info)
        self.TerrainUsed = 0
        self.TerrainRects = {}
        for i = 1, self.TerrainCount do _UIKit:SetEnabled("MiniMap/Body/Area/Terrain/Pan/R" .. tostring(i), false) end
        if info == nil or not isvalid(map) then return end
        local tiles = map:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        if tiles == nil then return end
        -- 실제 타일 목록의 양끝을 포함해 CSV 크기 밖 지형과 최상단도 누락하지 않는다.
        self.MapCenter = Vector2(0, 0)
        self.TerrainRects = {}
        self.FitScale = self:FitMiniScale(info.w, info.h)
        self.Scale = self.FitScale * self:ZoomFactor()
        local positions = tiles:GetAllTilePositions()
        local low = nil
        local high = nil
        for _, cell in ipairs(positions) do
            if low == nil then low = Vector2Int(cell.x, cell.y) high = Vector2Int(cell.x, cell.y) end
            low = Vector2Int(math.min(low.x, cell.x), math.min(low.y, cell.y))
            high = Vector2Int(math.max(high.x, cell.x), math.max(high.y, cell.y))
        end
        if low == nil then return end
        local grid = tiles.GridSize
        local a = tiles:ToWorldPosition(low)
        local z = tiles:ToWorldPosition(high)
        self.MapCenter = Vector2((a.x + z.x) / 2, (a.y + z.y) / 2)
        self.FitScale = self:FitMiniScale((high.x - low.x + 1) * grid.x, (high.y - low.y + 1) * grid.y)
        self.Scale = self.FitScale * self:ZoomFactor()
        self.ViewCenter = self.MapCenter
        -- 안개 칸 단위로 나눠 합친다 (칸마다 따로 켜고 끄려고). 사각형이 슬롯보다 많으면 칸을 키운다
        local ct = math.max(1, math.floor(self.RevealCell / math.max(0.01, grid.x) + 0.5))
        local rects = self:ChunkRects(tiles, low.x, low.y, high.x, high.y, ct)
        if #rects > self.TerrainCount then
            ct = ct * 2
            rects = self:ChunkRects(tiles, low.x, low.y, high.x, high.y, ct)
        end
        self.BlockSize = ct * grid.x
        local blocks = {}
        local seenBlock = {}
        for _, r in ipairs(rects) do
            if not seenBlock[r.block] then
                seenBlock[r.block] = true
                local c = tiles:ToWorldPosition(Vector2Int(r.bx, r.by))
                -- 칸 가운데 = 칸 첫 타일 + (칸 크기 - 1)/2 타일
                table.insert(blocks, { key = r.block, x = c.x + (ct - 1) * grid.x / 2, y = c.y + (ct - 1) * grid.y / 2 })
            end
        end
        self.Blocks = blocks
        self.RevealAll = info.kind == "town"
        for i, r in ipairs(rects) do
            if i > self.TerrainCount then log_warning("[HudMap] terrain capacity exceeded " .. tostring(#rects)) break end
            local a = tiles:ToWorldPosition(Vector2Int(r.x1, r.y1))
            local z = tiles:ToWorldPosition(Vector2Int(r.x2, r.y2))
            table.insert(self.TerrainRects, { x = (a.x + z.x) / 2, y = (a.y + z.y) / 2, w = (r.x2 - r.x1 + 1) * grid.x, h = (r.y2 - r.y1 + 1) * grid.y, block = r.block })
            local e = _UIKit:Get("MiniMap/Body/Area/Terrain/Pan/R" .. tostring(i))
            if isvalid(e) then
                -- 실제 화면에서 검증한 사각 바닥 타일을 Simple로 그려 둥근 점 늘림을 피한다.
                local sprite = e:GetComponent("MOD.Core.SpriteGUIRendererComponent")
                if isvalid(sprite) then
                    -- 돌 무늬가 그대로 보이면 지도가 아니라 바닥 그림처럼 읽혔다. 어두운 게임 화면에 맞춰 낮게 누른다
                    sprite.Color = Color(0.38, 0.34, 0.42, 0.92)
                end
                e.Enable = true
                self.TerrainUsed = i
            end
        end
        self:LayoutTerrain()
    end

    @ExecSpace("ClientOnly")
    method void LayoutTerrain()
        -- 바닥 사각형을 지금 보는 가운데 기준으로 놓고 테두리 사각형(±TerrainHalf) 안으로 자른다.
        -- (메이커 원형 마스크는 자식을 자르지 못했다) 원 밖 모서리는 위에 덮인 테두리 그림이 가린다
        local half = self.TerrainHalf
        for i, r in ipairs(self.TerrainRects) do
            if i > self.TerrainUsed then break end
            local e = _UIKit:Get("MiniMap/Body/Area/Terrain/Pan/R" .. tostring(i))
            if isvalid(e) then
                local cx = (r.x - self.ViewCenter.x) * self.Scale
                local cy = (r.y - self.ViewCenter.y) * self.Scale
                local x1 = math.max(-half, cx - r.w * self.Scale / 2)
                local x2 = math.min(half, cx + r.w * self.Scale / 2)
                local y1 = math.max(-half, cy - r.h * self.Scale / 2)
                local y2 = math.min(half, cy + r.h * self.Scale / 2)
                local visible = x2 > x1 + 0.5 and y2 > y1 + 0.5 and self:IsRevealedBlock(r.block)
                if e.Enable ~= visible then e.Enable = visible end
                if visible then
                    e.UITransformComponent.RectSize = Vector2(x2 - x1, y2 - y1)
                    e.UITransformComponent.anchoredPosition = Vector2((x1 + x2) / 2, (y1 + y2) / 2)
                end
            end
        end
    end

    method table ChunkRects(any tiles, integer lowX, integer lowY, integer highX, integer highY, integer ct)
        -- ct×ct 타일 칸마다 통행 가능한 구간을 가로로 합치고 같은 구간은 세로로 병합한다 (칸을 넘지 않게)
        local rects = {}
        local by = lowY
        while by <= highY do
            local yEnd = math.min(highY, by + ct - 1)
            local bx = lowX
            while bx <= highX do
                local xEnd = math.min(highX, bx + ct - 1)
                local block = tostring(bx) .. ":" .. tostring(by)
                local active = {}
                for y = by, yEnd do
                    local nextActive = {}
                    local start = nil
                    for x = bx, xEnd + 1 do
                        local tile = x <= xEnd and tiles:GetTile(Vector2Int(x, y)) or nil
                        local floor = tile ~= nil and not tile.IsCollidable
                        if floor and start == nil then start = x end
                        if not floor and start ~= nil then
                            local key = tostring(start) .. ":" .. tostring(x - 1)
                            local r = active[key]
                            if r == nil then
                                r = { x1 = start, x2 = x - 1, y1 = y, y2 = y, block = block, bx = bx, by = by }
                                table.insert(rects, r)
                            else r.y2 = y end
                            nextActive[key] = r
                            start = nil
                        end
                    end
                    active = nextActive
                end
                bx = bx + ct
            end
            by = by + ct
        end
        return rects
    end

    method any RevealSet()
        -- 지금 맵의 밝혀진 칸 (심도는 층마다 따로)
        if self.Revealed == nil then self.Revealed = {} end
        local key = self.LastMap .. "#" .. tostring(self.ShownFloor)
        local set = self.Revealed[key]
        if set == nil then
            set = {}
            self.Revealed[key] = set
        end
        return set
    end

    method boolean UpdateReveal(Vector2 me)
        -- 내 주변 칸을 밝힌다. 새로 밝혀진 칸이 있으면 true
        if self.RevealAll or self.Blocks == nil then return false end
        local set = self:RevealSet()
        local changed = false
        local r = self.RevealRadius + self.BlockSize * 0.5
        for _, b in ipairs(self.Blocks) do
            if not set[b.key] and math.abs(b.x - me.x) <= r and math.abs(b.y - me.y) <= r then
                local dx = b.x - me.x
                local dy = b.y - me.y
                if dx * dx + dy * dy <= r * r then
                    set[b.key] = true
                    changed = true
                end
            end
        end
        return changed
    end

    method boolean IsRevealedBlock(string key)
        if self.RevealAll or key == nil then return true end
        return self:RevealSet()[key] == true
    end

    method boolean IsRevealedPos(Vector2 p)
        -- 밝혀진 칸 안(또는 바로 옆)에 있는 위치인가 — 벽 위의 출구처럼 칸 밖 표시물도 가까운 칸을 따른다
        if self.RevealAll or self.Blocks == nil then return true end
        local set = self:RevealSet()
        local reach = self.BlockSize * 0.75
        for _, b in ipairs(self.Blocks) do
            if set[b.key] and math.abs(b.x - p.x) <= reach and math.abs(b.y - p.y) <= reach then return true end
        end
        return false
    end

    method number FitMiniScale(number width, number height)
        -- 지도 사각형의 네 모서리까지 원 안에 들어오도록 대각선 길이로 균일 축소한다.
        width = math.max(1, width)
        height = math.max(1, height)
        return self.MiniRadius * 2 / math.sqrt(width * width + height * height)
    end

    method Vector2 ToMini(Vector2 world)
        -- 원 밖으로 생성되는 임시 포털도 같은 방향의 원 가장자리에서 찾을 수 있다.
        local x = (world.x - self.ViewCenter.x) * self.Scale
        local y = (world.y - self.ViewCenter.y) * self.Scale
        local distance = math.sqrt(x * x + y * y)
        if distance > self.MiniRadius then
            x = x * self.MiniRadius / distance
            y = y * self.MiniRadius / distance
        end
        return Vector2(x, y)
    end

    @ExecSpace("ClientOnly")
    method void ToggleMap()
        -- 지도는 전투 입력을 가로막는 창 대신 접을 수 있는 HUD로 남긴다.
        if _UIKit:AnyWindowOpen() then return end
        self.Expanded = not self.Expanded
        self:RenderLayout()
    end

    @ExecSpace("ClientOnly")
    method boolean ShouldShowQuestTrack()
        -- 모바일에서 지도와 의뢰가 같은 손 영역을 겹쳐 차지하지 않게 한다.
        if _UIKit:AnyWindowOpen() then return false end
        if not Environment:IsMobilePlatform() then return true end
        return not self:InMobileCombat()
    end

    @ExecSpace("ClientOnly")
    method boolean InMobileCombat()
        -- 모바일 작은 화면: 근처(4.5칸)에 적이 있으면 의뢰 추적·일지 버튼을 접어 시야를 넓힌다. 전투가 끝나고 2초 뒤 다시 보인다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return false end
        local now = _UtilLogic.ElapsedSeconds
        if _Util:NearestMonster(player.CurrentMap, _Util:Pos2(player), 4.5) ~= nil then self.CombatUntil = now + 2 end
        return now < self.CombatUntil
    end

    @ExecSpace("ClientOnly")
    method void RenderLayout()
        -- 매 프레임 위치를 쓰지 않고 플랫폼·펼침 상태가 바뀔 때만 배치한다.
        local mobile = Environment:IsMobilePlatform()
        local key = tostring(mobile) .. ":" .. tostring(self.Expanded)
        if key ~= self.LayoutKey then
            self.LayoutKey = key
            local map = _UIKit:Get("MiniMap")
            local track = _UIKit:Get("QuestTrack")
            -- 모바일 (디아블로 이모탈식, docs/ui/mobile-layout.md): 지도는 오른쪽 위(엔진 친구·메뉴 단추 아래), 의뢰 추적은 왼쪽 위 캐릭터 틀·버프 아래.
            -- 지도를 펼쳐도 의뢰 추적은 그대로 (같은 열이 아니다)
            if isvalid(map) then
                local t = map.UITransformComponent
                t.AlignmentOption = AlignmentType.TopRight
                t.Pivot = Vector2(1, 1)
                t.anchoredPosition = mobile and Vector2(-24, -120) or Vector2(-24, -150)
                -- 모바일: 범례·「다음 길」 줄을 빼서(의뢰 추적·여정 안내가 같은 내용) 펼친 높이 394, 0.75배 → 아래 끝이 위 416.
                -- 그 아래에 안내 줄 두 줄이 스킬 호 위로 들어간다 (아이폰 가로 높이 1025 기준, tools/check_mobile_layout.cjs)
                t.RectSize = Vector2(344, self.Expanded and (mobile and 394 or 488) or 104)
                local k = mobile and 0.75 or 1
                t.UIScale = Vector3(k, k, 1)
                local body = _UIKit:Get("MiniMap/Body")
                if isvalid(body) then body.UITransformComponent.RectSize = Vector2(344, mobile and 290 or 384) end
                for i = 0, 3 do _UIKit:SetEnabled("MiniMap/Body/Legend" .. tostring(i), not mobile) end
                _UIKit:SetEnabled("MiniMap/Body/FocusText", not mobile)
            end
            if isvalid(track) then
                local t = track.UITransformComponent
                t.AlignmentOption = mobile and AlignmentType.TopLeft or AlignmentType.TopRight
                t.Pivot = mobile and Vector2(0, 1) or Vector2(1, 1)
                t.anchoredPosition = mobile and Vector2(24, -196) or Vector2(-24, self.Expanded and -658 or -270)
            end
            -- 모바일 일지 단추는 오른쪽 위 메뉴 단추 왼쪽 (이모탈의 가방·메뉴 아이콘 줄). 의뢰 추적 옆에 두면 위 가운데 안내와 겹쳤다
            local journal = _UIKit:Get("JournalOpen")
            if isvalid(journal) and mobile then
                local t = journal.UITransformComponent
                t.AlignmentOption = AlignmentType.TopRight
                t.Pivot = Vector2(1, 1)
                t.anchoredPosition = Vector2(-410, -120)
            end
            _UIKit:SetText("MiniMap/Toggle/Hint", self.Expanded and "−" or "+")
        end
        _UIKit:SetEnabled("MiniMap", not _UIKit:AnyWindowOpen())
        _UIKit:SetEnabled("MiniMap/Body", self.Expanded)
        _UIKit:SetEnabled("QuestTrack", self:ShouldShowQuestTrack() and _HudMain.QuestTrackKey ~= _HudMain.QuestTrackSeen)   -- 눌러서 닫은 의뢰 카드는 다시 띄우지 않는다
    end

    method string QuestMap(integer index, integer state)
        -- 목표 맵은 의뢰 데이터의 map(열쇠 단계는 map1), 수락·완료 보고는 야영지로 안내한다.
        local q = _QuestData:Get(index)
        if q == nil then return "" end
        if state ~= 1 then return _GameConst:TownOfAct(math.floor(q.act or 1)) end
        local player = _UserService.LocalPlayer
        ---@type PlayerQuest
        local quest = isvalid(player) and player:GetComponent("script.PlayerQuest") or nil
        if quest ~= nil and quest.Index == index then return quest:GoalMap(q) end
        return q.map
    end

    method string NextRoute(string startMap, string goalMap)
        return self:Route(startMap, goalMap).first
    end

    method table Route(string startMap, string goalMap)
        -- 포털 목적지 그래프를 너비 우선 탐색해 가장 짧은 경로의 첫 출구를 찾는다.
        startMap = _GameConst:BaseMapName(startMap)
        goalMap = _GameConst:BaseMapName(goalMap)
        if goalMap == "" then return { first = "", steps = -1 } end
        if startMap == goalMap then return { first = "", steps = 0 } end
        local queue = { { name = startMap, first = "", steps = 0 } }
        local seen = { [startMap] = true }
        local head = 1
        while head <= #queue do
            local node = queue[head]
            head = head + 1
            local info = _GameData:GetMapInfo(node.name)
            if info ~= nil then
                for _, f in ipairs(info.features) do
                    local target = _GameConst:BaseMapName(f.targetMap or "")
                    if f.kind == "portal" and target ~= "" and not seen[target] then
                        local first = node.first == "" and target or node.first
                        if target == goalMap then return { first = first, steps = node.steps + 1 } end
                        seen[target] = true
                        table.insert(queue, { name = target, first = first, steps = node.steps + 1 })
                    end
                end
            end
        end
        return { first = "", steps = -1 }
    end

    @ExecSpace("ClientOnly")
    method string RecommendedWaypoint(string startMap, string goalMap, PlayerTravel travel)
        if travel == nil or goalMap == "" then return "" end
        startMap = _GameConst:BaseMapName(startMap)
        goalMap = _GameConst:BaseMapName(goalMap)
        local key = startMap .. "|" .. goalMap .. "|" .. travel.Known
        if self.RouteKey == key then return self.RouteWaypoint end
        self.RouteKey = key
        self.RouteWaypoint = ""
        local best = self:Route(startMap, goalMap).steps
        if best == 0 then return "" end
        if best < 0 then best = math.huge end
        -- 거점 이동도 한 번의 전환으로 계산한다. 같은 거리라면 걷는 길을 유지한다.
        for _, w in ipairs(_WaypointData:GetList()) do
            if w.map ~= startMap and travel:IsKnown(w.id) then
                local remaining = self:Route(w.map, goalMap).steps
                if remaining >= 0 and remaining + 1 < best then
                    best = remaining + 1
                    self.RouteWaypoint = w.id
                end
            end
        end
        return self.RouteWaypoint
    end

    @ExecSpace("ClientOnly")
    method void RenderFocus(Entity player)
        -- 현재 의뢰에 필요한 NPC·제단 또는 다음 지역의 출구 하나만 강조한다.
        local quest = player:GetComponent("script.PlayerQuest")
        local focused = nil
        local text = ""
        if quest ~= nil then
            local goal = self:QuestMap(quest.Index, quest.State)
            local current = _GameConst:BaseMapName(player.CurrentMap.Name)
            local nextMap = self:NextRoute(current, goal)
            local q = _QuestData:Get(quest.Index)
            ---@type PlayerTravel
            local travel = player:GetComponent("script.PlayerTravel")
            local waypoint = _WaypointData:Get(self:RecommendedWaypoint(current, goal, travel))
            -- 실제로 사용할 수 있는 이 맵의 거점을 강조한다. 없는 맵에서는 출구 안내를 유지한다.
            if waypoint ~= nil then
                for _, f in ipairs(self.Features) do
                    if f.kind == "waypoint" and f.waypointId ~= "" and travel:IsKnown(f.waypointId) then
                        focused = f
                        text = "웨이포인트 이동: " .. waypoint.name
                        break
                    end
                end
            end
            for _, f in ipairs(self.Features) do
                if focused ~= nil then break end
                if nextMap ~= "" and f.kind == "portal" and _GameConst:BaseMapName(f.targetMap or "") == nextMap then
                    focused = f
                    text = "다음 길: " .. string.gsub(f.label, "%s*%(Lv[^%)]*%)", "")
                    break
                elseif current == goal and quest.State ~= 1 and q ~= nil and f.kind ~= "portal" and f.npcKind == q.giver then
                    focused = f
                    text = "대화: " .. _QuestData:GiverName(q.giver)
                    break
                elseif current == goal and quest.State == 1 and q ~= nil and (q.kind == "reach" or q.kind == "ritual") and f.kind == "altar" then
                    focused = f
                    text = "목표: 피의 제단"
                    break
                end
            end
            -- 정리 맵에서 5마리 이하로 남으면 가장 가까운 남은 몬스터를 가리킨다 (구석에 낀 몬스터 때문에 못 끝내지 않게)
            local remain = self:RemainingFocus(player)
            if remain ~= nil then
                focused = remain
                text = "남은 망자 " .. tostring(remain.count) .. " — 가까운 곳 표시"
            end
            if text == "" and q ~= nil then
                text = current == goal and "이 지역에서 의뢰 진행" or "목표: " .. (_GameConst:IsTownName(goal) and _GameConst:ActTownName(math.floor(q.act or 1)) or quest:StepZone(q))
            end
        end
        if text == "" then text = "출구와 웨이포인트를 찾으세요" end
        _UIKit:SetText("MiniMap/Body/FocusText", text)
        -- 목표 원은 그 자리가 밝혀졌을 때만 (안개 속 보스·제단 위치를 미리 알려 주지 않게). 안내 문구는 그대로
        if focused ~= nil and not focused.always and not self:IsRevealedPos(Vector2(focused.x, focused.y)) then focused = nil end
        _UIKit:SetEnabled("MiniMap/Body/Area/Focus", focused ~= nil)
        if focused ~= nil then _UIKit:SetPos("MiniMap/Body/Area/Focus", self:ToMini(Vector2(focused.x, focused.y))) end
    end

    @ExecSpace("ClientOnly")
    method any RemainingFocus(Entity player)
        -- 정리 맵(MonsterSpawner.ClearMode)이고 남은 수가 1~5면 가장 가까운 살아 있는 몬스터 위치
        local map = player.CurrentMap
        if not isvalid(map) then return nil end
        ---@type MonsterSpawner
        local spawner = map:GetFirstChildComponentByTypeName("script.MonsterSpawner", true)
        if spawner == nil or not spawner.ClearMode or spawner.Remaining <= 0 or spawner.Remaining > 5 then return nil end
        local me = _Util:Pos2(player)
        local best = nil
        local bestD = 9999
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local m = c
            if isvalid(m.Entity) and not m.IsDead then
                local p = _Util:Pos2(m.Entity)
                local d = (p - me):Magnitude()
                if d < bestD then
                    best = p
                    bestD = d
                end
            end
        end
        if best == nil then return nil end
        return { x = best.x, y = best.y, count = spawner.Remaining, always = true }
    end

    -- ───────── 맵 이름 ─────────

    @ExecSpace("ClientOnly")
    method void RestartBanner()
        -- 이동 화면에 가려 있던 동안 흘러간 배너 시간을 되돌린다 (걷히는 순간부터 처음부터)
        if self.BannerLength <= 0 then return end
        self.BannerUntil = _UtilLogic.ElapsedSeconds + self.BannerLength
        _UIKit:SetEnabled("Banner", true)
        self:SetBannerAlpha(1)
    end

    @ExecSpace("ClientOnly")
    method boolean BannerShowing()
        -- 위쪽 가운데는 한 번에 하나 (docs/ui/message-rules.md): 맵 배너가 떠 있는 동안 여정 안내·출구 안내는 기다린다
        return self.BannerUntil > _UtilLogic.ElapsedSeconds
    end

    @ExecSpace("ClientOnly")
    method void TickBanner()
        if self.BannerUntil <= 0 then return end
        local left = self.BannerUntil - _UtilLogic.ElapsedSeconds
        if left <= 0 then
            self.BannerUntil = 0
            _UIKit:SetEnabled("Banner", false)
            return
        end
        -- 마지막 0.6초 동안 흐려진다
        if left < 0.6 then self:SetBannerAlpha(left / 0.6) end
    end

    @ExecSpace("ClientOnly")
    method void ShowAlert(string title, string line, number seconds)
        -- 맵 배너 자리(위쪽 가운데)에 급한 사건 안내: 붉은 제목 + 한 줄 (재의 왕이 깨어난 4장 — AshAwakening). 맵 배너처럼 끝에 흐려진다
        _UIKit:SetText("Banner/Title", _UIKit:Colored("#FF5A46", title))
        _UIKit:SetText("Banner/Sub", "")
        _UIKit:SetEnabled("Banner/Sub", false)
        _UIKit:SetText("Banner/FlavorBg/Text", line)
        _UIKit:SetEnabled("Banner/FlavorBg", line ~= "")
        _UIKit:SetEnabled("Banner", true)
        self.BannerLength = seconds
        self.BannerUntil = _UtilLogic.ElapsedSeconds + seconds
        self:SetBannerAlpha(1)
    end

    @ExecSpace("ClientOnly")
    method void SetBannerAlpha(number a)
        for _, path in ipairs({ "Banner/Title", "Banner/Sub", "Banner/FlavorBg/Text" }) do
            local e = _UIKit:Get(path)
            if isvalid(e) then
                local c = e.TextGUIRendererComponent.FontColor
                e.TextGUIRendererComponent.FontColor = Color(c.r, c.g, c.b, a)
            end
        end
        local bg = _UIKit:Get("Banner/FlavorBg")
        if isvalid(bg) then bg.SpriteGUIRendererComponent.Color = Color(0, 0, 0, 0.6 * a) end
    end

    -- ───────── 파티·의뢰 표시 ─────────

    @ExecSpace("ClientOnly")
    method void RenderParty(Entity player)
        -- 같은 맵에 있는 파티원 (최대 3명)
        ---@type PlayerSocial
        local social = _UIKit:Comp("script.PlayerSocial")
        local n = 0
        if social ~= nil then
            for userId in string.gmatch(social.PartyDigest, "([^|;]+)|[^|;]+|%d+") do
                if n < 3 and userId ~= player.PlayerComponent.UserId then
                    local other = _UserService:GetUserEntityByUserId(userId)
                    if isvalid(other) and other.CurrentMap == player.CurrentMap then
                        n = n + 1
                        local path = "MiniMap/Body/Area/P" .. tostring(n)
                        _UIKit:SetEnabled(path, true)
                        _UIKit:SetPos(path, self:ToMini(_Util:Pos2(other)))
                    end
                end
            end
        end
        for i = n + 1, 3 do _UIKit:SetEnabled("MiniMap/Body/Area/P" .. tostring(i), false) end
    end

    @ExecSpace("ClientOnly")
    method void RenderGates(Entity player)
        -- D2처럼 출구 위에 갈 곳 이름: 가까운 포털(9칸 안)만, 최대 4개. 화면 밖이면 숨김
        if _UIKit:AnyWindowOpen() then
            for i = 1, 4 do _UIKit:SetEnabled("Gate" .. tostring(i), false) end
            _UIKit:SetEnabled("GatePrompt", false)
            return
        end
        local root = _UIKit:Get("/ui/GameHUD")
        if not isvalid(root) then return end
        local me = _Util:Pos2(player)
        local n = 0
        local nearest = nil
        local nearestDist = math.huge
        for _, g in ipairs(self.Gates) do
            local d = (g.pos - me):Magnitude()
            if d <= math.max(1.8, (g.radius or 0.6) + 0.8) and d < nearestDist then
                nearestDist = d
                nearest = g
            end
            if n < 4 and d <= self.GateLabelRange then
                local screen = _UILogic:WorldToScreenPosition(g.pos + Vector2(0, 1.3))
                local ui = _UILogic:ScreenToLocalUIPosition(screen, root.UITransformComponent)
                -- 화면 밖 출구를 임의의 화면 안 위치에 붙이지 않는다. 바깥 방향은 미니맵으로 안내한다.
                if ui.x >= -760 and ui.x <= 760 and ui.y >= -230 and ui.y <= 380 then
                    n = n + 1
                    local path = "Gate" .. tostring(n)
                    _UIKit:SetEnabled(path, true)
                    _UIKit:SetText(path, "▼ " .. g.label)
                    _UIKit:SetPos(path, ui)
                end
            end
        end
        for i = n + 1, 4 do _UIKit:SetEnabled("Gate" .. tostring(i), false) end
        -- 전투 중에는 실제 이동 반경 바로 앞에서만 큰 배너를 띄운다. 포털 이름은 계속 유지한다.
        _UIKit:SetEnabled("GatePrompt", self:ShouldShowGatePrompt(player, nearest, nearestDist))
        if nearest ~= nil then _UIKit:SetText("GatePrompt/Text", "출구: " .. nearest.label .. " — 들어서면 이동") end
    end

    @ExecSpace("ClientOnly")
    method boolean ShouldShowGatePrompt(Entity player, any gate, number distance)
        -- 보상·사망 알림과 근처 적의 공격을 먼저 읽게 하되, 출구에 들어서기 직전에는 이동을 알린다.
        if gate == nil or _UIKit:AnyWindowOpen() or _UXFeedback:IsShowing() or self:BannerShowing() then return false end
        if distance > math.max(1.8, (gate.radius or 0.6) + 0.8) then return false end
        if distance <= (gate.radius or 0.6) + 0.4 then return true end
        return _Util:NearestMonster(player.CurrentMap, _Util:Pos2(player), 4) == nil
    end

    @ExecSpace("ClientOnly")
    method void RenderCheerMarks(Entity player)
        -- 액트 보스를 쓰러뜨린 뒤 마을 사람 머리 위 주황 「!」 — 격려 한마디를 아직 듣지 않은 사람 (docs/design/31 §7).
        -- 의뢰 「!」(NpcMark)가 떠 있는 의뢰인은 겹치지 않게 뺀다. 화면 밖 사람은 표시하지 않는다
        local n = 0
        local map = player.CurrentMap
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        local root = _UIKit:Get("/ui/GameHUD")
        local info = isvalid(map) and _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name)) or nil
        if quest ~= nil and isvalid(root) and info ~= nil and info.kind == "town" and not _UIKit:AnyWindowOpen() then
            local act = _GameConst:ActOfMap(map.Name)
            local q = _QuestData:Get(quest.Index)
            local half = root.UITransformComponent.RectSize * 0.5
            for _, c in ipairs(map:GetChildComponentsByTypeName("script.WorldNPC", true)) do
                ---@type WorldNPC
                local npc = c
                local giverMark = q ~= nil and q.giver == npc.Kind and quest.State ~= 1
                if n < self.CheerMarkCount and npc.Entity.Enable and not giverMark and quest:CheerWaiting(act, npc.Kind) then
                    local screen = _UILogic:WorldToScreenPosition(_Util:Pos2(npc.Entity) + Vector2(0, 1.35))
                    local ui = _UILogic:ScreenToLocalUIPosition(screen, root.UITransformComponent)
                    if math.abs(ui.x) < half.x - 40 and math.abs(ui.y) < half.y - 40 then
                        n = n + 1
                        local bob = math.sin(_UtilLogic.ElapsedSeconds * 4 + n) * 6
                        _UIKit:SetEnabled("CheerMark" .. tostring(n), true)
                        _UIKit:SetPos("CheerMark" .. tostring(n), Vector2(ui.x, ui.y + bob))
                    end
                end
            end
        end
        for i = n + 1, self.CheerMarkCount do _UIKit:SetEnabled("CheerMark" .. tostring(i), false) end
    end

    @ExecSpace("ClientOnly")
    method void RenderNpcMark(Entity player)
        -- 의뢰 NPC 머리 위 「!」: 새 의뢰 = 노랑, 완료 보고 = 초록 (진행 중에는 없음). 위아래로 살짝 흔들림
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        local color = nil
        if _UIKit:AnyWindowOpen() then _UIKit:SetEnabled("NpcMark", false) return end
        local q = quest ~= nil and _QuestData:Get(quest.Index) or nil
        local giverPos = q ~= nil and self.NpcPos[q.giver] or nil
        if giverPos ~= nil then
            if quest.State == 0 then color = Color(1, 0.82, 0.25, 1) elseif quest.State == 2 then color = Color(0.45, 1, 0.45, 1) end
        end
        if color == nil then
            _UIKit:SetEnabled("NpcMark", false)
            return
        end
        -- 월드 → 화면 → GameHUD 루트 기준 좌표 (NpcMark는 루트 가운데 기준)
        local root = _UIKit:Get("/ui/GameHUD")
        if not isvalid(root) then return end
        local screen = _UILogic:WorldToScreenPosition(giverPos + Vector2(0, 1.35))
        local ui = _UILogic:ScreenToLocalUIPosition(screen, root.UITransformComponent)
        local bob = math.sin(_UtilLogic.ElapsedSeconds * 4) * 6
        -- NPC가 화면 밖이면 「!」를 화면 가장자리에 화살표 + 이름과 함께 둔다 (10-11 QA: 왼쪽 위 버프 줄 밑에 「!」만 덩그러니 떠서 무엇인지 몰랐다)
        -- 위쪽은 버프 줄(위 34~94px), 오른쪽은 미니맵·의뢰 칸을 비워 둔다
        local half = root.UITransformComponent.RectSize * 0.5
        -- NPC 몸이 화면 안이면 「!」만 (머리 위가 화면 끝에 걸리면 안쪽으로 당긴다), 몸까지 화면 밖이면 화살표 + 이름
        local body = _UILogic:ScreenToLocalUIPosition(_UILogic:WorldToScreenPosition(giverPos), root.UITransformComponent)
        local off = math.abs(body.x) > half.x - 40 or math.abs(body.y) > half.y - 40
        local clamped = off and Vector2(math.max(-half.x + 140, math.min(half.x - 620, ui.x)), math.max(-half.y + 120, math.min(half.y - 190, ui.y)))   -- 오른쪽 620px = 메뉴 버튼·미니맵·의뢰 칸
            or Vector2(math.max(-half.x + 60, math.min(half.x - 60, ui.x)), math.max(-half.y + 80, math.min(half.y - 70, ui.y)))
        local text = "!"
        if off then
            local d = ui - clamped
            local arrow = math.abs(d.x) >= math.abs(d.y) and (d.x < 0 and "◀ " or "▶ ") or (d.y > 0 and "▲ " or "▼ ")
            local name = self.NpcLabel[q.giver] or ""
            text = arrow .. "!" .. (name ~= "" and ("\n<size=22>" .. name .. "</size>") or "")
        end
        ui = clamped
        local mark = _UIKit:Get("NpcMark")
        if isvalid(mark) then
            local tc = mark.TextGUIRendererComponent
            if tc.FontColor ~= color then tc.FontColor = color end
            if tc.Text ~= text then
                tc.Text = text
                tc.FontSize = off and 56 or 96
                mark.UITransformComponent.RectSize = off and Vector2(260, 130) or Vector2(90, 120)
            end
        end
        _UIKit:SetEnabled("NpcMark", true)
        _UIKit:SetPos("NpcMark", Vector2(ui.x, ui.y + bob))
    end

end
