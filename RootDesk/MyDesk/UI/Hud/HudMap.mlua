-- 위치 안내 HUD (클라이언트): 맵 이름(D2처럼 들어올 때 상단 가운데 2.5초) · 미니맵(포털·웨이포인트·NPC·입구 + 나·파티) ·
-- 의뢰 NPC 머리 위 표시(새 의뢰 !, 완료 보고 ?). 맵 표시물은 GameData.MapInfo (maps.csv → 맵 빌드와 같은 위치).
@Logic
script HudMap extends Logic

    property number PollInterval = 0.1
    property number BannerSeconds = 2.5
    property integer FeatureCount = 12
    property integer TimerId = 0
    property string LastMap = ""
    property number BannerUntil = 0
    property number Scale = 1
    property Vector2 QuestPos = Vector2(0, 0)
    property boolean HasQuestNpc = false
    property table Gates = {}               -- 이 맵의 포털 { pos, label }
    property number GateLabelRange = 9

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:SetEnabled("Banner", false)
        _UIKit:SetEnabled("NpcMark", false)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local map = player.CurrentMap
        if map.Name ~= self.LastMap then
            self.LastMap = map.Name
            self:OnMapChanged(map.Name)
        end
        self:TickBanner()
        local me = _Util:Pos2(player)
        _UIKit:SetPos("MiniMap/Area/Me", self:ToMini(me))
        self:RenderParty(player)
        self:RenderNpcMark(player)
        self:RenderGates(player)
    end

    -- ───────── 맵이 바뀔 때 ─────────

    @ExecSpace("ClientOnly")
    method void OnMapChanged(string mapName)
        local base = _GameConst:BaseMapName(mapName)
        local info = _GameData:GetMapInfo(base)
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local diff = 0
        if st ~= nil then diff = st.Difficulty end
        local title = base
        local sub = ""
        if info ~= nil then
            title = info.name
            if info.kind == "town" then sub = "마을" elseif info.kind == "side" then sub = "곁가지 던전" elseif info.kind == "instance" then sub = "심도 던전" end
        end
        if diff > 0 then
            if sub ~= "" then sub = sub .. " · " end
            sub = sub .. _GameConst:DifficultyName(diff)
        end
        -- 레벨 표시는 괄호 안 그대로 이름에 붙어 있다 ("피 묻은 황무지 (Lv 1~3)")
        _UIKit:SetText("Banner/Title", title)
        _UIKit:SetText("Banner/Sub", sub)
        _UIKit:SetEnabled("Banner", true)
        self.BannerUntil = _UtilLogic.ElapsedSeconds + self.BannerSeconds
        self:SetBannerAlpha(1)
        _UIKit:SetText("MiniMap/Name", _UIKit:Clip(title, 14))
        self:BuildMiniMap(info)
        log("[HudMap] 맵 " .. mapName .. " → " .. title)
    end

    @ExecSpace("ClientOnly")
    method void BuildMiniMap(any info)
        -- 미니맵 영역(272×180)에 맵 전체가 들어가게 축소. 표시물 점 색: 포털 하늘·웨이포인트 청록·의뢰 노랑·NPC 흰·입구 보라·제단 빨강·보스 주황
        self.HasQuestNpc = false
        self.Gates = {}
        if info == nil then
            self.Scale = 8
            for i = 1, self.FeatureCount do _UIKit:SetEnabled("MiniMap/Area/F" .. tostring(i), false) end
            return
        end
        self.Scale = math.min(264 / math.max(1, info.w), 172 / math.max(1, info.h))
        local colors = {
            portal = Color(0.55, 0.8, 1, 1), waypoint = Color(0.3, 1, 0.9, 1), quest = Color(1, 0.9, 0.2, 1), npc = Color(1, 1, 1, 1),
            depth = Color(0.8, 0.45, 1, 1), altar = Color(1, 0.3, 0.3, 1), boss = Color(1, 0.55, 0.15, 1),
        }
        local n = 0
        for _, f in ipairs(info.features) do
            if n < self.FeatureCount then
                n = n + 1
                local path = "MiniMap/Area/F" .. tostring(n)
                _UIKit:SetEnabled(path, true)
                _UIKit:SetPos(path, self:ToMini(Vector2(f.x, f.y)))
                _UIKit:SetColor(path, colors[f.kind] or Color(1, 1, 1, 1))
            end
            if f.kind == "portal" and f.label ~= "" then table.insert(self.Gates, { pos = Vector2(f.x, f.y), label = f.label }) end
            if f.kind == "quest" then
                self.HasQuestNpc = true
                self.QuestPos = Vector2(f.x, f.y)
            end
        end
        for i = n + 1, self.FeatureCount do _UIKit:SetEnabled("MiniMap/Area/F" .. tostring(i), false) end
    end

    method Vector2 ToMini(Vector2 world)
        -- 맵 좌표(타일 = 1) → 미니맵 영역 안 좌표 (가장자리에서 잘림)
        local x = math.max(-132, math.min(132, world.x * self.Scale))
        local y = math.max(-86, math.min(86, world.y * self.Scale))
        return Vector2(x, y)
    end

    -- ───────── 맵 이름 ─────────

    @ExecSpace("ClientOnly")
    method void TickBanner()
        if self.BannerUntil <= 0 then return end
        local left = self.BannerUntil - _UtilLogic.ElapsedSeconds
        if left <= 0 then
            self.BannerUntil = 0
            _UIKit:SetEnabled("Banner", false)
            return
        end
        -- 마지막 0.6초 동안 흐려진다
        if left < 0.6 then self:SetBannerAlpha(left / 0.6) end
    end

    @ExecSpace("ClientOnly")
    method void SetBannerAlpha(number a)
        for _, path in ipairs({ "Banner/Title", "Banner/Sub" }) do
            local e = _UIKit:Get(path)
            if isvalid(e) then
                local c = e.TextGUIRendererComponent.FontColor
                e.TextGUIRendererComponent.FontColor = Color(c.r, c.g, c.b, a)
            end
        end
    end

    -- ───────── 파티·의뢰 표시 ─────────

    @ExecSpace("ClientOnly")
    method void RenderParty(Entity player)
        -- 같은 맵에 있는 파티원 (최대 3명)
        ---@type PlayerSocial
        local social = _UIKit:Comp("script.PlayerSocial")
        local n = 0
        if social ~= nil then
            for userId in string.gmatch(social.PartyDigest, "([^|;]+)|[^|;]+|%d+") do
                if n < 3 and userId ~= player.PlayerComponent.UserId then
                    local other = _UserService:GetUserEntityByUserId(userId)
                    if isvalid(other) and other.CurrentMap == player.CurrentMap then
                        n = n + 1
                        local path = "MiniMap/Area/P" .. tostring(n)
                        _UIKit:SetEnabled(path, true)
                        _UIKit:SetPos(path, self:ToMini(_Util:Pos2(other)))
                    end
                end
            end
        end
        for i = n + 1, 3 do _UIKit:SetEnabled("MiniMap/Area/P" .. tostring(i), false) end
    end

    @ExecSpace("ClientOnly")
    method void RenderGates(Entity player)
        -- D2처럼 출구 위에 갈 곳 이름: 가까운 포털(9칸 안)만, 최대 4개. 화면 밖이면 숨김
        local root = _UIKit:Get("/ui/GameHUD")
        if not isvalid(root) then return end
        local me = _Util:Pos2(player)
        local n = 0
        local nearest = nil
        local nearestDist = 3.5
        for _, g in ipairs(self.Gates) do
            local d = (g.pos - me):Magnitude()
            if d < nearestDist then
                nearestDist = d
                nearest = g
            end
            if n < 4 and d <= self.GateLabelRange then
                n = n + 1
                local path = "Gate" .. tostring(n)
                local screen = _UILogic:WorldToScreenPosition(g.pos + Vector2(0, 1.3))
                local ui = _UILogic:ScreenToLocalUIPosition(screen, root.UITransformComponent)
                -- 아래 HUD·위 대상 정보에 가리지 않게 화면 안쪽으로
                ui = Vector2(math.max(-760, math.min(760, ui.x)), math.max(-230, math.min(380, ui.y)))
                _UIKit:SetEnabled(path, true)
                _UIKit:SetText(path, "▼ " .. g.label)
                _UIKit:SetPos(path, ui)
            end
        end
        for i = n + 1, 4 do _UIKit:SetEnabled("Gate" .. tostring(i), false) end
        -- 출구 바로 앞: 어디로 가는지 분명히
        _UIKit:SetEnabled("GatePrompt", nearest ~= nil)
        if nearest ~= nil then _UIKit:SetText("GatePrompt/Text", "출구: " .. nearest.label .. " — 들어서면 이동") end
    end

    @ExecSpace("ClientOnly")
    method void RenderNpcMark(Entity player)
        -- 의뢰 NPC 머리 위: 새 의뢰 = 말풍선, 완료 보고 = 체크 (진행 중에는 없음). 위아래로 살짝 흔들림
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        local icon = ""
        if self.HasQuestNpc and quest ~= nil and _QuestData:Get(quest.Index) ~= nil then
            if quest.State == 0 then icon = _GameData:GetUiIcon("q_avail") elseif quest.State == 2 then icon = _GameData:GetUiIcon("q_done") end
        end
        if icon == "" then
            _UIKit:SetEnabled("NpcMark", false)
            return
        end
        -- 월드 → 화면 → GameHUD 루트 기준 좌표 (NpcMark는 루트 가운데 기준)
        local root = _UIKit:Get("/ui/GameHUD")
        if not isvalid(root) then return end
        local screen = _UILogic:WorldToScreenPosition(self.QuestPos + Vector2(0, 1.9))
        local ui = _UILogic:ScreenToLocalUIPosition(screen, root.UITransformComponent)
        local bob = math.sin(_UtilLogic.ElapsedSeconds * 4) * 6
        _UIKit:SetIcon("NpcMark", icon)
        _UIKit:SetPos("NpcMark", Vector2(ui.x, ui.y + bob))
    end

end
