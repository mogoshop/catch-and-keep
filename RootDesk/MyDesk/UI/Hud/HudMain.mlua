-- 상시 HUD: 생명·마나(PC 오브·모바일 작은 오브), 경험치, 스킬 칸(아이콘, 누르면 스킬 지정), 벨트(물약 아이콘·개수),
-- 미니 패널·메뉴 창(모든 창을 한곳에서), 대상 정보, 퀘스트 추적(오른쪽 위), 파티, 첫 진입 안내, 포인트 빨간 점.
-- 미니맵·맵 이름·NPC 의뢰 표시는 HudMap, 스킬 지정 창은 SkillPicker, 모바일 패드는 MobilePad.
@Logic
script HudMain extends Logic

    property number PollInterval = 0.15
    property integer TimerId = 0
    property string SlotKey = ""
    property string BadgeKey = ""
    property string MinionKey = ""
    property boolean DangerHinted = false
    property boolean BeltRightClick = false
    property Vector2 PopPos = Vector2(0, 0)
    property number PopUntil = 0
    property number PopSeconds = 1.8
    property any TunedCamera = nil
    property Vector2 CamScreenOffset = Vector2(0.5, 0.45)
    property Vector2 CamDamping = Vector2(0.8, 0.8)
    property Vector2 CamDeadZone = Vector2(0.03, 0.03)
    property Vector2 CamSoftZone = Vector2(0.5, 0.5)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:SetEnabled("Target", false)
        local target = _UIKit:Get("Target")
        local targetStatus = _UIKit:Get("Target/Curse")
        if isvalid(target) then target.UITransformComponent.RectSize = Vector2(460, 114) end
        if isvalid(targetStatus) then targetStatus.UITransformComponent.RectSize = Vector2(440, 44) end
        _UIKit:SetEnabled("Tip", false)
        _UIKit:RegisterWindow("MenuWin")
        -- 스킬 칸: 누르면 그 칸에 넣을 스킬을 고른다 (시전은 A S D F·우클릭)
        for i = 1, 5 do
            local slot = i
            _UIKit:Connect("Bottom/Slots/Slot" .. tostring(i), function() _SkillPicker:Open(slot) end)
        end
        -- 벨트 칸: 클릭 = 사용(빈 칸이면 지정 창), 우클릭 = 넣을 물건 바꾸기
        for i = 1, 4 do
            local index = i
            _UIKit:Connect("Bottom/Slots/Belt" .. tostring(i), function() self:UseBelt(index) end)
            _UIKit:ConnectHold("Bottom/Slots/Belt" .. tostring(i), function(event) self:BeltDown(index, event.TouchId) end, function(event) end)
        end
        local menu = { { "Inv", "InvWin" }, { "Char", "CharWin" }, { "Skill", "SkillWin" }, { "Quest", "QuestWin" }, { "Social", "SocialWin" } }
        for _, m in ipairs(menu) do
            local win = m[2]
            _UIKit:Connect("Bottom/Menu/Btn" .. m[1], function() _UIKit:Toggle(win) end)
            _UIKit:Connect("MenuWin/" .. m[1], function() self:FromMenu(win) end)
        end
        _UIKit:Connect("Bottom/Menu/BtnShadow", function() _ShadowHUD:ToggleWindow() end)
        _UIKit:Connect("Bottom/Menu/BtnRank", function() _RankWindow:Show("depth") end)
        _UIKit:Connect("Bottom/Menu/BtnExtract", function() self:Extract() end)
        self:CompactMenuRow()
        _UIKit:Connect("MenuWin/Shadow", function() self:FromMenu("") _ShadowHUD:ToggleWindow() end)
        _UIKit:Connect("MenuWin/Rank", function() self:FromMenu("") _RankWindow:Show("depth") end)
        _UIKit:Connect("MenuWin/Rune", function() self:FromMenu("") _RuneWindow:Show("words") end)
        _UIKit:SetText("MenuWin/Input/Label", "설정")
        _UIKit:Connect("MenuWin/Input", function() self:FromMenu("AudioWin") end)
        _UIKit:Connect("MenuWin/BtnClose", function() _UIKit:Close("MenuWin") end)
        _UIKit:Connect("MenuWin/CharSel", function() self:FromMenu("") self:AskCharSelect() end)
        _UIKit:Connect("BtnMenu", function() _UIKit:Toggle("MenuWin") end)
        _UIKit:Connect("QuestTrack", function() _UIKit:Toggle("QuestWin") end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        log("[HudMain] 시작")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 창 단축키 (스킬·물약·소환 키는 각 컴포넌트가 받는다)
        local k = event.key
        if k == KeyboardKey.U then _UIKit:Toggle("CharWin")
        elseif k == KeyboardKey.I then _UIKit:Toggle("InvWin")
        elseif k == KeyboardKey.K then _UIKit:Toggle("SkillWin")
        elseif k == KeyboardKey.Q then _UIKit:Toggle("QuestWin")
        elseif k == KeyboardKey.P then _UIKit:Toggle("SocialWin")
        elseif k == KeyboardKey.L then _RankWindow:Show("depth")
        elseif k == KeyboardKey.M then _UIKit:Toggle("MenuWin") end
    end

    @ExecSpace("ClientOnly")
    method void AskCharSelect()
        -- 메뉴 「캐릭터 선택으로」: 확인 후 저장하고 선택 화면으로 (PlayerSave.RequestCharSelect)
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil or save.Selecting then return end
        _ConfirmDialog:Show("캐릭터 선택", "지금 캐릭터를 저장하고 캐릭터 선택 화면으로 갑니다.\n다른 캐릭터로 들어가거나 새 캐릭터를 만들 수 있습니다.", "이동", function()
            save:RequestCharSelect()
        end)
    end

    @ExecSpace("ClientOnly")
    method void FromMenu(string win)
        -- 메뉴에서 고르면 메뉴는 닫고 그 창을 연다
        _UIKit:Close("MenuWin")
        if win ~= "" then _UIKit:Open(win) end
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void RenderShrineBuff(PlayerStats st)
        -- 신전 축복이 걸려 있는 동안 남은 시간 (MapShrine · PlayerStats.ShrineKind/ShrineUntil)
        local left = math.ceil(st.ShrineUntil - _UtilLogic.ServerElapsedSeconds)
        local info = _GameConst:ShrineInfo(st.ShrineKind)
        local show = info ~= nil and left > 0
        _UIKit:SetEnabled("ShrineBuff", show)
        if show then _UIKit:SetText("ShrineBuff", _UIKit:Colored(self:Hex(info.color), info.name) .. " · " .. info.desc .. " · " .. tostring(left) .. "초") end
    end

    method string Hex(Color c)
        return string.format("#%02X%02X%02X", math.floor(c.r * 255), math.floor(c.g * 255), math.floor(c.b * 255))
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or st == nil then return end
        local pc = player.PlayerComponent
        local hp = pc.Hp / math.max(1, pc.MaxHp)
        local mp = st.Mana / math.max(1, st.MaxMana)
        self:RenderShrineBuff(st)
        local hpText = tostring(math.floor(pc.Hp)) .. "/" .. tostring(math.floor(pc.MaxHp))
        local mpText = tostring(math.floor(st.Mana)) .. "/" .. tostring(math.floor(st.MaxMana))
        for _, orb in ipairs({ { "LifeOrb", hp, hpText }, { "MLife", hp, hpText }, { "ManaOrb", mp, mpText }, { "MMana", mp, mpText } }) do
            _UIKit:SetFill(orb[1] .. "/Fill", orb[2])
            _UIKit:SetText(orb[1] .. "/Text", orb[3])
        end
        _UIKit:SetFill("XP/Fill", st.Exp / math.max(1, st.ExpToNext))
        _UIKit:SetText("XP/Text", string.format("Lv %d   경험치 %d / %d", st.Level, st.Exp, st.ExpToNext))
        self:ApplyCamera()
        self:RenderSlots()
        self:RenderCooldowns()
        self:RenderBadges(st)
        self:RenderMinions()
        self:RenderTarget(player)
        _UIKit:SetEnabled("QuestTrack", _HudMap:ShouldShowQuestTrack())
        self:RenderQuestTrack(player)
        self:RenderParty()
        self:RenderTip(player, st)
        self:RenderSoulUi(player)
    end

    @ExecSpace("ClientOnly")
    method void ExtractPop(Vector2 worldPos, string text, Color color)
        -- 추출 결과: 혼 자리에서 글자가 떠오른다 (PopSeconds 동안)
        self.PopPos = worldPos
        self.PopUntil = _UtilLogic.ElapsedSeconds + self.PopSeconds
        _UIKit:SetText("ExtractPop", text)
        local e = _UIKit:Get("ExtractPop")
        if isvalid(e) then e.TextGUIRendererComponent.FontColor = color end
        self:RenderSoulUi(_UserService.LocalPlayer)
    end

    @ExecSpace("ClientOnly")
    method Vector2 WorldToHud(Vector2 world)
        local root = _UIKit:Get("/ui/GameHUD")
        if not isvalid(root) then return Vector2(0, 0) end
        return _UILogic:ScreenToLocalUIPosition(_UILogic:WorldToScreenPosition(world), root.UITransformComponent)
    end

    @ExecSpace("ClientOnly")
    method void RenderSoulUi(Entity player)
        -- 손 닿는(조금 넘는) 내 혼 위에 추출 확률, 추출 결과 글자 이동
        local now = _UtilLogic.ElapsedSeconds
        local popping = now < self.PopUntil
        _UIKit:SetEnabled("ExtractPop", popping)
        if popping then
            local rise = (self.PopSeconds - (self.PopUntil - now)) * 0.45
            _UIKit:SetPos("ExtractPop", self:WorldToHud(self.PopPos + Vector2(0, 1.1 + rise)))
        end
        local show = false
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if isvalid(player) and extractor ~= nil and book ~= nil and book:GetLevel("shadow_summon") > 0 and not _UIKit:AnyWindowOpen() then
            local soul = extractor:FindNearestSoul(_Util:Pos2(player), _ShadowConfig:GetExtractReach() + 2)
            if soul ~= nil then
                ---@type SoulOrb
                local orb = soul:GetComponent("script.SoulOrb")
                if orb ~= nil then
                    show = true
                    local pct = math.floor(extractor:ChanceFor(orb) * 100 + 0.5)
                    local key = Environment:IsMobilePlatform() and "그림자 추출" or "E 그림자 추출"
                    local color = "#FF9A5A"
                    if pct >= 60 then color = "#8CF08C" elseif pct >= 35 then color = "#FFE15A" end
                    _UIKit:SetText("SoulHint", key .. " " .. _UIKit:Colored(color, tostring(pct) .. "%"))
                    local q = soul.TransformComponent.WorldPosition
                    _UIKit:SetPos("SoulHint", self:WorldToHud(Vector2(q.x, q.y + 0.75)))
                end
            end
        end
        _UIKit:SetEnabled("SoulHint", show and not popping)
    end

    @ExecSpace("ClientOnly")
    method void RenderSlots()
        -- 스킬 칸 아이콘 (빈 칸은 비움) + 벨트 물약 아이콘·개수. 바뀌었을 때만
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if book == nil or belt == nil then return end
        local key = book.Slots .. "#" .. book.RightSkill .. "#" .. belt.Layout .. "#" .. tostring(belt.HpPot) .. "#" .. tostring(belt.MpPot) .. "#" .. tostring(belt.RvPot) .. "#" .. tostring(belt:CountOf("tp"))
        if key == self.SlotKey then return end
        self.SlotKey = key
        for i = 1, 5 do _UIKit:SetIcon("Bottom/Slots/Slot" .. tostring(i) .. "/Icon", self:SkillIcon(book:GetSlotSkill(i))) end
        -- 벨트: 칸마다 플레이어가 넣은 물건 그림·개수 (빈 칸은 그림 없이)
        for i = 1, 4 do
            local path = "Bottom/Slots/Belt" .. tostring(i)
            local kind = belt:SlotKind(i)
            local count = belt:CountOf(kind)
            _UIKit:SetIcon(path .. "/Icon", kind == "" and "" or _GameData:GetUiIcon(_GameConst:BeltIcon(kind)))
            _UIKit:SetColor(path .. "/Icon", count > 0 and Color(1, 1, 1, 1) or Color(1, 1, 1, 0.35))
            _UIKit:SetText(path .. "/Count", kind == "" and "" or tostring(count))
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderCooldowns()
        -- 스킬 칸 쿨다운 덮개 (시계 방향으로 줄어듦) + 남은 초
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        for i = 1, 5 do
            _UIKit:ShowCooldown("Bottom/Slots/Slot" .. tostring(i) .. "/Cd", book, book:GetSlotSkill(i))
        end
    end

    method string SkillIcon(string id)
        if id == "" then return "" end
        local def = _SkillData:Get(id)
        if def == nil then return "" end
        return def.icon
    end

    @ExecSpace("ClientOnly")
    method void RenderBadges(PlayerStats st)
        -- 쓸 포인트가 있으면 메뉴·능력치·스킬 버튼에 빨간 점
        local key = tostring(st.StatPoints) .. "#" .. tostring(st.SkillPoints)
        if key == self.BadgeKey then return end
        self.BadgeKey = key
        local stat = st.StatPoints > 0
        local skill = st.SkillPoints > 0
        _UIKit:SetEnabled("BtnMenu/Badge", stat or skill)
        _UIKit:SetEnabled("Bottom/Menu/BtnChar/Badge", stat)
        _UIKit:SetEnabled("Bottom/Menu/BtnSkill/Badge", skill)
        _UIKit:SetEnabled("MenuWin/Char/Badge", stat)
        _UIKit:SetEnabled("MenuWin/Skill/Badge", skill)
    end

    @ExecSpace("ClientOnly")
    method void RenderMinions()
        -- 개별 초상·생명·상태는 CompanionHUD가 담당해 동일 정보가 겹치지 않게 한다.
        _UIKit:SetEnabled("Minions", false)
        _UIKit:SetEnabled("MMinions", false)
    end

    @ExecSpace("ClientOnly")
    method void RenderTarget(Entity player)
        -- D2처럼 상단 중앙에 대상 이름·레벨·생명·저주. 우선순위: 커서 아래(마우스 모드, 1.2) → 지금 공격 중인 대상 → 가장 가까운 적(4)
        local m = nil
        ---@type ClickControl
        local cc = player:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            m = _Util:NearestMonster(player.CurrentMap, _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition()), 1.2)
        end
        if m == nil and cc ~= nil and isvalid(cc.AttackTarget) then
            ---@type Monster
            local attacking = cc.AttackTarget:GetComponent("script.Monster")
            if attacking ~= nil and not attacking.IsDead and cc.AttackTarget.Enable then m = attacking end
        end
        if m == nil then m = _Util:NearestMonster(player.CurrentMap, _Util:Pos2(player), 4) end
        _UIKit:SetEnabled("Target", m ~= nil)
        if m == nil then return end
        local prefix = ""
        local color = "#FFFFFF"
        if m.Grade >= 3 then
            prefix = "보스 "
            color = "#C8A050"
        elseif m.DisplayName ~= "" then
            prefix = ""                  -- 이름 있는 적 (모르그·유물 지기·피의 사제): 이름만 금색으로
            color = "#E0B050"
        elseif m.Unique then
            prefix = "최상위 "
            color = "#C8A050"
        elseif m:GetVariant() ~= "" then
            prefix = "우두머리 "
            color = "#E070FF"            -- 변종 우두머리 (오오라·기술): 이름표에 능력 이름
        elseif m.Grade == 2 then
            prefix = "정예 "
            color = "#6E8CFF"
        end
        _UIKit:SetText("Target/Name", _UIKit:Colored(color, prefix .. (m.DisplayName ~= "" and m.DisplayName or _GameData:GetMonsterName(m.SourceId))) .. "  Lv" .. tostring(m.Level))
        _UIKit:SetFill("Target/Bar/Fill", m.Hp / math.max(1, m.MaxHp))
        _UIKit:SetText("Target/Curse", self:TargetStatus(m))
    end

    @ExecSpace("ClientOnly")
    method string TargetStatus(Monster monster)
        -- 적의 지원 능력과 현재 저주를 짧게 함께 보여 주어 먼저 잡을 대상을 고를 수 있게 한다.
        local text = ""
        local variant = _GameData:GetVariant(monster:GetVariant())
        if variant ~= nil then
            if variant.kind == "aura" then
                local labels = { dmg = "피해", haste = "공격·이동", guard = "피해 감소" }
                local label = labels[variant.effect] or "전투력"
                text = variant.name .. " · 주변 적 " .. label .. " +" .. tostring(math.floor(variant.value)) .. "%"
            elseif variant.kind == "skill" then
                local names = { fire = "화염 ", cold = "냉기 ", light = "번개 " }
                text = variant.name .. " · " .. (names[variant.element] or "") .. "범위 공격 · 예고 원 밖으로"
            elseif variant.kind == "cloud" then
                text = variant.name .. " · 독안개가 남는다 · 초록 원 밖으로"
            end
        else
            text = monster:GetAffixName()
        end
        local curse = monster:GetCurseTag()
        if curse ~= "" then text = text == "" and curse or (text .. "\n" .. curse) end
        return text
    end

    @ExecSpace("ClientOnly")
    method void RenderQuestTrack(Entity player)
        -- 의뢰 추적(글자만): 뱃지 → 제목 → 지역 → 완료 조건·진행. 누르면 퀘스트 창
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil then return end
        local q = _QuestData:Get(quest.Index)
        local total = _QuestData:Count()
        local badge, title, caption, goal = "", "", "", ""
        if q == nil then
            badge, title, caption, goal = "완료", "모든 의뢰 완료", "심도 던전·높은 난이도", "새로운 도전을 찾아보세요"
        elseif quest.State == 0 then
            badge, title, caption, goal = "새 의뢰", q.title, "잿불 야영지", _QuestData:GiverName(q.giver) .. "에게 말을 거세요"
        elseif quest.State == 1 then
            badge, title, caption = "의뢰 " .. tostring(quest.Index) .. "/" .. tostring(total), q.title, q.zone
            goal = self:QuestGoalText(q, quest)
        else
            badge, title, caption, goal = "보고", q.title, "잿불 야영지", _QuestData:GiverName(q.giver) .. "에게 보고하세요"
        end
        _UIKit:SetText("QuestTrack/Badge/Text", badge)
        _UIKit:SetText("QuestTrack/Title", _UIKit:Clip(title, 16))
        _UIKit:SetText("QuestTrack/Body", caption)
        _UIKit:SetText("QuestTrack/Progress", goal)
    end

    method string QuestGoalText(table q, PlayerQuest quest)
        -- 진행 중 목표 한 줄: 정리 = 남은 수, 열쇠 → 상자 = 단계, 나머지 = n/count
        if q.kind == "clear" then
            local count = quest:CountFor(q)
            if count <= 0 then return q.objective end
            return "남은 망자 " .. tostring(math.max(0, count - quest.Progress)) .. " / " .. tostring(count)
        end
        if q.kind == "chest" then
            return quest.Progress >= 1 and "열쇠 획득 → 봉인 상자를 여세요" or q.objective
        end
        if q.count <= 1 then return q.objective end
        return q.objective .. "  " .. string.format("%d/%d", quest.Progress, q.count)
    end

    @ExecSpace("ClientOnly")
    method void RenderParty()
        ---@type PlayerSocial
        local s = _UIKit:Comp("script.PlayerSocial")
        if s == nil then return end
        local lines = {}
        for _, name, lv in string.gmatch(s.PartyDigest, "([^|;]+)|([^|;]+)|(%d+)") do table.insert(lines, name .. "  Lv" .. lv) end
        local text = ""
        if #lines > 0 then text = "파티 (" .. tostring(#lines) .. ")\n" .. table.concat(lines, "\n") end
        _UIKit:SetText("Party/Text", text)
    end

    @ExecSpace("ClientOnly")
    method void RenderTip(Entity player, PlayerStats st)
        -- 현재 단계의 다음 행동 하나만 안내하고 대화·보상 연출 중에는 숨긴다.
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        local tip = self:JourneyTip(player, st, quest, book)
        _UIKit:SetEnabled("Tip", tip ~= "" and not _UIKit:AnyWindowOpen() and _UXFeedback.Until <= _UtilLogic.ElapsedSeconds)
        if tip ~= "" then _UIKit:SetText("Tip/Text", tip) end
    end

    @ExecSpace("ClientOnly")
    method string JourneyTip(Entity player, PlayerStats st, PlayerQuest quest, SkillBook book)
        -- 의뢰의 수락→습득→배치→소환→보고→첫 장비를 실제 저장 상태에서 이어 준다.
        if not _Util:IsAlive(player) or quest == nil then return "" end
        local inTown = _GameConst:IsTown(player.CurrentMap)
        local cur = _QuestData:Get(quest.Index)
        local giver = cur ~= nil and _QuestData:GiverName(cur.giver) or "사제 오렌"
        if quest.State == 2 then
            return inTown and ("목표 달성 — " .. giver .. "에게 보고하고 보상을 받으세요") or ("목표 달성 — 잿불 야영지로 돌아가 " .. giver .. "에게 보고하세요")
        end
        if quest.Index == 1 then
            if quest.State == 0 then
                return inTown and "사제 오렌(미니맵 의뢰 아이콘)에게 다가가 첫 의뢰를 받으세요" or "잿불 야영지의 사제 오렌에게 첫 의뢰를 받으세요"
            end
            if book ~= nil then return self:FirstQuestTip(player, book) end
        elseif quest.Index == 2 then
            ---@type PlayerInventory
            local inv = player:GetComponent("script.PlayerInventory")
            local first = _QuestData:Get(1)
            local reward = first ~= nil and string.match("," .. first.reward, ",item:([^,]+)") or nil
            if inv ~= nil and reward ~= nil then
                -- 이미 다른 등불을 착용했으면 교체를 강요하지 않는다. 보유한 첫 보상에만 안내한다.
                local eq = inv:GetEquipMap()
                local rewardSlot = _ItemData:GetSlot(reward)
                if eq[rewardSlot] == nil or eq[rewardSlot] == "" then
                    for _, item in ipairs(inv:GetBagList()) do
                        if _ItemData:Parse(item).base == _ItemData:Parse(reward).base then
                            return "메뉴 → 소지품에서 보상 등불을 장착하세요 — 새로 부르는 소환수가 강해집니다"
                        end
                    end
                end
            end
            if quest.State == 0 then
                return inTown and "사제 오렌에게 다음 의뢰를 받으세요 — 썩은 갈대 늪의 가라앉은 지하실로" or "잿불 야영지의 사제 오렌에게 다음 의뢰를 받으세요"
            end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method string FirstQuestTip(Entity player, SkillBook book)
        -- 다른 스킬을 먼저 배웠어도 현재 포인트·슬롯·마나에 맞는 행동을 안내한다.
        ---@type PlayerStats
        local st = player:GetComponent("script.PlayerStats")
        if st == nil then return "" end
        local pc = Environment:IsPCPlatform()
        local skillMenu = pc and "스킬(K)" or "메뉴 → 스킬"
        if book:GetLevel("raise_skeleton") <= 0 then
            local reason = book:CanLearn("raise_skeleton", st.Level, st.SkillPoints)
            if reason == "" then return skillMenu .. "에서 「해골 전사」를 배우세요 — 첫 의뢰가 훨씬 쉬워집니다" end
            if st.SkillPoints <= 0 then return "황무지에서 적을 처치해 레벨을 올리세요 — 다음 스킬 포인트로 「해골 전사」 습득" end
            return "「해골 전사」 습득 조건: " .. reason .. " — " .. skillMenu .. "에서 확인하세요"
        end
        local key = ""
        local chosenSlot = 0
        local keys = { "A 키", "S 키", "D 키", "F 키", "우클릭" }
        for i = 1, 5 do
            if book:GetSlotSkill(i) == "raise_skeleton" then
                key = pc and keys[i] or (i == 5 and "큰 스킬 버튼" or ("스킬 " .. tostring(i) .. "번"))
                chosenSlot = i
                break
            end
        end
        if key == "" then return skillMenu .. "에서 「해골 전사」를 스킬 1~4번 칸에 지정하세요" end
        if _GameConst:IsTown(player.CurrentMap) then return "미니맵의 황무지 출구로 나가세요 — 황무지 북동쪽 「굶주린 굴」이 목적지" end
        if st.Mana < book:GetManaCost("raise_skeleton", book:GetLevel("raise_skeleton")) then
            return "소환할 마나가 부족합니다 — 마나 회복을 기다리거나 파란 물약을 사용하세요"
        end
        if _UndeadSystem:FindSoul(player, _Util:Pos2(player), 5) ~= nil then
            return "혼이 남았습니다 — 가까이 다가가 혼을 조준하고 「해골 전사」(" .. key .. ") 사용"
        end
        if not pc and chosenSlot == 5 then
            return "혼이 없습니다 — 스킬 창의 「스킬 편집」에서 소환을 1~4번에 두고 큰 공격 칸을 비우면 기본 공격을 쓸 수 있습니다"
        end
        if _GameConst:BaseMapName(player.CurrentMap.Name) == "hollow" then return "" end
        return "황무지 북동쪽 「굶주린 굴」로 — 쓰러뜨린 적의 혼으로 해골 전사를 일으키며 가세요"
    end

    -- ───────── 동작 ─────────

    @ExecSpace("ClientOnly")
    method void ApplyCamera()
        -- 탑다운 카메라: 횡스크롤 기본값(캐릭터를 중앙 아래에 두고 세로로 느리게 따라옴)은 아래로 걸을 때 하단 HUD에 길이 가려졌다.
        -- 캐릭터를 중앙보다 조금 위에 두고(아래 시야 확보) 가로·세로 모두 빨리 따라가게 한다. 맵 이동 뒤에도 다시 맞춘다
        local cam = _CameraService:GetCurrentCameraComponent()
        if not isvalid(cam) or cam == self.TunedCamera then return end
        self.TunedCamera = cam
        cam.ScreenOffset = self.CamScreenOffset
        cam.Damping = self.CamDamping
        cam.DeadZone = self.CamDeadZone
        cam.SoftZone = self.CamSoftZone
        log("[VRF] camera tuned offset=" .. tostring(cam.ScreenOffset) .. " damping=" .. tostring(cam.Damping))
    end

    @ExecSpace("ClientOnly")
    method void HintDanger(string kind)
        -- 처음 보는 붉은 바닥 원이 무엇인지 한 번만 알려 준다 (접속마다 1회)
        if self.DangerHinted then return end
        self.DangerHinted = true
        _UXFeedback:Show("붉은 원 = 적의 범위 공격", "곧 원 안이 터집니다 — 테두리 밖으로 걸어 나가면 피할 수 있습니다", _GameData:GetUiIcon("red_dot"))
    end

    @ExecSpace("ClientOnly")
    method void CompactMenuRow()
        -- 하단 메뉴 줄이 캐릭터 바로 아래 전투 공간(적·출구)을 가렸다. 85%로 줄이고(메뉴 이름은 읽히게) 아래 단축칸 쪽에 붙인다.
        local row = _UIKit:Get("Bottom/Menu")
        if not isvalid(row) then return end
        local t = row.UITransformComponent
        local scale = 0.85
        local bottomGap = t.anchoredPosition.y - t.RectSize.y   -- 원래 아래 끝과 단축칸 사이 간격 (위쪽 기준 피벗)
        t.UIScale = Vector3(scale, scale, 1)
        t.anchoredPosition = Vector2(t.anchoredPosition.x, bottomGap + t.RectSize.y * scale)
    end

    @ExecSpace("ClientOnly")
    method void UseBelt(integer index)
        -- 벨트 칸 클릭: 빈 칸이면 넣을 물건 고르기, 아니면 사용. 다른 창 조작 중에는 쓰지 않는다
        if self.BeltRightClick then self.BeltRightClick = false return end
        if not _UIKit:CanUseGameplayInput() then return end
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if belt == nil then return end
        if belt:SlotKind(index) == "" then _SkillPicker:OpenBelt(index) return end
        belt:RequestUseSlot(index)
    end

    @ExecSpace("ClientOnly")
    method void BeltDown(integer index, integer touchId)
        -- PC 우클릭(-2)은 사용하지 않고 칸 지정 창을 연다
        log("[VRF] belt down slot=" .. tostring(index) .. " touch=" .. tostring(touchId))
        if touchId ~= -2 then return end
        self.BeltRightClick = true
        _SkillPicker:OpenBelt(index)
    end

    @ExecSpace("ClientOnly")
    method void Extract()
        -- 다른 창을 조작하는 동안 배경 HUD에서 전투 동작이 나가지 않게 한다.
        if not _UIKit:CanUseGameplayInput() then return end
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        if extractor ~= nil then extractor:TryExtractNearby() end
    end

end
