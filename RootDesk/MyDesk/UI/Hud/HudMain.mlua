-- 상시 HUD: 생명·마나(PC 오브·모바일 작은 오브), 경험치, 스킬 칸(아이콘, 누르면 스킬 지정), 벨트(물약 아이콘·개수),
-- 미니 패널·메뉴 창(모든 창을 한곳에서), 대상 정보, 퀘스트 추적(오른쪽 위), 파티, 첫 진입 안내, 포인트 빨간 점.
-- 미니맵·맵 이름·NPC 의뢰 표시는 HudMap, 스킬 지정 창은 SkillPicker, 모바일 패드는 MobilePad.
@Logic
script HudMain extends Logic

    property number PollInterval = 0.15
    property integer TimerId = 0
    property string SlotKey = ""
    property string BadgeKey = ""
    property string MinionKey = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:SetEnabled("Target", false)
        _UIKit:SetEnabled("Tip", false)
        _UIKit:RegisterWindow("MenuWin")
        -- 스킬 칸: 누르면 그 칸에 넣을 스킬을 고른다 (시전은 A S D F·우클릭)
        for i = 1, 5 do
            local slot = i
            _UIKit:Connect("Bottom/Slots/Slot" .. tostring(i), function() _SkillPicker:Open(slot) end)
        end
        _UIKit:Connect("Bottom/Slots/Belt1", function() self:UsePotion("hp") end)
        _UIKit:Connect("Bottom/Slots/Belt2", function() self:UsePotion("mp") end)
        _UIKit:Connect("Bottom/Slots/Belt3", function() self:UsePotion("rv") end)
        _UIKit:Connect("Bottom/Slots/Belt4", function() self:TownPortal() end)
        local menu = { { "Inv", "InvWin" }, { "Char", "CharWin" }, { "Skill", "SkillWin" }, { "Quest", "QuestWin" }, { "Social", "SocialWin" } }
        for _, m in ipairs(menu) do
            local win = m[2]
            _UIKit:Connect("Bottom/Menu/Btn" .. m[1], function() _UIKit:Toggle(win) end)
            _UIKit:Connect("MenuWin/" .. m[1], function() self:FromMenu(win) end)
        end
        _UIKit:Connect("Bottom/Menu/BtnShadow", function() _ShadowHUD:ToggleWindow() end)
        _UIKit:Connect("Bottom/Menu/BtnRank", function() _RankWindow:Show("depth") end)
        _UIKit:Connect("Bottom/Menu/BtnExtract", function() self:Extract() end)
        _UIKit:Connect("Bottom/Menu/BtnPortal", function() self:TownPortal() end)
        _UIKit:Connect("MenuWin/Shadow", function() self:FromMenu("") _ShadowHUD:ToggleWindow() end)
        _UIKit:Connect("MenuWin/Rank", function() self:FromMenu("") _RankWindow:Show("depth") end)
        _UIKit:Connect("MenuWin/Portal", function() self:FromMenu("") self:TownPortal() end)
        _UIKit:Connect("MenuWin/Input", function() self:FromMenu("") _ShadowHUD:ToggleInputMode() end)
        _UIKit:Connect("MenuWin/BtnClose", function() _UIKit:Close("MenuWin") end)
        _UIKit:Connect("BtnMenu", function() _UIKit:Toggle("MenuWin") end)
        _UIKit:Connect("QuestTrack", function() _UIKit:Toggle("QuestWin") end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        log("[HudMain] 시작")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 창 단축키 (스킬·물약·소환 키는 각 컴포넌트가 받는다)
        local k = event.key
        if k == KeyboardKey.U then _UIKit:Toggle("CharWin")
        elseif k == KeyboardKey.I then _UIKit:Toggle("InvWin")
        elseif k == KeyboardKey.K then _UIKit:Toggle("SkillWin")
        elseif k == KeyboardKey.Q then _UIKit:Toggle("QuestWin")
        elseif k == KeyboardKey.P then _UIKit:Toggle("SocialWin")
        elseif k == KeyboardKey.L then _RankWindow:Show("depth")
        elseif k == KeyboardKey.M then _UIKit:Toggle("MenuWin") end
    end

    @ExecSpace("ClientOnly")
    method void FromMenu(string win)
        -- 메뉴에서 고르면 메뉴는 닫고 그 창을 연다
        _UIKit:Close("MenuWin")
        if win ~= "" then _UIKit:Open(win) end
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or st == nil then return end
        local pc = player.PlayerComponent
        local hp = pc.Hp / math.max(1, pc.MaxHp)
        local mp = st.Mana / math.max(1, st.MaxMana)
        local hpText = tostring(math.floor(pc.Hp)) .. "/" .. tostring(math.floor(pc.MaxHp))
        local mpText = tostring(math.floor(st.Mana)) .. "/" .. tostring(math.floor(st.MaxMana))
        for _, orb in ipairs({ { "LifeOrb", hp, hpText }, { "MLife", hp, hpText }, { "ManaOrb", mp, mpText }, { "MMana", mp, mpText } }) do
            _UIKit:SetFill(orb[1] .. "/Fill", orb[2])
            _UIKit:SetText(orb[1] .. "/Text", orb[3])
        end
        _UIKit:SetFill("XP/Fill", st.Exp / math.max(1, st.ExpToNext))
        _UIKit:SetText("XP/Text", string.format("Lv %d   경험치 %d / %d", st.Level, st.Exp, st.ExpToNext))
        self:RenderSlots()
        self:RenderBadges(st)
        self:RenderMinions()
        self:RenderTarget(player)
        self:RenderQuestTrack(player)
        self:RenderParty()
        self:RenderTip(player, st)
    end

    @ExecSpace("ClientOnly")
    method void RenderSlots()
        -- 스킬 칸 아이콘 (빈 칸은 비움) + 벨트 물약 아이콘·개수. 바뀌었을 때만
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        if book == nil or belt == nil or travel == nil then return end
        local key = book.Slots .. "#" .. book.RightSkill .. "#" .. tostring(belt.HpPot) .. "#" .. tostring(belt.MpPot) .. "#" .. tostring(belt.RvPot) .. "#" .. tostring(travel.TownScroll)
        if key == self.SlotKey then return end
        self.SlotKey = key
        for i = 1, 5 do _UIKit:SetIcon("Bottom/Slots/Slot" .. tostring(i) .. "/Icon", self:SkillIcon(book:GetSlotSkill(i))) end
        local belts = { { "potion_hp", belt.HpPot }, { "potion_mp", belt.MpPot }, { "potion_rv", belt.RvPot }, { "icon_scroll", travel.TownScroll } }
        for i, b in ipairs(belts) do
            local path = "Bottom/Slots/Belt" .. tostring(i)
            _UIKit:SetIcon(path .. "/Icon", _GameData:GetUiIcon(b[1]))
            _UIKit:SetColor(path .. "/Icon", b[2] > 0 and Color(1, 1, 1, 1) or Color(1, 1, 1, 0.35))
            _UIKit:SetText(path .. "/Count", tostring(b[2]))
        end
    end

    method string SkillIcon(string id)
        if id == "" then return "" end
        local def = _SkillData:Get(id)
        if def == nil then return "" end
        return def.icon
    end

    @ExecSpace("ClientOnly")
    method void RenderBadges(PlayerStats st)
        -- 쓸 포인트가 있으면 메뉴·능력치·스킬 버튼에 빨간 점
        local key = tostring(st.StatPoints) .. "#" .. tostring(st.SkillPoints)
        if key == self.BadgeKey then return end
        self.BadgeKey = key
        local stat = st.StatPoints > 0
        local skill = st.SkillPoints > 0
        _UIKit:SetEnabled("BtnMenu/Badge", stat or skill)
        _UIKit:SetEnabled("Bottom/Menu/BtnChar/Badge", stat)
        _UIKit:SetEnabled("Bottom/Menu/BtnSkill/Badge", skill)
        _UIKit:SetEnabled("MenuWin/Char/Badge", stat)
        _UIKit:SetEnabled("MenuWin/Skill/Badge", skill)
    end

    @ExecSpace("ClientOnly")
    method void RenderMinions()
        -- 소환수 배지 (D2): 해골·마법사·되살림·그림자 아이콘 + 지금 수. 0이면 숨김
        ---@type ShadowCommander
        local cmd = _UIKit:Comp("script.ShadowCommander")
        if cmd == nil then return end
        local key = cmd.MinionCounts .. "," .. tostring(cmd.DeployedCount)
        if key == self.MinionKey then return end
        self.MinionKey = key
        local counts = {}
        for v in string.gmatch(key, "[^,]+") do table.insert(counts, tonumber(v) or 0) end
        local names = { "Skel", "Mage", "Revive", "Shadow" }
        for _, root in ipairs({ "Minions", "MMinions" }) do
            local x = 0
            for i = 1, 4 do
                local path = root .. "/" .. names[i]
                local n = counts[i] or 0
                _UIKit:SetEnabled(path, n > 0)
                if n > 0 then
                    -- 있는 것만 왼쪽부터 붙여서
                    _UIKit:SetPos(path, Vector2(x, 0))
                    _UIKit:SetText(path .. "/Count", tostring(n))
                    x = x + 76
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderTarget(Entity player)
        -- D2처럼 상단 중앙에 대상 이름·레벨·생명·저주. 우선순위: 커서 아래(마우스 모드, 1.2) → 지금 공격 중인 대상 → 가장 가까운 적(4)
        local m = nil
        ---@type ClickControl
        local cc = player:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            m = _Util:NearestMonster(player.CurrentMap, _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition()), 1.2)
        end
        if m == nil and cc ~= nil and isvalid(cc.AttackTarget) then
            ---@type Monster
            local attacking = cc.AttackTarget:GetComponent("script.Monster")
            if attacking ~= nil and not attacking.IsDead and cc.AttackTarget.Enable then m = attacking end
        end
        if m == nil then m = _Util:NearestMonster(player.CurrentMap, _Util:Pos2(player), 4) end
        _UIKit:SetEnabled("Target", m ~= nil)
        if m == nil then return end
        local prefix = ""
        local color = "#FFFFFF"
        local affix = m:GetAffixName()
        if m.Grade >= 3 then
            prefix = "보스 "
            color = "#C8A050"
        elseif m.Unique then
            prefix = "최상위 "
            color = "#C8A050"
        elseif m:GetVariant() ~= "" then
            color = "#E070FF"            -- 변종 우두머리 (오오라·기술): 이름표에 능력 이름
        elseif m.Grade == 2 then
            prefix = "정예 "
            color = "#6E8CFF"
        end
        if affix ~= "" then prefix = affix .. " " .. prefix end
        _UIKit:SetText("Target/Name", _UIKit:Colored(color, prefix .. _GameData:GetMonsterName(m.SourceId)) .. "  Lv" .. tostring(m.Level))
        _UIKit:SetFill("Target/Bar/Fill", m.Hp / math.max(1, m.MaxHp))
        _UIKit:SetText("Target/Curse", m:GetCurseTag())
    end

    @ExecSpace("ClientOnly")
    method void RenderQuestTrack(Entity player)
        -- 오른쪽 위 종이: 제목 + 할 일 (누르면 퀘스트 창)
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil then return end
        local q = _QuestData:Get(quest.Index)
        local title = ""
        local body = ""
        if q == nil then
            title = "모든 의뢰 완료"
            body = "심도 던전·높은 난이도에 도전하세요"
        elseif quest.State == 0 then
            title = "새 의뢰"
            body = "잿불 야영지의 사제 오렌을 찾아가세요"
        elseif quest.State == 1 then
            title = q.title
            body = string.format("진행 %d / %d", quest.Progress, q.count)
        else
            title = q.title .. " (완료)"
            body = "사제 오렌에게 보고하세요"
        end
        _UIKit:SetText("QuestTrack/Title", _UIKit:Clip(title, 16))
        _UIKit:SetText("QuestTrack/Body", body)
    end

    @ExecSpace("ClientOnly")
    method void RenderParty()
        ---@type PlayerSocial
        local s = _UIKit:Comp("script.PlayerSocial")
        if s == nil then return end
        local lines = {}
        for _, name, lv in string.gmatch(s.PartyDigest, "([^|;]+)|([^|;]+)|(%d+)") do table.insert(lines, name .. "  Lv" .. lv) end
        local text = ""
        if #lines > 0 then text = "파티 (" .. tostring(#lines) .. ")\n" .. table.concat(lines, "\n") end
        _UIKit:SetText("Party/Text", text)
    end

    @ExecSpace("ClientOnly")
    method void RenderTip(Entity player, PlayerStats st)
        -- 첫 진입 안내: 의뢰 받기 → 스킬 배우기 → 사냥터로 (해당하는 것 하나만)
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        local tip = ""
        local inTown = _GameConst:IsTown(player.CurrentMap)
        if quest ~= nil and quest.Index == 1 and quest.State == 0 and inTown then
            tip = "사제 오렌(미니맵 노란 점, 머리 위 표시)에게 다가가 의뢰를 받으세요"
        elseif book ~= nil and st.SkillPoints > 0 and book:GetLevel("raise_skeleton") <= 0 and book:GetLevel("bone_shard") <= 0 then
            tip = "스킬 포인트가 있습니다 — 메뉴 ▸ 스킬(K)에서 「해골 전사」나 「골편 투척」을 배우세요"
        elseif inTown and st.Level <= 2 and quest ~= nil and quest.State == 1 then
            tip = "미니맵의 출구 표시로 나가 사냥터로 가세요"
        end
        _UIKit:SetEnabled("Tip", tip ~= "")
        if tip ~= "" then _UIKit:SetText("Tip/Text", tip) end
    end

    -- ───────── 동작 ─────────

    @ExecSpace("ClientOnly")
    method void UsePotion(string kind)
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if belt ~= nil then belt:RequestUsePotion(kind) end
    end

    @ExecSpace("ClientOnly")
    method void TownPortal()
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        if travel ~= nil then travel:RequestTownPortal() end
    end

    @ExecSpace("ClientOnly")
    method void Extract()
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        if extractor ~= nil then extractor:TryExtractNearby() end
    end

end
