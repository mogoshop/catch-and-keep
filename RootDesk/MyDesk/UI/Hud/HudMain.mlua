-- 상시 HUD: 생명·마나(PC 오브·모바일 작은 오브), 경험치, 스킬 칸(아이콘, 누르면 스킬 지정), 벨트(물약 아이콘·개수),
-- 미니 패널·메뉴 창(모든 창을 한곳에서), 대상 정보, 퀘스트 추적(오른쪽 위), 파티, 첫 진입 안내, 포인트 빨간 점.
-- 미니맵·맵 이름·NPC 의뢰 표시는 HudMap, 스킬 지정 창은 SkillPicker, 모바일 패드는 MobilePad.
@Logic
script HudMain extends Logic

    property string QuestTrackKey = ""       -- 지금 의뢰·단계 (번호:상태)
    property string QuestTrackSeen = ""      -- 눌러서 닫은 의뢰 알림 카드의 키 (같은 키면 다시 안 띄움)
    property number PollInterval = 0.15
    property integer TimerId = 0
    property string SlotKey = ""
    property string BadgeKey = ""
    property string MinionKey = ""
    property number GuideRepeat = 40         -- 끝나지 않은 상황 안내 줄을 다시 띄우는 간격(초)
    property boolean BeltRightClick = false
    property Vector2 PopPos = Vector2(0, 0)
    property number PopUntil = 0
    property number PopSeconds = 1.8
    property table BuffDescs = {}               -- 버프 칩 번호 → 효과 설명 (PC 마우스 올리면 설명 상자 · 모바일 누르면 안내 줄)
    property integer HoverBuff = 0              -- PC: 마우스가 올라가 있는 칩 번호 (0 = 없음)
    property number WarnUntil = 0               -- 머리 위 경고 글씨 (ShowWarn)
    property number WarnSeconds = 1.3
    property string WarnText = ""
    property number RaidUntil = 0               -- 습격 예고 (RaidDirector.Warn → RaidWarn): 가장자리 표식·글귀가 보이는 동안
    property table RaidPts = {}                 -- 떼가 솟을 자리 { {x, y}, ... } (최대 8)
    property table RaidDecals = {}              -- 바닥 조짐 이펙트 번호 (끝나면 지운다)
    property number RaidStartAt = 0             -- 예고가 뜬 때 (가장자리 표식 1 나타남 → 2 긁음 → 3 흩어짐)
    property table RaidOmenFrames = {}          -- 바닥 조짐 프레임 RUID — 그 맵 액트의 코덱스 조짐 4프레임 (GameConst.SpriteRaidOmen a1~a4)
    property integer RaidOmenAct = 0
    property integer RaidOmenTick = 0           -- 예고 시작부터 지난 150ms 칸 수 (바뀔 때 다음 프레임으로 갈아 끼운다)
    property table RaidMarkRuids = {}           -- 가장자리 표식 1·2·3 (ui_icons ui_raid_edge_mark_1~3)
    property integer RaidMarkFrame = 0          -- 지금 그린 표식 번호 (바뀔 때만 [VRF])
    property number RaidPlateUntil = 0          -- 습격 격퇴 판 (RaidDefeated): 4초 보이고 끝 0.5초 흐려진다
    property string TipText = ""                -- 위쪽 가운데 여정 안내: 바뀌거나 맵에 들어올 때만 TipSeconds 동안
    property string TipMap = ""
    property number TipUntil = 0
    property number TipSeconds = 8
    property any ShadowLocked = nil             -- 그림자 메뉴 잠김 표시 상태 (바뀔 때만 다시 그린다)
    property any LockIconColors = nil           -- 잠그기 전 아이콘 원래 색
    property string TipShownText = ""           -- 같은 안내를 맵마다 다시 띄우지 않는다 (10-21: 맵을 옮길 때마다 같은 띠가 NPC 머리를 가렸다)
    property number TipShownAt = -999
    property number TipRepeatGap = 120          -- 같은 안내는 이 초 안에는 맵에 들어와도 다시 띄우지 않는다
    property any TunedCamera = nil
    property Vector2 CamScreenOffset = Vector2(0.5, 0.45)
    property Vector2 CamDamping = Vector2(0.8, 0.8)
    property Vector2 CamDeadZone = Vector2(0.03, 0.03)
    property Vector2 CamSoftZone = Vector2(0.5, 0.5)
    property integer ComboN = 0               -- 머리 위 콤보: 지금 보이는 수 (0 = 숨김)
    property number ComboPunchAt = 0          -- 마지막으로 수가 오른 시각 (툭 커지는 연출)
    property number ComboFadeAt = 0           -- 연쇄가 끊겨 흐려지기 시작한 시각 (0 = 아님)
    property boolean ComboTierUp = false      -- 이번 오름이 단계(10·25·50·100)를 넘었다 (더 크게 튄다)
    property boolean RiteShown = false        -- 뼈 의식 충전 고리가 떠 있다 (RenderRite)
    property integer RiteLastStage = -1       -- 고리에 마지막으로 그린 단계 (바뀔 때만 글자·로그)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:SetEnabled("Target", false)
        local target = _UIKit:Get("Target")
        local targetStatus = _UIKit:Get("Target/Curse")
        if isvalid(target) then target.UITransformComponent.RectSize = Vector2(460, 114) end
        if isvalid(targetStatus) then targetStatus.UITransformComponent.RectSize = Vector2(440, 44) end
        _UIKit:SetEnabled("Tip", false)
        -- 안내 띠는 반투명 (뒤의 NPC 머리·이름이 비쳐 보이게)
        local tipBox = _UIKit:Get("Tip")
        if isvalid(tipBox) then
            local c = tipBox.SpriteGUIRendererComponent.Color
            tipBox.SpriteGUIRendererComponent.Color = Color(c.r, c.g, c.b, 0.62)
        end
        _UIKit:RegisterWindow("MenuWin")
        -- 버프 칩: PC는 마우스를 올리면 설명 상자, 모바일은 누르면 안내 줄 (모바일은 마우스를 올릴 수 없다 · 10-24 사용자)
        self.BuffDescs = {}
        _UIKit:SetEnabled("Buffs/Tip", false)
        local mobile = Environment:IsMobilePlatform()
        for i = 1, 8 do
            local index = i
            if mobile then
                _UIKit:Connect("Buffs/B" .. tostring(i), function()
                    local d = self.BuffDescs[index]
                    if d ~= nil then _NoticeFeed:Push(d) end
                end)
            else
                local chip = _UIKit:Get("Buffs/B" .. tostring(i))
                if isvalid(chip) then chip:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnBuffHover(index, event.state) end) end
            end
        end
        -- 스킬 칸: 누르면 그 칸에 넣을 스킬을 고른다 (시전은 A S D F·우클릭)
        for i = 1, 5 do
            local slot = i
            _UIKit:Connect("Bottom/Slots/Slot" .. tostring(i), function() _SkillPicker:Open(slot) end)
        end
        -- 벨트 칸: 클릭 = 사용(빈 칸이면 지정 창), 우클릭 = 넣을 물건 바꾸기
        for i = 1, 4 do
            local index = i
            _UIKit:Connect("Bottom/Slots/Belt" .. tostring(i), function() self:UseBelt(index) end)
            _UIKit:ConnectHold("Bottom/Slots/Belt" .. tostring(i), function(event) self:BeltDown(index, event.TouchId) end, function(event) end)
        end
        local menu = { { "Inv", "InvWin" }, { "Char", "CharWin" }, { "Skill", "SkillWin" }, { "Quest", "QuestWin" }, { "Social", "SocialWin" } }
        for _, m in ipairs(menu) do
            local win = m[2]
            _UIKit:Connect("Bottom/Menu/Btn" .. m[1], function() _UIKit:Toggle(win) end)
            _UIKit:Connect("MenuWin/" .. m[1], function() self:FromMenu(win) end)
        end
        _UIKit:Connect("Bottom/Menu/BtnShadow", function() _ShadowHUD:ToggleWindow() end)
        _UIKit:Connect("Bottom/Menu/BtnRank", function() _RankWindow:Show("progress") end)
        _UIKit:Connect("Bottom/Menu/BtnExtract", function() self:Extract() end)
        self:CompactMenuRow()
        _UIKit:Connect("MenuWin/Shadow", function() self:FromMenu("") _ShadowHUD:ToggleWindow() end)
        _UIKit:Connect("MenuWin/Rank", function() self:FromMenu("") _RankWindow:Show("progress") end)
        _UIKit:Connect("MenuWin/Rune", function() self:FromMenu("") _RuneWindow:Show("words") end)
        _UIKit:SetText("MenuWin/Input/Label", "설정")
        _UIKit:Connect("MenuWin/Input", function() self:FromMenu("AudioWin") end)
        _UIKit:Connect("MenuWin/BtnClose", function() _UIKit:Close("MenuWin") end)
        _UIKit:Connect("MenuWin/CharSel", function() self:FromMenu("") self:AskCharSelect() end)
        -- 10-21 방 구조: 게임 방에서는 「게임 나가기」(로비로), 로비에서는 「채널 변경」
        _UIKit:Connect("MenuWin/Channel", function()
            self:FromMenu("")
            if self:InLobby() then _ChannelWindow:Show() else self:AskLeaveGame() end
        end)
        _UIKit:Connect("MenuWin/Guide", function() self:FromMenu("") _GuideWindow:Show(1) end)
        _UIKit:Connect("BtnMenu", function() _UIKit:Toggle("MenuWin") end)
        _UIKit:Connect("QuestTrack", function() self:OpenQuestFromTrack() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        log("[HudMain] 시작")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 창 단축키 (스킬·물약·소환 키는 각 컴포넌트가 받는다)
        local k = event.key
        if k == KeyboardKey.U then _UIKit:Toggle("CharWin")
        elseif k == KeyboardKey.I then _UIKit:Toggle("InvWin")
        elseif k == KeyboardKey.K then _UIKit:Toggle("SkillWin")
        elseif k == KeyboardKey.Q then _UIKit:Toggle("QuestWin")
        elseif k == KeyboardKey.P then _UIKit:Toggle("SocialWin")
        elseif k == KeyboardKey.L then _RankWindow:Toggle()
        elseif k == KeyboardKey.M then _UIKit:Toggle("MenuWin") end
    end

    method boolean InLobby()
        -- 로비(정적 방 map01)에 있는가 — 클라이언트는 방 키를 모르므로 맵 이름으로 본다
        local me = _UserService.LocalPlayer
        return isvalid(me) and isvalid(me.CurrentMap) and me.CurrentMap.Name == _GameConst.MapLobby
    end

    @ExecSpace("ClientOnly")
    method void AskLeaveGame()
        -- 메뉴 「게임 나가기」: 확인 후 저장하고 로비로 (RoomSystem.RequestLeaveGame) — 방 창에서 다른 게임을 고른다
        _ConfirmDialog:Show("게임 나가기", "지금 캐릭터를 저장하고 로비로 나갑니다.\n혼자 하기·방 만들기·다른 방 들어가기를 다시 고를 수 있습니다.", "나가기", function()
            _RoomSystem:RequestLeaveGame()
        end)
    end

    @ExecSpace("ClientOnly")
    method void AskCharSelect()
        -- 메뉴 「캐릭터 선택으로」: 확인 후 저장하고 선택 화면으로 (PlayerSave.RequestCharSelect)
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil or save.Selecting then return end
        _ConfirmDialog:Show("캐릭터 선택", "지금 캐릭터를 저장하고 캐릭터 선택 화면으로 갑니다.\n다른 캐릭터로 들어가거나 새 캐릭터를 만들 수 있습니다.", "이동", function()
            save:RequestCharSelect()
        end)
    end

    @ExecSpace("ClientOnly")
    method void FromMenu(string win)
        -- 메뉴에서 고르면 메뉴는 닫고 그 창을 연다
        _UIKit:Close("MenuWin")
        if win ~= "" then _UIKit:Open(win) end
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void RenderBuffs(Entity player, PlayerStats st)
        -- 버프·디버프 줄 (10-11 팀 QA): 신전 축복 · 호령 · 냉기 둔화 · 미라 저주. 위쪽 가운데 신전 글자는 없앴다 (메시지 정리)
        _UIKit:SetEnabled("ShrineBuff", false)
        local now = _UtilLogic.ServerElapsedSeconds
        local list = {}
        ---@type SkillBook
        local book = player:GetComponent("script.SkillBook")
        if book ~= nil and book:GetLevel("wraith_dash") > 0 and not Environment:IsMobilePlatform() and not _GameConst:IsTown(player.CurrentMap) then
            -- 망령 질주 칸 (10-24 사용자: 스페이스에 고정이라 쿨타임이 안 보였다 · 모바일은 질주 단추가 보여 준다) — 맨 앞에 남은 횟수, 다 쓰면 어둡게 + 남은 초
            local def = _SkillData:Get("wraith_dash")
            local cd = book:CooldownLeft("wraith_dash")
            local max = 1 + book:Node("dash_charge")
            local name = book:Node("dash_blink") > 0 and "망령 도약" or "망령 질주"
            table.insert(list, { key = "skill_dash", icon = def ~= nil and def.icon or nil, label = "질주", color = Color(0.55, 0.75, 1, 1), left = -1, dim = cd > 0.05,
                timeText = cd > 0.05 and string.format("%.1f초", cd) or (max > 1 and (tostring(book.DashShown) .. "/" .. tostring(max)) or ""),
                desc = string.format("%s · %s · 남은 횟수 %d/%d", name, Environment:IsMobilePlatform() and "질주 단추" or "스페이스", book.DashShown, max) })
        end
        local info = _GameConst:ShrineInfo(st.ShrineKind)
        if info ~= nil and st.ShrineUntil > now then
            table.insert(list, { key = "buff_" .. st.ShrineKind, label = info.short or info.name, color = info.color, left = st.ShrineUntil - now, desc = info.name .. " · " .. info.desc })
        end
        if book ~= nil and book:GetLevel("command_aura") > 0 then
            local aura = book:GetCommandAura()
            table.insert(list, { key = "buff_command", label = "호령", color = Color(0.95, 0.78, 0.35, 1), left = -1,
                desc = string.format("호령 · 그림자·언데드 공격·생명 +%d%%, 이동 +%d%%, 모든 저항 +%d", math.floor(aura.atk), math.floor(aura.speed), math.floor(aura.resist)) })
        end
        self:AddAuraBuffs(player, book, list)
        if st.BoneArmor > 0 then
            table.insert(list, { key = "buff_bone_armor", label = "뼈갑옷", color = Color(0.85, 0.8, 0.65, 1), left = -1, timeText = tostring(math.floor(st.BoneArmor)), desc = string.format("뼈 갑옷 · 피해 흡수 %d / %d 남음", math.floor(st.BoneArmor), math.floor(st.BoneArmorMax)) })
        end
        if st.ChillUntil > now then
            table.insert(list, { key = "debuff_chill", label = "둔화", color = Color(0.4, 0.65, 1, 1), left = st.ChillUntil - now, desc = "냉기 둔화 · 이동 속도 -40% (냉기 저항이 높을수록 짧아집니다)", debuff = true })
        end
        if st.CorrodeUntil > now and st.CorrodeAmount > 0 then
            table.insert(list, { key = "aura_corrode", label = "부식", color = _GameConst:AuraColor("corrode"), left = -1, desc = string.format("부식 오오라 · 내 모든 저항 -%d (변종 몬스터 곁 — 벗어나면 풀립니다)", st.CorrodeAmount), debuff = true })
        end
        if st.ShockUntil > now then
            table.insert(list, { key = "debuff_shock", label = "감전", color = Color(0.7, 0.88, 1, 1), left = st.ShockUntil - now, desc = "감전 · 번개 연쇄에 맞았습니다 (번개 저항이 높을수록 피해가 줄어듭니다)", debuff = true })
        end
        if st.PotionCurseUntil > now then
            table.insert(list, { key = "debuff_potion_curse", label = "저주", color = Color(0.75, 0.3, 0.55, 1), left = st.PotionCurseUntil - now, desc = "미라의 저주 · 물약 회복 -30%", debuff = true })
        end
        self.BuffDescs = {}
        for i = 1, 8 do
            local b = list[i]
            local path = "Buffs/B" .. tostring(i)
            _UIKit:SetEnabled(path, b ~= nil)
            if b ~= nil then
                _UIKit:SetPos(path, Vector2((i - 1) * 64, 0))   -- 칩 피벗이 왼쪽 가운데
                self.BuffDescs[i] = b.desc
                -- 칩 그림(ui_icons.csv의 buff_*·debuff_* — 코덱스)이 있으면 그림 + 남은 시간만, 없으면 색 원 + 짧은 이름
                local icon = b.icon or _GameData:GetUiIcon(b.key)
                _UIKit:SetEnabled(path .. "/Frame", b.debuff == true and icon ~= "")
                -- 오오라 칩은 등급 테두리 (옅은·짙은·극한)
                local tierIcon = (b.tier ~= nil and icon ~= "") and _GameData:GetUiIcon("aura_tier" .. tostring(b.tier)) or ""
                _UIKit:SetEnabled(path .. "/Tier", tierIcon ~= "")
                if tierIcon ~= "" then _UIKit:SetIcon(path .. "/Tier", tierIcon) end
                if icon ~= "" then
                    _UIKit:SetIcon(path, icon)
                    _UIKit:SetColor(path, b.dim == true and Color(0.4, 0.4, 0.45, 1) or Color(1, 1, 1, 1))
                    _UIKit:SetText(path .. "/Label", "")
                else
                    local c = b.color
                    _UIKit:SetIcon(path, _GameData:GetUiIcon("circle"))
                    _UIKit:SetColor(path, Color(c.r * 0.55, c.g * 0.55, c.b * 0.55, 0.92))
                    _UIKit:SetText(path .. "/Label", _UIKit:Colored(b.debuff and "#FFB0B0" or "#FFFFFF", b.label))
                end
                _UIKit:SetText(path .. "/Time", b.timeText or (b.left >= 0 and (tostring(math.ceil(b.left)) .. "초") or ""))
            end
        end
        if self.HoverBuff > 0 then self:RenderBuffTip() end
    end

    @ExecSpace("ClientOnly")
    method void AddAuraBuffs(Entity player, SkillBook book, table list)
        -- 나·소환수에게 지금 닿는 오오라 (10-24 사용자): 항상 켜진 스킬 오오라 + 변종 그림자의 오오라(내 소환수가 반경 안일 때) + 근처 다른 플레이어의 호령
        if book ~= nil then
            local stepLv = book:GetPowerLevel("swift_step")
            if stepLv > 0 then
                local def = _SkillData:Get("swift_step")
                table.insert(list, { key = "buff_swift_step", icon = def ~= nil and def.icon or nil, label = "걸음", color = Color(0.6, 0.85, 0.7, 1), left = -1,
                    desc = string.format("가벼운 걸음 · 내 이동 속도 +%g%%", book:GetEffectPower("swift_step", stepLv)) })
            end
            ---@type PlayerStats
            local ast = player:GetComponent("script.PlayerStats")
            if ast ~= nil and ast.AfterStepUntil > _UtilLogic.ServerElapsedSeconds then
                -- 강화 「잔걸음」(44 결정 4): 질주 뒤 잠깐 빨라진 동안
                local def = _SkillData:Get("step_gale")
                table.insert(list, { key = "buff_after_step", icon = def ~= nil and def.icon or nil, label = "잔걸음", color = Color(0.6, 0.82, 1, 1), left = ast.AfterStepUntil - _UtilLogic.ServerElapsedSeconds,
                    desc = string.format("잔걸음 · 질주 뒤 이동 속도 +%d%%", math.floor(ast.AfterStepPct)) })
            end
            ---@type PlayerStats
            local st = player:GetComponent("script.PlayerStats")
            if st ~= nil and st.HuntUntil > _UtilLogic.ServerElapsedSeconds and book:Node("step_hunt") > 0 then
                table.insert(list, { key = "buff_step_hunt", label = "사냥", color = Color(0.95, 0.7, 0.4, 1), left = st.HuntUntil - _UtilLogic.ServerElapsedSeconds,
                    desc = string.format("사냥꾼의 걸음 · 처치 뒤 이동 속도 +%d%%", 4 * book:Node("step_hunt")) })
            end
        end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        local units = map:GetChildComponentsByTypeName("script.ShadowUnit", true)
        local mine = { _Util:Pos2(player) }   -- 나도 그림자 오오라를 받는다 (10-24)
        for _, c in ipairs(units) do
            ---@type ShadowUnit
            local u = c
            if isvalid(u.Entity) and u.Entity.Enable and u.OwnerPlayer == player and u.Hp > 0 then table.insert(mine, _Util:Pos2(u.Entity)) end
        end
        -- 변종 그림자 오오라: 같은 효과는 가장 센 것 하나만 (서버 ReceiveAura도 최댓값만 쓴다)
        local best = {}
        for _, c in ipairs(units) do
            ---@type ShadowUnit
            local u = c
            local v = (isvalid(u.Entity) and u.Entity.Enable and u.Hp > 0 and u.Variant ~= "") and _GameData:GetVariantOf(u.Variant, "aura") or nil
            if v ~= nil and (best[v.effect] == nil or v.value > best[v.effect].v.value) then
                local src = _Util:Pos2(u.Entity)
                for _, q in ipairs(mine) do
                    if (q - src):Magnitude() <= v.radius then
                        local name = _GameData:GetMonsterName(string.match(u.Entity.Name, "^Shadow_(.+)$") or "")
                        best[v.effect] = { v = v, from = u.OwnerPlayer == player and ("내 그림자 " .. name) or ("다른 플레이어의 그림자 " .. name) }
                        break
                    end
                end
            end
        end
        for _, effect in ipairs({ "dmg", "haste", "move", "guard", "regen", "resist", "thorns", "crit", "corrode" }) do
            local b = best[effect]
            if b ~= nil then
                local whom = effect == "corrode" and ("반경 %g 안 적") or ("반경 %g 안 나와 소환수")
                table.insert(list, { key = "aura_" .. effect, label = string.match(b.v.name, "^(%S+)") or b.v.name, color = _GameConst:AuraColor(effect), left = -1, tier = _GameData:AuraTier(b.v.value),
                    desc = string.format("%s · " .. whom .. " %s (%s)", b.v.label, b.v.radius, b.v.text, b.from) })
            end
        end
        -- 근처 다른 플레이어의 호령은 내 소환수에도 닿는다 (ShadowUnit.PartyAuraTick · 반경 6)
        if #mine > 1 then   -- 나 말고 소환수가 있을 때 (호령은 소환수에게만)
            local me = _Util:Pos2(player)
            for _, p in ipairs(_UserService:GetUsersByMapComponent(map.MapComponent) or {}) do
                if p ~= player and isvalid(p) and (_Util:Pos2(p) - me):Magnitude() <= 6 then
                    ---@type SkillBook
                    local other = p:GetComponent("script.SkillBook")
                    if other ~= nil and other:GetLevel("command_aura") > 0 then
                        local aura = other:GetCommandAura()
                        table.insert(list, { key = "buff_command", label = "호령", color = Color(0.95, 0.78, 0.35, 1), left = -1,
                            desc = string.format("동료의 호령 · 내 소환수 공격 +%d%%, 이동 +%d%%", math.floor(aura.atk), math.floor(aura.speed)) })
                        break
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnBuffHover(integer index, ButtonState state)
        -- 마우스가 칩 위에 있는 동안만 설명 상자 (칩 줄 바로 위, 그 칩 왼쪽에 맞춘다)
        if state == ButtonState.Normal and self.HoverBuff == index then self.HoverBuff = 0 end
        if state == ButtonState.Hover then self.HoverBuff = index end
        self:RenderBuffTip()
    end

    @ExecSpace("ClientOnly")
    method void RenderBuffTip()
        -- 칩이 사라지거나 바뀌어도 설명 상자를 지금 칩 내용에 맞춘다 (남은 초가 바뀌는 신전 축복 등)
        local index = self.HoverBuff
        local d = index > 0 and self.BuffDescs[index] or nil
        if d == nil then
            _UIKit:SetEnabled("Buffs/Tip", false)
            return
        end
        _UIKit:SetText("Buffs/Tip/Text", d)
        _UIKit:SetPos("Buffs/Tip", Vector2((index - 1) * 64, 64))
        _UIKit:SetEnabled("Buffs/Tip", true)
    end

    method string Hex(Color c)
        return string.format("#%02X%02X%02X", math.floor(c.r * 255), math.floor(c.g * 255), math.floor(c.b * 255))
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or st == nil then return end
        local pc = player.PlayerComponent
        local hp = pc.Hp / math.max(1, pc.MaxHp)
        local mp = st.Mana / math.max(1, st.MaxMana)
        self:RenderBuffs(player, st)
        local hpText = tostring(math.floor(pc.Hp)) .. "/" .. tostring(math.floor(pc.MaxHp))
        local mpText = tostring(math.floor(st.Mana)) .. "/" .. tostring(math.floor(st.MaxMana))
        -- PC = 양쪽 아래 오브, 모바일 = 왼쪽 위 캐릭터 틀의 막대 (docs/ui/mobile-layout.md)
        for _, orb in ipairs({ { "LifeOrb", hp, hpText }, { "MFrame/Hp", hp, hpText }, { "ManaOrb", mp, mpText }, { "MFrame/Mp", mp, mpText } }) do
            _UIKit:SetFill(orb[1] .. "/Fill", orb[2])
            _UIKit:SetText(orb[1] .. "/Text", orb[3])
        end
        _UIKit:SetText("MFrame/Lv/Text", tostring(st.Level))
        _UIKit:SetFill("XP/Fill", st.Exp / math.max(1, st.ExpToNext))
        _UIKit:SetText("XP/Text", string.format("Lv %d   경험치 %d / %d", st.Level, st.Exp, st.ExpToNext))
        self:ApplyCamera()
        self:RenderSlots()
        self:RenderCooldowns()
        self:RenderBadges(st)
        self:RenderLocks(st)
        self:RenderTarget(player)
        self:RenderQuestTrack(player)
        _UIKit:SetEnabled("QuestTrack", _HudMap:ShouldShowQuestTrack() and self.QuestTrackKey ~= self.QuestTrackSeen)
        self:RenderParty()
        _UIKit:SetText("MenuWin/Channel", self:InLobby() and "채널 변경" or "게임 나가기")
        self:RenderTip(player, st)
        self:RenderSoulUi(player)
        self:RenderStreak(st)
    end

    @ExecSpace("ClientOnly")
    method void RenderStreak(PlayerStats st)
        -- 머리 위 콤보 (10-28 사용자 A안 · 글귀 「COMBO 12」): comboShowFrom(2)부터. 수가 오르면 글자를 바꾸고 툭 튀게, 끊기면 흐려진다.
        -- 위치·크기는 매 프레임 RenderCombo가 (0.15초 갱신으로는 걸을 때 뒤처진다)
        local n = st ~= nil and st.KillStreak or 0
        local now = _UtilLogic.ElapsedSeconds
        if n >= _GameData.comboShowFrom then
            if n ~= self.ComboN then
                local function tier(k) if k >= 100 then return 4 elseif k >= 50 then return 3 elseif k >= 25 then return 2 elseif k >= _GameData.streakShowFrom then return 1 end return 0 end
                self.ComboTierUp = tier(n) > tier(self.ComboN)
                self.ComboN = n
                self.ComboPunchAt = now
                self.ComboFadeAt = 0
                local color = "#FFFFFF"
                if n >= 100 then color = "#FF4A6A" elseif n >= 50 then color = "#FF7A4A" elseif n >= 25 then color = "#FFB050" elseif n >= _GameData.streakShowFrom then color = "#FFE15A" end
                _UIKit:SetText("ComboHead", _UIKit:Colored(color, "<size=55%>COMBO</size> " .. tostring(n)))
            end
        elseif self.ComboN > 0 and self.ComboFadeAt == 0 then
            self.ComboFadeAt = now
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderCombo()
        -- 머리 위 콤보를 캐릭터 머리 위에 붙이고, 툭 튀기(0.18초) · 끊기면 0.5초 동안 떠오르며 흐려진다
        local player = _UserService.LocalPlayer
        local now = _UtilLogic.ElapsedSeconds
        local fade = self.ComboFadeAt > 0 and math.min(1, (now - self.ComboFadeAt) / 0.5) or 0
        if fade >= 1 or not isvalid(player) then
            self.ComboN = 0
            self.ComboFadeAt = 0
            _UIKit:SetEnabled("ComboHead", false)
            return
        end
        local e = _UIKit:Get("ComboHead")
        if not isvalid(e) then return end
        e.Enable = not _UIKit:AnyWindowOpen()
        local t = now - self.ComboPunchAt
        local pop = math.max(0, 1 - t / 0.18) * (self.ComboTierUp and 0.7 or 0.4)
        e.UITransformComponent.UIScale = Vector3(1 + pop, 1 + pop, 1)
        _UIKit:SetPos("ComboHead", self:WorldToHud(_Util:Pos2(player) + Vector2(0, 1.35 + fade * 0.4)))   -- 머리 바로 위 (1.85는 위쪽 안내 띠에 걸렸다 — 메이커 10-28)
        local text = e.TextGUIRendererComponent
        local c = text.FontColor
        text.FontColor = Color(c.r, c.g, c.b, 1 - fade)
        local o = text.OutlineColor
        text.OutlineColor = Color(o.r, o.g, o.b, 1 - fade)
    end

    @ExecSpace("ClientOnly")
    method void ExtractPop(Vector2 worldPos, string text, Color color)
        -- 추출 결과: 혼 자리에서 글자가 떠오른다 (PopSeconds 동안)
        self.PopPos = worldPos
        self.PopUntil = _UtilLogic.ElapsedSeconds + self.PopSeconds
        _UIKit:SetText("ExtractPop", text)
        local e = _UIKit:Get("ExtractPop")
        if isvalid(e) then e.TextGUIRendererComponent.FontColor = color end
        self:RenderSoulUi(_UserService.LocalPlayer)
    end

    @ExecSpace("ClientOnly")
    method void ShowWarn(string text)
        -- 지금 한 행동이 안 된 이유: 내 캐릭터 머리 위에 주황 글씨로 잠깐 (같은 문구가 이어지면 시간만 늘린다)
        self.WarnText = text
        self.WarnUntil = _UtilLogic.ElapsedSeconds + self.WarnSeconds
        _UIKit:SetText("WarnPop", text)
        self:RenderWarn()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 경고 글씨·머리 위 콤보는 캐릭터를 매 프레임 따라간다 (0.15초 갱신으로는 걸을 때 뒤처졌다). 떠 있을 때만
        if self.ComboN > 0 then self:RenderCombo() end
        if self.WarnUntil > 0 then
            self:RenderWarn()
            if _UtilLogic.ElapsedSeconds >= self.WarnUntil then self.WarnUntil = 0 end
        end
        if self.RaidUntil > 0 then self:RenderRaid() end
        if self.RaidPlateUntil > 0 then self:RenderRaidPlate() end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book ~= nil and book.RiteHoldAt >= 0 then self:RenderRite(book)
        elseif self.RiteShown then self:HideRite() end
    end

    @ExecSpace("ClientOnly")
    method void RenderRite(SkillBook book)
        -- 뼈 의식 충전 고리 (기획서 43 §3-1 · 결정 1A · 임시 그림): 누르는 동안 머리 위에 고리가 위에서 시계 방향으로 차고,
        -- 가운데 숫자 = 지금 떼면 나갈 단계(해골·재사용·마나가 모자라면 낮춘 값), 아래 = 단계 이름, 눈금 점 = 2·3·5기 문턱 (넘으면 밝아진다).
        -- 5기 문턱은 악몽이 열린 뒤에만 보이고, 그 전에는 고리 한 바퀴 = 3기(1초)
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not _UIKit:CanUseGameplayInput() or book:GetSlotSkill(book.RiteHoldSlot) ~= "bone_rite" then
            book:CancelRiteHold()
            self:HideRite()
            return
        end
        local held = _UtilLogic.ElapsedSeconds - book.RiteHoldAt
        local giant = book:RiteGiantUnlocked()
        local top = giant and _GameData.riteHold5 or _GameData.riteHold3
        local want = book:RiteStageForHold(held, giant)
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local stage = book:RiteBestStage(want, st ~= nil and st.Mana or -1)
        _UIKit:SetEnabled("RiteRing", true)
        _UIKit:SetPos("RiteRing", self:WorldToHud(_Util:Pos2(player) + Vector2(0, 1.8)))
        _UIKit:SetFill("RiteRing/Fill", held / math.max(0.1, top))
        local colors = { [0] = Color(0.45, 0.42, 0.4, 0.9), [1] = Color(0.85, 0.8, 0.7, 0.95), [2] = Color(0.62, 0.86, 0.8, 0.95), [3] = Color(0.96, 0.82, 0.45, 0.95), [5] = Color(0.92, 0.42, 0.3, 0.95) }
        _UIKit:SetColor("RiteRing/Fill", colors[stage] or colors[0])
        -- 눈금: 고리 위쪽(12시)에서 시계 방향으로 문턱 비율만큼 (FillOrigin 2 · 시계 방향 — tools/build/ui.cjs RiteRing)
        local marks = { { "T2", _GameData.riteHold2, true }, { "T3", _GameData.riteHold3, true }, { "T5", _GameData.riteHold5, giant } }
        for _, m in ipairs(marks) do
            local path = "RiteRing/" .. m[1]
            _UIKit:SetEnabled(path, m[3] and m[2] <= top + 0.001)
            if m[3] then
                local a = 2 * math.pi * math.min(1, m[2] / top)
                _UIKit:SetPos(path, Vector2(41 * math.sin(a), 12 + 41 * math.cos(a)))
                _UIKit:SetColor(path, held >= m[2] and Color(1, 0.95, 0.8, 1) or Color(0.43, 0.4, 0.35, 1))
            end
        end
        if stage ~= self.RiteLastStage or not self.RiteShown then
            -- 단계 이름 · 낮춰 나갈 때는 「{단계}까지만」 (10-29 사용자 확정 — 까닭이 해골·마나·재사용 대기 어느 것이든 같은 글)
            local names = { [1] = "해골 폭탄", [2] = "뼈 회오리", [3] = "뼈 화살", [5] = "뼈 거인" }
            local label = stage == 0 and "해골 없음" or names[stage]
            if stage > 0 and stage < want then label = label .. "까지만" end
            _UIKit:SetText("RiteRing/Count", stage > 0 and tostring(stage) or "-")
            _UIKit:SetText("RiteRing/Label", label)
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] rite ring stage=%d want=%d held=%.2f", stage, want, held)) end
            self.RiteLastStage = stage
        end
        self.RiteShown = true
    end

    @ExecSpace("ClientOnly")
    method void HideRite()
        -- 뗐거나 끊겼다: 고리를 거둔다
        _UIKit:SetEnabled("RiteRing", false)
        self.RiteShown = false
        self.RiteLastStage = -1
    end

    @ExecSpace("ClientOnly")
    method void RaidWarn(table pts, number sec, integer act)
        -- 습격 예고 (기획서 41 #7-A · 글귀 「습격이 온다」): 가운데 위 글귀 + 떼가 솟을 자리마다 화면 가장자리 표식(RenderRaid) + 바닥 조짐 + 소리
        -- 10-29 코덱스 전체 납품: 바닥 조짐은 그 맵 액트(RaidDirector가 maps 정보의 act로 보낸다)의 4프레임을 150ms마다 갈아 끼운다 (Util.BeamFx와 같은 방식)
        local now = _UtilLogic.ElapsedSeconds
        for _, d in ipairs(self.RaidDecals) do if d ~= 0 then _EffectService:RemoveEffect(d) end end
        self.RaidDecals = {}
        self.RaidPts = pts
        self.RaidStartAt = now
        self.RaidUntil = now + sec
        self.RaidMarkFrame = 0
        self.RaidMarkRuids = { _GameData:GetUiIcon("ui_raid_edge_mark_1"), _GameData:GetUiIcon("ui_raid_edge_mark_2"), _GameData:GetUiIcon("ui_raid_edge_mark_3") }
        _UIKit:SetText("RaidText", "습격이 온다")
        _UIKit:SetEnabled("RaidText", true)
        _SoundDirector:PlayEffect(_GameConst.SfxCurse, 0.9)
        local a = math.max(1, math.min(4, act))
        self.RaidOmenAct = a
        self.RaidOmenFrames = _Util:KeyFrames(_GameConst.SpriteRaidOmen, "a" .. tostring(a))
        self.RaidOmenTick = 0
        self:RaidOmenDraw()   -- 다음 프레임부터는 RenderRaid(매 화면)가 예고 시작부터 지난 시간으로 150ms마다 갈아 끼운다
        _TimerService:SetTimerOnce(function() self:RaidClear() end, sec + 0.2)
        log(string.format("[VRF] raid warn shown pts=%d sec=%.1f act=%d omenFrames=%d", #pts, sec, act, #self.RaidOmenFrames))
    end

    @ExecSpace("ClientOnly")
    method void RaidOmenDraw()
        -- 바닥 조짐 한 프레임: 떼가 솟을 자리마다 새 프레임을 먼저 깔고 옛 프레임을 지운다 (00 → 03 → 00 반복 · 지름 2.2칸)
        local frames = self.RaidOmenFrames
        local player = _UserService.LocalPlayer
        if #frames == 0 or not isvalid(player) then return end
        local i = self.RaidOmenTick % #frames + 1
        local old = self.RaidDecals
        local fresh = {}
        -- 10-29 사용자 승인: 액트 2 조짐(모래색 그림 평균 200/131/64)은 모래 바닥(240/146/45) 위에서 옅었다 → 액트 2만 검붉게 곱해 대비를 올린다 (그림은 그대로 · 다른 액트는 흰색 = 원래 색)
        local tint = Color(1, 1, 1, 1)
        if self.RaidOmenAct == 2 then tint = Color(0.78, 0.22, 0.17, 1) end
        for _, p in ipairs(self.RaidPts) do
            table.insert(fresh, _Util:GroundDecal(frames[i], 160, 80, player, Vector3(p[1], p[2], 0), 1.1, tint))
        end
        self.RaidDecals = fresh
        for _, d in ipairs(old) do if d ~= 0 then _EffectService:RemoveEffect(d) end end
        if self.RaidOmenTick <= #frames then
            log(string.format("[VRF] raid omen frame act=%d i=%d/%d ruid=%s decals=%d tint=%.2f/%.2f/%.2f t=%.2f", self.RaidOmenAct, i, #frames, frames[i], #fresh, tint.r, tint.g, tint.b, _UtilLogic.ElapsedSeconds - self.RaidStartAt))
        end
    end

    @ExecSpace("ClientOnly")
    method void RaidClear()
        -- 예고 끝: 글귀·표식·조짐을 거둔다
        self.RaidUntil = 0
        _UIKit:SetEnabled("RaidText", false)
        for i = 1, 8 do _UIKit:SetEnabled("RaidMark" .. tostring(i), false) end
        for _, d in ipairs(self.RaidDecals) do if d ~= 0 then _EffectService:RemoveEffect(d) end end
        self.RaidDecals = {}
    end

    @ExecSpace("ClientOnly")
    method void RenderRaid()
        -- 떼가 솟을 자리를 화면 가장자리 안쪽(48px)에 표식으로 — 화면 밖 자리의 방향이 보인다. 크기가 숨 쉬듯 커졌다 작아진다
        -- 10-29 사용자 결정 64px · 코덱스 표식 3프레임(요청서 B-1): 1 나타남(첫 150ms) → 2 긁음(예고 내내) → 3 흩어짐(마지막 150ms)
        local now = _UtilLogic.ElapsedSeconds
        local root = _UIKit:Get("/ui/GameHUD")
        if now >= self.RaidUntil or not isvalid(root) then self:RaidClear() return end
        local size = root.UITransformComponent.RectSize
        local hx, hy = size.x * 0.5 - 48, size.y * 0.5 - 48
        local pulse = 0.85 + 0.15 * math.sin(now * 9)
        local tick = math.floor((now - self.RaidStartAt) / 0.15)
        if tick ~= self.RaidOmenTick and #self.RaidOmenFrames > 1 then
            self.RaidOmenTick = tick
            self:RaidOmenDraw()
        end
        local frame = 2
        if now - self.RaidStartAt < 0.15 then frame = 1 elseif self.RaidUntil - now <= 0.15 then frame = 3 end
        local ruid = self.RaidMarkRuids[frame] or ""
        if frame ~= self.RaidMarkFrame then
            self.RaidMarkFrame = frame
            log(string.format("[VRF] raid mark frame=%d size=%.0f pts=%d t=%.2f", frame, 64 * pulse, #self.RaidPts, now - self.RaidStartAt))
        end
        for i = 1, 8 do
            local name = "RaidMark" .. tostring(i)
            local p = self.RaidPts[i]
            if p ~= nil then
                local q = self:WorldToHud(Vector2(p[1], p[2]))
                _UIKit:SetPos(name, Vector2(math.max(-hx, math.min(hx, q.x)), math.max(-hy, math.min(hy, q.y))))
                local e = _UIKit:Get(name)
                if isvalid(e) then
                    -- 코덱스 표식은 오른쪽을 가리킨다 → 화면 가운데에서 자리 쪽으로 8방향(45°)으로 돌린다
                    local deg = math.deg(math.atan(q.y, q.x))
                    e.UITransformComponent.UIRotation = Vector3(0, 0, math.floor(deg / 45 + 0.5) * 45)
                    e.UITransformComponent.RectSize = Vector2(64 * pulse, 64 * pulse)
                    local sp = e.SpriteGUIRendererComponent
                    if ruid ~= "" and sp ~= nil and sp.ImageRUID.DataId ~= ruid then sp.ImageRUID = DataRef(ruid) end
                end
                _UIKit:SetEnabled(name, true)
            else
                _UIKit:SetEnabled(name, false)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void RaidDefeated(integer n, integer gold)
        -- 격퇴 (글귀 후보 1): 「습격 격퇴 · N마리」 + 골드 주머니 안내 — 10-29 코덱스 격퇴 판(RaidPlate) 위에 알림 띠와 같은 글자 양식으로
        _UIKit:SetText("RaidPlate/Title", "습격 격퇴 · " .. tostring(n) .. "마리")
        _UIKit:SetText("RaidPlate/Body", gold > 0 and ("골드 주머니 " .. tostring(gold) .. "이 발밑에 떨어졌습니다") or "")
        _UIKit:SetEnabled("RaidText", false)
        self.RaidPlateUntil = _UtilLogic.ElapsedSeconds + 4
        self:RenderRaidPlate()
        _SoundDirector:PlayEffect(_GameConst.SfxTreasure, 0.8)
        log(string.format("[VRF] raid plate shown n=%d gold=%d", n, gold))
    end

    @ExecSpace("ClientOnly")
    method void RenderRaidPlate()
        -- 격퇴 판: 끝 0.5초 동안 흐려지고 시간이 다 되면 거둔다 (창이 열려 있으면 가린다)
        local left = self.RaidPlateUntil - _UtilLogic.ElapsedSeconds
        local e = _UIKit:Get("RaidPlate")
        if left <= 0 or not isvalid(e) then
            self.RaidPlateUntil = 0
            _UIKit:SetEnabled("RaidPlate", false)
            return
        end
        if e.CanvasGroupComponent ~= nil then e.CanvasGroupComponent.GroupAlpha = math.min(1, left / 0.5) end
        _UIKit:SetEnabled("RaidPlate", not _UIKit:AnyWindowOpen())
    end

    @ExecSpace("ClientOnly")
    method void RenderWarn()
        local player = _UserService.LocalPlayer
        local now = _UtilLogic.ElapsedSeconds
        local show = now < self.WarnUntil and isvalid(player) and not _UIKit:AnyWindowOpen()
        _UIKit:SetEnabled("WarnPop", show)
        if not show then return end
        local t = 1 - (self.WarnUntil - now) / self.WarnSeconds
        _UIKit:SetPos("WarnPop", self:WorldToHud(_Util:Pos2(player) + Vector2(0, 1.15 + t * 0.25)))
    end

    @ExecSpace("ClientOnly")
    method Vector2 WorldToHud(Vector2 world)
        local root = _UIKit:Get("/ui/GameHUD")
        if not isvalid(root) then return Vector2(0, 0) end
        return _UILogic:ScreenToLocalUIPosition(_UILogic:WorldToScreenPosition(world), root.UITransformComponent)
    end

    @ExecSpace("ClientOnly")
    method void RenderSoulUi(Entity player)
        -- 손 닿는(조금 넘는) 내 혼 위에 추출 확률, 추출 결과 글자 이동
        local now = _UtilLogic.ElapsedSeconds
        local popping = now < self.PopUntil
        _UIKit:SetEnabled("ExtractPop", popping)
        if popping then
            local rise = (self.PopSeconds - (self.PopUntil - now)) * 0.45
            _UIKit:SetPos("ExtractPop", self:WorldToHud(self.PopPos + Vector2(0, 1.1 + rise)))
        end
        local show = false
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if isvalid(player) and extractor ~= nil and book ~= nil and not _UIKit:AnyWindowOpen() then   -- 혼 추출은 Lv1부터 (10-24)
            local soul = extractor:FindNearestSoul(_Util:Pos2(player), _ShadowConfig:GetExtractReach() + 2)
            if soul ~= nil then
                ---@type SoulOrb
                local orb = soul:GetComponent("script.SoulOrb")
                if orb ~= nil then
                    show = true
                    local pct = math.floor(extractor:ChanceFor(orb) * 100 + 0.5)
                    local key = Environment:IsMobilePlatform() and "그림자 추출" or "E 그림자 추출"
                    local color = "#FF9A5A"
                    if pct >= 60 then color = "#8CF08C" elseif pct >= 35 then color = "#FFE15A" end
                    if orb.Rank == "boss" then
                        -- 10-28 피드백 F1 #5-C: 보스 혼은 확정 대신 확률을 크게 — 「이 보스를 내 편으로」가 눈에 띄게 (보스 추출 5%는 그대로)
                        _UIKit:SetText("SoulHint", _UIKit:Colored("#F0D9A0", "보스의 혼") .. "\n" .. key .. " " .. _UIKit:Colored(color, "<size=150%>" .. tostring(pct) .. "%</size>"))
                    else
                        _UIKit:SetText("SoulHint", key .. " " .. _UIKit:Colored(color, tostring(pct) .. "%"))
                    end
                    local q = soul.TransformComponent.WorldPosition
                    _UIKit:SetPos("SoulHint", self:WorldToHud(Vector2(q.x, q.y + 0.75)))
                end
            end
        end
        _UIKit:SetEnabled("SoulHint", show and not popping)
    end

    @ExecSpace("ClientOnly")
    method void RenderSlots()
        -- 스킬 칸 아이콘 (빈 칸은 비움) + 벨트 물약 아이콘·개수. 바뀌었을 때만
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if book == nil or belt == nil then return end
        -- 벨트 칸은 다음에 마실 등급이 바뀌면 다시 그린다 (가방 내용이 키)
        ---@type PlayerInventory
        local inv = _UIKit:Comp("script.PlayerInventory")
        local key = book.Slots .. "#" .. book.RightSkill .. "#" .. belt.Layout .. "#" .. (inv ~= nil and inv.BagDigest or "") .. "#" .. tostring(belt:CountOf("tp"))
        if key == self.SlotKey then return end
        self.SlotKey = key
        for i = 1, 5 do _UIKit:SetIcon("Bottom/Slots/Slot" .. tostring(i) .. "/Icon", self:SkillIcon(book:GetSlotSkill(i))) end
        -- 벨트: 칸마다 넣은 물건 — 물약은 다음에 마실 등급(낮은 것부터)의 그림·그 등급 개수 (빈 칸은 그림 없이)
        for i = 1, 4 do
            local path = "Bottom/Slots/Belt" .. tostring(i)
            local view = belt:SlotView(i)
            _UIKit:SetIcon(path .. "/Icon", view.icon)
            _UIKit:SetColor(path .. "/Icon", view.count > 0 and Color(1, 1, 1, 1) or Color(1, 1, 1, 0.35))
            _UIKit:SetText(path .. "/Count", view.count < 0 and "" or tostring(view.count))
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderCooldowns()
        -- 스킬 칸 쿨다운 덮개 (시계 방향으로 줄어듦) + 남은 초
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        for i = 1, 5 do
            _UIKit:ShowCooldown("Bottom/Slots/Slot" .. tostring(i) .. "/Cd", book, book:GetSlotSkill(i))
            _UIKit:ShowRiteStages("Bottom/Slots/Slot" .. tostring(i) .. "/Stage", book, book:GetSlotSkill(i))
        end
    end

    method string SkillIcon(string id)
        if id == "" then return "" end
        local def = _SkillData:Get(id)
        if def == nil then return "" end
        return def.icon
    end

    @ExecSpace("ClientOnly")
    method void RenderLocks(PlayerStats st)
        -- 10-24: 혼 추출이 Lv1부터라 그림자 메뉴·추출 단추도 처음부터 열어 둔다 (예전엔 Lv5 전 흐리게 + 「Lv5」)
        local need = 1
        local locked = st.Level < need
        if locked == self.ShadowLocked then return end
        self.ShadowLocked = locked
        if self.LockIconColors == nil then self.LockIconColors = {} end
        for _, p in ipairs({ { "Bottom/Menu/BtnShadow", "그림자" }, { "Bottom/Menu/BtnExtract", "그림자 추출" }, { "MenuWin/Shadow", "그림자" } }) do
            local icon = _UIKit:Get(p[1] .. "/Icon")
            if isvalid(icon) then
                local base = self.LockIconColors[p[1]]
                if base == nil then
                    base = icon.SpriteGUIRendererComponent.Color
                    self.LockIconColors[p[1]] = base
                end
                icon.SpriteGUIRendererComponent.Color = locked and Color(base.r * 0.4, base.g * 0.4, base.b * 0.4, base.a * 0.8) or base
            end
            _UIKit:SetText(p[1] .. "/Label", locked and ("Lv" .. tostring(need) .. "부터") or p[2])
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderBadges(PlayerStats st)
        -- 쓸 포인트가 있으면 메뉴·능력치·스킬 버튼에 빨간 점. 상황 안내(GuideCoach)가 가리키는 점도 함께 켠다 (깜빡임은 GuideCoach)
        local key = tostring(st.StatPoints) .. "#" .. tostring(st.SkillPoints) .. "#" .. _GuideCoach.PointKey
        if key == self.BadgeKey then return end
        self.BadgeKey = key
        local stat = st.StatPoints > 0
        local skill = st.SkillPoints > 0
        local g = function(path) return _GuideCoach:Wants(path) end
        _UIKit:SetEnabled("BtnMenu/Badge", stat or skill or g("BtnMenu/Badge"))
        _UIKit:SetEnabled("Bottom/Menu/BtnChar/Badge", stat or g("Bottom/Menu/BtnChar/Badge"))
        _UIKit:SetEnabled("Bottom/Menu/BtnSkill/Badge", skill or g("Bottom/Menu/BtnSkill/Badge"))
        _UIKit:SetEnabled("MenuWin/Char/Badge", stat or g("MenuWin/Char/Badge"))
        _UIKit:SetEnabled("MenuWin/Skill/Badge", skill or g("MenuWin/Skill/Badge"))
    end

    @ExecSpace("ClientOnly")
    method void RenderTarget(Entity player)
        -- D2처럼 상단 중앙에 대상 이름·레벨·생명·저주. 우선순위: 커서 아래(마우스 모드, 1.2) → 지금 공격 중인 대상 → 가장 가까운 적(4)
        local m = nil
        ---@type ClickControl
        local cc = player:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            m = _Util:NearestMonster(player.CurrentMap, _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition()), 1.2)
        end
        if m == nil and cc ~= nil and isvalid(cc.AttackTarget) then
            ---@type Monster
            local attacking = cc.AttackTarget:GetComponent("script.Monster")
            if attacking ~= nil and not attacking.IsDead and cc.AttackTarget.Enable then m = attacking end
        end
        if m == nil then m = _Util:NearestMonster(player.CurrentMap, _Util:Pos2(player), 4) end
        _UIKit:SetEnabled("Target", m ~= nil)
        if m == nil then return end
        local prefix = ""
        local color = "#FFFFFF"
        if m.Grade >= 3 then
            prefix = "보스 "
            color = "#C8A050"
        elseif m.DisplayName ~= "" then
            prefix = ""                  -- 이름 있는 적 (모르그·유물 지기·피의 사제): 이름만 금색으로
            color = "#E0B050"
        elseif m.Unique then
            prefix = "최상위 "
            color = "#C8A050"
        elseif m:GetRank() == "champion" then
            prefix = "우두머리 "
            color = "#E070FF"            -- 변종 우두머리 (오오라·기술): 이름표에 능력 이름
        elseif m.Grade == 2 then
            prefix = "정예 "
            color = "#6E8CFF"
        end
        -- 습격의 떼 (기획서 41 글귀 후보 1): 「떼 · 」 · 우두머리는 「떼 우두머리 」
        if m.Horde then prefix = (m.Grade >= 2 or m:GetRank() == "champion") and "떼 우두머리 " or "떼 · " end
        -- 유형 (archetypes.csv): 동작을 쓰는 몬스터만 이름 옆에 옅게
        local arch = (m.Arch ~= "" and m:ArchActive(m.Arch)) and ("  " .. _UIKit:Colored("#A99F8E", _GameData:GetArchetype(m.Arch).name)) or ""
        _UIKit:SetText("Target/Name", _UIKit:Colored(color, prefix .. (m.DisplayName ~= "" and m.DisplayName or _GameData:GetMonsterName(m.SourceId))) .. "  Lv" .. tostring(m.Level) .. arch)
        _UIKit:SetFill("Target/Bar/Fill", m.Hp / math.max(1, m.MaxHp))
        _UIKit:SetText("Target/Curse", self:TargetStatus(m))
    end

    @ExecSpace("ClientOnly")
    method string TargetStatus(Monster monster)
        -- 적의 지원 능력과 현재 저주를 짧게 함께 보여 주어 먼저 잡을 대상을 고를 수 있게 한다.
        local text = ""
        -- 능력이 둘이면 (악몽부터 우두머리 오오라 + 기술) 둘 다, 능력 붙은 정예는 수식어도 앞에
        local parts = {}
        for _, variant in ipairs(_GameData:ParseVariant(monster:GetVariant())) do
            if variant.kind == "aura" then
                local tierColor = variant.tier >= 3 and "#FFB04A" or (variant.tier == 2 and "#9FD0FF" or "#C9BFA8")
                local whom = variant.effect == "corrode" and "" or "주변 적 "
                table.insert(parts, _UIKit:Colored(tierColor, variant.label) .. " · " .. whom .. variant.text)
            elseif variant.kind == "skill" then
                local names = { fire = "화염 ", cold = "냉기 ", light = "번개 " }
                table.insert(parts, variant.name .. " · " .. (names[variant.element] or "") .. "범위 공격")
            elseif variant.kind == "cloud" then
                table.insert(parts, variant.name .. " · 독안개가 남는다")
            end
        end
        text = table.concat(parts, " / ")
        if monster.Grade == 2 and monster:GetRank() ~= "champion" then
            local affix = string.match(monster:GetAffixName(), "^([^·]+)") or ""
            affix = string.gsub(affix, "%s+$", "")
            text = text == "" and monster:GetAffixName() or (affix ~= "" and (affix .. " · " .. text) or text)
        elseif text == "" then
            text = monster:GetAffixName()
        end
        -- 유형 버릇 한 줄 (거구 「예고 강타 (피하기)」 · 방패 「정면 방어 (옆·뒤가 약점)」). 광전사가 광폭하면 붉게
        if monster.Arch ~= "" and monster:ArchActive(monster.Arch) then
            local habit = monster.Enraged and _UIKit:Colored("#FF7A5A", "광폭! 공격·이동이 빨라졌다") or _GameData:GetArchetype(monster.Arch).trait
            if monster.Arch ~= "soldier" then text = text == "" and habit or (text .. " · " .. habit) end
        end
        -- 몬스터 상태 (monster_states.csv — 각성 등): 특성 줄 끝에 그 상태 색으로 (「빠름 · 덮치기 · 각성」)
        local state = _GameData:GetMonsterState(monster.MonsterState)
        if state ~= nil then
            local tag = _UIKit:Colored(state.color, state.name)
            text = text == "" and tag or (text .. " · " .. tag)
        end
        local curse = monster:GetCurseTag()
        if curse ~= "" then text = text == "" and curse or (text .. "\n" .. curse) end
        return text
    end

    @ExecSpace("ClientOnly")
    method void OpenQuestFromTrack()
        -- 의뢰 알림 카드를 누르면 카드는 닫히고 의뢰 창이 열린다. 같은 의뢰·같은 단계의 카드는 다시 띄우지 않는다 (10-21 사용자: 화면 UI 줄이기)
        self.QuestTrackSeen = self.QuestTrackKey
        _UIKit:SetEnabled("QuestTrack", false)
        _UIKit:Open("QuestWin")
    end

    @ExecSpace("ClientOnly")
    method void RenderQuestTrack(Entity player)
        -- 의뢰 알림 카드(글자만): 뱃지 → 제목 → 지역 → 지금 할 일. 의뢰가 바뀌거나 단계(받기 → 진행 → 보고)가 바뀔 때 한 번 뜨고,
        -- 누르면 닫히며 의뢰 창이 열린다. 그 뒤 진행은 의뢰 창(퀘스트 Q)에서 본다
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil then return end
        local q = _QuestData:Get(quest.Index)
        local total = _QuestData:Count()
        self.QuestTrackKey = tostring(quest.Index) .. ":" .. tostring(quest.State)
        local badge, title, caption, goal = "", "", "", ""
        if q == nil then
            badge, title, caption, goal = "완료", "모든 퀘스트 완료", "심도 던전·높은 난이도", "새로운 도전을 찾아보세요"
        elseif quest.State == 0 then
            badge, title, caption, goal = "새 퀘스트", q.title, _GameConst:ActTownName(q.act), _QuestData:GiverName(q.giver) .. "에게 말을 거세요"
        elseif quest.State == 1 then
            badge, title, caption = "퀘스트 " .. tostring(quest.Index) .. "/" .. tostring(total), q.title, quest:StepZone(q)
            goal = self:QuestGoalText(q, quest)
        else
            badge, title, caption, goal = "보고", q.title, _GameConst:ActTownName(q.act), _QuestData:GiverName(q.giver) .. "에게 보고하세요"
        end
        _UIKit:SetText("QuestTrack/Badge/Text", badge)
        _UIKit:SetText("QuestTrack/Title", _UIKit:Clip(title, 16))
        _UIKit:SetText("QuestTrack/Body", caption)
        _UIKit:SetText("QuestTrack/Progress", goal)
    end

    method string QuestGoalText(table q, PlayerQuest quest)
        -- 진행 중 목표 한 줄: 정리 = 남은 수, 열쇠 → 상자 = 단계, 나머지 = n/count
        if q.kind == "clear" then
            local count = quest:CountFor(q)
            if count <= 0 then return q.objective end
            return "남은 망자 " .. tostring(math.max(0, count - quest.Progress)) .. " / " .. tostring(count)
        end
        if q.kind == "chest" or q.kind == "gate" then
            return quest:StepGoal(q)
        end
        if q.count <= 1 then return q.objective end
        return q.objective .. "  " .. string.format("%d/%d", quest.Progress, q.count)
    end

    @ExecSpace("ClientOnly")
    method void RenderParty()
        ---@type PlayerSocial
        local s = _UIKit:Comp("script.PlayerSocial")
        if s == nil then return end
        -- 파티원마다 「이름  Lv」 + 아래 작은 글씨로 지금 있는 곳 (PartySystem.Refresh가 2초마다 갱신)
        local lines = {}
        local n = 0
        for entry in string.gmatch(s.PartyDigest .. ";", "([^;]*);") do
            local _, name, lv, place = string.match(entry, "^([^|]*)|([^|]*)|(%d+)|?(.*)$")
            if name ~= nil then
                n = n + 1
                table.insert(lines, name .. "  Lv" .. lv)
                if place ~= nil and place ~= "" then table.insert(lines, "<size=14><color=#9DB89F>  " .. place .. "</color></size>") end
            end
        end
        local text = ""
        if n > 0 then text = "파티 (" .. tostring(n) .. ")\n" .. table.concat(lines, "\n") end
        _UIKit:SetText("Party/Text", text)
    end

    @ExecSpace("ClientOnly")
    method void RenderTip(Entity player, PlayerStats st)
        -- 현재 단계의 다음 행동 하나만 안내하고 대화·보상 연출 중에는 숨긴다.
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        -- 상황 안내(스킬 습득·그림자 추출·지정·소환·군단 확장)가 있으면 먼저. 의뢰 보고할 때만 보고가 앞선다
        local guide = _GuideCoach:Tip()
        local tip = guide
        if tip == "" or (quest ~= nil and quest.State == 2) then tip = self:JourneyTip(player, st, quest, book) end
        -- 10-11 팀 QA(메시지가 위쪽 가운데·왼쪽으로 흩어짐): 안내는 늘 떠 있지 않고, 바뀌었을 때·맵에 들어왔을 때만 8초.
        -- 계속 볼 내용은 오른쪽 의뢰 칸에 있다 (docs/ui/message-rules.md)
        local now = _UtilLogic.ElapsedSeconds
        local mapId = isvalid(player.CurrentMap) and player.CurrentMap.Id or ""
        if tip ~= self.TipText or mapId ~= self.TipMap then
            local seenRecently = tip == self.TipShownText and now - self.TipShownAt < self.TipRepeatGap
            self.TipText = tip
            self.TipMap = mapId
            if tip == "" then
                self.TipUntil = 0
            elseif not seenRecently then
                self.TipUntil = now + self.TipSeconds
                self.TipShownText = tip
                self.TipShownAt = now
            end
        end
        -- 상황 안내는 창을 연 채 바뀌면(스킬 창에서 습득 등) 창을 닫은 뒤에 보이도록 시간을 붙잡아 둔다
        if tip ~= "" and tip == guide and _UIKit:AnyWindowOpen() then self.TipUntil = math.max(self.TipUntil, now + self.TipSeconds) end
        -- 상황 안내가 남아 있으면 GuideRepeat초마다 다시 보여 준다 (깜빡이는 점은 그동안에도 계속)
        if tip ~= "" and tip == guide and now > self.TipUntil + self.GuideRepeat then self.TipUntil = now + self.TipSeconds end
        -- 위쪽 가운데는 한 번에 하나: 맵 배너가 끝난 뒤 같은 자리에 TipSeconds 동안 (배너 시간만큼 뒤로 민다)
        if _HudMap:BannerShowing() and self.TipUntil > 0 then self.TipUntil = math.max(self.TipUntil, _HudMap.BannerUntil + self.TipSeconds) end
        _UIKit:SetEnabled("Tip", tip ~= "" and now < self.TipUntil and not _HudMap:BannerShowing() and not _UIKit:AnyWindowOpen() and _UXFeedback.Until <= now)
        if tip ~= "" then _UIKit:SetText("Tip/Text", tip) end
    end

    @ExecSpace("ClientOnly")
    method string JourneyTip(Entity player, PlayerStats st, PlayerQuest quest, SkillBook book)
        -- 의뢰의 수락→습득→배치→소환→보고→첫 장비를 실제 저장 상태에서 이어 준다.
        if not _Util:IsAlive(player) or quest == nil then return "" end
        local inTown = _GameConst:IsTown(player.CurrentMap)
        local cur = _QuestData:Get(quest.Index)
        local giver = cur ~= nil and _QuestData:GiverName(cur.giver) or "사제 오렌"
        if quest.State == 2 then
            return inTown and ("목표 달성 — " .. giver .. "에게 보고하고 보상을 받으세요") or ("목표 달성 — " .. _GameConst:WithRo(_GameConst:ActTownName(cur ~= nil and cur.act or 1)) .. " 돌아가 " .. giver .. "에게 보고하세요")
        end
        -- 액트 2·3 첫 의뢰: 액트 이동 NPC에게 (앞 액트 마을에서는 다음 마을로 가는 길부터)
        if cur ~= nil and cur.act >= 2 and quest.Index == _QuestData:LastOfAct(cur.act - 1) + 1 and quest.State == 0 then
            ---@type PlayerTravel
            local travel = player:GetComponent("script.PlayerTravel")
            local mover = "카라반 대장 무하드"   -- 야영지·오아시스의 카라반이 열린 액트 어디로든 (항구에서는 선장, 초소에서는 정찰병)
            if travel ~= nil and travel.Act == 3 then mover = "선장 하그로" elseif travel ~= nil and travel.Act == 4 then mover = "정찰병 카이" end
            if travel ~= nil and travel.Act < cur.act then
                local here = _GameConst:ActTownName(travel.Act)
                -- 한 줄로 (10-12: 「…가 열렸습니다」까지 붙여 두 줄로 넘쳤다. 열림 자체는 장 마무리 카드가 알린다)
                return inTown and (mover .. "에게 말을 걸어 " .. _GameConst:WithRo(_GameConst:ActTownName(cur.act)) .. " (액트 " .. tostring(cur.act) .. ")")
                    or (here .. "의 " .. mover .. "에게 — 다음 길은 " .. _GameConst:ActTownName(cur.act))
            end
            return _GameConst:ActTownName(cur.act) .. "의 " .. _QuestData:GiverName(cur.giver) .. "에게 퀘스트를 받으세요"
        end
        if quest.Index == 1 then
            if quest.State == 0 then
                return inTown and "사제 오렌(미니맵 퀘스트 아이콘)에게 다가가 첫 퀘스트를 받으세요" or "잿불 야영지의 사제 오렌에게 첫 퀘스트를 받으세요"
            end
            if book ~= nil then return self:FirstQuestTip(player, book) end
        elseif quest.Index == 2 then
            ---@type PlayerInventory
            local inv = player:GetComponent("script.PlayerInventory")
            local first = _QuestData:Get(1)
            local reward = first ~= nil and string.match("," .. first.reward, ",item:([^,]+)") or nil
            if inv ~= nil and reward ~= nil then
                -- 이미 다른 등불을 착용했으면 교체를 강요하지 않는다. 보유한 첫 보상에만 안내한다.
                local eq = inv:GetEquipMap()
                local rewardSlot = _ItemData:GetSlot(reward)
                if eq[rewardSlot] == nil or eq[rewardSlot] == "" then
                    for _, item in ipairs(inv:GetBagList()) do
                        if _ItemData:Parse(item).base == _ItemData:Parse(reward).base then
                            return "메뉴 → 인벤토리에서 보상 등불을 장착하세요 — 새로 부르는 소환수가 강해집니다"
                        end
                    end
                end
            end
            if quest.State == 0 then
                return inTown and "사제 오렌에게 다음 퀘스트를 받으세요 — 썩은 갈대 늪의 가라앉은 지하실로" or "잿불 야영지의 사제 오렌에게 다음 퀘스트를 받으세요"
            end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method string FirstQuestTip(Entity player, SkillBook book)
        -- 다른 스킬을 먼저 배웠어도 현재 포인트·슬롯·마나에 맞는 행동을 안내한다.
        ---@type PlayerStats
        local st = player:GetComponent("script.PlayerStats")
        if st == nil then return "" end
        local pc = Environment:IsPCPlatform()
        local skillMenu = pc and "스킬(K)" or "메뉴 → 스킬"
        if book:GetLevel("raise_skeleton") <= 0 then
            local reason = book:CanLearn("raise_skeleton", st.Level, st.SkillPoints)
            if reason == "" then return skillMenu .. "에서 「해골 전사」를 배우세요 — 첫 퀘스트가 훨씬 쉬워집니다" end
            if st.SkillPoints <= 0 then return "황무지에서 적을 처치해 레벨을 올리세요 — 다음 스킬 포인트로 「해골 전사」 습득" end
            return "「해골 전사」 습득 조건: " .. reason .. " — " .. skillMenu .. "에서 확인하세요"
        end
        local key = ""
        local chosenSlot = 0
        local keys = { "A 키", "S 키", "D 키", "F 키", "우클릭" }
        for i = 1, 5 do
            if book:GetSlotSkill(i) == "raise_skeleton" then
                key = pc and keys[i] or (i == 5 and "큰 스킬 버튼" or ("스킬 " .. tostring(i) .. "번"))
                chosenSlot = i
                break
            end
        end
        if key == "" then return skillMenu .. "에서 「해골 전사」를 스킬 1~4번 칸에 지정하세요" end
        if _GameConst:IsTown(player.CurrentMap) then return "미니맵의 황무지 출구로 나가세요 — 황무지 북동쪽 「굶주린 굴」이 목적지" end
        if st.Mana < book:GetManaCost("raise_skeleton", book:GetLevel("raise_skeleton")) then
            return "소환할 마나가 부족합니다 — 마나 회복을 기다리거나 파란 물약을 사용하세요"
        end
        if _UndeadSystem:FindSoul(player, _Util:Pos2(player), 5, true) ~= nil then   -- 해골로 쓸 수 있는 일반 혼
            return "혼이 남았습니다 — 가까이 다가가 혼을 조준하고 「해골 전사」(" .. key .. ") 사용"
        end
        if not pc and chosenSlot == 5 then
            return "혼이 없습니다 — 스킬 창의 「스킬 편집」에서 소환을 1~4번에 두고 큰 공격 칸을 비우면 기본 공격을 쓸 수 있습니다"
        end
        if _GameConst:BaseMapName(player.CurrentMap.Name) == "hollow" then return "" end
        return "황무지 북동쪽 「굶주린 굴」로 — 쓰러뜨린 적의 혼으로 해골 전사를 일으키며 가세요"
    end

    -- ───────── 동작 ─────────

    @ExecSpace("ClientOnly")
    method void ApplyCamera()
        -- 탑다운 카메라: 횡스크롤 기본값(캐릭터를 중앙 아래에 두고 세로로 느리게 따라옴)은 아래로 걸을 때 하단 HUD에 길이 가려졌다.
        -- 캐릭터를 중앙보다 조금 위에 두고(아래 시야 확보) 가로·세로 모두 빨리 따라가게 한다. 맵 이동 뒤에도 다시 맞춘다
        local cam = _CameraService:GetCurrentCameraComponent()
        if not isvalid(cam) or cam == self.TunedCamera then return end
        self.TunedCamera = cam
        cam.ScreenOffset = self.CamScreenOffset
        cam.Damping = self.CamDamping
        cam.DeadZone = self.CamDeadZone
        cam.SoftZone = self.CamSoftZone
        -- 탑뷰 비율: 기본 줌(100)은 캐릭터·몬스터가 맵에 비해 커 보여 조금 뺀다 (config cameraZoom)
        _CameraService:ZoomTo(_GameData.cameraZoom, 0.01)
        log("[VRF] camera tuned offset=" .. tostring(cam.ScreenOffset) .. " damping=" .. tostring(cam.Damping))
    end

    @ExecSpace("ClientOnly")
    method void CompactMenuRow()
        -- 하단 메뉴 줄이 캐릭터 바로 아래 전투 공간(적·출구)을 가렸다. 85%로 줄이고(메뉴 이름은 읽히게) 아래 단축칸 쪽에 붙인다.
        local row = _UIKit:Get("Bottom/Menu")
        if not isvalid(row) then return end
        local t = row.UITransformComponent
        local scale = 0.85
        local bottomGap = t.anchoredPosition.y - t.RectSize.y   -- 원래 아래 끝과 단축칸 사이 간격 (위쪽 기준 피벗)
        t.UIScale = Vector3(scale, scale, 1)
        t.anchoredPosition = Vector2(t.anchoredPosition.x, bottomGap + t.RectSize.y * scale)
    end

    @ExecSpace("ClientOnly")
    method void UseBelt(integer index)
        -- 벨트 칸 클릭: 빈 칸이면 넣을 물건 고르기, 아니면 사용. 다른 창 조작 중에는 쓰지 않는다
        if self.BeltRightClick then self.BeltRightClick = false return end
        if not _UIKit:CanUseGameplayInput() then return end
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if belt == nil then return end
        if belt:SlotKind(index) == "" then _SkillPicker:OpenBelt(index) return end
        belt:RequestUseSlot(index)
    end

    @ExecSpace("ClientOnly")
    method void BeltDown(integer index, integer touchId)
        -- PC 우클릭(-2)은 사용하지 않고 칸 지정 창을 연다
        log("[VRF] belt down slot=" .. tostring(index) .. " touch=" .. tostring(touchId))
        if touchId ~= -2 then return end
        self.BeltRightClick = true
        _SkillPicker:OpenBelt(index)
    end

    @ExecSpace("ClientOnly")
    method void Extract()
        -- 다른 창을 조작하는 동안 배경 HUD에서 전투 동작이 나가지 않게 한다.
        if not _UIKit:CanUseGameplayInput() then return end
        ---@type SoulExtractor
        local extractor = _UIKit:Comp("script.SoulExtractor")
        if extractor ~= nil then extractor:TryExtractNearby() end
    end

end
