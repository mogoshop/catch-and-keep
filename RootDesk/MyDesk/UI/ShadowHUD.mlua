-- 그림자 상태줄 + 보관함 창 (H) (클라이언트 전용). 모바일 패드는 MobilePad.
-- 보관함 창: 왼쪽 = 고른 그림자 상세(모습·능력치·고유 능력·소환 지정/강화/분해), 오른쪽 = 목록(필터 전체|일반|정예|보스, 정렬 레벨·추출·등급).
--   소환 지정: 소환 스킬(Z)이 부를 그림자와 순서를 정한다 (소환 한도만큼). 「여러 개 선택」: 목록에서 여러 마리를 골라 한꺼번에 분해만.
-- 보관함 값은 ShadowOwner(@Sync StorageDigest·Essence), 소환 수는 ShadowCommander에서 읽는다.
-- 버튼은 각 컴포넌트의 Server 요청으로 보낸다 (검증은 서버).
@Logic
script ShadowHUD extends Logic

    property string Root = "/ui/ShadowHUD"
    property string Win = "/ui/ShadowHUD/Window"
    property integer RowCount = 8   -- 한 쪽 목록 줄 수 (모바일 좁은 화면은 WindowFit이 5로 — 위 목록 / 아래 상세)
    property number InfoTextW = 490 -- 상세 능력치·고유 능력 글 폭 (모바일 좁은 화면은 WindowFit이 줄인다)
    property number PollInterval = 0.25

    property integer Page = 0
    property string RenderKey = ""
    property table RowIds = {}      -- 줄 번호 → 표시 중인 그림자 id
    property table RowDeployed = {} -- 줄 번호 → 소환 중 여부
    property table RowEntries = {}  -- 줄 번호 → 그 줄의 그림자 요약
    property string SelectedId = ""
    property any SelectedEntry = nil
    property integer Filter = 0     -- 0 전체 / 1 일반 / 2 정예 / 3 보스
    property string Sort = "level"  -- level / recent / grade
    property boolean Multi = false  -- 여러 개 선택(분해 전용) 모드
    property table Picked = {}      -- 여러 개 선택: id → true
    property integer TimerId = 0
    property string InfoKey = ""    -- 상세 스크롤 칸에 지금 쓴 글 (바뀌면 맨 위로)
    property any WheelHandler = nil -- 마우스 휠 → 상세 스크롤

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        self.WheelHandler = _InputService:ConnectEvent(MouseScrollEvent, function(ev) self:OnWheel(ev.ScrollDelta) end)
        -- 모바일 패드는 ActivePlatform=Mobile이어도 PC에서 화면 클릭을 가로채므로 PC에서는 끈다
        _UIKit:SetEnabled(self.Root .. "/MobilePad", Environment:IsMobilePlatform())
        -- 목록 줄을 누르면 왼쪽 상세에 띄운다. 소환·강화·분해는 상세의 버튼으로 (확인 창)
        for i = 1, self.RowCount do
            local index = i
            _UIKit:Connect(self.Win .. "/Row" .. tostring(i), function() self:SelectRow(index) end)
        end
        _UIKit:Connect(self.Win .. "/Detail/BtnDeploy", function() self:OnAction("deploy") end)
        _UIKit:Connect(self.Win .. "/Detail/BtnUpgrade", function() self:OnAction("upgrade") end)
        _UIKit:Connect(self.Win .. "/Detail/BtnSalvage", function() self:OnAction("salvage") end)
        local filters = { { "FAll", 0 }, { "FNormal", 1 }, { "FElite", 2 }, { "FBoss", 3 } }
        for _, f in ipairs(filters) do
            local grade = f[2]
            _UIKit:Connect(self.Win .. "/" .. f[1], function() self:SetFilter(grade) end)
        end
        _UIKit:Connect(self.Win .. "/BtnSort", function() self:NextSort() end)
        _UIKit:Connect(self.Win .. "/BtnMulti", function() self:ToggleMulti() end)
        _UIKit:Connect(self.Win .. "/BtnPickAll", function() self:PickAll() end)
        -- 보관함 창이 하단 메뉴 줄(GameHUD 5)보다 위에, 제목이 테두리 그림보다 위에 오게 (파일 값만으로는 메이커가 다시 읽지 않았다)
        local group = _EntityService:GetEntityByPath(self.Root)
        if isvalid(group) then group.UIGroupComponent.GroupOrder = 6 end
        local title = _UIKit:Get(self.Win .. "/Title")
        if isvalid(title) then _UILogic:SetSiblingIndex(title.UITransformComponent, 1000) end
        _UIKit:Connect(self.Win .. "/BtnClose", function() self:ToggleWindow() end)
        _UIKit:Connect(self.Win .. "/BtnPrev", function() self:ChangePage(-1) end)
        _UIKit:Connect(self.Win .. "/BtnNext", function() self:ChangePage(1) end)
        _UIKit:Connect(self.Root .. "/Status/BtnStorage", function() self:ToggleWindow() end)
        _UIKit:Connect(self.Root .. "/Status/BtnInput", function() self:ToggleInputMode() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        if self.WheelHandler ~= nil then _InputService:DisconnectEvent(MouseScrollEvent, self.WheelHandler) self.WheelHandler = nil end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- H: 보관함 열기/닫기
        if event.key == KeyboardKey.H then self:ToggleWindow() end
    end

    method ShadowOwner Owner()
        ---@type ShadowOwner
        local c = _UIKit:Comp("script.ShadowOwner")
        return c
    end

    method ShadowCommander Commander()
        ---@type ShadowCommander
        local c = _UIKit:Comp("script.ShadowCommander")
        return c
    end

    -- ───────── 조작 ─────────

    @ExecSpace("ClientOnly")
    method void ToggleInputMode()
        -- PC 조작 전환: 마우스(클릭 이동·공격) ↔ 키보드(방향키·Ctrl)
        ---@type ClickControl
        local cc = _UIKit:Comp("script.ClickControl")
        if cc == nil then return end
        cc:SetMouseMode(not cc.MouseMode)
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save ~= nil then save:RequestInputMode(cc.MouseMode and 1 or 2) end   -- 고른 방식은 계정에 남는다
        self:RefreshInputLabel()
    end

    @ExecSpace("ClientOnly")
    method void RefreshInputLabel()
        ---@type ClickControl
        local cc = _UIKit:Comp("script.ClickControl")
        if cc == nil then return end
        local label = "조작: 키보드"
        if cc.MouseMode then label = "조작: 마우스" end
        _UIKit:SetText(self.Root .. "/Status/BtnInput", label)
    end

    @ExecSpace("ClientOnly")
    method void ToggleWindow()
        _UIKit:Toggle(self.Win)
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void ToggleMulti()
        -- 여러 개 선택(분해 전용) 켜고 끄기. 끄면 고른 것을 비운다
        self.Multi = not self.Multi
        self.Picked = {}
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void PickAll()
        -- 지금 필터 목록에서 분해할 수 있는 그림자(소환 중·보스 제외)를 전부 고른다. 이미 다 골랐으면 모두 뺀다
        local owner = self:Owner()
        if owner == nil then return end
        if not self.Multi then
            self.Multi = true
            self.Picked = {}
        end
        local eligible = {}
        local allPicked = true
        for _, e in ipairs(self:Entries(owner)) do
            if not e.deployed and self:SalvageYield(e) > 0 then
                table.insert(eligible, e.id)
                if not self.Picked[e.id] then allPicked = false end
            end
        end
        for _, id in ipairs(eligible) do self.Picked[id] = not allPicked end
        self.RenderKey = ""
        self:Poll()
    end

    method integer PickedCount()
        local n = 0
        for _, v in pairs(self.Picked) do if v then n = n + 1 end end
        return n
    end

    @ExecSpace("ClientOnly")
    method void ChangePage(integer delta)
        self.Page = math.max(0, self.Page + delta)
        self.RenderKey = ""
        self:Poll()
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 상태줄은 매번, 창은 내용이 바뀌었을 때만 다시 그린다
        local owner = self:Owner()
        local cmd = self:Commander()
        if owner == nil or cmd == nil then return end
        if self.RenderKey == "" then self:RefreshInputLabel() end
        local assignedCount = #owner:AssignedList()
        local status = string.format("그림자 %d   소환 %d/%d", owner.StorageCount, cmd.DeployedCount, cmd:GetDeployLimit()) .. (assignedCount > 0 and ("   지정 " .. tostring(assignedCount)) or "")
        if cmd.UndeadSummary ~= "" then status = status .. "\n" .. cmd.UndeadSummary end
        _UIKit:SetText(self.Root .. "/Status/Text", status)
        if not _UIKit:IsOpen(self.Win) then return end
        -- 재소환 대기 중인 그림자가 있으면 남은 초가 바뀔 때마다 다시 그린다
        local tick = ""
        if string.find(owner.StorageDigest, "|0|%d") then tick = tostring(math.floor(_UtilLogic.ServerElapsedSeconds)) end
        local key = owner.StorageDigest .. "#" .. tostring(owner.Essence) .. "#" .. tostring(self.Page) .. "#" .. tick .. "#" .. owner.Assigned .. "#" .. tostring(cmd:GetDeployLimit())
        if key == self.RenderKey then return end
        self.RenderKey = key
        self:RenderRows(owner)
    end

    @ExecSpace("ClientOnly")
    method void SelectRow(integer index)
        local e = self.RowEntries[index]
        if e == nil then return end
        if self.Multi then
            -- 여러 개 선택: 누를 때마다 넣고 빼기 (소환 중·보스는 분해할 수 없어 고를 수 없다)
            if e.deployed or self:SalvageYield(e) <= 0 then
                _ConfirmDialog:Show("고를 수 없음", self:ShadowName(e.src) .. " Lv" .. tostring(e.level) .. "\n" .. (e.deployed and "소환 중인 그림자는 먼저 회수(X)하세요." or "보스 그림자는 분해할 수 없습니다."), "닫기", nil)
                return
            end
            self.Picked[e.id] = not self.Picked[e.id]
            self.RenderKey = ""
            self:Poll()
            return
        end
        self.SelectedId = e.id
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void SetFilter(integer grade)
        self.Filter = grade
        self.Page = 0
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void NextSort()
        -- 레벨순 → 추출순(최근) → 등급순
        if self.Sort == "level" then self.Sort = "recent" elseif self.Sort == "recent" then self.Sort = "grade" else self.Sort = "level" end
        self.Page = 0
        self.RenderKey = ""
        self:Poll()
    end

    method table Entries(ShadowOwner owner)
        -- 요약 문자열(id|src|grade|level|deployed|readyAt|variant|at;...)을 풀어 필터·정렬한다
        local now = _UtilLogic.ServerElapsedSeconds
        local order = {}
        for i, id in ipairs(owner:AssignedList()) do order[id] = i end
        local list = {}
        for row in string.gmatch(owner.StorageDigest, "[^;]+") do
            local id, src, grade, level, deployed, readyAt, variant, at, plus, xp, deaths = string.match(row, "^(.-)|(.-)|(%d+)|(%d+)|(%d)|([%d%.]+)|(.-)|(%d+)|(%d+)|(%d+)|(%d+)$")
            if id ~= nil then
                local g = tonumber(grade)
                local tier = math.min(3, g)
                if self.Filter == 0 or self.Filter == tier then
                    local serial = tonumber(string.match(id, "_(%d+)$")) or 0
                    table.insert(list, { id = id, src = src, grade = g, level = tonumber(level), plus = tonumber(plus) or 0, xp = tonumber(xp) or 0, deployed = deployed == "1", wait = math.max(0, math.ceil(tonumber(readyAt) - now)), variant = variant, at = tonumber(at) or 0, serial = serial, assign = order[id] or 0,
                        deaths = tonumber(deaths) or 0, limit = _ShadowConfig:GetDeathLimit(g) })
                end
            end
        end
        local sort = self.Sort
        table.sort(list, function(a, b)
            if sort == "recent" then
                if a.at ~= b.at then return a.at > b.at end
                return a.serial > b.serial
            elseif sort == "grade" then
                if a.grade ~= b.grade then return a.grade > b.grade end
                if a.level ~= b.level then return a.level > b.level end
            else
                if a.level ~= b.level then return a.level > b.level end
                if a.grade ~= b.grade then return a.grade > b.grade end
            end
            return a.id < b.id
        end)
        return list
    end

    @ExecSpace("ClientOnly")
    method void RenderRows(ShadowOwner owner)
        -- 목록(현재 필터·정렬·페이지) + 왼쪽 상세
        local entries = self:Entries(owner)
        local pages = math.max(1, math.ceil(#entries / self.RowCount))
        if self.Page >= pages then self.Page = pages - 1 end
        _UIKit:SetText(self.Win .. "/PageText", string.format("%d / %d  ·  %d마리", self.Page + 1, pages, #entries))
        local sortNames = { level = "레벨순", recent = "추출순", grade = "등급순" }
        _UIKit:SetText(self.Win .. "/BtnSort", "정렬: " .. sortNames[self.Sort])
        _UIKit:SetText(self.Win .. "/BtnMulti", self.Multi and "선택 끝내기" or "여러 개 선택")
        _UIKit:SetText(self.Win .. "/BtnPickAll", (self.Multi and self:PickedCount() > 0) and "전체 해제" or "전체 선택")
        _UIKit:SetColor(self.Win .. "/BtnMulti", self.Multi and Color(0.6, 1, 0.65, 1) or Color(1, 1, 1, 1))
        -- 사라진(분해된) 그림자는 고른 목록에서 뺀다
        local alive = {}
        for _, e in ipairs(self:Entries(owner)) do alive[e.id] = true end
        for id, _ in pairs(self.Picked) do if not alive[id] then self.Picked[id] = nil end end
        local filterPaths = { "FAll", "FNormal", "FElite", "FBoss" }
        for i, name in ipairs(filterPaths) do
            _UIKit:SetColor(self.Win .. "/" .. name, (i - 1) == self.Filter and Color(1, 0.86, 0.55, 1) or Color(0.55, 0.52, 0.5, 1))
        end
        -- 고른 그림자가 목록에 없으면(필터·분해) 첫 줄을 고른다
        local selected = nil
        for _, e in ipairs(entries) do if e.id == self.SelectedId then selected = e end end
        if selected == nil and #entries > 0 then
            selected = entries[self.Page * self.RowCount + 1] or entries[1]
            self.SelectedId = selected.id
        end
        self.SelectedEntry = selected
        for i = 1, self.RowCount do
            local base = self.Win .. "/Row" .. tostring(i)
            local e = entries[self.Page * self.RowCount + i]
            self.RowIds[i] = e ~= nil and e.id or ""
            self.RowDeployed[i] = e ~= nil and e.deployed or false
            self.RowEntries[i] = e
            _UIKit:SetEnabled(base, e ~= nil)
            if e ~= nil then
                _UIKit:SetText(base .. "/Label", self:RowLabel(e))
                _UIKit:SetEnabled(base .. "/Assign", e.assign > 0)
                if e.assign > 0 then _UIKit:SetText(base .. "/Assign/Num", tostring(e.assign)) end
                local state = ""
                if e.deployed then state = _UIKit:Colored("#9EE6A0", "소환 중")
                elseif e.limit > 0 and e.deaths >= e.limit then state = _UIKit:Colored("#FF9A8A", "지침")
                elseif e.wait > 0 then state = "회복 " .. tostring(e.wait) .. "초" end
                if self.Multi and self.Picked[e.id] then state = _UIKit:Colored("#9EE6A0", "분해 선택") end
                _UIKit:SetText(base .. "/State", state)
                local m = _GameData:GetMonsterStats(e.src)
                _UIKit:SetMonsterPortrait(base .. "/Portrait", e.src, 60)
                local rowColor = Color(0.13, 0.12, 0.16, 1)
                if self.Multi then
                    if self.Picked[e.id] then rowColor = Color(0.16, 0.36, 0.2, 1) end
                elseif e.id == self.SelectedId then rowColor = Color(0.42, 0.32, 0.14, 1) end
                _UIKit:SetColor(base, rowColor)
            end
        end
        self:RenderDetail(owner, selected)
    end

    @ExecSpace("ClientOnly")
    method string ArchLine(string src, string role)
        -- 상세의 「유형」 줄: 원본 몬스터 유형과 그림자 특기 (archetypes.csv shadow 칸)
        local id = _GameData:ArchetypeOf(src)
        if id == "" or id == "boss" then return "싸움 방식: " .. role end
        local a = _GameData:GetArchetype(id)
        local perk = (a.shadow ~= "" and a.shadow ~= "—") and ("  ·  " .. _UIKit:Colored("#C9A2FF", "특기 " .. a.shadow)) or ""
        return "유형: " .. a.name .. " (" .. role .. ")" .. perk
    end

    @ExecSpace("ClientOnly")
    method void RenderDetail(ShadowOwner owner, any e)
        -- 왼쪽 상세: 모습(원본 몬스터, 그림자 보라빛) · 등급·속성 · 능력치 · 고유 능력(변종 기술·오오라)
        local d = self.Win .. "/Detail"
        if self.Multi then
            self:RenderMulti(owner)
            return
        end

        local has = e ~= nil
        _UIKit:SetEnabled(d .. "/Empty", not has)
        for _, n in ipairs({ "Stage", "Name", "Grade", "Info", "BtnDeploy", "BtnUpgrade", "BtnSalvage", "BtnDeployNote", "BtnUpgradeNote", "BtnSalvageNote" }) do _UIKit:SetEnabled(d .. "/" .. n, has) end
        self:SetEssence(owner.Essence)
        if not has then return end
        local m = _GameData:GetMonsterStats(e.src)
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        _UIKit:SetMonsterPortrait(d .. "/Stage/Portrait", e.src, 200)
        _UIKit:SetColor(d .. "/Stage/Portrait", Color(0.82, 0.72, 1, 1))
        _UIKit:SetText(d .. "/Name", self:ShadowName(e.src) .. "  " .. self:LevelLabel(e) .. (e.plus > 0 and ("  " .. _UIKit:Colored("#FFD27A", self:PlusLabel(e))) or ""))
        local gradeName = "일반"
        if e.grade == 2 then gradeName = "정예" elseif e.grade >= 3 then gradeName = "보스" end
        local p = _ShadowConfig:GetProfile(e.src, e.grade, self:PowerLevel(e), 1)
        local full = _ShadowConfig:GetProfile(e.src, e.grade, self:PowerLevel(e), _ShadowConfig:GetPlusMult(self:EffPlus(e), e.grade))
        local element = p.element ~= "" and (" · " .. _ShadowConfig:ElementName(p.element) .. " 속성") or ""
        local state = e.deployed and " · 소환 중" or (e.wait > 0 and (" · 회복 " .. tostring(e.wait) .. "초") or "")
        if e.limit > 0 then
            -- 정예·보스 사망 한도 (10-20): 다 쓰러지면 마을에 들를 때까지 지침
            if e.deaths >= e.limit then state = state .. _UIKit:Colored("#FF9A8A", " · 지침 (마을에서 회복)")
            else state = state .. _UIKit:Colored("#C9B17E", string.format(" · 쓰러짐 %d/%d", e.deaths, e.limit)) end
        end
        _UIKit:SetText(d .. "/Grade", "[" .. gradeName .. "]" .. element .. state)
        local resist = {}
        for k, v in pairs(p.resists or {}) do if v ~= 0 then table.insert(resist, _ShadowConfig:ElementName(k) .. " " .. tostring(v)) end end
        local roles = { ranged = "원거리 사격", burrow = "땅속 기습", hitrun = "치고 빠지기", coward = "겁쟁이(무리와 함께)" }
        local lines = {
            "공격 " .. tostring(full.atk) .. self:PlusText(full.atk - p.atk) .. "   ·   생명 " .. tostring(full.hp) .. self:PlusText(full.hp - p.hp),
            (st ~= nil and e.level > st.Level) and _UIKit:Colored("#C9A2FF", string.format("본래 Lv%d — 지금은 내 레벨(Lv%d)만큼 힘을 낸다. 내가 크면 본래 레벨까지 함께 강해진다", e.level, st.Level))
                or (st ~= nil and e.level >= st.Level) and _UIKit:Colored("#8C99B4", "레벨 최대 (내 레벨까지) — 내가 레벨업하면 다시 자란다")
                or _UIKit:Colored("#9EE6A0", string.format("경험치 %d%% — 소환해 데리고 다니며 처치하면 오른다", e.xp)),
            string.format("공격 간격 %.1f초  ·  사거리 %.1f  ·  이동 %.1f", p.cooldown, p.range, p.speed),
            "저항: " .. (#resist > 0 and table.concat(resist, " · ") or "없음"),
            self:ArchLine(e.src, roles[p.behavior] or "근접 돌격"),
            _UIKit:Colored("#8C99B4", "(장비·스킬 보너스 전 · 노란 +는 강화로 오른 몫)"),
        }
        self:FitInfo(table.concat(lines, "\n"), self:TraitText(e))
        _UIKit:SetText(d .. "/BtnDeploy", e.assign > 0 and "지정 해제" or "소환 지정")
        local cap = _ShadowConfig:GetPlusCap(self:OwnerLevel())
        _UIKit:SetText(d .. "/BtnUpgrade", e.plus >= _ShadowConfig:GetPlusMax() and "강화 최대" or (e.plus >= cap and "레벨 제한" or "강화"))
        -- 소환 중이면 분해 대신 회수 (보관함으로 돌려보내 다른 그림자를 부를 수 있게)
        _UIKit:SetText(d .. "/BtnSalvage", e.deployed and "회수" or "분해")
        -- 보유 정수는 버튼 위 오른쪽, 각 버튼 아래에 그 버튼이 하는 일의 값 (지정 순번 · 강화 비용 · 분해로 얻는 정수)
        local yield = self:SalvageYield(e)
        local cost = _ShadowConfig:GetUpgradeCost(e.plus, e.grade)
        local cmd = self:Commander()
        local limit = cmd ~= nil and cmd:GetDeployLimit() or 1
        self:SetEssence(owner.Essence)
        _UIKit:SetText(d .. "/BtnDeployNote", e.assign > 0 and ("소환 순서 " .. tostring(e.assign) .. "번째") or string.format("지정 %d / %d", #owner:AssignedList(), limit))
        local upNote = string.format("+%d→+%d · 정수 %d", e.plus, e.plus + 1, cost)
        local runeTier = _ShadowConfig:UpgradeRuneTier(e.plus, e.grade)
        if runeTier > 0 then upNote = string.format("+%d→+%d · %s룬 · %d%%", e.plus, e.plus + 1, _ShadowConfig:TierName(runeTier), math.floor(_ShadowConfig:UpgradeChance(e.plus) * 100 + 0.5)) end
        if e.plus >= _ShadowConfig:GetPlusMax() then upNote = "최대 강화"
        elseif e.plus >= cap then upNote = string.format("Lv%d에 +%d", _ShadowConfig:NextCapLevel(e.plus + 1), e.plus + 1) end
        _UIKit:SetText(d .. "/BtnUpgradeNote", upNote)
        local salvage = "정수 +" .. tostring(yield)
        if e.deployed then salvage = "보관함으로" elseif yield <= 0 then salvage = "보스는 불가" end
        _UIKit:SetText(d .. "/BtnSalvageNote", salvage)
    end

    @ExecSpace("ClientOnly")
    method void RenderMulti(ShadowOwner owner)
        -- 여러 개 선택: 왼쪽은 고른 그림자 요약 + 분해 버튼만
        local d = self.Win .. "/Detail"
        local picked = {}
        local total = 0
        for _, e in ipairs(self:Entries(owner)) do
            if self.Picked[e.id] then
                table.insert(picked, e)
                total = total + self:SalvageYield(e)
            end
        end
        _UIKit:SetEnabled(d .. "/Empty", false)
        for _, n in ipairs({ "Name", "Grade", "Info", "BtnSalvage" }) do _UIKit:SetEnabled(d .. "/" .. n, true) end
        _UIKit:SetEnabled(d .. "/Stage", false)
        _UIKit:SetEnabled(d .. "/BtnDeploy", false)
        _UIKit:SetEnabled(d .. "/BtnUpgrade", false)
        _UIKit:SetEnabled(d .. "/BtnDeployNote", false)
        _UIKit:SetEnabled(d .. "/BtnUpgradeNote", false)
        _UIKit:SetEnabled(d .. "/BtnSalvageNote", true)
        _UIKit:SetText(d .. "/BtnSalvageNote", "정수 +" .. tostring(total))
        _UIKit:SetText(d .. "/Name", "여러 개 선택 · " .. tostring(#picked) .. "마리")
        _UIKit:SetText(d .. "/Grade", "목록을 눌러 분해할 그림자를 고르세요 (다시 누르면 빠짐)")
        local lines = {}
        for i, e in ipairs(picked) do
            if i > 6 then
                -- 6마리 + 「외 N마리」 한 줄 (7마리를 다 쓰면 아래 안내문과 겹쳤다)
                table.insert(lines, _UIKit:Colored("#8C99B4", "… 외 " .. tostring(#picked - 6) .. "마리"))
                break
            end
            table.insert(lines, self:ShadowName(e.src) .. "  Lv" .. tostring(e.level) .. (e.plus > 0 and ("  +" .. tostring(e.plus)) or "") .. (e.assign > 0 and _UIKit:Colored("#FFD27A", "  (소환 지정됨)") or ""))
        end
        if #lines == 0 then lines = { _UIKit:Colored("#8C99B4", "아직 고른 그림자가 없다") } end
        self:FitInfo(table.concat(lines, "\n"), _UIKit:Colored("#8C99B4", "소환 중인 그림자와 보스 그림자는 고를 수 없다 · 소환 지정·강화는 「선택 끝내기」 후"))
        _UIKit:SetText(d .. "/BtnSalvage", "선택 분해")
        self:SetEssence(owner.Essence)
    end

    @ExecSpace("ClientOnly")
    method void FitInfo(string stats, string trait)
        -- 능력치·고유 능력은 스크롤 칸(Detail/Info) 안 묶음(Body)에 글 길이만큼 세운다. 넘치면 손가락·휠로 내린다 (10-13: 고유 기술 두 줄이 정수 줄과 겹쳤다)
        --   스크롤 칸이 글을 직접 세우면 줄바꿈 전 한 줄 너비로 재므로, 칸에는 크기를 정한 묶음 하나만 둔다
        local body = self.Win .. "/Detail/Info/Body"
        local width = self.InfoTextW
        local y = 0
        for _, pair in ipairs({ { "/Stats", stats }, { "/Trait", trait } }) do
            local e = _UIKit:Get(body .. pair[1])
            if isvalid(e) then
                local t = e.TextGUIRendererComponent
                t.Text = pair[2]
                local height = math.max(30, t:GetPreferredHeight(pair[2], width) + 6)
                e.UITransformComponent.RectSize = Vector2(width, height)
                e.UITransformComponent.anchoredPosition = Vector2(0, -y)
                y = y + height + 10
            end
        end
        local holder = _UIKit:Get(body)
        if isvalid(holder) then holder.UITransformComponent.RectSize = Vector2(width, y) end
        -- 다른 그림자를 고르면 맨 위부터 (같은 글을 다시 그릴 때는 읽던 자리를 둔다). 높이가 바뀌면 스크롤 칸이 다시 재게 한다 (UIKit.RelayoutScroll)
        local key = stats .. "\n" .. trait
        if key ~= self.InfoKey then
            self.InfoKey = key
            local box = _UIKit:Get(self.Win .. "/Detail/Info")
            if isvalid(box) and isvalid(holder) then _UIKit:RelayoutScroll(box, holder) end
        end
    end

    @ExecSpace("ClientOnly")
    method void OnWheel(number delta)
        -- 마우스 휠: 커서가 상세 스크롤 칸 위면 내린다 (엔진 스크롤은 글만 든 칸에서 휠을 받지 않았다 — 소지품 창과 같은 처리). 한 칸 = 약 3줄
        if delta == 0 or not _UIKit:IsOpen(self.Win) then return end
        local info = self.Win .. "/Detail/Info"
        if not self:CursorOver(info) then return end
        local box = _UIKit:Get(info)
        local holder = _UIKit:Get(info .. "/Body")
        if not isvalid(box) or not isvalid(holder) or box.ScrollLayoutGroupComponent == nil then return end
        local overflow = holder.UITransformComponent.RectSize.y + 8 - box.UITransformComponent.RectSize.y
        if overflow <= 0 then return end
        local sl = box.ScrollLayoutGroupComponent
        local now = sl:GetScrollNormalizedPosition(UITransformAxis.Vertical)
        sl:SetScrollNormalizedPosition(UITransformAxis.Vertical, math.max(0, math.min(1, now - delta * 90 / overflow)))
    end

    @ExecSpace("ClientOnly")
    method boolean CursorOver(string path)
        -- 커서가 그 UI 사각형 안인지 (InventoryWindow.CursorOver와 같은 판정)
        local e = _UIKit:Get(path)
        if not isvalid(e) then return false end
        local corners = e.UITransformComponent:GetWorldCorners()
        if corners == nil or #corners < 4 then return false end
        local cur = _InputService:GetCursorPosition()
        local minX, maxX = math.min(corners[1].x, corners[3].x), math.max(corners[1].x, corners[3].x)
        local minY, maxY = math.min(corners[1].y, corners[3].y), math.max(corners[1].y, corners[3].y)
        return cur.x >= minX and cur.x <= maxX and cur.y >= minY and cur.y <= maxY
    end

    @ExecSpace("ClientOnly")
    method void SetEssence(integer essence)
        -- [아이콘] 정수 N 보유 — 글자 길이에 맞춰 묶음 폭을 줄여 오른쪽 끝(버튼 끝)에 붙인다
        local text = "정수 " .. tostring(essence) .. " 보유"
        _UIKit:SetText(self.Win .. "/Detail/Essence/Text", text)
        local chars = utf8.len(text) or #text
        local wide = (#text - chars) // 2            -- 한글(3바이트) 글자 수
        local width = 44 + wide * 22 + (chars - wide) * 12 + 6
        local box = _UIKit:Get(self.Win .. "/Detail/Essence")
        if isvalid(box) then box.UITransformComponent.RectSize = Vector2(width, 40) end
    end

    method string PlusText(number diff)
        if diff <= 0 then return "" end
        return " " .. _UIKit:Colored("#FFD27A", "(+" .. tostring(math.floor(diff)) .. ")")
    end

    method integer OwnerLevel()
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        return st ~= nil and st.Level or 0
    end

    method integer EffPlus(table e)
        -- 지금 힘에 들어가는 강화 (주인 레벨 상한까지)
        return _ShadowConfig:EffectivePlus(e.plus, self:OwnerLevel())
    end

    method string PlusLabel(table e)
        -- 「+4」 또는 상한을 넘으면 「+9 (적용 +4)」
        if e.plus <= 0 then return "" end
        local eff = self:EffPlus(e)
        if eff < e.plus then return "+" .. tostring(e.plus) .. " (적용 +" .. tostring(eff) .. ")" end
        return "+" .. tostring(e.plus)
    end

    method integer PowerLevel(table e)
        -- 지금 내는 힘의 레벨: 본래 레벨과 내 레벨 중 낮은 쪽
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        return _ShadowConfig:EffectiveLevel(e.level, st ~= nil and st.Level or 0)
    end

    method string LevelLabel(table e)
        -- 「Lv31」 또는 내 레벨보다 높으면 「Lv31(힘 Lv10)」
        local power = self:PowerLevel(e)
        if power < e.level then return "Lv" .. tostring(e.level) .. _UIKit:Colored("#C9A2FF", "(힘 Lv" .. tostring(power) .. ")") end
        return "Lv" .. tostring(e.level)
    end

    method integer SalvageYield(table e)
        if _ShadowConfig:GetDisassembleYield(e.grade, e.level or 1) <= 0 then return 0 end
        return _ShadowConfig:GetDisassembleYield(e.grade, e.level or 1) + _ShadowConfig:GetPlusRefund(e.plus)
    end

    method string ShadowName(string src)
        -- 몬스터 표에 없는 원본(예전 시험 데이터 "mob-…")은 내부 id 대신 이름 없는 그림자로
        if _GameData:GetMonsterStats(src) == nil then return "이름 없는 그림자" end
        return _GameData:GetMonsterName(src)
    end

    method string TraitText(table e)
        -- 고유 능력: 변종 우두머리의 오오라·범위 기술, 정예·보스의 등급 보정
        local lines = {}
        for _, v in ipairs(_GameData:ParseVariant(e.variant)) do
            if v.kind == "aura" then
                -- 등급(옅은·짙은·극한)과 수치 (10-24 C안: 같은 오오라도 10~25%)
                local tierColor = v.tier >= 3 and "#FFB04A" or (v.tier == 2 and "#9FD0FF" or "#C9BFA8")
                local whom = v.effect == "corrode" and "" or "주변 아군 "
                table.insert(lines, "고유 오오라 「" .. _UIKit:Colored(tierColor, v.label) .. "」: " .. whom .. v.text .. " (반경 " .. tostring(v.radius) .. ")")
            elseif v.kind == "cloud" then
                table.insert(lines, "고유 기술 「" .. v.name .. "」: " .. tostring(v.interval) .. "초마다 주위 적에게 독 (4초 동안 공격력 ×" .. tostring(v.mult) .. ", 반경 " .. tostring(v.radius) .. ")")
            else
                local elem = v.element ~= "" and (_ShadowConfig:ElementName(v.element) .. " ") or ""
                table.insert(lines, "고유 기술 「" .. v.name .. "」: " .. tostring(v.interval) .. "초마다 주위 " .. elem .. "범위 공격 (공격력 ×" .. tostring(v.mult) .. ", 반경 " .. tostring(v.radius) .. ")")
            end
        end
        if e.grade == 2 then table.insert(lines, "정예: 일반보다 기본 공격·생명이 높고 분해하면 정수를 더 준다")
        elseif e.grade >= 3 then table.insert(lines, "보스: 가장 높은 기본 능력치 · 분해할 수 없음") end
        if #lines == 0 then return _UIKit:Colored("#8C99B4", "특수 능력 없음 (정예·변종 우두머리에게서 추출하면 고유 능력이 붙는다)") end
        return table.concat(lines, "\n")
    end

    method string RowLabel(table e)
        -- 목록 한 줄: 「이름 · Lv32」 (+강화). 10-29 글귀 확정 79 — 지정 번호는 칸 왼쪽 배지(Row/Assign), 등급·속성·힘 레벨은 상세 칸에서,
        -- 소환 중·지침·회복 초는 오른쪽 상태 칸(Row/State)에 이미 있다
        local plus = e.plus > 0 and (" " .. _UIKit:Colored("#FFD27A", "(+" .. tostring(e.plus) .. ")")) or ""
        return self:ShadowName(e.src) .. " · Lv" .. tostring(e.level) .. plus
    end

    @ExecSpace("ClientOnly")
    method void OnRowAction(integer index, string action)
        -- (예전 줄 버튼 호환) 그 줄을 고른 뒤 같은 동작
        local e = self.RowEntries[index]
        if e == nil then return end
        self.SelectedId = e.id
        self.SelectedEntry = e
        self:OnAction(action)
    end

    @ExecSpace("ClientOnly")
    method void OnAction(string action)
        -- 상세 버튼 → 확인 창(무엇이 어떻게 바뀌는지) → 확인하면 서버 요청
        if self.Multi then
            if action == "salvage" then self:SalvagePicked() end
            return
        end
        local e = self.SelectedEntry
        if e == nil then return end
        local id = e.id
        local owner = self:Owner()
        local cmd = self:Commander()
        if owner == nil or cmd == nil then return end
        local name = self:ShadowName(e.src) .. " " .. self:LevelLabel(e)
        local now = _ShadowConfig:GetProfile(e.src, e.grade, self:PowerLevel(e), 1)
        if action == "deploy" then
            -- 소환 지정: 소환 스킬(Z)이 지정 순서대로 부른다. 한도가 차 있으면 해제부터 하라고 알린다
            local limit = cmd:GetDeployLimit()
            if e.assign == 0 and #owner:AssignedList() >= limit then
                _ConfirmDialog:Show("소환 지정", name .. "\n소환 지정은 최대 " .. tostring(limit) .. "마리입니다 (지금 소환 한도).\n지정된 그림자 하나를 먼저 「지정 해제」하세요.", "닫기", nil)
                return
            end
            owner:RequestToggleAssign(id)
            return
        end
        local essence = _GameData:GetUiIcon("essence")
        if action == "upgrade" then
            local cost = _ShadowConfig:GetUpgradeCost(e.plus, e.grade)
            local cap = _ShadowConfig:GetPlusCap(self:OwnerLevel())
            local nextP = _ShadowConfig:GetProfile(e.src, e.grade, self:PowerLevel(e), _ShadowConfig:GetPlusMult(e.plus + 1, e.grade))
            local curP = _ShadowConfig:GetProfile(e.src, e.grade, self:PowerLevel(e), _ShadowConfig:GetPlusMult(e.plus, e.grade))
            local body = name .. "  +" .. tostring(e.plus) .. " → +" .. tostring(e.plus + 1) .. "  (레벨은 그대로)\n공격 " .. tostring(curP.atk) .. " → " .. tostring(nextP.atk) .. " · 생명 " .. tostring(curP.hp) .. " → " .. tostring(nextP.hp)
                .. "\n정수 " .. tostring(cost) .. " 사용 (보유 " .. tostring(owner.Essence) .. ")  ·  강화 1당 공격·생명 +" .. tostring(_ShadowConfig:GetPlusPct(e.grade)) .. "% · 지금 레벨 상한 +" .. tostring(cap)
            -- +6부터 룬 1개 + 성공 확률 (10-20): 가방에서 쓸 룬을 미리 보여 준다 (등급 하한 이상 중 가장 흔한 것)
            local runeTier = _ShadowConfig:UpgradeRuneTier(e.plus, e.grade)
            local runeMissing = false
            if runeTier > 0 then
                ---@type PlayerInventory
                local inv = _UIKit:Comp("script.PlayerInventory")
                local bag = inv ~= nil and inv:GetBagList() or {}
                local index = _ShadowConfig:FindUpgradeRune(bag, runeTier)
                local pct = math.floor(_ShadowConfig:UpgradeChance(e.plus) * 100 + 0.5)
                if index > 0 then
                    local rune = _ItemData:GetRune(_ItemData:Parse(bag[index]).base)
                    body = body .. "\n" .. _UIKit:Colored("#C9A2FF", string.format("룬 「%s」 1개 사용 · 성공 %d%% — 실패하면 정수·룬만 사라지고 +%d 그대로", rune ~= nil and rune.name or "룬", pct, e.plus))
                else
                    runeMissing = true
                    body = body .. "\n" .. _UIKit:Colored("#FF8888", string.format("%s 이상 룬 1개가 필요합니다 (성공 %d%%)", _ShadowConfig:TierName(runeTier), pct))
                    -- 잠긴 룬만 있으면 그 이유를 한 줄 더 (10-29 기획서 45 결정 6-A · 글귀 승인 전)
                    if _ShadowConfig:HasLockedUpgradeRune(bag, runeTier) then body = body .. "\n" .. _UIKit:Colored("#FFD27A", "★ 잠긴 룬은 강화에 쓰지 않습니다") end
                end
            end
            if e.plus >= _ShadowConfig:GetPlusMax() then
                _ConfirmDialog:ShowIcon("그림자 강화 불가", name .. "\n이미 최대 강화(+" .. tostring(e.plus) .. ")입니다.", "닫기", essence, nil)
            elseif e.plus >= cap then
                _ConfirmDialog:ShowIcon("그림자 강화 불가", name .. "\n강화는 주인 레벨 3마다 +1까지 할 수 있습니다 (지금 +" .. tostring(cap) .. ").\nLv" .. tostring(_ShadowConfig:NextCapLevel(e.plus + 1)) .. "이 되면 +" .. tostring(e.plus + 1) .. "로 강화할 수 있습니다.", "닫기", essence, nil)
            elseif owner.Essence < cost then
                _ConfirmDialog:ShowIcon("그림자 강화 불가", body .. "\n" .. _UIKit:Colored("#FF8888", "정수가 부족합니다 — 그림자를 분해하면 정수를 얻습니다."), "닫기", essence, nil)
            elseif runeMissing then
                _ConfirmDialog:ShowIcon("그림자 강화 불가", body, "닫기", essence, nil)
            else
                _ConfirmDialog:ShowIcon("그림자 강화", body, "강화", essence, function() owner:RequestUpgrade(id) end)
            end
            return
        end
        local yield = self:SalvageYield(e)
        if e.deployed then
            -- 소환 중인 그림자: 「회수」 — 보관함으로 돌려보낸다 (지정은 그대로, 다시 부르려면 소환)
            cmd:RequestRecall(id)
            return
        end
        if yield <= 0 then
            _ConfirmDialog:Show("그림자 분해 불가", name .. "\n" .. (e.deployed and "소환 중인 그림자는 먼저 회수하세요." or "보스 그림자는 분해할 수 없습니다."), "닫기", nil)
            return
        end
        local refund = e.plus > 0 and ("\n(강화에 쓴 정수의 절반 " .. tostring(_ShadowConfig:GetPlusRefund(e.plus)) .. " 포함)") or ""
        _ConfirmDialog:ShowIcon("그림자 분해", name .. "\n분해하면 이 그림자는 영원히 사라지고 정수 +" .. tostring(yield) .. "을 얻습니다." .. refund .. "\n(정수 " .. tostring(owner.Essence) .. " → " .. tostring(owner.Essence + yield) .. " · 가방에 귀속 재료로 들어갑니다)", "분해", essence, function() owner:RequestDisassemble(id) end)
    end

    @ExecSpace("ClientOnly")
    method void SalvagePicked()
        -- 고른 그림자 한꺼번에 분해 (확인 창 한 번)
        local owner = self:Owner()
        if owner == nil then return end
        local ids = {}
        local total = 0
        local assigned = 0
        for _, e in ipairs(self:Entries(owner)) do
            if self.Picked[e.id] and not e.deployed and self:SalvageYield(e) > 0 then
                table.insert(ids, e.id)
                total = total + self:SalvageYield(e)
                if e.assign > 0 then assigned = assigned + 1 end
            end
        end
        if #ids == 0 then
            _ConfirmDialog:Show("선택 분해", "목록에서 분해할 그림자를 먼저 고르세요.", "닫기", nil)
            return
        end
        local warn = assigned > 0 and ("\n" .. _UIKit:Colored("#FFD27A", "소환 지정된 그림자 " .. tostring(assigned) .. "마리 포함 — 지정에서도 빠집니다")) or ""
        _ConfirmDialog:ShowIcon("그림자 " .. tostring(#ids) .. "마리 분해", tostring(#ids) .. "마리가 영원히 사라지고 정수 +" .. tostring(total) .. "을 얻습니다." .. warn .. "\n(정수 " .. tostring(owner.Essence) .. " → " .. tostring(owner.Essence + total) .. ")", "분해", _GameData:GetUiIcon("essence"), function()
            owner:RequestDisassembleMany(table.concat(ids, ","))
            self.Picked = {}
            self.RenderKey = ""
        end)
    end

end
