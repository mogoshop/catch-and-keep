-- 그림자 상태줄 + 보관함 창 (H) + 모바일 패드 (클라이언트 전용).
-- 보관함 값은 ShadowOwner(@Sync StorageDigest·Essence), 소환 수는 ShadowCommander에서 읽는다.
-- 버튼은 각 컴포넌트의 Server 요청으로 보낸다 (검증은 서버).
@Logic
script ShadowHUD extends Logic

    property string Root = "/ui/ShadowHUD"
    property string Win = "/ui/ShadowHUD/Window"
    property integer RowCount = 8
    property number PollInterval = 0.25

    property integer Page = 0
    property string RenderKey = ""
    property table RowIds = {}      -- 줄 번호 → 표시 중인 그림자 id
    property table RowDeployed = {} -- 줄 번호 → 소환 중 여부
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        -- 모바일 패드는 ActivePlatform=Mobile이어도 PC에서 화면 클릭을 가로채므로 PC에서는 끈다
        _UIKit:SetEnabled(self.Root .. "/MobilePad", Environment:IsMobilePlatform())
        for i = 1, self.RowCount do
            local index = i
            local base = self.Win .. "/Row" .. tostring(i)
            _UIKit:Connect(base .. "/BtnDeploy", function() self:OnRowAction(index, "deploy") end)
            _UIKit:Connect(base .. "/BtnUpgrade", function() self:OnRowAction(index, "upgrade") end)
            _UIKit:Connect(base .. "/BtnSalvage", function() self:OnRowAction(index, "salvage") end)
        end
        _UIKit:Connect(self.Win .. "/BtnClose", function() self:ToggleWindow() end)
        _UIKit:Connect(self.Win .. "/BtnPrev", function() self:ChangePage(-1) end)
        _UIKit:Connect(self.Win .. "/BtnNext", function() self:ChangePage(1) end)
        _UIKit:Connect(self.Root .. "/Status/BtnStorage", function() self:ToggleWindow() end)
        _UIKit:Connect(self.Root .. "/Status/BtnInput", function() self:ToggleInputMode() end)
        _UIKit:Connect(self.Root .. "/MobilePad/BtnAttack", function() self:MobileAttack() end)
        _UIKit:Connect(self.Root .. "/MobilePad/BtnSummon", function() self:CommanderCall("deploy") end)
        _UIKit:Connect(self.Root .. "/MobilePad/BtnRecall", function() self:CommanderCall("recall") end)
        _UIKit:Connect(self.Root .. "/MobilePad/BtnRally", function() self:CommanderCall("rally") end)
        _UIKit:Connect(self.Root .. "/MobilePad/BtnStorage", function() self:ToggleWindow() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- H: 보관함 열기/닫기
        if event.key == KeyboardKey.H then self:ToggleWindow() end
    end

    method ShadowOwner Owner()
        ---@type ShadowOwner
        local c = _UIKit:Comp("script.ShadowOwner")
        return c
    end

    method ShadowCommander Commander()
        ---@type ShadowCommander
        local c = _UIKit:Comp("script.ShadowCommander")
        return c
    end

    -- ───────── 조작 ─────────

    @ExecSpace("ClientOnly")
    method void ToggleInputMode()
        -- PC 조작 전환: 마우스(클릭 이동·공격) ↔ 키보드(방향키·Ctrl)
        ---@type ClickControl
        local cc = _UIKit:Comp("script.ClickControl")
        if cc == nil then return end
        cc:SetMouseMode(not cc.MouseMode)
        self:RefreshInputLabel()
    end

    @ExecSpace("ClientOnly")
    method void RefreshInputLabel()
        ---@type ClickControl
        local cc = _UIKit:Comp("script.ClickControl")
        if cc == nil then return end
        local label = "조작: 키보드"
        if cc.MouseMode then label = "조작: 마우스" end
        _UIKit:SetText(self.Root .. "/Status/BtnInput", label)
    end

    @ExecSpace("ClientOnly")
    method void CommanderCall(string action)
        -- 모바일 버튼 → 단축키(Z X C)와 같은 서버 요청
        local cmd = self:Commander()
        if cmd == nil then return end
        if action == "deploy" then cmd:RequestDeploy("")
        elseif action == "recall" then cmd:RequestRecall("")
        elseif action == "rally" then cmd:RequestRally() end
    end

    @ExecSpace("ClientOnly")
    method void MobileAttack()
        -- 모바일 공격: 가까운 몬스터 쪽을 보고 공격 (조준 입력이 없으므로)
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local m = _Util:NearestMonster(player.CurrentMap, _Util:Pos2(player), 2.0)
        if m ~= nil then
            local dx = m.Entity.TransformComponent.WorldPosition.x - player.TransformComponent.WorldPosition.x
            if math.abs(dx) > 0.05 then
                local dir = -1
                if dx >= 0 then dir = 1 end
                player.PlayerControllerComponent.LookDirectionX = dir
            end
        end
        player.PlayerControllerComponent:ActionAttack()
    end

    @ExecSpace("ClientOnly")
    method void ToggleWindow()
        _UIKit:Toggle(self.Win)
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void ChangePage(integer delta)
        self.Page = math.max(0, self.Page + delta)
        self.RenderKey = ""
        self:Poll()
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 상태줄은 매번, 창은 내용이 바뀌었을 때만 다시 그린다
        local owner = self:Owner()
        local cmd = self:Commander()
        if owner == nil or cmd == nil then return end
        if self.RenderKey == "" then self:RefreshInputLabel() end
        _UIKit:SetText(self.Root .. "/Status/Text", string.format("그림자 %d   소환 %d/%d   정수 %d", owner.StorageCount, cmd.DeployedCount, cmd:GetDeployLimit(), owner.Essence))
        if not _UIKit:IsOpen(self.Win) then return end
        -- 재소환 대기 중인 그림자가 있으면 남은 초가 바뀔 때마다 다시 그린다
        local tick = ""
        if string.find(owner.StorageDigest, "|0|%d") then tick = tostring(math.floor(_UtilLogic.ServerElapsedSeconds)) end
        local key = owner.StorageDigest .. "#" .. tostring(owner.Essence) .. "#" .. tostring(self.Page) .. "#" .. tick
        if key == self.RenderKey then return end
        self.RenderKey = key
        self:RenderRows(owner)
    end

    @ExecSpace("ClientOnly")
    method void RenderRows(ShadowOwner owner)
        -- 요약 문자열(id|sourceId|grade|level|deployed|readyAt;...)을 풀어 현재 페이지를 그린다
        local now = _UtilLogic.ServerElapsedSeconds
        local entries = {}
        for row in string.gmatch(owner.StorageDigest, "[^;]+") do
            local id, src, grade, level, deployed, readyAt = string.match(row, "^(.-)|(.-)|(%d+)|(%d+)|(%d)|([%d%.]+)$")
            if id ~= nil then
                local wait = math.max(0, math.ceil(tonumber(readyAt) - now))
                table.insert(entries, { id = id, src = src, grade = tonumber(grade), level = tonumber(level), deployed = deployed == "1", wait = wait })
            end
        end
        local pages = math.max(1, math.ceil(#entries / self.RowCount))
        if self.Page >= pages then self.Page = pages - 1 end
        _UIKit:SetText(self.Win .. "/PageText", string.format("%d / %d   (정수 %d)", self.Page + 1, pages, owner.Essence))
        for i = 1, self.RowCount do
            local base = self.Win .. "/Row" .. tostring(i)
            local e = entries[self.Page * self.RowCount + i]
            self.RowIds[i] = ""
            self.RowDeployed[i] = false
            _UIKit:SetEnabled(base, e ~= nil)
            if e ~= nil then
                self.RowIds[i] = e.id
                self.RowDeployed[i] = e.deployed
                _UIKit:SetText(base .. "/Label", self:RowLabel(e))
                local deployText = "소환"
                if e.deployed then deployText = "회수" elseif e.wait > 0 then deployText = "대기" end
                _UIKit:SetText(base .. "/BtnDeploy", deployText)
                _UIKit:SetText(base .. "/BtnUpgrade", "강화 " .. tostring(_ShadowConfig:GetUpgradeCost(e.level)))
                local yield = _ShadowConfig:GetDisassembleYield(e.grade)
                local salvage = "분해 +" .. tostring(yield)
                if e.deployed or yield <= 0 then salvage = "-" end
                _UIKit:SetText(base .. "/BtnSalvage", salvage)
            end
        end
    end

    method string RowLabel(table e)
        local gradeName = "일반"
        if e.grade == 2 then gradeName = "정예" elseif e.grade >= 3 then gradeName = "보스" end
        local state = ""
        if e.deployed then state = "  · 소환 중" elseif e.wait > 0 then state = "  · 재소환 " .. tostring(e.wait) .. "초" end
        -- 원본 몬스터 개성: 속성 표시
        local trait = ""
        local m = _GameData:GetMonsterStats(e.src)
        if m ~= nil and m.element ~= "" then trait = " " .. _ShadowConfig:ElementName(m.element) end
        return string.format("%s  [%s%s]  Lv%d%s", _GameData:GetMonsterName(e.src), gradeName, trait, e.level, state)
    end

    @ExecSpace("ClientOnly")
    method void OnRowAction(integer index, string action)
        -- 줄 버튼 → 서버 요청
        local id = self.RowIds[index]
        if id == nil or id == "" then return end
        if action == "deploy" then
            local cmd = self:Commander()
            if cmd == nil then return end
            if self.RowDeployed[index] then cmd:RequestRecall(id) else cmd:RequestDeploy(id) end
        else
            local owner = self:Owner()
            if owner == nil then return end
            if action == "upgrade" then owner:RequestUpgrade(id) else owner:RequestDisassemble(id) end
        end
    end

end
