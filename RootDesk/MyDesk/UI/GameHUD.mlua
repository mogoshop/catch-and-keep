-- D2식 메인 HUD 컨트롤러 (클라이언트 전용).
-- 하단: 생명·마나 오브, 경험치 바, 스킬 슬롯(A S D F·우클릭), 포션(1 2) / 상단: 대상 정보, 메뉴
-- 창: 능력치(U), 소지품(I), 스킬(K). Esc = 모든 창 닫기. 값은 각 컴포넌트의 @Sync 값을 읽고, 버튼은 Server 요청으로 보낸다.
@Logic
script GameHUD extends Logic

    property string G = "/ui/GameHUD"
    property number PollInterval = 0.15
    property integer TimerId = 0
    property table Handlers = {}
    property table E = {}                 -- 경로 → 엔티티 캐시
    property string SelectedSkill = ""
    property integer SelectedBag = 0
    property string CharKey = ""
    property string InvKey = ""
    property string SkillKey = ""
    property string SlotKey = ""
    property table SkillRows = {}         -- "T1_1" → skill id
    property string NpcKind = ""          -- 지금 열린 NPC 창 종류 (shop / quest / "")
    property string NpcKey = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 창은 닫고 시작, 버튼 연결, 주기 갱신
        self.Handlers = {}
        self.E = {}
        for _, w in ipairs({ "CharWin", "InvWin", "SkillWin", "QuestWin", "SocialWin", "RankWin" }) do
            local e = self:Get(w)
            if isvalid(e) then e.Enable = false end
        end
        local tgt = self:Get("Target")
        if isvalid(tgt) then tgt.Enable = false end
        local npcWin = self:Get("NpcWin")
        if isvalid(npcWin) then npcWin.Enable = false end
        for i = 1, 5 do
            local index = i
            self:Connect("NpcWin/Btn" .. tostring(i), function() self:NpcAction(index) end)
        end
        for i = 1, 5 do
            local slot = i
            self:Connect("Bottom/Slots/Slot" .. tostring(i), function() self:CastSlot(slot) end)
        end
        self:Connect("Bottom/Slots/Belt1", function() self:UsePotion("hp") end)
        self:Connect("Bottom/Slots/Belt2", function() self:UsePotion("mp") end)
        self:Connect("Bottom/Slots/Belt3", function() self:UsePotion("rv") end)
        self:Connect("Bottom/Slots/Belt4", function() self:TownPortal() end)
        self:Connect("Bottom/Menu/BtnChar", function() self:Toggle("CharWin") end)
        self:Connect("Bottom/Menu/BtnInv", function() self:Toggle("InvWin") end)
        self:Connect("Bottom/Menu/BtnSkill", function() self:Toggle("SkillWin") end)
        self:Connect("Bottom/Menu/BtnQuest", function() self:Toggle("QuestWin") end)
        self:Connect("Bottom/Menu/BtnSocial", function() self:Toggle("SocialWin") end)
        self:Connect("Bottom/Menu/BtnRank", function() self:OpenRanking("depth") end)
        self:Connect("Bottom/Menu/BtnExtract", function() self:Extract() end)
        self:Connect("Bottom/Menu/BtnPortal", function() self:TownPortal() end)
        for _, w in ipairs({ "Request", "TradeWin", "WpWin" }) do
            local e = self:Get(w)
            if isvalid(e) then e.Enable = false end
        end
        for i = 1, 6 do
            local qi = i
            self:Connect("QuestWin/Q" .. tostring(i), function() self.SelectedQuest = qi self.QuestKey = "" end)
            self:Connect("WpWin/Wp" .. tostring(i), function() self:TravelTo(qi) end)
        end
        for i = 1, 8 do
            local si = i
            self:Connect("SocialWin/Party" .. tostring(i), function() self:SocialAction(si, "party") end)
            self:Connect("SocialWin/Duel" .. tostring(i), function() self:SocialAction(si, "duel") end)
            self:Connect("SocialWin/Trade" .. tostring(i), function() self:SocialAction(si, "trade") end)
            self:Connect("TradeWin/My" .. tostring(i), function() self:TradeRetract(si) end)
        end
        self:Connect("SocialWin/BtnLeave", function() local s = self:Social() if s ~= nil then s:RequestLeaveParty() end end)
        self:Connect("Request/BtnYes", function() self:Respond(true) end)
        self:Connect("Request/BtnNo", function() self:Respond(false) end)
        self:Connect("TradeWin/BtnGoldMinus", function() local t = self:Trade() if t ~= nil then t:RequestGold(-100) end end)
        self:Connect("TradeWin/BtnGoldPlus", function() local t = self:Trade() if t ~= nil then t:RequestGold(100) end end)
        self:Connect("TradeWin/BtnConfirm", function() local t = self:Trade() if t ~= nil then t:RequestConfirm() end end)
        self:Connect("TradeWin/BtnCancel", function() local t = self:Trade() if t ~= nil then t:RequestCancel() end end)
        self:Connect("TradeWin/BtnClose", function() local t = self:Trade() if t ~= nil then t:RequestCancel() end end)
        self:Connect("WpWin/BtnClose", function() self.WpClosed = true end)
        for d = 0, 2 do
            local dd = d
            self:Connect("WpWin/Diff" .. tostring(d), function() local tr = self:Travel() if tr ~= nil then tr:RequestDifficulty(dd) end end)
        end
        self:Connect("RankWin/TabDepth", function() self:OpenRanking("depth") end)
        self:Connect("RankWin/TabQueen", function() self:OpenRanking("queen") end)
        for _, w in ipairs({ "CharWin", "InvWin", "SkillWin", "QuestWin", "SocialWin", "RankWin" }) do
            local name = w
            self:Connect(w .. "/BtnClose", function() self:Toggle(name) end)
        end
        for _, s in ipairs({ "Str", "Dex", "Vit", "Ene" }) do
            local stat = s
            self:Connect("CharWin/" .. s .. "/BtnAdd", function() self:AddStat(stat) end)
        end
        for _, slot in ipairs({ "weapon", "offhand", "helm", "armor", "gloves", "boots", "belt", "amulet", "ring1", "ring2" }) do
            local s = slot
            self:Connect("InvWin/Eq_" .. s, function() self:OnEquipSlot(s) end)
        end
        for i = 1, 30 do
            local index = i
            self:Connect("InvWin/Bag" .. tostring(i), function() self:SelectBag(index) end)
        end
        self:Connect("InvWin/BtnEquip", function() self:InvAction("equip") end)
        self:Connect("InvWin/BtnSell", function() self:InvAction("sell") end)
        for t = 1, 3 do
            for r = 1, 10 do
                local key = "T" .. tostring(t) .. "_" .. tostring(r)
                self:Connect("SkillWin/" .. key, function() self:SelectSkill(key) end)
            end
        end
        self:Connect("SkillWin/BtnLearn", function() self:SkillAction(0) end)
        self:Connect("SkillWin/BtnA", function() self:SkillAction(1) end)
        self:Connect("SkillWin/BtnS", function() self:SkillAction(2) end)
        self:Connect("SkillWin/BtnD", function() self:SkillAction(3) end)
        self:Connect("SkillWin/BtnF", function() self:SkillAction(4) end)
        self:Connect("SkillWin/BtnR", function() self:SkillAction(5) end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, self.PollInterval)
        log("[GameHUD] 준비 완료")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, h in ipairs(self.Handlers) do
            if isvalid(h.entity) then h.entity:DisconnectEvent(ButtonClickEvent, h.eventHandler) end
        end
        self.Handlers = {}
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method Entity Get(string rel)
        -- 경로 캐시
        local e = self.E[rel]
        if e == nil then
            e = _EntityService:GetEntityByPath(self.G .. "/" .. rel)
            self.E[rel] = e
        end
        return e
    end

    @ExecSpace("ClientOnly")
    method void SetText(string rel, string text)
        local e = self:Get(rel)
        if isvalid(e) and e.TextGUIRendererComponent.Text ~= text then e.TextGUIRendererComponent.Text = text end
    end

    @ExecSpace("ClientOnly")
    method void SetFill(string rel, number amount)
        local e = self:Get(rel)
        if isvalid(e) then e.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, amount)) end
    end

    @ExecSpace("ClientOnly")
    method void Connect(string rel, any callback)
        local e = self:Get(rel)
        if not isvalid(e) then
            log_warning("[GameHUD] 없음: " .. rel)
            return
        end
        local h = e:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self.Handlers, { entity = e, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method void Toggle(string win)
        local e = self:Get(win)
        if not isvalid(e) then return end
        e.Enable = not e.Enable
        self.CharKey = ""
        self.InvKey = ""
        self.SkillKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        local k = event.key
        if k == KeyboardKey.U then self:Toggle("CharWin")
        elseif k == KeyboardKey.I then self:Toggle("InvWin")
        elseif k == KeyboardKey.K then self:Toggle("SkillWin")
        elseif k == KeyboardKey.Q then self:Toggle("QuestWin")
        elseif k == KeyboardKey.P then self:Toggle("SocialWin")
        elseif k == KeyboardKey.L then self:OpenRanking("depth")
        elseif k == KeyboardKey.Escape then
            for _, w in ipairs({ "CharWin", "InvWin", "SkillWin", "QuestWin", "SocialWin", "RankWin" }) do
                local e = self:Get(w)
                if isvalid(e) then e.Enable = false end
            end
        end
    end

    -- ───────── 컴포넌트 접근 ─────────

    @ExecSpace("ClientOnly")
    method PlayerStats Stats()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        ---@type PlayerStats
        local c = p:GetComponent("script.PlayerStats")
        return c
    end

    @ExecSpace("ClientOnly")
    method SkillBook Book()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        ---@type SkillBook
        local c = p:GetComponent("script.SkillBook")
        return c
    end

    @ExecSpace("ClientOnly")
    method PlayerInventory Inv()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        ---@type PlayerInventory
        local c = p:GetComponent("script.PlayerInventory")
        return c
    end

    -- ───────── 갱신 ─────────

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        local st = self:Stats()
        if not isvalid(player) or st == nil then return end
        local pc = player.PlayerComponent
        self:SetFill("Bottom/LifeOrb/Fill", pc.Hp / math.max(1, pc.MaxHp))
        self:SetText("Bottom/LifeOrb/Text", tostring(math.floor(pc.Hp)) .. "/" .. tostring(math.floor(pc.MaxHp)))
        self:SetFill("Bottom/ManaOrb/Fill", st.Mana / math.max(1, st.MaxMana))
        self:SetText("Bottom/ManaOrb/Text", tostring(math.floor(st.Mana)) .. "/" .. tostring(math.floor(st.MaxMana)))
        self:SetFill("Bottom/XP/Fill", st.Exp / math.max(1, st.ExpToNext))
        self:SetText("Bottom/XP/Text", string.format("Lv %d   경험치 %d / %d", st.Level, st.Exp, st.ExpToNext))
        self:RenderSlots()
        self:RenderTarget(player)
        self:RenderQuestTrack(player)
        self:RenderNpc(player, st)
        self:RenderParty()
        self:RenderRequest()
        self:RenderTrade()
        self:RenderWaypoint(player, st)
        local qw = self:Get("QuestWin")
        if isvalid(qw) and qw.Enable then self:RenderQuestLog(player) end
        local sw2 = self:Get("SocialWin")
        if isvalid(sw2) and sw2.Enable then self:RenderSocial(player) end
        local cw = self:Get("CharWin")
        if isvalid(cw) and cw.Enable then self:RenderChar(st, pc) end
        local iw = self:Get("InvWin")
        if isvalid(iw) and iw.Enable then self:RenderInv(st) end
        local sw = self:Get("SkillWin")
        if isvalid(sw) and sw.Enable then self:RenderSkills(st) end
    end

    @ExecSpace("ClientOnly")
    method void RenderSlots()
        local book = self:Book()
        local inv = self:Inv()
        if book == nil or inv == nil then return end
        local travel = self:Travel()
        local tp = 0
        if travel ~= nil then tp = travel.TownScroll end
        local key = book.Slots .. "#" .. book.RightSkill .. "#" .. tostring(inv.HpPot) .. "#" .. tostring(inv.MpPot) .. "#" .. tostring(inv.RvPot) .. "#" .. tostring(tp)
        if key == self.SlotKey then return end
        self.SlotKey = key
        local keys = { "A", "S", "D", "F" }
        local i = 0
        for id in string.gmatch(book.Slots .. ",", "([^,]*),") do
            i = i + 1
            if i <= 4 then self:SetText("Bottom/Slots/Slot" .. tostring(i), self:SkillShort(id) .. "\n" .. keys[i]) end
        end
        self:SetText("Bottom/Slots/Slot5", self:SkillShort(book.RightSkill) .. "\n우클릭")
        self:SetText("Bottom/Slots/Belt1", "생명 ×" .. tostring(inv.HpPot) .. "\n[1]")
        self:SetText("Bottom/Slots/Belt2", "마나 ×" .. tostring(inv.MpPot) .. "\n[2]")
        self:SetText("Bottom/Slots/Belt3", "회복 ×" .. tostring(inv.RvPot) .. "\n[3]")
        self:SetText("Bottom/Slots/Belt4", "귀환 ×" .. tostring(tp) .. "\n[4]")
    end

    @ExecSpace("ClientOnly")
    method string SkillShort(string id)
        if id == "" then return "-" end
        local def = _SkillData:Get(id)
        if def == nil then return id end
        return def.name
    end

    @ExecSpace("ClientOnly")
    method void RenderTarget(Entity player)
        -- 대상: 커서 근처(마우스 모드) 또는 가장 가까운 살아 있는 몬스터 (반경 4)
        local tgt = self:Get("Target")
        if not isvalid(tgt) then return end
        local p = player.TransformComponent.WorldPosition
        local center = Vector2(p.x, p.y)
        local radius = 4
        ---@type ClickControl
        local cc = player:GetComponent("script.ClickControl")
        if Environment:IsPCPlatform() and cc ~= nil and cc.MouseMode then
            center = _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition())
            radius = 1.2
        end
        local best = nil
        local bestDist = radius
        for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.ShadowMonster", true)) do
            ---@type ShadowMonster
            local m = c
            if not m.IsDead and c.Entity.Enable then
                local q = c.Entity.TransformComponent.WorldPosition
                local d = (Vector2(q.x, q.y) - center):Magnitude()
                if d < bestDist then bestDist = d best = m end
            end
        end
        tgt.Enable = best ~= nil
        if best == nil then return end
        local gradeName = ""
        local color = "#FFFFFF"
        if best.Grade == 2 then gradeName = "정예 " color = "#6E8CFF" elseif best.Grade >= 3 then gradeName = "보스 " color = "#C8A050" end
        if best.Affix ~= "" then gradeName = best.Affix .. " " .. gradeName end
        self:SetText("Target/Name", string.format("<color=%s>%s%s</color>  Lv%d", color, gradeName, _ShadowConfig:GetMonsterName(best.SourceId), best.Level))
        self:SetFill("Target/Bar/Fill", best.Hp / math.max(1, best.MaxHp))
        self:SetText("Target/Curse", best.CurseTag)
    end

    @ExecSpace("ClientOnly")
    method void RenderChar(PlayerStats st, PlayerComponent pc)
        local key = string.format("%d|%d|%d|%d|%d|%d|%d|%.0f|%.0f|%.0f|%.0f|%d|%d|%d|%d|%s|%d", st.Level, st.Str, st.Dex, st.Vit, st.Ene, st.StatPoints, pc.MaxHp, st.MaxMana, st.BonusDefense, st.BonusDamage, st.BonusMinionPct, st.ResFire, st.ResCold, st.ResLight, st.ResPoison, st.ElemDamage, st.Difficulty)
        if key == self.CharKey then return end
        self.CharKey = key
        local lines = {
            string.format("레벨 %d  ·  네크로맨서", st.Level),
            string.format("생명 %d   마나 %d", math.floor(pc.MaxHp), math.floor(st.MaxMana)),
            string.format("근접 피해 %d", math.floor(st:GetMeleeDamage(25))),
            string.format("주문력 +%d%%   방어 %d", math.floor(st:GetSpellPowerPct()), math.floor(st.BonusDefense)),
            string.format("소환수 +%d%%   추출 +%d%%", math.floor(st.BonusMinionPct), math.floor(st.BonusExtractPct)),
            string.format("아이템 발견 +%d%%   골드 발견 +%d%%", math.floor(st.BonusMF), math.floor(st.BonusGF)),
            string.format("<color=#FF7A45>화염 %d</color>  <color=#7AB8FF>냉기 %d</color>  <color=#FFE15A>번개 %d</color>  <color=#7CFF7A>독 %d</color>  (%s)", st.ResFire, st.ResCold, st.ResLight, st.ResPoison, ({ "보통", "악몽", "지옥" })[st.Difficulty + 1] or ""),
        }
        self:SetText("CharWin/Info", table.concat(lines, "\n"))
        self:SetText("CharWin/Str/Text", self:StatLine("힘", st.Str, st.BonusStr))
        self:SetText("CharWin/Dex/Text", self:StatLine("민첩", st.Dex, st.BonusDex))
        self:SetText("CharWin/Vit/Text", self:StatLine("활력", st.Vit, st.BonusVit))
        self:SetText("CharWin/Ene/Text", self:StatLine("정신", st.Ene, st.BonusEne))
        self:SetText("CharWin/Points", "남은 능력치 포인트: " .. tostring(st.StatPoints))
        for _, s in ipairs({ "Str", "Dex", "Vit", "Ene" }) do
            local btn = self:Get("CharWin/" .. s .. "/BtnAdd")
            if isvalid(btn) then btn.Enable = st.StatPoints > 0 end
        end
    end

    @ExecSpace("ClientOnly")
    method string StatLine(string name, integer base, integer bonus)
        if bonus > 0 then return string.format("%s  %d  <color=#6E8CFF>(+%d)</color>", name, base + bonus, bonus) end
        return string.format("%s  %d", name, base)
    end

    @ExecSpace("ClientOnly")
    method void RenderInv(PlayerStats st)
        local inv = self:Inv()
        if inv == nil then return end
        local key = inv.BagDigest .. "#" .. inv.EquipDigest .. "#" .. tostring(st.Gold) .. "#" .. tostring(self.SelectedBag)
        if key == self.InvKey then return end
        self.InvKey = key
        self:SetText("InvWin/Gold", "골드 " .. tostring(st.Gold) .. "      생명 물약 " .. tostring(inv.HpPot) .. "   마나 물약 " .. tostring(inv.MpPot))
        local labels = { weapon = "무기", offhand = "보조", helm = "투구", armor = "갑옷", gloves = "장갑", boots = "신발", belt = "허리띠", amulet = "목걸이", ring1 = "반지1", ring2 = "반지2" }
        local eq = inv:GetEquipMap()
        for slot, label in pairs(labels) do
            local s = eq[slot]
            if s == nil then
                self:SetText("InvWin/Eq_" .. slot, "<color=#777777>" .. label .. ": 비어 있음</color>")
            else
                self:SetText("InvWin/Eq_" .. slot, label .. ": " .. _ItemData:DisplayName(s))
            end
        end
        local list = inv:GetBagList()
        if self.SelectedBag > #list then self.SelectedBag = 0 end
        for i = 1, 30 do
            local s = list[i]
            local btn = self:Get("InvWin/Bag" .. tostring(i))
            if isvalid(btn) then
                if s == nil then
                    btn.TextGUIRendererComponent.Text = ""
                else
                    local item = _ItemData:Parse(s)
                    local short = self:Clip(item.name, 7)
                    local mark = ""
                    if i == self.SelectedBag then mark = "▶" end
                    btn.TextGUIRendererComponent.Text = mark .. "<color=" .. _ItemData:RarityColor(item.rarity) .. ">" .. short .. "</color>"
                end
            end
        end
        local desc = "아이템을 선택하세요."
        if self.SelectedBag > 0 and list[self.SelectedBag] ~= nil then
            local s = list[self.SelectedBag]
            desc = _ItemData:Describe(s) .. "\n판매가 " .. tostring(_ItemData:SellValue(s)) .. " 골드"
            if _ItemData:IsRune(_ItemData:Parse(s).base) then desc = desc .. "\n→ 소켓이 빈 장비 칸을 누르면 끼운다" end
        end
        self:SetText("InvWin/Desc", desc)
    end

    @ExecSpace("ClientOnly")
    method string Clip(string text, integer maxChars)
        -- UTF-8 글자 단위로 자른다 (바이트로 자르면 한글이 깨진다)
        local out = {}
        local n = 0
        for ch in string.gmatch(text, "[\0-\127\194-\244][\128-\191]*") do
            n = n + 1
            if n > maxChars then
                table.insert(out, "..")
                break
            end
            table.insert(out, ch)
        end
        return table.concat(out)
    end

    @ExecSpace("ClientOnly")
    method void RenderSkills(PlayerStats st)
        local book = self:Book()
        if book == nil then return end
        local key = book.SkillDigest .. "#" .. tostring(st.SkillPoints) .. "#" .. tostring(st.Level) .. "#" .. self.SelectedSkill
        if key == self.SkillKey then return end
        self.SkillKey = key
        self:SetText("SkillWin/Points", "남은 스킬 포인트: " .. tostring(st.SkillPoints))
        local trees = { "command", "soul", "curse" }
        local rowCount = { 0, 0, 0 }
        self.SkillRows = {}
        for t = 1, 3 do self:SetText("SkillWin/Head" .. tostring(t), _SkillData:TreeName(trees[t])) end
        for _, id in ipairs(_SkillData:GetOrder()) do
            local def = _SkillData:Get(id)
            local t = 1
            if def.tree == "soul" then t = 2 elseif def.tree == "curse" then t = 3 end
            rowCount[t] = rowCount[t] + 1
            local rkey = "T" .. tostring(t) .. "_" .. tostring(rowCount[t])
            self.SkillRows[rkey] = id
            local lv = book:GetLevel(id)
            local color = "#777777"
            if lv > 0 then color = "#FFFFFF" elseif book:CanLearn(id, st.Level, math.max(1, st.SkillPoints)) == "" then color = "#AACCAA" end
            local mark = ""
            if id == self.SelectedSkill then mark = "▶" end
            local soon = ""
            if not def.impl then soon = " ·" end
            self:SetText("SkillWin/" .. rkey, string.format("%s<color=%s>%s  %d/%d</color>%s", mark, color, def.name, lv, def.maxLv, soon))
        end
        for t = 1, 3 do
            for r = rowCount[t] + 1, 10 do self:SetText("SkillWin/T" .. tostring(t) .. "_" .. tostring(r), "") end
        end
        local desc = "스킬을 선택하세요.  (· = 준비 중)"
        if self.SelectedSkill ~= "" then
            local def = _SkillData:Get(self.SelectedSkill)
            local reason = book:CanLearn(self.SelectedSkill, st.Level, st.SkillPoints)
            local req = "요구 Lv" .. tostring(def.row)
            if def.prereq ~= "" then req = req .. ", 선행 " .. _SkillData:Get(def.prereq).name end
            local manaText = ""
            if def.mana > 0 then manaText = string.format("  마나 %d", math.floor(def.mana)) end
            desc = string.format("%s — %s%s\n%s   %s", def.name, def.desc, manaText, req, reason == "" and "<color=#AACCAA>습득 가능</color>" or ("<color=#FF8888>" .. reason .. "</color>"))
        end
        self:SetText("SkillWin/Desc", desc)
    end

    @ExecSpace("ClientOnly")
    method void RenderQuestTrack(Entity player)
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil then return end
        local q = _QuestData:Get(quest.Index)
        local text = ""
        if q == nil then
            text = "모든 의뢰 완료"
        elseif quest.State == 0 then
            text = "새 의뢰: 잿불 야영지의 사제 오렌을 찾아가라"
        elseif quest.State == 1 then
            text = string.format("의뢰 「%s」 %d / %d", q.title, quest.Progress, q.count)
        else
            text = string.format("의뢰 「%s」 완료 — 사제 오렌에게 보고", q.title)
        end
        self:SetText("QuestTrack", text)
    end

    @ExecSpace("ClientOnly")
    method void RenderNpc(Entity player, PlayerStats st)
        -- 가장 가까운 NPC(대화 거리 안)의 창을 연다. 멀어지면 닫는다
        local win = self:Get("NpcWin")
        if not isvalid(win) then return end
        local p = player.TransformComponent.WorldPosition
        local best = nil
        local bestDist = 999
        for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.WorldNPC", true)) do
            ---@type WorldNPC
            local npc = c
            local q = c.Entity.TransformComponent.WorldPosition
            local d = (Vector2(q.x, q.y) - Vector2(p.x, p.y)):Magnitude()
            if d <= npc.TalkRange and d < bestDist then bestDist = d best = npc end
        end
        win.Enable = best ~= nil
        if best == nil then
            self.NpcKind = ""
            self.NpcKey = ""
            return
        end
        self.NpcKind = best.Kind
        self:SetText("NpcWin/Title", best.NpcName)
        local b1 = self:Get("NpcWin/Btn1")
        local b2 = self:Get("NpcWin/Btn2")
        local b3 = self:Get("NpcWin/Btn3")
        local b4 = self:Get("NpcWin/Btn4")
        local b5 = self:Get("NpcWin/Btn5")
        if best.Kind == "shop" then
            ---@type PlayerInventory
            local inv = player:GetComponent("script.PlayerInventory")
            local gamble = 150 + 30 * st.Level
            self:SetText("NpcWin/Body", string.format("살아 돌아왔군. 필요한 걸 골라라.\n\n생명·마나 물약 25 · 회복 물약 120 · 귀환 두루마리 40\n도박: 무작위 마법 이상 장비 %d골드\n(판매는 소지품 창에서)\n\n가진 골드 %d", gamble, st.Gold))
            for _, b in ipairs({ b1, b2, b3, b4, b5 }) do if isvalid(b) then b.Enable = true end end
            self:SetText("NpcWin/Btn1", "생명\n25")
            self:SetText("NpcWin/Btn2", "마나\n25")
            self:SetText("NpcWin/Btn3", "회복\n120")
            self:SetText("NpcWin/Btn4", "귀환\n40")
            self:SetText("NpcWin/Btn5", "도박\n" .. tostring(gamble))
        else
            ---@type PlayerQuest
            local quest = player:GetComponent("script.PlayerQuest")
            if quest == nil then return end
            local q = _QuestData:Get(quest.Index)
            for _, b in ipairs({ b2, b3, b4, b5 }) do if isvalid(b) then b.Enable = false end end
            if q == nil then
                self:SetText("NpcWin/Body", "여왕의 저주가 걷혔다... 하지만 혼각은 더 깊은 곳에서 울리고 있다.")
                if isvalid(b1) then b1.Enable = false end
                return
            end
            local reward = string.format("보상: 경험치 %d, 골드 %d", q.exp, q.gold)
            local extra = _QuestData:RewardText(q.reward)
            if extra ~= "" then reward = reward .. ", " .. extra end
            local stateText = "수락하겠나?"
            local btn = "수락"
            if quest.State == 1 then
                stateText = string.format("진행 %d / %d", quest.Progress, q.count)
                btn = ""
            elseif quest.State == 2 then
                stateText = "해냈군! 보상을 받게."
                btn = "보고"
            end
            self:SetText("NpcWin/Body", string.format("「%s」\n%s\n%s\n\n%s", q.title, q.desc, reward, stateText))
            if isvalid(b1) then b1.Enable = btn ~= "" end
            self:SetText("NpcWin/Btn1", btn)
        end
    end

    @ExecSpace("ClientOnly")
    method void NpcAction(integer index)
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        if self.NpcKind == "shop" then
            ---@type PlayerInventory
            local inv = player:GetComponent("script.PlayerInventory")
            if inv == nil then return end
            local keys = { "hp", "mp", "rv", "tp", "gamble" }
            if keys[index] ~= nil then inv:RequestBuy(keys[index]) end
        elseif self.NpcKind == "quest" and index == 1 then
            ---@type PlayerQuest
            local quest = player:GetComponent("script.PlayerQuest")
            if quest == nil then return end
            if quest.State == 0 then quest:RequestAccept() elseif quest.State == 2 then quest:RequestTurnIn() end
        end
    end

    -- ───────── 동작 ─────────

    @ExecSpace("ClientOnly")
    method void CastSlot(integer slot)
        local book = self:Book()
        if book ~= nil then book:CastSlot(slot) end
    end

    @ExecSpace("ClientOnly")
    method void UsePotion(string kind)
        local inv = self:Inv()
        if inv ~= nil then inv:RequestUsePotion(kind) end
    end

    @ExecSpace("ClientOnly")
    method void Extract()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return end
        ---@type ShadowOwner
        local owner = p:GetComponent("script.ShadowOwner")
        if owner ~= nil then owner:TryExtractNearby() end
    end

    @ExecSpace("ClientOnly")
    method void AddStat(string stat)
        local st = self:Stats()
        if st ~= nil then st:RequestAddStat(stat) end
    end

    @ExecSpace("ClientOnly")
    method void SelectBag(integer index)
        -- 거래 중이면 가방 칸을 누르면 거래창에 올린다
        local t = self:Trade()
        if t ~= nil and t.Partner ~= "" then
            t:RequestOffer(index)
            return
        end
        self:SelectBagOnly(index)
    end

    @ExecSpace("ClientOnly")
    method void SelectBagOnly(integer index)
        self.SelectedBag = index
        self.InvKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void OnEquipSlot(string slot)
        -- 룬을 고른 상태면 그 장비에 소켓, 아니면 장비 해제
        local inv = self:Inv()
        if inv == nil then return end
        local list = inv:GetBagList()
        local sel = list[self.SelectedBag]
        if sel ~= nil and _ItemData:IsRune(_ItemData:Parse(sel).base) then
            inv:RequestSocket(self.SelectedBag, slot)
            self.SelectedBag = 0
        else
            inv:RequestUnequip(slot)
        end
        self.InvKey = ""
    end

    @ExecSpace("ClientOnly")
    method void InvAction(string action)
        local inv = self:Inv()
        if inv == nil or self.SelectedBag <= 0 then return end
        if action == "equip" then inv:RequestEquip(self.SelectedBag) else inv:RequestSell(self.SelectedBag) end
        self.SelectedBag = 0
        self.InvKey = ""
    end

    @ExecSpace("ClientOnly")
    method void SelectSkill(string rkey)
        local id = self.SkillRows[rkey]
        if id == nil then return end
        self.SelectedSkill = id
        self.SkillKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void SkillAction(integer slot)
        -- 0 = 습득, 1~4 = A S D F 슬롯, 5 = 우클릭
        local book = self:Book()
        if book == nil or self.SelectedSkill == "" then return end
        if slot == 0 then book:RequestLearn(self.SelectedSkill) else book:RequestSetSlot(slot, self.SelectedSkill) end
        self.SkillKey = ""
    end

    -- ───────── D2 확장: 벨트·퀘스트·파티·요청·거래·웨이포인트·랭킹 ─────────

    property integer SelectedQuest = 1
    property string QuestKey = ""
    property string SocialKey = ""
    property table SocialIds = {}
    property string TradeKey = ""
    property string WpKey = ""
    property boolean WpClosed = false
    property string RankKind = "depth"

    @ExecSpace("ClientOnly")
    method PlayerSocial Social()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        ---@type PlayerSocial
        local c = p:GetComponent("script.PlayerSocial")
        return c
    end

    @ExecSpace("ClientOnly")
    method PlayerTrade Trade()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        ---@type PlayerTrade
        local c = p:GetComponent("script.PlayerTrade")
        return c
    end

    @ExecSpace("ClientOnly")
    method PlayerTravel Travel()
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        ---@type PlayerTravel
        local c = p:GetComponent("script.PlayerTravel")
        return c
    end

    @ExecSpace("ClientOnly")
    method void TownPortal()
        local t = self:Travel()
        if t ~= nil then t:RequestTownPortal() end
    end

    @ExecSpace("ClientOnly")
    method void RenderQuestLog(Entity player)
        -- D2 퀘스트 창: 6개 의뢰의 상태 (완료 / 진행 / 미개방)
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil then return end
        local key = tostring(quest.Index) .. "|" .. tostring(quest.State) .. "|" .. tostring(quest.Progress) .. "|" .. tostring(self.SelectedQuest)
        if key == self.QuestKey then return end
        self.QuestKey = key
        for i = 1, 6 do
            local q = _QuestData:Get(i)
            local text = ""
            if q ~= nil then
                local status = "<color=#777777>잠김</color>"
                if i < quest.Index then status = "<color=#7CFF7A>완료</color>"
                elseif i == quest.Index then
                    if quest.State == 0 then status = "<color=#FFE15A>새 의뢰</color>"
                    elseif quest.State == 1 then status = string.format("<color=#FFFFFF>진행 %d/%d</color>", quest.Progress, q.count)
                    else status = "<color=#7CFF7A>보고 대기</color>" end
                end
                local mark = ""
                if i == self.SelectedQuest then mark = "▶" end
                text = string.format("%s%d. %s   %s", mark, i, q.title, status)
            end
            self:SetText("QuestWin/Q" .. tostring(i), text)
        end
        local sel = _QuestData:Get(self.SelectedQuest)
        local desc = ""
        if sel ~= nil and self.SelectedQuest <= quest.Index then
            desc = sel.desc .. "\n보상: 경험치 " .. tostring(sel.exp) .. ", 골드 " .. tostring(sel.gold)
            local extra = _QuestData:RewardText(sel.reward)
            if extra ~= "" then desc = desc .. ", " .. extra end
        elseif sel ~= nil then
            desc = "앞선 의뢰를 마치면 열린다."
        end
        self:SetText("QuestWin/Desc", desc)
    end

    @ExecSpace("ClientOnly")
    method void RenderParty()
        local s = self:Social()
        if s == nil then return end
        local lines = {}
        for uid, name, lv in string.gmatch(s.PartyDigest, "([^|;]+)|([^|;]+)|(%d+)") do
            table.insert(lines, name .. "  Lv" .. lv)
        end
        local text = ""
        if #lines > 0 then text = "파티 (" .. tostring(#lines) .. ")\n" .. table.concat(lines, "\n") end
        self:SetText("PartyPanel", text)
    end

    @ExecSpace("ClientOnly")
    method void RenderSocial(Entity player)
        -- 서버의 다른 플레이어 목록 (최대 8명)
        local ids = {}
        local names = {}
        for _, u in pairs(_UserService.UserEntities) do
            if isvalid(u) and u ~= player and #ids < 8 then
                table.insert(ids, u.PlayerComponent.UserId)
                local mapName = ""
                if isvalid(u.CurrentMap) then mapName = u.CurrentMap.Name end
                table.insert(names, u.PlayerComponent.Nickname .. "  <color=#888888>" .. mapName .. "</color>")
            end
        end
        local key = table.concat(names, ";")
        if key == self.SocialKey then return end
        self.SocialKey = key
        self.SocialIds = ids
        for i = 1, 8 do
            local has = ids[i] ~= nil
            self:SetText("SocialWin/Name" .. tostring(i), names[i] or (i == 1 and "같은 서버에 다른 플레이어가 없다" or ""))
            for _, b in ipairs({ "Party", "Duel", "Trade" }) do
                local e = self:Get("SocialWin/" .. b .. tostring(i))
                if isvalid(e) then e.Enable = has end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void SocialAction(integer index, string kind)
        local id = self.SocialIds[index]
        local s = self:Social()
        if id == nil or s == nil then return end
        s:RequestAction(kind, id)
    end

    @ExecSpace("ClientOnly")
    method void RenderRequest()
        local s = self:Social()
        local win = self:Get("Request")
        if s == nil or not isvalid(win) then return end
        win.Enable = s.PendingKind ~= ""
        if s.PendingKind == "" then return end
        local names = { party = "파티에 초대했다", duel = "결투를 신청했다", trade = "거래를 요청했다" }
        self:SetText("Request/Text", s.PendingFromName .. "님이 " .. (names[s.PendingKind] or s.PendingKind))
    end

    @ExecSpace("ClientOnly")
    method void Respond(boolean accept)
        local s = self:Social()
        if s ~= nil then s:RespondRequest(accept) end
    end

    @ExecSpace("ClientOnly")
    method void RenderTrade()
        local t = self:Trade()
        local win = self:Get("TradeWin")
        if t == nil or not isvalid(win) then return end
        win.Enable = t.Partner ~= ""
        if t.Partner == "" then
            self.TradeKey = ""
            return
        end
        local key = t.MyOffer .. "#" .. t.TheirOffer .. "#" .. tostring(t.MyGold) .. "#" .. tostring(t.TheirGold) .. "#" .. tostring(t.MyConfirm) .. tostring(t.TheirConfirm)
        if key == self.TradeKey then return end
        self.TradeKey = key
        local mine = {}
        for x in string.gmatch(t.MyOffer, "[^;]+") do table.insert(mine, x) end
        local theirs = {}
        for x in string.gmatch(t.TheirOffer, "[^;]+") do table.insert(theirs, x) end
        for i = 1, 8 do
            self:SetText("TradeWin/My" .. tostring(i), mine[i] ~= nil and _ItemData:DisplayName(mine[i]) or "")
            self:SetText("TradeWin/Their" .. tostring(i), theirs[i] ~= nil and _ItemData:DisplayName(theirs[i]) or "")
        end
        local ok = function(b) return b and "<color=#7CFF7A>확인함</color>" or "<color=#888888>대기</color>" end
        self:SetText("TradeWin/Gold", string.format("내 골드 %d  %s\n상대 골드 %d  %s   (소지품 칸을 누르면 올라간다)", t.MyGold, ok(t.MyConfirm), t.TheirGold, ok(t.TheirConfirm)))
        local inv = self:Get("InvWin")
        if isvalid(inv) then inv.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void TradeRetract(integer index)
        local t = self:Trade()
        if t ~= nil and t.Partner ~= "" then t:RequestRetract(index) end
    end

    @ExecSpace("ClientOnly")
    method void RenderWaypoint(Entity player, PlayerStats st)
        -- 웨이포인트 위에 서 있으면 창을 연다 (닫으면 벗어났다가 다시 밟을 때까지 닫힘)
        local win = self:Get("WpWin")
        local travel = self:Travel()
        if not isvalid(win) or travel == nil then return end
        local p = player.TransformComponent.WorldPosition
        local near = false
        for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.Waypoint", true)) do
            local q = c.Entity.TransformComponent.WorldPosition
            if (Vector2(q.x, q.y) - Vector2(p.x, p.y)):Magnitude() <= 1.2 then near = true end
        end
        if not near then self.WpClosed = false end
        win.Enable = near and not self.WpClosed
        if not win.Enable then return end
        local key = travel.Known .. "#" .. tostring(st.Difficulty) .. "#" .. tostring(st.MaxDifficulty)
        if key == self.WpKey then return end
        self.WpKey = key
        local list = _WaypointData:GetList()
        for i = 1, 6 do
            local w = list[i]
            local text = ""
            if w ~= nil then
                if travel:IsKnown(w.id) then text = w.name else text = "<color=#666666>" .. w.name .. " (미발견)</color>" end
            end
            self:SetText("WpWin/Wp" .. tostring(i), text)
        end
        local names = { "보통", "악몽", "지옥" }
        for d = 0, 2 do
            local label = names[d + 1]
            if d == st.Difficulty then label = "▶" .. label elseif d > st.MaxDifficulty then label = "<color=#666666>" .. label .. " (잠김)</color>" end
            self:SetText("WpWin/Diff" .. tostring(d), label)
        end
    end

    @ExecSpace("ClientOnly")
    method void TravelTo(integer index)
        local w = _WaypointData:GetList()[index]
        local travel = self:Travel()
        if w == nil or travel == nil then return end
        travel:RequestTravel(w.id)
    end

    @ExecSpace("ClientOnly")
    method void OpenRanking(string kind)
        local win = self:Get("RankWin")
        if not isvalid(win) then return end
        win.Enable = true
        self.RankKind = kind
        self:SetText("RankWin/List", "불러오는 중...")
        local st = self:Stats()
        local diff = 0
        if st ~= nil then diff = st.Difficulty end
        _RankingSystem:RequestBoard(kind, diff)
    end

    @ExecSpace("ClientOnly")
    method void OnRankingData(string kind, integer diff, string digest)
        if kind ~= self.RankKind then return end
        local names = { "보통", "악몽", "지옥" }
        local lines = { (kind == "depth" and "심도 최고 층" or "묘지기 여왕 최단 처치") .. "  (" .. (names[diff + 1] or "") .. ")", "" }
        local i = 0
        for name, value in string.gmatch(digest, "([^|;]+)|(%d+)") do
            i = i + 1
            local v = kind == "depth" and (value .. "층") or (value .. "초")
            table.insert(lines, string.format("%2d.  %s   %s", i, name, v))
        end
        if i == 0 then table.insert(lines, "아직 기록이 없다") end
        self:SetText("RankWin/List", table.concat(lines, "\n"))
    end

end
