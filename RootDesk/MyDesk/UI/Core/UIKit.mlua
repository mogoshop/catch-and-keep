-- UI 공통 도구 (클라이언트). 모든 HUD·창 컨트롤러가 같이 쓴다.
--   경로 캐시 Get / 글자·게이지 SetText·SetFill / 버튼 연결 Connect(OnEndPlay 해제 포함)
--   창 열고 닫기 Open·Close·Toggle·IsOpen, Esc로 열린 창 모두 닫기 / 내 캐릭터 컴포넌트 Comp / 한글 안전 자르기 Clip
-- 경로: "Bottom/XP"처럼 쓰면 GameHUD 그룹 기준, "/ui/ShadowHUD/..."처럼 /로 시작하면 절대 경로.
@Logic
script UIKit extends Logic

    property string Group = "/ui/GameHUD"
    property table Cache = {}
    property table Handlers = {}
    property table Windows = {}             -- Esc로 닫을 창 이름 목록

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, h in ipairs(self.Handlers) do
            if isvalid(h.entity) then h.entity:DisconnectEvent(h.eventType or ButtonClickEvent, h.eventHandler) end
        end
        self.Handlers = {}
    end

    @ExecSpace("ClientOnly")
    method Entity Get(string rel)
        local e = self.Cache[rel]
        if e == nil or not isvalid(e) then
            local path = rel
            if string.sub(rel, 1, 1) ~= "/" then path = self.Group .. "/" .. rel end
            e = _EntityService:GetEntityByPath(path)
            self.Cache[rel] = e
        end
        return e
    end

    @ExecSpace("ClientOnly")
    method void SetText(string rel, string text)
        local e = self:Get(rel)
        if isvalid(e) and e.TextGUIRendererComponent.Text ~= text then e.TextGUIRendererComponent.Text = text end
    end

    @ExecSpace("ClientOnly")
    method void SetFill(string rel, number amount)
        local e = self:Get(rel)
        if isvalid(e) then e.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, amount)) end
    end

    @ExecSpace("ClientOnly")
    method void ShowCooldown(string rel, SkillBook book, string id)
        -- 쿨다운 덮개(rel = 칸/Cd): 남았으면 켜고 채움·초 표시, 끝났으면 끈다
        local left = book:CooldownLeft(id)
        local on = left > 0.05
        local e = self:Get(rel)
        if not isvalid(e) then return end
        if e.Enable ~= on then e.Enable = on end
        if not on then return end
        e.SpriteGUIRendererComponent.FillAmount = book:CooldownRatio(id)
        local text = left >= 1 and tostring(math.ceil(left)) or string.format("%.1f", left)
        self:SetText(rel .. "/Text", text)
    end

    @ExecSpace("ClientOnly")
    method void SetIcon(string rel, string ruid)
        -- 아이콘: RUID가 있으면 그림을 넣고 켜고, ""면 끈다 (같은 그림이면 건드리지 않는다)
        local e = self:Get(rel)
        if not isvalid(e) then return end
        if ruid == "" then
            if e.Enable then e.Enable = false end
            return
        end
        local sprite = e.SpriteGUIRendererComponent
        if sprite.ImageRUID.DataId ~= ruid then sprite.ImageRUID = DataRef(ruid) end
        if not e.Enable then e.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void SetColor(string rel, Color color)
        -- 그림 색조 (칸 바탕의 등급색·선택 표시, 아이콘 흐리게)
        local e = self:Get(rel)
        if isvalid(e) then e.SpriteGUIRendererComponent.Color = color end
    end

    @ExecSpace("ClientOnly")
    method void SetPos(string rel, Vector2 pos)
        local e = self:Get(rel)
        if isvalid(e) then e.UITransformComponent.anchoredPosition = pos end
    end

    @ExecSpace("ClientOnly")
    method void SetEnabled(string rel, boolean enabled)
        local e = self:Get(rel)
        if isvalid(e) and e.Enable ~= enabled then e.Enable = enabled end
    end

    @ExecSpace("ClientOnly")
    method void Connect(string rel, any callback)
        local e = self:Get(rel)
        if not isvalid(e) then
            log_warning("[UIKit] UI 없음: " .. rel)
            return
        end
        local h = e:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self.Handlers, { entity = e, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method void ConnectHold(string rel, any onDown, any onUp)
        -- 누르고 있기 (버튼은 UITouchReceive가 붙어 있다): 누를 때 onDown, 뗄 때 onUp
        local e = self:Get(rel)
        if not isvalid(e) then
            log_warning("[UIKit] UI 없음: " .. rel)
            return
        end
        table.insert(self.Handlers, { entity = e, eventType = UITouchDownEvent, eventHandler = e:ConnectEvent(UITouchDownEvent, onDown) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchUpEvent, eventHandler = e:ConnectEvent(UITouchUpEvent, onUp) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchExitEvent, eventHandler = e:ConnectEvent(UITouchExitEvent, onUp) })
    end

    @ExecSpace("ClientOnly")
    method void ConnectAimControl(string rel, any onDown, any onDrag, any onUp)
        -- 버튼 밖 드래그에서도 유지한다. 화면 release는 MobilePad가 touch id별로 받는다.
        local e = self:Get(rel)
        if not isvalid(e) then log_warning("[UIKit] 조준 UI 없음: " .. rel) return end
        table.insert(self.Handlers, { entity = e, eventType = UITouchDownEvent, eventHandler = e:ConnectEvent(UITouchDownEvent, onDown) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchDragEvent, eventHandler = e:ConnectEvent(UITouchDragEvent, onDrag) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchUpEvent, eventHandler = e:ConnectEvent(UITouchUpEvent, onUp) })
    end

    -- ───────── 창 ─────────

    @ExecSpace("ClientOnly")
    method void RegisterWindow(string name)
        -- 창 컨트롤러가 시작할 때 등록 (닫힌 상태로 시작)
        table.insert(self.Windows, name)
        self:SetEnabled(name, false)
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen(string name)
        local e = self:Get(name)
        return isvalid(e) and e.Enable
    end

    @ExecSpace("ClientOnly")
    method void Open(string name)
        if name ~= "NpcWin" and self:IsOpen("NpcWin") then _NpcWindow:Dismiss() end
        local click = self:Comp("script.ClickControl")
        if click ~= nil then click:Cancel() end
        for _, win in ipairs(self.Windows) do if win ~= name then self:SetEnabled(win, false) end end
        self:SetEnabled(name, true)
        local e = self:Get(name)
        if isvalid(e) then _UILogic:SetSiblingIndex(e.UITransformComponent, 1000000) end
    end

    @ExecSpace("ClientOnly")
    method void Close(string name)
        self:SetEnabled(name, false)
    end

    @ExecSpace("ClientOnly")
    method void Toggle(string name)
        if self:IsOpen(name) then self:Close(name) else self:Open(name) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if event.key ~= KeyboardKey.Escape then return end
        if self:IsOpen("NpcWin") then _NpcWindow:Dismiss() end
        for _, name in ipairs(self.Windows) do self:Close(name) end
    end

    @ExecSpace("ClientOnly")
    method boolean AnyWindowOpen()
        return self:AnyOtherWindowOpen("")
    end

    @ExecSpace("ClientOnly")
    method boolean AnyOtherWindowOpen(string ignored)
        for _, name in ipairs(self.Windows) do if name ~= ignored and self:IsOpen(name) then return true end end
        return self:IsOpen("/ui/ShadowHUD/Window")
    end

    -- ───────── 데이터 ─────────

    @ExecSpace("ClientOnly")
    method any Comp(string componentName)
        -- 내 캐릭터의 스크립트 컴포넌트 (없으면 nil)
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        return p:GetComponent(componentName)
    end

    method string Clip(string text, integer maxChars)
        -- UTF-8 글자 단위로 자른다 (바이트로 자르면 한글이 깨진다)
        local out = {}
        local n = 0
        for ch in string.gmatch(text, "[\0-\127\194-\244][\128-\191]*") do
            n = n + 1
            if n > maxChars then
                table.insert(out, "..")
                break
            end
            table.insert(out, ch)
        end
        return table.concat(out)
    end

    method string Colored(string color, string text)
        return "<color=" .. color .. ">" .. text .. "</color>"
    end

end
