-- UI 공통 도구 (클라이언트). 모든 HUD·창 컨트롤러가 같이 쓴다.
--   경로 캐시 Get / 글자·게이지 SetText·SetFill / 버튼 연결 Connect(OnEndPlay 해제 포함)
--   창 열고 닫기 Open·Close·Toggle·IsOpen, Esc로 열린 창 모두 닫기 / 내 캐릭터 컴포넌트 Comp / 한글 안전 자르기 Clip
-- 경로: "Bottom/XP"처럼 쓰면 GameHUD 그룹 기준, "/ui/ShadowHUD/..."처럼 /로 시작하면 절대 경로.
@Logic
script UIKit extends Logic

    property string Group = "/ui/GameHUD"
    property table WindowPaths = { AudioWin = "/ui/AudioSettingsHUD/Modal", InvWin = "/ui/EquipmentHUD/SafeArea/InvWin", QuestWin = "/ui/QuestJournalHUD/SafeArea/QuestWin", MiniMap = "/ui/NavigationHUD/SafeArea/MiniMap", QuestTrack = "/ui/NavigationHUD/SafeArea/QuestTrack", JournalWin = "/ui/JournalHUD/SafeArea/JournalWin", JournalOpen = "/ui/JournalHUD/SafeArea/BtnOpen", StashWin = "/ui/StashHUD/SafeArea/StashWin", MerchantWin = "/ui/MerchantHUD/SafeArea/MerchantWin", ShopWin = "/ui/ShopHUD/SafeArea/ShopWin", CharSelect = "/ui/CharSelectHUD/SafeArea/Win", RoomWin = "/ui/CharSelectHUD/SafeArea/Room" }
    property table Cache = {}
    property table Handlers = {}
    property table Windows = {}             -- Esc로 닫을 창 이름 목록
    -- 대화 상자 규격 (NPC 대화창 · 이야기 카드 공통, 10-22): tools/build/ui-tokens.cjs FRAME·DIALOG와 같은 값. 한쪽만 바꾸지 않는다
    property number DialogWidth = 1300
    property number DialogPadX = 51          -- FRAME.padX (테두리 안쪽 경계 39 + 12)
    property number DialogContentTop = 74    -- FRAME.contentTop
    property number DialogGap = 16           -- FRAME.gap
    property number DialogPortraitW = 220    -- DIALOG.portrait.w
    property number DialogTextPadX = 20      -- DIALOG.textPad
    property number DialogTextPadY = 14
    property number DialogPageNoH = 28       -- DIALOG.pageNo
    property number DialogPageNoBottom = 8
    property integer DialogFontPc = 26       -- DIALOG.font
    property integer DialogFontMobile = 30
    property table Passive = { WpWin = true } -- 떠 있어도 이동·전투를 막지 않는 안내 창 (움직이면 스스로 닫힌다)
    property table ScrollBoxes = {}         -- SetScrollText로 채운 스크롤 글 상자 경로 (마우스 휠 대상)
    property any WheelHandler = nil

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, h in ipairs(self.Handlers) do
            if isvalid(h.entity) then h.entity:DisconnectEvent(h.eventType or ButtonClickEvent, h.eventHandler) end
        end
        self.Handlers = {}
        if self.WheelHandler ~= nil then _InputService:DisconnectEvent(MouseScrollEvent, self.WheelHandler) self.WheelHandler = nil end
    end

    -- ───────── 스크롤 글 상자 (빌드 kit.scrollText) ─────────

    @ExecSpace("ClientOnly")
    method void SetScrollText(string rel, string text)
        -- 글을 넣고 글 길이만큼 높이를 세운다. 칸보다 길면 손가락·휠로 내린다. 글이 바뀌면 맨 위부터
        local box = self:Get(rel)
        local body = self:Get(rel .. "/Body")
        local e = self:Get(rel .. "/Body/Text")
        if not isvalid(box) or not isvalid(body) or not isvalid(e) then return end
        local t = e.TextGUIRendererComponent
        if t.Text == text then return end
        t.Text = text
        local width = body.UITransformComponent.RectSize.x
        local height = math.max(box.UITransformComponent.RectSize.y - 8, t:GetPreferredHeight(text, width) + 10)
        e.UITransformComponent.RectSize = Vector2(width, height)
        body.UITransformComponent.RectSize = Vector2(width, height)
        self:RelayoutScroll(box, body)
        local known = false
        for _, r in ipairs(self.ScrollBoxes) do if r == rel then known = true end end
        if not known then table.insert(self.ScrollBoxes, rel) end
        if self.WheelHandler == nil then
            self.WheelHandler = _InputService:ConnectEvent(MouseScrollEvent, function(ev) self:OnWheel(ev.ScrollDelta) end)
        end
    end

    @ExecSpace("ClientOnly")
    method void RelayoutScroll(Entity box, Entity body)
        -- 스크롤 칸은 내용 높이를 자식이 켜질 때만 다시 잰다. 실행 중에 묶음 높이만 바꾸면 빌드 때 높이(칸과 같음)만큼만 내려갔다
        -- (10-13 메이커 측정: 룬워드 1,981 높이인데 8px만 스크롤). 묶음과 레이아웃을 껐다 켜서 다시 재게 하고 맨 위로
        local sl = box.ScrollLayoutGroupComponent
        if sl == nil then return end
        body.Enable = false
        body.Enable = true
        sl.Enable = false
        sl.Enable = true
        sl:ResetScrollPosition(UITransformAxis.Vertical)
    end

    @ExecSpace("ClientOnly")
    method void OnWheel(number delta)
        -- 마우스 휠: 커서 아래 보이는 스크롤 글 상자를 내린다 (엔진 스크롤은 글만 든 칸에서 휠을 받지 않는다). 한 칸 = 약 3줄
        if delta == 0 then return end
        for _, rel in ipairs(self.ScrollBoxes) do
            local box = self:Get(rel)
            local body = self:Get(rel .. "/Body")
            if isvalid(box) and isvalid(body) and self:IsShown(box) and self:CursorOver(box) and box.ScrollLayoutGroupComponent ~= nil then
                local overflow = body.UITransformComponent.RectSize.y + 8 - box.UITransformComponent.RectSize.y
                if overflow > 0 then
                    local sl = box.ScrollLayoutGroupComponent
                    local now = sl:GetScrollNormalizedPosition(UITransformAxis.Vertical)
                    sl:SetScrollNormalizedPosition(UITransformAxis.Vertical, math.max(0, math.min(1, now - delta * 90 / overflow)))
                end
                return
            end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsShown(Entity e)
        -- 자신과 부모가 모두 켜져 있는가 (닫힌 창 안의 상자는 휠을 받지 않는다)
        local cur = e
        while isvalid(cur) do
            if not cur.Enable then return false end
            cur = cur.Parent
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean CursorOver(Entity e)
        -- 커서가 그 UI 사각형 안인지 (InventoryWindow.CursorOver와 같은 판정)
        local corners = e.UITransformComponent:GetWorldCorners()
        if corners == nil or #corners < 4 then return false end
        local cur = _InputService:GetCursorPosition()
        local minX, maxX = math.min(corners[1].x, corners[3].x), math.max(corners[1].x, corners[3].x)
        local minY, maxY = math.min(corners[1].y, corners[3].y), math.max(corners[1].y, corners[3].y)
        return cur.x >= minX and cur.x <= maxX and cur.y >= minY and cur.y <= maxY
    end

    @ExecSpace("ClientOnly")
    method Entity Get(string rel)
        local e = self.Cache[rel]
        if e == nil or not isvalid(e) then
            local path = self:ResolvePath(rel)
            e = _EntityService:GetEntityByPath(path)
            self.Cache[rel] = e
        end
        return e
    end

    method string ResolvePath(string rel)
        -- 창 별칭은 자식 경로까지 같은 그룹으로 보낸다. 절대 경로는 그대로 둔다.
        if string.sub(rel, 1, 1) == "/" then return rel end
        local first, suffix = string.match(rel, "^([^/]+)(.*)$")
        local mapped = first ~= nil and self.WindowPaths[first] or nil
        if mapped ~= nil then return mapped .. suffix end
        return self.Group .. "/" .. rel
    end

    @ExecSpace("ClientOnly")
    method void SetText(string rel, string text)
        local e = self:Get(rel)
        if isvalid(e) and e.TextGUIRendererComponent.Text ~= text then e.TextGUIRendererComponent.Text = text end
    end

    @ExecSpace("ClientOnly")
    method void SetFill(string rel, number amount)
        local e = self:Get(rel)
        if isvalid(e) then e.SpriteGUIRendererComponent.FillAmount = math.max(0, math.min(1, amount)) end
    end

    @ExecSpace("ClientOnly")
    method void SetBar(string fillRel, number ratio)
        -- 진행 막대 채움 (tools/build/lib.cjs progressBar — 업적 막대 그림): 바탕 폭 × 비율로 줄인다.
        --   채움 그림은 양 끝 8px씩 고정(9조각)이라 16보다 짧게 줄이지 않고, 0이면 감춘다 (JournalWindow 줄 막대와 같은 규칙)
        local fill = self:Get(fillRel)
        if not isvalid(fill) or not isvalid(fill.Parent) then return end
        local r = math.max(0, math.min(1, ratio))
        local t = fill.UITransformComponent
        local w = math.max(16, fill.Parent.UITransformComponent.RectSize.x * r)
        if math.abs(t.RectSize.x - w) > 0.5 then t.RectSize = Vector2(w, t.RectSize.y) end
        if fill.Enable ~= (r > 0) then fill.Enable = r > 0 end
    end

    @ExecSpace("ClientOnly")
    method void ShowCooldown(string rel, SkillBook book, string id)
        -- 쿨다운 덮개(rel = 칸/Cd): 남았으면 켜고 채움·초 표시, 끝났으면 끈다
        local left = book:CooldownLeft(id)
        local on = left > 0.05
        local e = self:Get(rel)
        if not isvalid(e) then return end
        if e.Enable ~= on then e.Enable = on end
        if not on then return end
        e.SpriteGUIRendererComponent.FillAmount = book:CooldownRatio(id)
        local text = left >= 1 and tostring(math.ceil(left)) or string.format("%.1f", left)
        self:SetText(rel .. "/Text", text)
    end

    @ExecSpace("ClientOnly")
    method void SetIcon(string rel, string ruid)
        -- 아이콘: RUID가 있으면 그림을 넣고 켜고, ""면 끈다 (같은 그림이면 건드리지 않는다)
        local e = self:Get(rel)
        if not isvalid(e) then return end
        if ruid == "" then
            if e.Enable then e.Enable = false end
            return
        end
        local sprite = e.SpriteGUIRendererComponent
        if sprite.ImageRUID.DataId ~= ruid then sprite.ImageRUID = DataRef(ruid) end
        if not e.Enable then e.Enable = true end
    end

    @ExecSpace("ClientOnly")
    method void SetMonsterPortrait(string rel, string src, number box)
        -- 몬스터 초상: 몸만 잘라 둔 초상 그림(monsters.csv portrait, 없으면 서 있는 프레임)을 box 칸 안에 원래 비율로.
        -- 프레임 그림은 캔버스가 몸보다 넓고 피벗이 발밑이라, 칸에 늘리면(None) 찌그러지고 비율 유지(AspectOnly)면 작아지고 밀린다 (10-13 그림자 보관함 자칼)
        local e = self:Get(rel)
        if not isvalid(e) then return end
        local stats = src ~= "" and _GameData:GetMonsterStats(src) or nil
        if stats == nil then
            self:SetIcon(rel, "")
            return
        end
        local ruid = (stats.portrait ~= nil and stats.portrait ~= "") and stats.portrait or (stats.stand or "")
        self:SetIcon(rel, ruid)
        local sprite = e.SpriteGUIRendererComponent
        if not isvalid(sprite) then return end
        local w = (stats.pw ~= nil and stats.pw > 0) and stats.pw or (stats.w or 0)
        local h = (stats.ph ~= nil and stats.ph > 0) and stats.ph or (stats.h or 0)
        if w <= 0 or h <= 0 then
            sprite.PreserveSprite = PreserveSpriteType.AspectOnly
            e.UITransformComponent.RectSize = Vector2(box, box)
            return
        end
        sprite.PreserveSprite = PreserveSpriteType.None
        local k = box / math.max(w, h)
        e.UITransformComponent.RectSize = Vector2(w * k, h * k)
    end

    @ExecSpace("ClientOnly")
    method void SetColor(string rel, Color color)
        -- 그림 색조 (칸 바탕의 등급색·선택 표시, 아이콘 흐리게)
        local e = self:Get(rel)
        if isvalid(e) then e.SpriteGUIRendererComponent.Color = color end
    end

    @ExecSpace("ClientOnly")
    method void SetPos(string rel, Vector2 pos)
        local e = self:Get(rel)
        if isvalid(e) then e.UITransformComponent.anchoredPosition = pos end
    end

    @ExecSpace("ClientOnly")
    method void SetActPager(string bar, integer act, integer count, string title, string locked)
        -- 액트 넘김 막대 (kit.actPager): 제목 · 끝에선 ◀/▶를 흐리게 (숨기면 막대가 한쪽으로 기울어 보였다) · 점은 액트 수만큼 가운데 정렬 (지금 금색 · 열림 흰 · 잠김 어둡게)
        -- locked: 액트마다 한 글자, "1" = 잠김 (예: "001"). 끝에서 누르면 창 쪽 SetAct가 범위 밖이라 무시한다
        self:SetText(bar .. "/Title", title)
        self:SetText(bar .. "/Prev", act > 1 and "◀" or self:Colored("#7A7268", "◀"))
        self:SetText(bar .. "/Next", act < count and "▶" or self:Colored("#7A7268", "▶"))
        self:SetColor(bar .. "/Prev", Color(1, 1, 1, act > 1 and 1 or 0.55))
        self:SetColor(bar .. "/Next", Color(1, 1, 1, act < count and 1 or 0.55))
        for i = 1, 6 do
            local dot = bar .. "/D" .. tostring(i)
            self:SetEnabled(dot, i <= count and count > 1)
            if i <= count then
                self:SetPos(dot, Vector2((i - (count + 1) / 2) * 22, -20))
                local color = Color(0.78, 0.75, 0.7, 1)
                if i == act then color = Color(1, 0.8, 0.42, 1)
                elseif string.sub(locked, i, i) == "1" then color = Color(0.3, 0.28, 0.33, 1) end
                self:SetColor(dot, color)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void SetEnabled(string rel, boolean enabled)
        local e = self:Get(rel)
        if isvalid(e) and e.Enable ~= enabled then e.Enable = enabled end
    end

    @ExecSpace("ClientOnly")
    method void Connect(string rel, any callback)
        local e = self:Get(rel)
        if not isvalid(e) then
            log_warning("[UIKit] UI 없음: " .. rel)
            return
        end
        local h = e:ConnectEvent(ButtonClickEvent, callback)
        table.insert(self.Handlers, { entity = e, eventHandler = h })
    end

    @ExecSpace("ClientOnly")
    method void ConnectHold(string rel, any onDown, any onUp)
        -- 누르고 있기 (버튼은 UITouchReceive가 붙어 있다): 누를 때 onDown, 뗄 때 onUp
        local e = self:Get(rel)
        if not isvalid(e) then
            log_warning("[UIKit] UI 없음: " .. rel)
            return
        end
        table.insert(self.Handlers, { entity = e, eventType = UITouchDownEvent, eventHandler = e:ConnectEvent(UITouchDownEvent, onDown) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchUpEvent, eventHandler = e:ConnectEvent(UITouchUpEvent, onUp) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchExitEvent, eventHandler = e:ConnectEvent(UITouchExitEvent, onUp) })
    end

    @ExecSpace("ClientOnly")
    method void ConnectAimControl(string rel, any onDown, any onDrag, any onUp)
        -- 버튼 밖 드래그에서도 유지한다. 화면 release는 MobilePad가 touch id별로 받는다.
        local e = self:Get(rel)
        if not isvalid(e) then log_warning("[UIKit] 조준 UI 없음: " .. rel) return end
        table.insert(self.Handlers, { entity = e, eventType = UITouchDownEvent, eventHandler = e:ConnectEvent(UITouchDownEvent, onDown) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchDragEvent, eventHandler = e:ConnectEvent(UITouchDragEvent, onDrag) })
        table.insert(self.Handlers, { entity = e, eventType = UITouchUpEvent, eventHandler = e:ConnectEvent(UITouchUpEvent, onUp) })
    end

    -- ───────── 아이콘 미리 불러오기 ─────────

    @ExecSpace("ClientOnly")
    method void PreloadItemIcons()
        -- 장비·룬·물약·UI 아이콘을 시작할 때 한 번 받아 둔다. 처음 보는 아이콘은 받는 동안 흰 네모·빈칸으로 보였다
        -- (10-11 QA: 상점 가방의 룬 칸이 흰 네모 — 아이콘 자체는 정상, 첫 다운로드 중이었다)
        local seen, list = {}, {}
        local function add(ruid)
            -- 2860136c…는 엔진 기본 UI 판(9-slice) 그림이라 미리 불러올 수 없다 (LEA-3015) — 이미 들어 있다
            if type(ruid) ~= "string" or #ruid ~= 32 or seen[ruid] or ruid == "2860136c06ab075439721c027de365af" then return end
            seen[ruid] = true
            table.insert(list, ruid)
        end
        local t = _ItemData:T()
        for _, b in pairs(t.Bases) do
            -- 외형 썸네일(icon == avatar)은 엔진이 따로 그리므로 직접 그린 아이콘만
            if b.icon ~= nil and b.icon ~= "" and b.icon ~= b.avatar then add(b.icon) end
        end
        for _, r in pairs(t.Runes) do add(r.icon) end
        _GameData:Ensure()
        for _, c in pairs(_GameData.Shop) do add(c.icon) end
        -- 이야기 카드 배경(story_*, 1600×900 약 2MB씩 11장)은 그 카드를 띄울 때 받는다 (StoryCard.Push) — 접속 직후 30MB를 한꺼번에 받지 않게
        for key, ruid in pairs(_GameData.UiIcons) do
            if string.sub(key, 1, 6) ~= "story_" then add(ruid) end
        end
        if #list == 0 then return end
        _ResourceService:PreloadAsync(list, function(results)
            local failed = 0
            if type(results) == "table" then
                for _, status in pairs(results) do
                    if status ~= PreloadResultStatus.Success then failed = failed + 1 end
                end
            end
            log("[VRF] UIKit 아이콘 미리 불러오기 " .. tostring(#list) .. "개 · 실패 " .. tostring(failed))
        end)
    end

    -- ───────── 창 ─────────

    @ExecSpace("ClientOnly")
    method void RegisterWindow(string name)
        -- 창 컨트롤러가 시작할 때 등록 (닫힌 상태로 시작)
        table.insert(self.Windows, name)
        self:SetEnabled(name, false)
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen(string name)
        local e = self:Get(name)
        return isvalid(e) and e.Enable
    end

    @ExecSpace("ClientOnly")
    method void Open(string name)
        -- 창을 여는 순간 캡처된 전투 입력을 끊어 손을 뗄 때 스킬이 나가지 않게 한다.
        _MobilePad:ClearGesture()
        if name ~= "NpcWin" and self:IsOpen("NpcWin") then _NpcWindow:Dismiss() end
        local click = self:Comp("script.ClickControl")
        if click ~= nil then click:Cancel() end
        for _, win in ipairs(self.Windows) do if win ~= name then self:SetEnabled(win, false) end end
        self:SetEnabled(name, true)
        local e = self:Get(name)
        if isvalid(e) then _UILogic:SetSiblingIndex(e.UITransformComponent, 1000000) end
        _ChatFold:SyncHidden()   -- 엔진 채팅이 창 위에 그려지지 않게 바로 감춘다
    end

    @ExecSpace("ClientOnly")
    method void Close(string name)
        self:SetEnabled(name, false)
    end

    @ExecSpace("ClientOnly")
    method void Toggle(string name)
        if self:IsOpen(name) then self:Close(name) else self:Open(name) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if event.key ~= KeyboardKey.Escape then return end
        -- Esc 처리는 여기 한 곳에서 (10-29 45 §2-6 #1: 확인 창과 이 처리가 둘 다 Esc를 받아 확인 창을 닫으며 뒤 소지품 창까지 닫혔다 — 핸들러 순서는 정해져 있지 않다)
        -- 확인 창·조작 방식 고르기가 떠 있으면 그것만 처리하고 뒤 창은 그대로 둔다
        if _ConfirmDialog:IsOpen() then
            _ConfirmDialog:OnEscape()
            log("[VRF] esc consumed by confirm")
            return
        end
        -- 로비 게임 고르기 창은 Esc로 닫지 않고 한 단계 뒤로 (10-29 45 §2-6 #3: 닫으면 다시 열 길이 없었다)
        if self:IsOpen("RoomWin") then
            _RoomWindow:Back()
            return
        end
        -- 거래 창 닫기 = 거래 취소 (창 닫기 단추와 같다)
        if self:IsOpen("TradeWin") then _TradeWindow:CancelTrade() end
        if self:IsOpen("NpcWin") then _NpcWindow:Dismiss() end
        for _, name in ipairs(self.Windows) do self:Close(name) end
    end

    @ExecSpace("ClientOnly")
    method boolean AnyWindowShown()
        -- 안내 창(Passive)까지 포함해 무엇이든 떠 있는가 — 모바일 패드·벨트를 숨길 때 (10-29 45 §2-6 #7: 웨이포인트 창 옆에 패드가 남아 오탭)
        for _, name in ipairs(self.Windows) do if self:IsOpen(name) then return true end end
        return self:IsOpen("/ui/ShadowHUD/Window")
    end

    @ExecSpace("ClientOnly")
    method boolean CanUseGameplayInput()
        -- 메뉴·NPC 대화·보관함에서는 전투/소모품 단축키를 게임으로 보내지 않는다.
        local player = _UserService.LocalPlayer
        return isvalid(player) and _Util:IsAlive(player) and not self:AnyWindowOpen()
    end

    @ExecSpace("ClientOnly")
    method boolean AnyWindowOpen()
        return self:AnyOtherWindowOpen("")
    end

    @ExecSpace("ClientOnly")
    method boolean AnyOtherWindowOpen(string ignored)
        for _, name in ipairs(self.Windows) do if name ~= ignored and not self.Passive[name] and self:IsOpen(name) then return true end end
        return self:IsOpen("/ui/ShadowHUD/Window")
    end

    -- ───────── 데이터 ─────────

    @ExecSpace("ClientOnly")
    method any Comp(string componentName)
        -- 내 캐릭터의 스크립트 컴포넌트 (없으면 nil)
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return nil end
        return p:GetComponent(componentName)
    end

    method string Clip(string text, integer maxChars)
        -- UTF-8 글자 단위로 자른다 (바이트로 자르면 한글이 깨진다)
        local out = {}
        local n = 0
        for ch in string.gmatch(text, "[\0-\127\194-\244][\128-\191]*") do
            n = n + 1
            if n > maxChars then
                table.insert(out, "..")
                break
            end
            table.insert(out, ch)
        end
        return table.concat(out)
    end

    method integer CharCount(string text)
        -- UTF-8 글자 수 (한글 1자 = 1). 글자 길이에 맞춰 칸 너비를 정할 때 쓴다
        local n = 0
        for _ in string.gmatch(text or "", "[\0-\127\194-\244][\128-\191]*") do n = n + 1 end
        return n
    end

    method number TextWidth(string text, number fontPx)
        -- 글자 폭 어림값: 한글·기호 1자 = 글자 크기, 영문·숫자·공백 = 0.55배
        local w = 0
        for ch in string.gmatch(text or "", "[\0-\127\194-\244][\128-\191]*") do
            w = w + (string.len(ch) > 1 and fontPx or fontPx * 0.55)
        end
        return w
    end

    @ExecSpace("ClientOnly")
    method void SetFitText(string rel, string text, number fontPx, number sidePad, number minW, number maxW)
        -- 글자 길이에 맞춰 배너·버튼 너비를 정한다 (공통 규칙: 좌우 장식 안쪽 여백 sidePad, 가운데 정렬).
        -- 최대 너비를 넘으면 그 안에서 글자 크기를 줄인다 — 이름이 길어도 테두리를 넘지 않는다
        local e = self:Get(rel)
        if not isvalid(e) then return end
        local t = e.TextGUIRendererComponent
        if t == nil then return end
        if t.Text ~= text then t.Text = text end
        local need = self:TextWidth(text, fontPx) + sidePad * 2
        local width = math.max(minW, math.min(maxW, need))
        local size = e.UITransformComponent.RectSize
        if math.abs(size.x - width) > 1 then e.UITransformComponent.RectSize = Vector2(width, size.y) end
        local fit = need > maxW
        if t.BestFit ~= fit then
            t.BestFit = fit
            t.MinSize = math.floor(fontPx * 0.7)
            t.MaxSize = math.floor(fontPx)
        end
        if t.Padding.left ~= math.floor(sidePad) then t.Padding = RectOffset(math.floor(sidePad), math.floor(sidePad), 0, 0) end
    end

    method string StoryText(string text, integer limit)
        -- 이야기 문구 표시: {장소} = 금색, [적] = 붉은색. limit >= 0이면 표시 글자 수(강조 기호 제외)를 그만큼만 (글자 차례 출력)
        local out = {}
        local count = 0
        local mode = ""
        for _, cp in utf8.codes(text) do
            local ch = utf8.char(cp)
            if ch == "{" and mode == "" then
                table.insert(out, "<color=#E8C66B>")
                mode = "}"
            elseif ch == "[" and mode == "" then
                table.insert(out, "<color=#E8705C>")
                mode = "]"
            elseif ch == mode then
                table.insert(out, "</color>")
                mode = ""
            else
                if limit >= 0 and count >= limit then break end
                table.insert(out, ch)
                count = count + 1
            end
        end
        if mode ~= "" then table.insert(out, "</color>") end
        return table.concat(out)
    end

    method integer StoryLength(string text)
        -- 강조 기호({ } [ ])를 뺀 글자 수
        local n = 0
        for _, cp in utf8.codes(text) do
            local ch = utf8.char(cp)
            if ch ~= "{" and ch ~= "}" and ch ~= "[" and ch ~= "]" then n = n + 1 end
        end
        return n
    end

    @ExecSpace("ClientOnly")
    method void SetSize(string rel, Vector2 size)
        local e = self:Get(rel)
        if isvalid(e) then e.UITransformComponent.RectSize = size end
    end

    @ExecSpace("ClientOnly")
    method void LayoutDialog(string win, boolean portrait, number paperH, number rightReserve)
        -- 대화 상자 글 칸 배치: 초상화가 있으면 그 오른쪽, 없으면 상자 왼쪽부터. rightReserve = 오른쪽에 비워 둘 폭 (의뢰 그림 등)
        local paperX = self.DialogPadX
        if portrait then paperX = self.DialogPadX + self.DialogPortraitW + self.DialogGap end
        local paperW = self.DialogWidth - paperX - self.DialogPadX - rightReserve
        self:SetPos(win .. "/Paper", Vector2(paperX, -self.DialogContentTop))
        self:SetSize(win .. "/Paper", Vector2(paperW, paperH))
        self:SetPos(win .. "/Paper/Body", Vector2(self.DialogTextPadX, -self.DialogTextPadY))
        self:SetSize(win .. "/Paper/Body", Vector2(paperW - self.DialogTextPadX * 2, paperH - self.DialogTextPadY * 2 - self.DialogPageNoH + self.DialogPageNoBottom))
        self:ApplyDialogFont(win .. "/Paper/Body")
    end

    @ExecSpace("ClientOnly")
    method void SetPortrait(string path, string standRuid)
        -- 대화 상자 초상화: NPC 서 있는 그림(애니메이션 클립 · 발밑 기준점)은 thumbnail://로 넣어야 칸 가운데에 그려진다 ("" = 끔)
        --   10-23: 그림 한 장(스프라이트)이면 원본 그대로 — thumbnail://은 작게 줄인 미리보기라 대화창에서 흐렸다 (마을 NPC는 선명한데 초상화만 흐림)
        if standRuid ~= "" and _QuestData:IsSpriteStand(standRuid) then
            self:SetIcon(path, standRuid)
            return
        end
        self:SetIcon(path, standRuid ~= "" and ("thumbnail://" .. standRuid) or "")
    end

    @ExecSpace("ClientOnly")
    method void ApplyDialogFont(string path)
        -- 대화 글 크기: PC 26 · 모바일 30 (긴 글은 BestFit으로 MinSize까지 줄어든다)
        local e = self:Get(path)
        if not isvalid(e) then return end
        local size = _ApplicationService:IsMobilePlatform() and self.DialogFontMobile or self.DialogFontPc
        local t = e.TextGUIRendererComponent
        if t.MaxSize ~= size then t.MaxSize = size end
        if t.FontSize ~= size then t.FontSize = size end
    end

    method string Colored(string color, string text)
        return "<color=" .. color .. ">" .. text .. "</color>"
    end

end
