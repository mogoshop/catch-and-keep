-- 스킬 지정 창: 퀵슬롯(A S D F 우클릭)마다 넣을 스킬을 고른다. 배운 액티브·저주만 아이콘으로 보인다 (D2 스킬 선택).
-- 여는 곳: PC 아래 스킬 칸 클릭, 모바일 패드 「스킬 편집」, 스킬 창. 지정은 SkillBook:RequestSetSlot (서버 검증).
-- 벨트 모드(OpenBelt): 같은 창으로 벨트 칸 1~4에 넣을 물건(물약 3종·귀환 두루마리)을 고른다 → PlayerBelt:RequestSetBelt.
@Logic
script SkillPicker extends Logic

    property string Win = "SkillPick"
    property integer PickCount = 18
    property integer Slot = 1
    property table Picks = {}               -- 칸 번호 → 스킬 id (벨트 모드는 물건 종류)
    property string Mode = "skill"          -- skill / belt
    property string RenderKey = ""
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for i = 1, 5 do
            local slot = i
            _UIKit:Connect(self.Win .. "/Tab" .. tostring(i), function() self:SelectSlot(slot) end)
        end
        for i = 1, self.PickCount do
            local index = i
            _UIKit:Connect(self.Win .. "/Grid/Pick" .. tostring(i), function() self:Pick(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnClear", function() self:Assign("") end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method void Open(integer slot)
        self.Mode = "skill"
        self.Slot = math.max(1, math.min(5, slot))
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void OpenBelt(integer index)
        -- 벨트 칸 index에 넣을 물건 고르기
        self.Mode = "belt"
        self.Slot = math.max(1, math.min(4, index))
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void SelectSlot(integer slot)
        if self.Mode == "belt" and slot > 4 then return end
        self.Slot = slot
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Pick(integer index)
        local id = self.Picks[index]
        if id == nil then return end
        self:Assign(id)
    end

    @ExecSpace("ClientOnly")
    method void Assign(string id)
        if self.Mode == "belt" then
            ---@type PlayerBelt
            local belt = _UIKit:Comp("script.PlayerBelt")
            if belt ~= nil then belt:RequestSetBelt(self.Slot, id) end
            self.RenderKey = ""
            return
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        book:RequestSetSlot(self.Slot, id)
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        if not _UIKit:IsOpen(self.Win) then return end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        if self.Mode == "belt" then self:PollBelt() return end
        _UIKit:SetText(self.Win .. "/Title", "스킬 지정")
        _UIKit:SetEnabled(self.Win .. "/Tab5", true)
        local key = book.SkillDigest .. "#" .. book.Slots .. "#" .. book.RightSkill .. "#" .. tostring(self.Slot)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local current = book:GetSlotSkill(self.Slot)
        -- 탭: 고른 칸은 밝게, 칸 이름 아래 지금 든 스킬. 모바일은 키가 없으니 칸 번호와 큰 공격 버튼
        local names = { "A", "S", "D", "F", "우클릭" }
        if Environment:IsMobilePlatform() then names = { "1번", "2번", "3번", "4번", "공격 버튼" } end
        for i = 1, 5 do
            local held = book:GetSlotSkill(i)
            local label = names[i]
            if held ~= "" then label = label .. " " .. _UIKit:Clip(_SkillData:Get(held).name, 4) end
            if i == self.Slot then label = _UIKit:Colored("#FFFFFF", "▶" .. label) end
            _UIKit:SetText(self.Win .. "/Tab" .. tostring(i), label)
        end
        -- 배운 액티브·저주 목록
        self.Picks = {}
        local n = 0
        for _, id in ipairs(_SkillData:GetOrder()) do
            local def = _SkillData:Get(id)
            if (def.kind == "active" or def.kind == "curse") and book:GetLevel(id) > 0 and n < self.PickCount then
                n = n + 1
                self.Picks[n] = id
                local path = self.Win .. "/Grid/Pick" .. tostring(n)
                _UIKit:SetEnabled(path, true)
                _UIKit:SetIcon(path .. "/Icon", def.icon)
                _UIKit:SetText(path .. "/Name", _UIKit:Clip(def.name, 6))
                _UIKit:SetColor(path, id == current and Color(0.42, 0.3, 0.12, 0.95) or Color(0.05, 0.045, 0.06, 0.94))
            end
        end
        for i = n + 1, self.PickCount do _UIKit:SetEnabled(self.Win .. "/Grid/Pick" .. tostring(i), false) end
        local desc = names[self.Slot] .. " 칸: "
        if current == "" then
            if self.Slot == 5 and Environment:IsMobilePlatform() then desc = desc .. "기본 공격" else desc = desc .. "비어 있음" end
        else
            desc = desc .. _SkillData:Get(current).name
        end
        if n == 0 then desc = desc .. "\n배운 스킬이 없습니다. 스킬 창(K)에서 먼저 배우세요." else desc = desc .. "\n아래에서 스킬을 누르면 이 칸에 들어갑니다." end
        _UIKit:SetText(self.Win .. "/Desc", desc)
        local clear = "칸 비우기"
        if self.Slot == 5 and Environment:IsMobilePlatform() then clear = "기본 공격으로" end
        _UIKit:SetText(self.Win .. "/BtnClear", clear)
    end

    @ExecSpace("ClientOnly")
    method void PollBelt()
        -- 벨트 모드: 탭 = 벨트 칸 1~4, 목록 = 물약 3종 + 귀환 두루마리 (남은 개수와 함께)
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if belt == nil then return end
        local key = "belt#" .. belt.Layout .. "#" .. tostring(belt.HpPot) .. tostring(belt.MpPot) .. tostring(belt.RvPot) .. tostring(belt:CountOf("tp")) .. "#" .. tostring(self.Slot)
        if key == self.RenderKey then return end
        self.RenderKey = key
        _UIKit:SetText(self.Win .. "/Title", "벨트 칸 지정")
        _UIKit:SetEnabled(self.Win .. "/Tab5", false)
        for i = 1, 4 do
            local short = { hp = "생명", mp = "마나", rv = "회복", tp = "귀환" }
            local label = tostring(i) .. "번 " .. (short[belt:SlotKind(i)] or "빈 칸")
            if i == self.Slot then label = _UIKit:Colored("#FFFFFF", "▶" .. label) end
            _UIKit:SetText(self.Win .. "/Tab" .. tostring(i), label)
        end
        local kinds = { "hp", "mp", "rv", "tp" }
        local current = belt:SlotKind(self.Slot)
        self.Picks = {}
        for i, kind in ipairs(kinds) do
            self.Picks[i] = kind
            local path = self.Win .. "/Grid/Pick" .. tostring(i)
            _UIKit:SetEnabled(path, true)
            _UIKit:SetIcon(path .. "/Icon", _GameData:GetUiIcon(_GameConst:BeltIcon(kind)))
            _UIKit:SetText(path .. "/Name", _UIKit:Clip(_GameConst:BeltName(kind), 5) .. " " .. tostring(belt:CountOf(kind)))
            _UIKit:SetColor(path, kind == current and Color(0.42, 0.3, 0.12, 0.95) or Color(0.05, 0.045, 0.06, 0.94))
        end
        for i = #kinds + 1, self.PickCount do _UIKit:SetEnabled(self.Win .. "/Grid/Pick" .. tostring(i), false) end
        local keyHint = Environment:IsMobilePlatform() and "물약 칸" or ("숫자 " .. tostring(self.Slot) .. "키")
        _UIKit:SetText(self.Win .. "/Desc", tostring(self.Slot) .. "번 칸: " .. _GameConst:BeltName(current) .. " (" .. keyHint .. ")\n위 목록에서 고르면 이 칸에 들어갑니다.")
        _UIKit:SetText(self.Win .. "/BtnClear", "칸 비우기")
    end

end
