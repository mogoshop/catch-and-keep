-- 스킬 창 (K) — 10-11 개편 (docs/design/16): 트리 탭(소환·영혼·저주·망령 걸음, 10-20) + 메인 스킬 카드 8칸씩 (해금 레벨 순).
--   10-24 사용자: 오른쪽 패널 대신 고른 카드 바로 아래 아코디언(Grid/Acc)에 설명·지금/다음 효과·스킬 강화 3칸 — 아랫줄 카드는 그만큼 밀린다.
--   카드·강화를 고르면 아래 설명에 지금/다음 효과·조건. 고른 것을 한 번 더 누르면 바로 +1 (첫 클릭은 설명 보기라 실수로 찍히지 않는다).
--   메인 스킬 랭크 상한 = 1 + (캐릭터 Lv − 해금 Lv) ÷ 2 → 남는 포인트는 예전 메인 스킬의 강화로.
-- 칸 지정: 「스킬 편집」 하나 — PC는 스킬 지정 창(A S D F 우클릭 탭), 모바일은 창을 닫고 패드 칸의 +를 눌러 고른다.
@Logic
script SkillWindow extends Logic

    property string Win = "SkillWin"
    property string Selected = ""           -- 고른 메인 스킬 또는 강화 노드
    property string SelMain = ""            -- 오른쪽 패널에 보이는 메인 스킬
    property table Cards = {}               -- 카드 번호 → 메인 스킬 id
    property table NodeIds = {}             -- 강화 칸 번호 → 노드 id
    property string Tab = "command"         -- 보고 있는 트리 (command · soul · curse · move)
    property string RenderKey = ""
    property integer LockedFold = 10        -- 지금 레벨 + 이 값보다 늦게 열리는 카드는 한 장으로 접는다
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for i = 1, 24 do
            local index = i
            _UIKit:Connect(self.Win .. "/Grid/M" .. tostring(i), function() self:Pick(self.Cards[index]) end)
        end
        for i, tree in ipairs(self:Trees()) do
            local t = tree
            _UIKit:Connect(self.Win .. "/Tab" .. tostring(i), function() self:SetTab(t) end)
        end
        for i = 1, 8 do
            local index = i
            _UIKit:Connect(self.Win .. "/Grid/Acc/N" .. tostring(i), function() self:Pick(self.NodeIds[index]) end)
        end
        -- 습득 + 「스킬 편집」(PC: 스킬 지정 창, 모바일: 패드 칸의 +)
        _UIKit:Connect(self.Win .. "/BtnLearn", function() self:Act(0) end)
        _UIKit:Connect(self.Win .. "/BtnEdit", function() self:EditSlots() end)
        _UIKit:Connect(self.Win .. "/BtnReset", function()
            ---@type SkillBook
            local book = _UIKit:Comp("script.SkillBook")
            ---@type PlayerStats
            local st = _UIKit:Comp("script.PlayerStats")
            if book == nil or st == nil then return end
            local cost = book:RespecCost(st.Level)
            local note = cost == 0 and ("무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)") or (tostring(cost) .. " 골드 · 마을의 사제 오렌·카라반 대장 무하드 곁에서")
            _ConfirmDialog:Show("스킬 초기화", "배운 스킬·강화를 모두 돌려받고 스킬 칸도 비웁니다.\n" .. note, "초기화", function() book:RequestRespec("skills") end)
        end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        if not _UIKit:IsOpen(self.Win) then
            self.RenderKey = ""
            return
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if book == nil or st == nil then return end
        local key = book.SkillDigest .. "#" .. tostring(st.SkillPoints) .. "#" .. tostring(st.Level) .. "#" .. self.Selected .. "#" .. tostring(st:GetSpellPowerPct()) .. "#" .. tostring(st:GetCastCooldownMult()) .. "#" .. tostring(st:GetMinionPct()) .. "#" .. tostring(st.BonusDeploy) .. "#" .. tostring(st.BonusShadowCap) .. "#" .. tostring(st.Gold) .. "#" .. self:GearLevelKey(st)
        key = key .. "#" .. self.Tab
        if key == self.RenderKey then return end
        self.RenderKey = key
        -- 탭: 고른 트리는 밝게, 배울 수 있는 스킬이 있는 트리는 이름 옆 「+」
        for i, tree in ipairs(self:Trees()) do
            local chosen = tree == self.Tab
            local learnable = false
            if st.SkillPoints > 0 then
                for _, id in ipairs(self:MainsOf(tree)) do
                    if book:CanLearn(id, st.Level, st.SkillPoints) == "" then learnable = true break end
                end
            end
            _UIKit:SetText(self.Win .. "/Tab" .. tostring(i), _UIKit:Colored(chosen and "#FFE9A8" or "#A99F8E", _SkillData:TreeName(tree)) .. (learnable and _UIKit:Colored("#7CFF7A", " +") or ""))
            _UIKit:SetColor(self.Win .. "/Tab" .. tostring(i), chosen and Color(1, 0.92, 0.7, 1) or Color(0.6, 0.6, 0.6, 0.85))
        end
        _UIKit:SetText(self.Win .. "/Points", "남은 스킬 포인트: " .. tostring(st.SkillPoints) .. _UIKit:Colored("#A99F8E", "   · 레벨업마다 +" .. tostring(math.floor(_GameData.skillPerLevel))))
        local cost = book:RespecCost(st.Level)
        _UIKit:SetText(self.Win .. "/BtnReset", cost == 0 and ("초기화 · 무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)") or ("초기화 · " .. tostring(cost) .. " 골드"))
        -- 카드: 고른 트리의 메인 스킬 (해금 레벨 순). 지금 레벨 +LockedFold 밖의 잠긴 카드는 마지막 한 장으로 접는다
        -- (10-20 첫 1시간 점검: Lv1 소환 탭 9장 중 8장이 잠김이라 무엇을 배울지 안 보였다)
        local all = self:MainsOf(self.Tab)
        local mains, folded, foldFrom = {}, 0, 0
        for _, id in ipairs(all) do
            local row = _SkillData:Get(id).row
            if row <= st.Level + self.LockedFold then
                table.insert(mains, id)
            else
                folded = folded + 1
                if foldFrom == 0 then foldFrom = row end
            end
        end
        self.Cards = {}
        for i = 1, 24 do
            local id = mains[i]
            local path = self.Win .. "/Grid/M" .. tostring(i)
            local summary = id == nil and folded > 0 and i == #mains + 1
            _UIKit:SetEnabled(path, id ~= nil or summary)
            if summary then
                _UIKit:SetText(path .. "/Label", _UIKit:Colored("#8C99B4", "Lv" .. tostring(foldFrom) .. " 이후\n스킬 " .. tostring(folded) .. "개"))
                _UIKit:SetIcon(path .. "/Icon", "")
                _UIKit:SetColor(path, Color(0, 0, 0, 0.18))
            end
            if id ~= nil then
                self.Cards[i] = id
                local def = _SkillData:Get(id)
                local lv = book:GetLevel(id)
                local cap = book:RankCap(id, st.Level)
                local status
                local color = "#8A8A8A"
                if st.Level < def.row then
                    status = _UIKit:Colored("#8C99B4", "Lv" .. tostring(def.row) .. "에 열림")
                else
                    if lv > 0 then color = "#FFFFFF" elseif book:CanLearn(id, st.Level, math.max(1, st.SkillPoints)) == "" then color = "#B8E0B8" end
                    status = _UIKit:Colored(lv > 0 and "#F4ED83" or "#B8E0B8", tostring(lv) .. "/" .. tostring(cap)) .. (cap < def.maxLv and _UIKit:Colored("#8C99B4", " (" .. tostring(def.maxLv) .. ")") or "")
                    local gear = st:GetSkillLevelBonus(id, def.tree)
                    if lv > 0 and gear > 0 then status = status .. _UIKit:Colored("#7CFF7A", " +" .. tostring(gear)) end   -- 장비 스킬 레벨 (docs/design/19)
                end
                _UIKit:SetText(path .. "/Label", _UIKit:Colored(color, def.name) .. "\n" .. status)
                _UIKit:SetIcon(path .. "/Icon", def.icon)
                _UIKit:SetColor(path .. "/Icon", lv > 0 and Color(1, 1, 1, 1) or (st.Level >= def.row and Color(0.75, 0.75, 0.75, 0.95) or Color(0.35, 0.35, 0.35, 0.7)))
                local chosen = id == self.SelMain
                _UIKit:SetColor(path, chosen and Color(0.55, 0.65, 0.9, 0.55) or Color(0, 0, 0, 0.3))
            end
        end
        if self.SelMain == "" and #mains > 0 then self.SelMain = mains[1] end
        self:Layout(#mains + (folded > 0 and 1 or 0))
        self:RenderDetail(book, st)
        _UIKit:SetText(self.Win .. "/DescBox/Desc", self:Describe(book, st))
        self:RenderLearnButton(book, st)
    end

    @ExecSpace("ClientOnly")
    method void Layout(integer shown)
        -- 카드 8칸씩. 고른 카드의 줄 바로 아래에 아코디언을 펼치고, 그 아랫줄 카드는 아코디언 높이만큼 내린다
        local cols = 8
        local cellW = 120
        local cellH = 98
        local accH = self:AccHeight()
        local sel = 0
        for i, id in pairs(self.Cards) do if id == self.SelMain then sel = i end end
        local selRow = sel > 0 and (sel - 1) // cols or -1
        for i = 1, 24 do
            local col = (i - 1) % cols
            local row = (i - 1) // cols
            local y = -row * cellH
            if selRow >= 0 and row > selRow then y = y - (accH + 8) end
            _UIKit:SetPos(self.Win .. "/Grid/M" .. tostring(i), Vector2(col * cellW, y))
        end
        _UIKit:SetEnabled(self.Win .. "/Grid/Acc", sel > 0 and shown > 0)
        if sel > 0 then
            _UIKit:SetPos(self.Win .. "/Grid/Acc", Vector2(0, -(selRow + 1) * cellH))
            _UIKit:SetPos(self.Win .. "/Grid/Acc/Pointer", Vector2(((sel - 1) % cols) * cellW, 8))
            local acc = _UIKit:Get(self.Win .. "/Grid/Acc")
            if isvalid(acc) then acc.UITransformComponent.RectSize = Vector2(954, accH) end
        end
    end

    @ExecSpace("ClientOnly")
    method void LayoutNodes(string acc, integer n)
        -- 강화 칸: 6개까지 3칸씩(폭 306), 7개 이상(해골 마법사 변이)은 4칸씩(폭 228) 두 줄
        local cols = n > 6 and 4 or 3
        local w = n > 6 and 228 or 306
        for i = 1, 8 do
            local path = acc .. "/N" .. tostring(i)
            local e = _UIKit:Get(path)
            if isvalid(e) then
                e.UITransformComponent.RectSize = Vector2(w, 72)
                _UIKit:SetPos(path, Vector2(12 + ((i - 1) % cols) * (w + 6), -154 - ((i - 1) // cols) * 78))
                local label = _UIKit:Get(path .. "/Label")
                if isvalid(label) then label.UITransformComponent.RectSize = Vector2(w - 120, 68) end
            end
        end
    end

    method number AccHeight()
        -- 강화 수에 맞춘다: 없음(집결·망령 도약 등) 128 · 3개까지 한 줄 232 · 4~8개(해골 전사·마법사 변이) 두 줄 310
        local n = #_SkillData:NodesOf(self.SelMain)
        if n == 0 then return 128 end
        if n <= 3 then return 232 end
        return 310
    end

    @ExecSpace("ClientOnly")
    method void RenderDetail(SkillBook book, PlayerStats st)
        -- 아코디언: 고른 메인 스킬 이름·랭크·설명 / 지금·다음 효과·마나 / 스킬 강화 (최대 3)
        local def = _SkillData:Get(self.SelMain)
        if def == nil then return end
        local acc = self.Win .. "/Grid/Acc"
        local lv = book:GetLevel(self.SelMain)
        local cap = book:RankCap(self.SelMain, st.Level)
        local rank = st.Level < def.row and _UIKit:Colored("#8C99B4", "Lv" .. tostring(def.row) .. "에 열림")
            or _UIKit:Colored("#F4ED83", "랭크 " .. tostring(lv) .. "/" .. tostring(cap)) .. (cap < def.maxLv and _UIKit:Colored("#8C99B4", " (최대 " .. tostring(def.maxLv) .. ")") or "")
        _UIKit:SetText(acc .. "/Name", def.name .. "  " .. _UIKit:Colored("#8C99B4", _SkillData:TreeName(def.tree)) .. "   " .. rank)
        _UIKit:SetText(acc .. "/Desc", def.desc)
        _UIKit:SetText(acc .. "/Stat", self:StatLine(book, st, self.SelMain))
        local nodes = _SkillData:NodesOf(self.SelMain)
        _UIKit:SetEnabled(acc .. "/NodeHead", #nodes > 0)
        _UIKit:SetEnabled(acc .. "/NodeHint", #nodes > 0)
        self.NodeIds = {}
        self:LayoutNodes(acc, #nodes)
        for i = 1, 8 do
            local nid = nodes[i]
            local path = acc .. "/N" .. tostring(i)
            _UIKit:SetEnabled(path, nid ~= nil)
            if nid ~= nil then
                self.NodeIds[i] = nid
                local nd = _SkillData:Get(nid)
                local nlv = book:GetLevel(nid)
                local reason = book:CanLearn(nid, st.Level, math.max(1, st.SkillPoints))
                local color = nlv > 0 and "#FFFFFF" or (reason == "" and "#B8E0B8" or "#8A8A8A")
                local line2 = nd.desc
                if not nd.impl then line2 = _UIKit:Colored("#8C99B4", "준비 중 — 다음 업데이트") .. " · " .. nd.desc
                else
                    -- 다음 랭크에 필요한 메인 랭크 (다중 투사체는 랭크마다 다르다 — SkillBook.NodeNeed) · 캐릭터 레벨 (그림자 증원 — NodeLevel)
                    local need = book:NodeNeed(nid, nlv + 1)
                    local needLv = book:NodeLevel(nid, nlv + 1)
                    if nlv < nd.maxLv and lv < need then line2 = _UIKit:Colored("#FF9A8A", def.name .. " " .. tostring(need) .. "랭크부터") .. " · " .. nd.desc
                    elseif nlv < nd.maxLv and st.Level < needLv then line2 = _UIKit:Colored("#FF9A8A", "캐릭터 Lv" .. tostring(needLv) .. "부터") .. " · " .. nd.desc end
                end
                _UIKit:SetText(path .. "/Label", _UIKit:Colored(color, nd.name .. "  " .. tostring(nlv) .. "/" .. tostring(nd.maxLv)) .. "\n" .. line2)
                _UIKit:SetColor(path, nid == self.Selected and Color(0.55, 0.65, 0.9, 0.55) or Color(0, 0, 0, 0.35))
                -- 아이콘 + 오른쪽 상태 칩: 지금 찍을 수 있으면 초록 「+1」, 다 찍었으면 「완료」, 조건이 모자라면 「잠김」 (10-24 사용자: 눌러야 하는지 몰랐다)
                _UIKit:SetIcon(path .. "/Icon", nd.icon)
                _UIKit:SetColor(path .. "/Icon", nlv > 0 and Color(1, 1, 1, 1) or (reason == "" and Color(0.85, 0.85, 0.85, 1) or Color(0.4, 0.4, 0.4, 0.8)))
                local chip = _UIKit:Colored("#8A8A8A", "잠김")
                if nlv >= nd.maxLv then chip = _UIKit:Colored("#F4ED83", "완료")
                elseif book:CanLearn(nid, st.Level, st.SkillPoints) == "" then chip = _UIKit:Colored("#7CFF7A", "+1")
                elseif reason == "" then chip = _UIKit:Colored("#B8B0A0", "포인트\n부족") end
                _UIKit:SetText(path .. "/Chip", chip)
            end
        end
    end

    method string StatLine(SkillBook book, PlayerStats st, string id)
        -- 아코디언 효과 줄: 지금(배우면) → 다음 랭크, 마나·재사용 (장비 스킬 레벨 포함)
        local def = _SkillData:Get(id)
        if def == nil then return "" end
        local level = book:GetLevel(id)
        local gear = level > 0 and st:GetSkillLevelBonus(id, def.tree) or 0
        local current = book:GetRankSummary(id, math.max(1, level) + gear)
        local line = ""
        if current ~= "" then
            line = (level == 0 and "배우면: " or "지금: ") .. current
            if level > 0 and level < def.maxLv then
                local nextRank = book:GetRankSummary(id, level + 1 + gear)
                line = line .. "\n" .. (nextRank == current and "다음 랭크: 효과 동일" or ("다음 랭크: " .. _UIKit:Colored("#7CFF7A", nextRank)))
            end
        end
        if def.kind == "active" or def.kind == "curse" then
            local lv = math.max(1, level)
            local cost = "마나 " .. tostring(math.floor(book:GetManaCost(id, lv)))
            local cd = book:SkillCooldown(id, lv)
            if cd > 0 then cost = cost .. string.format(" · 재사용 %.2f초", cd * st:GetCastCooldownMult()) end
            line = line .. _UIKit:Colored("#C9BFA8", (line ~= "" and "   · " or "") .. cost)
        end
        if gear > 0 then line = line .. _UIKit:Colored("#7CFF7A", "   · 장비 +" .. tostring(gear)) end
        return line
    end

    @ExecSpace("ClientOnly")
    method void RenderLearnButton(SkillBook book, PlayerStats st)
        -- 버튼 글자가 지금 고른 것에 맞게: 배우기 +1 / 레벨 업 +1 / 강화 +1. 못 찍으면 흐리게 (이유는 왼쪽 설명)
        local id = self.Selected ~= "" and self.Selected or self.SelMain
        local def = _SkillData:Get(id)
        local label = "습득 +1"
        if def ~= nil then
            if def.kind == "node" then label = "강화 +1"
            elseif book:GetLevel(id) > 0 then label = "레벨 업 +1"
            else label = "배우기 +1" end
        end
        local ok = def ~= nil and book:CanLearn(id, st.Level, st.SkillPoints) == ""
        _UIKit:SetText(self.Win .. "/BtnLearn", ok and label or _UIKit:Colored("#8A8A8A", label))
        _UIKit:SetColor(self.Win .. "/BtnLearn", ok and Color(1, 1, 1, 1) or Color(0.55, 0.55, 0.55, 1))
    end

    method string Describe(SkillBook book, PlayerStats st)
        -- 고른 메인/강화의 지금·다음 효과, 마나·재사용, 배울 수 있는지(아니면 이유)
        if self.Selected == "" then return "스킬 카드나 카드 아래 「스킬 강화」 칸을 누르면 여기에 효과가 나온다. 고른 것을 한 번 더 누르거나 오른쪽 아래 버튼으로 +1." end
        local def = _SkillData:Get(self.Selected)
        if def == nil then return "다시 고르세요." end
        local reason = book:CanLearn(self.Selected, st.Level, st.SkillPoints)
        local level = book:GetLevel(self.Selected)
        local isNode = def.kind == "node"
        local cap = book:RankCap(self.Selected, st.Level)
        local head = def.name .. "  " .. tostring(level) .. "/" .. tostring(isNode and def.maxLv or cap)
        if not isNode and cap < def.maxLv then head = head .. _UIKit:Colored("#8C99B4", "  (지금 상한 " .. tostring(cap) .. " · " .. tostring(cap + 1) .. "랭크는 Lv" .. tostring(book:NextRankLevel(self.Selected, cap + 1)) .. "부터 · 최대 " .. tostring(def.maxLv) .. ")") end
        -- 장비 스킬 레벨(모든·계열·단일)은 배운 메인 스킬의 효과에만 더한다 (docs/design/19)
        local gear = 0
        if not isNode and level > 0 then gear = st:GetSkillLevelBonus(self.Selected, def.tree) end
        if gear > 0 then head = head .. _UIKit:Colored("#7CFF7A", "  장비 +" .. tostring(gear) .. " → 효과 " .. tostring(level + gear) .. "랭크") end
        local growth = ""
        local current = book:GetRankSummary(self.Selected, math.max(1, level) + gear)
        if current ~= "" then
            growth = "\n" .. (level == 0 and "배우면: " or "지금: ") .. current
            if level > 0 and level < def.maxLv then
                local nextRank = book:GetRankSummary(self.Selected, level + 1 + gear)
                growth = growth .. "   " .. (nextRank == current and "다음: 효과 동일" or ("다음: " .. _UIKit:Colored("#7CFF7A", nextRank)))
            end
        elseif isNode then
            growth = "\n" .. def.desc
        end
        local mana = ""
        if def.kind == "active" or def.kind == "curse" then
            local lv = math.max(1, level)
            mana = "\n마나 " .. tostring(math.floor(book:GetManaCost(self.Selected, lv)))
            local cd = book:SkillCooldown(self.Selected, lv)
            if cd > 0 then mana = mana .. string.format(" · 재사용 %.2f초", cd * st:GetCastCooldownMult()) end
        end
        local learn = _UIKit:Colored("#AACCAA", (isNode and "강화할 수 있음" or "배울 수 있음") .. " · 한 번 더 누르거나 오른쪽 아래 버튼으로 +1")
        if reason ~= "" then learn = _UIKit:Colored("#FF8888", reason) end
        return head .. growth .. mana .. "\n" .. learn
    end

    method string GearLevelKey(PlayerStats st)
        -- 장비 스킬 레벨·저주 수치가 바뀌면 다시 그린다
        return tostring(st.BonusAllSkills) .. tostring(st.BonusTreeCommand) .. tostring(st.BonusTreeSoul) .. tostring(st.BonusTreeCurse) .. st.BonusSkillLv .. "#" .. tostring(st.BonusCurseDur) .. "#" .. tostring(st.BonusCurseEff) .. "#" .. tostring(st.BonusSpellDmg)
    end

    method table Trees()
        return { "command", "soul", "curse", "move" }
    end

    method table MainsOf(string tree)
        -- 그 트리의 메인 스킬 (해금 레벨 순)
        local list = {}
        for _, id in ipairs(_SkillData:Mains()) do
            if _SkillData:Get(id).tree == tree then table.insert(list, id) end
        end
        return list
    end

    method integer TabIndex(string tree)
        for i, t in ipairs(self:Trees()) do if t == tree then return i end end
        return 1
    end

    @ExecSpace("ClientOnly")
    method void SetTab(string tree)
        -- 탭을 바꾸면 그 트리의 첫 스킬을 오른쪽에 보인다
        if tree == self.Tab then return end
        self.Tab = tree
        local mains = self:MainsOf(tree)
        self.SelMain = mains[1] or ""
        self.Selected = ""
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void EditSlots()
        -- 스킬 창을 내리고 PC는 스킬 지정 창(A S D F 우클릭 탭)을, 모바일은 패드 칸마다 +를 띄운다
        _UIKit:Close(self.Win)
        if Environment:IsMobilePlatform() then _MobilePad:StartEdit() else _SkillPicker:Open(1) end
    end

    @ExecSpace("ClientOnly")
    method void Pick(string id)
        -- 카드·강화 고르기. 이미 고른 것을 다시 누르면 배울 수 있을 때 +1 (못 배우면 아래 설명의 빨간 사유가 보인다)
        if id == nil or id == "" then return end
        if id == self.Selected then
            ---@type SkillBook
            local book = _UIKit:Comp("script.SkillBook")
            ---@type PlayerStats
            local st = _UIKit:Comp("script.PlayerStats")
            if book ~= nil and st ~= nil and book:CanLearn(id, st.Level, st.SkillPoints) == "" then self:Act(0) end
            return
        end
        self.Selected = id
        local def = _SkillData:Get(id)
        if def ~= nil and def.kind ~= "node" then self.SelMain = id end
        if def ~= nil then self.Tab = def.tree end
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Act(integer slot)
        -- 0 = 습득, 1~4 = A S D F, 5 = 우클릭
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        -- 카드를 따로 누르지 않았어도 오른쪽에 보이는 스킬을 배운다 (10-20 첫 1시간 점검: 설명이 떠 있는데 「습득」이 아무 반응이 없었다)
        if self.Selected == "" then self.Selected = self.SelMain end
        if self.Selected == "" then return end
        if slot == 0 then book:RequestLearn(self.Selected) else book:RequestSetSlot(slot, self.Selected) end
        self.RenderKey = ""
    end

end
