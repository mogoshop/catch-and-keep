-- 스킬 창 (K) — 10-28 V3 「해금 시간선 + 스킬 공방」 (피드백 F4 · 기획서 38 #24-A, 시안 assets/codex-skill-window-mock-v1/V3-pc.png).
--   위 = Lv1→50 해금 시간선: 열 = 메인 스킬이 열리는 레벨, 열마다 그 레벨의 메인 스킬(트리색 테두리) · 지금 레벨 표지 · 「다음 해금」 한 줄.
--     트리를 넘나드는 해금 순서를 지도처럼 보여 준다 (예전 탭 4개 + 카드 격자는 「중구난방」이라는 피드백).
--   아래 = 고른 메인 스킬의 공방: 큰 초상 · 지금/다음 효과 · 랭크 사다리 20칸 · 배우기/스킬 칸에 넣기 · 오른쪽 강화 노드(필요 랭크 열별 · 허브 갈래 선).
--   고른 것을 한 번 더 누르면 바로 +1 (첫 클릭은 설명 보기라 실수로 찍히지 않는다). 메인 스킬 랭크 상한 = 1 + (캐릭터 Lv − 해금 Lv) ÷ 2.
-- 칸 지정: 「스킬 칸에 넣기」 — PC는 스킬 지정 창(A S D F 우클릭 탭), 모바일은 창을 닫고 패드 칸의 +를 눌러 고른다.
-- 혼의 제물 3택 카드(V4, 2차)는 SkillOffer가 맡는다.
@Logic
script SkillWindow extends Logic

    property string Win = "SkillWin"
    property string Selected = ""           -- 고른 메인 스킬 또는 강화 노드
    property string SelMain = ""            -- 공방에 보이는 메인 스킬
    property any Columns = nil              -- 시간선 열: { row = 해금 레벨, ids = { 메인 스킬 id … } }
    property any SlotIds = nil              -- "c:r" → 메인 스킬 id (지금 쪽의 칸)
    property table NodeIds = {}             -- 강화 칸 번호 → 노드 id
    property integer Page = 1               -- 모바일 시간선 쪽 (PC는 한 판)
    property string Tab = "command"         -- (예전 탭 — 상황 안내 호환용, 고른 스킬의 트리)
    property string RenderKey = ""
    property integer TimerId = 0
    property integer MaxCols = 26           -- 빌더가 만든 열 수 (tools/build/ui.cjs)
    property table PipBase = {}             -- 랭크 점 번호 → 20 크기일 때 자리 (단계 칸을 26으로 키울 때 가운데 맞춤 · 44-7)
    -- 모바일 시간선 (QR1629-OBS-02 · iPad에서 첫 줄 랭크·「배우기」 글이 둘째 줄 칸 테두리에 덮였다 — 줄 간격 96 < 칸 88 + 글 2+16 + 테두리 4)
    --   칸 88(손가락) 아래 상태 글 16을 두고 다음 줄 테두리(칸 + 4)까지 2를 띄운다 → 줄 간격 112. 판(356) 안에 두 줄까지라
    --   한 레벨에 메인 스킬이 셋인 열(Lv18)은 모바일에서 같은 레벨의 이어진 열로 나눈다 (해금 순서 그대로). 진행 막대는 둘째 줄 글 아래로.
    --   PC 배치(칸 48 · 줄 68 · 막대 −304 · 한 열 셋)는 그대로. tools/check_mobile_layout.cjs가 이 숫자를 읽어 겹침을 잰다
    property integer MobileRows = 2         -- 모바일 열 하나의 칸 수 (넘치면 이어진 열)
    property integer MobileStepY = 112      -- 모바일 줄 간격 (칸 위끼리)
    property integer MobileBarY = -318      -- 모바일 진행 막대 가운데 (판 위에서) · PC는 빌더 자리 −304
    -- 모바일 넘김 단추 자리 (RB-OBS-04): 판 양끝 TL/Prev(x 24~68)·TL/NextPage(x 1230~1274)는 쪽 넘김 전용 칸으로 비우고,
    --   열은 그 사이에만 — 첫 열 왼쪽 100(첫 칸 테두리 78~174 · Prev와 10 띄움) · 열 간격 130(9열째 테두리 끝 1214 · Next와 16) · 막대 100~1270(판 안쪽 1274 안).
    --   예전 44·134는 첫 칸 테두리(22~118)가 Prev(24~68)와 겹쳐 그림·누르는 자리가 함께 겹쳤다. PC(44 · 한 판 · 넘김 단추 꺼짐)는 그대로
    property integer MobileX0 = 100         -- 모바일 첫 열 왼쪽 (판 위에서) · PC는 44
    property any MobileColumns = nil        -- DisplayColumns 모바일 결과 (BuildColumns처럼 한 번만 만든다)
    property integer StatFont = 17          -- 효과 줄 글자 크기 (빌더 WS/Stat max_size와 같다) — 화면 폭을 잴 기준
    property string FormKind = ""           -- 편성 조작 칸(WS/Form)이 다루는 종류: skeleton · mage · shard(모바일 골편 홀드 반복) · "" (숨김)
    property string FormForm = ""           -- 편성 조작 칸 ± 대상 변이 (변이 노드를 골랐을 때만)
    property string ShowGiant = ""          -- 46-5 뼈 의식 공방에 펼친 거인 노드 줄 (basic·shield·greatsword·twin·mage · "" = 깃발 → 지금 무리 → 기본)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for c = 1, self.MaxCols do
            for r = 1, 3 do
                local key = tostring(c) .. ":" .. tostring(r)
                _UIKit:Connect(self.Win .. "/TL/C" .. tostring(c) .. "/S" .. tostring(r), function() self:Pick(self.SlotIds ~= nil and self.SlotIds[key] or "") end)
            end
        end
        _UIKit:Connect(self.Win .. "/TL/Prev", function() self:Flip(-1) end)
        _UIKit:Connect(self.Win .. "/TL/NextPage", function() self:Flip(1) end)
        for i = 1, 8 do
            local index = i
            _UIKit:Connect(self.Win .. "/WS/N" .. tostring(i), function() self:Pick(self.NodeIds[index]) end)
        end
        _UIKit:Connect(self.Win .. "/BtnLearn", function() self:Act(0) end)
        -- I03 단계 2 희망 편성 · I04 골편 홀드 반복 설정 (공방 강화 트리 오른쪽 아래 WS/Form)
        _UIKit:Connect(self.Win .. "/WS/Form/Mode", function() self:FormMode() end)
        _UIKit:Connect(self.Win .. "/WS/Form/Minus", function() self:FormStep(-1) end)
        _UIKit:Connect(self.Win .. "/WS/Form/Plus", function() self:FormStep(1) end)
        -- 46-6 거인 깃발 줄 (뼈 의식 공방): 칸 1~5 = fallback 순서 거인 · 6 = 안 고름
        for i = 1, 6 do
            local index = i
            _UIKit:Connect(self.Win .. "/WS/Banner/K" .. tostring(i), function() self:PickBanner(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnEdit", function() self:EditSlots() end)
        _UIKit:Connect(self.Win .. "/BtnReset", function()
            ---@type SkillBook
            local book = _UIKit:Comp("script.SkillBook")
            ---@type PlayerStats
            local st = _UIKit:Comp("script.PlayerStats")
            if book == nil or st == nil then return end
            local cost = book:RespecCost(st.Level)
            local note = cost == 0 and ("무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)") or (tostring(cost) .. " 골드 · 마을의 사제 오렌·카라반 대장 무하드 곁에서")
            _ConfirmDialog:Show("스킬 초기화", "배운 스킬·강화를 모두 돌려받고 스킬 칸도 비웁니다.\n" .. note, "초기화", function() book:RequestRespec("skills") end)
        end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    method Color TreeColor(string tree)
        -- 트리색 (테두리·선·범례): 소환 청록 · 영혼 보라 · 저주 붉은 · 이동 하늘
        if tree == "soul" then return Color(0.69, 0.55, 1, 1) end
        if tree == "curse" then return Color(1, 0.48, 0.42, 1) end
        if tree == "move" then return Color(0.55, 0.78, 1, 1) end
        return Color(0.44, 0.85, 0.76, 1)
    end

    method string TreeHex(string tree)
        if tree == "soul" then return "#B08CFF" end
        if tree == "curse" then return "#FF7A6A" end
        if tree == "move" then return "#8CC8FF" end
        return "#6FD9C2"
    end

    method any BuildColumns()
        -- 메인 스킬을 해금 레벨(row)별 열로 (지금 23열 · 한 열 최대 3개)
        if self.Columns ~= nil then return self.Columns end
        local cols, byRow = {}, {}
        for _, id in ipairs(_SkillData:Mains()) do
            local row = math.floor(_SkillData:Get(id).row)
            if byRow[row] == nil then
                byRow[row] = { row = row, ids = {} }
                table.insert(cols, byRow[row])
            end
            if #byRow[row].ids < 3 then table.insert(byRow[row].ids, id) end
        end
        table.sort(cols, function(a, b) return a.row < b.row end)
        self.Columns = cols
        return cols
    end

    method any SplitColumns(any cols, integer rows)
        -- 열마다 칸을 rows개까지만 두고 남는 칸은 같은 레벨의 이어진 열(cont)로 (순서 그대로 · 칸이 빠지거나 겹치지 않는다)
        local out = {}
        for _, col in ipairs(cols) do
            local i = 1
            while i <= #col.ids do
                local part = { row = col.row, ids = {}, cont = i > 1 }
                for k = i, math.min(#col.ids, i + rows - 1) do table.insert(part.ids, col.ids[k]) end
                table.insert(out, part)
                i = i + rows
            end
        end
        return out
    end

    method any DisplayColumns()
        -- 시간선에 그리는 열: PC는 BuildColumns 그대로(한 열 셋), 모바일은 한 열 MobileRows칸 (QR1629-OBS-02)
        if not Environment:IsMobilePlatform() then return self:BuildColumns() end
        if self.MobileColumns == nil then self.MobileColumns = self:SplitColumns(self:BuildColumns(), self.MobileRows) end
        return self.MobileColumns
    end

    method integer PageSize()
        -- 한 쪽에 보이는 열 수: PC는 전부(23), 모바일은 손가락 크기 칸(88)으로 9열씩
        if Environment:IsMobilePlatform() then return 9 end
        return self.MaxCols
    end

    @ExecSpace("ClientOnly")
    method void Flip(integer dir)
        local pages = math.max(1, math.ceil(#self:DisplayColumns() / self:PageSize()))
        self.Page = math.max(1, math.min(pages, self.Page + dir))
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        if not _UIKit:IsOpen(self.Win) then
            self.RenderKey = ""
            return
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if book == nil or st == nil then return end
        local key = book.SkillDigest .. "#" .. tostring(st.SkillPoints) .. "#" .. tostring(st.Level) .. "#" .. self.Selected .. "#" .. self.SelMain .. "#" .. tostring(self.Page) .. "#" .. tostring(st:GetSpellPowerPct()) .. "#" .. tostring(st:GetCastCooldownMult()) .. "#" .. tostring(st:GetMinionPct()) .. "#" .. tostring(st.BonusDeploy) .. "#" .. tostring(st.BonusShadowCap) .. "#" .. tostring(st.Gold) .. "#" .. self:GearLevelKey(st)
        ---@type ShadowCommander
        local cmd = _UIKit:Comp("script.ShadowCommander")
        if cmd ~= nil then key = key .. "#" .. cmd.UndeadRoster end   -- 편성이 바뀌면 편성 줄을 다시 그린다 (I03)
        key = key .. "#" .. book.FormHope .. "#" .. tostring(book.ShardHold)   -- 희망 편성·골편 홀드 설정을 바꾸면 소환 없이도 다시 그린다 (B-R05)
        key = key .. "#" .. book.RiteBanner .. "#" .. self.ShowGiant .. "#" .. tostring(st.MaxDifficulty)   -- 46-5·46-6 거인 깃발·펼친 거인·악몽 해금
        if key == self.RenderKey then return end
        self.RenderKey = key
        -- 머리 줄: 남은 포인트 · 숙련(배운 스킬·강화 수) · 트리색 범례 · 초기화
        local learned, total = 0, 0
        for id, _ in pairs(_SkillData.Skills) do
            total = total + 1
            if book:GetLevel(id) > 0 then learned = learned + 1 end
        end
        _UIKit:SetText(self.Win .. "/Points", "남은 포인트 " .. _UIKit:Colored("#FFFFFF", tostring(st.SkillPoints)) .. "   " .. _UIKit:Colored("#A8A090", "숙련 " .. tostring(learned) .. "/" .. tostring(total)))
        local legend = {}
        for _, tree in ipairs(self:Trees()) do table.insert(legend, _UIKit:Colored(self:TreeHex(tree), "■ " .. _SkillData:TreeName(tree))) end
        _UIKit:SetText(self.Win .. "/Legend", table.concat(legend, "   "))
        local cost = book:RespecCost(st.Level)
        _UIKit:SetText(self.Win .. "/BtnReset", cost == 0 and ("초기화 · 무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)") or ("초기화 · " .. tostring(cost) .. " 골드"))
        if self.SelMain == "" then self.SelMain = self:FirstLearnable(book, st) end
        self:RenderTimeline(book, st)
        self:RenderWorkshop(book, st)
        self:RenderLearnButton(book, st)
    end

    @ExecSpace("ClientOnly")
    method string FirstLearnable(SkillBook book, PlayerStats st)
        -- 처음 열 때 공방에 보일 스킬: 지금 배울 수 있는 첫 메인, 없으면 첫 메인
        for _, id in ipairs(_SkillData:Mains()) do
            if book:CanLearn(id, st.Level, math.max(1, st.SkillPoints)) == "" then return id end
        end
        return _SkillData:Mains()[1] or ""
    end

    @ExecSpace("ClientOnly")
    method void RenderTimeline(SkillBook book, PlayerStats st)
        -- 해금 시간선: 열 위치·크기(플랫폼별) · 칸 그림·테두리·상태 · 지금 레벨 표지 · 다음 해금 줄
        local cols = self:DisplayColumns()
        local mobile = Environment:IsMobilePlatform()
        local per = self:PageSize()
        local pages = math.max(1, math.ceil(#cols / per))
        self.Page = math.max(1, math.min(pages, self.Page))
        local first = (self.Page - 1) * per + 1
        local shown = math.min(per, #cols - first + 1)
        local width = 1210
        local colW = mobile and 130 or math.floor(width / math.max(1, shown))   -- 모바일 130: 넘김 단추 칸을 비운 사이에 9열 (RB-OBS-04)
        local btn = mobile and 88 or 48
        local stepY = mobile and self.MobileStepY or 68
        local x0 = mobile and self.MobileX0 or 44
        _UIKit:SetEnabled(self.Win .. "/TL/Prev", pages > 1)
        _UIKit:SetEnabled(self.Win .. "/TL/NextPage", pages > 1)
        self.SlotIds = {}
        local base = self.Win .. "/TL/C"
        for c = 1, self.MaxCols do
            local col = cols[first + c - 1]
            local path = base .. tostring(c)
            local on = c <= shown and col ~= nil
            _UIKit:SetEnabled(path, on)
            if on then
                _UIKit:SetPos(path, Vector2(x0 + (c - 1) * colW, -68))   -- 판 머리 줄(36~60) 아래 (빌더 tools/build/ui.cjs와 같은 숫자)
                local reached = st.Level >= col.row
                _UIKit:SetText(path .. "/Lv", _UIKit:Colored(reached and "#E6DCC6" or "#7A7468", "Lv" .. tostring(col.row)))
                for r = 1, 3 do
                    local id = col.ids[r]
                    local s = path .. "/S" .. tostring(r)
                    _UIKit:SetEnabled(s, id ~= nil)
                    if id ~= nil then
                        self.SlotIds[tostring(c) .. ":" .. tostring(r)] = id
                        self:SizeSlot(s, btn, mobile)
                        _UIKit:SetPos(s, Vector2(0, -20 - (r - 1) * stepY))
                        local def = _SkillData:Get(id)
                        local lv = book:GetLevel(id)
                        local cap = book:RankCap(id, st.Level)
                        _UIKit:SetIcon(s .. "/Icon", def.icon)
                        _UIKit:SetColor(s .. "/Icon", lv > 0 and Color(1, 1, 1, 1) or (reached and Color(0.78, 0.78, 0.78, 1) or Color(0.32, 0.32, 0.34, 0.85)))
                        -- 칸 테두리 4상태 (코덱스 skill-window-v3 · PC 64 / 모바일 96): 고름(금) · 잠김 · 배울 수 있음 · 그 밖(트리색으로 물들인 흰 테두리)
                        local tc = self:TreeColor(def.tree)
                        local key = "sk_tl_node_frame_"
                        if id == self.SelMain then key = "sk_tl_node_selected_"
                        elseif not reached then key = "sk_tl_node_locked_"
                        elseif lv == 0 and book:CanLearn(id, st.Level, math.max(1, st.SkillPoints)) == "" then key = "sk_tl_node_learnable_" end
                        _UIKit:SetIcon(s .. "/Ring", _GameData:GetUiIcon(key .. (mobile and "96" or "64")))
                        _UIKit:SetColor(s .. "/Ring", key == "sk_tl_node_frame_" and tc or Color(1, 1, 1, 1))
                        local state
                        if not reached then state = _UIKit:Colored("#8C99B4", "Lv" .. tostring(col.row))
                        elseif lv > 0 then state = _UIKit:Colored("#F4ED83", tostring(lv) .. "/" .. tostring(cap))
                        elseif book:CanLearn(id, st.Level, math.max(1, st.SkillPoints)) == "" then state = _UIKit:Colored("#7CFF7A", "배우기")
                        else state = _UIKit:Colored("#A8A090", "0/" .. tostring(cap)) end
                        _UIKit:SetText(s .. "/State", state)
                    end
                end
            end
        end
        -- 지금 레벨 표지: 지금 레벨이 들어갈 열 사이 위치 (열 가운데 기준 보간)
        local markX = 0
        local lastX, lastRow = 0, 0
        for c = 1, shown do
            local col = cols[first + c - 1]
            local cx = (c - 1) * colW + colW / 2
            if st.Level >= col.row then markX = cx lastX = cx lastRow = col.row
            elseif markX == lastX and c > 1 then
                local prevCol = cols[first + c - 2]
                local t = (st.Level - prevCol.row) / math.max(1, col.row - prevCol.row)
                markX = lastX + (cx - lastX) * math.max(0, math.min(1, t))
                break
            else break end
        end
        local barW = math.min(width, shown * colW)
        _UIKit:SetPos(self.Win .. "/TL/Bar", Vector2(x0, mobile and self.MobileBarY or -304))   -- 모바일은 둘째 줄 상태 글 아래 (QR1629-OBS-02)
        local bar = _UIKit:Get(self.Win .. "/TL/Bar")
        if isvalid(bar) then bar.UITransformComponent.RectSize = Vector2(barW, 16) end
        _UIKit:SetBar(self.Win .. "/TL/Bar/Fill", barW > 0 and markX / barW or 0)   -- 업적 막대 그림 (10-28 민짜 막대 교체)
        -- 지금 선: 막대에서 열 위(판 위에서 68)까지 236 · 불꽃 표지는 막대 위 (판 밖 머리 줄의 범례를 덮지 않게, 10-28)
        _UIKit:SetPos(self.Win .. "/TL/Bar/Mark", Vector2(markX, 116))
        _UIKit:SetPos(self.Win .. "/TL/Bar/Now", Vector2(markX + 50, 0))   -- 표지 오른쪽 막대 위
        _UIKit:SetText(self.Win .. "/TL/Bar/Now", "Lv" .. tostring(st.Level))
        self:RenderStageMarks(book, st, cols, first, shown, colW)
        -- 다음 해금
        local nextLine = "모든 스킬이 열렸습니다"
        for _, col in ipairs(self:BuildColumns()) do
            if col.row > st.Level then
                local names = {}
                for _, id in ipairs(col.ids) do table.insert(names, _UIKit:Colored(self:TreeHex(_SkillData:Get(id).tree), _SkillData:Get(id).name)) end
                nextLine = "다음 해금: Lv" .. tostring(col.row) .. " " .. table.concat(names, " · ") .. " — " .. tostring(col.row - st.Level) .. "레벨 남음"
                break
            end
        end
        _UIKit:SetText(self.Win .. "/TL/Next", nextLine)
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] timeline page=%d/%d cols=%d shown=%d step=%d btn=%d barY=%d", self.Page, pages, #cols, shown, stepY, btn, mobile and self.MobileBarY or -304)) end
    end

    @ExecSpace("ClientOnly")
    method void SizeSlot(string s, integer btn, boolean mobile)
        -- 칸 크기: PC 48 / 모바일 88 (손가락)
        local e = _UIKit:Get(s)
        if not isvalid(e) or math.abs(e.UITransformComponent.RectSize.x - btn) < 0.5 then return end
        e.UITransformComponent.RectSize = Vector2(btn, btn)
        local ring = _UIKit:Get(s .. "/Ring")
        if isvalid(ring) then ring.UITransformComponent.RectSize = Vector2(btn + 8, btn + 8) end
        local icon = _UIKit:Get(s .. "/Icon")
        if isvalid(icon) then icon.UITransformComponent.RectSize = Vector2(btn - 8, btn - 8) end
    end

    @ExecSpace("ClientOnly")
    method void RenderWorkshop(SkillBook book, PlayerStats st)
        -- 공방: 고른 메인 스킬 초상·이름·트리/랭크·설명·지금/다음 · 랭크 사다리 · 강화 노드
        local def = _SkillData:Get(self.SelMain)
        if def == nil then return end
        self.Tab = def.tree
        local ws = self.Win .. "/WS"
        local lv = book:GetLevel(self.SelMain)
        local cap = book:RankCap(self.SelMain, st.Level)
        local picked = _SkillData:Get(self.Selected)
        local detail = picked ~= nil and picked.kind == "node" and picked.parent == self.SelMain and picked or def
        local detailId = detail == def and self.SelMain or self.Selected
        local detailLv = book:GetLevel(detailId)
        _UIKit:SetIcon(ws .. "/Portrait/Icon", detail.icon)
        _UIKit:SetColor(ws .. "/Portrait/Icon", detailLv > 0 and Color(1, 1, 1, 1) or Color(0.7, 0.7, 0.7, 1))
        _UIKit:SetText(ws .. "/Name", detail.name)
        local info = _UIKit:Colored(self:TreeHex(def.tree), _SkillData:TreeName(def.tree)) .. " · "
        if detail.kind == "node" then info = info .. def.name .. " 강화 " .. tostring(detailLv) .. "/" .. tostring(detail.maxLv)
        elseif st.Level < def.row then info = info .. _UIKit:Colored("#8C99B4", "Lv" .. tostring(def.row) .. "에 열림")
        else info = info .. "랭크 " .. tostring(lv) .. "/" .. tostring(cap) .. "  (최대 " .. tostring(def.maxLv) .. ")" end
        _UIKit:SetText(ws .. "/Info", info)
        local hint = book:UseHint(detailId)
        _UIKit:SetText(ws .. "/Desc", detail.desc .. (hint ~= "" and ("\n" .. hint) or ""))
        -- 효과 줄은 「 · 」 경계에서만 접는다 (QR1629-OBS-01: 엔진 줄바꿈은 한글을 글자 단위로 끊어 「마 / 나 8」이 됐다). 폭은 그 칸 글꼴로 잰다
        local statE = _UIKit:Get(ws .. "/Stat")
        local statT = isvalid(statE) and statE.TextGUIRendererComponent or nil
        local statW = isvalid(statE) and statE.UITransformComponent.RectSize.x or 494
        local stat = self:WrapLines(self:StatLine(book, st, detailId), statW - 6, statT)
        _UIKit:SetText(ws .. "/Stat", stat)
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] skill stat %s lines=%d w=%d", detailId, self:LineCount(stat), math.floor(statW))) end
        -- 랭크 사다리 20칸: 찍음(금) · 지금 상한까지(밝은 빈칸) · 상한 밖(어둠)
        -- 랭크 점 3상태 (코덱스 skill-window-v3): 찍음 · 지금 상한까지 빈칸 · 상한 밖(잠긴 점) — 최대 랭크 밖은 감춘다
        -- 44-7 랭크 단계: 단계가 바뀌는 칸(투사체 5·8·12 등 — SkillBook.StageRanks)과 20랭크 「완성」 칸은 큰 점 (코덱스 H-10 sk_rank_pip_stage(_on) 그림이 오면 그 그림, 그 전엔 같은 점을 금빛으로)
        local stages = book:StageRanks(self.SelMain)
        local stageOn = _GameData:GetUiIcon("sk_rank_pip_stage_on")
        local stageOff = _GameData:GetUiIcon("sk_rank_pip_stage")
        for i = 1, 20 do
            local key = ""
            if i <= def.maxLv then
                if i <= lv then key = "sk_rank_pip_filled" elseif i <= cap then key = "sk_rank_pip_empty" else key = "sk_rank_pip_capped" end
            end
            local path = ws .. "/Pip" .. tostring(i)
            local icon = key == "" and "" or _GameData:GetUiIcon(key)
            local tint = Color(1, 1, 1, 1)
            local big = key ~= "" and (stages[i] ~= nil or (i == 20 and def.maxLv >= 20))
            if big then
                if i <= lv then
                    if stageOn ~= "" then icon = stageOn else tint = Color(1, 0.84, 0.4, 1) end
                else
                    if stageOff ~= "" then icon = stageOff else tint = i <= cap and Color(1, 0.9, 0.62, 1) or Color(0.72, 0.62, 0.44, 1) end
                end
            end
            _UIKit:SetIcon(path, icon)
            _UIKit:SetColor(path, tint)
            self:SizePip(path, i, big and 26 or 20)
        end
        -- 사다리 아래 줄: 20랭크 「완성」 → 다음 단계까지 남은 랭크 → (단계가 없으면) 다음 랭크가 열리는 레벨
        local note = ""
        local nextStage = book:NextStage(self.SelMain)
        local complete = book:IsComplete(self.SelMain, lv)
        if complete then note = _UIKit:Colored("#F4D27A", "완성")
        elseif nextStage ~= nil then note = _UIKit:Colored("#F4D27A", "다음 단계 · " .. nextStage.text .. "까지 " .. tostring(nextStage.left) .. "랭크")
        elseif st.Level >= def.row and cap < def.maxLv then note = "랭크 " .. tostring(cap + 1) .. " · Lv" .. tostring(book:NextRankLevel(self.SelMain, cap + 1)) .. "부터" end   -- 숫자 뒤 조사 없이 (「랭크 2은」 M18-OBS-03)
        _UIKit:SetText(ws .. "/RankNote", note)
        -- 20랭크 완성: 초상 테두리를 금빛으로 (코덱스 H-10 sk_icon_frame_complete가 오면 그 테) — 그 밖은 트리색
        local frameDone = _GameData:GetUiIcon("sk_icon_frame_complete")
        if complete and frameDone ~= "" then
            _UIKit:SetIcon(ws .. "/Portrait/Rim", frameDone)
            _UIKit:SetColor(ws .. "/Portrait/Rim", Color(1, 1, 1, 1))
        else
            _UIKit:SetIcon(ws .. "/Portrait/Rim", _GameData:GetUiIcon("sk_portrait_frame"))
            _UIKit:SetColor(ws .. "/Portrait/Rim", complete and Color(1, 0.82, 0.36, 1) or self:TreeColor(def.tree))
        end
        if not Environment:IsPublishedPlay() then
            local marks = {}
            for r, text in pairs(stages) do table.insert(marks, tostring(r) .. "=" .. text) end
            table.sort(marks)
            log(string.format("[VRF] skill ladder %s lv=%d stages=%s next=%s complete=%s", self.SelMain, lv, table.concat(marks, ","), nextStage ~= nil and (nextStage.text .. "/" .. tostring(nextStage.left)) or "-", tostring(complete)))
        end
        local target = self.Selected ~= "" and self.Selected or self.SelMain
        local reason = book:CanLearn(target, st.Level, st.SkillPoints)
        _UIKit:SetText(ws .. "/Reason", reason)
        self:RenderNodes(book, st, def)
        self:RenderForm(book, detailId)
        self:RenderBanner(book, st)
    end

    @ExecSpace("ClientOnly")
    method void RenderBanner(SkillBook book, PlayerStats st)
        -- 46-6 거인 깃발 줄 (§5-3 · §10-2 · 결정 8 V1 — 노말에서도 보임): 「동률이면」 + [방패][대검][쌍칼][마법사][기본][안 고름].
        --   고른 칸 = 금테(깃발) · 펼친 거인 = 트리색 테 · 누르면 깃발을 바꾸고 그 거인의 강화 노드를 펼친다 (깃발은 동률 최다 안에서만 이긴다 — GiantPlan)
        local root = self.Win .. "/WS/Banner"
        local on = self.SelMain == "bone_rite"
        _UIKit:SetEnabled(root, on)
        if not on then return end
        local kinds = _UndeadSystem:GiantFallback()
        local shown = self:ShownGiant(book)
        local unlocked = book:RiteGiantUnlocked()
        _UIKit:SetText(root .. "/Head", (unlocked and "" or "거인 악몽부터 · ") .. "동률이면")
        for i = 1, 6 do
            local c = root .. "/K" .. tostring(i)
            local kind = kinds[i] or ""
            local chosen = book.RiteBanner == kind
            _UIKit:SetIcon(c .. "/Icon", kind ~= "" and _GameData:GetUiIcon("ui_giant_" .. kind) or "")
            _UIKit:SetEnabled(c .. "/Icon", kind ~= "")
            _UIKit:SetColor(c .. "/Icon", unlocked and Color(1, 1, 1, 1) or Color(0.55, 0.5, 0.6, 0.9))
            _UIKit:SetText(c .. "/Label", kind ~= "" and _HudMain:GiantShort(kind) or "안 고름")
            local key = "sk_ws_node_frame_empty"
            local ring = Color(0.7, 0.7, 0.7, 0.8)
            if chosen then key, ring = "sk_ws_node_frame_max", Color(1, 1, 1, 1)
            elseif kind ~= "" and kind == shown then key, ring = "sk_ws_node_frame_learned", self:TreeColor("command") end
            _UIKit:SetIcon(c .. "/Rim", _GameData:GetUiIcon(key))
            _UIKit:SetColor(c .. "/Rim", ring)
        end
        if not Environment:IsPublishedPlay() then log("[VRF] rite banner ui banner=" .. (book.RiteBanner == "" and "none" or book.RiteBanner) .. " shown=" .. shown .. " unlocked=" .. tostring(unlocked)) end
    end

    @ExecSpace("ClientOnly")
    method void PickBanner(integer index)
        -- 깃발 칸을 눌렀다: 깃발 저장(서버 RequestRiteBanner · 포인트 없음) + 그 거인 노드 펼치기. 「안 고름」이면 깃발만 끈다
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        local kind = _UndeadSystem:GiantFallback()[index] or ""
        book:RequestRiteBanner(kind)
        self.ShowGiant = kind
        if book:GiantOfNode(self.Selected) ~= "" then self.Selected = self.SelMain end   -- 고른 거인 노드가 펼칠 거인을 정하지 않게
        self.RenderKey = ""
        log("[VRF] rite banner pick kind=" .. (kind == "" and "none" or kind))
    end

    @ExecSpace("ClientOnly")
    method void RenderForm(SkillBook book, string detailId)
        -- 편성 조작 칸 (I03 단계 2 희망 편성 · I04 모바일 골편 홀드 반복 설정) — 새 창 없이 공방 안. 해골 전사·마법사·골편 트리는 강화 노드가 5열 첫 줄까지라
        --   5열 둘째 줄~6열이 빈다 → 그 자리 (tools/build/ui.cjs WS/Form). 다른 트리에서는 숨긴다.
        --   해골 전사·마법사 메인·증원 노드: 「편성: 자동/직접」 + 바꾸기 단추 · 변이 노드: 그 변이 희망 수(직접)·장기 수(자동) + −/+ · 골편(모바일만): 누르고 있으면 반복 켜기/끄기
        --   바꾸면 다음 소환부터 (서 있는 해골은 그대로) — 지금 편성·다음 소환은 효과 칸 편성 줄(SkillBook.RosterLine)이 같은 계획으로 보인다
        local root = self.Win .. "/WS/Form"
        local kind = ""
        if self.SelMain == "raise_skeleton" then kind = "skeleton"
        elseif self.SelMain == "raise_mage" then kind = "mage"
        elseif self.SelMain == "bone_shard" and Environment:IsMobilePlatform() then kind = "shard" end
        if (kind == "skeleton" or kind == "mage") and book:GetLevel(self.SelMain) <= 0 then kind = "" end   -- 배우기 전에는 편성이 없다
        self.FormKind = kind
        self.FormForm = ""
        _UIKit:SetEnabled(root, kind ~= "")
        if kind == "" then return end
        if kind == "shard" then
            _UIKit:SetText(root .. "/Head", "누르고 있으면 반복: " .. (book.ShardHold and "켬" or "끔"))
            _UIKit:SetText(root .. "/Mode", book.ShardHold and "끄기" or "켜기")
            _UIKit:SetEnabled(root .. "/Minus", false)
            _UIKit:SetEnabled(root .. "/Plus", false)
            return
        end
        local p = _UndeadSystem:RosterPreview(book.Entity, kind)
        local nf = _UndeadSystem:NodeForm(detailId)
        local form = nf.kind == kind and nf.form or ""
        self.FormForm = form
        local head = "편성: " .. (p.direct and "직접" or "자동")
        if form ~= "" then
            local short = string.match(_UndeadSystem:FormName(kind, form), "^(%S+)") or form
            if p.direct then head = short .. " 희망 " .. tostring(p.want[form] or 0) .. "/" .. tostring(p.quota[form] or 0)
            else head = short .. " 자동 " .. tostring(p.steady[form] or 0) .. "기" end
        end
        _UIKit:SetText(root .. "/Head", head)
        _UIKit:SetText(root .. "/Mode", p.direct and "자동으로 되돌리기" or "직접 정하기")
        local adjustable = form ~= "" and (p.quota[form] or 0) > 0
        _UIKit:SetEnabled(root .. "/Minus", adjustable)
        _UIKit:SetEnabled(root .. "/Plus", adjustable)
        if not Environment:IsPublishedPlay() then log("[VRF] roster form ui kind=" .. kind .. " form=" .. form .. " head=" .. head .. " next=" .. p.nextForm) end
    end

    @ExecSpace("ClientOnly")
    method void FormMode()
        -- 편성 조작 칸 큰 단추: 해골 = 자동 ↔ 직접 · 골편 = 홀드 반복 켜기/끄기 (판정·저장은 서버 SkillBook)
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil or self.FormKind == "" then return end
        if self.FormKind == "shard" then
            book:RequestShardHold(not book.ShardHold)
            return
        end
        local hope = _UndeadSystem:HopeOf(book.Entity, self.FormKind)
        book:RequestFormMode(self.FormKind, not hope.direct)
    end

    @ExecSpace("ClientOnly")
    method void FormStep(integer delta)
        -- 편성 조작 칸 −/+: 고른 변이의 희망 수 (자동이면 서버가 자동 편성 모습에서 직접으로 바꾼 뒤 조정 · 범위는 서버가 검사)
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil or (self.FormKind ~= "skeleton" and self.FormKind ~= "mage") or self.FormForm == "" then return end
        book:RequestFormHope(self.FormKind, self.FormForm, delta)
    end

    @ExecSpace("ClientOnly")
    method void SizePip(string path, integer i, integer size)
        -- 랭크 점 크기: 보통 20 · 단계·완성 칸 26 (빌더 자리 왼쪽 위 기준이라 커진 만큼 왼쪽 위로 비켜 가운데를 맞춘다)
        local e = _UIKit:Get(path)
        if not isvalid(e) then return end
        local t = e.UITransformComponent
        if self.PipBase[i] == nil then
            local half0 = (t.RectSize.x - 20) * 0.5
            self.PipBase[i] = Vector2(t.anchoredPosition.x + half0, t.anchoredPosition.y - half0)   -- 20 크기일 때의 자리
        end
        if math.abs(t.RectSize.x - size) < 0.5 then return end
        local base = self.PipBase[i]
        local half = (size - 20) * 0.5
        t.RectSize = Vector2(size, size)
        t.anchoredPosition = Vector2(base.x - half, base.y + half)
    end

    method number LevelX(any cols, integer first, integer shown, number colW, number level)
        -- 시간선 막대 위 x: 그 캐릭터 레벨이 들어갈 열 사이 (열 가운데 기준 보간 — 지금 레벨 표지와 같은 규칙). 보이는 열 밖이면 -1
        local lastX, lastRow = -1, 0
        for c = 1, shown do
            local col = cols[first + c - 1]
            if col == nil then return -1 end
            local cx = (c - 1) * colW + colW / 2
            if level <= col.row then
                if level == col.row then return cx end
                if lastX < 0 then return -1 end
                return lastX + (cx - lastX) * (level - lastRow) / math.max(1, col.row - lastRow)
            end
            lastX, lastRow = cx, col.row
        end
        return -1
    end

    @ExecSpace("ClientOnly")
    method void RenderStageMarks(SkillBook book, PlayerStats st, any cols, integer first, integer shown, number colW)
        -- 44-7 시간선 단계 표지: 고른 메인 스킬의 단계(SkillBook.RankStages)가 열리는 캐릭터 레벨(해금 Lv + 2 × (랭크 − 1))에 막대 위 작은 점.
        --   닿은 단계는 금빛 · 아직은 흐리게. 보이는 쪽 밖이거나 단계가 없으면 숨긴다 (빌더 TL/Bar/St1~4)
        local def = _SkillData:Get(self.SelMain)
        local list = def ~= nil and book:RankStages(self.SelMain) or {}
        local gear = book:GearRanks(self.SelMain)
        local power = book:GetPowerLevel(self.SelMain)
        local shownMarks = 0
        for i = 1, 4 do
            local path = self.Win .. "/TL/Bar/St" .. tostring(i)
            local s = list[i]
            local x = -1
            if s ~= nil and def ~= nil then
                local rank = math.max(1, s.lv - gear)
                x = self:LevelX(cols, first, shown, colW, book:NextRankLevel(self.SelMain, rank))
            end
            _UIKit:SetEnabled(path, x >= 0)
            if x >= 0 then
                shownMarks = shownMarks + 1
                _UIKit:SetPos(path, Vector2(x, 0))
                _UIKit:SetColor(path, power >= s.lv and Color(1, 0.84, 0.4, 1) or Color(0.62, 0.58, 0.5, 0.9))
            end
        end
        if shownMarks > 0 and not Environment:IsPublishedPlay() then log(string.format("[VRF] timeline stage marks %s n=%d", self.SelMain, shownMarks)) end
    end

    @ExecSpace("ClientOnly")
    method void RenderNodes(SkillBook book, PlayerStats st, any def)
        -- 강화 노드: 필요 랭크(need) 열별로 세우고 허브에서 갈래 선 (찍은 노드 선은 트리색)
        local ws = self.Win .. "/WS"
        local nodes = self:VisibleNodes(book, self.SelMain)
        local needs, colOf = {}, {}
        for _, nid in ipairs(nodes) do
            local need = book:NodeNeed(nid, 1)
            if colOf[need] == nil then
                table.insert(needs, need)
                colOf[need] = 0
            end
        end
        table.sort(needs)
        for i, need in ipairs(needs) do colOf[need] = i end
        local rowsIn = {}
        local hubY = -230
        local hubX = 600
        local tc = self:TreeColor(def.tree)
        _UIKit:SetEnabled(ws .. "/TreeHead", #nodes > 0)
        _UIKit:SetEnabled(ws .. "/Hub", #nodes > 0)
        _UIKit:SetEnabled(ws .. "/Spine", #nodes > 0)
        _UIKit:SetColor(ws .. "/Hub", tc)
        for i = 1, 6 do
            local need = needs[i]
            _UIKit:SetEnabled(ws .. "/Need" .. tostring(i), need ~= nil)
            if need ~= nil then
                _UIKit:SetText(ws .. "/Need" .. tostring(i), "필요 랭크 " .. tostring(need))
                _UIKit:SetPos(ws .. "/Need" .. tostring(i), Vector2(680 + (i - 1) * 104, -66))
            end
        end
        self.NodeIds = {}
        local topY, botY = hubY, hubY
        for i = 1, 8 do
            local nid = nodes[i]
            local n = ws .. "/N" .. tostring(i)
            _UIKit:SetEnabled(n, nid ~= nil)
            _UIKit:SetEnabled(ws .. "/L" .. tostring(i), nid ~= nil)
            if nid ~= nil then
                self.NodeIds[i] = nid
                local nd = _SkillData:Get(nid)
                local need = book:NodeNeed(nid, 1)
                local ci = colOf[need]
                rowsIn[ci] = (rowsIn[ci] or 0) + 1
                -- 열 680+104씩(6열 끝 1250 < 판 안쪽 1262) · 줄 96+102씩(3줄 끝 400 — 판 452의 안쪽 416 안), 10-28 「아래 노드가 판 밖으로」
                local x = 680 + (ci - 1) * 104
                local y = -96 - (rowsIn[ci] - 1) * 102
                _UIKit:SetPos(n, Vector2(x, y))
                local cy = y - 32   -- 노드 테두리(68) 가운데
                topY = math.max(topY, cy)
                botY = math.min(botY, cy)
                local link = _UIKit:Get(ws .. "/L" .. tostring(i))
                if isvalid(link) then link.UITransformComponent.RectSize = Vector2(math.max(16, x - 50 - hubX), 12) end
                _UIKit:SetPos(ws .. "/L" .. tostring(i), Vector2(hubX, cy))
                local nlv = book:GetLevel(nid)
                local can = book:CanLearn(nid, st.Level, st.SkillPoints) == ""
                -- 노드 테두리 4상태 (코덱스 skill-window-v3): 최대(금) · 배움(트리색) · 배울 수 있음(빈 테두리, 초록빛) · 잠김
                local key, ring = "sk_ws_node_frame_locked", Color(1, 1, 1, 1)
                if nlv >= nd.maxLv and nlv > 0 then key = "sk_ws_node_frame_max"
                elseif nlv > 0 then key, ring = "sk_ws_node_frame_learned", tc
                elseif can then key, ring = "sk_ws_node_frame_empty", Color(0.62, 0.92, 0.62, 1) end
                _UIKit:SetIcon(n .. "/Ring", _GameData:GetUiIcon(key))
                _UIKit:SetColor(n .. "/Ring", ring)
                -- 연결선: 배운 노드까지는 밝은 선(트리색), 아니면 어두운 선
                _UIKit:SetIcon(ws .. "/L" .. tostring(i), _GameData:GetUiIcon(nlv > 0 and "sk_ws_link_lit" or "sk_ws_link_dark"))
                _UIKit:SetColor(ws .. "/L" .. tostring(i), nlv > 0 and tc or Color(1, 1, 1, 1))
                _UIKit:SetIcon(n .. "/Icon", nd.icon)
                _UIKit:SetColor(n .. "/Icon", nlv > 0 and Color(1, 1, 1, 1) or (can and Color(0.85, 0.85, 0.85, 1) or Color(0.4, 0.4, 0.42, 0.85)))
                local status = tostring(nlv) .. "/" .. tostring(nd.maxLv)
                if nlv < nd.maxLv then
                    local needRank = book:NodeNeed(nid, nlv + 1)
                    local needLv = book:NodeLevel(nid, nlv + 1)
                    if book:GetLevel(self.SelMain) < needRank then status = _UIKit:Colored("#FF9A8A", tostring(needRank) .. "랭크부터")
                    elseif st.Level < needLv then status = _UIKit:Colored("#FF9A8A", "Lv" .. tostring(needLv) .. "부터")
                    elseif can then status = _UIKit:Colored("#7CFF7A", status .. " +1") end
                else status = _UIKit:Colored("#F4ED83", status) end
                _UIKit:SetText(n .. "/Label", nd.name .. "\n" .. status)
                _UIKit:SetColor(n, nid == self.Selected and Color(0.55, 0.65, 0.9, 0.45) or Color(0, 0, 0, 0.25))
            end
        end
        -- 등뼈: 허브에서 가장 위·아래 노드 높이까지
        local spine = _UIKit:Get(ws .. "/Spine")
        if isvalid(spine) then spine.UITransformComponent.RectSize = Vector2(4, math.max(4, topY - botY)) end
        _UIKit:SetPos(ws .. "/Spine", Vector2(hubX, topY))
        _UIKit:SetPos(ws .. "/Hub", Vector2(hubX, (topY + botY) / 2))
    end

    method table VisibleNodes(SkillBook book, string main)
        -- 공방에 세울 강화 노드 (46-5 · §4-4 두 묶음): 보류(hold) 줄은 빼고, 뼈 의식은 폭탄 3 + 펼친 거인 하나의 노드만 (나머지 4종은 깃발 줄에서 골라 펼친다 — 46-6).
        --   폭탄 필요 랭크 1·3·5 + 거인 10·14|17|20 = 5열 · 6칸 이하라 빌더 칸(6열 · 8칸) 안
        local out = {}
        local show = main == "bone_rite" and self:ShownGiant(book) or ""
        for _, nid in ipairs(_SkillData:NodesOf(main)) do
            local nd = _SkillData:Get(nid)
            local giant = book:GiantOfNode(nid)
            if nd ~= nil and not nd.hold and (giant == "" or giant == show) then table.insert(out, nid) end
        end
        return out
    end

    method string ShownGiant(SkillBook book)
        -- 펼칠 거인: 고른 노드가 거인 노드면 그 거인 → 공방에서 고른 줄(ShowGiant) → 깃발 → 지금 무리의 거인(GiantPlan) → 기본
        local picked = book:GiantOfNode(self.Selected)
        if picked ~= "" then return picked end
        if self.ShowGiant ~= "" then return self.ShowGiant end
        if book.RiteBanner ~= "" then return book.RiteBanner end
        local plan = _UndeadSystem:GiantPlanFor(book.Entity)
        if plan ~= nil then return plan.type end
        return "basic"
    end

    method string StatLine(SkillBook book, PlayerStats st, string id)
        -- 아코디언 효과 줄: 지금(배우면) → 다음 랭크, 마나·재사용 (장비 스킬 레벨 포함)
        local def = _SkillData:Get(id)
        if def == nil then return "" end
        local level = book:GetLevel(id)
        local power = book:PowerLevelAt(id, math.max(1, level))
        local gear = def.kind ~= "node" and math.max(0, power - math.max(1, level)) or 0
        -- 53·54: 이 줄은 공방(RenderWorkshop)에서만 그려지고 같은 화면 설명 칸(Desc)에 UseHint 조건 줄이 함께 보인다 → 요약 끝 중복 괄호만 뺀다 (DropHintDup)
        local hint = book:UseHint(id)
        local current = self:DropHintDup(id, book:GetRankSummary(id, def.kind == "node" and level == 0 and 1 or power), hint)
        if level > 0 and power <= 0 then current = "현재 캐릭터 레벨에서는 효과 없음" end
        local line = ""
        if current ~= "" then
            line = (level == 0 and "배우면: " or "지금: ") .. current
            if level > 0 and level < def.maxLv then
                local nextPower = book:PowerLevelAt(id, level + 1)
                -- 노드의 잠긴 다음 랭크는 계획할 효과를 보여 주고 구매 조건은 아래 Reason에서 설명한다.
                local nextRank = self:DropHintDup(id, book:GetRankSummary(id, def.kind == "node" and (level + 1) or nextPower), hint)
                line = line .. "\n" .. (nextRank == current and "다음 랭크: 효과 동일" or ("다음 랭크: " .. _UIKit:Colored("#7CFF7A", nextRank)))
            end
        end
        -- 비용 줄: 마나 · 재사용(질주는 충전) · 추가 랭크 — 다음 랭크 효과 뒤에 이어 붙이면 칸 끝에서 「마 / 나 8」로 갈렸다 (QR1629-OBS-01) → 따로 한 줄
        local cost = ""
        if def.kind == "active" or def.kind == "curse" then
            cost = "마나 " .. tostring(math.floor(book:GetManaCost(id, power)))
            local cd = book:SkillCooldown(id, power)
            if id == "wraith_dash" then
                cost = cost .. string.format(" · 충전 %.2f초", book:DashCooldown(power))
            elseif cd > 0 then cost = cost .. string.format(" · 재사용 %.2f초", cd * st:GetCastCooldownMult()) end
            cost = _UIKit:Colored("#C9BFA8", cost .. (gear > 0 and " · " or ""))
        end
        if gear > 0 then cost = cost .. _UIKit:Colored("#7CFF7A", "추가 랭크 +" .. tostring(gear)) end
        if cost ~= "" then line = line .. (line ~= "" and "\n" or "") .. cost end
        -- 해골 일으키기·변이·증원: 지금 편성과 다음 소환 (I03 · SkillBook.RosterLine)
        local roster = book:RosterLine(id)
        if roster ~= "" then line = line .. (line ~= "" and "\n" or "") .. _UIKit:Colored("#C9BFA8", roster) end
        return line
    end

    method string DropHintDup(string id, string summary, string hint)
        -- 글귀 53·54 (10-29 저녁 코덱스 위임 승인 · approval-copy-review-2103): 잔걸음(step_gale)·뼈 껍질(dash_ghost)은 선행 스킬이 없으면
        --   요약 끝에 「(망령 질주를 배우면)」·「(뼈 갑옷을 배우면)」이 붙고, 같은 화면에 UseHint 조건 줄(「…를 배워야 발동합니다」)도 보여 정보가 겹친다.
        --   UseHint 줄이 실제로 함께 보이는 표시 경로(스킬 창 공방 StatLine · 스킬 제물 강화 카드 NodeChange)에서만 요약 쪽 괄호를 뺀다.
        --   SkillBook.GetRankSummary는 그대로 둔다 — RequestLearn→NotifyLearned 학습 알림은 UseHint 줄이 없어 이 괄호가 유일한 조건 안내다
        if hint == "" or (id ~= "step_gale" and id ~= "dash_ghost") then return summary end
        local out = string.gsub(summary, " %([^%(%)]*배우면%)$", "")
        return out
    end

    method number MeasureW(TextGUIRendererComponent comp, string text)
        -- 글 한 줄의 화면 폭: 실행 중에는 그 칸 글꼴의 실제 폭(GetPreferredWidth — 크기 맞춤 칸은 최대 크기로 잰다), 칸이 없으면(오프라인 검사) 넉넉한 어림 UIKit.TextWidth
        if comp ~= nil then return comp:GetPreferredWidth(text) end
        return _UIKit:TextWidth(text, self.StatFont)
    end

    method table SplitPlain(string text, string sep)
        -- sep(글자 그대로)로 나눈 조각들 (패턴 문자 해석 없음)
        local parts = {}
        local i = 1
        while true do
            local a, b = string.find(text, sep, i, true)
            if a == nil then
                table.insert(parts, string.sub(text, i))
                break
            end
            table.insert(parts, string.sub(text, i, a - 1))
            i = b + 1
        end
        return parts
    end

    method string WrapLine(string text, number maxW, TextGUIRendererComponent comp)
        -- 한 줄을 칸 폭 maxW 안에 「 · 」 경계에서만 접는다. 이어지는 줄은 「  · 」로 시작 (QR1629-OBS-01)
        --   조각 하나가 칸보다 길면 그 조각만 띄어쓰기 경계에서 접는다(「  」 들여쓰기). 글자 크기·수치는 바꾸지 않는다 — 폭은 서식 태그를 뺀 글로 잰다
        if self:MeasureW(comp, _UIKit:PlainText(text)) <= maxW then return text end
        local out = {}
        local cur = ""
        for si, seg in ipairs(self:SplitPlain(text, " · ")) do
            local joined = si == 1 and seg or (cur .. " · " .. seg)
            if si > 1 and self:MeasureW(comp, _UIKit:PlainText(joined)) <= maxW then
                cur = joined
            else
                if si > 1 then table.insert(out, cur) end
                cur = si == 1 and seg or ("  · " .. seg)
                if self:MeasureW(comp, _UIKit:PlainText(cur)) > maxW then
                    -- 조각 자체가 길다: 띄어쓰기 경계에서 접는다 (단어 가운데는 끊지 않는다)
                    local line = ""
                    for wi, w in ipairs(self:SplitPlain(cur, " ")) do
                        local joinedWord = wi == 1 and w or (line .. " " .. w)
                        if w ~= "" and string.match(line, "%S") ~= nil and self:MeasureW(comp, _UIKit:PlainText(joinedWord)) > maxW then
                            table.insert(out, line)
                            line = "  " .. w
                        else
                            line = joinedWord
                        end
                    end
                    cur = line
                end
            end
        end
        table.insert(out, cur)
        return table.concat(out, "\n")
    end

    method string WrapLines(string text, number maxW, TextGUIRendererComponent comp)
        -- 여러 줄 글의 줄마다 WrapLine (지금 · 다음 랭크 · 비용 · 편성 줄이 각자 접힌다)
        local lines = {}
        for _, line in ipairs(self:SplitPlain(text, "\n")) do table.insert(lines, self:WrapLine(line, maxW, comp)) end
        return table.concat(lines, "\n")
    end

    method integer LineCount(string text)
        -- 줄 수 (빈 글은 0)
        if text == "" then return 0 end
        local _, n = string.gsub(text, "\n", "")
        return n + 1
    end

    @ExecSpace("ClientOnly")
    method void RenderLearnButton(SkillBook book, PlayerStats st)
        -- 버튼 글자가 지금 고른 것에 맞게: 배우기 / 레벨 업 +1 / 강화 +1. 못 찍으면 흐리게 (이유는 공방의 빨간 줄)
        local id = self.Selected ~= "" and self.Selected or self.SelMain
        local def = _SkillData:Get(id)
        local label = "배우기"
        if def ~= nil then
            if def.kind == "node" then label = "강화 +1"
            elseif book:GetLevel(id) > 0 then label = "레벨 업 +1" end
        end
        local ok = def ~= nil and book:CanLearn(id, st.Level, st.SkillPoints) == ""
        _UIKit:SetText(self.Win .. "/BtnLearn", ok and label or _UIKit:Colored("#8A8A8A", label))
        _UIKit:SetColor(self.Win .. "/BtnLearn", ok and Color(1, 1, 1, 1) or Color(0.55, 0.55, 0.55, 1))
    end

    method string GearLevelKey(PlayerStats st)
        -- 장비 스킬 레벨·저주 수치가 바뀌면 다시 그린다
        return tostring(st.BonusAllSkills) .. tostring(st.BonusTreeCommand) .. tostring(st.BonusTreeSoul) .. tostring(st.BonusTreeCurse) .. st.BonusSkillLv .. "#" .. tostring(st.BonusCurseDur) .. "#" .. tostring(st.BonusCurseEff) .. "#" .. tostring(st.BonusSpellDmg)
    end

    method table Trees()
        return { "command", "soul", "curse", "move" }
    end

    method table MainsOf(string tree)
        -- 그 트리의 메인 스킬 (해금 레벨 순)
        local list = {}
        for _, id in ipairs(_SkillData:Mains()) do
            if _SkillData:Get(id).tree == tree then table.insert(list, id) end
        end
        return list
    end

    method integer TabIndex(string tree)
        for i, t in ipairs(self:Trees()) do if t == tree then return i end end
        return 1
    end

    @ExecSpace("ClientOnly")
    method string SlotPathOf(string id)
        -- 상황 안내(GuideCoach)가 가리킬 시간선 칸 (지금 쪽에 없으면 넘김 단추, 시간선에 없으면 "")
        local cols = self:DisplayColumns()
        local per = self:PageSize()
        for ci, col in ipairs(cols) do
            for r, sid in ipairs(col.ids) do
                if sid == id then
                    local page = (ci - 1) // per + 1
                    if page < self.Page then return self.Win .. "/TL/Prev" end
                    if page > self.Page then return self.Win .. "/TL/NextPage" end
                    return self.Win .. "/TL/C" .. tostring(ci - (page - 1) * per) .. "/S" .. tostring(r)
                end
            end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method void EditSlots()
        -- 스킬 창을 내리고 PC는 스킬 지정 창(A S D F 우클릭 탭)을, 모바일은 패드 칸마다 +를 띄운다
        _UIKit:Close(self.Win)
        if Environment:IsMobilePlatform() then _MobilePad:StartEdit() else _SkillPicker:Open(1) end
    end

    @ExecSpace("ClientOnly")
    method void Pick(string id)
        -- 선택은 설명만 바꾼다. 포인트는 별도 배우기/강화 버튼에서만 사용한다.
        if id == nil or id == "" then return end
        if id == self.Selected then return end
        self.Selected = id
        local def = _SkillData:Get(id)
        if def ~= nil and def.kind ~= "node" then self.SelMain = id end
        if def ~= nil then self.Tab = def.tree end
        self.RenderKey = ""
        log("[VRF] skill pick " .. id)
    end

    @ExecSpace("ClientOnly")
    method void Act(integer slot)
        -- 0 = 습득, 1~4 = A S D F, 5 = 우클릭
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        -- 카드를 따로 누르지 않았어도 오른쪽에 보이는 스킬을 배운다 (10-20 첫 1시간 점검: 설명이 떠 있는데 「습득」이 아무 반응이 없었다)
        if self.Selected == "" then self.Selected = self.SelMain end
        if self.Selected == "" then return end
        if slot == 0 then book:RequestLearn(self.Selected) else book:RequestSetSlot(slot, self.Selected) end
        self.RenderKey = ""
    end

end
