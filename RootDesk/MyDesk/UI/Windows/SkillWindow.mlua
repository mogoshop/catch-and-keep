-- 스킬 창 (K): 3트리 × 최대 12행 (아이콘 + 이름·레벨, 안 배운 스킬은 흐리게). 스킬을 고르면 설명·습득 조건, 습득(+1, 설명 오른쪽 큰 버튼).
-- 칸 지정: 「스킬 편집」 하나 — PC는 스킬 지정 창(A S D F 우클릭 탭), 모바일은 창을 닫고 패드 칸의 +를 눌러 고른다.
@Logic
script SkillWindow extends Logic

    property string Win = "SkillWin"
    property string Selected = ""
    property table Rows = {}                -- "T1_1" → skill id
    property string RenderKey = ""
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        -- 트리 목록은 끌어서 스크롤한다 (위·아래 버튼 없음)
        for t = 1, 3 do
            for r = 1, 12 do
                local key = "T" .. tostring(t) .. "_" .. tostring(r)
                _UIKit:Connect(self.Win .. "/Col" .. tostring(t) .. "/T" .. tostring(r), function() self:Select(key) end)
            end
        end
        -- 습득 + 「스킬 편집」(PC: 스킬 지정 창, 모바일: 패드 칸의 +)
        _UIKit:Connect(self.Win .. "/BtnLearn", function() self:Act(0) end)
        _UIKit:Connect(self.Win .. "/BtnEdit", function() self:EditSlots() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        if not _UIKit:IsOpen(self.Win) then
            self.RenderKey = ""
            return
        end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if book == nil or st == nil then return end
        local key = book.SkillDigest .. "#" .. tostring(st.SkillPoints) .. "#" .. tostring(st.Level) .. "#" .. self.Selected .. "#" .. tostring(st:GetSpellPowerPct()) .. "#" .. tostring(st:GetCastCooldownMult()) .. "#" .. tostring(st.BonusMinionPct) .. "#" .. tostring(st.BonusDeploy) .. "#" .. tostring(st.BonusShadowCap)
        if key == self.RenderKey then return end
        self.RenderKey = key
        _UIKit:SetText(self.Win .. "/Points", "남은 스킬 포인트: " .. tostring(st.SkillPoints))
        local trees = { "command", "soul", "curse" }
        local rowCount = { 0, 0, 0 }
        self.Rows = {}
        for t = 1, 3 do _UIKit:SetText(self.Win .. "/Head" .. tostring(t), _SkillData:TreeName(trees[t])) end
        for _, id in ipairs(_SkillData:GetOrder()) do
            local def = _SkillData:Get(id)
            local t = 1
            if def.tree == "soul" then t = 2 elseif def.tree == "curse" then t = 3 end
            rowCount[t] = rowCount[t] + 1
            local rkey = "T" .. tostring(t) .. "_" .. tostring(rowCount[t])
            self.Rows[rkey] = id
            local lv = book:GetLevel(id)
            local color = "#777777"
            if lv > 0 then color = "#FFFFFF" elseif book:CanLearn(id, st.Level, math.max(1, st.SkillPoints)) == "" then color = "#AACCAA" end
            local soon = ""
            if not def.impl then soon = " ·" end
            local path = self.Win .. "/Col" .. tostring(t) .. "/T" .. tostring(rowCount[t])
            _UIKit:SetEnabled(path, true)
            _UIKit:SetText(path .. "/Label", _UIKit:Colored(color, def.name .. "\n" .. tostring(lv) .. "/" .. tostring(def.maxLv)) .. soon .. "  " .. _UIKit:Colored("#8C99B4", "Lv" .. tostring(def.row)))
            _UIKit:SetIcon(path .. "/Icon", def.icon)
            _UIKit:SetColor(path .. "/Icon", lv > 0 and Color(1, 1, 1, 1) or Color(0.45, 0.45, 0.45, 0.8))
            -- 고른 줄은 밝은 바탕
            _UIKit:SetColor(path, id == self.Selected and Color(0.55, 0.65, 0.9, 0.55) or Color(0, 0, 0, 0.25))
        end
        for t = 1, 3 do
            for r = rowCount[t] + 1, 12 do _UIKit:SetEnabled(self.Win .. "/Col" .. tostring(t) .. "/T" .. tostring(r), false) end
        end
        _UIKit:SetText(self.Win .. "/DescBox/Desc", self:Describe(book, st))
    end

    method string Describe(SkillBook book, PlayerStats st)
        -- 투자 전 현재·다음 효과를 비교하고 최대 레벨에서는 다음 효과를 숨긴다.
        if self.Selected == "" then return "스킬을 선택하세요." end
        -- 현재/다음 투자 레벨의 비용과 장비가 반영된 재사용 시간을 보여 준다.
        local def = _SkillData:Get(self.Selected)
        if def == nil then return "스킬을 다시 선택하세요." end
        local reason = book:CanLearn(self.Selected, st.Level, st.SkillPoints)
        local req = "요구 Lv" .. tostring(def.row)
        if def.nextLv > 0 then req = req .. " (2레벨부터 Lv" .. tostring(def.nextLv) .. ")" end
        if def.prereq ~= "" then req = req .. ", 선행 " .. _SkillData:Get(def.prereq).name end
        local mana = ""
        if def.kind ~= "passive" then
            local lv = math.max(1, book:GetLevel(self.Selected))
            local cost = book:GetManaCost(self.Selected, lv)
            local nextCost = book:GetManaCost(self.Selected, math.min(def.maxLv, lv + 1))
            mana = "  마나 " .. tostring(math.floor(cost))
            if book:GetLevel(self.Selected) > 0 and lv < def.maxLv and nextCost ~= cost then mana = mana .. " (다음 " .. tostring(math.floor(nextCost)) .. ")" end
            if def.cooldown > 0 then mana = mana .. string.format("  재사용 %.1f초", def.cooldown * st:GetCastCooldownMult()) end
        end
        local learn = _UIKit:Colored("#AACCAA", "습득 가능")
        if reason ~= "" then learn = _UIKit:Colored("#FF8888", reason) end
        local level = book:GetLevel(self.Selected)
        local growth = ""
        local current = book:GetRankSummary(self.Selected, math.max(1, level))
        if current ~= "" then
            growth = "\n" .. (level == 0 and "배우면: " or "현재: ") .. current
            if level > 0 and level < def.maxLv then
                local nextRank = book:GetRankSummary(self.Selected, level + 1)
                growth = growth .. "\n" .. (nextRank == current and "다음 레벨: 효과 동일" or ("다음: " .. nextRank))
            end
        end
        local description = def.desc
        if self.Selected == "raise_skeleton" then description = "혼으로 근접 전사 소환 · 다음 소환부터 강화 적용"
        elseif self.Selected == "raise_mage" then description = "혼으로 무작위 속성 마법사 소환 · 다음 소환부터 강화 적용" end
        return def.name .. " — " .. description .. growth .. (mana ~= "" and ("\n" .. mana) or "") .. "\n" .. req .. "   " .. learn
    end

    @ExecSpace("ClientOnly")
    method void EditSlots()
        -- 스킬 창을 내리고 PC는 스킬 지정 창(A S D F 우클릭 탭)을, 모바일은 패드 칸마다 +를 띄운다
        _UIKit:Close(self.Win)
        if Environment:IsMobilePlatform() then _MobilePad:StartEdit() else _SkillPicker:Open(1) end
    end

    @ExecSpace("ClientOnly")
    method void Select(string rkey)
        local id = self.Rows[rkey]
        if id == nil then return end
        self.Selected = id
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Act(integer slot)
        -- 0 = 습득, 1~4 = A S D F, 5 = 우클릭
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil or self.Selected == "" then return end
        if slot == 0 then book:RequestLearn(self.Selected) else book:RequestSetSlot(slot, self.Selected) end
        self.RenderKey = ""
    end

end
