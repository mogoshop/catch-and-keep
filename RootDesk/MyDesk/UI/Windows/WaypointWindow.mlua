-- 웨이포인트 창: 문양 위(반경 1.5)에서 멈추면 열린다. B·대화 버튼으로 바로 열 수도 있다. 통과 중에는 입력을 가로채지 않는다.
-- (클릭 이동의 목적지가 문양 안쪽에서 끝나지 않으면 '이동 중'이 남아 창이 영영 안 열리던 문제 — 실제 위치 변화와 전투만 본다)
-- 발견한 곳으로 이동, 난이도(보통·악몽·지옥) 전환. 액트 넘김 막대(◀ 액트 2 · 모래 폐허 ▶): 열린 액트의 웨이포인트로 바로 이동 (D2).
@Logic
script WaypointWindow extends Logic

    property string Win = "WpWin"
    property number Reach = 2.0               -- 10-10 QA: 1.5는 문양 가장자리에서 잘 안 열렸다
    property boolean PendingOpen = false      -- 웨이포인트를 클릭해 걸어가는 중 (닿으면 연다)
    property number ExplicitAt = -99          -- B·클릭으로 연 시각 (직후 한 걸음 움직임에 닫히지 않게)
    property boolean Dismissed = false
    property string RenderKey = ""
    property integer TimerId = 0
    property boolean WasOpen = false
    property string LastMapId = ""
    property Vector2 LastPosition = Vector2(0, 0)
    property number QuietSince = 0
    property number OpenDelay = 0.4
    property integer ViewAct = 1             -- 탭에서 보고 있는 액트 (창을 열 때 지금 액트로)
    property integer ViewDiff = 0            -- 보고 있는 난이도 (창을 열 때 지금 난이도로). 바꿔도 이동하지 않고, 맵을 고를 때 그 난이도로 간다
    property integer HoverDiff = -1          -- PC: 마우스가 올라간 잠긴 난이도 단추 (-1 = 없음) → 해금 조건 말풍선 (기획서 43 결정 7)
    property table HoverHandlers = {}        -- 난이도 단추 ButtonStateChangeEvent 연결 { entity, eventHandler }

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 플레이마다 거점 체류·닫기 상태를 초기화한다.
        self.Dismissed = false
        self.WasOpen = false
        self.RenderKey = ""
        self.LastMapId = ""
        self.QuietSince = _UtilLogic.ElapsedSeconds
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() self.Dismissed = true _UIKit:Close(self.Win) end)
        for i = 1, 8 do
            local index = i
            _UIKit:Connect(self.Win .. "/Wp" .. tostring(i), function() self:TravelTo(index) end)
        end
        -- 액트 넘김 막대 (◀ ▶, 10-20 사용자 선택 — 액트가 늘어도 그대로)
        _UIKit:Connect(self.Win .. "/ActBar/Prev", function() self:SelectAct(self.ViewAct - 1) end)
        _UIKit:Connect(self.Win .. "/ActBar/Next", function() self:SelectAct(self.ViewAct + 1) end)
        for d = 0, 2 do
            local diff = d
            _UIKit:Connect(self.Win .. "/Diff" .. tostring(d), function() self:SelectDiff(diff) end)
            -- 잠긴 난이도 단추에 마우스를 올리면 해금 조건 말풍선 (HudMain 버프 칩과 같은 ButtonStateChangeEvent 방식)
            local btn = _UIKit:Get(self.Win .. "/Diff" .. tostring(d))
            if isvalid(btn) then
                local h = btn:ConnectEvent(ButtonStateChangeEvent, function(event) self:OnDiffHover(diff, event.state == ButtonState.Hover) end)
                table.insert(self.HoverHandlers, { entity = btn, eventHandler = h })
            end
        end
        _UIKit:SetEnabled(self.Win .. "/DiffTip", false)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
        log("[VRF] WaypointWindow idle-only opening and route recommendation ready")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 반복 검사와 이전 맵의 체류 상태를 정리한다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        self.WasOpen = false
        self.LastMapId = ""
        for _, rec in ipairs(self.HoverHandlers) do
            if isvalid(rec.entity) then rec.entity:DisconnectEvent(ButtonStateChangeEvent, rec.eventHandler) end
        end
        self.HoverHandlers = {}
    end

    @ExecSpace("ClientOnly")
    method void OnDiffHover(integer diff, boolean hover)
        -- PC 마우스: 잠긴 난이도 단추 위에서만 해금 조건을 보여 준다 (조건은 NightmarePreview.UnlockConditionText — ProgressionSystem과 같은 규칙)
        if hover then self.HoverDiff = diff
        elseif self.HoverDiff == diff then self.HoverDiff = -1 end
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local locked = st ~= nil and self.HoverDiff >= 0 and self.HoverDiff > st.MaxDifficulty
        if locked then
            _UIKit:SetText(self.Win .. "/DiffTip/Text", _GameConst:DifficultyName(self.HoverDiff) .. " 잠김\n" .. _NightmarePreview:UnlockConditionText(self.HoverDiff))
            _UIKit:SetPos(self.Win .. "/DiffTip", Vector2((self.HoverDiff - 1) * 180, 100))
            log("[VRF] waypoint locked tip diff=" .. tostring(self.HoverDiff))
        end
        _UIKit:SetEnabled(self.Win .. "/DiffTip", locked)
    end

    method PlayerTravel Travel()
        ---@type PlayerTravel
        local c = _UIKit:Comp("script.PlayerTravel")
        return c
    end

    @ExecSpace("ClientOnly")
    method boolean HasGameplayIntent(Entity player)
        -- 경로 추적·표적 접근·방향키·공격·터치 조준이 끝나기 전에는 창을 열지 않는다.
        local click = player:GetComponent("script.ClickControl")
        if click ~= nil and (isvalid(click.AttackTarget) or isvalid(click.ExtractTarget) or click:IsArrowPressed()) then return true end
        local attack = player:GetComponent("script.PlayerAttack")
        if attack ~= nil and (attack.AttackPhase ~= "idle" or _UtilLogic.ElapsedSeconds - attack.LastLocalInputAt < 0.6) then return true end
        return _MobilePad.Holding or _MobilePad.GestureTouchId ~= 0
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 거점에 잠시 멈춘 뒤에만 자동으로 열고, 맵 전환 시 이전 창을 정리한다.
        local player = _UserService.LocalPlayer
        local travel = self:Travel()
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or not isvalid(player.CurrentMap) or travel == nil or st == nil then return end
        local pos = _Util:Pos2(player)
        local now = _UtilLogic.ElapsedSeconds
        if self.LastMapId ~= player.CurrentMap.Id then
            self.LastMapId = player.CurrentMap.Id
            self.LastPosition = pos
            self.QuietSince = now
            self.Dismissed = false
            self.WasOpen = false
            _UIKit:Close(self.Win)
        end
        local near = _Util:NearestComponent(player.CurrentMap, "script.Waypoint", pos, self.Reach) ~= nil
        if self.PendingOpen and near and _Util:IsAlive(player) and not _UIKit:AnyOtherWindowOpen(self.Win) then
            -- 클릭한 웨이포인트에 닿았다: 남은 이동을 멈추고 연다
            self.PendingOpen = false
            local click = player:GetComponent("script.ClickControl")
            if click ~= nil then click.HasDestination = false end
            if self:OpenNear() then return end
        end
        local shown = _UIKit:IsOpen(self.Win)
        -- Esc·다른 메뉴로 닫은 창은 같은 거점 위에서 다시 열지 않는다.
        if self.WasOpen and not shown then self.Dismissed = true end
        if not near then self.Dismissed = false end
        local eligible = near and not self.Dismissed and _Util:IsAlive(player) and not _UIKit:AnyOtherWindowOpen(self.Win)
        local moving = (pos - self.LastPosition):Magnitude() > 0.01 or self:HasGameplayIntent(player)
        if not eligible or moving then self.QuietSince = now end
        self.LastPosition = pos
        -- 이동을 막지 않는 창이라, 열린 뒤 걷거나 공격하면 스스로 닫고 거점을 벗어날 때까지 다시 열지 않는다.
        if shown and moving and now - self.ExplicitAt > 0.8 then
            self.Dismissed = true
            eligible = false
        end
        local open = eligible and (shown or now - self.QuietSince >= self.OpenDelay)
        if open and not shown then
            -- 열 때는 지금 있는 맵의 액트 탭부터 (10-24: PlayerTravel.Act는 서버 값이라 클라이언트에서 늘 1 — 오아시스에서 액트 1이 열렸다)
            self.ViewAct = self:CurrentAct(player)
            self.ViewDiff = st.Difficulty
            _UIKit:Open(self.Win)
        elseif not open then _UIKit:Close(self.Win) end
        self.WasOpen = open
        if not open then
            self.RenderKey = ""
            return
        end
        local quest = player:GetComponent("script.PlayerQuest")
        local goal = quest ~= nil and _HudMap:QuestMap(quest.Index, quest.State) or ""
        local recommended = _HudMap:RecommendedWaypoint(player.CurrentMap.Name, goal, travel)
        local key = travel.Known .. "#" .. tostring(st.Difficulty) .. "#" .. tostring(st.MaxDifficulty) .. "#" .. player.CurrentMap.Id .. "#" .. recommended .. "#" .. tostring(self.ViewAct) .. "#" .. tostring(self.ViewDiff) .. "#" .. travel.KnownAll .. "#" .. travel.ActOpenAll .. "#" .. tostring(travel:ActUnlocked(2)) .. tostring(travel:ActUnlocked(3))
        if key == self.RenderKey then return end
        self.RenderKey = key
        local list = _WaypointData:ListOfAct(self.ViewAct)
        local locked = ""
        for a = 1, _GameConst.ActCount do locked = locked .. (travel:ActUnlockedIn(self.ViewDiff, a) and "0" or "1") end
        _UIKit:SetActPager(self.Win .. "/ActBar", self.ViewAct, _GameConst.ActCount, "액트 " .. tostring(self.ViewAct) .. " · " .. _GameConst:ActRegionName(self.ViewAct), locked)
        for i = 1, 8 do
            local w = list[i]
            local text = ""
            _UIKit:SetEnabled(self.Win .. "/Wp" .. tostring(i), w ~= nil)
            if w ~= nil then
                if travel:IsKnownIn(self.ViewDiff, w.id) then
                    -- 의뢰 경로 표시는 지금 난이도를 볼 때만 (의뢰 진행은 난이도마다 다르다)
                    text = (w.id == recommended and self.ViewDiff == st.Difficulty) and "[의뢰 경로] " .. w.name or w.name
                else text = _UIKit:Colored("#666666", w.name) end  -- 10-10 QA: 「(미발견)」 문구 없이 흐린 글씨로만
            end
            _UIKit:SetText(self.Win .. "/Wp" .. tostring(i), text)
        end
        for d = 0, 2 do
            local label = _GameConst:DifficultyName(d)
            if d > st.MaxDifficulty then label = _UIKit:Colored("#666666", label .. " (잠김)")
            else
                if d == st.Difficulty and d ~= self.ViewDiff then label = label .. " (지금)" end
                if d == self.ViewDiff then label = "▶" .. label end
            end
            _UIKit:SetText(self.Win .. "/Diff" .. tostring(d), label)
        end
    end

    @ExecSpace("ClientOnly")
    method boolean OpenNear()
        -- B·대화 버튼: 웨이포인트 위면 바로 연다 (NPC보다 먼저 확인할 필요는 없다 — NPC가 없을 때 불린다)
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) then return false end
        if _Util:NearestComponent(player.CurrentMap, "script.Waypoint", _Util:Pos2(player), self.Reach) == nil then return false end
        self.Dismissed = false
        self.ExplicitAt = _UtilLogic.ElapsedSeconds
        self.QuietSince = _UtilLogic.ElapsedSeconds - self.OpenDelay
        self.LastPosition = _Util:Pos2(player)
        self.RenderKey = ""
        local travel = self:Travel()
        if travel ~= nil then self.ViewAct = self:CurrentAct(_UserService.LocalPlayer) end
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if st ~= nil then self.ViewDiff = st.Difficulty end
        _UIKit:Open(self.Win)
        self.WasOpen = true
        self:Poll()
        return true
    end

    @ExecSpace("ClientOnly")
    method integer CurrentAct(Entity player)
        -- 지금 있는 맵의 액트 (마을·사냥터 공통, 모르면 1)
        if not isvalid(player) or not isvalid(player.CurrentMap) then return 1 end
        return math.max(1, _GameConst:ActOfMap(_GameConst:BaseMapName(player.CurrentMap.Name)))
    end

    @ExecSpace("ClientOnly")
    method void SelectAct(integer act)
        -- 액트 탭: 열린 액트만 (잠긴 액트는 이유 안내)
        local travel = self:Travel()
        if travel == nil or act < 1 or act > _GameConst.ActCount then return end
        if not travel:ActUnlockedIn(self.ViewDiff, act) then
            -- 10-28 피드백 F1 B-(4): 「열리면 무엇이 있는지」 한 줄을 같이 (story.csv lock_act와 같은 내용)
            local why = { "", "묘지기 여왕 오르넬라를 쓰러뜨리고 사제 오렌에게 알리면 열립니다 — 모래 폐허 · 새 몬스터 12종 · 중급 룬 · 룬워드 「망자의 행진」",
                "대사제 알하자르를 쓰러뜨리고 학자 오빈에게 알리면 열립니다 — 폭풍 해안 · 새 몬스터 11종",
                "익사한 제독 바렌을 쓰러뜨리고 미라에게 알리면 열립니다 — 심연의 땅 · 새 몬스터 15종 · 재의 왕" }
            _UXFeedback:Show("액트 " .. tostring(act) .. " 잠김", why[act] or "", _GameData:GetUiIcon("icon_waypoint"))
            return
        end
        self.ViewAct = act
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void SelectDiff(integer diff)
        -- 난이도 버튼: 그 난이도의 웨이포인트 목록을 보여 주기만 한다 (이동은 맵을 고를 때)
        local travel = self:Travel()
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if travel == nil or st == nil then return end
        if diff > st.MaxDifficulty then
            -- 모바일(마우스 없음)은 누르면 같은 해금 조건을 알림으로 (기획서 43 결정 7)
            _UXFeedback:Show(_GameConst:DifficultyName(diff) .. " 잠김", _NightmarePreview:UnlockConditionText(diff), _GameData:GetUiIcon("icon_waypoint"))
            return
        end
        self.ViewDiff = diff
        if not travel:ActUnlockedIn(diff, self.ViewAct) then self.ViewAct = 1 end
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void TravelTo(integer index)
        -- 맵을 골랐을 때만 이동한다 (보고 있는 난이도로)
        local w = _WaypointData:ListOfAct(self.ViewAct)[index]
        local travel = self:Travel()
        if w == nil or travel == nil then return end
        if not travel:IsKnownIn(self.ViewDiff, w.id) then
            _UXFeedback:Show(w.name, "아직 발견하지 않은 웨이포인트입니다", _GameData:GetUiIcon("icon_waypoint"))
            return
        end
        travel:RequestTravelIn(w.id, self.ViewDiff)
    end

end
