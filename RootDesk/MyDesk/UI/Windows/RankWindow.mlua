-- 랭킹 창 (L): 성장 순위 (10-24 사용자: 모든 사용자를 레벨 + 가장 멀리 간 난이도·액트로) / 마지막 액트 보스 최단 처치 (현재 난이도).
-- 심연 기록판(심도 · 이번 주)은 심연을 숨긴 동안(config depthEnabled 0) 탭을 감춘다.
-- Show(kind)로 열면 서버에 요청 → RankingSystem이 OnData로 돌려준다.
-- 10-20: 심연이 액트별(레벨대·몬스터가 다름)이라 기록판도 액트별. 심연 탭 아래 액트 넘김 막대(◀ ▶), 처음엔 지금 액트
-- 10-20 B안: 「이번 주 심연」 탭 — 이번 주 규칙(WeeklyRules)과 주마다 새로 시작하는 기록판 (액트별)
@Logic
script RankWindow extends Logic

    property string Win = "RankWin"
    property string Kind = "progress"
    property integer Act = 0                -- 심연 탭에서 보는 액트 (0 = 아직 안 고름 → 지금 액트)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/TabProgress", function() self:Show("progress") end)
        _UIKit:Connect(self.Win .. "/TabDepth", function() self:Show("depth") end)
        _UIKit:Connect(self.Win .. "/TabWeek", function() self:Show("week") end)
        _UIKit:SetEnabled(self.Win .. "/TabDepth", _GameData.depthEnabled >= 1)
        _UIKit:SetEnabled(self.Win .. "/TabWeek", _GameData.depthEnabled >= 1)
        _UIKit:Connect(self.Win .. "/TabQueen", function() self:Show("boss_" .. _GameConst.FinalBossSourceId) end)
        _UIKit:Connect(self.Win .. "/ActBar/Prev", function() self:SetAct(self:CurrentAct() - 1) end)
        _UIKit:Connect(self.Win .. "/ActBar/Next", function() self:SetAct(self:CurrentAct() + 1) end)
        -- 탭 글자: 지금 마지막 액트 보스 (10-11 액트 3 → 익사한 제독 바렌)
        _UIKit:SetText(self.Win .. "/TabQueen", _GameData:GetMonsterName(_GameConst.FinalBossSourceId) .. " 처치")
    end

    @ExecSpace("ClientOnly")
    method void SetAct(integer act)
        -- ◀ ▶ 넘김 (액트 범위 안에서만)
        if act < 1 or act > _GameConst.ActCount then return end
        self.Act = act
        self:Show(self.Kind == "week" and "week" or "depth")
    end

    @ExecSpace("ClientOnly")
    method integer CurrentAct()
        -- 처음 열 때는 내가 지금 있는 액트
        if self.Act > 0 then return self.Act end
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        return travel ~= nil and math.max(1, math.min(_GameConst.ActCount, travel.Act)) or 1
    end

    @ExecSpace("ClientOnly")
    method void Show(string kind)
        _UIKit:Open(self.Win)
        self.Kind = kind
        _UIKit:SetText(self.Win .. "/Paper/List", "불러오는 중...")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local diff = 0
        if st ~= nil then diff = st.Difficulty end
        -- 액트 넘김 막대는 심연 탭에서만 (기록은 잠김 없이 모든 액트를 볼 수 있다)
        local act = self:CurrentAct()
        local paged = kind == "depth" or kind == "week"
        _UIKit:SetEnabled(self.Win .. "/ActBar", paged)
        if paged then
            _UIKit:SetActPager(self.Win .. "/ActBar", act, _GameConst.ActCount, "액트 " .. tostring(act) .. " · " .. _GameConst:ActRegionName(act), "")
        end
        local board = kind
        if kind == "depth" then board = _RankingSystem:DepthKind(act)
        elseif kind == "week" then board = _WeeklyRules:BoardKind(act, _WeeklyRules:CurrentWeek()) end
        _RankingSystem:RequestBoard(board, diff)
    end

    @ExecSpace("ClientOnly")
    method void OnData(string kind, integer diff, string digest)
        if kind == "progress" then
            -- 성장 순위: 레벨 → 난이도 → 액트 순
            if self.Kind ~= "progress" then return end
            local rows = { "레벨 · 가장 멀리 간 난이도·액트", "" }
            local n = 0
            for name, value in string.gmatch(digest, "([^|;]+)|(%d+)") do
                n = n + 1
                table.insert(rows, string.format("%2d.  %s   %s", n, name, _RankingSystem:ProgressText(tonumber(value) or 0)))
            end
            if n == 0 then table.insert(rows, "아직 기록이 없다") end
            _UIKit:SetText(self.Win .. "/Paper/List", table.concat(rows, "\n"))
            return
        end
        local week = string.sub(kind, 1, 9) == "weekrun_a"
        local depth = string.sub(kind, 1, 10) == "depthrun_a" or week
        if week then
            if self.Kind ~= "week" or kind ~= _WeeklyRules:BoardKind(self:CurrentAct(), _WeeklyRules:CurrentWeek()) then return end
        elseif (depth and self.Kind ~= "depth") or (not depth and kind ~= self.Kind) then return
        elseif depth and kind ~= _RankingSystem:DepthKind(self:CurrentAct()) then return end
        local title = _GameData:GetMonsterName(_GameConst.FinalBossSourceId) .. " 최단 처치"
        if depth then title = "최고 층 · 같은 층이면 빠른 순" end   -- 액트는 위 넘김 막대에 있다
        local lines = { title .. "  (" .. _GameConst:DifficultyName(diff) .. ")", "" }
        if week then
            -- 이번 주 규칙 두 줄 + 남은 시간
            local w = _WeeklyRules:CurrentWeek()
            lines = { "이번 주 규칙 (" .. _WeeklyRules:EndsIn() .. ")", _WeeklyRules:Describe(w, "\n"), "", title .. "  (" .. _GameConst:DifficultyName(diff) .. ")" }
        end
        local i = 0
        for name, value in string.gmatch(digest, "([^|;]+)|(%d+)") do
            i = i + 1
            local text = value .. "초"
            if depth then
                local v = tonumber(value) or 0
                local floor = math.floor(v / 100000)
                local secs = 99999 - v % 100000
                text = string.format("%d층 · %d분 %02d초", floor, math.floor(secs / 60), secs % 60)
            end
            table.insert(lines, string.format("%2d.  %s   %s", i, name, text))
        end
        if i == 0 then table.insert(lines, "아직 기록이 없다") end
        _UIKit:SetText(self.Win .. "/Paper/List", table.concat(lines, "\n"))
    end

end
