-- 랭킹 창 (L): 성장 순위 (10-24 사용자: 모든 사용자를 레벨 + 가장 멀리 간 난이도·액트로) / 마지막 액트 보스 최단 처치 (현재 난이도).
-- 심연 기록판(심도 · 이번 주)은 심연을 숨긴 동안(config depthEnabled 0) 탭을 감춘다.
-- Show(kind)로 열면 서버에 요청 → RankingSystem이 OnData로 돌려준다.
-- 10-20: 심연이 액트별(레벨대·몬스터가 다름)이라 기록판도 액트별. 심연 탭에서 액트 넘김 막대(◀ ▶), 처음엔 지금 액트
-- 10-20 B안: 「이번 주 심연」 탭 — 이번 주 규칙(WeeklyRules)과 주마다 새로 시작하는 기록판 (액트별)
-- 11-01 2차 (사용자 「랭킹창에 이 공백은 도대체 뭐여 줄이자 · 캐릭터도 작게 · 20위까지 · ui는 너가 판단」 · docs/evidence/2026-11-01-rank-window-2):
--   ① 보이는 것만 위에서 아래로 쌓는다 — 탭(한 줄) → 기록 판[머리 줄(제목 | 심연 탭이면 오른쪽 액트 넘김 막대) → 상위 20 → 내 순위]. 예전엔 막대 자리가 모든 탭에 비었다
--   ② 상위 20 = 칸 4 × 5줄. 칸 = 순위 | 캐릭터 그림(서버가 보낸 외형을 캐릭터 선택 카드와 같은 방식으로 입힘) | 이름 · 기록. 외형 없는 옛 줄은 기본 모습을 그림자 색으로
--   ③ 창 위 끝을 고정하고 아래로만 늘고 준다 (탭이 움직이지 않게 · 가장 긴 배치도 하단 메뉴 줄·버프 줄 위). 값 = tools/build/ui-tokens.cjs RANK·RANKTAB (check_ui_tokens)
@Logic
script RankWindow extends Logic

    property string Win = "RankWin"
    property string Kind = "progress"
    property integer Act = 0                -- 심연 탭에서 보는 액트 (0 = 아직 안 고름 → 지금 액트)
    -- 탭 (11-01 사용자 결정 2-C 「탭 폭 넓히기」 · 글귀·글자 16 그대로 · 2차: 창 바탕 1188이라 넷도 한 줄): 보이는 탭만 한 줄 가운데
    property integer TabW = 202
    property integer TabH = 56
    property integer TabTop = -86            -- 탭 위 끝 (창 바탕 위에서)
    property integer TabGapX = 16            -- 나란한 탭 사이 (ui-tokens FRAME.gap)
    property integer TabGapY = 12            -- 줄 사이 (ui-tokens SPACE · 지금은 늘 한 줄)
    property integer TabPerRow = 4
    property integer TabRows = 1             -- LayoutTabs가 센 탭 줄 수 (Layout이 기록 판을 그만큼 내린다)
    -- 창·기록 판 세로 쌓기 (ui-tokens RANK · rankWinLayout과 같은 계산)
    property integer WinW = 1188
    property integer RimOut = 20             -- 창 테두리가 바탕 밖으로 넘치는 폭 (ui-tokens FRAME.rimOut)
    property integer RimTop = 496            -- 창 테두리 위 끝 (화면 가운데 기준 · 고정)
    property integer PaperTop = -154         -- 탭 한 줄일 때 기록 판 위 끝 (탭 바로 아래 SPACE)
    property integer PaperW = 1110
    property integer PaperPad = 12           -- 기록 판 안 여백
    property integer PaperGap = 12           -- 기록 판 안 덩어리 사이 (머리 줄 ↔ 목록 ↔ 내 순위)
    property integer PaperBottom = 36        -- 기록 판 아래 ↔ 창 바탕 아래 (ui-tokens INSET.bottom)
    property integer HeadH = 40              -- 머리 줄 (막대 없음)
    property integer ActBarW = 420
    property integer ActBarH = 76            -- 심연 탭 머리 줄 = 막대 높이 (kit.actPager)
    property integer ListW = 1086
    property integer ListH = 334             -- 칸 62 × 5줄 + 사이 6 × 4
    property integer MineH = 56
    property integer TopCount = 20           -- 칸 수 (RankingSystem.TopCount와 같다)
    -- 외형 없는 옛 줄의 「그림자 모습」 색 (11-01 메이커 2회차 관찰 2: 예전 0.13·0.12·0.16·0.9는 어두운 칸 바탕과 대비가 낮아 1배에서 거의 안 보였다 → 어두운 잿빛 보라 — 몸 모양은 보이고 「모르는 모습」 느낌은 남김)
    property Color ShadowTint = Color(0.5, 0.48, 0.62, 0.95)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/TabProgress", function() self:Show("progress") end)
        _UIKit:Connect(self.Win .. "/TabDepth", function() self:Show("depth") end)
        _UIKit:Connect(self.Win .. "/TabWeek", function() self:Show("week") end)
        _UIKit:SetEnabled(self.Win .. "/TabDepth", _GameData.depthEnabled >= 1)
        _UIKit:SetEnabled(self.Win .. "/TabWeek", _GameData.depthEnabled >= 1)
        _UIKit:Connect(self.Win .. "/TabQueen", function() self:Show("boss_" .. _GameConst.FinalBossSourceId) end)
        -- 액트 넘김 ◀ ▶ = 투명 단추 88×88 + 보이는 틀 PrevArt·NextArt (11-01 메이커 2회차 관찰 3 · kit.actPager → kit.arrow)
        _UIKit:Connect(self.Win .. "/Paper/ActBar/Prev", function()
            log("[VRF] arrow click rank prev act=" .. tostring(self:CurrentAct()))
            self:SetAct(self:CurrentAct() - 1)
        end)
        _UIKit:Connect(self.Win .. "/Paper/ActBar/Next", function()
            log("[VRF] arrow click rank next act=" .. tostring(self:CurrentAct()))
            self:SetAct(self:CurrentAct() + 1)
        end)
        -- 탭 글자: 보스 이름은 아래 판 제목에 있다 (10-24: 탭이 좁아져 「재의 왕 고르바스 처치」가 두 줄로 접혔다)
        _UIKit:SetText(self.Win .. "/TabQueen", "보스 처치 시간")
        self:LayoutTabs(_GameData.depthEnabled >= 1)
        self:Layout("progress")
    end

    @ExecSpace("ClientOnly")
    method void LayoutTabs(boolean depth)
        -- 보이는 탭만 한 줄에 TabPerRow개씩 가운데 정렬 (2차: 넷도 한 줄 — 4 × 202 + 3 × 16 = 856 ≤ 창 안쪽 1086). 줄 수는 Layout이 쓴다
        local shown = { "TabProgress", "TabQueen" }
        if depth then
            table.insert(shown, "TabDepth")
            table.insert(shown, "TabWeek")
        end
        local per = math.max(1, self.TabPerRow)
        self.TabRows = math.max(1, math.ceil(#shown / per))
        local xs = {}
        for i, name in ipairs(shown) do
            local row = math.floor((i - 1) / per)
            local inRow = math.min(per, #shown - row * per)
            local col = (i - 1) - row * per
            local x = (col - (inRow - 1) / 2) * (self.TabW + self.TabGapX)
            _UIKit:SetPos(self.Win .. "/" .. name, Vector2(x, self.TabTop - row * (self.TabH + self.TabGapY)))
            table.insert(xs, tostring(math.floor(x)))
        end
        log(string.format("[VRF] rank tabs shown=%d rows=%d w=%d x=%s", #shown, self.TabRows, self.TabW, table.concat(xs, ",")))
    end

    @ExecSpace("ClientOnly")
    method void Layout(string kind)
        -- 보이는 것만 쌓는다: 탭 → 기록 판[머리 줄(심연 탭이면 막대 높이 · 막대 오른쪽) → 목록 → 내 순위(판 아래에 붙음)] → 창 높이.
        --   창 테두리 위 끝(RimTop)은 그대로 두고 창 가운데를 옮겨 아래로만 늘고 준다 (탭이 손 아래에서 움직이지 않게)
        local paged = kind == "depth" or kind == "week"
        local headH = self.HeadH
        if paged then headH = self.ActBarH end
        local paperTop = self.PaperTop - (self.TabRows - 1) * (self.TabH + self.TabGapY)
        local listTop = self.PaperPad + headH + self.PaperGap
        local paperH = listTop + self.ListH + self.PaperGap + self.MineH + self.PaperPad
        local winH = -paperTop + paperH + self.PaperBottom
        local winY = self.RimTop - self.RimOut - winH / 2
        local p = self.Win .. "/Paper"
        local headW = self.ListW
        if paged then headW = self.ListW - self.ActBarW - self.PaperGap end
        _UIKit:SetEnabled(p .. "/ActBar", paged)
        _UIKit:SetSize(p .. "/Head", Vector2(headW, headH))
        _UIKit:SetPos(p .. "/List", Vector2(self.PaperPad, -listTop))
        _UIKit:SetPos(p, Vector2(0, paperTop))
        _UIKit:SetSize(p, Vector2(self.PaperW, paperH))
        _UIKit:SetPos(self.Win, Vector2(0, winY))
        _UIKit:SetSize(self.Win, Vector2(self.WinW, winH))
        _UIKit:SetSize(self.Win .. "/Rim", Vector2(self.WinW + self.RimOut * 2, winH + self.RimOut * 2))
        log(string.format("[VRF] rank layout kind=%s paged=%s head=%d listTop=%d paperH=%d winH=%d winY=%d rimBottom=%d", kind, tostring(paged), math.floor(headH), math.floor(listTop), math.floor(paperH), math.floor(winH), math.floor(winY), math.floor(self.RimTop - winH - self.RimOut * 2)))
    end

    @ExecSpace("ClientOnly")
    method void SetAct(integer act)
        -- ◀ ▶ 넘김 (액트 범위 안에서만)
        if act < 1 or act > _GameConst.ActCount then return end
        self.Act = act
        self:Show(self.Kind == "week" and "week" or "depth")
    end

    @ExecSpace("ClientOnly")
    method integer CurrentAct()
        -- 처음 열 때는 내가 지금 있는 액트
        if self.Act > 0 then return self.Act end
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        return travel ~= nil and math.max(1, math.min(_GameConst.ActCount, travel.Act)) or 1
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        -- L 키: 열려 있으면 닫고, 아니면 성장 순위로 연다 (10-29 45 §2-6 #4 — 다른 창 단축키와 같은 규칙)
        if _UIKit:IsOpen(self.Win) then
            _UIKit:Close(self.Win)
            return
        end
        self:Show("progress")
    end

    @ExecSpace("ClientOnly")
    method void MarkTabs()
        -- 고른 탭 표시: 능력치·룬워드 창 탭과 같은 양식 (btn_frame 색 — 고른 탭은 밝은 금빛, 나머지는 어둡게)
        local queen = "boss_" .. _GameConst.FinalBossSourceId
        for _, t in ipairs({ { "TabProgress", "progress" }, { "TabDepth", "depth" }, { "TabWeek", "week" }, { "TabQueen", queen } }) do
            _UIKit:SetColor(self.Win .. "/" .. t[1], t[2] == self.Kind and Color(1, 0.9, 0.7, 1) or Color(0.55, 0.52, 0.5, 1))
        end
    end

    @ExecSpace("ClientOnly")
    method void Show(string kind)
        _UIKit:Open(self.Win)
        self.Kind = kind
        self:MarkTabs()
        self:Layout(kind)
        log("[VRF] rank show kind=" .. kind)
        self:Clear("불러오는 중…")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local diff = 0
        if st ~= nil then diff = st.Difficulty end
        -- 액트 넘김 막대는 심연 탭에서만 (기록은 잠김 없이 모든 액트를 볼 수 있다)
        local act = self:CurrentAct()
        if kind == "depth" or kind == "week" then
            _UIKit:SetActPager(self.Win .. "/Paper/ActBar", act, _GameConst.ActCount, "액트 " .. tostring(act) .. " · " .. _GameConst:ActRegionName(act), "")
        end
        local board = kind
        if kind == "depth" then board = _RankingSystem:DepthKind(act)
        elseif kind == "week" then board = _WeeklyRules:BoardKind(act, _WeeklyRules:CurrentWeek()) end
        _UIKit:SetText(self.Win .. "/Paper/Head", self:HeadText(board, diff))   -- 제목은 바로 (목록은 서버 답이 오면)
        _RankingSystem:RequestBoard(board, diff)
    end

    @ExecSpace("ClientOnly")
    method void Clear(string message)
        -- 목록 칸을 모두 끄고 가운데 안내 한 줄 (「불러오는 중…」) · 내 순위 줄 비우기
        for i = 1, self.TopCount do _UIKit:SetEnabled(self.Win .. "/Paper/List/R" .. tostring(i), false) end
        _UIKit:SetEnabled(self.Win .. "/Paper/List/Empty", true)
        _UIKit:SetText(self.Win .. "/Paper/List/Empty", message)
        local m = self.Win .. "/Paper/Mine"
        _UIKit:SetText(m .. "/Rank", "")
        _UIKit:SetText(m .. "/Name", "")
        _UIKit:SetText(m .. "/Value", "")
        _UIKit:SetEnabled(m .. "/Avatar", false)
    end

    method boolean IsCurrent(string kind)
        -- 서버 답이 지금 보고 있는 판의 것인가 (탭·액트를 빨리 넘기면 늦게 온 예전 답은 버린다)
        if kind == "progress" then return self.Kind == "progress" end
        if string.sub(kind, 1, 9) == "weekrun_a" then return self.Kind == "week" and kind == _WeeklyRules:BoardKind(self:CurrentAct(), _WeeklyRules:CurrentWeek()) end
        if string.sub(kind, 1, 10) == "depthrun_a" then return self.Kind == "depth" and kind == _RankingSystem:DepthKind(self:CurrentAct()) end
        return kind == self.Kind
    end

    method string HeadText(string kind, integer diff)
        -- 판 제목 (머리 줄 왼쪽): 성장 「레벨 · 가장 멀리 간 난이도·액트」 · 보스 「재의 왕 고르바스 최단 처치  (노말)」 · 심연 「최고 층 · 같은 층이면 빠른 순  (노말)」 ·
        --   이번 주는 세 줄 「이번 주 규칙 (n일 뒤 바뀜) · 노말」 + 규칙 두 줄 (액트는 오른쪽 넘김 막대에 있다)
        if kind == "progress" then return "레벨 · 가장 멀리 간 난이도·액트" end
        local diffName = _GameConst:DifficultyName(diff)
        if string.sub(kind, 1, 9) == "weekrun_a" then
            return "이번 주 규칙 (" .. _WeeklyRules:EndsIn() .. ")  ·  " .. diffName .. "\n" .. _WeeklyRules:Describe(_WeeklyRules:CurrentWeek(), "\n")
        end
        if string.sub(kind, 1, 10) == "depthrun_a" then return "최고 층 · 같은 층이면 빠른 순  (" .. diffName .. ")" end
        return _GameData:GetMonsterName(_GameConst.FinalBossSourceId) .. " 최단 처치  (" .. diffName .. ")"
    end

    @ExecSpace("ClientOnly")
    method void OnData(string kind, integer diff, string digest, string mine, string me)
        -- 상위 20 칸 (순위 · 캐릭터 그림 · 이름 · 기록) + 아래 「내 순위」 줄 (10-31 A안 · RankingSystem.MineDigest "순위|값" / "none" · MeText "이름|외형")
        if not self:IsCurrent(kind) then return end
        _UIKit:SetText(self.Win .. "/Paper/Head", self:HeadText(kind, diff))
        local rows = {}
        for name, value, look in string.gmatch(digest, "([^|;]+)|(%d+)|([^|;]*)") do
            table.insert(rows, { name = name, value = tonumber(value) or 0, look = look })
        end
        local myName = string.match(me or "", "^([^|]*)|")
        local myLook = string.match(me or "", "^[^|]*|(.*)$")
        local rank = string.match(mine or "", "^(%-?%d+)|%d+$")
        local mineValue = string.match(mine or "", "^%-?%d+|(%d+)$")
        local myRank = tonumber(rank or "") or 0
        local myValue = tonumber(mineValue or "")
        -- 목록 안 내 칸: 내 순위 자리의 이름·값이 같을 때만 (목록은 60초 캐시라 순위가 그새 바뀌었으면 칠하지 않는다)
        local myCell = 0
        local mr = rows[myRank]
        if mr ~= nil and mr.name == myName and mr.value == myValue then myCell = myRank end
        local shadow = 0
        for i = 1, self.TopCount do
            local c = self.Win .. "/Paper/List/R" .. tostring(i)
            local r = rows[i]
            _UIKit:SetEnabled(c, r ~= nil)
            if r ~= nil then
                _UIKit:SetColor(c, self:CellColor(i, i == myCell))
                _UIKit:SetText(c .. "/Rank", self:RankLabel(i))
                _UIKit:SetText(c .. "/Name", i == myCell and _UIKit:Colored("#F4ED83", r.name) or r.name)
                _UIKit:SetText(c .. "/Value", self:ValueText(kind, r.value))
                if not self:DressAvatar(c .. "/Avatar", r.look) then shadow = shadow + 1 end
            end
        end
        _UIKit:SetEnabled(self.Win .. "/Paper/List/Empty", #rows == 0)
        if #rows == 0 then _UIKit:SetText(self.Win .. "/Paper/List/Empty", "아직 기록이 없습니다") end
        -- 내 순위 줄: 「37위」 / 「100위 밖」 / 「-」 · 지금 캐릭터 그림·이름 · 기록(없으면 「기록 없음」)
        local m = self.Win .. "/Paper/Mine"
        local where = "-"
        if rank ~= nil then where = myRank > 0 and (tostring(myRank) .. "위") or (tostring(_RankingSystem.MinePageMax) .. "위 밖") end
        _UIKit:SetText(m .. "/Rank", where)
        _UIKit:SetText(m .. "/Name", myName or "")
        _UIKit:SetText(m .. "/Value", myValue ~= nil and self:ValueText(kind, myValue) or "기록 없음")
        if (myName or "") ~= "" then self:DressAvatar(m .. "/Avatar", myLook or "")
        else _UIKit:SetEnabled(m .. "/Avatar", false) end
        log(string.format("[VRF] rank rows kind=%s n=%d looks=%d shadow=%d myCell=%d mine=%s", kind, #rows, #rows - shadow, shadow, myCell, self:MineText(kind, mine)))
    end

    @ExecSpace("ClientOnly")
    method boolean DressAvatar(string path, string look)
        -- 칸 캐릭터 그림: 외형이 있으면 캐릭터 선택 카드·파티 판과 같은 모습(CharSelectWindow.Dress — 외형 + 기본 로브).
        --   외형이 없는 옛 줄(11-01 2차 전 기록)은 기본 모습을 그림자 색으로 칠해 「아직 모르는 모습」으로 둔다 (남의 모습을 기본 남자로 잘못 보이지 않게). 외형이 있으면 true
        local known = string.match(look or "", "^[mf]%-%d+%-%d+") ~= nil
        _UIKit:SetEnabled(path, true)
        _CharSelectWindow:Dress(path, known and look or "m-1-1")
        local e = _UIKit:Get(path)
        if isvalid(e) and e.AvatarGUIRendererComponent ~= nil then
            e.AvatarGUIRendererComponent.Color = known and Color(1, 1, 1, 1) or self.ShadowTint
        end
        return known
    end

    method string RankLabel(integer rank)
        -- 칸 순위 숫자: 1 금 · 2 은 · 3 동 · 그 밖 흐린 베이지
        local hex = "#B8AE9A"
        if rank == 1 then hex = "#FFD45A"
        elseif rank == 2 then hex = "#DCE3EC"
        elseif rank == 3 then hex = "#E39A5C" end
        return _UIKit:Colored(hex, tostring(rank))
    end

    method Color CellColor(integer rank, boolean mine)
        -- 칸 바탕: 내 칸 = 노란 빛 · 1~3위 = 따뜻한 빛 · 그 밖 = 옅은 칸 (줄마다 아주 조금 다르게)
        if mine then return Color(0.96, 0.85, 0.35, 0.22) end
        if rank <= 3 then return Color(0.85, 0.62, 0.25, 0.14) end
        if math.floor((rank - 1) / 4) % 2 == 0 then return Color(1, 1, 1, 0.05) end
        return Color(1, 1, 1, 0.03)
    end

    method string ValueText(string kind, integer value)
        -- 판마다 값 글: 성장 「Lv44 · 노말 액트 4」 · 심연(도전·이번 주) 「7층 · 3분 05초」 · 보스 「95초」
        if kind == "progress" then return _RankingSystem:ProgressText(value) end
        if string.sub(kind, 1, 9) == "weekrun_a" or string.sub(kind, 1, 10) == "depthrun_a" then
            local floor = math.floor(value / 100000)
            local secs = 99999 - value % 100000
            return string.format("%d층 · %d분 %02d초", floor, math.floor(secs / 60), secs % 60)
        end
        return tostring(value) .. "초"
    end

    method string MineText(string kind, string mine)
        -- 「내 순위  N위 · 값」 / 「내 순위  100위 밖 · 값」 / 「내 순위  기록 없음」 (내 순위 줄 요약 — [VRF] 로그)
        local rank, value = string.match(mine or "", "^(%-?%d+)|(%d+)$")
        if rank == nil then return "내 순위  기록 없음" end
        local r = tonumber(rank) or -1
        local where = r > 0 and (tostring(r) .. "위") or (tostring(_RankingSystem.MinePageMax) .. "위 밖")
        return "내 순위  " .. where .. " · " .. self:ValueText(kind, tonumber(value) or 0)
    end

end
