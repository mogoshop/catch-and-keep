-- 랭킹 창 (L): 성장 순위 (10-24 사용자: 모든 사용자를 레벨 + 가장 멀리 간 난이도·액트로) / 마지막 액트 보스 최단 처치 (현재 난이도).
-- 심연 기록판(심도 · 이번 주)은 심연을 숨긴 동안(config depthEnabled 0) 탭을 감춘다.
-- Show(kind)로 열면 서버에 요청 → RankingSystem이 OnData로 돌려준다.
-- 10-20: 심연이 액트별(레벨대·몬스터가 다름)이라 기록판도 액트별. 심연 탭 아래 액트 넘김 막대(◀ ▶), 처음엔 지금 액트
-- 10-20 B안: 「이번 주 심연」 탭 — 이번 주 규칙(WeeklyRules)과 주마다 새로 시작하는 기록판 (액트별)
@Logic
script RankWindow extends Logic

    property string Win = "RankWin"
    property string Kind = "progress"
    property integer Act = 0                -- 심연 탭에서 보는 액트 (0 = 아직 안 고름 → 지금 액트)
    -- 탭 배치 (11-01 사용자 결정 2-C 「탭 폭 넓히기」 · 글귀·글자 16 그대로): 빌더(tools/build/ui.cjs · ui-tokens RANKTAB)와 같은 값 — check_ui_tokens가 본다.
    --   탭 폭은 가장 긴 글(「보스 처치 시간」) + 양쪽 단추 장식 안쪽. 보이는 탭만 한 줄에 TabPerRow개씩 가운데로 —
    --   심연을 숨긴 동안 = 성장·보스 한 줄(빌더 자리 그대로) · 심연이 켜져 넷 = 둘째 줄 + 액트 넘김 막대·기록 칸을 TabGapY씩 아래로 쌓고 창을 늘린다
    --   (넷을 한 줄에 두면 856 > 창 안쪽 538)
    property integer TabW = 202
    property integer TabH = 56
    property integer TabTop = -86            -- 첫 줄 위 끝 (창 바탕 위에서)
    property integer TabGapX = 16            -- 나란한 탭 사이 (ui-tokens FRAME.gap)
    property integer TabGapY = 12            -- 줄 사이 · 둘째 줄 아래 쌓기 사이 (ui-tokens SPACE)
    property integer TabPerRow = 2
    property integer ActBarTop = -166        -- 탭 한 줄일 때 액트 넘김 막대 위 끝 (빌더 자리)
    property integer ActBarH = 76
    property integer PaperTop = -218         -- 탭 한 줄일 때 기록 칸 위 끝 (빌더 자리)
    property integer WinW = 640
    property integer WinH = 660              -- 탭 한 줄일 때 창 바탕 높이
    property integer RimOut = 20             -- 창 테두리가 바탕 밖으로 넘치는 폭 (ui-tokens FRAME.rimOut)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/TabProgress", function() self:Show("progress") end)
        _UIKit:Connect(self.Win .. "/TabDepth", function() self:Show("depth") end)
        _UIKit:Connect(self.Win .. "/TabWeek", function() self:Show("week") end)
        _UIKit:SetEnabled(self.Win .. "/TabDepth", _GameData.depthEnabled >= 1)
        _UIKit:SetEnabled(self.Win .. "/TabWeek", _GameData.depthEnabled >= 1)
        _UIKit:Connect(self.Win .. "/TabQueen", function() self:Show("boss_" .. _GameConst.FinalBossSourceId) end)
        _UIKit:Connect(self.Win .. "/ActBar/Prev", function() self:SetAct(self:CurrentAct() - 1) end)
        _UIKit:Connect(self.Win .. "/ActBar/Next", function() self:SetAct(self:CurrentAct() + 1) end)
        -- 탭 글자: 보스 이름은 아래 표 제목에 있다 (10-24: 탭이 좁아져 「재의 왕 고르바스 처치」가 두 줄로 접혔다)
        _UIKit:SetText(self.Win .. "/TabQueen", "보스 처치 시간")
        self:LayoutTabs(_GameData.depthEnabled >= 1)
    end

    @ExecSpace("ClientOnly")
    method void LayoutTabs(boolean depth)
        -- 보이는 탭만 한 줄에 TabPerRow개씩 가운데 정렬. 줄이 둘 이상이면 액트 넘김 막대·기록 칸을 탭 아래로 TabGapY씩 쌓고 창(테두리 포함)을 그만큼 늘린다
        local shown = { "TabProgress", "TabQueen" }
        if depth then
            table.insert(shown, "TabDepth")
            table.insert(shown, "TabWeek")
        end
        local per = math.max(1, self.TabPerRow)
        local rows = math.max(1, math.ceil(#shown / per))
        local xs = {}
        for i, name in ipairs(shown) do
            local row = math.floor((i - 1) / per)
            local inRow = math.min(per, #shown - row * per)
            local col = (i - 1) - row * per
            local x = (col - (inRow - 1) / 2) * (self.TabW + self.TabGapX)
            _UIKit:SetPos(self.Win .. "/" .. name, Vector2(x, self.TabTop - row * (self.TabH + self.TabGapY)))
            table.insert(xs, tostring(math.floor(x)))
        end
        local actTop = self.ActBarTop
        local paperTop = self.PaperTop
        if rows > 1 then
            local bottom = self.TabTop - rows * self.TabH - (rows - 1) * self.TabGapY
            actTop = bottom - self.TabGapY
            paperTop = actTop - self.ActBarH - self.TabGapY
        end
        local winH = self.WinH + (self.PaperTop - paperTop)
        _UIKit:SetPos(self.Win .. "/ActBar", Vector2(0, actTop))
        _UIKit:SetPos(self.Win .. "/Paper", Vector2(0, paperTop))
        _UIKit:SetSize(self.Win, Vector2(self.WinW, winH))
        _UIKit:SetSize(self.Win .. "/Rim", Vector2(self.WinW + self.RimOut * 2, winH + self.RimOut * 2))
        log(string.format("[VRF] rank tabs shown=%d rows=%d w=%d x=%s actTop=%d paperTop=%d winH=%d", #shown, rows, self.TabW, table.concat(xs, ","), math.floor(actTop), math.floor(paperTop), math.floor(winH)))
    end

    @ExecSpace("ClientOnly")
    method void SetAct(integer act)
        -- ◀ ▶ 넘김 (액트 범위 안에서만)
        if act < 1 or act > _GameConst.ActCount then return end
        self.Act = act
        self:Show(self.Kind == "week" and "week" or "depth")
    end

    @ExecSpace("ClientOnly")
    method integer CurrentAct()
        -- 처음 열 때는 내가 지금 있는 액트
        if self.Act > 0 then return self.Act end
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        return travel ~= nil and math.max(1, math.min(_GameConst.ActCount, travel.Act)) or 1
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        -- L 키: 열려 있으면 닫고, 아니면 성장 순위로 연다 (10-29 45 §2-6 #4 — 다른 창 단축키와 같은 규칙)
        if _UIKit:IsOpen(self.Win) then
            _UIKit:Close(self.Win)
            return
        end
        self:Show("progress")
    end

    @ExecSpace("ClientOnly")
    method void MarkTabs()
        -- 고른 탭 표시: 능력치·룬워드 창 탭과 같은 양식 (btn_frame 색 — 고른 탭은 밝은 금빛, 나머지는 어둡게)
        local queen = "boss_" .. _GameConst.FinalBossSourceId
        for _, t in ipairs({ { "TabProgress", "progress" }, { "TabDepth", "depth" }, { "TabWeek", "week" }, { "TabQueen", queen } }) do
            _UIKit:SetColor(self.Win .. "/" .. t[1], t[2] == self.Kind and Color(1, 0.9, 0.7, 1) or Color(0.55, 0.52, 0.5, 1))
        end
    end

    @ExecSpace("ClientOnly")
    method void Show(string kind)
        _UIKit:Open(self.Win)
        self.Kind = kind
        self:MarkTabs()
        log("[VRF] rank show kind=" .. kind)
        _UIKit:SetText(self.Win .. "/Paper/List", "불러오는 중…")
        _UIKit:SetText(self.Win .. "/Paper/Mine", "")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        local diff = 0
        if st ~= nil then diff = st.Difficulty end
        -- 액트 넘김 막대는 심연 탭에서만 (기록은 잠김 없이 모든 액트를 볼 수 있다)
        local act = self:CurrentAct()
        local paged = kind == "depth" or kind == "week"
        _UIKit:SetEnabled(self.Win .. "/ActBar", paged)
        if paged then
            _UIKit:SetActPager(self.Win .. "/ActBar", act, _GameConst.ActCount, "액트 " .. tostring(act) .. " · " .. _GameConst:ActRegionName(act), "")
        end
        local board = kind
        if kind == "depth" then board = _RankingSystem:DepthKind(act)
        elseif kind == "week" then board = _WeeklyRules:BoardKind(act, _WeeklyRules:CurrentWeek()) end
        _RankingSystem:RequestBoard(board, diff)
    end

    @ExecSpace("ClientOnly")
    method void OnData(string kind, integer diff, string digest, string mine)
        -- 상위 10줄 (목록) + 아래 「내 순위」 한 줄 (10-31 A안 · RankingSystem.MineDigest "순위|값" / "none")
        if kind == "progress" then
            -- 성장 순위: 레벨 → 난이도 → 액트 순
            if self.Kind ~= "progress" then return end
            local rows = { "레벨 · 가장 멀리 간 난이도·액트", "" }
            local n = 0
            for name, value in string.gmatch(digest, "([^|;]+)|(%d+)") do
                n = n + 1
                table.insert(rows, string.format("%2d.  %s   %s", n, name, self:ValueText(kind, tonumber(value) or 0)))
            end
            if n == 0 then table.insert(rows, "아직 기록이 없습니다") end
            _UIKit:SetText(self.Win .. "/Paper/List", table.concat(rows, "\n"))
            _UIKit:SetText(self.Win .. "/Paper/Mine", self:MineText(kind, mine))
            return
        end
        local week = string.sub(kind, 1, 9) == "weekrun_a"
        local depth = string.sub(kind, 1, 10) == "depthrun_a" or week
        if week then
            if self.Kind ~= "week" or kind ~= _WeeklyRules:BoardKind(self:CurrentAct(), _WeeklyRules:CurrentWeek()) then return end
        elseif (depth and self.Kind ~= "depth") or (not depth and kind ~= self.Kind) then return
        elseif depth and kind ~= _RankingSystem:DepthKind(self:CurrentAct()) then return end
        local title = _GameData:GetMonsterName(_GameConst.FinalBossSourceId) .. " 최단 처치"
        if depth then title = "최고 층 · 같은 층이면 빠른 순" end   -- 액트는 위 넘김 막대에 있다
        local lines = { title .. "  (" .. _GameConst:DifficultyName(diff) .. ")", "" }
        if week then
            -- 이번 주 규칙 두 줄 + 남은 시간
            local w = _WeeklyRules:CurrentWeek()
            lines = { "이번 주 규칙 (" .. _WeeklyRules:EndsIn() .. ")", _WeeklyRules:Describe(w, "\n"), "", title .. "  (" .. _GameConst:DifficultyName(diff) .. ")" }
        end
        local i = 0
        for name, value in string.gmatch(digest, "([^|;]+)|(%d+)") do
            i = i + 1
            table.insert(lines, string.format("%2d.  %s   %s", i, name, self:ValueText(kind, tonumber(value) or 0)))
        end
        if i == 0 then table.insert(lines, "아직 기록이 없습니다") end
        _UIKit:SetText(self.Win .. "/Paper/List", table.concat(lines, "\n"))
        _UIKit:SetText(self.Win .. "/Paper/Mine", self:MineText(kind, mine))
    end

    method string ValueText(string kind, integer value)
        -- 판마다 값 글: 성장 「Lv44 · 노말 액트 4」 · 심연(도전·이번 주) 「7층 · 3분 05초」 · 보스 「95초」
        if kind == "progress" then return _RankingSystem:ProgressText(value) end
        if string.sub(kind, 1, 9) == "weekrun_a" or string.sub(kind, 1, 10) == "depthrun_a" then
            local floor = math.floor(value / 100000)
            local secs = 99999 - value % 100000
            return string.format("%d층 · %d분 %02d초", floor, math.floor(secs / 60), secs % 60)
        end
        return tostring(value) .. "초"
    end

    method string MineText(string kind, string mine)
        -- 「내 순위  N위 · 값」 / 「내 순위  100위 밖 · 값」 / 「내 순위  기록 없음」
        local rank, value = string.match(mine or "", "^(%-?%d+)|(%d+)$")
        if rank == nil then return "내 순위  기록 없음" end
        local r = tonumber(rank) or -1
        local where = r > 0 and (tostring(r) .. "위") or (tostring(_RankingSystem.MinePageMax) .. "위 밖")
        return "내 순위  " .. where .. " · " .. self:ValueText(kind, tonumber(value) or 0)
    end

end
