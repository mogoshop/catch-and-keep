-- 공용 확인 창 (ConfirmHUD): Show(제목, 본문, 확인 글자, 확인 시 실행할 함수). 취소·Esc·바깥 누르기는 아무것도 하지 않는다.
-- 쓰는 곳: 그림자 소환·강화·분해(ShadowHUD), 소지품 버리기·판매(InventoryWindow). ShowInputPick = PC 첫 진입 조작 방식 고르기 (GuideWindow).
@Logic
script ConfirmDialog extends Logic

    property string Root = "/ui/ConfirmHUD/SafeArea/Dim"
    property any OnYes = nil
    property any OnNo = nil
    property string PickRoot = "/ui/ConfirmHUD/SafeArea/Pick"   -- 조작 방식 고르기 (카드 두 장)
    property any OnPick = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:SetEnabled(self.Root, false)
        _UIKit:Connect(self.Root .. "/Box/BtnYes", function() self:Answer(true) end)
        _UIKit:Connect(self.Root .. "/Box/BtnNo", function() self:Answer(false) end)
        _UIKit:SetEnabled(self.PickRoot, false)
        _UIKit:Connect(self.PickRoot .. "/Box/Mouse/Btn", function() self:Pick(true) end)
        _UIKit:Connect(self.PickRoot .. "/Box/Keys/Btn", function() self:Pick(false) end)
    end

    @ExecSpace("ClientOnly")
    method void ShowInputPick(any onPick)
        -- PC 첫 진입: 마우스 / 키보드 카드 (그림 + 이동·공격·스킬·질주 키). 골라야 닫힌다 (Esc로 넘기지 않는다)
        self.OnPick = onPick
        _UIKit:SetEnabled(self.PickRoot, true)
        local e = _UIKit:Get(self.PickRoot)
        if isvalid(e) then _UILogic:SetSiblingIndex(e.UITransformComponent, 1000000) end
        log("[VRF] input pick show")
    end

    @ExecSpace("ClientOnly")
    method void Pick(boolean mouse)
        local callback = self.OnPick
        self.OnPick = nil
        _UIKit:SetEnabled(self.PickRoot, false)
        if callback ~= nil then callback(mouse) end
    end

    @ExecSpace("ClientOnly")
    method void Show(string title, string body, string yesLabel, any onYes)
        self:ShowIcon(title, body, yesLabel, "", onYes)
    end

    @ExecSpace("ClientOnly")
    method void ShowIcon(string title, string body, string yesLabel, string icon, any onYes)
        -- 같은 창을 다시 쓰면 앞의 질문은 취소된다. icon이 있으면 본문 위 가운데에 (정수 등 무엇을 쓰는지), 본문은 그만큼 아래로
        _UIKit:SetIcon(self.Root .. "/Box/Icon", icon)
        _UIKit:SetPos(self.Root .. "/Box/Body", Vector2(0, icon ~= "" and -150 or -86))
        self.OnYes = onYes
        _UIKit:SetText(self.Root .. "/Box/Title", title)
        _UIKit:SetText(self.Root .. "/Box/Body", body)
        _UIKit:SetText(self.Root .. "/Box/BtnYes", yesLabel ~= "" and yesLabel or "확인")
        _UIKit:SetText(self.Root .. "/Box/BtnNo", "취소")
        self.OnNo = nil
        _UIKit:SetEnabled(self.Root, true)
        local e = _UIKit:Get(self.Root)
        if isvalid(e) then _UILogic:SetSiblingIndex(e.UITransformComponent, 1000000) end
        log("[VRF] confirm show " .. title)
    end

    @ExecSpace("ClientOnly")
    method void ShowChoice(string title, string body, string yesLabel, string noLabel, any onYes, any onNo)
        -- 두 갈래 고르기 (예: 이동 방식 마우스 / 키보드). 아니오 쪽도 실행할 함수가 있다. Esc는 아니오와 같다
        self:ShowIcon(title, body, yesLabel, "", onYes)
        _UIKit:SetText(self.Root .. "/Box/BtnNo", noLabel)
        self.OnNo = onNo
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen()
        return _UIKit:IsOpen(self.Root) or _UIKit:IsOpen(self.PickRoot)
    end

    @ExecSpace("ClientOnly")
    method void Answer(boolean yes)
        local callback = self.OnYes
        local other = self.OnNo
        self.OnYes = nil
        self.OnNo = nil
        _UIKit:SetEnabled(self.Root, false)
        if yes and callback ~= nil then callback() end
        if not yes and other ~= nil then other() end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- Esc = 취소, Enter = 확인
        if not _UIKit:IsOpen(self.Root) then return end
        if event.key == KeyboardKey.Escape then self:Answer(false)
        elseif event.key == KeyboardKey.Return then self:Answer(true) end
    end

end
