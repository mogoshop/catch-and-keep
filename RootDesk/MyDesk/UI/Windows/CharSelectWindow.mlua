-- 캐릭터 선택 창 (CharSelectHUD): PlayerSave.Selecting 동안 화면을 덮고 슬롯 4칸을 보여 준다 (Esc로 닫혀도 다시 연다).
--   칸마다 그 캐릭터의 모습(UI 아바타 · 외형 + 기본 로브)을 보여 준다. 칸을 누르면 고르기 → 「입장」, 「삭제」(확인 창).
--   빈 칸을 누르면 「캐릭터 만들기」 판: 이름 · 성별(남/여 데몬슬레이어) · 머리 모양·색 · 얼굴·눈 색 · 무작위 → 「만들기」 (10-13, 모양은 10-24)
-- 서버 처리: PlayerSave.RequestSelectSlot / RequestCreateSlot / RequestDeleteSlot
@Logic
script CharSelectWindow extends Logic

    property string Win = "CharSelect"
    property integer TimerId = 0
    property integer Selected = 0
    property string RenderKey = ""
    property boolean Busy = false             -- 요청을 보낸 뒤 결과(창 닫힘·목록 변화)가 올 때까지 중복 클릭 막기
    property number BusyUntil = 0
    property boolean BootShown = true         -- 첫 진입 로딩 화면 (UI 파일에서 처음부터 켜져 있다)
    property number BootLimit = 15            -- 저장 응답이 없어도 이 시간(초) 뒤엔 로딩 화면을 끈다
    property boolean Creating = false         -- 캐릭터 만들기 판이 열려 있다
    property string Gender = "m"
    property integer HairIndex = 1
    property integer FaceIndex = 1
    property integer HairStyle = 1            -- 머리 모양 (player_appearance.csv hairstyle.<성별>.N)
    property integer FaceStyle = 1            -- 얼굴 모양 (facestyle.<성별>.N)
    property table Previewed = {}             -- 아바타 경로 → 마지막으로 입힌 외형 (같은 외형이면 다시 입히지 않는다)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        for i = 1, 4 do
            local index = i
            _UIKit:Connect(self.Win .. "/Box/S" .. tostring(i), function() self:PickSlot(index) end)
        end
        _UIKit:Connect(self.Win .. "/Box/BtnEnter", function() self:Enter() end)
        _UIKit:Connect(self.Win .. "/Box/BtnDelete", function() self:Delete() end)
        local c = self.Win .. "/Box/Create"
        _UIKit:Connect(c .. "/BtnMale", function() self:SetGender("m") end)
        _UIKit:Connect(c .. "/BtnFemale", function() self:SetGender("f") end)
        _UIKit:Connect(c .. "/HairPrev", function() self:Step("hair", -1) end)
        _UIKit:Connect(c .. "/HairNext", function() self:Step("hair", 1) end)
        _UIKit:Connect(c .. "/FacePrev", function() self:Step("face", -1) end)
        _UIKit:Connect(c .. "/FaceNext", function() self:Step("face", 1) end)
        _UIKit:Connect(c .. "/HairStylePrev", function() self:Step("hairstyle", -1) end)
        _UIKit:Connect(c .. "/HairStyleNext", function() self:Step("hairstyle", 1) end)
        _UIKit:Connect(c .. "/FaceStylePrev", function() self:Step("facestyle", -1) end)
        _UIKit:Connect(c .. "/FaceStyleNext", function() self:Step("facestyle", 1) end)
        _UIKit:Connect(c .. "/BtnRandom", function() self:Randomize() end)
        _UIKit:Connect(c .. "/BtnCreate", function() self:Create() end)
        _UIKit:Connect(c .. "/BtnCancel", function() self:CloseCreator() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.25)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    method PlayerSave Save()
        ---@type PlayerSave
        local c = _UIKit:Comp("script.PlayerSave")
        return c
    end

    method table Slots(string digest)
        -- "1|이름|레벨|난이도|외형;2;…" → { [1] = { name, lv, diff, look } 또는 nil } (외형이 없던 예전 요약도 읽는다)
        local list = {}
        for entry in string.gmatch(digest .. ";", "([^;]*);") do
            local no, name, lv, diff, look = string.match(entry, "^(%d+)|([^|]*)|(%d+)|(%d+)|?(.*)$")
            if no ~= nil then
                list[tonumber(no)] = { name = name, lv = tonumber(lv), diff = tonumber(diff), look = look ~= "" and look or "m-1-1" }
            end
        end
        return list
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local save = self:Save()
        if self.BootShown and ((save ~= nil and save.BootDone) or _UtilLogic.ElapsedSeconds > self.BootLimit) then
            -- 선택 창이 열리거나 캐릭터를 다 불러왔다: 로딩 화면을 끈다 (선택 창은 같은 Poll에서 바로 열린다)
            self.BootShown = false
            _UIKit:SetEnabled("/ui/CharSelectHUD/SafeArea/Boot", false)
        end
        if save == nil then return end
        if not save.Selecting then
            if _UIKit:IsOpen(self.Win) then _UIKit:Close(self.Win) end
            self.Busy = false
            return
        end
        if not _UIKit:IsOpen(self.Win) then
            if self.Busy and _UIKit:IsOpen("RoomWin") then return end   -- 입장 요청 중: 게임 고르기(불러오는 중)를 덮어쓰지 않는다
            _UIKit:Open(self.Win)
            self.RenderKey = ""
        end
        if self.Busy and _UtilLogic.ElapsedSeconds > self.BusyUntil then self.Busy = false end
        local slots = self:Slots(save.SlotDigest)
        if self.Selected == 0 then
            -- 처음엔 캐릭터가 있는 첫 칸 (없으면 1번)
            self.Selected = 1
            for i = 1, 4 do
                if slots[i] ~= nil then
                    self.Selected = i
                    break
                end
            end
        end
        local key = save.SlotDigest .. "#" .. tostring(self.Selected) .. "#" .. tostring(self.Busy) .. "#" .. tostring(self.Creating) .. "#" .. self:CurrentLook()
        if key == self.RenderKey then return end
        self.RenderKey = key
        local count = 0
        for i = 1, 4 do
            local s = slots[i]
            local path = self.Win .. "/Box/S" .. tostring(i)
            if s ~= nil then count = count + 1 end
            _UIKit:SetEnabled(path, not self.Creating)
            _UIKit:SetEnabled(path .. "/Pick", i == self.Selected)
            _UIKit:SetEnabled(path .. "/Plus", s == nil)
            _UIKit:SetEnabled(path .. "/Avatar", s ~= nil)
            if s ~= nil then self:Dress(path .. "/Avatar", s.look) end
            _UIKit:SetText(path .. "/Name", s ~= nil and s.name or "<color=#8C8270>새 캐릭터</color>")
            _UIKit:SetText(path .. "/Level", s ~= nil and ("Lv " .. tostring(s.lv)) or "")
            _UIKit:SetText(path .. "/Diff", s ~= nil and _GameConst:DifficultyName(s.diff) or "<color=#6E6658>눌러서 만들기</color>")
        end
        local sel = slots[self.Selected]
        local empty = sel == nil
        _UIKit:SetText(self.Win .. "/Box/Info", self.Creating and "이름과 모습을 정하세요 — 데몬슬레이어의 피를 이은 술사"
            or string.format("캐릭터 %d / 4  ·  창고는 모든 캐릭터가 함께 쓴다  ·  %s", count, empty and "빈 칸을 누르면 새 캐릭터를 만든다" or "칸을 고르고 「입장」"))
        _UIKit:SetEnabled(self.Win .. "/Box/BtnEnter", not self.Creating)
        _UIKit:SetEnabled(self.Win .. "/Box/BtnDelete", not self.Creating)
        _UIKit:SetEnabled(self.Win .. "/Box/Create", self.Creating)
        if self.Creating then self:RenderCreator() end
        _UIKit:SetText(self.Win .. "/Box/BtnEnter", empty and "새 캐릭터 만들기" or ("「" .. sel.name .. "」 입장"))
        self:SetButton("BtnEnter", not self.Busy)
        self:SetButton("BtnDelete", not empty and not self.Busy)
    end

    @ExecSpace("ClientOnly")
    method void SetButton(string name, boolean allowed)
        local e = _UIKit:Get(self.Win .. "/Box/" .. name)
        if isvalid(e) and e.ButtonComponent ~= nil then e.ButtonComponent.Enable = allowed end
        _UIKit:SetColor(self.Win .. "/Box/" .. name, allowed and Color(1, 1, 1, 1) or Color(0.42, 0.42, 0.42, 1))
    end

    @ExecSpace("ClientOnly")
    method void Enter()
        local save = self:Save()
        if save == nil or self.Busy or self.Selected == 0 then return end
        local slots = self:Slots(save.SlotDigest)
        self.Busy = true
        self.BusyUntil = _UtilLogic.ElapsedSeconds + 5
        self.RenderKey = ""
        if slots[self.Selected] ~= nil then
            save:RequestSelectSlot(self.Selected)
            _RoomWindow:ShowLoading()   -- 10-22: 같은 어두운 화면으로 이어서 게임 고르기 (로비가 비치지 않게)
        else
            -- 빈 칸의 「새 캐릭터 만들기」: 만들기 판을 연다
            self.Busy = false
            self:OpenCreator()
        end
    end

    -- ───────── 캐릭터 만들기 ─────────

    @ExecSpace("ClientOnly")
    method void PickSlot(integer index)
        -- 칸 누르기: 캐릭터가 있으면 고르기, 빈 칸이면 바로 만들기 판
        if self.Busy or self.Creating then return end
        self.Selected = index
        local save = self:Save()
        if save ~= nil and self:Slots(save.SlotDigest)[index] == nil then
            self:OpenCreator()
            return
        end
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void OpenCreator()
        self.Creating = true
        self.Gender = "m"
        self.HairIndex = 1
        self.FaceIndex = 1
        self.HairStyle = 1
        self.FaceStyle = 1
        local input = _UIKit:Get(self.Win .. "/Box/Create/NameInput")
        if isvalid(input) and input.TextGUIRendererInputComponent ~= nil then input.TextGUIRendererInputComponent.Text = "" end
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void CloseCreator()
        self.Creating = false
        self.RenderKey = ""
        self:Poll()
    end

    method string CurrentLook()
        return self.Gender .. "-" .. tostring(self.HairIndex) .. "-" .. tostring(self.FaceIndex) .. "-" .. tostring(self.HairStyle) .. "-" .. tostring(self.FaceStyle)
    end

    @ExecSpace("ClientOnly")
    method void SetGender(string g)
        -- 성별을 바꾸면 같은 번호의 색을 유지한다 (남·녀 목록이 같은 색 순서). 모양은 성별마다 달라 첫 모양으로
        if self.Gender ~= g then
            self.HairStyle = 1
            self.FaceStyle = 1
        end
        self.Gender = g
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Step(string kind, integer delta)
        local n = math.max(1, _GameData:LookOptionCount(kind, self.Gender))
        if kind == "hair" then self.HairIndex = (self.HairIndex - 1 + delta) % n + 1
        elseif kind == "face" then self.FaceIndex = (self.FaceIndex - 1 + delta) % n + 1
        elseif kind == "hairstyle" then self.HairStyle = (self.HairStyle - 1 + delta) % n + 1
        else self.FaceStyle = (self.FaceStyle - 1 + delta) % n + 1 end
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Randomize()
        self.Gender = _UtilLogic:RandomDouble() < 0.5 and "m" or "f"
        self.HairIndex = _UtilLogic:RandomIntegerRange(1, math.max(1, _GameData:LookOptionCount("hair", self.Gender)))
        self.FaceIndex = _UtilLogic:RandomIntegerRange(1, math.max(1, _GameData:LookOptionCount("face", self.Gender)))
        self.HairStyle = _UtilLogic:RandomIntegerRange(1, math.max(1, _GameData:LookOptionCount("hairstyle", self.Gender)))
        self.FaceStyle = _UtilLogic:RandomIntegerRange(1, math.max(1, _GameData:LookOptionCount("facestyle", self.Gender)))
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void RenderCreator()
        local c = self.Win .. "/Box/Create"
        local look = _GameData:ParseLook(self:CurrentLook())
        self:Dress(c .. "/Stage/Avatar", self:CurrentLook())
        self:SetPick(c .. "/HairStyleName", "머리 모양", look.hairStyleName, self.HairStyle, "hairstyle")
        self:SetPick(c .. "/HairName", "머리 색", look.hairName, self.HairIndex, "hair")
        self:SetPick(c .. "/FaceStyleName", "얼굴", look.faceStyleName, self.FaceStyle, "facestyle")
        self:SetPick(c .. "/FaceName", "눈 색", look.faceName, self.FaceIndex, "face")
        -- 고른 성별 단추는 밝게, 다른 쪽은 어둡게
        _UIKit:SetColor(c .. "/BtnMale", self.Gender == "m" and Color(1, 0.86, 0.62, 1) or Color(0.45, 0.42, 0.4, 1))
        _UIKit:SetColor(c .. "/BtnFemale", self.Gender == "f" and Color(1, 0.86, 0.62, 1) or Color(0.45, 0.42, 0.4, 1))
        self:SetButton("Create/BtnCreate", not self.Busy)
    end

    @ExecSpace("ClientOnly")
    method void SetPick(string path, string label, string value, integer index, string kind)
        -- 고르기 칸 글씨: 작은 항목 이름 위에 고른 값 + 번호/개수
        local n = _GameData:LookOptionCount(kind, self.Gender)
        _UIKit:SetText(path, _UIKit:Colored("#8C8270", "<size=18>" .. label .. "</size>") .. "\n" .. value .. "  " .. _UIKit:Colored("#8C8270", "<size=20>" .. tostring(index) .. "/" .. tostring(n) .. "</size>"))
    end

    @ExecSpace("ClientOnly")
    method void Create()
        local save = self:Save()
        if save == nil or self.Busy or not self.Creating then return end
        local input = _UIKit:Get(self.Win .. "/Box/Create/NameInput")
        local name = ""
        if isvalid(input) and input.TextGUIRendererInputComponent ~= nil then name = input.TextGUIRendererInputComponent.Text end
        self.Busy = true
        self.BusyUntil = _UtilLogic.ElapsedSeconds + 5
        save:RequestCreateSlot(self.Selected, name, self:CurrentLook())
        self.Creating = false
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Dress(string path, string lookText)
        -- UI 아바타에 외형 + 기본 로브를 입힌다 (게임 안 외형과 같은 규칙: PlayerInventory.ApplyAppearance)
        if self.Previewed[path] == lookText then return end
        local e = _UIKit:Get(path)
        if not isvalid(e) or e.CostumeManagerComponent == nil then return end
        local look = _GameData:ParseLook(lookText)
        local cm = e.CostumeManagerComponent
        cm.UseCustomEquipOnly = true
        cm.CustomBodyEquip = _GameData:GetPlayerAppearance("body")
        cm.CustomHairEquip = look.hair
        cm.CustomFaceEquip = look.face
        cm.CustomEarEquip = _GameData:GetPlayerAppearance("ear")
        cm.CustomLongcoatEquip = _ItemData:AppearanceParts({}, "").armor
        self.Previewed[path] = lookText
    end

    @ExecSpace("ClientOnly")
    method void Delete()
        local save = self:Save()
        if save == nil or self.Busy then return end
        local s = self:Slots(save.SlotDigest)[self.Selected]
        if s == nil then return end
        local slot = self.Selected
        _ConfirmDialog:Show("캐릭터 삭제", "「" .. s.name .. "」 Lv " .. tostring(s.lv) .. "\n이 캐릭터를 목록에서 지웁니다. 장비·그림자·진행도는 이 캐릭터와 함께 사라집니다.\n(공용 창고는 그대로 남습니다)", "삭제", function()
            self.Busy = true
            self.BusyUntil = _UtilLogic.ElapsedSeconds + 5
            self.RenderKey = ""
            save:RequestDeleteSlot(slot)
        end)
    end

end
