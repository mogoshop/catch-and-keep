-- NPC 대화 창: 근처에서는 대화 버튼만 표시한다. 버튼/B 키로 선택했을 때 열고, 거리·맵이 바뀌면 닫는다.
--   shop  = 물약·두루마리·도박 5버튼 → PlayerShop
--   quest = D2처럼 말을 건 뒤 의뢰를 받는다: 소개 대사(다음 ▶) → 의뢰 내용·보상 → 수락/거절 → PlayerQuest.
--           완료하면 마무리 대사 → 보고(보상). 대사는 quests.csv intro·outro ("/"로 줄 나눔)
@Logic
script NpcWindow extends Logic

    property string Win = "NpcWin"
    property string Kind = ""
    property string RenderKey = ""
    property integer TimerId = 0
    property integer Page = 1
    property string PageKey = ""            -- 의뢰 번호·상태가 바뀌면 대사를 처음부터
    property boolean Dismissed = false      -- 닫기를 누른 뒤 NPC에게서 멀어질 때까지 열지 않음
    property integer PageCount = 1
    property string Prompt = "/ui/InteractionHUD/SafeArea/Talk"
    property Entity ActiveNpc = nil
    property integer PendingIndex = 0
    property integer PendingState = 0
    property number PendingUntil = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 가까이 지나가는 것만으로 대화가 이동을 막지 않게 한다.
        self.ActiveNpc = nil
        self.PendingIndex = 0
        self.PendingState = 0
        self.PendingUntil = 0
        _UIKit:RegisterWindow(self.Win)
        _UIKit:SetEnabled(self.Prompt, false)
        _UIKit:Connect(self.Prompt, function() self:Talk() end)
        local prompt = _UIKit:Get(self.Prompt)
        -- 모바일은 생명·마나 구슬 바로 위(가운데 아래)에 둔다. 화면 한가운데 떠 있으면 위치가 뜬금없었다
        if isvalid(prompt) then prompt.UITransformComponent.anchoredPosition = Vector2(0, Environment:IsMobilePlatform() and 170 or 280) end
        for i = 1, 5 do
            local index = i
            _UIKit:Connect(self.Win .. "/Btn" .. tostring(i), function() self:Action(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnClose", function() self:Dismiss() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 세션 종료 시 대화 대상과 안내를 함께 지운다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self.ActiveNpc = nil
        _UIKit:SetEnabled(self.Prompt, false)
    end

    @ExecSpace("ClientOnly")
    method WorldNPC FindNpc(Entity player)
        -- 맵을 전환하는 짧은 구간의 입력에서도 nil 맵을 읽지 않는다.
        if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
        local best = nil
        local bestDist = 999
        local p = _Util:Pos2(player)
        for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.WorldNPC", true)) do
            ---@type WorldNPC
            local npc = c
            local d = (_Util:Pos2(c.Entity) - p):Magnitude()
            if d < bestDist and self:CanTalkTo(player, npc) then
                bestDist = d
                best = npc
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method boolean CanTalkTo(Entity player, WorldNPC npc)
        -- 벽 너머·다른 맵·사망·비활성 NPC와는 대화하지 않는다.
        return isvalid(player) and _Util:IsAlive(player) and npc ~= nil and isvalid(npc.Entity) and npc.Entity.Enable
            and npc.Entity.CurrentMap == player.CurrentMap and _Util:Distance(player, npc.Entity) <= npc.TalkRange
            and _Util:HasLineOfSight(player.CurrentMap, _Util:Pos2(player), _Util:Pos2(npc.Entity))
    end

    @ExecSpace("ClientOnly")
    method void Talk()
        -- 명시적인 버튼/키 입력 한 번에 가장 가까운 대화 대상을 고정한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) or _UIKit:AnyWindowOpen() then return end
        local npc = self:FindNpc(player)
        if npc == nil then return end
        self.ActiveNpc = npc.Entity
        self.Dismissed = false
        self.Page = 1
        self.PageKey = ""
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        _SoundDirector:PlayEffect("972843e759204d3e9ad84e7d3fa94f83", 0.35)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 기존 추출/스킬/귀환 키와 겹치지 않는 대화 단축키.
        -- 대화 중에는 Space·Enter로 주 버튼(다음·수락·보상 받기)을 누른다. 마우스 없이도 의뢰를 진행할 수 있게.
        if (event.key == KeyboardKey.Space or event.key == KeyboardKey.Return) and _UIKit:IsOpen(self.Win) then
            if self.Kind == "quest" and self:ButtonShown(4) then self:Action(4) end
            return
        end
        if event.key == KeyboardKey.B and not _UIKit:IsOpen(self.Win) then self:Talk() end
    end

    @ExecSpace("ClientOnly")
    method boolean ButtonShown(integer index)
        local e = _UIKit:Get(self.Win .. "/Btn" .. tostring(index))
        return isvalid(e) and e.Enable
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 접근은 안내만 보여준다. 열린 대화는 처음 선택한 NPC에 고정한다.
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) or st == nil then
            self:Dismiss()
            _UIKit:SetEnabled(self.Prompt, false)
            return
        end
        local nearby = self:FindNpc(player)
        local show = nearby ~= nil and not _UIKit:AnyWindowOpen()
        _UIKit:SetEnabled(self.Prompt, show)
        if show then
            local hint = Environment:IsPCPlatform() and " [B]" or ""
            _UIKit:SetText(self.Prompt, _UIKit:Clip(nearby.NpcName, 12) .. " · 대화" .. hint)
        end
        if not _UIKit:IsOpen(self.Win) then self.ActiveNpc = nil end
        ---@type WorldNPC
        local npc = isvalid(self.ActiveNpc) and self.ActiveNpc:GetComponent("script.WorldNPC") or nil
        if npc == nil or not self:CanTalkTo(player, npc) or _UIKit:AnyOtherWindowOpen(self.Win) then
            if isvalid(self.ActiveNpc) or _UIKit:IsOpen(self.Win) then self:Dismiss() end
            return
        end
        self.Kind = npc.Kind
        if self.Kind == "quest" and self.PendingIndex > 0 then
            ---@type PlayerQuest
            local quest = _UIKit:Comp("script.PlayerQuest")
            if quest ~= nil and (quest.Index ~= self.PendingIndex or quest.State ~= self.PendingState) then
                -- 동기화로 성공을 확인한 뒤 닫아 보상과 다음 행동 안내가 보이게 한다.
                self:Dismiss()
                return
            end
            if _UtilLogic.ElapsedSeconds < self.PendingUntil then return end
            -- 가방 부족 등 거절 시에는 같은 의뢰에서 다시 시도할 수 있다.
            self.PendingIndex = 0
            self.PendingUntil = 0
            self.RenderKey = ""
        end
        _UIKit:SetText(self.Win .. "/Title", npc.NpcName)
        if npc.Kind == "shop" then self:RenderShop(st) else self:RenderQuest() end
    end

    @ExecSpace("ClientOnly")
    method void Dismiss()
        -- 닫은 뒤에도 근처에서 버튼으로 다시 대화할 수 있다. 자동 재열기는 없다.
        self.Dismissed = true
        self.ActiveNpc = nil
        self.Kind = ""
        self.RenderKey = ""
        self.PageKey = ""
        self.Page = 1
        self.PendingIndex = 0
        self.PendingState = 0
        self.PendingUntil = 0
        _UIKit:SetEnabled(self.Win, false)
    end

    @ExecSpace("ClientOnly")
    method void SetButtons(table labels)
        -- labels[i] = 글자 ("" = 숨김)
        for i = 1, 5 do
            local label = labels[i] or ""
            _UIKit:SetEnabled(self.Win .. "/Btn" .. tostring(i), label ~= "")
            -- PC 의뢰 대화의 주 버튼에는 키 안내를 붙인다 (처리 중 표시는 제외)
            if label ~= "" and i == 4 and self.Kind == "quest" and Environment:IsPCPlatform() and label ~= "처리 중…" then label = label .. " [Space]" end
            if label ~= "" then _UIKit:SetText(self.Win .. "/Btn" .. tostring(i), label) end
        end
    end

    -- ───────── 상점 ─────────

    @ExecSpace("ClientOnly")
    method void RenderShop(PlayerStats st)
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        if shop == nil then return end
        local key = "shop#" .. tostring(st.Gold) .. "#" .. tostring(st.Level)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local keys = { "hp", "mp", "rv", "tp", "gamble" }
        local labels = { "생명", "마나", "회복", "귀환", "도박" }
        local buttons = {}
        for i = 1, 5 do buttons[i] = labels[i] .. "  " .. tostring(shop:GetPrice(keys[i], st.Level)) end
        self:SetButtons(buttons)
        _UIKit:SetText(self.Win .. "/Paper/Body", string.format("살아 돌아왔군. 필요한 걸 골라라.  (가진 골드 %d)\n생명·마나 물약 %d · 회복 물약 %d · 귀환 두루마리 %d · 도박(무작위 마법 이상 장비) %d골드\n가방 물건을 팔려면 소지품을 열어 「판매」.",
            st.Gold, shop:GetPrice("hp", st.Level), shop:GetPrice("rv", st.Level), shop:GetPrice("tp", st.Level), shop:GetPrice("gamble", st.Level)))
    end

    -- ───────── 의뢰 ─────────

    method table Lines(string text)
        local out = {}
        for line in string.gmatch(text, "[^/]+") do table.insert(out, line) end
        return out
    end

    method string RewardText(table q)
        local reward = "보상: 경험치 " .. tostring(q.exp) .. ", 골드 " .. tostring(q.gold)
        local extra = _QuestData:RewardText(q.reward)
        if extra ~= "" then reward = reward .. ", " .. extra end
        return reward
    end

    @ExecSpace("ClientOnly")
    method void RenderQuest()
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return end
        local pageKey = tostring(quest.Index) .. "#" .. tostring(quest.State)
        if pageKey ~= self.PageKey then
            self.PageKey = pageKey
            self.Page = 1
        end
        local key = pageKey .. "#" .. tostring(quest.Progress) .. "#" .. tostring(self.Page)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local q = _QuestData:Get(quest.Index)
        local body = ""
        if q == nil then
            body = "여왕의 저주가 걷혔다... 하지만 혼각은 더 깊은 곳에서 울리고 있다."
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif quest.State == 1 then
            body = "「" .. q.title .. "」  진행 " .. tostring(quest.Progress) .. " / " .. tostring(q.count) .. "\n" .. q.desc .. "\n어서 다녀오게."
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        else
            -- 0 = 새 의뢰(소개 대사 → 수락), 2 = 완료(마무리 대사 → 보고)
            local lines = self:Lines(quest.State == 0 and q.intro or q.outro)
            if #lines == 0 then lines = { quest.State == 0 and "할 일이 있다." or "해냈군." } end
            self.PageCount = #lines + (quest.State == 0 and 1 or 0)
            local page = math.min(self.Page, self.PageCount)
            body = lines[page] or ""
            if page < self.PageCount then
                self:SetButtons({ "", "", "", "다음 ▶", "닫기" })
            elseif quest.State == 0 then
                body = "의뢰 「" .. q.title .. "」\n" .. q.desc .. "\n\n" .. self:RewardText(q)
                self:SetButtons({ "", "", "", "수락", "거절" })
            else
                body = body .. "\n\n" .. self:RewardText(q)
                self:SetButtons({ "", "", "", "보상 받기", "닫기" })
            end
        end
        _UIKit:SetText(self.Win .. "/Paper/Body", body)
    end

    @ExecSpace("ClientOnly")
    method void Action(integer index)
        -- 닫힌 창의 오래된 버튼 입력은 상점/의뢰 RPC로 보내지 않는다.
        if not _UIKit:IsOpen(self.Win) or not isvalid(self.ActiveNpc) then return end
        ---@type WorldNPC
        local npc = self.ActiveNpc:GetComponent("script.WorldNPC")
        if not self:CanTalkTo(_UserService.LocalPlayer, npc) or _UIKit:AnyOtherWindowOpen(self.Win) then return end
        if self.Kind == "shop" then
            ---@type PlayerShop
            local shop = _UIKit:Comp("script.PlayerShop")
            local keys = { "hp", "mp", "rv", "tp", "gamble" }
            if shop ~= nil and keys[index] ~= nil then shop:RequestBuy(keys[index]) end
            self.RenderKey = ""
            return
        end
        if self.Kind ~= "quest" then return end
        if index == 5 then
            self:Dismiss()
            return
        end
        if index ~= 4 then return end
        if self.PendingIndex > 0 then return end
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return end
        local displayed = tostring(quest.Index) .. "#" .. tostring(quest.State)
        if displayed ~= self.PageKey then
            -- 상태가 바뀐 직후의 클릭으로 아직 읽지 않은 다음 대화를 건너뛰지 않는다.
            self.RenderKey = ""
            self:Poll()
            return
        end
        -- 다음 대사, 마지막이면 수락 / 보고
        if self.Page < self.PageCount then
            self.Page = self.Page + 1
        else
            if quest.State ~= 0 and quest.State ~= 2 then return end
            -- 서버 RPC의 expectedIndex와 같은 번호를 보관해 성공 동기화를 기다린다.
            self.PendingIndex = quest.Index
            self.PendingState = quest.State
            self.PendingUntil = _UtilLogic.ElapsedSeconds + 3
            self:SetButtons({ "", "", "", "처리 중…", "닫기" })
            if quest.State == 0 then quest:RequestAccept(quest.Index) else quest:RequestTurnIn(quest.Index) end
        end
        self.RenderKey = ""
    end

end
