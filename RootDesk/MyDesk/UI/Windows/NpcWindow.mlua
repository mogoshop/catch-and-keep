-- NPC 대화 창: 근처에서는 대화 버튼만 표시한다. 버튼/Space(B) 키로 선택했을 때 열고, 거리·맵이 바뀌면 닫는다.
--   shop  = 잿빛 행상: 「거래」로 거래 창(ShopWindow — 살 물건 · 가방 판매)을 연다
--   merchant = 떠돌이 상인: 10분마다 바뀌는 장비 5개 — 「물건 보기」로 목록 창(MerchantWindow)을 연다
--   smith = 대장장이: 「물건 고르기」로 소지품을 대장장이 모드로 연다 (옵션 바꾸기 · 소켓 뚫기)
--   stash = 창고: 대화 대신 창고 창(StashWindow)을 바로 연다
--   quest = D2처럼 말을 건 뒤 의뢰를 받는다: 소개 대사(다음 ▶) → 의뢰 내용·보상 → 수락/거절 → PlayerQuest.
--           완료하면 마무리 대사 → 보고(보상). 대사는 quests.csv intro·outro ("/"로 줄 나눔)
--   의뢰인(giver)이 대장장이인 의뢰는 대장장이에게 말을 걸면 의뢰 대화가 먼저 나온다 (진행 중에는 평소 메뉴).
--   caravan = 카라반 대장: 액트 사이 이동 (잿불 야영지 ↔ 오아시스 시장, 앞 액트 보스를 쓰러뜨려야 열림) + 의뢰
--   captain = 선장 (소금바람 항구): 카라반과 같은 창. 카라반·선장 모두 열린 다른 액트 마을로 데려다준다 (docs/design/17 §6)
--   scholar · apothecary = 액트 2 의뢰인, harbormaster · keeperdaughter = 액트 3 의뢰인 (자기 의뢰 차례가 아니면 한마디만)
@Logic
script NpcWindow extends Logic

    property string Win = "NpcWin"
    property string Kind = ""
    property string NpcKind = ""            -- 말을 건 NPC의 원래 종류 (대장장이가 의뢰 대화 중이면 Kind = quest)
    property string RenderKey = ""
    property integer TimerId = 0
    property integer Page = 1
    property string PageKey = ""            -- 의뢰 번호·상태가 바뀌면 대사를 처음부터
    property boolean Dismissed = false      -- 닫기를 누른 뒤 NPC에게서 멀어질 때까지 열지 않음
    property integer PageCount = 1
    property string Prompt = "/ui/InteractionHUD/SafeArea/Talk"
    property Entity ActiveNpc = nil
    property integer PendingIndex = 0
    property integer PendingState = 0
    property number PendingUntil = 0
    property string TypeFull = ""            -- 글자 차례 출력 중인 대사 (강조 기호 포함 원문)
    property number TypeShown = 0
    property integer TypeTotal = 0
    property number TypeSpeed = 45           -- 초당 글자 수
    property number PaperHeight = 150        -- 글 칸 높이 (ui-tokens.cjs DIALOG.npcPaperH · 너비·여백은 UIKit 대화 상자 규격)
    property number ArtReserve = 186         -- 의뢰 그림(170) + 칸 사이(16)
    property string CheerText = ""           -- 액트 보스를 쓰러뜨린 뒤의 격려 한마디 (말을 건 첫 쪽, docs/design/31 §7)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 가까이 지나가는 것만으로 대화가 이동을 막지 않게 한다.
        self.ActiveNpc = nil
        self.PendingIndex = 0
        self.PendingState = 0
        self.PendingUntil = 0
        _UIKit:RegisterWindow(self.Win)
        _UIKit:SetEnabled(self.Prompt, false)
        _UIKit:Connect(self.Prompt, function() self:Talk() end)
        local prompt = _UIKit:Get(self.Prompt)
        -- 모바일은 가운데 아래 소환수 줄 바로 위 (docs/ui/mobile-layout.md). 화면 한가운데 떠 있으면 위치가 뜬금없었다
        if isvalid(prompt) then prompt.UITransformComponent.anchoredPosition = Vector2(0, Environment:IsMobilePlatform() and 296 or 280) end
        for i = 1, 5 do
            local index = i
            _UIKit:Connect(self.Win .. "/Btn" .. tostring(i), function() self:Action(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnClose", function() self:Dismiss() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 세션 종료 시 대화 대상과 안내를 함께 지운다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self.ActiveNpc = nil
        _UIKit:SetEnabled(self.Prompt, false)
    end

    @ExecSpace("ClientOnly")
    method WorldNPC FindNpc(Entity player)
        -- 맵을 전환하는 짧은 구간의 입력에서도 nil 맵을 읽지 않는다.
        if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
        local best = nil
        local bestDist = 999
        local p = _Util:Pos2(player)
        for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.WorldNPC", true)) do
            ---@type WorldNPC
            local npc = c
            local d = (_Util:Pos2(c.Entity) - p):Magnitude()
            if d < bestDist and self:CanTalkTo(player, npc) then
                bestDist = d
                best = npc
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method boolean CanTalkTo(Entity player, WorldNPC npc)
        -- 벽 너머·다른 맵·사망·비활성 NPC와는 대화하지 않는다.
        return isvalid(player) and _Util:IsAlive(player) and npc ~= nil and isvalid(npc.Entity) and npc.Entity.Enable
            and npc.Entity.CurrentMap == player.CurrentMap and _Util:Distance(player, npc.Entity) <= npc.TalkRange
            and _Util:HasLineOfSight(player.CurrentMap, _Util:Pos2(player), _Util:Pos2(npc.Entity))
    end

    @ExecSpace("ClientOnly")
    method void Talk()
        -- 명시적인 버튼/키 입력 한 번에 가장 가까운 대화 대상을 고정한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) or _UIKit:AnyWindowOpen() then return end
        local npc = self:FindNpc(player)
        if npc == nil then
            -- 근처에 NPC가 없으면 웨이포인트 창 (B·대화 버튼 하나로)
            _WaypointWindow:OpenNear()
            return
        end
        if npc.Kind == "stash" then
            _StashWindow:Open()
            return
        end
        if npc.Kind == "merchant" then
            ---@type PlayerShop
            local shop = _UIKit:Comp("script.PlayerShop")
            if shop ~= nil then shop:RequestOpenMerchant() end
        end
        self.ActiveNpc = npc.Entity
        self.CheerText = ""
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local act = _GameConst:ActOfMap(player.CurrentMap.Name)
        if quest ~= nil and quest:CheerWaiting(act, npc.Kind) then
            self.CheerText = _GameData:GetStory("cheer_" .. tostring(act) .. "_" .. npc.Kind)
            quest:RequestCheer(act, npc.Kind)
        end
        local stand = isvalid(npc.Entity.SpriteRendererComponent) and npc.Entity.SpriteRendererComponent.SpriteRUID or ""
        _UIKit:SetPortrait(self.Win .. "/PortraitBox/Portrait", stand)
        self.TypeTotal = 0
        self:ShowPage(1, 1, 0)
        self.Dismissed = false
        self.Page = 1
        self.PageKey = ""
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        _SoundDirector:PlayEffect("972843e759204d3e9ad84e7d3fa94f83", 0.35)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 기존 추출/스킬/귀환 키와 겹치지 않는 대화 단축키.
        -- 대화 중에는 Space·Enter로 주 버튼(다음·수락·보상 받기)을 누른다. 마우스 없이도 의뢰를 진행할 수 있게.
        if _StoryCard.Active then return end   -- 이야기 카드가 Space를 쓴다
        if (event.key == KeyboardKey.Space or event.key == KeyboardKey.Return) and _UIKit:IsOpen(self.Win) then
            if self.CheerText ~= "" or (self.Kind == "quest" and self:ButtonShown(4)) then self:Action(4) end
            return
        end
        -- 10-11 팀 QA: 대화 키가 B라 찾기 어려웠다 → Space로 연다 (B도 그대로 둔다)
        if (event.key == KeyboardKey.Space or event.key == KeyboardKey.B) and not _UIKit:IsOpen(self.Win) then self:Talk() end
    end

    @ExecSpace("ClientOnly")
    method boolean ButtonShown(integer index)
        local e = _UIKit:Get(self.Win .. "/Btn" .. tostring(index))
        return isvalid(e) and e.Enable
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 접근은 안내만 보여준다. 열린 대화는 처음 선택한 NPC에 고정한다.
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) or st == nil then
            self:Dismiss()
            _UIKit:SetEnabled(self.Prompt, false)
            return
        end
        local nearby = self:FindNpc(player)
        -- NPC가 없어도 웨이포인트 위면 같은 안내 버튼으로 연다 (Space·B · 버튼 터치 → Talk → OpenNear)
        local nearWp = nearby == nil and _Util:NearestComponent(player.CurrentMap, "script.Waypoint", _Util:Pos2(player), _WaypointWindow.Reach) ~= nil
        local show = (nearby ~= nil or nearWp) and not _UIKit:AnyWindowOpen()
        _UIKit:SetEnabled(self.Prompt, show)
        if show then
            -- PC는 「[Space] 이름」, 모바일은 「이름 · 대화」. 너비는 이름 길이에 맞춘다 (공통 SetFitText)
            local name = nearby ~= nil and nearby.NpcName or "웨이포인트"
            local text = Environment:IsPCPlatform() and ("[Space] " .. name) or (name .. (nearby ~= nil and " · 대화" or " · 열기"))
            _UIKit:SetFitText(self.Prompt, text, 28, 56, 300, 640)
        end
        if not _UIKit:IsOpen(self.Win) then self.ActiveNpc = nil end
        ---@type WorldNPC
        local npc = isvalid(self.ActiveNpc) and self.ActiveNpc:GetComponent("script.WorldNPC") or nil
        if npc == nil or not self:CanTalkTo(player, npc) or _UIKit:AnyOtherWindowOpen(self.Win) then
            if isvalid(self.ActiveNpc) or _UIKit:IsOpen(self.Win) then self:Dismiss() end
            return
        end
        self.Kind = npc.Kind
        self.NpcKind = npc.Kind
        if npc.Kind ~= "quest" and self:GiverWaiting(npc.Kind) then self.Kind = "quest" end
        if self.Kind == "quest" and self.PendingIndex > 0 then
            ---@type PlayerQuest
            local quest = _UIKit:Comp("script.PlayerQuest")
            if quest ~= nil and (quest.Index ~= self.PendingIndex or quest.State ~= self.PendingState) then
                -- 동기화로 성공을 확인한 뒤 닫아 보상과 다음 행동 안내가 보이게 한다.
                self:Dismiss()
                return
            end
            if _UtilLogic.ElapsedSeconds < self.PendingUntil then return end
            -- 가방 부족 등 거절 시에는 같은 의뢰에서 다시 시도할 수 있다.
            self.PendingIndex = 0
            self.PendingUntil = 0
            self.RenderKey = ""
        end
        _UIKit:SetText(self.Win .. "/Title", npc.NpcName)
        if self.CheerText ~= "" then
            if self.RenderKey ~= "cheer" then
                self.RenderKey = "cheer"
                self:SetButtons({ "", "", "", "계속 ▶", "닫기" })
                self:ShowPage(1, 1, 0)
                self:ShowBody(self.CheerText, true)
            end
            return
        end
        if self.Kind == "shop" then self:RenderShop(st)
        elseif self.Kind == "merchant" then self:RenderMerchant(st)
        elseif self.Kind == "smith" then self:RenderSmith(st)
        elseif self.Kind == "caravan" or self.Kind == "captain" or self.Kind == "scout" then self:RenderCaravan()
        else self:RenderQuest() end
    end

    @ExecSpace("ClientOnly")
    method table CaravanTargets()
        -- 지금 액트가 아닌 다른 액트들 (버튼 2·3·4). 카라반(야영지·오아시스)·선장(항구)·정찰병(초소) 모두 열린 액트로 데려다준다
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        local out = {}
        if travel == nil then return out end
        for a = 1, _GameConst.ActCount do
            if a ~= travel.Act then table.insert(out, a) end
        end
        return out
    end

    @ExecSpace("ClientOnly")
    method void RenderCaravan()
        -- 카라반 대장·선장: 다른 액트 마을로. 열린 액트는 버튼, 잠긴 다음 액트는 이유 한 줄
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        if travel == nil then return end
        local targets = self:CaravanTargets()
        ---@type PlayerQuest
        local q0 = _UIKit:Comp("script.PlayerQuest")
        local key = self.NpcKind .. "#" .. tostring(travel.Act) .. "#" .. (q0 ~= nil and q0:StoryStage() or "")
        for _, a in ipairs(targets) do key = key .. "#" .. tostring(travel:ActUnlocked(a)) end
        if key == self.RenderKey then return end
        self.RenderKey = key
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local body = quest ~= nil and quest:StoryLine("idle_" .. self.NpcKind) or ""
        if body == "" then body = self:Stock(self.NpcKind, "travel") end
        local buttons = { "", "", "", "", "닫기" }
        local slot = 2
        local locked = ""
        for _, a in ipairs(targets) do
            if travel:ActUnlocked(a) then
                buttons[slot] = _GameConst:WithRo(_GameConst:ActTownName(a))
                slot = slot + 1
            elseif locked == "" then
                locked = _UIKit:StoryText(_GameData:GetStory("lock_act" .. tostring(a)), -1)
            end
        end
        if locked ~= "" then body = body .. "\n<color=#9C9488>" .. locked .. "</color>" end
        self:SetButtons(buttons)
        _UIKit:SetText(self.Win .. "/Paper/Body", body)
    end

    @ExecSpace("ClientOnly")
    method string Stock(string kind, string key)
        -- NPC가 공통으로 하는 짧은 말 (의뢰 진행 중·다른 의뢰인 차례·이동 인사)을 그 인물의 말투로 (npcs.csv voice, docs/design/32)
        -- done·wait는 string.format(의뢰 이름, 의뢰인 이름)
        local v = _QuestData:Voice(kind)
        local T = {
            haera = { go = "어서 다녀오너라.", none = "지금은 할 이야기가 없다.", travel = "어디로 갈 테냐?",
                done = "「%s」 일을 해냈다고? %s에게 알려라. 보상은 그쪽에서 받을 거다.", wait = "「%s」 일로 %s 쪽에서 너를 찾고 있다. 먼저 가 보아라." },
            hage = { go = "어서 다녀오게.", none = "지금은 할 이야기가 없네.", travel = "어디로 가겠나?",
                done = "「%s」 일을 해냈다고? %s에게 알려 주게. 보상은 그쪽에서 받을 걸세.", wait = "「%s」 일로 %s 쪽에서 자네를 찾고 있더군. 먼저 가 보게." },
            haeyo = { go = "조심해서 다녀오세요.", none = "지금은 드릴 말씀이 없어요.", travel = "어디로 가실 건가요?",
                done = "「%s」 일을 해내셨군요! %s에게 알려 주세요. 보상은 그쪽에서 받으실 거예요.", wait = "「%s」 일로 %s 쪽에서 당신을 찾고 있어요. 먼저 가 보세요." },
            hasipsio = { go = "조심히 다녀오십시오.", none = "지금은 드릴 말씀이 없습니다.", travel = "어디로 모실까요?",
                done = "「%s」 일을 해내셨군요. %s에게 알려 주십시오. 보상은 그쪽에서 받으실 겁니다.", wait = "「%s」 일로 %s 쪽에서 손님을 찾고 있습니다. 먼저 가 보십시오." },
            hao = { go = "조심히 다녀오시오.", none = "지금은 할 이야기가 없소.", travel = "어디로 가시겠소?",
                done = "「%s」 일을 해냈다니 대단하오. %s에게 알리시오. 보상은 그쪽에서 받을 거요.", wait = "「%s」 일로 %s 쪽에서 당신을 찾고 있소. 먼저 가 보시오." },
        }
        local set = T[v] or T.haera
        return set[key] or ""
    end

    @ExecSpace("ClientOnly")
    method string IdleLine(string kind)
        -- 자기 의뢰 차례가 아닐 때 마을 사람의 한마디: 이야기 단계별 (story.csv idle_<종류>_<단계>, docs/design/31)
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local line = quest ~= nil and quest:StoryLine("idle_" .. kind) or ""
        if line == "" then line = self:Stock(kind, "none") end
        return line
    end

    @ExecSpace("ClientOnly")
    method boolean GiverWaiting(string kind)
        -- 이 NPC가 지금 의뢰의 의뢰인이고 받기/보고 차례인가 (진행 중이면 평소 메뉴)
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return false end
        local q = _QuestData:Get(quest.Index)
        return q ~= nil and q.giver == kind and quest.State ~= 1
    end

    @ExecSpace("ClientOnly")
    method void Dismiss()
        -- 닫은 뒤에도 근처에서 버튼으로 다시 대화할 수 있다. 자동 재열기는 없다.
        self.Dismissed = true
        self.ActiveNpc = nil
        self.CheerText = ""
        self.Kind = ""
        self.RenderKey = ""
        self.PageKey = ""
        self.Page = 1
        self.PendingIndex = 0
        self.PendingState = 0
        self.PendingUntil = 0
        self.TypeTotal = 0
        _UIKit:SetEnabled(self.Win, false)
    end

    @ExecSpace("ClientOnly")
    method void SetButtons(table labels)
        -- labels[i] = 글자 ("" = 숨김)
        for i = 1, 5 do
            local label = labels[i] or ""
            _UIKit:SetEnabled(self.Win .. "/Btn" .. tostring(i), label ~= "")
            -- PC 의뢰 대화의 주 버튼에는 키 안내를 붙인다 (처리 중 표시는 제외)
            if label ~= "" and i == 4 and self.Kind == "quest" and Environment:IsPCPlatform() and label ~= "처리 중…" then label = label .. " <size=15><color=#B8AE9C>Space</color></size>" end
            if label ~= "" then _UIKit:SetText(self.Win .. "/Btn" .. tostring(i), label) end
        end
    end

    -- ───────── 상점 ─────────

    @ExecSpace("ClientOnly")
    method void RenderShop(PlayerStats st)
        -- 잿빛 행상: 인사 + 「거래」(거래 창 — 왼쪽 살 물건 · 오른쪽 가방). 버튼에 물건을 넣지 않는다
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        if shop == nil then return end
        local diff = shop:ShopDifficulty()
        local key = "shop#" .. tostring(st.Gold) .. "#" .. tostring(diff)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local tiers = { "하급 물약", "중급 물약까지", "고급 물약까지" }
        self:SetButtons({ "", "", "", "거래", "닫기" })
        -- 인사: 고르(정체가 드러나기 전) / 카라반 보급관 (docs/design/31 §5)
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local stage = quest ~= nil and quest:StoryStage() or "0"
        local hello = quest ~= nil and quest:StoryLine((stage == "r" or stage == "4") and "idle_qm" or "idle_shop") or ""
        if hello == "" then hello = "물약이 필요하십니까, 아니면 짐을 덜고 싶으십니까?" end
        _UIKit:SetText(self.Win .. "/Paper/Body", string.format("%s\n<color=#9C9488>파는 물건: %s · 귀환 두루마리 · 도박 — 안 쓰는 물건은 팔 수 있다 · 가진 골드 %d</color>", hello, tiers[diff + 1] or tiers[1], st.Gold))
    end

    method table StockList()
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        local list = {}
        if shop == nil or shop.StockDigest == "" then return list end
        for x in string.gmatch(shop.StockDigest .. ";", "([^;]*);") do table.insert(list, x) end
        return list
    end

    @ExecSpace("ClientOnly")
    method void RenderMerchant(PlayerStats st)
        -- 떠돌이 상인: 인사 + 「물건 보기」(물건 목록 창 — 그림·이름·옵션을 보고 산다). 버튼에 물건 이름을 넣지 않는다
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        if shop == nil then return end
        local left = math.max(0, math.ceil(shop.StockNextAt - _UtilLogic.ServerElapsedSeconds))
        local count = 0
        for _, s in ipairs(self:StockList()) do if s ~= "" then count = count + 1 end end
        local key = "merchant#" .. tostring(count) .. "#" .. tostring(st.Gold) .. "#" .. tostring(math.floor(left / 10))
        if key == self.RenderKey then return end
        self.RenderKey = key
        self:SetButtons({ "", "", "", "물건 보기", "닫기" })
        local body = string.format("먼 길을 왔소. 오늘 들고 온 장비가 %d점 남았소.\n그림과 옵션을 보고 고르시오.\n<color=#9C9488>가진 골드 %d · 다음 입고 %d분 %02d초</color>", count, st.Gold, left // 60, left % 60)
        -- 말을 건 직후 서버가 짐을 풀기 전(입고 시각 0)에는 「다 팔렸다」가 아니라 짐 푸는 중
        if count == 0 then body = shop.StockNextAt <= 0 and "짐을 푸는 중이오… 잠시만 기다리시오." or ("오늘 물건은 다 팔렸소.\n<color=#9C9488>다음 입고까지 " .. string.format("%d분 %02d초", left // 60, left % 60) .. "</color>") end
        _UIKit:SetText(self.Win .. "/Paper/Body", body)
    end

    @ExecSpace("ClientOnly")
    method void RenderSmith(PlayerStats st)
        ---@type PlayerInventory
        local inv = _UIKit:Comp("script.PlayerInventory")
        local tokens = inv ~= nil and inv.SocketTokens or 0
        local key = "smith#" .. tostring(st.Gold) .. "#" .. tostring(tokens)
        if key == self.RenderKey then return end
        self.RenderKey = key
        self:SetButtons({ "", "", "", "물건 고르기", "닫기" })
        -- 첫마디는 진행에 따라 (교단 기록을 찾은 3번 의뢰 뒤로는 혼각 이야기)
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local idle = quest ~= nil and quest:StoryLine("idle_smith") or ""
        if quest ~= nil and quest:StoryStage() == "0" and quest.Index > 3 then idle = _GameData:GetStory("idle_smith_q3") end
        _UIKit:SetText(self.Win .. "/Paper/Body", string.format("%s 소지품에서 물건을 고르면 손봐 주지.  (가진 골드 %d)\n· 옵션 바꾸기: 마법·레어 장비의 옵션을 새로 새긴다 (레벨이 높을수록 비쌈, 레어는 3배)\n· 소켓 뚫기: 소켓 없는 무기·등불·투구·갑옷. 소켓권 %d장 — 소켓권이 있으면 확실히, 없으면 골드로 %d%% 확률\n  (일반 2~최대 · 마법 1~2 · 레어·유니크·세트 1개)",
            idle, st.Gold, tokens, math.floor(_GameData.punchChance * 100 + 0.5)))
    end

    -- ───────── 의뢰 ─────────

    method table Lines(string text)
        local out = {}
        for line in string.gmatch(text, "[^/]+") do table.insert(out, line) end
        return out
    end

    method string RewardText(table q)
        -- 대표 보상을 앞에, 경험치는 주는 의뢰만 (14장 §2). 악몽·지옥 배율은 보고할 때 붙는다
        local extra = _QuestData:RewardText(q.reward)
        local parts = {}
        if extra ~= "" then table.insert(parts, extra) end
        if q.exp > 0 then table.insert(parts, "경험치 " .. tostring(q.exp)) end
        table.insert(parts, "골드 " .. tostring(q.gold))
        return "보상: " .. table.concat(parts, ", ")
    end

    @ExecSpace("ClientOnly")
    method void RenderQuest()
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return end
        local pageKey = tostring(quest.Index) .. "#" .. tostring(quest.State)
        if pageKey ~= self.PageKey then
            self.PageKey = pageKey
            self.Page = 1
        end
        local key = pageKey .. "#" .. tostring(quest.Progress) .. "#" .. tostring(self.Page)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local q = _QuestData:Get(quest.Index)
        local body = ""
        if self.NpcKind ~= "quest" and (q == nil or q.giver ~= self.NpcKind) then
            body = self:IdleLine(self.NpcKind)
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif q == nil then
            body = _GameData:GetStory("all_done")
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif self.NpcKind == "quest" and q.act > 1 then
            -- 액트 1을 끝낸 뒤의 오렌: 사막으로 보낸다
            body = quest:StoryLine("idle_quest")
            if body == "" then body = "조각을 찾아라. 목소리가 그렇게 말했다." end
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif q.giver ~= self.NpcKind and quest.State ~= 1 then
            -- 다른 의뢰인의 차례: 그 사람에게 보낸다
            local who = _QuestData:GiverName(q.giver)
            body = string.format(self:Stock(self.NpcKind, quest.State == 2 and "done" or "wait"), q.title, who)
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif quest.State == 1 then
            local count = quest:CountFor(q)
            local progress = count > 0 and ("  진행 " .. tostring(quest.Progress) .. " / " .. tostring(count)) or ""
            body = "「" .. q.title .. "」" .. progress .. "\n" .. q.desc .. "\n" .. self:Stock(self.NpcKind, "go")
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        else
            -- 0 = 새 의뢰(소개 대사 → 수락), 2 = 완료(마무리 대사 → 보고)
            local lines = self:Lines(quest.State == 0 and q.intro or q.outro)
            if #lines == 0 then lines = { quest.State == 0 and "할 일이 있다." or "해냈군." } end
            self.PageCount = #lines + (quest.State == 0 and 1 or 0)
            local page = math.min(self.Page, self.PageCount)
            body = lines[page] or ""
            local accept = false
            if page < self.PageCount then
                self:SetButtons({ "", "", "", "다음 ▶", "닫기" })
            elseif quest.State == 0 then
                body = "의뢰 「" .. q.title .. "」\n" .. q.desc .. "\n\n" .. self:RewardText(q)
                accept = true
                self:SetButtons({ "", "", "", "수락", "거절" })
            else
                body = body .. "\n\n" .. self:RewardText(q)
                self:SetButtons({ "", "", "", "보상 받기", "닫기" })
            end
            self:ShowPage(page, self.PageCount, accept and quest.Index or 0)
            self:ShowBody(body, not accept)
            return
        end
        self:ShowPage(1, 1, 0)
        self:ShowBody(body, false)
    end

    @ExecSpace("ClientOnly")
    method void ShowPage(integer page, integer count, integer artIndex)
        -- 「2 / 4」 쪽 표시, 의뢰 수락 쪽이면 오른쪽에 의뢰 그림 (그만큼 글 칸을 좁힌다)
        _UIKit:SetText(self.Win .. "/Paper/PageNo", count > 1 and (tostring(page) .. " / " .. tostring(count)) or "")
        local art = artIndex > 0 and _GameData:GetUiIcon("quest_art" .. tostring(artIndex)) or ""
        _UIKit:SetIcon(self.Win .. "/Art", art)
        _UIKit:LayoutDialog(self.Win, true, self.PaperHeight, art ~= "" and self.ArtReserve or 0)
    end

    @ExecSpace("ClientOnly")
    method void ShowBody(string text, boolean typed)
        -- 대사는 글자가 차례로 나온다 (Space·다음 ▶으로 바로 끝까지). 강조: {장소} 금색 · [적] 붉은색
        if typed then
            self.TypeFull = text
            self.TypeShown = 0
            self.TypeTotal = _UIKit:StoryLength(text)
            _UIKit:SetText(self.Win .. "/Paper/Body", "")
        else
            self.TypeTotal = 0
            _UIKit:SetText(self.Win .. "/Paper/Body", _UIKit:StoryText(text, -1))
        end
    end

    @ExecSpace("ClientOnly")
    method boolean FinishTyping()
        -- 글자가 나오는 중이면 끝까지 보여 주고 true (이번 입력은 넘기기로 쓰지 않는다)
        if self.TypeTotal <= 0 or self.TypeShown >= self.TypeTotal then return false end
        self.TypeShown = self.TypeTotal
        _UIKit:SetText(self.Win .. "/Paper/Body", _UIKit:StoryText(self.TypeFull, -1))
        return true
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if self.TypeTotal <= 0 or self.TypeShown >= self.TypeTotal or (self.Kind ~= "quest" and self.CheerText == "") or not _UIKit:IsOpen(self.Win) then return end
        local before = math.floor(self.TypeShown)
        self.TypeShown = math.min(self.TypeTotal, self.TypeShown + delta * self.TypeSpeed)
        local now = math.floor(self.TypeShown)
        if now ~= before then _UIKit:SetText(self.Win .. "/Paper/Body", _UIKit:StoryText(self.TypeFull, now)) end
    end

    @ExecSpace("ClientOnly")
    method void Action(integer index)
        -- 닫힌 창의 오래된 버튼 입력은 상점/의뢰 RPC로 보내지 않는다.
        if not _UIKit:IsOpen(self.Win) or not isvalid(self.ActiveNpc) then return end
        ---@type WorldNPC
        local npc = self.ActiveNpc:GetComponent("script.WorldNPC")
        if not self:CanTalkTo(_UserService.LocalPlayer, npc) or _UIKit:AnyOtherWindowOpen(self.Win) then return end
        if self.CheerText ~= "" then
            -- 격려 한마디 → 계속(평소 대화) / 닫기
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                if self:FinishTyping() then return end
                self.CheerText = ""
                self.RenderKey = ""
                self:Poll()
            end
            return
        end
        if self.Kind == "shop" then
            -- 거래 = 거래 창 (이 대화 창은 닫는다)
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                local name = npc.NpcName
                self:Dismiss()
                _ShopWindow:Open(name)
            end
            return
        end
        if self.Kind == "merchant" then
            -- 물건 보기 = 물건 목록 창 (이 대화 창은 닫는다)
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                self:Dismiss()
                _MerchantWindow:Open()
            end
            return
        end
        if self.Kind == "smith" then
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                -- 소지품을 대장장이 모드로 연다 (이 창은 닫힌다)
                self:Dismiss()
                _InventoryWindow:OpenSmith()
            end
            return
        end
        if self.Kind == "caravan" or self.Kind == "captain" or self.Kind == "scout" then
            if index == 5 then self:Dismiss() return end
            if index >= 2 and index <= 4 then
                -- 버튼 2·3·4 = 열린 다른 액트 (RenderCaravan과 같은 순서)
                ---@type PlayerTravel
                local travel = _UIKit:Comp("script.PlayerTravel")
                if travel == nil then return end
                local open = {}
                for _, a in ipairs(self:CaravanTargets()) do
                    if travel:ActUnlocked(a) then table.insert(open, a) end
                end
                local target = open[index - 1]
                self:Dismiss()
                if target ~= nil then travel:RequestActTravel(target) end
            end
            return
        end
        if self.Kind ~= "quest" then
            if index == 5 then self:Dismiss() end
            return
        end
        if index == 5 then
            self:Dismiss()
            return
        end
        if index ~= 4 then return end
        if self:FinishTyping() then return end
        if self.PendingIndex > 0 then return end
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return end
        local displayed = tostring(quest.Index) .. "#" .. tostring(quest.State)
        if displayed ~= self.PageKey then
            -- 상태가 바뀐 직후의 클릭으로 아직 읽지 않은 다음 대화를 건너뛰지 않는다.
            self.RenderKey = ""
            self:Poll()
            return
        end
        -- 다음 대사, 마지막이면 수락 / 보고
        if self.Page < self.PageCount then
            self.Page = self.Page + 1
        else
            if quest.State ~= 0 and quest.State ~= 2 then return end
            -- 서버 RPC의 expectedIndex와 같은 번호를 보관해 성공 동기화를 기다린다.
            self.PendingIndex = quest.Index
            self.PendingState = quest.State
            self.PendingUntil = _UtilLogic.ElapsedSeconds + 3
            self:SetButtons({ "", "", "", "처리 중…", "닫기" })
            if quest.State == 0 then quest:RequestAccept(quest.Index) else quest:RequestTurnIn(quest.Index) end
        end
        self.RenderKey = ""
    end

end
