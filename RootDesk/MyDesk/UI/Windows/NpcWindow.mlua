-- NPC 대화 창: 근처에서는 대화 버튼만 표시한다. 버튼/B 키로 선택했을 때 열고, 거리·맵이 바뀌면 닫는다.
--   shop  = 잿빛 행상: 「거래」로 거래 창(ShopWindow — 살 물건 · 가방 판매)을 연다
--   merchant = 떠돌이 상인: 10분마다 바뀌는 장비 5개 — 「물건 보기」로 목록 창(MerchantWindow)을 연다
--   smith = 대장장이: 「물건 고르기」로 소지품을 대장장이 모드로 연다 (옵션 바꾸기 · 소켓 뚫기)
--   stash = 창고: 대화 대신 창고 창(StashWindow)을 바로 연다
--   quest = D2처럼 말을 건 뒤 의뢰를 받는다: 소개 대사(다음 ▶) → 의뢰 내용·보상 → 수락/거절 → PlayerQuest.
--           완료하면 마무리 대사 → 보고(보상). 대사는 quests.csv intro·outro ("/"로 줄 나눔)
--   의뢰인(giver)이 대장장이인 의뢰는 대장장이에게 말을 걸면 의뢰 대화가 먼저 나온다 (진행 중에는 평소 메뉴).
--   caravan = 카라반 대장: 액트 사이 이동 (잿불 야영지 ↔ 오아시스 시장, 앞 액트 보스를 쓰러뜨려야 열림) + 의뢰
--   scholar · apothecary = 액트 2 의뢰인 (자기 의뢰 차례가 아니면 한마디만)
@Logic
script NpcWindow extends Logic

    property string Win = "NpcWin"
    property string Kind = ""
    property string NpcKind = ""            -- 말을 건 NPC의 원래 종류 (대장장이가 의뢰 대화 중이면 Kind = quest)
    property string RenderKey = ""
    property integer TimerId = 0
    property integer Page = 1
    property string PageKey = ""            -- 의뢰 번호·상태가 바뀌면 대사를 처음부터
    property boolean Dismissed = false      -- 닫기를 누른 뒤 NPC에게서 멀어질 때까지 열지 않음
    property integer PageCount = 1
    property string Prompt = "/ui/InteractionHUD/SafeArea/Talk"
    property Entity ActiveNpc = nil
    property integer PendingIndex = 0
    property integer PendingState = 0
    property number PendingUntil = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 가까이 지나가는 것만으로 대화가 이동을 막지 않게 한다.
        self.ActiveNpc = nil
        self.PendingIndex = 0
        self.PendingState = 0
        self.PendingUntil = 0
        _UIKit:RegisterWindow(self.Win)
        _UIKit:SetEnabled(self.Prompt, false)
        _UIKit:Connect(self.Prompt, function() self:Talk() end)
        local prompt = _UIKit:Get(self.Prompt)
        -- 모바일은 생명·마나 구슬 바로 위(가운데 아래)에 둔다. 화면 한가운데 떠 있으면 위치가 뜬금없었다
        if isvalid(prompt) then prompt.UITransformComponent.anchoredPosition = Vector2(0, Environment:IsMobilePlatform() and 170 or 280) end
        for i = 1, 5 do
            local index = i
            _UIKit:Connect(self.Win .. "/Btn" .. tostring(i), function() self:Action(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnClose", function() self:Dismiss() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 세션 종료 시 대화 대상과 안내를 함께 지운다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self.ActiveNpc = nil
        _UIKit:SetEnabled(self.Prompt, false)
    end

    @ExecSpace("ClientOnly")
    method WorldNPC FindNpc(Entity player)
        -- 맵을 전환하는 짧은 구간의 입력에서도 nil 맵을 읽지 않는다.
        if not isvalid(player) or not isvalid(player.CurrentMap) then return nil end
        local best = nil
        local bestDist = 999
        local p = _Util:Pos2(player)
        for _, c in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.WorldNPC", true)) do
            ---@type WorldNPC
            local npc = c
            local d = (_Util:Pos2(c.Entity) - p):Magnitude()
            if d < bestDist and self:CanTalkTo(player, npc) then
                bestDist = d
                best = npc
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method boolean CanTalkTo(Entity player, WorldNPC npc)
        -- 벽 너머·다른 맵·사망·비활성 NPC와는 대화하지 않는다.
        return isvalid(player) and _Util:IsAlive(player) and npc ~= nil and isvalid(npc.Entity) and npc.Entity.Enable
            and npc.Entity.CurrentMap == player.CurrentMap and _Util:Distance(player, npc.Entity) <= npc.TalkRange
            and _Util:HasLineOfSight(player.CurrentMap, _Util:Pos2(player), _Util:Pos2(npc.Entity))
    end

    @ExecSpace("ClientOnly")
    method void Talk()
        -- 명시적인 버튼/키 입력 한 번에 가장 가까운 대화 대상을 고정한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) or _UIKit:AnyWindowOpen() then return end
        local npc = self:FindNpc(player)
        if npc == nil then
            -- 근처에 NPC가 없으면 웨이포인트 창 (B·대화 버튼 하나로)
            _WaypointWindow:OpenNear()
            return
        end
        if npc.Kind == "stash" then
            _StashWindow:Open()
            return
        end
        if npc.Kind == "merchant" then
            ---@type PlayerShop
            local shop = _UIKit:Comp("script.PlayerShop")
            if shop ~= nil then shop:RequestOpenMerchant() end
        end
        self.ActiveNpc = npc.Entity
        self.Dismissed = false
        self.Page = 1
        self.PageKey = ""
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        _SoundDirector:PlayEffect("972843e759204d3e9ad84e7d3fa94f83", 0.35)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 기존 추출/스킬/귀환 키와 겹치지 않는 대화 단축키.
        -- 대화 중에는 Space·Enter로 주 버튼(다음·수락·보상 받기)을 누른다. 마우스 없이도 의뢰를 진행할 수 있게.
        if (event.key == KeyboardKey.Space or event.key == KeyboardKey.Return) and _UIKit:IsOpen(self.Win) then
            if self.Kind == "quest" and self:ButtonShown(4) then self:Action(4) end
            return
        end
        if event.key == KeyboardKey.B and not _UIKit:IsOpen(self.Win) then self:Talk() end
    end

    @ExecSpace("ClientOnly")
    method boolean ButtonShown(integer index)
        local e = _UIKit:Get(self.Win .. "/Btn" .. tostring(index))
        return isvalid(e) and e.Enable
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 접근은 안내만 보여준다. 열린 대화는 처음 선택한 NPC에 고정한다.
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or not isvalid(player.CurrentMap) or not _Util:IsAlive(player) or st == nil then
            self:Dismiss()
            _UIKit:SetEnabled(self.Prompt, false)
            return
        end
        local nearby = self:FindNpc(player)
        local show = nearby ~= nil and not _UIKit:AnyWindowOpen()
        _UIKit:SetEnabled(self.Prompt, show)
        if show then
            -- PC는 「[B] 이름」, 모바일은 「이름 · 대화」. 너비는 이름 길이에 맞춘다 (공통 SetFitText)
            local text = Environment:IsPCPlatform() and ("[B] " .. nearby.NpcName) or (nearby.NpcName .. " · 대화")
            _UIKit:SetFitText(self.Prompt, text, 28, 56, 300, 640)
        end
        if not _UIKit:IsOpen(self.Win) then self.ActiveNpc = nil end
        ---@type WorldNPC
        local npc = isvalid(self.ActiveNpc) and self.ActiveNpc:GetComponent("script.WorldNPC") or nil
        if npc == nil or not self:CanTalkTo(player, npc) or _UIKit:AnyOtherWindowOpen(self.Win) then
            if isvalid(self.ActiveNpc) or _UIKit:IsOpen(self.Win) then self:Dismiss() end
            return
        end
        self.Kind = npc.Kind
        self.NpcKind = npc.Kind
        if npc.Kind ~= "quest" and self:GiverWaiting(npc.Kind) then self.Kind = "quest" end
        if self.Kind == "quest" and self.PendingIndex > 0 then
            ---@type PlayerQuest
            local quest = _UIKit:Comp("script.PlayerQuest")
            if quest ~= nil and (quest.Index ~= self.PendingIndex or quest.State ~= self.PendingState) then
                -- 동기화로 성공을 확인한 뒤 닫아 보상과 다음 행동 안내가 보이게 한다.
                self:Dismiss()
                return
            end
            if _UtilLogic.ElapsedSeconds < self.PendingUntil then return end
            -- 가방 부족 등 거절 시에는 같은 의뢰에서 다시 시도할 수 있다.
            self.PendingIndex = 0
            self.PendingUntil = 0
            self.RenderKey = ""
        end
        _UIKit:SetText(self.Win .. "/Title", npc.NpcName)
        if self.Kind == "shop" then self:RenderShop(st)
        elseif self.Kind == "merchant" then self:RenderMerchant(st)
        elseif self.Kind == "smith" then self:RenderSmith(st)
        elseif self.Kind == "caravan" then self:RenderCaravan()
        else self:RenderQuest() end
    end

    @ExecSpace("ClientOnly")
    method integer CaravanTarget()
        -- 카라반으로 갈 수 있는 다른 액트 (지금 액트 1이면 2, 아니면 1)
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        if travel == nil then return 0 end
        return travel.Act == 1 and 2 or 1
    end

    @ExecSpace("ClientOnly")
    method void RenderCaravan()
        -- 카라반 대장: 다른 액트 마을로. 잠겨 있으면 이유만
        ---@type PlayerTravel
        local travel = _UIKit:Comp("script.PlayerTravel")
        if travel == nil then return end
        local target = self:CaravanTarget()
        local unlocked = travel:ActUnlocked(target)
        local key = "caravan#" .. tostring(travel.Act) .. "#" .. tostring(unlocked)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local dest = _GameConst:ActTownName(target)
        local body = ""
        if unlocked then
            body = target == 2 and "사막길이 열렸다. 낙타 등에 짐은 다 실었지 — 오아시스 시장까지 데려다주마.\n(언제든 이곳 카라반으로 오갈 수 있다)"
                or "잿불 야영지로 돌아가겠나? 사막 모래가 신발에 가득하군.\n(언제든 카라반으로 다시 사막에 올 수 있다)"
            -- 받침에 맞춘 조사 (시장으로 · 야영지로)
            self:SetButtons({ "", "", "", target == 2 and (dest .. "으로") or (dest .. "로"), "닫기" })
        else
            body = "사막길은 아직 막혀 있다. 지하 납골당 깊은 곳의 묘지기 여왕이 길을 막고 있지.\n여왕을 쓰러뜨리고 사제 오렌에게 알리면 출발하겠네."
            self:SetButtons({ "", "", "", "", "닫기" })
        end
        _UIKit:SetText(self.Win .. "/Paper/Body", body)
    end

    method string IdleLine(string kind)
        -- 자기 의뢰 차례가 아닐 때 의뢰인 NPC의 한마디
        if kind == "scholar" then return "사원의 비밀은 아직 모래 아래 잠들어 있다. 길이 열리면 자네에게 부탁할 일이 생길 걸세." end
        if kind == "apothecary" then return "사막에선 물 한 모금이 목숨이야. 다치면 서두르지 말고 물약부터 챙겨." end
        return "할 이야기가 없다."
    end

    @ExecSpace("ClientOnly")
    method boolean GiverWaiting(string kind)
        -- 이 NPC가 지금 의뢰의 의뢰인이고 받기/보고 차례인가 (진행 중이면 평소 메뉴)
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return false end
        local q = _QuestData:Get(quest.Index)
        return q ~= nil and q.giver == kind and quest.State ~= 1
    end

    @ExecSpace("ClientOnly")
    method void Dismiss()
        -- 닫은 뒤에도 근처에서 버튼으로 다시 대화할 수 있다. 자동 재열기는 없다.
        self.Dismissed = true
        self.ActiveNpc = nil
        self.Kind = ""
        self.RenderKey = ""
        self.PageKey = ""
        self.Page = 1
        self.PendingIndex = 0
        self.PendingState = 0
        self.PendingUntil = 0
        _UIKit:SetEnabled(self.Win, false)
    end

    @ExecSpace("ClientOnly")
    method void SetButtons(table labels)
        -- labels[i] = 글자 ("" = 숨김)
        for i = 1, 5 do
            local label = labels[i] or ""
            _UIKit:SetEnabled(self.Win .. "/Btn" .. tostring(i), label ~= "")
            -- PC 의뢰 대화의 주 버튼에는 키 안내를 붙인다 (처리 중 표시는 제외)
            if label ~= "" and i == 4 and self.Kind == "quest" and Environment:IsPCPlatform() and label ~= "처리 중…" then label = label .. " [Space]" end
            if label ~= "" then _UIKit:SetText(self.Win .. "/Btn" .. tostring(i), label) end
        end
    end

    -- ───────── 상점 ─────────

    @ExecSpace("ClientOnly")
    method void RenderShop(PlayerStats st)
        -- 잿빛 행상: 인사 + 「거래」(거래 창 — 왼쪽 살 물건 · 오른쪽 가방). 버튼에 물건을 넣지 않는다
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        if shop == nil then return end
        local diff = shop:ShopDifficulty()
        local key = "shop#" .. tostring(st.Gold) .. "#" .. tostring(diff)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local tiers = { "하급 물약", "중급 물약까지", "고급 물약까지" }
        self:SetButtons({ "", "", "", "거래", "닫기" })
        _UIKit:SetText(self.Win .. "/Paper/Body", string.format("살아 돌아왔군. 물약이 필요한가, 아니면 짐을 덜고 싶은가.\n이 야영지에선 %s · 회복 물약 · 귀환 두루마리 · 도박을 판다.\n쓸모없는 물건은 사 주지.  <color=#9C9488>가진 골드 %d</color>", tiers[diff + 1] or tiers[1], st.Gold))
    end

    method table StockList()
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        local list = {}
        if shop == nil or shop.StockDigest == "" then return list end
        for x in string.gmatch(shop.StockDigest .. ";", "([^;]*);") do table.insert(list, x) end
        return list
    end

    @ExecSpace("ClientOnly")
    method void RenderMerchant(PlayerStats st)
        -- 떠돌이 상인: 인사 + 「물건 보기」(물건 목록 창 — 그림·이름·옵션을 보고 산다). 버튼에 물건 이름을 넣지 않는다
        ---@type PlayerShop
        local shop = _UIKit:Comp("script.PlayerShop")
        if shop == nil then return end
        local left = math.max(0, math.ceil(shop.StockNextAt - _UtilLogic.ServerElapsedSeconds))
        local count = 0
        for _, s in ipairs(self:StockList()) do if s ~= "" then count = count + 1 end end
        local key = "merchant#" .. tostring(count) .. "#" .. tostring(st.Gold) .. "#" .. tostring(math.floor(left / 10))
        if key == self.RenderKey then return end
        self.RenderKey = key
        self:SetButtons({ "", "", "", "물건 보기", "닫기" })
        local body = string.format("먼 길을 왔지. 오늘 들고 온 장비가 %d점 남았다.\n그림과 옵션을 보고 골라라. 열 분마다 짐이 바뀐다.\n<color=#9C9488>가진 골드 %d · 다음 입고 %d분 %02d초</color>", count, st.Gold, left // 60, left % 60)
        -- 말을 건 직후 서버가 짐을 풀기 전(입고 시각 0)에는 「다 팔렸다」가 아니라 짐 푸는 중
        if count == 0 then body = shop.StockNextAt <= 0 and "짐을 푸는 중이다… 잠시만." or ("오늘 물건은 다 팔렸다. 다음 입고까지 " .. string.format("%d분 %02d초", left // 60, left % 60) .. ".") end
        _UIKit:SetText(self.Win .. "/Paper/Body", body)
    end

    @ExecSpace("ClientOnly")
    method void RenderSmith(PlayerStats st)
        ---@type PlayerInventory
        local inv = _UIKit:Comp("script.PlayerInventory")
        local tokens = inv ~= nil and inv.SocketTokens or 0
        local key = "smith#" .. tostring(st.Gold) .. "#" .. tostring(tokens)
        if key == self.RenderKey then return end
        self.RenderKey = key
        self:SetButtons({ "", "", "", "물건 고르기", "닫기" })
        _UIKit:SetText(self.Win .. "/Paper/Body", string.format("망치질이 필요한가. 소지품에서 물건을 고르면 손봐 주지.  (가진 골드 %d)\n· 옵션 바꾸기: 마법·레어 장비의 옵션을 새로 새긴다 (레벨이 높을수록 비쌈, 레어는 3배)\n· 소켓 뚫기: 소켓 없는 무기·등불·투구·갑옷. 소켓권 %d장 — 소켓권이 있으면 확실히, 없으면 골드로 %d%% 확률\n  (일반 2~최대 · 마법 1~2 · 레어·유니크·세트 1개)",
            st.Gold, tokens, math.floor(_GameData.punchChance * 100 + 0.5)))
    end

    -- ───────── 의뢰 ─────────

    method table Lines(string text)
        local out = {}
        for line in string.gmatch(text, "[^/]+") do table.insert(out, line) end
        return out
    end

    method string RewardText(table q)
        -- 대표 보상을 앞에, 경험치는 주는 의뢰만 (14장 §2). 악몽·지옥 배율은 보고할 때 붙는다
        local extra = _QuestData:RewardText(q.reward)
        local parts = {}
        if extra ~= "" then table.insert(parts, extra) end
        if q.exp > 0 then table.insert(parts, "경험치 " .. tostring(q.exp)) end
        table.insert(parts, "골드 " .. tostring(q.gold))
        return "보상: " .. table.concat(parts, ", ")
    end

    @ExecSpace("ClientOnly")
    method void RenderQuest()
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return end
        local pageKey = tostring(quest.Index) .. "#" .. tostring(quest.State)
        if pageKey ~= self.PageKey then
            self.PageKey = pageKey
            self.Page = 1
        end
        local key = pageKey .. "#" .. tostring(quest.Progress) .. "#" .. tostring(self.Page)
        if key == self.RenderKey then return end
        self.RenderKey = key
        local q = _QuestData:Get(quest.Index)
        local body = ""
        if self.NpcKind ~= "quest" and (q == nil or q.giver ~= self.NpcKind) then
            body = self:IdleLine(self.NpcKind)
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif q == nil then
            body = "여왕의 저주가 걷혔다... 하지만 혼각은 더 깊은 곳에서 울리고 있다."
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif q.giver ~= self.NpcKind and quest.State ~= 1 then
            -- 다른 의뢰인의 차례: 그 사람에게 보낸다
            local who = _QuestData:GiverName(q.giver)
            body = quest.State == 2 and ("「" .. q.title .. "」을 해냈다고? " .. who .. "에게 알려 주게. 보상은 그쪽에서 받을 거다.")
                or ("「" .. q.title .. "」 — " .. who .. "이(가) 자네를 찾고 있더군. 먼저 가 보게.")
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        elseif quest.State == 1 then
            local count = quest:CountFor(q)
            local progress = count > 0 and ("  진행 " .. tostring(quest.Progress) .. " / " .. tostring(count)) or ""
            body = "「" .. q.title .. "」" .. progress .. "\n" .. q.desc .. "\n어서 다녀오게."
            self.PageCount = 1
            self:SetButtons({ "", "", "", "", "닫기" })
        else
            -- 0 = 새 의뢰(소개 대사 → 수락), 2 = 완료(마무리 대사 → 보고)
            local lines = self:Lines(quest.State == 0 and q.intro or q.outro)
            if #lines == 0 then lines = { quest.State == 0 and "할 일이 있다." or "해냈군." } end
            self.PageCount = #lines + (quest.State == 0 and 1 or 0)
            local page = math.min(self.Page, self.PageCount)
            body = lines[page] or ""
            if page < self.PageCount then
                self:SetButtons({ "", "", "", "다음 ▶", "닫기" })
            elseif quest.State == 0 then
                body = "의뢰 「" .. q.title .. "」\n" .. q.desc .. "\n\n" .. self:RewardText(q)
                self:SetButtons({ "", "", "", "수락", "거절" })
            else
                body = body .. "\n\n" .. self:RewardText(q)
                self:SetButtons({ "", "", "", "보상 받기", "닫기" })
            end
        end
        _UIKit:SetText(self.Win .. "/Paper/Body", body)
    end

    @ExecSpace("ClientOnly")
    method void Action(integer index)
        -- 닫힌 창의 오래된 버튼 입력은 상점/의뢰 RPC로 보내지 않는다.
        if not _UIKit:IsOpen(self.Win) or not isvalid(self.ActiveNpc) then return end
        ---@type WorldNPC
        local npc = self.ActiveNpc:GetComponent("script.WorldNPC")
        if not self:CanTalkTo(_UserService.LocalPlayer, npc) or _UIKit:AnyOtherWindowOpen(self.Win) then return end
        if self.Kind == "shop" then
            -- 거래 = 거래 창 (이 대화 창은 닫는다)
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                local name = npc.NpcName
                self:Dismiss()
                _ShopWindow:Open(name)
            end
            return
        end
        if self.Kind == "merchant" then
            -- 물건 보기 = 물건 목록 창 (이 대화 창은 닫는다)
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                self:Dismiss()
                _MerchantWindow:Open()
            end
            return
        end
        if self.Kind == "smith" then
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                -- 소지품을 대장장이 모드로 연다 (이 창은 닫힌다)
                self:Dismiss()
                _InventoryWindow:OpenSmith()
            end
            return
        end
        if self.Kind == "caravan" then
            if index == 5 then self:Dismiss() return end
            if index == 4 then
                ---@type PlayerTravel
                local travel = _UIKit:Comp("script.PlayerTravel")
                local target = self:CaravanTarget()
                self:Dismiss()
                if travel ~= nil and target > 0 then travel:RequestActTravel(target) end
            end
            return
        end
        if self.Kind ~= "quest" then
            if index == 5 then self:Dismiss() end
            return
        end
        if index == 5 then
            self:Dismiss()
            return
        end
        if index ~= 4 then return end
        if self.PendingIndex > 0 then return end
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        if quest == nil then return end
        local displayed = tostring(quest.Index) .. "#" .. tostring(quest.State)
        if displayed ~= self.PageKey then
            -- 상태가 바뀐 직후의 클릭으로 아직 읽지 않은 다음 대화를 건너뛰지 않는다.
            self.RenderKey = ""
            self:Poll()
            return
        end
        -- 다음 대사, 마지막이면 수락 / 보고
        if self.Page < self.PageCount then
            self.Page = self.Page + 1
        else
            if quest.State ~= 0 and quest.State ~= 2 then return end
            -- 서버 RPC의 expectedIndex와 같은 번호를 보관해 성공 동기화를 기다린다.
            self.PendingIndex = quest.Index
            self.PendingState = quest.State
            self.PendingUntil = _UtilLogic.ElapsedSeconds + 3
            self:SetButtons({ "", "", "", "처리 중…", "닫기" })
            if quest.State == 0 then quest:RequestAccept(quest.Index) else quest:RequestTurnIn(quest.Index) end
        end
        self.RenderKey = ""
    end

end
