-- 혼의 제물 3택 카드 (10-28 피드백 F4 · 기획서 38 #24-A 2차 — 시안 assets/codex-skill-window-mock-v1/V4-pc.png 카드 부분).
--   스킬 포인트가 있으면 HUD에 「혼의 제물 — 고르기」 띠(OfferBand) → 누르면 카드 3장: 새 스킬 1 · 쓰던 스킬 랭크 업 1 · 강화 1
--   (지금 찍을 수 있는 것 중에서 — 없는 종류는 빠진다) + 4번째는 다음 해금 미리보기. 「다시 섞기」는 레벨당 1번,
--   「보드에서 직접 고르기」는 스킬 창(K). 포인트·해금 규칙은 그대로 — 고르는 창구만 하나 더 (SkillBook.RequestLearn).
@Logic
script SkillOffer extends Logic

    property string Win = "OfferWin"
    property any Offer = nil                -- 카드 번호 → 스킬·강화 id
    property string OfferKey = ""           -- 카드를 고른 때의 상태 (포인트·배운 것이 바뀌면 다시 고른다)
    property integer RerollLevel = 0        -- 다시 섞기를 쓴 캐릭터 레벨 (레벨당 1번)
    property integer Shuffle = 0            -- 다시 섞을 때마다 1씩 — 같은 종류에서 다른 후보를 고른다
    property string RenderKey = ""
    property integer TimerId = 0
    property string Mode = "skill"          -- "skill" 혼의 제물 · "reward" 선택 보상 (10-28 — 같은 카드 창을 함께 쓴다)
    property integer RewardSlot = 0         -- 보상 모드에서 고르는 칸 (1~3)
    property integer AutoShownSlot = 0      -- 이 접속에서 스스로 열어 준 칸 (같은 칸은 한 번만 — 닫으면 띠로 다시 연다)
    property number CardX0 = 74             -- 첫 카드 왼쪽 (보상 모드는 「다음 해금」 칸이 없어 카드 셋을 가운데로 — 174)
    property number CardStep = 356          -- 카드 340 + 사이 16 (빌더 tools/build/ui.cjs CARD와 같은 숫자)
    property number WinW = 1400             -- 창 폭 (모바일 좁은 화면은 WindowFit이 1368로 · 카드 시작도 같이 옮긴다)
    property number CardLeft = 74           -- 혼의 제물 첫 카드 왼쪽 (오른쪽 「다음 해금」까지 좌우 여백이 같게)
    property number RewardLeft = 174        -- 선택 보상 첫 카드 왼쪽 (카드 셋 가운데)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect("OfferBand", function() self:Open() end)
        for i = 1, 3 do
            local index = i
            _UIKit:Connect(self.Win .. "/Card" .. tostring(i), function() self:Choose(index) end)
            _UIKit:Connect(self.Win .. "/Pick" .. tostring(i), function() self:Choose(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnReroll", function() self:Reroll() end)
        _UIKit:Connect(self.Win .. "/BtnBoard", function()
            _UIKit:Close(self.Win)
            _UIKit:Open("SkillWin")
        end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.25)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method void Open()
        -- 띠를 누르면: 고를 선택 보상이 있으면 그것부터, 아니면 혼의 제물
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local pending = quest ~= nil and quest:PendingChoice() or 0
        if pending > 0 then self:OpenReward(pending) return end
        self.Mode = "skill"
        self.OfferKey = ""
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        log("[VRF] offer open")
    end

    @ExecSpace("ClientOnly")
    method void OpenReward(integer slot)
        self.Mode = "reward"
        self.RewardSlot = slot
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        log("[VRF] choice reward open slot=" .. tostring(slot))
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if book == nil or st == nil then return end
        ---@type PlayerQuest
        local quest = _UIKit:Comp("script.PlayerQuest")
        local pending = quest ~= nil and quest:PendingChoice() or 0
        -- 선택 보상: 고를 차례가 오면 (의뢰 보고 직후 · 이미 끝낸 캐릭터는 접속하자마자) 한 번 스스로 연다
        if pending > 0 and self.AutoShownSlot ~= pending and not _UIKit:AnyWindowOpen() then
            self.AutoShownSlot = pending
            self:OpenReward(pending)
        end
        -- HUD 띠: 고를 선택 보상이 있거나 포인트가 있고, 창이 하나도 안 열려 있을 때
        local band = (pending > 0 or st.SkillPoints > 0) and not _UIKit:AnyWindowOpen()
        _UIKit:SetEnabled("OfferBand", band)
        if band then
            if pending > 0 then _UIKit:SetText("OfferBand", "선택 보상 — 고르기  " .. _UIKit:Colored("#FFFFFF", "(" .. quest:ChoiceQuestTitle(pending) .. ")"))
            else _UIKit:SetText("OfferBand", "혼의 제물 — 고르기  " .. _UIKit:Colored("#FFFFFF", "(" .. tostring(st.SkillPoints) .. ")")) end
        end
        if not _UIKit:IsOpen(self.Win) then return end
        if self.Mode == "reward" then
            if quest == nil or quest:PickOf(self.RewardSlot) ~= "" or quest:TierOfSlot(self.RewardSlot) <= 0 then
                self.Mode = "skill"
                _UIKit:Close(self.Win)
                return
            end
            local rkey = "reward#" .. tostring(self.RewardSlot) .. "#" .. tostring(quest:TierOfSlot(self.RewardSlot))
            if rkey ~= self.RenderKey then
                self.RenderKey = rkey
                self:RenderReward(quest)
            end
            return
        end
        if st.SkillPoints <= 0 then
            _UIKit:Close(self.Win)
            return
        end
        local state = book.SkillDigest .. "#" .. tostring(st.SkillPoints) .. "#" .. tostring(st.Level) .. "#" .. tostring(self.Shuffle)
        if state ~= self.OfferKey then
            self.OfferKey = state
            self.Offer = self:Pick(book, st)
        end
        if state == self.RenderKey then return end
        self.RenderKey = state
        self:Render(book, st)
    end

    @ExecSpace("ClientOnly")
    method table Slotted(SkillBook book)
        -- 스킬 칸(A S D F 우클릭)에 넣은 메인 스킬
        local set = {}
        for i = 1, 5 do
            local id = book:GetSlotSkill(i)
            if id ~= nil and id ~= "" then set[id] = true end
        end
        return set
    end

    @ExecSpace("ClientOnly")
    method any Pick(SkillBook book, PlayerStats st)
        -- 카드 3장: ① 새 스킬(안 배운 메인) ② 쓰던 스킬 랭크 업(칸에 넣은 것 우선) ③ 강화(칸에 넣은 스킬의 강화 우선). 다시 섞으면 같은 종류의 다른 후보
        local news, ranks, nodes = {}, {}, {}
        local slotted = self:Slotted(book)
        for _, id in ipairs(_SkillData:Mains()) do
            if book:CanLearn(id, st.Level, st.SkillPoints) == "" then
                if book:GetLevel(id) == 0 then table.insert(news, id)
                elseif slotted[id] then table.insert(ranks, 1, id)
                else table.insert(ranks, id) end
            end
            for _, nid in ipairs(_SkillData:NodesOf(id)) do
                if book:CanLearn(nid, st.Level, st.SkillPoints) == "" then
                    if slotted[id] then table.insert(nodes, 1, nid) else table.insert(nodes, nid) end
                end
            end
        end
        local function at(list)
            if #list == 0 then return nil end
            return list[(self.Shuffle % #list) + 1]
        end
        local offer = {}
        -- 목록마다 따로 고른다 (예전 { at(news), at(ranks), at(nodes) }는 새 스킬이 없으면 첫 칸이 nil이라 ipairs가 바로 멈춰 카드 0장 — 10-29 통합 메이커)
        for _, list in ipairs({ news, ranks, nodes }) do
            local id = at(list)
            if id ~= nil then table.insert(offer, id) end
        end
        log("[VRF] offer pick new=" .. #news .. " rank=" .. #ranks .. " node=" .. #nodes .. " → " .. table.concat(offer, ","))
        return offer
    end

    @ExecSpace("ClientOnly")
    method void RenderReward(PlayerQuest quest)
        -- 선택 보상 카드 3장: 군단 · 주문 · 저주 (축 이름 = 그 트리 색 글자). 하나만 — 다시 고를 수 없다
        local slot = self.RewardSlot
        local tier = quest:TierOfSlot(slot)
        _UIKit:SetText(self.Win .. "/Title", "선택 보상 · " .. quest:ChoiceQuestTitle(slot))
        _UIKit:SetText(self.Win .. "/Sub", "하나만 고르세요 — 다시 고를 수 없습니다")
        _UIKit:SetText(self.Win .. "/Left", tier > 1 and ("지금 " .. tostring(tier) .. "단계") or "")
        _UIKit:SetEnabled(self.Win .. "/BtnReroll", false)
        _UIKit:SetEnabled(self.Win .. "/BtnBoard", false)
        _UIKit:SetEnabled(self.Win .. "/Preview", false)
        self:Layout(true, 3)
        local axes = { { "command", "군단" }, { "soul", "주문" }, { "curse", "저주" } }
        for i, a in ipairs(axes) do
            local c = self.Win .. "/Card" .. tostring(i)
            local def = quest:ChoiceDef(slot, a[1])
            _UIKit:SetEnabled(c, def ~= nil)
            _UIKit:SetEnabled(self.Win .. "/Pick" .. tostring(i), def ~= nil)
            if def ~= nil then
                _UIKit:SetIcon(c, _GameData:GetUiIcon("sk_offer_card_new"))
                _UIKit:SetColor(c, Color(1, 1, 1, 1))   -- 혼의 제물 단계 카드의 금빛 물들임을 지운다 (44-7)
                -- 축 이름은 그 트리 색 글자로 (카드 위 색 띠는 10-28 사용자 지시로 없앰)
                _UIKit:SetText(c .. "/Kind", _UIKit:Colored(_SkillWindow:TreeHex(a[1]), a[2]))
                _UIKit:SetIcon(c .. "/Icon", _SkillData:Get(def.skill).icon)
                _UIKit:SetText(c .. "/Name", def.name)
                _UIKit:SetText(c .. "/Effect", def.desc)
                _UIKit:SetText(c .. "/Change", def.next)
                _UIKit:SetText(self.Win .. "/Pick" .. tostring(i), "이것으로")
            end
        end
        log("[VRF] choice reward render slot=" .. tostring(slot) .. " tier=" .. tostring(tier))
    end

    @ExecSpace("ClientOnly")
    method void Render(SkillBook book, PlayerStats st)
        -- 카드 3장 + 다음 해금 미리보기 + 남은 포인트 · 다시 섞기
        _UIKit:SetText(self.Win .. "/Title", "혼의 제물")
        _UIKit:SetText(self.Win .. "/Sub", "포인트를 바칠 곳을 고르세요")
        _UIKit:SetEnabled(self.Win .. "/BtnReroll", true)
        _UIKit:SetEnabled(self.Win .. "/BtnBoard", true)
        -- 고를 수 있는 종류가 1~2개면 (아직 배운 스킬이 없어 랭크 업·강화가 없을 때) 카드를 카드 셋 자리 가운데로
        local count = 0
        for i = 1, 3 do if self.Offer ~= nil and self.Offer[i] ~= nil then count = count + 1 end end
        self:Layout(false, count)
        for i = 1, 3 do _UIKit:SetText(self.Win .. "/Pick" .. tostring(i), "이 카드로") end
        _UIKit:SetText(self.Win .. "/Left", "남은 " .. tostring(st.SkillPoints))
        local rerollLeft = self.RerollLevel ~= st.Level
        _UIKit:SetText(self.Win .. "/BtnReroll", rerollLeft and "다시 섞기 (1)" or _UIKit:Colored("#8A8A8A", "다시 섞기 (0)"))
        for i = 1, 3 do
            local id = self.Offer ~= nil and self.Offer[i] or nil
            local c = self.Win .. "/Card" .. tostring(i)
            _UIKit:SetEnabled(c, id ~= nil)
            _UIKit:SetEnabled(self.Win .. "/Pick" .. tostring(i), id ~= nil)
            if id ~= nil then
                local def = _SkillData:Get(id)
                local lv = book:GetLevel(id)
                local kind, kindColor
                -- 44-7: 이 랭크로 단계(투사체 5·8·12 등)에 닿거나 20랭크 「완성」이면 「랭크 업」 카드를 금 테두리로 (은빛 카드를 금빛으로 물들임 · 숫자뿐인 랭크 업과 구분)
                local stage = (def.kind ~= "node" and lv > 0) and book:StageReachedAt(id, lv + 1) or ""
                local done = def.kind ~= "node" and lv > 0 and book:IsComplete(id, lv + 1)
                if def.kind == "node" then
                    kind, kindColor = "강화  " .. tostring(lv) .. " → " .. tostring(lv + 1), "#C8A0FF"
                elseif lv == 0 then
                    kind, kindColor = "★ 새 스킬", "#F4ED83"
                elseif done then
                    kind, kindColor = "랭크 " .. tostring(lv) .. " → " .. tostring(lv + 1) .. " · 완성", "#F4D27A"
                elseif stage ~= "" then
                    kind, kindColor = "랭크 " .. tostring(lv) .. " → " .. tostring(lv + 1) .. " · 단계", "#F4D27A"
                else
                    kind, kindColor = "랭크 " .. tostring(lv) .. " → " .. tostring(lv + 1), "#D8D8E0"
                end
                -- 카드 그림 3종 (코덱스 skill-window-v3): 새 스킬 · 랭크 업 · 강화
                local card = "sk_offer_card_rank"
                if def.kind == "node" then card = "sk_offer_card_augment" elseif lv == 0 then card = "sk_offer_card_new" end
                _UIKit:SetIcon(c, _GameData:GetUiIcon(card))
                _UIKit:SetColor(c, (stage ~= "" or done) and Color(1, 0.84, 0.48, 1) or Color(1, 1, 1, 1))
                if (stage ~= "" or done) and not Environment:IsPublishedPlay() then log(string.format("[VRF] offer stage card %s %d→%d stage=%s complete=%s", id, lv, lv + 1, stage, tostring(done))) end
                _UIKit:SetText(c .. "/Kind", _UIKit:Colored(kindColor, kind))
                _UIKit:SetIcon(c .. "/Icon", def.icon)
                _UIKit:SetText(c .. "/Name", def.name)
                _UIKit:SetText(c .. "/Effect", def.desc)
                local change = ""
                local now = book:GetRankSummary(id, book:PowerLevelAt(id, math.max(1, lv)))
                local nextRank = book:GetRankSummary(id, def.kind == "node" and (lv + 1) or book:PowerLevelAt(id, lv + 1))
                if lv == 0 then change = nextRank
                elseif nextRank ~= "" and nextRank ~= now then change = nextRank end
                if def.kind == "node" then
                    local hint = book:UseHint(id)
                    if hint ~= "" then change = change .. (change ~= "" and "\n" or "") .. hint end
                end
                _UIKit:SetText(c .. "/Change", change)
            end
        end
        -- 다음 해금 미리보기 (반투명)
        local preview = nil
        for _, col in ipairs(_SkillWindow:BuildColumns()) do
            if col.row > st.Level then preview = col break end
        end
        _UIKit:SetEnabled(self.Win .. "/Preview", preview ~= nil)
        if preview ~= nil then
            local first = _SkillData:Get(preview.ids[1])
            _UIKit:SetIcon(self.Win .. "/Preview/Icon", first.icon)
            local names = {}
            for _, id in ipairs(preview.ids) do table.insert(names, _SkillData:Get(id).name) end
            _UIKit:SetText(self.Win .. "/Preview/Body", "Lv" .. tostring(preview.row) .. "\n" .. table.concat(names, "\n") .. "\n\n" .. tostring(preview.row - st.Level) .. "레벨 남음")
        end
    end

    @ExecSpace("ClientOnly")
    method void Choose(integer index)
        -- 카드 고르기 = 그 스킬·강화 +1 (서버가 다시 확인한다). 보상 모드면 그 축을 고른다 (한 번만)
        if self.Mode == "reward" then
            ---@type PlayerQuest
            local quest = _UIKit:Comp("script.PlayerQuest")
            local axes = { "command", "soul", "curse" }
            if quest == nil or axes[index] == nil then return end
            -- 선택 보상은 다시 고를 수 없어 확인 창을 거친다 (10-29 기획서 45 결정 6-A · 글귀 승인 전)
            local slot, axis = self.RewardSlot, axes[index]
            local def = quest:ChoiceDef(slot, axis)
            local name = def ~= nil and def.name or axis
            _ConfirmDialog:ShowIcon("선택 보상", name .. "\n한 번 고르면 다시 고를 수 없습니다.", "고르기", def ~= nil and _SkillData:Get(def.skill).icon or "", function()
                if self.Mode ~= "reward" or self.RewardSlot ~= slot then return end
                quest:RequestChoose(slot, axis)
                _SoundDirector:PlayEffect(_GameConst.SfxSummon, 0.6)
                self:Flash(index)
                log("[VRF] choice reward choose slot=" .. tostring(slot) .. " " .. axis)
            end)
            return
        end
        local id = self.Offer ~= nil and self.Offer[index] or nil
        if id == nil then return end
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        if book == nil then return end
        book:RequestLearn(id)
        _SoundDirector:PlayEffect(_GameConst.SfxSummon, 0.6)
        self:Flash(index)
        log("[VRF] offer choose " .. id)
        self.Shuffle = 0
    end

    @ExecSpace("ClientOnly")
    method void Layout(boolean reward, integer count)
        -- 모드별 배치 (10-28 「아래 빈 공간 · 창 높이 줄이기」):
        --   혼의 제물 = 카드 셋 + 다음 해금 + 아래 단추 줄(다시 섞기·보드) → 창 772, 첫 카드 74 (카드가 count장이면 셋 자리 가운데로)
        --   선택 보상 = 카드 셋만 가운데, 단추 줄 없음 → 창 668 (카드 아래 고르기 단추 + 바닥 여백 48), 첫 카드 174
        local x0 = reward and self.RewardLeft or (self.CardLeft + (3 - math.max(1, math.min(3, count))) * self.CardStep / 2)
        local h = reward and 668 or 772
        _UIKit:SetSize(self.Win, Vector2(self.WinW, h))
        _UIKit:SetSize(self.Win .. "/Rim", Vector2(self.WinW + 40, h + 40))   -- 테두리 그림은 바탕보다 20씩 밖으로 (k.frame)
        _UIKit:SetPos(self.Win .. "/Preview", Vector2(self.CardLeft + 3 * self.CardStep, -116))   -- 다음 해금 칸은 셋째 카드 오른쪽
        self.CardX0 = x0
        for i = 1, 3 do
            local x = x0 + (i - 1) * self.CardStep
            _UIKit:SetPos(self.Win .. "/Card" .. tostring(i), Vector2(x, -116))
            _UIKit:SetPos(self.Win .. "/Pick" .. tostring(i), Vector2(x + 20, -532))
        end
    end

    @ExecSpace("ClientOnly")
    method void Flash(integer index)
        -- 고른 카드 위 반짝임 (코덱스 sk-offer-pick-01~06 · 80ms씩 · 480ms)
        local path = self.Win .. "/Flash"
        _UIKit:SetPos(path, Vector2(self.CardX0 + (index - 1) * self.CardStep + 170, -116 - 202))
        _UIKit:SetIcon(path, _GameData:GetUiIcon("sk_offer_pick_01"))
        for i = 2, 6 do
            local ruid = _GameData:GetUiIcon("sk_offer_pick_0" .. tostring(i))
            _TimerService:SetTimerOnce(function() _UIKit:SetIcon(path, ruid) end, 0.08 * (i - 1))
        end
        _TimerService:SetTimerOnce(function() _UIKit:SetEnabled(path, false) end, 0.48)
    end

    @ExecSpace("ClientOnly")
    method void Reroll()
        -- 다시 섞기: 레벨당 1번 (같은 종류의 다른 후보로)
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if st == nil or self.RerollLevel == st.Level then return end
        self.RerollLevel = st.Level
        self.Shuffle = self.Shuffle + 1
        log("[VRF] offer reroll lv=" .. tostring(st.Level))
    end

end
