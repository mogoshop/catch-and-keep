-- 메뉴에서 여는 공용 환경 설정. 실제 저장 확인과 즉시 적용을 구분한다.
@Logic
script AudioWindow extends Logic

    property string Win = "AudioWin"
    property string Body = "/ui/AudioSettingsHUD/Modal/SafeArea/Panel"
    property table Values = { bgm = 55, effects = 100, ambience = 100 }
    property table Previous = { bgm = 55, effects = 100, ambience = 100 }
    property Entity Player = nil
    property boolean Ready = false
    property integer TimerId = 0
    property string SupportPath = "/ui/AudioSettingsHUD/Modal/SafeArea/Support"   -- 개발자 응원하기 판 (설정 판과 번갈아 켠다)
    property boolean SupportShown = false
    property boolean PricesAsked = false
    property any SupportPrices = nil            -- 단계 → 가격 (상점에서 한 번 읽는다)
    property any SupportOpen = nil              -- 단계 → 살 수 있음 (판매 중 · 메이커는 시험 구매)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        for _, key in ipairs({ "bgm", "effects", "ambience" }) do
            local channel = key
            _UIKit:Connect(self.Body .. "/" .. channel .. "/Minus", function() self:Adjust(channel, -5) end)
            _UIKit:Connect(self.Body .. "/" .. channel .. "/Plus", function() self:Adjust(channel, 5) end)
            _UIKit:Connect(self.Body .. "/" .. channel .. "/Mute", function() self:ToggleMute(channel) end)
        end
        _UIKit:Connect(self.Body .. "/Reset", function() self:ResetVolumes() end)
        _UIKit:Connect(self.Body .. "/Input", function() _ShadowHUD:ToggleInputMode() end)
        _UIKit:Connect(self.Body .. "/Back", function() _UIKit:Open("MenuWin") end)
        -- 개발자 응원하기 (10-25 후원 패스 — Shop/Supporter)
        self.SupportPrices = {}
        self.SupportOpen = {}
        _UIKit:Connect(self.Body .. "/Support", function() self:ShowSupport(true) end)
        _UIKit:Connect(self.SupportPath .. "/Back", function() self:ShowSupport(false) end)
        for i = 1, 3 do
            local tier = i
            _UIKit:Connect(self.SupportPath .. "/Card" .. tostring(i) .. "/Btn", function() self:BuySupport(tier) end)
        end
        self.TimerId = _TimerService:SetTimer(self, function() self:Poll() end, 0.2, true, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self.Player = nil
        self.Ready = false
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local player = _UserService.LocalPlayer
        if player ~= self.Player then self.Player = player self.Ready = false end
        ---@type PlayerSave
        local save = isvalid(player) and player:GetComponent("script.PlayerSave") or nil
        if save == nil then return end
        if not self.Ready and save.AudioDigest ~= "" then
            local values = { string.match(save.AudioDigest, "^(%d+),(%d+),(%d+)$") }
            if values[1] ~= nil then
                self.Values = { bgm = tonumber(values[1]), effects = tonumber(values[2]), ambience = tonumber(values[3]) }
                self.Previous = { bgm = self.Values.bgm > 0 and self.Values.bgm or 55, effects = self.Values.effects > 0 and self.Values.effects or 100, ambience = self.Values.ambience > 0 and self.Values.ambience or 100 }
                self.Ready = true
                self:Apply()
            end
        end
        if not _UIKit:IsOpen(self.Win) then
            if self.SupportShown then self:ShowSupport(false) end   -- 다시 열면 설정 판부터
            return
        end
        if self.SupportShown then self:RenderSupport() end
        for _, key in ipairs({ "bgm", "effects", "ambience" }) do
            local value = self.Values[key]
            _UIKit:SetText(self.Body .. "/" .. key .. "/Value", self.Ready and (tostring(value) .. "%") or "—")
            _UIKit:SetFill(self.Body .. "/" .. key .. "/Bar/Fill", value / 100)
            _UIKit:SetText(self.Body .. "/" .. key .. "/Mute", value == 0 and "켜기" or "음소거")
        end
        ---@type ClickControl
        local control = _UIKit:Comp("script.ClickControl")
        if control ~= nil then _UIKit:SetText(self.Body .. "/Input", control.MouseMode and "조작: 마우스" or "조작: 키보드") end
        local status = "저장 데이터를 불러온 뒤 변경할 수 있습니다"
        if self.Ready then status = save.AudioSavedDigest == self:Key() and "저장 완료" or "저장 대기 중" end
        _UIKit:SetText(self.Body .. "/Status", status)
    end

    @ExecSpace("ClientOnly")
    method void ShowSupport(boolean on)
        -- 설정 판 ↔ 개발자 응원하기 판
        self.SupportShown = on
        _UIKit:SetEnabled(self.Body, not on)
        _UIKit:SetEnabled(self.SupportPath, on)
        if on then
            self:AskSupportPrices()
            self:RenderSupport()
        end
    end

    @ExecSpace("ClientOnly")
    method void AskSupportPrices()
        -- 상점 가격·판매 상태를 한 번 읽는다 (기다리는 호출이라 타이머 안에서). 메이커는 판매 전 상품도 시험 구매할 수 있다
        if self.PricesAsked then return end
        self.PricesAsked = true
        _TimerService:SetTimerOnce(function()
            for i, id in ipairs(_Supporter:PassList()) do
                local ok, prod = pcall(function() return _WorldShopService:GetProductAndWait(id) end)
                if ok and prod ~= nil then
                    self.SupportPrices[i] = prod.Price
                    local st = prod.Status
                    local test = not Environment:IsPublishedPlay() and st ~= WorldShopProductStatus.End and st ~= WorldShopProductStatus.Deleted
                    self.SupportOpen[i] = st == WorldShopProductStatus.Ing or test
                end
            end
            log("[VRF] Support prices " .. tostring(self.SupportPrices[1]) .. "/" .. tostring(self.SupportPrices[2]) .. "/" .. tostring(self.SupportPrices[3]))
        end, 0.1)
    end

    @ExecSpace("ClientOnly")
    method void RenderSupport()
        -- 카드마다 가격 · 버튼 (이미 그 단계 이상이면 「응원 완료」)
        local me = _UserService.LocalPlayer
        local tier = isvalid(me) and (_Supporter.Tier[me.PlayerComponent.UserId] or 0) or 0
        for i = 1, 3 do
            local card = self.SupportPath .. "/Card" .. tostring(i)
            local price = self.SupportPrices[i]
            _UIKit:SetText(card .. "/Price", price ~= nil and (tostring(price) .. " 월드 코인") or "")
            local label = "응원하기"
            if tier >= i then label = "응원 완료 ♥"
            elseif not self.SupportOpen[i] then label = "준비 중" end
            _UIKit:SetText(card .. "/Btn", label)
            _UIKit:SetColor(card .. "/Btn", (tier < i and self.SupportOpen[i]) and Color(1, 1, 1, 1) or Color(0.55, 0.55, 0.55, 1))
        end
    end

    @ExecSpace("ClientOnly")
    method void BuySupport(integer tier)
        -- 플랫폼 구매 창 (결제·확인은 플랫폼이 맡는다). 지급은 Supporter.ProcessPurchase
        local me = _UserService.LocalPlayer
        if not isvalid(me) or (_Supporter.Tier[me.PlayerComponent.UserId] or 0) >= tier or not self.SupportOpen[tier] then return end
        local id = _Supporter:PassList()[tier]
        if id ~= nil then _WorldShopService:PromptPurchase(id) end
    end

    method string Key()
        return tostring(self.Values.bgm) .. "," .. tostring(self.Values.effects) .. "," .. tostring(self.Values.ambience)
    end

    @ExecSpace("ClientOnly")
    method void Apply()
        _SoundDirector:SetVolumes(self.Values.bgm / 100, self.Values.effects / 100, self.Values.ambience / 100)
    end

    @ExecSpace("ClientOnly")
    method void Submit()
        self:Apply()
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save ~= nil then save:RequestAudioSettings(self.Values.bgm, self.Values.effects, self.Values.ambience) end
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Adjust(string key, integer delta)
        if not self.Ready or not _UIKit:IsOpen(self.Win) or self.Values[key] == nil then return end
        local value = math.max(0, math.min(100, self.Values[key] + delta))
        if value == self.Values[key] then return end
        self.Values[key] = value
        if value > 0 then self.Previous[key] = value end
        self:Submit()
    end

    @ExecSpace("ClientOnly")
    method void ToggleMute(string key)
        if not self.Ready or not _UIKit:IsOpen(self.Win) or self.Values[key] == nil then return end
        local value = self.Values[key]
        if value > 0 then self.Previous[key] = value self.Values[key] = 0
        else self.Values[key] = self.Previous[key] end
        self:Submit()
    end

    @ExecSpace("ClientOnly")
    method void ResetVolumes()
        if not self.Ready or not _UIKit:IsOpen(self.Win) then return end
        self.Values = { bgm = 55, effects = 100, ambience = 100 }
        self.Previous = { bgm = 55, effects = 100, ambience = 100 }
        self:Submit()
    end
end
