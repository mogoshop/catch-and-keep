-- 일지 창: 일일 의뢰 · 업적 · 몬스터 도감 · 아이템 도감 (PlayerJournal.Digest를 그린다). PC는 J, 모바일은 의뢰 추적 아래 「일지」 버튼.
-- 10-27 사용자: 업적 줄에 난이도 별 · 「받기」(골드 + 큰 업적 소켓권/상급 룬 + 칭호) · 「칭호 달기」.
-- 일지 뱃지(GameHUD/BtnJournal): 진행이 10% 단계를 넘거나 끝나면(PlayerJournal.Pulse) journalPulseSeconds초 동안 진행 말풍선과 함께,
--   받을 보상이 있으면(ClaimCount) 빨간 점과 함께 메뉴 아래에 뜬다. 누르면 그 줄이 있는 쪽을 열고 줄을 잠깐 밝힌다.
@Logic
script JournalWindow extends Logic

    property string Win = "JournalWin"
    property string Tab = "daily"
    property integer Page = 1
    property integer Rows = 8
    property string RenderKey = ""
    property integer TimerId = 0
    property table RowAct = {}                -- 줄 번호 → { kind = "claim"|"title", key }
    property integer LastPulse = 0
    property number PulseUntil = 0
    property string PulseTab = "ach"
    property integer PulseIndex = 0
    property integer HiIndex = 0              -- 뱃지로 열었을 때 밝힐 줄 (목록 전체 번호)
    property number HiUntil = 0
    property boolean SeekClaim = false
    property integer ViewDiff = 0        -- 뱃지로 열었는데 말풍선이 없다 → 첫 「받기」 줄로

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/TabDaily", function() self:SetTab("daily") end)
        _UIKit:Connect(self.Win .. "/TabAch", function() self:SetTab("ach") end)
        _UIKit:Connect(self.Win .. "/TabCol", function() self:SetTab("col") end)
        _UIKit:Connect(self.Win .. "/TabItem", function() self:SetTab("item") end)
        _UIKit:Connect(self.Win .. "/BtnPrev", function() self:Turn(-1) end)
        _UIKit:Connect(self.Win .. "/BtnNext", function() self:Turn(1) end)
        _UIKit:Connect("JournalOpen", function() self:Toggle() end)
        _UIKit:Connect("BtnJournal", function() self:OpenFromBadge() end)
        for i = 1, self.Rows do
            local row = i
            _UIKit:Connect(self.Win .. "/List/R" .. tostring(i) .. "/BtnAct", function() self:RowAction(row) end)
        end
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.25)
        log("[VRF] JournalWindow ready")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if event.key ~= KeyboardKey.J then return end
        if _UIKit:IsOpen(self.Win) then _UIKit:Close(self.Win) return end
        if _UIKit:CanUseGameplayInput() then self:Toggle() end
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        self.RenderKey = ""
        _UIKit:Toggle(self.Win)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void SetTab(string tab)
        self.Tab = tab
        self.Page = 1
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Turn(integer delta)
        self.Page = math.max(1, self.Page + delta)
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 모바일 여는 버튼은 다른 창이 없을 때만. 창이 열려 있으면 요약이 바뀔 때만 다시 그린다.
        -- 모바일 여는 버튼은 의뢰 추적 패널과 함께 보이고 접힌다 (전투 중·창 열림)
        -- PC는 J 키로 연다 (모바일 전용 버튼이 PC 화면에도 보였다)
        _UIKit:SetEnabled("JournalOpen", Environment:IsMobilePlatform() and _HudMap:ShouldShowQuestTrack())
        ---@type PlayerJournal
        local journal = _UIKit:Comp("script.PlayerJournal")
        self:UpdateBadge(journal)
        if not _UIKit:IsOpen(self.Win) then return end
        if journal == nil then return end
        local hi = _UtilLogic.ElapsedSeconds < self.HiUntil
        local key = self.Tab .. "#" .. tostring(self.Page) .. "#" .. tostring(hi) .. "#" .. journal.Digest
        if key == self.RenderKey then return end
        self.RenderKey = key
        local ok, view = pcall(function() return _HttpService:JSONDecode(journal.Digest) end)
        if not ok or type(view) ~= "table" then view = { daily = {}, ach = {}, col = {}, it = "", left = 0 } end
        self:Render(view)
    end

    @ExecSpace("ClientOnly")
    method void UpdateBadge(any journal)
        -- 메뉴 아래 일지 뱃지: 진행 말풍선(Pulse) 또는 받을 보상(ClaimCount)이 있을 때만
        local now = _UtilLogic.ElapsedSeconds
        local claims = 0
        if journal ~= nil then
            claims = journal.ClaimCount
            if journal.Pulse ~= "" then
                local ok, p = pcall(function() return _HttpService:JSONDecode(journal.Pulse) end)
                if ok and type(p) == "table" and (p.q or 0) ~= self.LastPulse then
                    self.LastPulse = p.q or 0
                    self.PulseUntil = now + _GameData.journalPulseSeconds
                    self.PulseTab = p.t or "ach"
                    self.PulseIndex = p.i or 0
                    local c = math.max(1, p.c or 1)
                    _UIKit:SetText("BtnJournal/Tip/Name", (self.PulseTab == "daily" and "일일 의뢰 · " or "업적 · ") .. (p.n or ""))
                    _UIKit:SetText("BtnJournal/Tip/Value", p.done and _UIKit:Colored("#9FD69B", "완료!") or (tostring(p.p or 0) .. " / " .. tostring(c)))
                    _UIKit:SetBar("BtnJournal/Tip/Bar/Fill", (p.p or 0) / c)
                    log("[VRF] journal pulse " .. self.PulseTab .. "#" .. tostring(self.PulseIndex) .. " " .. tostring(p.p) .. "/" .. tostring(c))
                end
            end
        end
        local pulsing = now < self.PulseUntil
        local show = not _HudMain:InLobby() and (pulsing or claims > 0)
        local e = _UIKit:Get("BtnJournal")
        if not isvalid(e) then return end
        if show then self:PlaceBadge(e) end
        if e.Enable ~= show then
            e.Enable = show
            log("[VRF] journal badge " .. (show and "shown" or "hidden") .. " claims=" .. tostring(claims))
        end
        _UIKit:SetEnabled("BtnJournal/Tip", show and pulsing)
        _UIKit:SetEnabled("BtnJournal/Badge", show and claims > 0)
    end

    @ExecSpace("ClientOnly")
    method void PlaceBadge(Entity e)
        -- 「재 받기」가 떠 있으면 그 왼쪽, 아니면 그 자리 (메뉴 단추 바로 아래 · MobileLayout과 같은 줄)
        local jae = _UIKit:Get("BtnJae")
        local shift = (isvalid(jae) and jae.Enable) and -(96 + 24) or 0
        local t = e.UITransformComponent
        if Environment:IsMobilePlatform() then
            t.AlignmentOption = AlignmentType.TopRight
            t.Pivot = Vector2(1, 1)
            t.anchoredPosition = Vector2(-298 + shift, -120 - 96 - 28 - 16)
        else
            t.anchoredPosition = Vector2(-456 + shift, -150 - 96 - 28 - 16)
        end
    end

    @ExecSpace("ClientOnly")
    method void OpenFromBadge()
        -- 말풍선이 떠 있으면 그 항목 쪽, 아니면 첫 「받기」 줄로 열고 그 줄을 잠깐 밝힌다
        if _UtilLogic.ElapsedSeconds < self.PulseUntil and self.PulseIndex > 0 then
            self.Tab = self.PulseTab
            self.HiIndex = self.PulseIndex
            self.SeekClaim = false
        else
            self.Tab = "ach"
            self.HiIndex = 0
            self.SeekClaim = true
        end
        self.Page = math.max(1, math.ceil(math.max(1, self.HiIndex) / self.Rows))
        self.HiUntil = _UtilLogic.ElapsedSeconds + 3
        self.PulseUntil = 0
        self.RenderKey = ""
        _UIKit:Open(self.Win)
        self:Poll()
        log("[VRF] journal badge clicked tab=" .. self.Tab .. " row=" .. tostring(self.HiIndex) .. " seekClaim=" .. tostring(self.SeekClaim))
    end

    @ExecSpace("ClientOnly")
    method void RowAction(integer i)
        local act = self.RowAct[i]
        if act == nil then return end
        ---@type PlayerJournal
        local journal = _UIKit:Comp("script.PlayerJournal")
        if journal == nil then return end
        if act.kind == "claim" then journal:RequestClaim(act.key) else journal:RequestTitle(act.key) end
        log("[VRF] journal row action " .. act.kind .. " " .. act.key)
    end

    @ExecSpace("ClientOnly")
    method void Render(table view)
        local list = view.daily or {}
        local info = ""
        if self.Tab == "daily" then
            local left = view.left or 0
            info = string.format("다음 교체까지 %d시간 %d분", left // 60, left % 60)
        elseif self.Tab == "ach" then
            list = view.ach or {}
            local done = 0
            for _, a in ipairs(list) do if a.d then done = done + 1 end end
            local diffs = { "보통", "악몽", "지옥" }
            info = string.format("%s 달성 %d / %d", diffs[(view.diff or 0) + 1] or "보통", done, #list)
            if (view.claims or 0) > 0 then info = info .. "  ·  " .. _UIKit:Colored("#C9A0FF", "받을 보상 " .. tostring(view.claims)) end
            if self.SeekClaim then
                -- 뱃지로 열었다: 첫 「받기」 줄이 있는 쪽으로
                self.SeekClaim = false
                for i, a in ipairs(list) do
                    if (a.cl or "") ~= "" then
                        self.HiIndex = i
                        self.Page = math.ceil(i / self.Rows)
                        break
                    end
                end
            end
            self.ViewDiff = view.diff or 0
        elseif self.Tab == "item" then
            -- 아이템 도감: ItemData.GrailList 순서 + Digest의 찾음 표시(1/0)
            list = {}
            local bits = view.it or ""
            local got = { u = 0, s = 0, r = 0 }
            local all = { u = 0, s = 0, r = 0 }
            for i, g in ipairs(_ItemData:GrailList()) do
                local found = string.sub(bits, i, i) == "1"
                all[g.kind] = all[g.kind] + 1
                if found then got[g.kind] = got[g.kind] + 1 end
                table.insert(list, { g = g, f = found })
            end
            info = string.format("유니크 %d/%d · 세트 %d/%d · 룬워드 %d/%d", got.u, all.u, got.s, all.s, got.r, all.r)
        else
            list = view.col or {}
            local seen = 0
            for _, m in ipairs(list) do if (m.k or 0) > 0 then seen = seen + 1 end end
            info = string.format("도감 %d / %d종", seen, #list)
        end
        _UIKit:SetText(self.Win .. "/Info", info)
        local pages = math.max(1, math.ceil(#list / self.Rows))
        self.Page = math.min(self.Page, pages)
        _UIKit:SetText(self.Win .. "/Page", tostring(self.Page) .. " / " .. tostring(pages))
        -- 넘길 쪽이 없는 단추는 숨기지 않고 흐리게 (자리가 비면 아래 줄이 들쭉날쭉해진다). 누르면 Turn이 쪽 범위로 되돌린다
        -- 단추 그림이 어두워 알파만으로는 티가 안 난다 → 글자도 흐리게 (UIKit.SetActPager와 같은 방식)
        _UIKit:SetText(self.Win .. "/BtnPrev", self.Page > 1 and "◀ 이전" or _UIKit:Colored("#6A6460", "◀ 이전"))
        _UIKit:SetText(self.Win .. "/BtnNext", self.Page < pages and "다음 ▶" or _UIKit:Colored("#6A6460", "다음 ▶"))
        _UIKit:SetColor(self.Win .. "/BtnPrev", Color(1, 1, 1, self.Page > 1 and 1 or 0.45))
        _UIKit:SetColor(self.Win .. "/BtnNext", Color(1, 1, 1, self.Page < pages and 1 or 0.45))
        for _, tab in ipairs({ { "TabDaily", "daily" }, { "TabAch", "ach" }, { "TabCol", "col" }, { "TabItem", "item" } }) do
            _UIKit:SetColor(self.Win .. "/" .. tab[1], tab[2] == self.Tab and Color(0.55, 0.45, 0.25, 1) or Color(0.14, 0.13, 0.17, 1))
        end
        for i = 1, self.Rows do
            local row = self.Win .. "/List/R" .. tostring(i)
            local index = (self.Page - 1) * self.Rows + i
            local item = list[index]
            _UIKit:SetEnabled(row, item ~= nil)
            self.RowAct[i] = nil
            if item ~= nil then self:RenderRow(row, item, index, i) end
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderRow(string row, table item, integer index, integer slot)
        local name, desc, value, ratio = "", "", "", 0
        local finished = false
        local act, stars, gold = nil, "", 0
        if self.Tab == "item" then
            -- 이름은 처음부터 보인다 (무엇을 찾아야 하는지 알게). 찾은 것만 색이 들어온다
            local g = item.g
            local trees = { command = "소환", soul = "영혼", curse = "저주", any = "범용" }
            local kinds = { u = "유니크", s = "세트", r = "룬워드" }
            local colors = { u = "#C8A050", s = "#5ED15E", r = "#E8A85A" }
            name = item.f and _UIKit:Colored(colors[g.kind] or "#FFFFFF", g.name) or _UIKit:Colored("#77707F", g.name)
            local parts = { kinds[g.kind] or "", trees[g.tree] or "범용" }
            if g.kind ~= "r" then
                table.insert(parts, ((g.grade or 0) > 0 and _ItemData:GradeName(g.grade) .. " " or "") .. g.base)
            else
                local n = 0
                for _ in string.gmatch(g.runes or "", "[^,]+") do n = n + 1 end
                table.insert(parts, "룬 " .. tostring(n) .. "개 · " .. g.base)
            end
            if g.kind == "s" then table.insert(parts, g.set) end
            if g.kind == "u" and (g.source or "") ~= "" then table.insert(parts, "보스 전용") end
            desc = table.concat(parts, " · ")
            value = item.f and _UIKit:Colored("#9FD69B", "찾음") or "???"
            ratio = item.f and 1 or 0
            finished = false   -- 이름은 등급 색 그대로 (초록 덧칠 안 함)
        elseif self.Tab == "col" then
            local known = (item.k or 0) > 0
            name = known and item.n or "???"
            if known and item.u then name = name .. "  (고유)" elseif known and (item.g or 1) >= 3 then name = name .. "  (보스)" end
            -- 도감 한 줄 (monsters.csv lore, docs/design/18 §3-4): 만난 몬스터만. 목록 순서 = JournalData 몬스터 순서
            local def = _JournalData:GetMonsters()[index]
            local lore = def ~= nil and (def.lore or "") or ""
            -- 유형 (archetypes.csv): 만난 몬스터만
            local arch = (known and def ~= nil and (def.arch or "") ~= "" and def.arch ~= "nest") and _GameData:GetArchetype(def.arch) or nil
            if arch ~= nil then name = name .. "  " .. _UIKit:Colored("#C9B17E", "[" .. arch.name .. " · " .. arch.trait .. "]") end
            if known then name = name .. "   " .. _UIKit:Colored("#A99F8E", "처치 " .. tostring(item.k) .. " · 포획 " .. tostring(item.c or 0)) end
            desc = known and (lore ~= "" and lore or "처치 기록이 쌓였다") or "아직 만나지 못한 몬스터"
            value = known and ((item.c or 0) > 0 and "포획함" or "처치함") or ""
            ratio = known and ((item.c or 0) > 0 and 1 or 0.5) or 0
            finished = (item.c or 0) > 0
        else
            local p, c = item.p or 0, math.max(1, item.c or 1)
            finished = item.d == true
            name = item.n or ""
            gold = item.g or 0
            if self.Tab == "daily" then desc = "보상 경험치: 다음 레벨의 " .. tostring(item.x or 0) .. "%"
            else
                -- 보상: 골드(난이도 배율, 오른쪽 보상 칸에 주머니 그림 + 숫자) + 큰 업적은 악몽 소켓권 · 지옥 상급 룬 + 칭호(줄기 끝 8개만)
                local d = item.pd and self.ViewDiff or 0
                local extra = {}
                if item.bonus and d == 1 then table.insert(extra, "소켓권") elseif item.bonus and d == 2 then table.insert(extra, "상급 룬") end
                if item.ti then table.insert(extra, _UIKit:Colored("#C9B17E", "칭호")) end
                desc = (item.s or "") .. (#extra > 0 and ("  ·  + " .. table.concat(extra, " + ")) or "")
                -- 난이도 별: 깬 곳 "1" · 못 깬 곳 "0" (난이도마다 따로 깨는 업적만 셋, 나머지는 하나)
                stars = string.sub((item.st or "") .. "000", 1, item.pd and 3 or 1)
                if (item.cl or "") ~= "" then
                    act = { kind = "claim", key = item.cl, label = "받기" }
                elseif item.tt then
                    act = { kind = "title", key = item.id or "", label = item.tp and "칭호 떼기" or "칭호 달기" }
                end
            end
            value = finished and "완료" or (tostring(p) .. " / " .. tostring(c))
            ratio = math.min(1, p / c)
        end
        -- 업적 줄: 별 · 단추 (단추가 있으면 막대와 숫자 자리를 쓴다)
        -- 별 그림(코덱스 r3): 깬 난이도는 그대로, 못 깬 곳은 같은 그림을 어둡게 눌러 빈 자리처럼. 하나뿐이면 가운데에
        -- 알파 30%만으로는 원래 어두운 보라·붉은 별이 색이 남아 깬 것처럼 보였다 (10-27 실측) → 색을 0.3배로 눌러 회색 실루엣에 가깝게
        _UIKit:SetEnabled(row .. "/Stars", stars ~= "")
        for k = 1, 3 do
            local star = row .. "/Stars/S" .. tostring(k)
            _UIKit:SetEnabled(star, k <= #stars)
            if k <= #stars then
                _UIKit:SetColor(star, string.sub(stars, k, k) == "1" and Color(1, 1, 1, 1) or Color(0.3, 0.29, 0.33, 0.8))
                _UIKit:SetPos(star, Vector2(#stars == 1 and 0 or (k - 2) * 34, 0))
            end
        end
        _UIKit:SetEnabled(row .. "/BtnAct", act ~= nil)
        if act ~= nil then
            self.RowAct[slot] = act
            -- 단추 위계 (같은 테두리 단추, 밝기로 구분): 받기(그림 그대로 · 밝은 금 글자 굵게) > 칭호 달기(조금 어둡게) > 칭호 떼기(가장 어둡게 · 흐린 글자, 이미 단 칭호)
            -- 단추 그림을 보라로 물들이면 오히려 어두워져 받기가 가장 덜 띄었다 (10-27 실측) — 받기는 보라 줄 판 + 상자로 이미 구분된다
            local wearing = act.kind == "title" and item.tp == true
            local label = act.label
            if act.kind == "claim" then label = "<b>" .. _UIKit:Colored("#FFE7A3", act.label) .. "</b>"
            elseif wearing then label = _UIKit:Colored("#8A8278", act.label) end
            _UIKit:SetText(row .. "/BtnAct", label)
            _UIKit:SetColor(row .. "/BtnAct", act.kind == "claim" and Color(1, 1, 1, 1) or (wearing and Color(0.5, 0.48, 0.52, 1) or Color(0.8, 0.78, 0.82, 1)))
        end
        -- 10-27 코덱스 줄 칸: 받을 보상(보라) · 완료(금테) · 진행 중. 뱃지로 연 줄은 잠깐 금빛으로 물들인다
        local claim = act ~= nil and act.kind == "claim"
        _UIKit:SetIcon(row, _GameData:GetUiIcon(claim and "jr_row_claim" or (finished and "jr_row_done" or "jr_row")))
        local hi = index == self.HiIndex and _UtilLogic.ElapsedSeconds < self.HiUntil
        _UIKit:SetColor(row, hi and Color(1, 0.86, 0.55, 1) or Color(1, 1, 1, 1))
        _UIKit:SetIcon(row .. "/Icon", _GameData:GetUiIcon(self:RowIcon(item)))
        _UIKit:SetEnabled(row .. "/Chest", claim)
        if act ~= nil and act.kind == "title" and item.tp == true then name = name .. "  " .. _UIKit:Colored("#E6C88A", "[착용 중]") end
        _UIKit:SetText(row .. "/Name", finished and _UIKit:Colored("#9FD69B", name) or name)
        _UIKit:SetText(row .. "/Desc", desc)
        _UIKit:SetText(row .. "/Value", finished and _UIKit:Colored("#9FD69B", value) or value)
        -- 도감: 진행 막대 대신 한 줄 설명을 넓게
        local codex = self.Tab == "col" or self.Tab == "item"
        _UIKit:SetEnabled(row .. "/BarBg", not codex and act == nil)
        _UIKit:SetEnabled(row .. "/Value", act == nil)
        _UIKit:SetSize(row .. "/Desc", Vector2(codex and 900 or 420, 24))
        _UIKit:SetSize(row .. "/Name", Vector2(codex and 900 or 420, 34))
        _UIKit:SetEnabled(row .. "/Reward", not codex and gold > 0)
        _UIKit:SetText(row .. "/Reward/Text", tostring(gold))
        local fill = _UIKit:Get(row .. "/BarBg/Fill")
        if isvalid(fill) then
            -- 채움 그림은 양 끝 8px씩 고정(9-slice)이라 16px보다 짧게 줄이지 않는다
            local t = fill.UITransformComponent
            local full = fill.Parent.UITransformComponent.RectSize.x
            t.RectSize = Vector2(math.max(16, full * ratio), t.RectSize.y)
            fill.Enable = ratio > 0
        end
    end

    method string RowIcon(table item)
        -- 줄 왼쪽 업적 문양: 처치(낫과 해골) · 수집(도감) · 탐험(지도와 횃불) · 일일(모래시계)
        if self.Tab == "daily" then return "jr_icon_daily" end
        if self.Tab == "col" then return "jr_icon_kill" end
        if self.Tab == "item" then return "jr_icon_collect" end
        local k = item.k or ""
        if k == "kill" or k == "kill_elite" or k == "kill_boss" or k == "kill_source" then return "jr_icon_kill" end
        if k == "depth" or k == "level" or k == "quest" then return "jr_icon_explore" end
        if k == "daily" then return "jr_icon_daily" end
        return "jr_icon_collect"
    end

end
