-- 일지 창: 일일 의뢰 · 업적 · 몬스터 도감 · 아이템 도감 (PlayerJournal.Digest를 그린다). PC는 J, 모바일은 의뢰 추적 아래 「일지」 버튼.
@Logic
script JournalWindow extends Logic

    property string Win = "JournalWin"
    property string Tab = "daily"
    property integer Page = 1
    property integer Rows = 8
    property string RenderKey = ""
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/TabDaily", function() self:SetTab("daily") end)
        _UIKit:Connect(self.Win .. "/TabAch", function() self:SetTab("ach") end)
        _UIKit:Connect(self.Win .. "/TabCol", function() self:SetTab("col") end)
        _UIKit:Connect(self.Win .. "/TabItem", function() self:SetTab("item") end)
        _UIKit:Connect(self.Win .. "/BtnPrev", function() self:Turn(-1) end)
        _UIKit:Connect(self.Win .. "/BtnNext", function() self:Turn(1) end)
        _UIKit:Connect("JournalOpen", function() self:Toggle() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.25)
        log("[VRF] JournalWindow ready")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if event.key ~= KeyboardKey.J then return end
        if _UIKit:IsOpen(self.Win) then _UIKit:Close(self.Win) return end
        if _UIKit:CanUseGameplayInput() then self:Toggle() end
    end

    @ExecSpace("ClientOnly")
    method void Toggle()
        self.RenderKey = ""
        _UIKit:Toggle(self.Win)
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void SetTab(string tab)
        self.Tab = tab
        self.Page = 1
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Turn(integer delta)
        self.Page = math.max(1, self.Page + delta)
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 모바일 여는 버튼은 다른 창이 없을 때만. 창이 열려 있으면 요약이 바뀔 때만 다시 그린다.
        -- 모바일 여는 버튼은 의뢰 추적 패널과 함께 보이고 접힌다 (전투 중·창 열림)
        -- PC는 J 키로 연다 (모바일 전용 버튼이 PC 화면에도 보였다)
        _UIKit:SetEnabled("JournalOpen", Environment:IsMobilePlatform() and _HudMap:ShouldShowQuestTrack())
        if not _UIKit:IsOpen(self.Win) then return end
        ---@type PlayerJournal
        local journal = _UIKit:Comp("script.PlayerJournal")
        if journal == nil then return end
        local key = self.Tab .. "#" .. tostring(self.Page) .. "#" .. journal.Digest
        if key == self.RenderKey then return end
        self.RenderKey = key
        local ok, view = pcall(function() return _HttpService:JSONDecode(journal.Digest) end)
        if not ok or type(view) ~= "table" then view = { daily = {}, ach = {}, col = {}, it = "", left = 0 } end
        self:Render(view)
    end

    @ExecSpace("ClientOnly")
    method void Render(table view)
        local list = view.daily or {}
        local info = ""
        if self.Tab == "daily" then
            local left = view.left or 0
            info = string.format("다음 교체까지 %d시간 %d분", left // 60, left % 60)
        elseif self.Tab == "ach" then
            list = view.ach or {}
            local done = 0
            for _, a in ipairs(list) do if a.d then done = done + 1 end end
            info = string.format("달성 %d / %d", done, #list)
        elseif self.Tab == "item" then
            -- 아이템 도감: ItemData.GrailList 순서 + Digest의 찾음 표시(1/0)
            list = {}
            local bits = view.it or ""
            local got = { u = 0, s = 0, r = 0 }
            local all = { u = 0, s = 0, r = 0 }
            for i, g in ipairs(_ItemData:GrailList()) do
                local found = string.sub(bits, i, i) == "1"
                all[g.kind] = all[g.kind] + 1
                if found then got[g.kind] = got[g.kind] + 1 end
                table.insert(list, { g = g, f = found })
            end
            info = string.format("유니크 %d/%d · 세트 %d/%d · 룬워드 %d/%d", got.u, all.u, got.s, all.s, got.r, all.r)
        else
            list = view.col or {}
            local seen = 0
            for _, m in ipairs(list) do if (m.k or 0) > 0 then seen = seen + 1 end end
            info = string.format("도감 %d / %d종", seen, #list)
        end
        _UIKit:SetText(self.Win .. "/Info", info)
        local pages = math.max(1, math.ceil(#list / self.Rows))
        self.Page = math.min(self.Page, pages)
        _UIKit:SetText(self.Win .. "/Page", tostring(self.Page) .. " / " .. tostring(pages))
        _UIKit:SetEnabled(self.Win .. "/BtnPrev", self.Page > 1)
        _UIKit:SetEnabled(self.Win .. "/BtnNext", self.Page < pages)
        for _, tab in ipairs({ { "TabDaily", "daily" }, { "TabAch", "ach" }, { "TabCol", "col" }, { "TabItem", "item" } }) do
            _UIKit:SetColor(self.Win .. "/" .. tab[1], tab[2] == self.Tab and Color(0.55, 0.45, 0.25, 1) or Color(0.14, 0.13, 0.17, 1))
        end
        for i = 1, self.Rows do
            local row = self.Win .. "/List/R" .. tostring(i)
            local index = (self.Page - 1) * self.Rows + i
            local item = list[index]
            _UIKit:SetEnabled(row, item ~= nil)
            if item ~= nil then self:RenderRow(row, item, index) end
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderRow(string row, table item, integer index)
        local name, desc, value, ratio = "", "", "", 0
        local finished = false
        if self.Tab == "item" then
            -- 이름은 처음부터 보인다 (무엇을 찾아야 하는지 알게). 찾은 것만 색이 들어온다
            local g = item.g
            local trees = { command = "소환", soul = "영혼", curse = "저주", any = "범용" }
            local kinds = { u = "유니크", s = "세트", r = "룬워드" }
            local colors = { u = "#C8A050", s = "#5ED15E", r = "#E8A85A" }
            name = item.f and _UIKit:Colored(colors[g.kind] or "#FFFFFF", g.name) or _UIKit:Colored("#77707F", g.name)
            local parts = { kinds[g.kind] or "", trees[g.tree] or "범용" }
            if g.kind ~= "r" then
                table.insert(parts, ((g.grade or 0) > 0 and _ItemData:GradeName(g.grade) .. " " or "") .. g.base)
            else
                local n = 0
                for _ in string.gmatch(g.runes or "", "[^,]+") do n = n + 1 end
                table.insert(parts, "룬 " .. tostring(n) .. "개 · " .. g.base)
            end
            if g.kind == "s" then table.insert(parts, g.set) end
            if g.kind == "u" and (g.source or "") ~= "" then table.insert(parts, "보스 전용") end
            desc = table.concat(parts, " · ")
            value = item.f and _UIKit:Colored("#9FD69B", "찾음") or "???"
            ratio = item.f and 1 or 0
            finished = false   -- 이름은 등급 색 그대로 (초록 덧칠 안 함)
        elseif self.Tab == "col" then
            local known = (item.k or 0) > 0
            name = known and item.n or "???"
            if known and item.u then name = name .. "  (고유)" elseif known and (item.g or 1) >= 3 then name = name .. "  (보스)" end
            -- 도감 한 줄 (monsters.csv lore, docs/design/18 §3-4): 만난 몬스터만. 목록 순서 = JournalData 몬스터 순서
            local def = _JournalData:GetMonsters()[index]
            local lore = def ~= nil and (def.lore or "") or ""
            -- 유형 (archetypes.csv): 만난 몬스터만
            local arch = (known and def ~= nil and (def.arch or "") ~= "" and def.arch ~= "nest") and _GameData:GetArchetype(def.arch) or nil
            if arch ~= nil then name = name .. "  " .. _UIKit:Colored("#C9B17E", "[" .. arch.name .. " · " .. arch.trait .. "]") end
            if known then name = name .. "   " .. _UIKit:Colored("#A99F8E", "처치 " .. tostring(item.k) .. " · 포획 " .. tostring(item.c or 0)) end
            desc = known and (lore ~= "" and lore or "처치 기록이 쌓였다") or "아직 만나지 못한 몬스터"
            value = known and ((item.c or 0) > 0 and "포획함" or "처치함") or ""
            ratio = known and ((item.c or 0) > 0 and 1 or 0.5) or 0
            finished = (item.c or 0) > 0
        else
            local p, c = item.p or 0, math.max(1, item.c or 1)
            finished = item.d == true
            name = item.n or ""
            if self.Tab == "daily" then desc = "보상: 골드 " .. tostring(item.g or 0) .. " · 다음 레벨 경험치의 " .. tostring(item.x or 0) .. "%"
            else desc = (item.s or "") .. "  ·  골드 " .. tostring(item.g or 0) end
            value = finished and "완료" or (tostring(p) .. " / " .. tostring(c))
            ratio = math.min(1, p / c)
        end
        _UIKit:SetText(row .. "/Name", finished and _UIKit:Colored("#9FD69B", name) or name)
        _UIKit:SetText(row .. "/Desc", desc)
        _UIKit:SetText(row .. "/Value", finished and _UIKit:Colored("#9FD69B", value) or value)
        -- 도감: 진행 막대 대신 한 줄 설명을 넓게
        local codex = self.Tab == "col" or self.Tab == "item"
        _UIKit:SetEnabled(row .. "/BarBg", not codex)
        _UIKit:SetSize(row .. "/Desc", Vector2(codex and 1010 or 700, 30))
        local fill = _UIKit:Get(row .. "/BarBg/Fill")
        if isvalid(fill) then
            local t = fill.UITransformComponent
            t.RectSize = Vector2(math.max(0.01, 260 * ratio), t.RectSize.y)
            fill.Enable = ratio > 0
        end
    end

end
