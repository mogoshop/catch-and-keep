                .. "· 보스 방에 들어가기 전에 물약을 채우고 군단을 " .. g("집결") .. "해 두세요" },
            { kind = "", head = "난이도 — 악몽 · 지옥",
              body = "액트 4 마지막 보스 " .. g("「재의 왕」") .. "을 쓰러뜨리면 다음 난이도가 열립니다.\n"
                .. "보통 → " .. g("악몽") .. " → " .. g("지옥") .. "\n\n"
                .. "· 몬스터도 보상도 강해집니다\n"
                .. "· 악몽부터는 쓰러지면 경험치를 조금 잃습니다" },
        } })

        table.insert(tabs, { key = "together", name = "함께하기", pages = {
            { kind = "shot", shot = shot("party"), head = "함께 출발하기",
              body = "로비의 게임 고르기에서 " .. g("혼자 하기 · 공개 방 · 비공개 방") .. " 중 하나로 출발합니다.\n"
                .. "· 방은 최대 " .. g("4명") .. " — 방장이 「출발」을 누르면 다 같이 들어갑니다\n"
                .. "· 친구와 하려면 비공개 방을 만들고 비밀번호를 알려 주세요" },
            { kind = "", head = "파티 · 거래 · 결투",
              body = key("플레이어(P)", "메뉴 → 플레이어") .. " 창에서 같은 서버 플레이어에게 " .. g("파티 · 거래 · 결투") .. "를 요청합니다.\n"
                .. "· 상대가 수락해야 성립합니다\n"
                .. "· 거래는 서로 물건과 골드를 올리고 둘 다 확인하면 끝납니다" },
        } })

        table.insert(tabs, { key = "danger", name = "위험 신호", pages = {
            { kind = "clip", vid = { 94, 5 }, head = "바닥의 붉은 원",
              body = r("붉은 원") .. "은 곧 터지는 범위 공격입니다.\n"
                .. "· 원 밖으로 걸어 나가면 피할 수 있습니다\n"
                .. "· 군단이 맞아 주는 동안 내 자리부터 챙기세요" },
            { kind = "shot", shot = shot("variant"), head = "푸른 몸 · 발밑의 색 원",
              body = "· " .. b("몸이 푸른 몬스터") .. " — 변종 우두머리. 특수 기술을 쓰고 좋은 것을 떨어뜨립니다\n"
                .. "· " .. g("발밑에 색 원") .. " — 주변 적을 강하게 하는 오오라. 먼저 잡으세요\n"
                .. "  빨강 공격 · 노랑 속도 · 하늘 방어 · 초록 회복 · 보라는 내 저항을 깎는 부식" },
            { kind = "", head = "마나",
              body = "마나가 모자라면 스킬이 나가지 않습니다.\n\n"
                .. "· 벨트에 " .. g("마나 물약") .. "을 채워 두세요\n"
                .. "· 능력치 " .. g("정신") .. "을 올리면 마나가 늘어납니다" },
        } })
        return tabs
    end

end
