-- 게임 안내 창 (GameHUD/GuideWin — tools/build/ui.cjs · docs/design/35): 왼쪽 책갈피 7 + 오른쪽 화면(움짤·캡처) · 제목 · 설명 · 쪽 점.
--   · 첫 진입: 계정에서 한 번도 안 봤으면(PlayerSave.GuideSeen) 캐릭터를 다 불러오고 시작 이야기 카드가 닫힌 뒤 저절로 연다.
--     책갈피 1~4(시작하기 · 군단 · 성장 · 장비·파밍)를 이어서 넘기고 4번 끝에서 「시작하기」로 닫는다 (10-27 사용자 B안).
--     연 순간 서버에 「봤다」를 남겨 다른 캐릭터·다음 접속에는 다시 띄우지 않는다 (RequestGuideSeen).
--   · 책갈피 5~7(모험 · 함께하기 · 위험 신호)은 그 순간이 오면 상황 카드가 「자세히 보기」로 데려간다 (GuideCoach).
--   · 안 본 책갈피에는 붉은 점 — 펴 보면 계정에 남긴다 (PlayerSave.GuideCards의 gtab_<key>).
--   · 메뉴 「게임 안내」로 언제든 다시 본다. 조작 쪽은 PC·모바일 글이 다르다 (_ApplicationService:IsMobilePlatform).
--   · 상황 카드: GuideCoach가 그 순간 필요한 한 장만 같은 창에 띄운다 (ShowCard / ShowCardLink — 쪽 점 없이 「확인」).
--   · 화면 칸: 쪽의 shot(animationclip 움짤 또는 sprite 캡처 RUID). 아직 없으면 「준비 중」 글, 글만 쓰는 쪽(kind "")은 화면 칸을 접고 글을 크게.
--   · 안내 영상: 쪽에 vid { 시작 초, 길이 }가 있으면 Media/Video(유튜브 일부 공개 1편 frX4-7REhRw)를 그 초로 Jump하고 길이만큼 되풀이.
--     영상은 인트로 4초 뒤에 본편이 붙는다 (assets/claude-guide-video-v1/README.md 장면 초 + 4). 창을 닫거나 다른 쪽으로 가면 멈춘다.
@Logic
script GuideWindow extends Logic

    property string Win = "GuideWin"
    property integer Tab = 1
    property integer Page = 1
    property integer TimerId = 0
    property number ReadyFor = 0             -- 첫 진입 조건이 이어서 맞은 시간 (이야기 카드가 대기열에 들어올 틈을 준다)
    property number ReadyDelay = 2.5
    property boolean AutoDone = false        -- 이번 접속에서 저절로 띄우기를 끝냈다
    property table Tabs = {}                 -- { key, name, pages = { { head, body, kind, shot } } }
    property boolean InputDone = false       -- 이번 접속에서 이동 방식을 적용했거나 물었다
    property number InputReadyFor = 0
    property boolean CardMode = false        -- 상황 카드 한 장을 보이는 중 (닫거나 책갈피를 누르면 안내 쪽으로 돌아간다)
    property table Card = {}                 -- 상황 카드 { head, body }
    property integer MoreTab = 0             -- 상황 카드 「자세히 보기」가 펼 책갈피 (0 = 버튼 없음)
    property integer MorePage = 1
    property boolean Tour = false            -- 첫 진입 둘러보기 (TourLast 책갈피 끝에서 닫는다)
    property integer TourLast = 4
    property table Seen = {}                 -- 이번 접속에서 편 책갈피 (서버 저장 전에도 점을 바로 끈다)
    -- 배치 (ui.cjs 게임 안내 블록과 짝): 화면 칸이 있을 때 / 글만일 때 제목·설명 자리, 쪽 점 가운데
    property number RightX = 367
    property number RightW = 1142
    property number DotX = 158
    property number DotY = 92
    property integer VidStart = -1           -- 지금 되풀이 중인 영상 구간 (−1 = 멈춤)
    property number VidDur = 0
    property integer VidTimer = 0
    property number JumpCover = 0.9           -- Jump 직후 재생기가 0.05~0.4초 하얗게 비친다 (10-27 전체 녹화 실측, 0.6초로도 버퍼링이 길면 한두 프레임 남았다) → 그동안 인트로 그림으로 덮는다
    property integer CoverTimer = 0
    property number CoverLead = 0.1           -- 가림판을 켠 뒤 재생기를 켜거나 Jump하기까지 (같은 프레임이면 하얀 화면이 한 프레임 비친다)
    property number VidLoad = 2.5            -- 재생기를 처음 켤 때 불러오는 시간 (그동안 검은 가림판 · 그 뒤 Jump)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 창 등록·버튼 연결, 첫 진입 확인 타이머
        self.Tabs = self:BuildTabs(_ApplicationService:IsMobilePlatform())
        self.Seen = {}
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/BtnPrev", function() self:Turn(-1) end)
        _UIKit:Connect(self.Win .. "/BtnNext", function() self:Turn(1) end)
        _UIKit:Connect(self.Win .. "/BtnMore", function() self:ShowTab(self.MoreTab, self.MorePage) end)
        for i = 1, #self.Tabs do
            local index = i
            _UIKit:SetText(self.Win .. "/Tabs/T" .. tostring(i) .. "/Label", self.Tabs[i].name)
            _UIKit:Connect(self.Win .. "/Tabs/T" .. tostring(i), function()
                self.Tour = self.Tour and index <= self.TourLast
                self:ShowTab(index, 1)
            end)
        end
        self.TimerId = _TimerService:SetTimerRepeat(function()
            self:CheckFirstEntry(0.5)
            self:CheckInputChoice(0.5)
            if self.VidStart >= 0 and not _UIKit:IsOpen(self.Win) then self:StopVideo() end
        end, 0.5)
        local pages = 0
        for _, t in ipairs(self.Tabs) do pages = pages + #t.pages end
        log("[VRF] GuideWindow ready tabs=" .. tostring(#self.Tabs) .. " pages=" .. tostring(pages) .. " mobile=" .. tostring(_ApplicationService:IsMobilePlatform()))
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 타이머 정리
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        self:StopVideo()
    end

    @ExecSpace("ClientOnly")
    method void Show(integer page)
        -- 메뉴 「게임 안내」: 첫 책갈피의 그 쪽부터 (둘러보기 아님)
        self.Tour = false
        self:ShowTab(1, page)
    end

    @ExecSpace("ClientOnly")
    method void ShowTab(integer tab, integer page)
        -- 그 책갈피의 그 쪽을 펴서 연다 (상황 카드였다면 안내로 돌아온다)
        if tab < 1 or tab > #self.Tabs then return end
        self.CardMode = false
        self.Tab = tab
        self.Page = math.max(1, math.min(#self.Tabs[tab].pages, page))
        _UIKit:Open(self.Win)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void ShowTabKey(string key, integer page)
        -- 책갈피 이름(key)으로 펴기 (GuideCoach 등 바깥에서)
        local tab = self:TabIndex(key)
        if tab > 0 then self:ShowTab(tab, page) end
    end

    @ExecSpace("ClientOnly")
    method void ShowCard(string head, string body)
        -- 상황 안내 한 장 (GuideCoach · AbyssSystem): 같은 창에 쪽 점 없이, 「확인」으로 닫는다
        self:ShowCardLink(head, body, "", 1)
    end

    @ExecSpace("ClientOnly")
    method void ShowCardLink(string head, string body, string tabKey, integer page)
        -- 상황 카드 + 「자세히 보기」(그 책갈피 쪽으로). tabKey ""면 버튼 없음
        self.CardMode = true
        self.Tour = false
        self.Card = { head = head, body = body }
        self.MoreTab = tabKey ~= "" and self:TabIndex(tabKey) or 0
        self.MorePage = page
        _UIKit:Open(self.Win)
        self:Render()
    end

    method integer TabIndex(string key)
        for i, t in ipairs(self.Tabs) do
            if t.key == key then return i end
        end
        return 0
    end

    @ExecSpace("ClientOnly")
    method void Turn(integer step)
        -- 이전/다음: 책갈피 끝에서 다음 책갈피로 이어진다. 둘러보기는 TourLast 끝, 아니면 마지막 책갈피 끝에서 닫는다
        if self.CardMode then
            if step > 0 then _UIKit:Close(self.Win) end
            return
        end
        local tab, page = self.Tab, self.Page + step
        if page > #self.Tabs[tab].pages then
            if self:IsLastStop() then
                _UIKit:Close(self.Win)
                return
            end
            tab, page = tab + 1, 1
        elseif page < 1 then
            if tab <= 1 then return end
            tab = tab - 1
            page = #self.Tabs[tab].pages
        end
        self.Tab, self.Page = tab, page
        self:Render()
    end

    method boolean IsLastStop()
        -- 지금 책갈피가 넘김의 끝인가 (둘러보기 = TourLast, 평소 = 마지막 책갈피)
        if self.Tour then return self.Tab >= self.TourLast end
        return self.Tab >= #self.Tabs
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- 책갈피(고른 것 밝게 · 안 본 것 붉은 점) → 화면 칸 → 제목·설명 → 쪽 점 · 버튼
        local w = self.Win
        local tabs = self.Tabs
        local showing = self.CardMode and 0 or self.Tab
        if not self.CardMode then self:MarkSeen(self.Tab) end
        for i, t in ipairs(tabs) do
            local n = w .. "/Tabs/T" .. tostring(i)
            local chosen = i == showing
            _UIKit:SetText(n .. "/Label", _UIKit:Colored(chosen and "#FFE9A8" or "#A99F8E", t.name))
            -- 칸 그림: 고른 책갈피는 금테·보라 칸(guide_tab_on), 나머지는 보통 칸 (코덱스 10-27)
            local tab = _UIKit:Get(n)
            local ruid = _GameData:GetUiIcon(chosen and "guide_tab_on" or "guide_tab")
            if isvalid(tab) and ruid ~= "" and tab.SpriteGUIRendererComponent.ImageRUID.DataId ~= ruid then tab.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid) end
            _UIKit:SetEnabled(n .. "/Badge", not self:IsSeen(t.key))
        end
        local head, body, kind, shot, vid = "", "", "", "", nil
        if self.CardMode then
            head, body = self.Card.head, self.Card.body
        else
            local p = tabs[self.Tab].pages[self.Page]
            head, body, kind, shot, vid = p.head, p.body, p.kind or "", p.shot or "", p.vid
        end
        -- 화면 칸: 그림이 있으면 그림, 만들 예정이면 「준비 중」, 글만 쓰는 쪽·상황 카드는 접는다
        local media = not self.CardMode and kind ~= ""
        _UIKit:SetEnabled(w .. "/Media", media)
        if media and vid ~= nil then
            _UIKit:SetEnabled(w .. "/Media/Shot", false)
            _UIKit:SetEnabled(w .. "/Media/Empty", false)
            self:PlayVideo(vid[1], vid[2])
        else
            self:StopVideo()
            if media then
                -- 캡처 그림(1280×720)은 처음 그릴 때 한 프레임 하얗게 비쳤다 (10-27 전체 녹화) → 인트로 그림으로 잠깐 덮는다
                if shot ~= "" then self:CoverBriefly(self.JumpCover) end
                _UIKit:SetIcon(w .. "/Media/Shot", shot)
                _UIKit:SetEnabled(w .. "/Media/Empty", shot == "")
                _UIKit:SetText(w .. "/Media/Empty", kind == "clip" and "움짤 준비 중" or "화면 준비 중")
            end
        end
        local headY = media and 572 or 74
        _UIKit:SetPos(w .. "/Head", Vector2(self.RightX, -headY))
        _UIKit:SetPos(w .. "/Body", Vector2(self.RightX, -(headY + 50)))
        _UIKit:SetSize(w .. "/Body", Vector2(self.RightW, media and 150 or 640))
        _UIKit:SetText(w .. "/Head", head)
        _UIKit:SetText(w .. "/Body", body)
        -- 쪽 점: 이 책갈피의 쪽 수만큼 가운데 정렬 (지금 금색 · 나머지 흐리게), 상황 카드는 없음
        local count = self.CardMode and 0 or #tabs[self.Tab].pages
        for i = 1, 6 do
            local dot = w .. "/D" .. tostring(i)
            _UIKit:SetEnabled(dot, i <= count and count > 1)
            if i <= count then
                _UIKit:SetPos(dot, Vector2(self.DotX + (i - (count + 1) / 2) * 30, self.DotY))
                _UIKit:SetColor(dot, i == self.Page and Color(1, 0.8, 0.42, 1) or Color(0.5, 0.47, 0.44, 1))
            end
        end
        local first = self.CardMode or (self.Tab == 1 and self.Page == 1)
        _UIKit:SetEnabled(w .. "/BtnPrev", not first)
        _UIKit:SetEnabled(w .. "/BtnMore", self.CardMode and self.MoreTab > 0)
        local label = "다음"
        if self.CardMode then
            label = "확인"
        elseif self.Page >= count and self:IsLastStop() then
            label = self.Tour and "시작하기" or "닫기"
        end
        _UIKit:SetText(w .. "/BtnNext", label)
        log("[VRF] guide render tab=" .. tostring(self.Tab) .. " page=" .. tostring(self.Page) .. " card=" .. tostring(self.CardMode) .. " media=" .. tostring(media) .. " next=" .. label)
    end

    @ExecSpace("ClientOnly")
    method void PlayVideo(integer start, number dur)
        -- 영상 칸을 켜고 그 구간을 되풀이 (같은 구간이면 이어서 둔다).
        -- 꺼져 있던 재생기는 Jump만으로는 첫 화면에 멈춰 있다 → Play로 불러오고 VidLoad초 뒤 Jump (10-27 메이커 실측). 그동안 하얀 화면이 비쳐 인트로 고정 그림(Media/Cover · ui_icons guide_video_cover)으로 덮는다
        local e = _UIKit:Get(self.Win .. "/Media/Video")
        if not isvalid(e) or e.YoutubePlayerGUIComponent == nil then
            log("[VRF] guide video missing")
            return
        end
        if self.VidStart == start and (e.Enable or self.VidTimer ~= 0) then return end
        if self.VidTimer ~= 0 then _TimerService:ClearTimer(self.VidTimer) end
        self.VidTimer = 0
        local fresh = not e.Enable
        self.VidStart, self.VidDur = start, dur
        if fresh then
            -- 가림판을 먼저 켜고 한 박자(CoverLead) 뒤에 재생기를 켠다: 같은 프레임에 켜면 재생기의 하얀 첫 화면이 한 프레임 비쳤다 (10-27 전체 녹화)
            _UIKit:SetEnabled(self.Win .. "/Media/Cover", true)   -- 불러오는 동안 하얀 화면을 가린다 (Jump 뒤 JumpCover초에 걷는다)
            self.VidTimer = _TimerService:SetTimerOnce(function()
                local v = _UIKit:Get(self.Win .. "/Media/Video")
                if self.VidStart < 0 or not isvalid(v) then return end
                v.Enable = true
                v.YoutubePlayerGUIComponent:Play()
                self.VidTimer = _TimerService:SetTimerOnce(function() self:LoopVideo() end, self.VidLoad)
            end, self.CoverLead)
        else
            self:LoopVideo()
        end
        log("[VRF] guide video start=" .. tostring(start) .. " dur=" .. tostring(dur) .. " fresh=" .. tostring(fresh))
    end

    @ExecSpace("ClientOnly")
    method void LoopVideo()
        -- 구간 처음으로 옮기고, 길이가 지날 때마다 다시 처음으로
        if self.VidTimer ~= 0 then _TimerService:ClearTimer(self.VidTimer) end
        self.VidTimer = 0
        if self.VidStart < 0 then return end
        local e = _UIKit:Get(self.Win .. "/Media/Video")
        if not isvalid(e) or not e.Enable then return end
        self:JumpCovered(e)
        self.VidTimer = _TimerService:SetTimerRepeat(function()
            local v = _UIKit:Get(self.Win .. "/Media/Video")
            if self.VidStart >= 0 and isvalid(v) and v.Enable then self:JumpCovered(v) end
        end, self.VidDur)
        log("[VRF] guide video jump " .. tostring(self.VidStart))
    end

    @ExecSpace("ClientOnly")
    method void JumpCovered(Entity e)
        -- 구간 처음으로 옮기는 동안 인트로 그림으로 덮고(먼저 덮고 한 박자 뒤 Jump) JumpCover초 뒤 걷는다
        _UIKit:SetEnabled(self.Win .. "/Media/Cover", true)
        if self.CoverTimer ~= 0 then _TimerService:ClearTimer(self.CoverTimer) end
        self.CoverTimer = _TimerService:SetTimerOnce(function()
            local v = _UIKit:Get(self.Win .. "/Media/Video")
            if self.VidStart >= 0 and isvalid(v) and v.Enable then v.YoutubePlayerGUIComponent:Jump(self.VidStart) end
            self.CoverTimer = _TimerService:SetTimerOnce(function()
                self.CoverTimer = 0
                _UIKit:SetEnabled(self.Win .. "/Media/Cover", false)
            end, self.JumpCover)
        end, self.CoverLead)
    end

    @ExecSpace("ClientOnly")
    method void CoverBriefly(number sec)
        -- 인트로 그림으로 sec초 덮었다가 걷는다 (캡처 그림 첫 표시)
        _UIKit:SetEnabled(self.Win .. "/Media/Cover", true)
        if self.CoverTimer ~= 0 then _TimerService:ClearTimer(self.CoverTimer) end
        self.CoverTimer = _TimerService:SetTimerOnce(function()
            self.CoverTimer = 0
            _UIKit:SetEnabled(self.Win .. "/Media/Cover", false)
        end, sec)
    end

    @ExecSpace("ClientOnly")
    method void StopVideo()
        -- 영상 칸을 멈추고 끈다 (창 닫힘 · 영상 없는 쪽 · 상황 카드)
        if self.VidTimer ~= 0 then _TimerService:ClearTimer(self.VidTimer) end
        self.VidTimer = 0
        if self.CoverTimer ~= 0 then _TimerService:ClearTimer(self.CoverTimer) end
        self.CoverTimer = 0
        _UIKit:SetEnabled(self.Win .. "/Media/Cover", false)
        if self.VidStart < 0 then return end
        self.VidStart = -1
        local e = _UIKit:Get(self.Win .. "/Media/Video")
        if isvalid(e) and e.YoutubePlayerGUIComponent ~= nil then
            e.YoutubePlayerGUIComponent:Pause()
            e.Enable = false
        end
        log("[VRF] guide video stopped")
    end

    @ExecSpace("ClientOnly")
    method boolean IsSeen(string key)
        -- 편 적 있는 책갈피 (이번 접속 또는 계정 기록)
        if self.Seen[key] then return true end
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil then return false end
        return string.find("," .. save.GuideCards .. ",", ",gtab_" .. key .. ",", 1, true) ~= nil
    end

    @ExecSpace("ClientOnly")
    method void MarkSeen(integer tab)
        -- 책갈피를 폈다 → 점을 끄고 계정에 남긴다 (한 번만)
        local t = self.Tabs[tab]
        if t == nil or self:IsSeen(t.key) then return end
        self.Seen[t.key] = true
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save ~= nil then save:RequestGuideCard("gtab_" .. t.key) end
    end

    @ExecSpace("ClientOnly")
    method void CheckFirstEntry(number delta)
        -- 계정 첫 진입: 캐릭터를 다 불러왔고(선택 창이 닫힘), 이야기 카드가 끝났고, 다른 창이 없을 때 한 번
        if self.AutoDone then return end
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil or not save.BootDone or save.Selecting or save.Slot <= 0 then
            self.ReadyFor = 0
            return
        end
        if save.GuideSeen then
            self.AutoDone = true
            log("[VRF] guide auto-open skipped (already seen)")
            return
        end
        if _StoryCard.Active or #_StoryCard.Queue > 0 or _UIKit:AnyWindowOpen() then
            self.ReadyFor = 0
            return
        end
        self.ReadyFor = self.ReadyFor + delta
        if self.ReadyFor < self.ReadyDelay then return end
        self.AutoDone = true
        save:RequestGuideSeen()
        self.Tour = true
        self:ShowTab(1, 1)
        log("[VRF] guide auto-opened on first entry (tour to tab " .. tostring(self.TourLast) .. ")")
    end

    @ExecSpace("ClientOnly")
    method void CheckInputChoice(number delta)
        -- PC 이동 방식: 고른 적이 있으면 그대로 적용, 처음이면 게임 안내를 닫은 뒤 「마우스 / 키보드」를 묻는다 (10-21 사용자)
        if self.InputDone then return end
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil or not save.BootDone or save.Selecting or save.Slot <= 0 then
            self.InputReadyFor = 0
            return
        end
        if not Environment:IsPCPlatform() then
            self.InputDone = true
            return
        end
        if save.InputMode > 0 then
            self.InputDone = true
            self:ApplyInputMode(save.InputMode == 1)
            return
        end
        -- 처음: 안내 창·이야기 카드·다른 창이 모두 닫힌 뒤 잠깐 있다가
        if not self.AutoDone or _UIKit:IsOpen(self.Win) or _StoryCard.Active or #_StoryCard.Queue > 0 or _UIKit:AnyWindowOpen() or _ConfirmDialog:IsOpen() then
            self.InputReadyFor = 0
            return
        end
        self.InputReadyFor = self.InputReadyFor + delta
        if self.InputReadyFor < 1 then return end
        self.InputDone = true
        -- 10-24 사용자: 카드 두 장으로 실제 키(이동·공격·스킬·질주)를 보여 준다 (예전엔 다른 게임 이름으로 설명했다)
        _ConfirmDialog:ShowInputPick(function(mouse) self:ChooseInput(mouse) end)
        log("[VRF] input choice asked")
    end

    @ExecSpace("ClientOnly")
    method void ChooseInput(boolean mouse)
        -- 고른 방식을 바로 적용하고 계정에 남긴다
        self:ApplyInputMode(mouse)
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save ~= nil then save:RequestInputMode(mouse and 1 or 2) end
        log("[VRF] input chosen mouse=" .. tostring(mouse))
    end

    @ExecSpace("ClientOnly")
    method void ApplyInputMode(boolean mouse)
        ---@type ClickControl
        local cc = _UIKit:Comp("script.ClickControl")
        if cc == nil then return end
        if cc.MouseMode ~= mouse then cc:SetMouseMode(mouse) end
        _ShadowHUD:RefreshInputLabel()
    end

    method table BuildTabs(boolean mobile)
        -- 책갈피 7 · 쪽 26 (docs/design/35 §3). kind: "clip" 움짤 · "shot" 캡처 · "" 글만. shot = 그림 RUID (녹화 후 채운다)
        -- vid = { 영상 시작 초, 길이 } — 안내 영상 v9 (인트로 4초 + 본편 장면 초, assets/claude-guide-video-v1/README.md)
        local g = function(s) return "<color=#E8C66B>" .. s .. "</color>" end
        local r = function(s) return "<color=#E8705C>" .. s .. "</color>" end
        local b = function(s) return "<color=#7FB2FF>" .. s .. "</color>" end
        local key = function(pc, mo) return g(mobile and mo or pc) end
        local full = tostring(math.floor(_GameData.shadowFullLevel))
        local shot = function(k) return _GameData:GetUiIcon("guide_shot_" .. k) end   -- 캡처 1280×720 (ui_icons guide_shot_*, 메이커 10-27)
        local tabs = {}

        table.insert(tabs, { key = "start", name = "시작하기", pages = {
            { kind = "clip", vid = { 4, 5 }, head = "잡으면 내 편",
              body = "몬스터를 쓰러뜨리면 그 자리에 " .. g("혼") .. "이 남습니다.\n"
                .. "· 혼으로 " .. g("해골") .. "을 일으키거나, 혼을 " .. g("추출") .. "해 " .. g("그림자") .. "로 거둡니다.\n"
                .. "· 강한 적의 혼일수록 강한 그림자 — 보스도 내 편이 됩니다.\n"
                .. "· 스킬은 소환 · 영혼 · 저주 · 이동, 어느 쪽으로 키울지는 자유입니다." },
            mobile and { kind = "", head = "조작 (모바일)",
              body = "· " .. g("왼쪽 스틱") .. " 이동 · " .. g("큰 공격 버튼") .. " 누르고 있으면 계속 공격 (누른 채 끌어 조준)\n"
                .. "· " .. g("둘레 스킬 4칸") .. " — 끌어서 방향을 정하고 손을 떼면 발동\n"
                .. "· " .. g("벨트 4칸") .. " 물약 (길게 눌러 넣을 물건 바꾸기) · 혼 근처 " .. g("추출 버튼") .. "\n"
                .. "· " .. g("그림자 명령") .. " 소환 · 회수 · 집결 · " .. g("메뉴") .. " 소지품 · 능력치 · 스킬 · 그림자 · 퀘스트 · 설정" }
            or { kind = "", head = "조작 (PC)",
              body = "· " .. g("바닥 클릭") .. " 이동 (방향키도 됩니다) · " .. g("몬스터 클릭") .. " 공격, 누르고 있으면 계속\n"
                .. "· " .. g("A S D F · 우클릭") .. " 스킬 · " .. g("1 ~ 4") .. " 벨트 물약 · " .. g("Space") .. " 질주 (마을에서는 대화)\n"
                .. "· " .. g("E") .. " 혼 추출 · " .. g("Z") .. " 그림자 소환 · " .. g("X") .. " 회수 · " .. g("C") .. " 집결\n"
                .. "· " .. g("I") .. " 소지품 · " .. g("U") .. " 능력치 · " .. g("K") .. " 스킬 · " .. g("H") .. " 그림자 · " .. g("Q") .. " 퀘스트 · " .. g("M") .. " 메뉴 · Esc 창 닫기" },
            { kind = "shot", shot = shot("hud"), head = "화면 보는 법",
              body = "· 아래 양쪽 구슬 — 붉은 " .. g("생명") .. " · 푸른 " .. g("마나") .. "\n"
                .. "· 아래 가운데 — 스킬 칸과 벨트(물약)\n"
                .. "· 오른쪽 위 미니맵, 그 아래 " .. g("의뢰 추적") .. " — 지금 할 일을 알려 줍니다\n"
                .. "· 메뉴·버튼의 " .. r("붉은 점") .. " — 새로 쓸 포인트나 볼 것이 있다는 뜻입니다. 따라 누르세요" },
        } })

        table.insert(tabs, { key = "legion", name = "군단", pages = {
            { kind = "clip", vid = { 9, 23 }, head = "해골 일으키기",
              body = "혼을 써서 " .. g("해골 전사") .. "와 " .. g("해골 마법사") .. "를 일으킵니다 (소환 계열).\n"
                .. "· 함께 세울 수 있는 해골 수는 스킬 랭크만큼 — 랭크를 올리면 군단이 늘어납니다.\n"
                .. "· 그냥 쓰면 가까운 " .. g("일반 혼") .. "부터 씁니다. 정예·보스의 귀한 혼은 직접 겨냥했을 때만 씁니다." },
            { kind = "clip", vid = { 32, 7 }, head = "그림자 추출",
              body = "Lv5에 「그림자 소환」을 배우면 쓰러뜨린 적을 " .. g("그림자") .. "로 거둘 수 있습니다.\n"
                .. "· 혼 곁에서 " .. key("E", "추출 버튼") .. " — 성공하면 그 몬스터가 내 그림자가 됩니다.\n"
                .. "· 강한 몬스터일수록 강한 그림자. 정예 · 고유 몬스터 · 보스도 데려올 수 있습니다." },
            { kind = "clip", vid = { 39, 8 }, head = "그림자 창",
              body = key("그림자(H)", "메뉴 → 그림자") .. " 창에서 그림자를 고르면\n"
                .. "· " .. g("소환 지정") .. " — 불러낼 그림자와 순서를 정합니다. 지정한 그림자만 나옵니다\n"
                .. "· " .. g("강화") .. " — 정수를 써서 공격·생명을 올립니다 (내 레벨이 오를수록 더 높이)\n"
                .. "· " .. g("분해") .. " — 필요 없는 그림자를 정수로 바꿉니다" },
            { kind = "clip", vid = { 47, 5 }, head = "소환 · 회수 · 집결",
              body = (mobile and (g("그림자 명령") .. " 버튼") or (g("Z") .. " 소환 · " .. g("X") .. " 회수 · " .. g("C") .. " 집결")) .. "\n"
                .. "· " .. g("집결") .. "은 흩어진 군단을 내 곁으로 모읍니다 — 보스 앞에서 한 번에 몰아치세요\n"
                .. "· Lv" .. full .. "까지는 한 번에 1기, 그 뒤로는 레벨이 오를수록 여러 기를 함께 거느립니다" },
            { kind = "shot", shot = shot("skel_variant"), head = "해골 변이",
              body = "해골 스킬의 강화 노드를 찍으면 해골의 모습과 싸움법이 바뀝니다.\n"
                .. "· " .. g("해골 전사") .. " — 방패 · 대검 · 쌍칼\n"
                .. "· " .. g("해골 마법사") .. " — 쌍발 · 관통 · 폭발\n"
                .. "· 변이를 섞으면 랭크마다 순서대로 다른 해골이 일어납니다" },
        } })

        table.insert(tabs, { key = "growth", name = "성장", pages = {
            { kind = "shot", shot = shot("stats"), head = "레벨과 능력치",
              body = "레벨이 오르면 " .. g("능력치 포인트") .. "와 " .. g("스킬 포인트") .. "가 생깁니다.\n"
                .. "· " .. key("능력치(U)", "메뉴 → 능력치") .. " — 통솔(소환수) · 정신(마나) · 활력(생명) · 민첩\n"
                .. "· 1포인트 더 찍었을 때를 미리 보여 주고, 추천 분배도 있습니다" },
            { kind = "shot", shot = shot("skill_trees"), head = "스킬 네 계열",
              body = "· " .. g("소환") .. " — 해골과 그림자 군단을 키웁니다\n"
                .. "· " .. g("영혼") .. " — 뼈 마법으로 직접 싸웁니다\n"
                .. "· " .. g("저주") .. " — 적을 약하게 만들어 군단을 돕습니다\n"
                .. "· " .. g("이동") .. " — 망령 걸음 같은 움직임 스킬" },
            { kind = "clip", vid = { 63, 5 }, head = "스킬 강화",
              body = "스킬 창에서 스킬을 고르면 아래에 " .. g("강화 노드") .. "가 있습니다.\n"
                .. "· 스킬 포인트로 노드를 찍으면 그 스킬에 효과가 붙습니다 (그림마다 효과가 다릅니다)\n"
                .. "· 한 스킬을 깊게 파도, 여러 스킬을 고루 찍어도 됩니다" },
            { kind = "", head = "스킬 편집",
              body = "스킬 창의 " .. g("「스킬 편집」") .. "에서 " .. key("A S D F · 우클릭 칸", "둘레 스킬 4칸") .. "에 넣을 스킬을 바꿉니다.\n\n"
                .. (mobile and "· 자주 쓰는 스킬을 엄지가 닿는 칸에 두세요" or "· 스킬 칸을 눌러도 바로 바꿀 수 있습니다") },
        } })

        table.insert(tabs, { key = "gear", name = "장비·파밍", pages = {
            { kind = "clip", vid = { 68, 5 }, head = "등급과 빛 기둥",
              body = "몬스터는 장비를 떨어뜨립니다. 이름 색이 등급입니다.\n"
                .. "흰색 일반 · <color=#6E8CFF>파란색 마법</color> · <color=#FFE15A>노란색 레어</color> · <color=#3CDC3C>초록색 세트</color> · <color=#C8A050>금색 유니크</color>\n"
                .. "· 좋은 물건일수록 떨어질 때 " .. g("빛 기둥") .. "이 섭니다. 바닥의 물건은 직접 주워야 합니다\n"
                .. "· " .. g("펫") .. "을 데리고 있으면 정해 둔 등급까지 대신 주워 옵니다" },
            { kind = "shot", shot = shot("compare"), head = "비교하기",
              body = "아이템 위에 " .. (mobile and "손가락을 대면" or "마우스를 올리면") .. " 지금 낀 장비와 능력치를 비교해 줍니다.\n"
                .. "· 바꿔 끼면 무엇이 오르고 내리는지 바로 보입니다" },
            { kind = "shot", shot = shot("runeword"), head = "룬과 룬워드",
              body = "· " .. g("룬") .. "을 정해진 순서로 소켓에 넣으면 " .. g("룬워드") .. "가 완성됩니다\n"
                .. "· 조합법은 메뉴 「룬워드」에서 봅니다\n"
                .. "· 소켓 수가 맞는 장비에만 들어갑니다" },
            { kind = "shot", shot = shot("collection"), head = "세트 · 유니크 · 도감",
              body = "· 같은 " .. g("세트") .. "를 여러 부위 모으면 세트 효과가 붙습니다\n"
                .. "· " .. g("유니크") .. "는 정해진 능력치를 가진 특별한 장비입니다\n"
                .. "· 처음 얻은 유니크 · 세트 · 룬워드는 " .. g("아이템 도감") .. "에 남고 업적 보상이 있습니다" },
            { kind = "", head = "창고와 상인",
              body = "· 마을 " .. g("창고") .. "는 계정의 모든 캐릭터가 함께 씁니다 — 다른 캐릭터에게 장비를 넘길 때 쓰세요\n"
                .. "· 필요 없는 물건은 " .. g("상인") .. "에게 팔아 골드로 바꿉니다" },
        } })

        table.insert(tabs, { key = "adventure", name = "모험", pages = {
            { kind = "shot", shot = shot("quest"), head = "의뢰 따라가기",
              body = "마을 NPC의 " .. g("의뢰") .. "를 따라 나아갑니다. 화면 오른쪽 추적 칸이 다음 할 일을 알려 줍니다.\n"
                .. "액트 1 " .. g("무덤 왕국") .. " → 2 " .. g("모래 폐허") .. " → 3 " .. g("폭풍 해안") .. " → 4 " .. g("심연의 땅") .. "\n"
                .. "· NPC 머리 위 표시 — 새 의뢰 / 완료 보고" },
            { kind = "clip", vid = { 73, 8 }, head = "웨이포인트",
              body = "각 지역의 " .. g("웨이포인트") .. "를 밟아 켜 두면 마을에서 바로 그곳으로 이동할 수 있습니다.\n"
                .. "· 새 사냥터에 들어가면 먼저 웨이포인트부터 찾으세요" },
            { kind = "clip", vid = { 81, 13 }, head = "보스",
              body = "액트마다 중간 보스와 마지막 보스가 기다립니다.\n"
