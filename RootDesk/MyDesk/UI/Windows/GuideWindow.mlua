-- 게임 안내 창 (GameHUD/GuideWin — tools/build/ui.cjs): 처음 하는 사람에게 핵심 재미·조작·성장·진행·위험 신호를 쪽으로 보여 준다.
--   · 첫 진입: 계정에서 한 번도 안 봤으면(PlayerSave.GuideSeen) 캐릭터를 다 불러오고 시작 이야기 카드가 닫힌 뒤 저절로 연다.
--     연 순간 서버에 「봤다」를 남겨 다른 캐릭터·다음 접속에는 다시 띄우지 않는다 (RequestGuideSeen).
--   · 메뉴 「게임 안내」로 언제든 다시 본다.
--   · 조작 쪽은 PC·모바일 글이 다르다 (_ApplicationService:IsMobilePlatform).
--   · 상황 카드: GuideCoach가 그 순간 필요한 한 장만 같은 창에 띄운다 (ShowCard — 쪽 번호 없이 「확인」).
@Logic
script GuideWindow extends Logic

    property string Win = "GuideWin"
    property integer Page = 1
    property integer TimerId = 0
    property number ReadyFor = 0             -- 첫 진입 조건이 이어서 맞은 시간 (이야기 카드가 대기열에 들어올 틈을 준다)
    property number ReadyDelay = 2.5
    property boolean AutoDone = false        -- 이번 접속에서 저절로 띄우기를 끝냈다
    property table Pages = {}
    property boolean InputDone = false       -- 이번 접속에서 이동 방식을 적용했거나 물었다
    property number InputReadyFor = 0
    property boolean CardMode = false        -- 상황 카드 한 장을 보이는 중 (닫거나 메뉴로 열면 안내 쪽으로 돌아간다)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 창 등록·버튼 연결, 첫 진입 확인 타이머
        self.Pages = self:BuildPages(_ApplicationService:IsMobilePlatform())
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        _UIKit:Connect(self.Win .. "/BtnPrev", function() self:Turn(-1) end)
        _UIKit:Connect(self.Win .. "/BtnNext", function() self:Turn(1) end)
        self.TimerId = _TimerService:SetTimerRepeat(function()
            self:CheckFirstEntry(0.5)
            self:CheckInputChoice(0.5)
        end, 0.5)
        log("[VRF] GuideWindow ready pages=" .. tostring(#self.Pages) .. " mobile=" .. tostring(_ApplicationService:IsMobilePlatform()))
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 타이머 정리
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    @ExecSpace("ClientOnly")
    method void Show(integer page)
        -- 그 쪽을 펴서 연다
        if self.CardMode then
            self.CardMode = false
            self.Pages = self:BuildPages(_ApplicationService:IsMobilePlatform())
        end
        self.Page = math.max(1, math.min(#self.Pages, page))
        _UIKit:Open(self.Win)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void ShowCard(string head, string body)
        -- 상황 안내 한 장 (GuideCoach): 같은 창에 쪽 번호 없이, 「확인」으로 닫는다
        self.CardMode = true
        self.Pages = { { head = head, body = body } }
        self.Page = 1
        _UIKit:Open(self.Win)
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void Turn(integer step)
        -- 이전/다음. 마지막 쪽의 「시작하기」는 닫기
        local next = self.Page + step
        if next > #self.Pages then
            _UIKit:Close(self.Win)
            return
        end
        if next < 1 then return end
        self.Page = next
        self:Render()
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- 지금 쪽의 제목·본문·쪽 번호, 첫 쪽은 「이전」을 끄고 마지막 쪽은 「다음」을 「시작하기」로
        local p = self.Pages[self.Page]
        if p == nil then return end
        _UIKit:SetText(self.Win .. "/Paper/Head", p.head)
        _UIKit:SetText(self.Win .. "/Paper/Body", p.body)
        _UIKit:SetText(self.Win .. "/Page", self.CardMode and "" or (tostring(self.Page) .. " / " .. tostring(#self.Pages)))
        _UIKit:SetEnabled(self.Win .. "/BtnPrev", self.Page > 1)
        _UIKit:SetText(self.Win .. "/BtnNext", self.CardMode and "확인" or (self.Page >= #self.Pages and "시작하기" or "다음"))
    end

    @ExecSpace("ClientOnly")
    method void CheckFirstEntry(number delta)
        -- 계정 첫 진입: 캐릭터를 다 불러왔고(선택 창이 닫힘), 이야기 카드가 끝났고, 다른 창이 없을 때 한 번
        if self.AutoDone then return end
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil or not save.BootDone or save.Selecting or save.Slot <= 0 then
            self.ReadyFor = 0
            return
        end
        if save.GuideSeen then
            self.AutoDone = true
            log("[VRF] guide auto-open skipped (already seen)")
            return
        end
        if _StoryCard.Active or #_StoryCard.Queue > 0 or _UIKit:AnyWindowOpen() then
            self.ReadyFor = 0
            return
        end
        self.ReadyFor = self.ReadyFor + delta
        if self.ReadyFor < self.ReadyDelay then return end
        self.AutoDone = true
        save:RequestGuideSeen()
        self:Show(1)
        log("[VRF] guide auto-opened on first entry")
    end

    @ExecSpace("ClientOnly")
    method void CheckInputChoice(number delta)
        -- PC 이동 방식: 고른 적이 있으면 그대로 적용, 처음이면 게임 안내를 닫은 뒤 「마우스 / 키보드」를 묻는다 (10-21 사용자)
        if self.InputDone then return end
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save == nil or not save.BootDone or save.Selecting or save.Slot <= 0 then
            self.InputReadyFor = 0
            return
        end
        if not Environment:IsPCPlatform() then
            self.InputDone = true
            return
        end
        if save.InputMode > 0 then
            self.InputDone = true
            self:ApplyInputMode(save.InputMode == 1)
            return
        end
        -- 처음: 안내 창·이야기 카드·다른 창이 모두 닫힌 뒤 잠깐 있다가
        if not self.AutoDone or _UIKit:IsOpen(self.Win) or _StoryCard.Active or #_StoryCard.Queue > 0 or _UIKit:AnyWindowOpen() or _ConfirmDialog:IsOpen() then
            self.InputReadyFor = 0
            return
        end
        self.InputReadyFor = self.InputReadyFor + delta
        if self.InputReadyFor < 1 then return end
        self.InputDone = true
        local g = function(t) return "<color=#E8C66B>" .. t .. "</color>" end
        _ConfirmDialog:ShowChoice("이동 방식 고르기",
            g("마우스") .. " — 바닥을 눌러 이동, 적을 눌러 공격 (디아블로식)\n" .. g("키보드") .. " — 방향키로 이동, Ctrl로 공격 (메이플식)\n\n나중에 메뉴 → 설정에서 바꿀 수 있습니다.",
            "마우스", "키보드",
            function() self:ChooseInput(true) end,
            function() self:ChooseInput(false) end)
        log("[VRF] input choice asked")
    end

    @ExecSpace("ClientOnly")
    method void ChooseInput(boolean mouse)
        -- 고른 방식을 바로 적용하고 계정에 남긴다
        self:ApplyInputMode(mouse)
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if save ~= nil then save:RequestInputMode(mouse and 1 or 2) end
        log("[VRF] input chosen mouse=" .. tostring(mouse))
    end

    @ExecSpace("ClientOnly")
    method void ApplyInputMode(boolean mouse)
        ---@type ClickControl
        local cc = _UIKit:Comp("script.ClickControl")
        if cc == nil then return end
        if cc.MouseMode ~= mouse then cc:SetMouseMode(mouse) end
        _ShadowHUD:RefreshInputLabel()
    end

    method table BuildPages(boolean mobile)
        -- 쪽 내용 (금색 = 핵심 말, 붉은색 = 위험). 조작 쪽만 PC·모바일이 다르다
        local g = function(s) return "<color=#E8C66B>" .. s .. "</color>" end
        local r = function(s) return "<color=#E8705C>" .. s .. "</color>" end
        local b = function(s) return "<color=#7FB2FF>" .. s .. "</color>" end
        local pages = {}
        table.insert(pages, { head = "마지막 네크로맨서",
            body = "심장의 조각 「혼각」에 묶여 망자가 일어선 땅. 당신은 그 " .. g("사슬을 끊는 마지막 네크로맨서") .. "입니다.\n\n"
                .. "· 몬스터를 쓰러뜨리면 사슬에서 풀려난 " .. g("혼") .. "이 그 자리에 남습니다.\n"
                .. "· 혼으로 " .. g("해골 전사") .. "를 일으키고, Lv5 스킬 「그림자 소환」을 배우면 혼을 " .. g("추출") .. "해 " .. g("그림자") .. "로 곁에 세웁니다.\n"
                .. "· 강한 적의 혼일수록 강한 그림자가 됩니다. 보스의 혼도 당신 곁에 섭니다.\n\n"
                .. "스킬은 세 계열 — " .. g("소환") .. "(해골·그림자 군단) · " .. g("영혼") .. "(뼈 마법) · " .. g("저주") .. "(적 약화)\n"
                .. "어느 쪽으로 키울지는 자유입니다. 레벨이 오르면 능력치·스킬 포인트가 생깁니다 (메뉴의 붉은 점)." })
        if mobile then
            table.insert(pages, { head = "조작 (모바일)",
                body = "· " .. g("왼쪽 스틱") .. " — 이동\n"
                    .. "· " .. g("큰 공격 버튼") .. " — 누르고 있으면 가까운 적을 계속 공격 (누른 채 끌어 조준)\n"
                    .. "· " .. g("둘레 스킬 4칸") .. " — 끌어서 방향을 정하고 손을 떼면 발동\n"
                    .. "· " .. g("벨트 4칸") .. " — 물약 (칸을 길게 누르면 넣을 물건을 바꿉니다)\n"
                    .. "· " .. g("그림자 명령") .. " — 소환 · 회수 · 집결\n"
                    .. "· 혼 근처의 " .. g("추출 버튼") .. " — 혼을 그림자로 거둡니다\n"
                    .. "· " .. g("메뉴") .. " — 소지품 · 능력치 · 스킬 · 그림자 · 퀘스트 · 룬워드 · 설정 · 채널\n\n"
                    .. "스킬 칸에 넣을 스킬은 스킬 창의 「스킬 편집」에서 바꿉니다." })
        else
            table.insert(pages, { head = "조작 (PC)",
                body = "· " .. g("바닥 클릭") .. " — 그 자리로 이동 (방향키로도 이동)\n"
                    .. "· " .. g("몬스터 클릭") .. " — 다가가서 공격, 누르고 있으면 계속 공격\n"
                    .. "· " .. g("A S D F · 우클릭") .. " — 스킬 (칸을 누르면 넣을 스킬을 바꿉니다)\n"
                    .. "· " .. g("1 ~ 4") .. " — 벨트 물약 (칸 우클릭 = 넣을 물건 바꾸기)\n"
                    .. "· " .. g("E") .. " — 가까운 혼 추출   · " .. g("Z") .. " 그림자 소환 · " .. g("X") .. " 회수 · " .. g("C") .. " 집결\n"
                    .. "· " .. g("Space") .. " — NPC와 대화\n"
                    .. "· " .. g("I") .. " 소지품 · " .. g("U") .. " 능력치 · " .. g("K") .. " 스킬 · " .. g("H") .. " 그림자 · " .. g("Q") .. " 퀘스트 · " .. g("P") .. " 플레이어 · " .. g("L") .. " 랭킹 · " .. g("M") .. " 메뉴\n\n"
                    .. "창은 Esc로 닫습니다." })
        end
        table.insert(pages, { head = "장비와 룬 — 파밍",
            body = "몬스터는 장비를 떨어뜨립니다. 이름 색이 등급입니다.\n"
                .. "흰색 일반 · <color=#6E8CFF>파란색 마법</color> · <color=#FFE15A>노란색 레어</color> · <color=#3CDC3C>초록색 세트</color> · <color=#C8A050>금색 유니크</color>\n\n"
                .. "· " .. g("룬") .. "을 정해진 순서로 소켓에 넣으면 " .. g("룬워드") .. "가 완성됩니다 — 조합법은 메뉴 「룬워드」\n"
                .. "· 같은 세트를 여러 부위 모으면 세트 효과가 붙습니다\n"
                .. "· 야영지 " .. g("창고") .. "는 계정의 모든 캐릭터가 함께 씁니다\n"
                .. "· 처음 얻은 유니크·세트·룬워드는 " .. g("아이템 도감") .. "에 남고 업적 보상이 있습니다\n"
                .. "· 아이템 위에 손을 올리면(모바일은 누르면) 능력치를 비교해 줍니다" })
        table.insert(pages, { head = "모험의 흐름",
            body = "· 야영지 NPC의 " .. g("의뢰") .. "를 따라 액트 1 → 2 → 3을 나아갑니다 (화면 오른쪽 추적 칸)\n"
                .. "· 각 지역의 " .. g("웨이포인트") .. "를 켜 두면 마을에서 바로 이동할 수 있습니다\n"
                .. "· 액트 3 보스를 쓰러뜨리면 다음 난이도 " .. g("악몽") .. ", 그다음 " .. g("지옥") .. "이 열립니다 — 몬스터·보상 모두 강해집니다\n"
                .. "· 악몽부터는 쓰러지면 경험치를 조금 잃습니다\n"
                .. "· 끝없는 " .. g("심도") .. "에서 최고 층 기록을 겨룹니다 (랭킹)\n\n"
                .. "· 최대 " .. g("4명") .. "까지 파티를 맺을 수 있습니다 (메뉴 「플레이어」)\n"
                .. "· 한 채널에는 4명까지 — 친구와 만나려면 메뉴 「채널 변경」으로 같은 채널에 들어갑니다" })
        table.insert(pages, { head = "이것만은 기억하세요",
            body = "· " .. r("바닥의 붉은 원") .. " — 곧 터지는 범위 공격입니다. 원 밖으로 걸어 나가면 피할 수 있습니다\n"
                .. "· " .. b("몸이 푸른 몬스터") .. " — 변종 우두머리. 특수 기술을 쓰고 좋은 것을 떨어뜨립니다\n"
                .. "· " .. g("발밑에 색 원") .. "이 있는 몬스터 — 주변 적을 강하게 하는 오오라 (빨강 광기 · 노랑 질풍 · 하늘 수호). 먼저 잡으세요\n"
                .. "· 이름 있는 " .. g("고유 몬스터") .. "와 보스는 혼도 특별합니다 — 꼭 추출해 보세요\n"
                .. "· 마나가 모자라면 스킬이 나가지 않습니다. 벨트에 물약을 채워 두세요\n\n"
                .. "이 안내는 " .. g("메뉴 → 게임 안내") .. "에서 언제든 다시 볼 수 있습니다." })
        return pages
    end

end
