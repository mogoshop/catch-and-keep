-- 소지품 창 (I): 장비 10부위(종이 인형, 빈 칸은 실루엣), 가방 30칸(아이콘 + 등급 테두리), 선택 아이템 설명, 장착·판매.
-- 룬을 고른 뒤 장비 칸을 누르면 소켓.
-- 거래 중에는 가방 칸을 누르면 거래창에 올라간다 (TradeWindow).
@Logic
script InventoryWindow extends Logic

    property string Win = "InvWin"
    property string SlotOrder = "weapon,offhand,helm,armor,gloves,boots,belt,amulet,ring1,ring2"
    property integer Selected = 0
    property string RenderKey = ""
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for slot in string.gmatch(self.SlotOrder, "[^,]+") do
            local s = slot
            _UIKit:Connect(self.Win .. "/Doll/Eq_" .. s, function() self:OnEquipSlot(s) end)
        end
        for i = 1, 30 do
            local index = i
            _UIKit:Connect(self.Win .. "/Bag/Bag" .. tostring(i), function() self:OnBagSlot(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnEquip", function() self:Act("equip") end)
        _UIKit:Connect(self.Win .. "/BtnSell", function() self:Act("sell") end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    method PlayerInventory Inv()
        ---@type PlayerInventory
        local c = _UIKit:Comp("script.PlayerInventory")
        return c
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        if not _UIKit:IsOpen(self.Win) then
            self.RenderKey = ""
            return
        end
        local inv = self:Inv()
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if inv == nil or st == nil or belt == nil then return end
        local key = inv.BagDigest .. "#" .. inv.EquipDigest .. "#" .. tostring(st.Gold) .. "#" .. tostring(self.Selected) .. "#" .. tostring(belt.HpPot) .. tostring(belt.MpPot)
        if key == self.RenderKey then return end
        self.RenderKey = key
        _UIKit:SetText(self.Win .. "/Gold", "골드 " .. tostring(st.Gold) .. "      생명 물약 " .. tostring(belt.HpPot) .. "   마나 물약 " .. tostring(belt.MpPot))
        -- 장비: 아이콘 + 등급 테두리, 빈 칸은 부위 실루엣
        local eq = inv:GetEquipMap()
        for slot in string.gmatch(self.SlotOrder, "[^,]+") do
            local path = self.Win .. "/Doll/Eq_" .. slot
            local s = eq[slot]
            self:DrawItem(path, s)
            _UIKit:SetEnabled(path .. "/Ghost", s == nil)
        end
        -- 가방: 아이콘 + 등급 테두리, 고른 칸은 노랗게
        local list = inv:GetBagList()
        if self.Selected > #list then self.Selected = 0 end
        for i = 1, 30 do
            local path = self.Win .. "/Bag/Bag" .. tostring(i)
            self:DrawItem(path, list[i])
            -- 칸 바탕은 어두운 색, 고른 칸만 청동빛
            _UIKit:SetColor(path, i == self.Selected and Color(0.42, 0.3, 0.12, 0.95) or Color(0.05, 0.045, 0.06, 0.94))
        end
        local desc = "아이템을 선택하세요."
        local sel = list[self.Selected]
        if sel ~= nil then
            desc = _ItemData:Describe(sel) .. "\n판매가 " .. tostring(_ItemData:SellValue(sel)) .. " 골드"
            if _ItemData:IsRune(_ItemData:Parse(sel).base) then desc = desc .. "\n→ 소켓이 빈 장비 칸을 누르면 끼운다" end
        end
        _UIKit:SetText(self.Win .. "/DescBox/Desc", desc)
    end

    @ExecSpace("ClientOnly")
    method void DrawItem(string path, any s)
        -- 칸 하나: 아이템 그림(베이스 아이콘, 룬은 룬 그림) + 등급 테두리(마법·레어·유니크·세트/룬워드)
        if s == nil then
            _UIKit:SetIcon(path .. "/Icon", "")
            _UIKit:SetIcon(path .. "/Frame", "")
            return
        end
        local item = _ItemData:Parse(s)
        local icon = ""
        if _ItemData:IsRune(item.base) then
            icon = _GameData:GetUiIcon("rune")
        else
            local base = _ItemData:GetBase(item.base)
            if base ~= nil then icon = base.icon end
        end
        _UIKit:SetIcon(path .. "/Icon", icon)
        local frames = { "frame_magic", "frame_rare", "frame_unique", "frame_set", "frame_unique" }
        local frame = ""
        if item.rarity >= 1 and item.rarity <= 5 then frame = _GameData:GetUiIcon(frames[item.rarity]) end
        _UIKit:SetIcon(path .. "/Frame", frame)
    end

    @ExecSpace("ClientOnly")
    method void OnBagSlot(integer index)
        -- 거래 중이면 거래창에 올리고, 아니면 선택
        ---@type PlayerTrade
        local trade = _UIKit:Comp("script.PlayerTrade")
        if trade ~= nil and trade.Partner ~= "" then
            trade:RequestOffer(index)
            return
        end
        self.Selected = index
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void OnEquipSlot(string slot)
        -- 룬을 고른 상태면 그 장비에 소켓, 아니면 장비 해제
        local inv = self:Inv()
        if inv == nil then return end
        local sel = inv:GetBagList()[self.Selected]
        if sel ~= nil and _ItemData:IsRune(_ItemData:Parse(sel).base) then
            inv:RequestSocket(self.Selected, slot)
            self.Selected = 0
        else
            inv:RequestUnequip(slot)
        end
        self.RenderKey = ""
    end

    @ExecSpace("ClientOnly")
    method void Act(string action)
        local inv = self:Inv()
        if inv == nil or self.Selected <= 0 then return end
        if action == "equip" then inv:RequestEquip(self.Selected) else inv:RequestSell(self.Selected) end
        self.Selected = 0
        self.RenderKey = ""
    end

end
