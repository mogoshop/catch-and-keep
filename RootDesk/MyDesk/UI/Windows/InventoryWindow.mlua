-- 소지품 창 (I): 장비 10부위(종이 인형, 빈 칸은 실루엣), 가방 60칸(아이콘 + 등급 테두리), 선택 아이템 설명, 장착·버리기.
-- 판매는 상인(잿빛 행상 고르) 곁에서만: 그때만 「버리기」 자리가 「판매」로 바뀐다. 둘 다 확인 창을 거친다.
-- 장비·룬은 선택만으로 바뀌지 않는다. 설명과 미리보기를 확인한 뒤 작업 버튼으로 확정한다.
-- 거래 중에는 가방 칸을 누르면 거래창에 올라간다 (TradeWindow).
@Logic
script InventoryWindow extends Logic

    property string Win = "InvWin"
    property string SlotOrder = "weapon,offhand,helm,armor,gloves,boots,belt,amulet,ring1,ring2"
    property integer Selected = 0
    property string SelectedItem = ""
    property string SelectedEquipSlot = ""
    property string SelectedEquipItem = ""
    property string SocketSlot = ""
    property string SocketItem = ""
    property string RenderKey = ""
    property integer TimerId = 0
    property boolean PreviewSelection = true
    property string PreviewKey = ""
    property string EquipResultSlot = ""
    property string EquipResultBefore = ""
    property string EquipResultAfter = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 선택과 확정을 분리한 소지품 창을 등록한다.
        self:ClearSelection()
        _UIKit:SetEnabled("/ui/GameHUD/InvWin", false)
        _UIKit:RegisterWindow(self.Win)
        _UIKit:SetText(self.Win .. "/Hint", "선택 → 설명 확인\n버튼으로 작업 확정")
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for slot in string.gmatch(self.SlotOrder, "[^,]+") do
            local s = slot
            _UIKit:Connect(self.Win .. "/Doll/Eq_" .. s, function() self:OnEquipSlot(s) end)
        end
        for i = 1, 60 do
            local index = i
            _UIKit:Connect(self.Win .. "/Bag/Bag" .. tostring(i), function() self:OnBagSlot(index) end)
        end
        _UIKit:Connect(self.Win .. "/BtnEquip", function() self:Act("equip") end)
        _UIKit:Connect(self.Win .. "/BtnSell", function() self:Act("sell") end)
        _UIKit:Connect(self.Win .. "/Doll/BtnPreview", function() self:TogglePreview() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
        log("[VRF] InventoryWindow inspect-first ready")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 반복 갱신과 선택 상태를 플레이 종료 시 정리한다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self:ClearSelection()
    end

    method PlayerInventory Inv()
        ---@type PlayerInventory
        local c = _UIKit:Comp("script.PlayerInventory")
        return c
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        -- 동기화로 칸의 아이템이 바뀌면 선택을 해제한다. 새 물건에 오래된 작업을 보내지 않는다.
        if not _UIKit:IsOpen(self.Win) then
            self:ClearSelection()
            return
        end
        local inv = self:Inv()
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        ---@type PlayerBelt
        local belt = _UIKit:Comp("script.PlayerBelt")
        if inv == nil or st == nil or belt == nil then return end
        local list = inv:GetBagList()
        local eq = inv:GetEquipMap()
        if self.EquipResultSlot ~= "" and eq[self.EquipResultSlot] == self.EquipResultAfter then
            self.SelectedEquipSlot = self.EquipResultSlot
            self.SelectedEquipItem = self.EquipResultAfter
        end
        self:ValidateSelection(list, eq)
        self:RenderAppearance(eq, list[self.Selected] or "")
        local alive = _Util:IsAlive(_UserService.LocalPlayer)
        local key = table.concat({inv.BagDigest, inv.EquipDigest, tostring(st.Gold), tostring(st.Level), tostring(alive), tostring(self.Selected), self.SelectedEquipSlot, self.SocketSlot, tostring(belt.HpPot), tostring(belt.MpPot), self.EquipResultAfter, self.EquipResultBefore, tostring(self:NearShop())}, "#")
        if key == self.RenderKey then return end
        self.RenderKey = key
        _UIKit:SetText(self.Win .. "/Gold", "골드 " .. tostring(st.Gold) .. "      생명 물약 " .. tostring(belt.HpPot) .. "   마나 물약 " .. tostring(belt.MpPot))
        for slot in string.gmatch(self.SlotOrder, "[^,]+") do
            local path = self.Win .. "/Doll/Eq_" .. slot
            self:DrawItem(path, eq[slot])
            _UIKit:SetEnabled(path .. "/Ghost", eq[slot] == nil)
            local chosen = slot == self.SelectedEquipSlot or slot == self.SocketSlot
            _UIKit:SetColor(path, chosen and Color(0.42, 0.3, 0.12, 0.95) or Color(0.05, 0.045, 0.06, 0.94))
        end
        for i = 1, 60 do
            local path = self.Win .. "/Bag/Bag" .. tostring(i)
            self:DrawItem(path, list[i])
            _UIKit:SetColor(path, i == self.Selected and Color(0.42, 0.3, 0.12, 0.95) or Color(0.05, 0.045, 0.06, 0.94))
        end
        -- 아무것도 고르지 않았으면 「장비로 오른 능력치」 합계를 보여 준다 (능력치 창은 기본·투자 몫)
        local desc = self:GearSummary(st)
        local label, allowed, sell = "장착", false, false
        local sel = list[self.Selected]
        if self.SelectedEquipSlot ~= "" then
            local worn = eq[self.SelectedEquipSlot]
            desc = "<color=#C8A050>현재 착용 중</color>\n" .. _ItemData:DescribeDetailed(worn) .. self:SetSection(worn, eq) .. self:SummonHint(worn)
            if self.EquipResultSlot == self.SelectedEquipSlot and worn == self.EquipResultAfter then
                local change = _ItemData:CompareText(worn, self.EquipResultBefore)
                change = string.gsub(change, "착용 중인 것과 비교:", "이번 장착 변화:")
                change = string.gsub(change, "빈 칸에 착용하면:", "이번 장착 변화:")
                desc = "<color=#E0B87A>장착 완료</color>\n" .. _ItemData:DescribeDetailed(worn) .. self:SummonHint(worn) .. "\n\n" .. change
            end
            label = "해제"
            allowed = #list < inv.BagSize
            if not allowed then desc = desc .. "\n<color=#FF6464>가방이 가득 차 해제할 수 없습니다.</color>" end
        elseif sel ~= nil then
            sell = true
            desc = _ItemData:DescribeDetailed(sel) .. self:SetSection(sel, eq) .. self:SummonHint(sel) .. "\n판매가 " .. tostring(_ItemData:SellValue(sel)) .. " 골드"
            if _ItemData:IsRune(_ItemData:Parse(sel).base) then
                label = "룬 끼우기"
                desc = desc .. "\n장비 칸을 골라 삽입 후 효과를 확인하세요."
                if self.SocketSlot ~= "" then
                    local target = eq[self.SocketSlot]
                    allowed = self:CanSocket(sel, target)
                    if allowed then
                        desc = desc .. self:SocketPreview(sel, target)
                    elseif target == nil then
                        desc = desc .. "\n<color=#FF6464>빈 장비 칸에는 룬을 끼울 수 없습니다.</color>"
                    else
                        desc = desc .. "\n<color=#FF6464>선택한 장비에 빈 소켓이 없습니다.</color>"
                    end
                end
            else
                desc = desc .. self:CompareLine(sel, eq, st)
                allowed = self:CanEquip(sel, st)
            end
        end
        if not alive then
            allowed = false
            sell = false
            desc = desc .. "\n<color=#FF6464>사망 중에는 장비 작업을 할 수 없습니다.</color>"
        end
        self:SetDescription(desc)
        self:SetActionButton("BtnEquip", label, allowed)
        self:SetActionButton("BtnSell", self:NearShop() and "판매" or "버리기", sell)
    end

    @ExecSpace("ClientOnly")
    method void SetDescription(string desc)
        -- 긴 장비 옵션은 작은 글씨로 줄이거나 잘라내지 않고 세로로 스크롤한다.
        local text = _UIKit:Get(self.Win .. "/DescBox/Desc")
        local box = _UIKit:Get(self.Win .. "/DescBox")
        if not isvalid(text) or not isvalid(box) then return end
        text.TextGUIRendererComponent.Text = desc
        local height = text.TextGUIRendererComponent:GetPreferredHeight(desc, 740)
        text.UITransformComponent.RectSize = Vector2(740, math.max(48, height + 16))
        if box.ScrollLayoutGroupComponent ~= nil then box.ScrollLayoutGroupComponent:ResetScrollPosition(UITransformAxis.Vertical) end
    end

    @ExecSpace("ClientOnly")
    method void TogglePreview()
        -- 미리보기 버튼은 가방과 착용 장비에 요청을 보내지 않는다.
        if not _UIKit:IsOpen(self.Win) then return end
        local inv = self:Inv()
        if inv == nil then return end
        local list, eq = inv:GetBagList(), inv:GetEquipMap()
        self:ValidateSelection(list, eq)
        if not _ItemData:HasAppearance(list[self.Selected] or "") then return end
        self.PreviewSelection = not self.PreviewSelection
        self.PreviewKey = ""
        self:RenderAppearance(eq, list[self.Selected])
    end

    @ExecSpace("ClientOnly")
    method void RenderAppearance(table eq, string selected)
        -- 로컬 UI 아바타만 교체한다. 실제 캐릭터 외형과 능력치는 장착 확정 전 그대로 둔다.
        local preview = _UIKit:Get(self.Win .. "/Doll/Avatar")
        local player = _UserService.LocalPlayer
        if not isvalid(preview) or not isvalid(player) or not isvalid(player.CostumeManagerComponent) then return end
        local source, costume = player.CostumeManagerComponent, preview.CostumeManagerComponent
        if not isvalid(costume) then return end
        local supported = _ItemData:HasAppearance(selected)
        local showing = supported and self.PreviewSelection
        local parts = _ItemData:AppearanceParts(eq, showing and selected or "")
        local identity = {
            (source:GetEquip(MapleAvatarItemCategory.Body) or ""), (source:GetEquip(MapleAvatarItemCategory.Hair) or ""),
            (source:GetEquip(MapleAvatarItemCategory.Face) or ""), (source:GetEquip(MapleAvatarItemCategory.Ear) or "")
        }
        local key = table.concat(identity, "/") .. "/" .. table.concat({ parts.armor, parts.helm, parts.gloves, parts.boots, parts.weapon, tostring(showing), selected }, "/")
        if key == self.PreviewKey then return end
        self.PreviewKey = key
        local categories = { MapleAvatarItemCategory.Body, MapleAvatarItemCategory.Hair, MapleAvatarItemCategory.Face, MapleAvatarItemCategory.Ear }
        for i, category in ipairs(categories) do costume:SetEquip(category, identity[i]) end
        costume.UseCustomEquipOnly = true
        costume:SetEquip(MapleAvatarItemCategory.Longcoat, parts.armor)
        costume:SetEquip(MapleAvatarItemCategory.Cap, parts.helm)
        costume:SetEquip(MapleAvatarItemCategory.Glove, parts.gloves)
        costume:SetEquip(MapleAvatarItemCategory.Shoes, parts.boots)
        costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, parts.weapon)
        _UIKit:SetEnabled(self.Win .. "/Doll/Avatar", identity[1] ~= "")
        _UIKit:SetText(self.Win .. "/Doll/PreviewState", showing and "선택 장비 · 미착용" or "현재 착용 모습")
        local label = "장비 선택 후 외형 비교"
        if supported then label = showing and "현재 모습 보기" or "선택 모습 보기"
        elseif selected ~= "" then label = "외형 변화 없는 부위" end
        local button = _UIKit:Get(self.Win .. "/Doll/BtnPreview")
        if isvalid(button) then
            button.ButtonComponent.Enable = supported
            button.TextGUIRendererComponent.Text = label
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearSelection()
        -- 가방·착용품·룬 대상의 식별값과 표시 캐시를 함께 지운다.
        self.Selected = 0
        self.SelectedItem = ""
        self.SelectedEquipSlot = ""
        self.SelectedEquipItem = ""
        self.SocketSlot = ""
        self.SocketItem = ""
        self.RenderKey = ""
        self.PreviewSelection = true
        self.PreviewKey = ""
        self.EquipResultSlot = ""
        self.EquipResultBefore = ""
        self.EquipResultAfter = ""
    end

    @ExecSpace("ClientOnly")
    method void OnEquipped(string slot, string before, string after)
        -- 서버 장착 성공 응답 후 착용 칸과 변화량을 남긴다. 뒤늦은 응답이 새 선택을 빼앗지 않는다.
        if not _UIKit:IsOpen(self.Win) or self.Selected > 0 or self.SelectedEquipSlot ~= "" then return end
        self:ClearSelection()
        self.EquipResultSlot = slot
        self.EquipResultBefore = before
        self.EquipResultAfter = after
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void ValidateSelection(table list, table eq)
        -- 선택 이후 판매·거래·장착 등으로 실제 물건이 바뀌면 작업 대상을 잃는다.
        if self.Selected > 0 and list[self.Selected] ~= self.SelectedItem then self:ClearSelection() return end
        if self.SelectedEquipSlot ~= "" and eq[self.SelectedEquipSlot] ~= self.SelectedEquipItem then self:ClearSelection() return end
        if self.SocketSlot ~= "" and (eq[self.SocketSlot] or "") ~= self.SocketItem then
            self.SocketSlot = ""
            self.SocketItem = ""
            self.RenderKey = ""
        end
    end

    @ExecSpace("ClientOnly")
    method boolean CanEquip(string sel, PlayerStats st)
        -- 클라이언트 안내를 위한 자격 확인이다. 서버는 동일한 장착 조건을 다시 검증한다.
        local base = _ItemData:GetBase(_ItemData:Parse(sel).base)
        return base ~= nil and _ItemData:GetSlot(sel) ~= "" and st ~= nil and st.Level >= base.reqLv
    end

    @ExecSpace("ClientOnly")
    method boolean CanSocket(string sel, any target)
        -- 존재하는 룬과 빈 소켓이 있는 착용 장비만 확정할 수 있다.
        local rune = _ItemData:Parse(sel)
        if not _ItemData:IsRune(rune.base) or _ItemData:GetRune(rune.base) == nil or target == nil then return false end
        local item = _ItemData:Parse(target)
        return item.sockets > #item.runes
    end

    @ExecSpace("ClientOnly")
    method string SocketPreview(string sel, string target)
        -- 문자열 사본에만 룬을 넣어 최종 능력치와 룬워드를 계산한다. 가방·장비는 건드리지 않는다.
        local item = _ItemData:Parse(target)
        table.insert(item.runes, _ItemData:Parse(sel).base)
        local after = _ItemData:Serialize(item)
        local delta = _ItemData:CompareText(after, target)
        delta = string.gsub(delta, "착용 중인 것과 비교:", "삽입 후 변화:")
        return "\n대상: " .. _ItemData:DisplayName(target) .. "\n" .. delta
            .. "\n완성: " .. _ItemData:DisplayName(after)
            .. "\n<color=#E0B87A>「룬 끼우기」를 누르면 룬 1개가 소모됩니다. 되돌릴 수 없습니다.</color>"
    end

    @ExecSpace("ClientOnly")
    method string SummonHint(string sel)
        -- 소환 시점에 확정되는 장비 효과를 설명해 이미 부른 유닛과 혼동하지 않게 한다.
        if (_ItemData:GetTotalMods(sel).minion or 0) ~= 0 then return "\n소환수 능력치 효과는 새로 소환할 때 적용됩니다." end
        return ""
    end

    @ExecSpace("ClientOnly")
    method void SetActionButton(string name, string label, boolean allowed)
        -- 비활성 작업도 버튼과 이유는 보인다. ButtonComponent만 입력을 차단한다.
        local path = self.Win .. "/" .. name
        _UIKit:SetText(path, label)
        local e = _UIKit:Get(path)
        if isvalid(e) and e.ButtonComponent ~= nil then e.ButtonComponent.Enable = allowed end
        _UIKit:SetColor(path, allowed and Color(1, 1, 1, 1) or Color(0.42, 0.42, 0.42, 1))
    end

    @ExecSpace("ClientOnly")
    method string CompareLine(string sel, table eq, PlayerStats st)
        -- 장비면: 요구 레벨 부족 경고 + 같은 부위 착용품과 능력치 비교 (반지는 빈 칸이 있으면 빈 칸, 아니면 첫째 반지)
        local slot = _ItemData:GetSlot(sel)
        if slot == "" then return "" end
        local line = ""
        local base = _ItemData:GetBase(_ItemData:Parse(sel).base)
        if base ~= nil and base.reqLv > st.Level then line = "\n<color=#FF6464>레벨 부족 — Lv" .. tostring(base.reqLv) .. " 필요</color>" end
        local old = ""
        if slot == "ring" then
            if eq.ring1 ~= nil and eq.ring2 ~= nil then old = eq.ring1 end
        elseif eq[slot] ~= nil then
            old = eq[slot]
        end
        return line .. "\n" .. _ItemData:CompareText(sel, old)
    end

    method void DrawItem(string path, any s)
        -- 칸 하나: 아이템 그림(베이스 아이콘, 룬은 룬 그림) + 등급은 칸 테두리 색 (마법 파랑·레어 노랑·유니크 금·세트 초록, 일반은 원래 청동)
        if s == nil then
            _UIKit:SetIcon(path .. "/Icon", "")
            _UIKit:SetColor(path .. "/Rim", Color(1, 1, 1, 1))
            return
        end
        local item = _ItemData:Parse(s)
        local icon = _ItemData:IconFor(s)
        _UIKit:SetIcon(path .. "/Icon", icon)
        local tints = { Color(0.55, 0.72, 1, 1), Color(1, 0.95, 0.4, 1), Color(1, 0.78, 0.4, 1), Color(0.5, 1, 0.5, 1), Color(1, 0.78, 0.4, 1) }
        local tint = Color(1, 1, 1, 1)
        if item.rarity >= 1 and item.rarity <= 5 then tint = tints[item.rarity] end
        _UIKit:SetColor(path .. "/Rim", tint)
    end

    @ExecSpace("ClientOnly")
    method void OnBagSlot(integer index)
        -- 거래 중의 제안 동작은 유지하고, 일반 가방 선택은 설명만 표시한다.
        ---@type PlayerTrade
        local trade = _UIKit:Comp("script.PlayerTrade")
        if trade ~= nil and trade.Partner ~= "" then
            trade:RequestOffer(index)
            return
        end
        local inv = self:Inv()
        if inv == nil then return end
        local sel = inv:GetBagList()[index]
        self:ClearSelection()
        if sel ~= nil then self.Selected = index self.SelectedItem = sel end
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void OnEquipSlot(string slot)
        -- 착용 칸은 해제나 룬 소모 없이 선택만 한다. 별도 작업 버튼으로 확정한다.
        local inv = self:Inv()
        if inv == nil or string.find("," .. self.SlotOrder .. ",", "," .. slot .. ",", 1, true) == nil then return end
        local list, eq = inv:GetBagList(), inv:GetEquipMap()
        self:ValidateSelection(list, eq)
        local sel = list[self.Selected]
        if sel ~= nil and _ItemData:IsRune(_ItemData:Parse(sel).base) then
            self.SocketSlot = slot
            self.SocketItem = eq[slot] or ""
        else
            self:ClearSelection()
            if eq[slot] ~= nil then self.SelectedEquipSlot = slot self.SelectedEquipItem = eq[slot] end
        end
        self.RenderKey = ""
        self:Poll()
    end

    method string SetSection(string s, table eq)
        -- 세트 조각이면 세트 전체 부위·부위 수별 효과 (착용 중인 수 기준으로 활성 표시)
        local text = _ItemData:DescribeSet(s, eq)
        if text == "" then return "" end
        return "\n\n" .. text
    end

    method string GearSummary(PlayerStats st)
        -- 착용 장비가 주는 효과 합계. 0인 항목은 숨긴다
        if st == nil then return "가방이나 착용 장비를 선택하세요." end
        local rows = {}
        local function add(label, value, fmt)
            if value ~= nil and math.abs(value) > 0.001 then table.insert(rows, string.format(fmt, label, value)) end
        end
        add("힘", st.BonusStr, "%s %+d")
        add("민첩", st.BonusDex, "%s %+d")
        add("활력", st.BonusVit, "%s %+d")
        add("정신", st.BonusEne, "%s %+d")
        add("생명", st.BonusLife, "%s %+d")
        add("마나", st.BonusMana, "%s %+d")
        add("피해", st.BonusDamage, "%s %+d")
        add("피해", st.BonusDamagePct, "%s %+d%%")
        add("방어", st.BonusDefense, "%s %+d")
        add("공격 속도", st.BonusIas, "%s %+d%%")
        add("시전 속도", st.BonusFcr, "%s %+d%%")
        add("이동 속도", st.BonusMs, "%s %+d%%")
        add("생명력 흡수", st.BonusLeech, "%s %+d%%")
        add("생명 재생", st.BonusRegen, "%s %+.1f/초")
        add("소환수 능력치", st.BonusMinionPct, "%s %+d%%")
        add("소환수 독", st.BonusMinionPoison, "%s %+d/초")
        add("배치 한도", st.BonusDeploy, "%s %+d")
        add("그림자 상한", st.BonusShadowCap, "%s %+d")
        add("추출 확률", st.BonusExtractPct, "%s %+d%%")
        add("저주 범위", st.BonusCurse, "%s %+d%%")
        add("아이템 발견", st.BonusMF, "%s %+d%%")
        add("골드 발견", st.BonusGF, "%s %+d%%")
        local names = { fire = "화염", cold = "냉기", light = "번개", poison = "독" }
        for e, amount in string.gmatch(st.ElemDamage, "(%a+)=(%d+)") do table.insert(rows, (names[e] or e) .. " 피해 +" .. amount) end
        local text = _UIKit:Colored("#E6C88A", "장비로 오른 능력치") .. "\n"
        if #rows == 0 then text = text .. "착용한 장비 효과가 없습니다." else text = text .. table.concat(rows, "\n") end
        local penalty = _GameConst:ResistPenalty(st.Difficulty)
        text = text .. "\n" .. _UIKit:Colored("#8C99B4", string.format("저항 (난이도 -%d 적용): 화염 %d · 냉기 %d · 번개 %d · 독 %d", penalty, st.ResFire, st.ResCold, st.ResLight, st.ResPoison))
        return text .. "\n\n" .. _UIKit:Colored("#8C99B4", "가방·장비를 누르면 그 물건의 설명이 나옵니다.")
    end

    @ExecSpace("ClientOnly")
    method boolean NearShop()
        -- 상인 대화 거리 안 (서버도 같은 거리로 다시 검사한다)
        local player = _UserService.LocalPlayer
        return isvalid(player) and _Util:NearNpc(player, "shop")
    end

    @ExecSpace("ClientOnly")
    method void Act(string action)
        -- 클릭 순간에도 선택 식별값과 레벨·공간·소켓을 검사한다. 연속 클릭은 재실행하지 않는다.
        if not _UIKit:IsOpen(self.Win) or not _Util:IsAlive(_UserService.LocalPlayer) then return end
        local inv = self:Inv()
        if inv == nil then return end
        local list, eq = inv:GetBagList(), inv:GetEquipMap()
        self:ValidateSelection(list, eq)
        local sel = list[self.Selected]
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if action == "sell" then
            if sel == nil then return end
            -- 되돌릴 수 없는 조작이라 확인 창을 거친다. 상인 곁이면 판매, 아니면 버리기(영구 삭제)
            local index = self.Selected
            local name = _ItemData:Parse(sel).name
            if self:NearShop() then
                _ConfirmDialog:Show("판매", name .. "\n상인에게 " .. tostring(_ItemData:SellValue(sel)) .. " 골드에 팝니다.", "판매", function()
                    inv:RequestSell(index, sel)
                    self:ClearSelection()
                    self:Poll()
                end)
            else
                _ConfirmDialog:Show("버리기", name .. "\n발밑에 떨어뜨립니다. 10초 동안은 아무도 줍지 못하고, 그 뒤 누구나(파티원 포함) 주울 수 있습니다.\n(팔려면 마을 상인 곁에서 소지품을 여세요)", "버리기", function()
                    inv:RequestDiscard(index, sel)
                    self:ClearSelection()
                    self:Poll()
                end)
            end
            return
        elseif action == "equip" then
            if self.SelectedEquipSlot ~= "" then
                if #list >= inv.BagSize then return end
                inv:RequestUnequip(self.SelectedEquipSlot, self.SelectedEquipItem)
            elseif sel ~= nil and _ItemData:IsRune(_ItemData:Parse(sel).base) then
                if self.SocketSlot == "" or not self:CanSocket(sel, eq[self.SocketSlot]) then return end
                inv:RequestSocket(self.Selected, self.SocketSlot, sel, self.SocketItem)
            elseif sel ~= nil and self:CanEquip(sel, st) then
                inv:RequestEquip(self.Selected, sel)
            else return end
        else return end
        self:ClearSelection()
        self:Poll()
    end

end
