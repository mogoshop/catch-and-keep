-- 사교 창 (P): 같은 서버 플레이어 최대 8명에게 파티·결투·거래 요청, 파티 탈퇴.
-- 받은 요청 팝업(Request)도 여기서 띄운다 (D2처럼 요청 → 수락해야 성립).
@Logic
script SocialWindow extends Logic

    property string Win = "SocialWin"
    property table Ids = {}
    property string RenderKey = ""
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:SetEnabled("Request", false)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for i = 1, 8 do
            local index = i
            _UIKit:Connect(self.Win .. "/Party" .. tostring(i), function() self:Act(index, "party") end)
            _UIKit:Connect(self.Win .. "/Duel" .. tostring(i), function() self:Act(index, "duel") end)
            _UIKit:Connect(self.Win .. "/Trade" .. tostring(i), function() self:Act(index, "trade") end)
            _UIKit:Connect(self.Win .. "/Inspect" .. tostring(i), function() self:Inspect(index) end)
        end
        _UIKit:SetEnabled(self.Win .. "/Inspect", false)
        _UIKit:Connect(self.Win .. "/Inspect/BtnBack", function() _UIKit:SetEnabled(self.Win .. "/Inspect", false) end)
        _UIKit:Connect(self.Win .. "/BtnLeave", function()
            local s = self:Social()
            if s ~= nil then s:RequestLeaveParty() end
        end)
        _UIKit:Connect("Request/BtnYes", function() self:Respond(true) end)
        _UIKit:Connect("Request/BtnNo", function() self:Respond(false) end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.25)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    method PlayerSocial Social()
        ---@type PlayerSocial
        local c = _UIKit:Comp("script.PlayerSocial")
        return c
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        self:RenderRequest()
        if not _UIKit:IsOpen(self.Win) then
            self.RenderKey = ""
            return
        end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        -- 같은 채널의 모든 플레이어 (서버 PartySystem.Roster — 클라이언트는 같은 맵 사람만 알 수 있다 · 10-13)
        local ids = {}
        local names = {}
        local sameMap = {}
        local myLv = 1
        local me = player.PlayerComponent.UserId
        local here = isvalid(player.CurrentMap) and player.CurrentMap.Name or ""
        local rows = {}
        for entry in string.gmatch(_PartySystem.Roster .. ";", "([^;]*);") do
            local uid, name, lv, place, mapName = string.match(entry, "^([^|]*)|([^|]*)|([^|]*)|([^|]*)|?(.*)$")
            if uid == me then myLv = math.tointeger(tonumber(lv)) or 1 end
            if uid ~= nil and uid ~= me and #rows < 8 then
                table.insert(rows, { uid = uid, name = name, lv = math.tointeger(tonumber(lv)) or 1, place = place, near = mapName ~= "" and mapName == here })
            end
        end
        local s = self:Social()
        local duelOk = {}
        for i, r in ipairs(rows) do
            ids[i] = r.uid
            sameMap[i] = r.near
            duelOk[i] = s ~= nil and s:DuelLevelOk(myLv, r.lv)
            local where = _UIKit:Colored(r.near and "#9EE6A0" or "#888888", r.near and (r.place .. " · 같은 곳") or r.place)
            -- 같은 곳인데 레벨 차로 결투 단추가 없을 때 이유를 붙인다 (10-13)
            if r.near and not duelOk[i] then where = where .. "  " .. _UIKit:Colored("#888888", "· 레벨 차로 결투 불가") end
            names[i] = r.name .. "  Lv" .. tostring(r.lv) .. "  " .. where
        end
        -- 아무도 없을 때도 한 번은 그린다 (예전에는 빈 목록 키가 처음 값 ""과 같아 버튼 24개가 그대로 떠 있었다)
        -- 결투 중인 상대의 줄은 「포기」 단추 (10-23: 결투를 끝낼 방법이 맵을 떠나는 것뿐이었다)
        ---@type PlayerDuel
        local duel = _UIKit:Comp("script.PlayerDuel")
        local foe = duel ~= nil and duel.Opponent or ""
        local key = "n" .. tostring(#names) .. ":" .. tostring(myLv) .. ":" .. foe .. ":" .. table.concat(names, ";")
        if key == self.RenderKey then return end
        self.RenderKey = key
        self.Ids = ids
        for i = 1, 8 do
            local text = names[i] or ""
            if i == 1 and #names == 0 then text = "이 채널에 다른 플레이어가 없습니다" end
            _UIKit:SetText(self.Win .. "/Name" .. tostring(i), text)
            -- 파티 초대는 채널 어디서나, 결투·거래는 같은 지역에서만 (서버 PlayerSocial.RequestAction과 같은 조건)
            _UIKit:SetEnabled(self.Win .. "/Party" .. tostring(i), ids[i] ~= nil)
            -- 결투는 레벨 차 duelMaxLevelGap 이하만 (10-13)
            local dueling = ids[i] ~= nil and ids[i] == foe
            _UIKit:SetText(self.Win .. "/Duel" .. tostring(i), dueling and _UIKit:Colored("#FF6A50", "포기") or "결투")
            _UIKit:SetEnabled(self.Win .. "/Duel" .. tostring(i), dueling or (ids[i] ~= nil and sameMap[i] == true and duelOk[i] == true))
            _UIKit:SetEnabled(self.Win .. "/Trade" .. tostring(i), ids[i] ~= nil and sameMap[i] == true)
            _UIKit:SetEnabled(self.Win .. "/Inspect" .. tostring(i), ids[i] ~= nil)   -- 살펴보기는 채널 어디서나
        end
    end

    @ExecSpace("ClientOnly")
    method void Inspect(integer index)
        -- 그 사람의 능력치·스킬·장비를 서버에 묻는다 (다른 맵에 있어도 같은 채널이면 된다)
        local id = self.Ids[index]
        local s = self:Social()
        if id == nil or s == nil then return end
        _UIKit:SetText(self.Win .. "/Inspect/Title", "불러오는 중…")
        _UIKit:SetText(self.Win .. "/Inspect/Stats", "")
        _UIKit:SetText(self.Win .. "/Inspect/Gear", "")
        _UIKit:SetEnabled(self.Win .. "/Inspect", true)
        s:RequestInspect(id)
    end

    @ExecSpace("ClientOnly")
    method void OnInspect(string title, string stats, string equipDigest)
        -- 서버가 보낸 요약을 그린다. 장비는 아이템 문자열을 받아 이 화면에서 이름·옵션으로 푼다
        local slotNames = { weapon = "무기", offhand = "보조", helm = "투구", armor = "갑옷", gloves = "장갑", boots = "장화", belt = "허리띠", amulet = "목걸이", ring1 = "반지", ring2 = "반지" }
        local lines = {}
        for slot, item in string.gmatch(equipDigest, "([^;>]+)>([^;]+)") do
            local text = _ItemData:Describe(item)
            table.insert(lines, _UIKit:Colored("#9C9488", (slotNames[slot] or slot) .. "  ") .. string.gsub(text, "\n", "\n      "))
        end
        if #lines == 0 then lines = { _UIKit:Colored("#9C9488", "착용한 장비가 없다") } end
        _UIKit:SetText(self.Win .. "/Inspect/Title", title)
        _UIKit:SetText(self.Win .. "/Inspect/Stats", stats)
        _UIKit:SetText(self.Win .. "/Inspect/Gear", table.concat(lines, "\n"))
        _UIKit:SetEnabled(self.Win .. "/Inspect", true)
    end

    @ExecSpace("ClientOnly")
    method void RenderRequest()
        local s = self:Social()
        if s == nil then return end
        _UIKit:SetEnabled("Request", s.PendingKind ~= "")
        if s.PendingKind == "" then return end
        local names = { party = "파티에 초대했다", duel = "결투를 신청했다", trade = "거래를 요청했다" }
        _UIKit:SetText("Request/Text", s.PendingFromName .. "님이 " .. (names[s.PendingKind] or s.PendingKind))
    end

    @ExecSpace("ClientOnly")
    method void Act(integer index, string kind)
        local id = self.Ids[index]
        ---@type PlayerDuel
        local duel = _UIKit:Comp("script.PlayerDuel")
        if kind == "duel" and id ~= nil and duel ~= nil and duel.Opponent == id then
            duel:RequestForfeit()
            return
        end
        local s = self:Social()
        if id ~= nil and s ~= nil then s:RequestAction(kind, id) end
    end

    @ExecSpace("ClientOnly")
    method void Respond(boolean accept)
        local s = self:Social()
        if s ~= nil then s:RespondRequest(accept) end
    end

end
