-- 능력치 창 (U): 네크로맨서용 능력치 (통솔·정신·활력·민첩 — docs/design/16).
-- 10-27 개편 (docs/design/37 §3 · 디아3 요약 지표 · 디아4 「1포인트당 효과」 · 0인 값 숨김):
--   왼쪽: 머리줄 · 요약 3칸(내 피해 · 생존 · 소환수) · 저항 칩 4 · 세부 분류 4탭(공격 · 소환수 · 방어 · 유틸) + 설명 칸
--   오른쪽: 능력치 4줄 = 이름 값 (장비 몫) · 1포인트당 효과 · 지금 효과 · [+]. 줄을 누르면 설명 칸에 출처(기본 · 투자 · 장비)
--   계산식은 본문에서 뺐다 (예전: 「소환수 공격·생명 +0% = 통솔 0 + 장비 0」).
@Logic
script CharWindow extends Logic

    property string Win = "CharWin"
    property string RenderKey = ""
    property integer TimerId = 0
    property string Detail = "atk"            -- 설명 칸: atk / minion / def / util, 또는 stat:Str 등 (능력치 줄을 누름)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:RegisterWindow(self.Win)
        _UIKit:Connect(self.Win .. "/BtnClose", function() _UIKit:Close(self.Win) end)
        for _, s in ipairs({ "Str", "Dex", "Vit", "Ene" }) do
            local stat = s
            _UIKit:Connect(self.Win .. "/" .. s .. "/BtnAdd", function()
                ---@type PlayerStats
                local st = _UIKit:Comp("script.PlayerStats")
                if st ~= nil then st:RequestAddStat(stat) end
            end)
            _UIKit:Connect(self.Win .. "/" .. s .. "/Hit", function() self:SetDetail("stat:" .. stat) end)
        end
        for i, key in ipairs({ "atk", "minion", "def", "util" }) do
            local k = key
            _UIKit:Connect(self.Win .. "/Tab" .. tostring(i), function() self:SetDetail(k) end)
        end
        -- 추천 분배 (docs/design/16): 남은 포인트를 한 번에 — 되돌리기 어려우니 확인을 거친다
        local presets = { { "Auto1", "summon", "소환형 (통솔 3 : 활력 2)" }, { "Auto2", "spell", "주문형 (정신 3 : 활력 2)" }, { "Auto3", "balance", "균형 (통솔 2 : 정신 1 : 활력 2)" } }
        for _, p in ipairs(presets) do
            local key, label = p[2], p[3]
            _UIKit:Connect(self.Win .. "/" .. p[1], function()
                ---@type PlayerStats
                local st = _UIKit:Comp("script.PlayerStats")
                if st == nil or st.StatPoints <= 0 then return end
                _ConfirmDialog:Show("추천 분배", "남은 능력치 포인트 " .. tostring(st.StatPoints) .. "을(를)\n" .. label .. "으로 나눕니다.", "분배", function() st:RequestAutoStats(key) end)
            end)
        end
        _UIKit:Connect(self.Win .. "/BtnReset", function()
            ---@type PlayerStats
            local st = _UIKit:Comp("script.PlayerStats")
            ---@type SkillBook
            local book = _UIKit:Comp("script.SkillBook")
            if st == nil or book == nil then return end
            local cost = book:RespecCost(st.Level)
            local note = cost == 0 and ("무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)") or (tostring(cost) .. " 골드 · 마을의 사제 오렌·카라반 대장 무하드 곁에서")
            _ConfirmDialog:Show("능력치 초기화", "투자한 능력치를 모두 돌려받습니다.\n" .. note, "초기화", function() book:RequestRespec("stats") end)
        end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ClientOnly")
    method void SetDetail(string key)
        self.Detail = key
        self.RenderKey = ""
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        if not _UIKit:IsOpen(self.Win) then
            self.RenderKey = ""
            return
        end
        local player = _UserService.LocalPlayer
        ---@type PlayerStats
        local st = _UIKit:Comp("script.PlayerStats")
        if not isvalid(player) or st == nil then return end
        local pc = player.PlayerComponent
        local gear = "#6E8CFF"
        local spell = st:GetSpellPowerPct()
        local minion = st:GetMinionPct()
        local hp = math.floor(pc.MaxHp)
        local def = math.floor(st:GetDefense())
        local head = string.format("Lv%d  네크로맨서  ·  %s", st.Level, _GameConst:DifficultyName(st.Difficulty))
        local sums = {
            { string.format("×%.2f", 1 + spell / 100), "스킬 피해 +" .. tostring(math.floor(spell)) .. "%" },
            { "생명 " .. tostring(hp), "방어 " .. tostring(def) .. " · 마나 " .. tostring(math.floor(st.MaxMana)) },
            { string.format("×%.2f", 1 + minion / 100), "공격·생명 +" .. string.format("%.1f", minion) .. "%" },
        }
        -- 저항: 상한(resistCap)이면 금색, 0 미만이면 붉게 경고
        local res = {}
        for i, e in ipairs({ { "fire", "화염" }, { "cold", "냉기" }, { "light", "번개" }, { "poison", "독" } }) do
            local v = math.floor(st:GetResist(e[1]))
            local text = e[2] .. " " .. tostring(math.min(v, math.floor(_GameData.resistCap))) .. "%"
            if v < 0 then text = _UIKit:Colored("#FF5A5A", text) elseif v >= _GameData.resistCap then text = _UIKit:Colored("#FFD36A", text) end
            res[i] = text
        end
        -- 능력치 4줄: 이름 값 (장비 몫) · 1포인트당 효과 · 지금 효과
        local dex = st.Dex + st.BonusDex
        local rows = {
            Str = { "통솔", "소환형", st.Str, st.BonusStr, string.format("1포인트당 소환수 공격·생명 +%.1f%%", _GameData.strMinionPct), string.format("지금 소환수 공격·생명 +%.1f%%", minion) },
            Ene = { "정신", "주문형", st.Ene, st.BonusEne, string.format("1포인트당 스킬 피해 +%d%% · 마나 +%d", math.floor(_GameData.eneSpellPct), math.floor(_GameData.eneMana)), string.format("지금 스킬 피해 +%d%% · 마나 %d", math.floor(spell), math.floor(st.MaxMana)) },
            Vit = { "활력", "생존", st.Vit, st.BonusVit, string.format("1포인트당 생명 +%d", math.floor(_GameData.vitLife)), "지금 생명 " .. tostring(hp) },
            Dex = { "민첩", "속도", st.Dex, st.BonusDex, string.format("1포인트당 공격 속도 +%.1f%% · 평타 +%.1f%%", _GameData.dexIasPct, _GameData.dexMeleePct), string.format("지금 공격 속도 +%.0f%% · 평타 +%.0f%%", st:GetIas(), dex * _GameData.dexMeleePct) },
        }
        local names = {}
        for k, r in pairs(rows) do
            local text = r[1] .. "  " .. tostring(r[3] + r[4]) .. "  " .. _UIKit:Colored("#C9B17E", "<size=75%>" .. r[2] .. "</size>")
            if r[4] ~= 0 then text = text .. "  " .. _UIKit:Colored(r[4] > 0 and gear or "#FF7A45", string.format("(장비 %+d)", r[4])) end
            names[k] = text
        end
        local detail = self:DetailText(st, pc, rows)
        ---@type SkillBook
        local book = _UIKit:Comp("script.SkillBook")
        local cost = book ~= nil and book:RespecCost(st.Level) or 0
        local more = st.StatPoints > 0
        local reset = cost == 0 and ("초기화 · 무료 (Lv" .. tostring(math.floor(_GameData.respecFreeLevel)) .. "까지)") or ("초기화 · " .. tostring(cost) .. " 골드 (마을 의뢰인 곁)")
        local points = more and ("남은 능력치 포인트 " .. tostring(st.StatPoints) .. "  —  [+] 또는 추천 분배") or "남은 포인트 없음 · 레벨업마다 +" .. tostring(math.floor(_GameData.statPerLevel))
        local key = table.concat({ head, sums[1][1], sums[1][2], sums[2][1], sums[2][2], sums[3][1], sums[3][2], res[1], res[2], res[3], res[4], names.Str, names.Ene, names.Vit, names.Dex, rows.Str[6], rows.Ene[6], rows.Vit[6], rows.Dex[6], detail, self.Detail, points, reset }, "|")
        if key == self.RenderKey then return end
        self.RenderKey = key
        _UIKit:SetText(self.Win .. "/Head", head)
        for i = 1, 3 do
            _UIKit:SetText(self.Win .. "/Sum" .. tostring(i) .. "/Value", sums[i][1])
            _UIKit:SetText(self.Win .. "/Sum" .. tostring(i) .. "/Sub", sums[i][2])
        end
        for i = 1, 4 do _UIKit:SetText(self.Win .. "/Res" .. tostring(i) .. "/Text", res[i]) end
        for _, s in ipairs({ "Str", "Ene", "Vit", "Dex" }) do
            _UIKit:SetText(self.Win .. "/" .. s .. "/Name", names[s])
            _UIKit:SetText(self.Win .. "/" .. s .. "/Per", rows[s][5])
            _UIKit:SetText(self.Win .. "/" .. s .. "/Now", rows[s][6])
            _UIKit:SetEnabled(self.Win .. "/" .. s .. "/BtnAdd", more)
            _UIKit:SetColor(self.Win .. "/" .. s, self.Detail == "stat:" .. s and Color(0.24, 0.2, 0.12, 1) or Color(0.09, 0.08, 0.11, 1))
        end
        for i, k in ipairs({ "atk", "minion", "def", "util" }) do
            _UIKit:SetColor(self.Win .. "/Tab" .. tostring(i), self.Detail == k and Color(1, 0.9, 0.7, 1) or Color(0.55, 0.52, 0.5, 1))
        end
        _UIKit:SetText(self.Win .. "/Paper/Info", detail)
        local heads = { atk = "공격", minion = "소환수", def = "방어", util = "유틸" }
        local stat = string.match(self.Detail, "^stat:(%a+)$")
        _UIKit:SetText(self.Win .. "/Paper/Head/Text", stat ~= nil and (rows[stat][1] .. " — 어디서 왔나") or (heads[self.Detail] or ""))
        _UIKit:SetText(self.Win .. "/Points", points)
        _UIKit:SetText(self.Win .. "/BtnReset", reset)
        for i = 1, 3 do _UIKit:SetEnabled(self.Win .. "/Auto" .. tostring(i), more) end
    end

    method string DetailText(any st, any pc, table rows)
        -- 설명 칸: 고른 분류의 값만 (0인 값은 숨김), 능력치 줄을 눌렀으면 그 능력치의 출처
        local gear = "#6E8CFF"
        local lines = {}
        local function add(label, value, show)
            if show then table.insert(lines, label .. "  " .. _UIKit:Colored("#F4E2B0", value)) end
        end
        local stat = string.match(self.Detail, "^stat:(%a+)$")
        if stat ~= nil then
            local r = rows[stat]
            local starts = { Str = 15, Ene = 25, Vit = 15, Dex = 25 }
            local base = starts[stat] or 0
            table.insert(lines, _UIKit:Colored("#E6C88A", r[1] .. " " .. tostring(r[3] + r[4])) .. "  =  기본 " .. tostring(base) .. " + 투자 " .. tostring(r[3] - base) .. " + " .. _UIKit:Colored(gear, "장비 " .. tostring(r[4])))
            if stat == "Str" then
                local fromStat = math.max(0, st.Str + st.BonusStr - 15) * _GameData.strMinionPct
                table.insert(lines, string.format("소환수 공격·생명 +%.1f%%  =  통솔 +%.1f%% + ", st:GetMinionPct(), fromStat) .. _UIKit:Colored(gear, string.format("장비 +%.1f%%", st.BonusMinionPct)))
                table.insert(lines, _UIKit:Colored("#8A8478", "통솔은 시작값 15를 넘은 만큼만 효과가 있습니다"))
            elseif stat == "Ene" then
                local fromStat = (st.Ene + st.BonusEne) * _GameData.eneSpellPct
                table.insert(lines, string.format("스킬 피해 +%d%%  =  정신 +%d%% + ", math.floor(st:GetSpellPowerPct()), math.floor(fromStat)) .. _UIKit:Colored(gear, string.format("장비 +%d%%", math.floor(st:GetSpellPowerPct() - fromStat))))
                table.insert(lines, string.format("마나 %d", math.floor(st.MaxMana)))
            elseif stat == "Vit" then
                local baseHp = math.floor(_GameData.playerBaseHp + (st.Level - 1) * _GameData.playerHpPerLevel)
                local vitHp = (st.Vit - 15) * _GameData.vitLife
                table.insert(lines, string.format("생명 %d  =  기본 %d + 활력 %d + ", math.floor(pc.MaxHp), baseHp, vitHp) .. _UIKit:Colored(gear, "장비 " .. tostring(math.floor(pc.MaxHp - baseHp - vitHp))))
            else
                local dex = st.Dex + st.BonusDex
                table.insert(lines, string.format("공격 속도 +%.0f%%  =  민첩 +%.0f%% + ", st:GetIas(), math.min(_GameData.iasCap, dex * _GameData.dexIasPct)) .. _UIKit:Colored(gear, string.format("장비 +%.0f%%", st.BonusIas)) .. _UIKit:Colored("#8A8478", string.format("  (상한 %d%%)", math.floor(_GameData.iasCap))))
                table.insert(lines, string.format("평타 +%.0f%% · 방어 %d · 평타 치명 %.1f%%", dex * _GameData.dexMeleePct, math.floor(st:GetDefense()), st:GetBasicCriticalChancePct()))
            end
            table.insert(lines, _UIKit:Colored("#8A8478", "파란 글씨 = 장비 몫 · 분류 탭을 누르면 돌아갑니다"))
            return table.concat(lines, "\n")
        end
        if self.Detail == "atk" then
            local player = _UserService.LocalPlayer
            ---@type PlayerAttack
            local attack = isvalid(player) and player:GetComponent("script.PlayerAttack") or nil
            add("스킬 피해", "+" .. tostring(math.floor(st:GetSpellPowerPct())) .. "%", true)
            add("주문 스킬 피해", "+" .. tostring(math.floor(st.BonusSpellDmg)) .. "%", st.BonusSpellDmg > 0)
            add("시전 속도", string.format("+%.0f%%", st:GetFcr()), st:GetFcr() > 0)
            add("공격 속도", string.format("+%.0f%%", st:GetIas()), st:GetIas() > 0)
            if attack ~= nil then add("평타 물리", tostring(math.max(1, math.floor(attack:GetBasicPhysicalDamage() + 0.5))), true) end
            add("평타 치명", string.format("%.1f%%", st:GetBasicCriticalChancePct()), st:GetBasicCriticalChancePct() > 0)
            add("속성 피해", _ItemData:ModsText(st.ElemDamage), st.ElemDamage ~= "")
            add("생명력 흡수", string.format("%.0f%%", st.BonusLeech), st.BonusLeech > 0)
            add("모든 스킬", "+" .. tostring(st.BonusAllSkills), st.BonusAllSkills > 0)
            add("저주 범위 · 지속 · 효과", string.format("+%.0f%% · +%.0f%% · +%.0f%%", st.BonusCurse, st.BonusCurseDur, st.BonusCurseEff), st.BonusCurse + st.BonusCurseDur + st.BonusCurseEff > 0)
        elseif self.Detail == "minion" then
            add("소환수 공격·생명", string.format("+%.1f%%", st:GetMinionPct()), true)
            add("소환수 공격 속도", string.format("+%.0f%%", st.BonusMinionIas), st.BonusMinionIas > 0)
            add("소환수 모든 저항", string.format("+%.0f%%", st.BonusMinionRes), st.BonusMinionRes > 0)
            add("소환수 공격에 독", string.format("초당 %.0f", st.BonusMinionPoison), st.BonusMinionPoison > 0)
            add("그림자 배치 한도", "+" .. tostring(st.BonusDeploy), st.BonusDeploy > 0)
            add("그림자 상한", "+" .. tostring(st.BonusShadowCap), st.BonusShadowCap > 0)
            add("소환 계열 스킬", "+" .. tostring(st.BonusTreeCommand), st.BonusTreeCommand > 0)
            add("그림자 추출 확률", string.format("+%.0f%%", st.BonusExtractPct), st.BonusExtractPct > 0)
        elseif self.Detail == "def" then
            add("생명", tostring(math.floor(pc.MaxHp)), true)
            add("방어", tostring(math.floor(st:GetDefense())) .. _UIKit:Colored("#8A8478", string.format("  (물리 피해 −%d%%)", math.floor(100 - 10000 / (100 + st:GetDefense())))), true)
            add("마나", tostring(math.floor(st.MaxMana)), true)
            add("생명 재생", string.format("초당 %.1f", st.BonusRegen), st.BonusRegen > 0)
            add("저항 상한", tostring(math.floor(_GameData.resistCap)) .. "%" .. (st.Difficulty > 0 and _UIKit:Colored("#FF7A45", "  (난이도 저항 감소 적용)") or ""), true)
        else
            add("이동 속도", string.format("+%.0f%%", st.BonusMs), st.BonusMs > 0)
            add("아이템 찾기", string.format("+%.0f%%", st.BonusMF), st.BonusMF > 0)
            add("골드 찾기", string.format("+%.0f%%", st.BonusGF), st.BonusGF > 0)
            add("주문 계열 스킬", "+" .. tostring(st.BonusTreeSoul), st.BonusTreeSoul > 0)
            add("저주 계열 스킬", "+" .. tostring(st.BonusTreeCurse), st.BonusTreeCurse > 0)
            add("골드", tostring(st.Gold), true)
        end
        if #lines == 0 then table.insert(lines, _UIKit:Colored("#8A8478", "장비로 오른 값이 아직 없습니다")) end
        return table.concat(lines, "\n")
    end

end
