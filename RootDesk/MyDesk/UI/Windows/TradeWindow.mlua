-- 거래 창: 거래가 성립하면 자동으로 열린다. 소지품 창과 같은 크기의 창 하나로 다 한다 (소지품 창을 따로 열지 않는다).
-- 10-23 4차: 왼쪽 위부터 상대 제안 8칸 · 내 제안 8칸 · 내 가방 6×5 (◀▶ 두 쪽), 오른쪽 = 고른 물건 설명 · 올리기/되돌리기 · 확인 · 취소.
-- 칸을 누르면 설명(상대 물건은 내 장비와 비교). 골드는 각 제안 줄 오른쪽 아래 금화 아이콘 옆 — 내 골드 칸을 눌러 바로 숫자를 고친다. 닫기 = 거래 취소.
@Logic
script TradeWindow extends Logic

    property string Win = "TradeWin"
    property boolean WasActive = false
    property string RenderKey = ""
    property integer TimerId = 0
    property integer SeenRevision = 0
    property number ChangedAt = -100
    property string PickSide = ""              -- 설명 칸에 보이는 물건: "their" / "my" / "" (없음)
    property integer PickIndex = 0
    property integer BagPage = 0               -- 내 가방 쪽 (0 = 1~30, 1 = 31~60)
    property string ShownGold = ""             -- 내 골드 칸에 마지막으로 쓴 글자 (고치는 중에는 덮어쓰지 않는다)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        _UIKit:SetEnabled(self.Win, false)
        -- 설명이 길면 칸 안에 들어가게 글자를 줄인다
        local info = _UIKit:Get(self.Win .. "/Info/Text")
        if isvalid(info) and info.TextGUIRendererComponent ~= nil then
            local fit = info.TextGUIRendererComponent
            fit.BestFit = true
            fit.MinSize = 14
            fit.MaxSize = 21
        end
        for i = 1, 8 do
            local index = i
            _UIKit:Connect(self.Win .. "/TheirRow/S" .. tostring(i), function() self:Pick("their", index) end)
            _UIKit:Connect(self.Win .. "/MyRow/S" .. tostring(i), function() self:Pick("my", index) end)
        end
        for i = 1, 30 do
            local slot = i
            _UIKit:Connect(self.Win .. "/Bag/B" .. tostring(i), function() self:Pick("bag", self.BagPage * 30 + slot) end)
        end
        _UIKit:Connect(self.Win .. "/BagPrev", function() self:Page(-1) end)
        _UIKit:Connect(self.Win .. "/BagNext", function() self:Page(1) end)
        _UIKit:Connect(self.Win .. "/Info/BtnAct", function() self:Act() end)
        local gold = _UIKit:Get(self.Win .. "/MyGold")
        if isvalid(gold) then gold:ConnectEvent(TextInputEndEditEvent, function(ev) self:SetGold(ev.text) end) end
        _UIKit:Connect(self.Win .. "/BtnConfirm", function() local t = self:Trade() if t ~= nil then t:RequestConfirm(t.TheirRevision) end end)
        _UIKit:Connect(self.Win .. "/BtnCancel", function() local t = self:Trade() if t ~= nil then t:RequestCancel() end end)
        _UIKit:Connect(self.Win .. "/BtnClose", function() local t = self:Trade() if t ~= nil then t:RequestCancel() end end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Poll() end, 0.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    method PlayerTrade Trade()
        ---@type PlayerTrade
        local c = _UIKit:Comp("script.PlayerTrade")
        return c
    end

    @ExecSpace("ClientOnly")
    method void Pick(string side, integer index)
        -- 칸을 눌렀다: 그 물건을 설명 칸에 (빈 칸이면 설명이 비고 안내가 나온다)
        self.PickSide = side
        self.PickIndex = index
        self.RenderKey = "#"
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Page(integer delta)
        -- 내 가방 쪽 넘기기 (가방 60칸 = 두 쪽)
        local inv = self:Inv()
        local pages = inv ~= nil and math.max(1, math.ceil(inv.BagSize / 30)) or 1
        self.BagPage = (self.BagPage + delta) % pages
        self.RenderKey = "#"
        self:Poll()
    end

    @ExecSpace("ClientOnly")
    method void Act()
        -- 설명 칸 단추: 가방 물건은 올리기, 내 제안은 되돌리기
        local t = self:Trade()
        if t == nil or t.Partner == "" or self.PickIndex <= 0 then return end
        if self.PickSide == "bag" then
            local inv = self:Inv()
            local seen = inv ~= nil and (inv:GetBagList()[self.PickIndex] or "") or ""
            if seen == "" then return end
            -- 누를 때 이 칸에 보이던 물건을 함께 보낸다 (서버가 같은 물건일 때만 올린다)
            t:RequestOffer(self.PickIndex, seen)
        elseif self.PickSide == "my" then
            t:RequestRetract(self.PickIndex)
        else
            return
        end
        self.PickSide = ""
        self.PickIndex = 0
        self.RenderKey = "#"
    end

    @ExecSpace("ClientOnly")
    method void SetGold(string text)
        -- 내 골드 칸을 고쳤다: 그 금액으로 맞춘다 (서버가 0 ~ 가진 골드로 자른다). 빈 칸이면 그대로 둔다
        local t = self:Trade()
        if t == nil or t.Partner == "" then return end
        local digits = (string.gsub(text or "", "[^%d]", ""))
        self.ShownGold = ""
        self.RenderKey = "#"
        if digits == "" then return end
        local want = math.floor(tonumber(digits) or 0)
        if want ~= t.MyGold then t:RequestGold(want - t.MyGold) end
    end

    method PlayerInventory Inv()
        ---@type PlayerInventory
        local c = _UIKit:Comp("script.PlayerInventory")
        return c
    end

    @ExecSpace("ClientOnly")
    method void Poll()
        local t = self:Trade()
        if t == nil then return end
        local active = t.Partner ~= ""
        _UIKit:SetEnabled(self.Win, active)
        if active and not self.WasActive then
            -- 거래가 열리는 순간 다른 창(거래를 건 플레이어 창 등)을 닫고 맨 위로 (10-24: 플레이어 창이 거래창을 가렸다)
            for _, win in ipairs(_UIKit.Windows) do _UIKit:Close(win) end
            local e = _UIKit:Get(self.Win)
            if isvalid(e) then _UILogic:SetSiblingIndex(e.UITransformComponent, 1000000) end
        end
        self.WasActive = active
        if not active then
            self.RenderKey = ""
            self.PickSide = ""
            self.PickIndex = 0
            self.BagPage = 0
            self.ShownGold = ""
            return
        end
        -- 상대가 바꾼 뒤 3초 동안은 「방금 바뀜」을 붉게 (서버도 그동안 확인을 받지 않는다)
        local now = _UtilLogic.ElapsedSeconds
        if t.TheirRevision ~= self.SeenRevision then
            self.SeenRevision = t.TheirRevision
            self.ChangedAt = now
        end
        local fresh = t.TheirRevision > 0 and now < self.ChangedAt + 3
        local inv = self:Inv()
        local bag = inv ~= nil and inv:GetBagList() or {}
        local key = table.concat({ t.MyOffer, t.TheirOffer, tostring(t.MyGold), tostring(t.TheirGold), tostring(t.MyConfirm), tostring(t.TheirConfirm),
            tostring(fresh), self.PickSide, tostring(self.PickIndex), t.PartnerName, tostring(self.BagPage), table.concat(bag, ";") }, "#")
        self:DrawGold(t)
        if key == self.RenderKey then return end
        self.RenderKey = key
        _UIKit:SetText(self.Win .. "/Title", t.PartnerName ~= "" and ("거래 — " .. t.PartnerName) or "거래")
        local mine = self:Split(t.MyOffer)
        local theirs = self:Split(t.TheirOffer)
        local plain = Color(0.05, 0.045, 0.06, 0.94)
        local lit = Color(0.3, 0.26, 0.16, 0.95)
        for i = 1, 8 do
            _InventoryWindow:DrawItem(self.Win .. "/TheirRow/S" .. tostring(i), theirs[i])
            _InventoryWindow:DrawItem(self.Win .. "/MyRow/S" .. tostring(i), mine[i])
            -- 고른 칸은 바탕을 밝게
            _UIKit:SetColor(self.Win .. "/TheirRow/S" .. tostring(i), (self.PickSide == "their" and self.PickIndex == i) and lit or plain)
            _UIKit:SetColor(self.Win .. "/MyRow/S" .. tostring(i), (self.PickSide == "my" and self.PickIndex == i) and lit or plain)
        end
        local pages = inv ~= nil and math.max(1, math.ceil(inv.BagSize / 30)) or 1
        for i = 1, 30 do
            local index = self.BagPage * 30 + i
            local path = self.Win .. "/Bag/B" .. tostring(i)
            _UIKit:SetEnabled(path, inv == nil or index <= inv.BagSize)
            _InventoryWindow:DrawItem(path, bag[index])
            _UIKit:SetColor(path, (self.PickSide == "bag" and self.PickIndex == index) and lit or plain)
        end
        _UIKit:SetEnabled(self.Win .. "/BagPrev", pages > 1)
        _UIKit:SetEnabled(self.Win .. "/BagNext", pages > 1)
        _UIKit:SetText(self.Win .. "/BagLabel", "내 가방 " .. tostring(self.BagPage + 1) .. "/" .. tostring(pages) .. " · 누르고 「올리기」로 제안")
        _UIKit:SetText(self.Win .. "/TheirLabel", "상대 제안" .. (fresh and ("  " .. _UIKit:Colored("#FF6A50", "방금 바뀌었다")) or ""))
        _UIKit:SetText(self.Win .. "/TheirState", self:ConfirmText(t.TheirConfirm))
        _UIKit:SetText(self.Win .. "/TheirGoldBox/TheirGold", self:Num(t.TheirGold))
        _UIKit:SetText(self.Win .. "/MyState", self:ConfirmText(t.MyConfirm))
        self:RenderInfo(theirs, mine, bag, fresh)
    end

    @ExecSpace("ClientOnly")
    method void DrawGold(PlayerTrade t)
        -- 내 골드 칸: 지금 건 금액을 보여 준다 (누르고 고치는 중에는 그대로 둔다)
        local e = _UIKit:Get(self.Win .. "/MyGold")
        if not isvalid(e) or e.TextGUIRendererInputComponent == nil then return end
        local input = e.TextGUIRendererInputComponent
        if input.IsFocused then return end
        local want = self:Num(t.MyGold)
        if want == self.ShownGold then return end
        self.ShownGold = want
        input.Text = want
    end

    @ExecSpace("ClientOnly")
    method void RenderInfo(table theirs, table mine, table bag, boolean fresh)
        -- 오른쪽 설명 칸: 고른 물건 그림 · 이름 · 옵션 (상대 물건은 같은 부위 내 장비와 비교) + 가방 물건 「올리기」 · 내 제안 「되돌리기」
        local s = nil
        if self.PickSide == "their" then s = theirs[self.PickIndex] elseif self.PickSide == "my" then s = mine[self.PickIndex] elseif self.PickSide == "bag" then s = bag[self.PickIndex] end
        local canAct = s ~= nil and (self.PickSide == "my" or (self.PickSide == "bag" and #mine < 8))
        _UIKit:SetEnabled(self.Win .. "/Info/BtnAct", canAct)
        _UIKit:SetText(self.Win .. "/Info/BtnAct", self.PickSide == "my" and "되돌리기" or "올리기")
        _InventoryWindow:DrawItem(self.Win .. "/Info/Pick", s)
        if s == nil then
            _UIKit:SetText(self.Win .. "/Info/Head", "")
            _UIKit:SetText(self.Win .. "/Info/Text", _UIKit:Colored("#A99F8E", "칸을 누르면 그 물건의 옵션과 요구 레벨이 여기 보입니다.\n\n가방 물건은 「올리기」로 제안하고, 내 제안은 「되돌리기」로 가방에 돌려받습니다.\n상대 물건은 지금 내 장비와 무엇이 달라지는지도 함께 보여 줍니다.\n\n골드는 「내 제안」 오른쪽 아래 금화 칸을 눌러 금액을 바로 적습니다."))
            return
        end
        local heads = { their = "상대 제안\n", my = "내 제안\n", bag = "내 가방\n" }
        _UIKit:SetText(self.Win .. "/Info/Head", heads[self.PickSide] .. _ItemData:DisplayName(s))
        local text = _ItemData:DescribeDetailed(s)
        if self.PickSide == "their" then
            local base = _ItemData:GetBase(_ItemData:Parse(s).base)
            ---@type PlayerInventory
            local inv = _UIKit:Comp("script.PlayerInventory")
            if base ~= nil and inv ~= nil and base.slot ~= nil and base.slot ~= "" then
                local eq = inv:GetEquipMap()
                local slot = base.slot == "ring" and "ring1" or base.slot
                -- 같은 부위에 낀 것이 있을 때만 비교 (빈 칸이면 위 옵션과 같은 줄이 되풀이된다)
                if eq[slot] ~= nil and eq[slot] ~= "" then text = text .. "\n\n" .. _ItemData:CompareText(s, eq[slot]) end
            end
            if fresh then text = _UIKit:Colored("#FF6A50", "방금 바뀐 내용 — 다시 확인하세요") .. "\n" .. text end
        end
        _UIKit:SetText(self.Win .. "/Info/Text", text)
    end

    method string Num(integer n)
        -- 1234567 → 「1,234,567」
        local s = tostring(math.floor(n))
        local grouped = (string.gsub(string.reverse(s), "(%d%d%d)", "%1,"))
        local out = string.reverse(grouped)
        return (string.gsub(out, "^,", ""))
    end

    method table Split(string digest)
        local out = {}
        for x in string.gmatch(digest, "[^;]+") do table.insert(out, x) end
        return out
    end

    method string ConfirmText(boolean confirmed)
        if confirmed then return _UIKit:Colored("#7CFF7A", "확인함") end
        return _UIKit:Colored("#888888", "대기")
    end

end
