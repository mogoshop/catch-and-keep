-- 게임 고르기 (10-21 방 구조 · 10-22 개편 · docs/design/30): 캐릭터 선택과 같은 어두운 전체 화면(CharSelectHUD/SafeArea/Room)에 이어서 뜬다.
--   첫 화면 = 그림 카드 「솔로 플레이」 「파티 플레이」 + 캐릭터 선택 · 채널 변경.
--   파티 플레이 = 방 목록(다른 채널 방 포함) + 새로 고침 · 방 만들기 · 뒤로. 덮는 판: 방 만들기 · 비밀번호 · 모집 · 불러오는 중.
--   캐릭터 선택 「입장」을 누르면 바로 이 화면(불러오는 중)이 덮여 로비가 비치지 않는다. 로비를 떠나면(게임 방·심연) 저절로 닫힌다.
@Logic
script RoomWindow extends Logic

    property string Win = "RoomWin"
    property integer Rows = 7
    property table Ids = nil        -- 줄 번호 → 방 id
    property table Locked = nil     -- 줄 번호 → 비공개
    property table Names = nil      -- 줄 번호 → 방 이름
    property boolean MakePrivate = false
    property integer MakeMax = 4
    property string AskId = ""
    property string View = "home"   -- home · list
    property integer TimerId = 0
    property boolean Armed = false  -- 로비에서 이 창을 띄운 적이 있다 (닫혀 있으면 Guard가 다시 연다 · 로비를 떠나면 꺼진다)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.Ids = {}
        self.Locked = {}
        self.Names = {}
        _UIKit:RegisterWindow(self.Win)
        local w = self.Win .. "/Box"
        _UIKit:Connect(w .. "/Home/Solo", function() self:Solo() end)
        _UIKit:Connect(w .. "/Home/Party", function() self:SetView("list") end)
        _UIKit:Connect(w .. "/Home/BtnChar", function() _HudMain:AskCharSelect() end)
        _UIKit:Connect(w .. "/Home/BtnChannel", function() _ChannelWindow:Show() end)
        _UIKit:Connect(w .. "/List/BtnBack", function() self:SetView("home") end)
        _UIKit:Connect(w .. "/List/BtnRefresh", function() self:Refresh() end)
        _UIKit:Connect(w .. "/List/BtnCreate", function() self:OpenCreate() end)
        for i = 1, self.Rows do
            local row = i
            _UIKit:Connect(w .. "/List/R" .. tostring(i), function() self:Pick(row) end)
        end
        _UIKit:Connect(w .. "/Create/BtnPublic", function() self:SetPrivate(false) end)
        _UIKit:Connect(w .. "/Create/BtnPrivate", function() self:SetPrivate(true) end)
        for _, n in ipairs({ 2, 3, 4 }) do
            local count = n
            _UIKit:Connect(w .. "/Create/Max" .. tostring(n), function() self:SetMax(count) end)
        end
        _UIKit:Connect(w .. "/Create/BtnBack", function() self:Overlay("") end)
        _UIKit:Connect(w .. "/Create/BtnMake", function() self:Make() end)
        _UIKit:Connect(w .. "/Ask/BtnCancel", function() self:Overlay("") end)
        _UIKit:Connect(w .. "/Ask/BtnJoin", function() self:JoinAsked() end)
        _UIKit:Connect(w .. "/Party/BtnStart", function() self:Start() end)
        _UIKit:Connect(w .. "/Party/BtnLeave", function() self:LeaveParty() end)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Guard() end, 0.5)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    @ExecSpace("ClientOnly")
    method void Guard()
        -- 로비가 아닌 곳(게임 방·심연)에 들어갔으면 닫는다 — 불러오는 중 화면이 남지 않게
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(me.CurrentMap) then return end
        local lobby = me.CurrentMap.Name == _GameConst.MapLobby
        if _UIKit:IsOpen(self.Win) then
            if not lobby then
                _UIKit:Close(self.Win)
                self.Armed = false
            end
            return
        end
        if not lobby then
            self.Armed = false
            return
        end
        -- 로비에서 닫혀 있다 (Esc·채널 창 Esc 등, 10-29 45 §2-6 #3): 다른 창·확인 창·캐릭터 선택이 없으면 그대로 다시 연다 (보던 화면 유지)
        ---@type PlayerSave
        local save = _UIKit:Comp("script.PlayerSave")
        if not self.Armed or save == nil or save.Selecting or save.Slot <= 0 then return end
        if _UIKit:AnyWindowShown() or _ConfirmDialog:IsOpen() then return end
        _UIKit:Open(self.Win)
        log("[VRF] RoomWindow reopened in lobby view=" .. self.View)
    end

    @ExecSpace("ClientOnly")
    method void Back()
        -- Esc (UIKit): 덮는 판(방 만들기·비밀번호)을 닫거나 목록 → 첫 화면. 첫 화면·불러오는 중·모집 판에서는 그대로 (창은 닫지 않는다)
        if _UIKit:IsOpen(self.Win .. "/Box/Loading") or _UIKit:IsOpen(self.Win .. "/Box/Party") then return end
        if _UIKit:IsOpen(self.Win .. "/Box/Create") or _UIKit:IsOpen(self.Win .. "/Box/Ask") then
            self:Overlay("")
        elseif self.View == "list" then
            self:SetView("home")
        end
        log("[VRF] RoomWindow esc back view=" .. self.View)
    end

    @ExecSpace("ClientOnly")
    method void ShowLoading()
        -- 캐릭터 선택 「입장」 직후: 같은 어두운 화면을 바로 덮는다 (캐릭터 선택 창 위 · 다른 창은 건드리지 않는다)
        _UIKit:SetEnabled(self.Win, true)
        self.Armed = true
        for _, n in ipairs({ "Create", "Ask", "Party" }) do _UIKit:SetEnabled(self.Win .. "/Box/" .. n, false) end
        self:ShowParts(false, false)
        _UIKit:SetEnabled(self.Win .. "/Box/Loading", true)
        _UIKit:SetText(self.Win .. "/Box/Title", "게임 고르기")
    end

    @ExecSpace("ClientOnly")
    method void Show()
        -- 로비 도착: 첫 화면(카드 두 장)
        _UIKit:Open(self.Win)
        self.Armed = true
        _UIKit:SetEnabled(self.Win .. "/Box/Loading", false)
        self.View = "home"
        self:Overlay("")
        self:SetView("home")
        log("[VRF] RoomWindow show")
    end

    @ExecSpace("ClientOnly")
    method void ShowParts(boolean home, boolean list)
        _UIKit:SetEnabled(self.Win .. "/Box/Home", home)
        _UIKit:SetEnabled(self.Win .. "/Box/List", list)
        _UIKit:SetEnabled(self.Win .. "/Box/Loading", false)
    end

    @ExecSpace("ClientOnly")
    method void Overlay(string name)
        -- 덮는 판 하나만 (빈 이름 = 모두 닫기). 판이 떠 있는 동안 아래 화면을 숨긴다 (판 그림이 반투명이라 비친다)
        for _, n in ipairs({ "Create", "Ask", "Party" }) do _UIKit:SetEnabled(self.Win .. "/Box/" .. n, n == name) end
        local loading = _UIKit:IsOpen(self.Win .. "/Box/Loading")
        if not loading then self:ShowParts(name == "" and self.View == "home", name == "" and self.View == "list") end
    end

    @ExecSpace("ClientOnly")
    method void SetView(string view)
        self.View = view
        self:ShowParts(view == "home", view == "list")
        _UIKit:SetText(self.Win .. "/Box/Title", view == "list" and "파티플레이" or "게임 고르기")
        if view == "list" then
            self:Refresh()
        else
            _UIKit:SetText(self.Win .. "/Box/Home/Note", "")
        end
    end

    @ExecSpace("ClientOnly")
    method void Note(string text)
        _UIKit:SetText(self.Win .. (self.View == "list" and "/Box/List/Note" or "/Box/Home/Note"), text)
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        for i = 1, self.Rows do _UIKit:SetEnabled(self.Win .. "/Box/List/R" .. tostring(i), false) end
        _UIKit:SetEnabled(self.Win .. "/Box/List/Empty", false)
        _UIKit:SetText(self.Win .. "/Box/List/Note", "방 목록을 불러오는 중…")
        _RoomSystem:RequestRooms()
    end

    @ExecSpace("ClientOnly")
    method void OnRooms(string digest, boolean shared)
        -- digest 줄 = "id|이름|잠금|난이도|인원|최대|같은 채널|상태(w 모집 · p 진행)|지금 들어갈 수 있나" (RoomSystem.RequestRoomsFor)
        self.Ids = {}
        self.Locked = {}
        self.Names = {}
        local n = 0
        for id, name, lock, diff, cur, max, here, state, open in string.gmatch(digest, "([^|;]+)|([^|;]*)|(%d)|(%d)|(%d+)|(%d+)|(%d)|(%a)|(%d)") do
            n = n + 1
            if n <= self.Rows then
                local diffName = _GameConst:DifficultyName(tonumber(diff) or 0)
                local text = string.format("%s%s%s    [%s]    %s / %s명", state == "w" and "[모집 중] " or "", lock == "1" and "[비공개] " or "", name, diffName, cur, max)
                if tonumber(cur) >= tonumber(max) then
                    text = text .. "   · 가득"
                elseif state ~= "w" and open == "0" then
                    text = text .. "   · 채널 가득 (자리 나면 입장)"
                end
                self.Ids[n] = id
                self.Locked[n] = lock == "1"
                self.Names[n] = name
                local path = self.Win .. "/Box/List/R" .. tostring(n)
                _UIKit:SetEnabled(path, true)
                _UIKit:SetText(path, text)
            end
        end
        local note = "방을 눌러 들어가거나 「방 만들기」로 친구를 모으세요 — 모이면 함께 출발합니다"
        _UIKit:SetEnabled(self.Win .. "/Box/List/Empty", n == 0 and shared)
        if n == 0 then note = "" end
        if n > self.Rows then note = string.format("그 밖에 방 %d개 — 새로 고침하면 순서가 바뀝니다", n - self.Rows) end
        if not shared then note = "방 목록을 읽지 못했습니다 (솔로 플레이·방 만들기는 됩니다)" end
        _UIKit:SetText(self.Win .. "/Box/List/Note", note)
        log("[VRF] RoomWindow rooms=" .. tostring(n))
    end

    @ExecSpace("ClientOnly")
    method void Solo()
        self:Note("나만의 게임을 여는 중…")
        _RoomSystem:RequestSolo()
    end

    @ExecSpace("ClientOnly")
    method void OpenCreate()
        self:Overlay("Create")
        self:SetInput(self.Win .. "/Box/Create/Name", "")
        self:SetInput(self.Win .. "/Box/Create/Pw", "")
        self:SetPrivate(false)
        self:SetMax(4)
    end

    @ExecSpace("ClientOnly")
    method void SetPrivate(boolean on)
        -- 고른 쪽 단추를 밝게, 비밀번호 칸은 비공개일 때만
        self.MakePrivate = on
        self:Mark(self.Win .. "/Box/Create/BtnPublic", not on)
        self:Mark(self.Win .. "/Box/Create/BtnPrivate", on)
        _UIKit:SetEnabled(self.Win .. "/Box/Create/Pw", on)
        _UIKit:SetEnabled(self.Win .. "/Box/Create/PwLabel", on)
    end

    @ExecSpace("ClientOnly")
    method void SetMax(integer n)
        self.MakeMax = n
        for _, k in ipairs({ 2, 3, 4 }) do self:Mark(self.Win .. "/Box/Create/Max" .. tostring(k), k == n) end
    end

    @ExecSpace("ClientOnly")
    method void Mark(string path, boolean on)
        local e = _UIKit:Get(path)
        if not isvalid(e) or not isvalid(e.SpriteGUIRendererComponent) then return end
        e.SpriteGUIRendererComponent.Color = on and Color(1, 0.86, 0.62, 1) or Color(0.55, 0.52, 0.5, 1)
    end

    @ExecSpace("ClientOnly")
    method void Make()
        local name = self:GetInput(self.Win .. "/Box/Create/Name")
        local pw = self.MakePrivate and self:GetInput(self.Win .. "/Box/Create/Pw") or ""
        if self.MakePrivate and pw == "" then
            _UXFeedback:ShowNow("비밀번호", "비공개 방은 비밀번호를 정해야 합니다", _GameData:GetUiIcon("icon_gear"))
            return
        end
        self:Note("방을 여는 중…")
        _RoomSystem:RequestCreate(name, self.MakePrivate, pw, self.MakeMax)
    end

    @ExecSpace("ClientOnly")
    method void Pick(integer row)
        local id = self.Ids[row]
        if id == nil then return end
        if self.Locked[row] then
            self.AskId = id
            self:Overlay("Ask")
            _UIKit:SetText(self.Win .. "/Box/Ask/Title", "[비공개] " .. (self.Names[row] or "비공개 방"))
            self:SetInput(self.Win .. "/Box/Ask/Pw", "")
            return
        end
        self:Note("방에 들어가는 중…")
        _RoomSystem:RequestJoin(id, "")
    end

    @ExecSpace("ClientOnly")
    method void JoinAsked()
        if self.AskId == "" then return end
        self:Note("방에 들어가는 중…")
        _RoomSystem:RequestJoin(self.AskId, self:GetInput(self.Win .. "/Box/Ask/Pw"))
        self:Overlay("")
    end

    @ExecSpace("ClientOnly")
    method void Start()
        _UIKit:SetText(self.Win .. "/Box/Party/Note", "함께 들어갈 채널을 찾는 중…")
        _RoomSystem:RequestStart()
    end

    @ExecSpace("ClientOnly")
    method void LeaveParty()
        self:Overlay("")
        _RoomSystem:RequestLeaveParty()
    end

    @ExecSpace("ClientOnly")
    method void OnParty(string digest)
        -- 모집 판: "제목\t팀장(1/0)\t최대\t출발 대기(1/0)\t이름~같은 채널~팀장;…" (RoomSystem.SendParty)
        local parts = {}
        for piece in string.gmatch(digest .. "\t", "([^\t]*)\t") do table.insert(parts, piece) end
        if #parts < 5 then return end
        local leader = parts[2] == "1"
        local max = tonumber(parts[3]) or 4
        local members = {}
        -- 이름~같은 채널~팀장~채널 번호(0 = 메이커처럼 목록을 모를 때)~외형~레벨
        local mine = parts[6] or "0"
        for entry in string.gmatch(parts[5] .. ";", "([^;]*);") do
            local f = {}
            for v in string.gmatch(entry .. "~", "([^~]*)~") do table.insert(f, v) end
            if #f >= 3 and f[1] ~= "" then table.insert(members, { name = f[1], here = f[2] == "1", lead = f[3] == "1", chan = f[4] or "", look = (f[5] ~= nil and f[5] ~= "") and f[5] or "m-1-1", lv = tonumber(f[6] or "") or 0 }) end
        end
        local n = #members
        if not _UIKit:IsOpen(self.Win) then _UIKit:Open(self.Win) end
        if self.View ~= "list" then self:SetView("list") end
        self:Overlay("Party")
        _UIKit:SetText(self.Win .. "/Box/Party/Title", parts[1] .. string.format("   —   모집 중 %d / %d", n, max))
        self:RenderPartyCards(members, max, mine)
        _UIKit:SetEnabled(self.Win .. "/Box/Party/BtnStart", leader)
        local note = "팀장이 「출발」하면 함께 들어갑니다. 다른 채널에 있어도 됩니다"
        if leader then note = "친구가 모이면 「출발」 — 모두 함께 들어갈 자리가 있는 채널로 갑니다. 먼저 출발해도 친구는 나중에 들어올 수 있습니다" end
        if parts[4] == "1" then note = "지금은 모두 함께 들어갈 채널이 없어 자리가 나는 대로 출발합니다…" end
        _UIKit:SetText(self.Win .. "/Box/Party/Note", note)
        log("[VRF] RoomWindow party n=" .. tostring(n) .. "/" .. tostring(max) .. " leader=" .. tostring(leader))
    end

    @ExecSpace("ClientOnly")
    method void RenderPartyCards(table members, integer max, string mine)
        -- 모집 판 4칸: 캐릭터 선택과 같은 카드 (모습 · 이름 · 레벨 · 팀장/채널). 방 인원보다 많은 칸은 숨기고, 빈 칸은 「빈자리」
        local base = self.Win .. "/Box/Party/M"
        for i = 1, 4 do
            local path = base .. tostring(i)
            local m = members[i]
            _UIKit:SetEnabled(path, i <= max)
            _UIKit:SetEnabled(path .. "/Avatar", m ~= nil)
            _UIKit:SetEnabled(path .. "/Empty", m == nil)
            if m ~= nil then
                _CharSelectWindow:Dress(path .. "/Avatar", m.look)   -- 캐릭터 선택 카드와 같은 외형 입히기
                _UIKit:SetText(path .. "/Name", m.name)
                local info = m.lv > 0 and ("Lv " .. tostring(m.lv)) or ""
                if m.lead then info = info .. (info ~= "" and "  ·  " or "") .. _UIKit:Colored("#E6C88A", "팀장") end
                if not m.here then
                    local where = (m.chan ~= "" and m.chan ~= "0") and ("채널 " .. m.chan) or "다른 채널"
                    info = info .. (info ~= "" and "  ·  " or "") .. _UIKit:Colored("#8C99B4", where)
                end
                _UIKit:SetText(path .. "/Info", info)
            else
                _UIKit:SetText(path .. "/Name", "")
                _UIKit:SetText(path .. "/Info", "")
            end
        end
        _UIKit:SetText(self.Win .. "/Box/Party/Mine", mine ~= "0" and ("나: 채널 " .. mine) or "")
    end

    @ExecSpace("ClientOnly")
    method void OnPartyGo()
        _UIKit:SetText(self.Win .. "/Box/Party/Note", "출발! 게임에 들어가는 중…")
        _UIKit:SetEnabled(self.Win .. "/Box/Party/BtnStart", false)
    end

    @ExecSpace("ClientOnly")
    method void OnQueue(boolean waiting)
        _UIKit:SetText(self.Win .. "/Box/List/Note", waiting and "방의 채널에 자리가 나기를 기다리는 중... 자리가 나면 자동으로 들어갑니다" or "")
    end

    @ExecSpace("ClientOnly")
    method string GetInput(string path)
        local e = _UIKit:Get(path)
        if not isvalid(e) or e.TextGUIRendererInputComponent == nil then return "" end
        return e.TextGUIRendererInputComponent.Text or ""
    end

    @ExecSpace("ClientOnly")
    method void SetInput(string path, string text)
        local e = _UIKit:Get(path)
        if isvalid(e) and e.TextGUIRendererInputComponent ~= nil then e.TextGUIRendererInputComponent.Text = text end
    end

end
