-- 게임 고르기 창 (10-21 방 구조 · docs/design/30): 로비에 들어오면 열린다 (RoomSystem.OpenPicker).
--   혼자 하기 · 방 만들기(이름 · 공개/비공개 + 비밀번호 · 최대 2~4명) · 공개·비공개 방 목록(다른 채널 방 포함) · 캐릭터 선택 · 채널 변경.
--   로비에는 할 일이 없어 닫지 않는다 (닫기 단추 숨김). 메뉴 「게임 나가기」로 게임 방에서 로비로 돌아온다.
@Logic
script RoomWindow extends Logic

    property string Win = "RoomWin"
    property integer Rows = 7
    property table Ids = nil        -- 줄 번호 → 방 id
    property table Locked = nil     -- 줄 번호 → 비공개
    property table Names = nil      -- 줄 번호 → 방 이름
    property boolean MakePrivate = false
    property integer MakeMax = 4
    property string AskId = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.Ids = {}
        self.Locked = {}
        self.Names = {}
        _UIKit:RegisterWindow(self.Win)
        local w = self.Win
        _UIKit:Connect(w .. "/BtnSolo", function() self:Solo() end)
        _UIKit:Connect(w .. "/BtnCreate", function() self:OpenCreate() end)
        _UIKit:Connect(w .. "/BtnRefresh", function() self:Refresh() end)
        _UIKit:Connect(w .. "/BtnChar", function() _HudMain:AskCharSelect() end)
        _UIKit:Connect(w .. "/BtnChannel", function() _ChannelWindow:Show() end)
        for i = 1, self.Rows do
            local row = i
            _UIKit:Connect(w .. "/R" .. tostring(i), function() self:Pick(row) end)
        end
        _UIKit:Connect(w .. "/Create/BtnPublic", function() self:SetPrivate(false) end)
        _UIKit:Connect(w .. "/Create/BtnPrivate", function() self:SetPrivate(true) end)
        for _, n in ipairs({ 2, 3, 4 }) do
            local count = n
            _UIKit:Connect(w .. "/Create/Max" .. tostring(n), function() self:SetMax(count) end)
        end
        _UIKit:Connect(w .. "/Create/BtnBack", function() _UIKit:SetEnabled(self.Win .. "/Create", false) end)
        _UIKit:Connect(w .. "/Create/BtnMake", function() self:Make() end)
        _UIKit:Connect(w .. "/Ask/BtnCancel", function() _UIKit:SetEnabled(self.Win .. "/Ask", false) end)
        _UIKit:Connect(w .. "/Ask/BtnJoin", function() self:JoinAsked() end)
        _UIKit:SetEnabled(w .. "/BtnClose", false)
    end

    @ExecSpace("ClientOnly")
    method void Show()
        -- 로비 도착: 창을 열고 목록을 불러온다
        _UIKit:Open(self.Win)
        _UIKit:SetEnabled(self.Win .. "/Create", false)
        _UIKit:SetEnabled(self.Win .. "/Ask", false)
        self:Refresh()
        log("[VRF] RoomWindow show")
    end

    @ExecSpace("ClientOnly")
    method void Refresh()
        for i = 1, self.Rows do _UIKit:SetEnabled(self.Win .. "/R" .. tostring(i), false) end
        _UIKit:SetText(self.Win .. "/Note", "방 목록을 불러오는 중...")
        _RoomSystem:RequestRooms()
    end

    @ExecSpace("ClientOnly")
    method void OnRooms(string digest, boolean shared)
        -- digest 줄 = "id|이름|잠금|난이도|인원|최대|같은 채널"
        self.Ids = {}
        self.Locked = {}
        self.Names = {}
        local n = 0
        for id, name, lock, diff, cur, max, here in string.gmatch(digest, "([^|;]+)|([^|;]*)|(%d)|(%d)|(%d+)|(%d+)|(%d)") do
            n = n + 1
            if n <= self.Rows then
                local diffName = _GameConst:DifficultyName(tonumber(diff) or 0)
                local text = string.format("%s%s    [%s]    %s / %s명%s", lock == "1" and "[비공개] " or "", name, diffName, cur, max, here == "1" and "" or "   · 다른 채널")
                if tonumber(cur) >= tonumber(max) then text = text .. "   · 가득" end
                self.Ids[n] = id
                self.Locked[n] = lock == "1"
                self.Names[n] = name
                local path = self.Win .. "/R" .. tostring(n)
                _UIKit:SetEnabled(path, true)
                _UIKit:SetText(path, text)
            end
        end
        local note = "혼자 하기는 나만의 방입니다. 함께 하려면 방을 만들거나 목록의 방에 들어가세요 (방 최대 4명)"
        if n == 0 then note = "열린 방이 없습니다 — 「방 만들기」로 먼저 열어 보세요" end
        if n > self.Rows then note = string.format("그 밖에 방 %d개 — 새로 고침하면 순서가 바뀝니다", n - self.Rows) end
        if not shared then note = "방 목록을 읽지 못했습니다 (혼자 하기·방 만들기는 됩니다)" end
        _UIKit:SetText(self.Win .. "/Note", note)
        log("[VRF] RoomWindow rooms=" .. tostring(n))
    end

    @ExecSpace("ClientOnly")
    method void Solo()
        _UIKit:SetText(self.Win .. "/Note", "나만의 방을 여는 중...")
        _RoomSystem:RequestSolo()
    end

    @ExecSpace("ClientOnly")
    method void OpenCreate()
        _UIKit:SetEnabled(self.Win .. "/Ask", false)
        _UIKit:SetEnabled(self.Win .. "/Create", true)
        self:SetInput(self.Win .. "/Create/Name", "")
        self:SetInput(self.Win .. "/Create/Pw", "")
        self:SetPrivate(false)
        self:SetMax(4)
    end

    @ExecSpace("ClientOnly")
    method void SetPrivate(boolean on)
        -- 고른 쪽 단추를 밝게, 비밀번호 칸은 비공개일 때만
        self.MakePrivate = on
        self:Mark(self.Win .. "/Create/BtnPublic", not on)
        self:Mark(self.Win .. "/Create/BtnPrivate", on)
        _UIKit:SetEnabled(self.Win .. "/Create/Pw", on)
        _UIKit:SetEnabled(self.Win .. "/Create/PwLabel", on)
    end

    @ExecSpace("ClientOnly")
    method void SetMax(integer n)
        self.MakeMax = n
        for _, k in ipairs({ 2, 3, 4 }) do self:Mark(self.Win .. "/Create/Max" .. tostring(k), k == n) end
    end

    @ExecSpace("ClientOnly")
    method void Mark(string path, boolean on)
        local e = _UIKit:Get(path)
        if not isvalid(e) or not isvalid(e.SpriteGUIRendererComponent) then return end
        e.SpriteGUIRendererComponent.Color = on and Color(1, 0.86, 0.62, 1) or Color(0.55, 0.52, 0.5, 1)
    end

    @ExecSpace("ClientOnly")
    method void Make()
        local name = self:GetInput(self.Win .. "/Create/Name")
        local pw = self.MakePrivate and self:GetInput(self.Win .. "/Create/Pw") or ""
        if self.MakePrivate and pw == "" then
            _UXFeedback:Show("비밀번호", "비공개 방은 비밀번호를 정해야 합니다", _GameData:GetUiIcon("icon_gear"))
            return
        end
        _UIKit:SetText(self.Win .. "/Note", "방을 여는 중...")
        _RoomSystem:RequestCreate(name, self.MakePrivate, pw, self.MakeMax)
    end

    @ExecSpace("ClientOnly")
    method void Pick(integer row)
        local id = self.Ids[row]
        if id == nil then return end
        if self.Locked[row] then
            self.AskId = id
            _UIKit:SetEnabled(self.Win .. "/Create", false)
            _UIKit:SetEnabled(self.Win .. "/Ask", true)
            _UIKit:SetText(self.Win .. "/Ask/Title", "[비공개] " .. (self.Names[row] or "비공개 방"))
            self:SetInput(self.Win .. "/Ask/Pw", "")
            return
        end
        _UIKit:SetText(self.Win .. "/Note", "방에 들어가는 중...")
        _RoomSystem:RequestJoin(id, "")
    end

    @ExecSpace("ClientOnly")
    method void JoinAsked()
        if self.AskId == "" then return end
        _UIKit:SetText(self.Win .. "/Note", "방에 들어가는 중...")
        _RoomSystem:RequestJoin(self.AskId, self:GetInput(self.Win .. "/Ask/Pw"))
        _UIKit:SetEnabled(self.Win .. "/Ask", false)
    end

    @ExecSpace("ClientOnly")
    method string GetInput(string path)
        local e = _UIKit:Get(path)
        if not isvalid(e) or e.TextGUIRendererInputComponent == nil then return "" end
        return e.TextGUIRendererInputComponent.Text or ""
    end

    @ExecSpace("ClientOnly")
    method void SetInput(string path, string text)
        local e = _UIKit:Get(path)
        if isvalid(e) and e.TextGUIRendererInputComponent ~= nil then e.TextGUIRendererInputComponent.Text = text end
    end

end
