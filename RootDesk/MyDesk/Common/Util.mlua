-- 여러 시스템이 같이 쓰는 도우미. 같은 코드를 컴포넌트마다 복사하지 않기 위해 둔다.
--   Notify          : 특정 플레이어 화면 안내 (서버 → 그 클라이언트)
--   AfterSpawn      : 스폰 직후 컴포넌트 조회 실패 대비 재시도 (MSW: 첫 프레임에 GetComponent가 nil일 수 있음)
--   PlayersNear     : 맵의 살아 있는 플레이어 중 반경 안
--   NearestPlayerDistance, OwnerPlayerOf, Distance
@Logic
script Util extends Logic

    property integer SpawnRetryCount = 5
    property number SpawnRetryInterval = 0.1
    property any ListMemo = nil               -- 맵Id·종류 → { at, list } 맵 전체 컴포넌트 목록 (0.2초 재사용)
    property number ListMemoSec = 0.2
    property any TileMemo = nil               -- 맵Id → { tiles, ox, oy, gx, gy, cells = 칸키 → 막힘 } (일반 Lua 테이블이라 any)

    @ExecSpace("Client")
    method void Notify(string text)
        -- 서버에서 _Util:Notify(text, userId) 로 부른다 (마지막 인자 = 받을 사람)
        _NoticeFeed:Push(text)
    end

    -- 메시지 세 갈래 (10-11 팀 QA: 위쪽 가운데·왼쪽 아래로 흩어져 보기 불편했다 — docs/ui/message-rules.md)
    --   · Notify: 왼쪽 아래 안내 줄 — 획득·기록·창 안의 결과 (골드, 구매, 판매, 보상 내역)
    --   · Warn:   내 캐릭터 머리 위 짧은 글씨 — 지금 한 행동이 안 된 이유 (마나 부족, 혼이 멀다, 이미 마을)
    --   · Banner: 왼쪽 알림 판(안내 줄 바로 위) — 진행 사건 (레벨 업, 의뢰 완료, 업적, 난이도 열림, 층 정리)
    @ExecSpace("Client")
    method void Warn(string text)
        -- 서버에서 _Util:Warn(text, userId). 창이 열려 있으면 머리 위 글씨가 가려지므로 안내 줄로
        if _UIKit:AnyWindowOpen() then _NoticeFeed:Push(text) return end
        _HudMain:ShowWarn(text)
    end

    @ExecSpace("Client")
    method void Banner(string title, string detail)
        -- 서버에서 _Util:Banner(title, detail, userId)
        _UXFeedback:Show(title, detail, "")
    end

    @ExecSpace("ServerOnly")
    method void NotifyMap(Entity map, string text)
        -- 그 맵 안의 모든 사람에게 알림
        for _, p in ipairs(self:PlayersInMap(map)) do self:Notify(text, p.PlayerComponent.UserId) end
    end

    @ExecSpace("ServerOnly")
    method void AfterSpawn(Entity e, string componentName, any onReady, any onFail)
        -- e의 componentName 컴포넌트가 잡히면 onReady(comp), 끝내 실패하면 onFail() (nil 가능)
        self:TryAfterSpawn(e, componentName, onReady, onFail, 0)
    end

    @ExecSpace("ServerOnly")
    method void TryAfterSpawn(Entity e, string componentName, any onReady, any onFail, integer attempt)
        if not isvalid(e) then return end
        local ok, comp = pcall(function() return e:GetComponent(componentName) end)
        if ok and comp ~= nil then
            onReady(comp)
            return
        end
        if attempt >= self.SpawnRetryCount then
            if onFail ~= nil then onFail() end
            return
        end
        _TimerService:SetTimerOnce(function() self:TryAfterSpawn(e, componentName, onReady, onFail, attempt + 1) end, self.SpawnRetryInterval)
    end

    method number Distance(Entity a, Entity b)
        local p = a.TransformComponent.WorldPosition
        local q = b.TransformComponent.WorldPosition
        return (Vector2(p.x, p.y) - Vector2(q.x, q.y)):Magnitude()
    end

    @ExecSpace("ServerOnly")
    method table PlayersNear(Entity map, Vector2 center, number radius)
        -- 맵의 살아 있는 플레이어 중 center에서 radius 안 (가까운 순 아님)
        local result = {}
        if not isvalid(map) then return result end
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users == nil then return result end
        for _, u in ipairs(users) do
            if isvalid(u) and not u.PlayerComponent:IsDead() then
                local q = u.TransformComponent.WorldPosition
                if (Vector2(q.x, q.y) - center):Magnitude() <= radius then table.insert(result, u) end
            end
        end
        return result
    end

    @ExecSpace("ServerOnly")
    method table PlayersInMap(Entity map)
        local result = {}
        if not isvalid(map) then return result end
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users == nil then return result end
        for _, u in ipairs(users) do if isvalid(u) then table.insert(result, u) end end
        return result
    end

    @ExecSpace("ServerOnly")
    method number NearestPlayerDistance(Entity map, Vector2 center)
        local best = 999
        for _, u in ipairs(self:PlayersInMap(map)) do
            local q = u.TransformComponent.WorldPosition
            local d = (Vector2(q.x, q.y) - center):Magnitude()
            if d < best then best = d end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method Entity OwnerPlayerOf(Entity attacker)
        -- 막타가 플레이어면 그대로, 그림자면 그 주인 플레이어 (보상·의뢰 귀속)
        if not isvalid(attacker) then return nil end
        if isvalid(attacker.PlayerComponent) then return attacker end
        ---@type ShadowUnit
        local unit = attacker:GetComponent("script.ShadowUnit")
        if unit ~= nil and isvalid(unit.OwnerPlayer) then return unit.OwnerPlayer end
        return nil
    end

    method any TerrainMemo(Entity map)
        -- 맵의 타일맵과 칸 계산값. 맵마다 한 번만 찾고, 칸별 막힘 결과를 계속 기억한다 (실행 중 타일을 바꾸는 코드는 없다).
        if not isvalid(map) then return nil end
        if self.TileMemo == nil then self.TileMemo = {} end
        local memo = self.TileMemo
        local m = memo[map.Id]
        if m ~= nil then
            if m.none then return nil end
            if isvalid(m.entity) then return m end
        end
        local tiles = map:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        if tiles == nil then
            memo[map.Id] = { none = true }
            return nil
        end
        -- ToWorldPosition은 칸 중심을 준다 (GroundPath에서 확인). 칸 = floor((좌표 - 0번 칸 중심) / 크기 + 0.5)
        local c0 = tiles:ToWorldPosition(0, 0)
        local grid = tiles.GridSize
        m = { tiles = tiles, entity = tiles.Entity, ox = c0.x, oy = c0.y, gx = grid.x, gy = grid.y, cells = {} }
        memo[map.Id] = m
        return m
    end

    method boolean CellBlocked(any m, Vector2 point)
        -- 그 지점의 칸이 없거나 충돌 타일이면 막힘. 엔진 조회는 칸마다 한 번만 (시야 판정 실측 0.1ms → 0.05ms).
        local x = math.floor((point.x - m.ox) / m.gx + 0.5)
        local y = math.floor((point.y - m.oy) / m.gy + 0.5)
        local key = x * 100000 + y
        local blocked = m.cells[key]
        if blocked == nil then
            local tile = m.tiles:GetTile(Vector2Int(x, y))
            blocked = tile == nil or tile.IsCollidable
            m.cells[key] = blocked
        end
        return blocked
    end

    method table ListOf(Entity map, string typeName)
        -- 맵 전체에서 그 종류의 컴포넌트 목록. 0.2초 동안 같은 목록을 돌려준다 (10-10 4차 QA: 몬스터 46마리·소환수가 초당 수백 번
        -- 맵 전체를 다시 뒤지며 표를 만들어 서버가 30~70ms씩 멈췄다). 사라진 개체가 섞일 수 있으니 쓰는 쪽에서 isvalid로 거른다
        if not isvalid(map) then return {} end
        if self.ListMemo == nil then self.ListMemo = {} end
        local key = map.Id .. "|" .. typeName
        local now = _UtilLogic.ElapsedSeconds
        local m = self.ListMemo[key]
        if m ~= nil and now - m.at < self.ListMemoSec then return m.list end
        local list = map:GetChildComponentsByTypeName(typeName, true)
        self.ListMemo[key] = { at = now, list = list }
        return list
    end

    method table MonstersNear(Entity map, Vector2 center, number radius)
        -- 살아 있는(보이는) 몬스터 중 반경 안, 가까운 순 (서버·클라이언트 공용)
        local found = {}
        if not isvalid(map) then return found end
        for _, c in ipairs(self:ListOf(map, "script.Monster")) do
            ---@type Monster
            local m = c
            if isvalid(c) and isvalid(c.Entity) and not m.IsDead and c.Entity.Enable then
                local q = c.Entity.TransformComponent.WorldPosition
                local d = (Vector2(q.x, q.y) - center):Magnitude()
                if d <= radius then table.insert(found, { m = m, d = d }) end
            end
        end
        table.sort(found, function(a, b) return a.d < b.d end)
        local list = {}
        for _, f in ipairs(found) do table.insert(list, f.m) end
        return list
    end

    method Monster MonsterInCone(Entity map, Vector2 origin, Vector2 dir, number range, number minCos)
        -- 바라보는 방향 부채꼴(dir과의 각 cos ≥ minCos) 안에서 가장 가까운 몬스터. 키보드·모바일 스킬 조준 보조
        if dir:Magnitude() < 0.01 then return nil end
        local d = dir:Normalize()
        for _, m in ipairs(self:MonstersNear(map, origin, range)) do
            local q = m.Entity.TransformComponent.WorldPosition
            local to = Vector2(q.x, q.y) - origin
            local len = to:Magnitude()
            if len < 0.3 or (to.x * d.x + to.y * d.y) / len >= minCos then return m end
        end
        return nil
    end

    method Monster NearestMonster(Entity map, Vector2 center, number radius)
        local list = self:MonstersNear(map, center, radius)
        return list[1]
    end

    method any NearestComponent(Entity map, string componentName, Vector2 center, number radius)
        -- 맵에서 componentName을 가진 엔티티 중 반경 안 가장 가까운 것의 컴포넌트 (없으면 nil)
        if not isvalid(map) then return nil end
        local best = nil
        local bestDist = radius
        for _, c in ipairs(map:GetChildComponentsByTypeName(componentName, true)) do
            local q = c.Entity.TransformComponent.WorldPosition
            local d = (Vector2(q.x, q.y) - center):Magnitude()
            if d <= bestDist then
                bestDist = d
                best = c
            end
        end
        return best
    end

    method boolean NearNpc(Entity player, string kind)
        -- 상점·의뢰 같은 NPC 기능은 그 NPC 대화 거리 안에서만 (서버 검증용)
        local map = player.CurrentMap
        if not isvalid(map) then return false end
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.WorldNPC", true)) do
            ---@type WorldNPC
            local npc = c
            if npc.Kind == kind and self:Distance(player, c.Entity) <= npc.TalkRange + 0.5 then return true end
        end
        return false
    end

    method boolean IsAlive(Entity player)
        -- 플레이어가 살아 있는가 (HP > 0 이고 사망 처리·부활 대기 중이 아님)
        if not isvalid(player) or player.PlayerComponent == nil then return false end
        local pc = player.PlayerComponent
        if pc.Hp <= 0 or pc:IsDead() then return false end
        ---@type PlayerVitals
        local vitals = player:GetComponent("script.PlayerVitals")
        return vitals == nil or not vitals.Dying
    end

    method Vector2 Pos2(Entity e)
        local p = e.TransformComponent.WorldPosition
        return Vector2(p.x, p.y)
    end

    method boolean TileBlocked(Entity terrain, Vector2 point)
        if not isvalid(terrain) then return false end
        local m = self:TerrainMemo(terrain.CurrentMap)
        if m ~= nil and m.entity == terrain then return self:CellBlocked(m, point) end
        local tiles = terrain.RectTileMapComponent
        local tile = tiles:GetTile(tiles:ToCellPosition(Vector3(point.x, point.y, 0)))
        return tile == nil or tile.IsCollidable
    end

    method void SetFlipX(Entity e, boolean value)
        -- 바뀔 때만 쓴다 (매 프레임 같은 값을 다시 쓰던 몬스터 이동 코드 — 10-13 3인 파티 끊김 점검)
        local r = isvalid(e) and e.SpriteRendererComponent or nil
        if isvalid(r) and r.FlipX ~= value then r.FlipX = value end
    end

    method Vector2 ReachablePoint(Entity map, Vector2 from, Vector2 to, number margin)
        -- from에서 to로 곧게 갈 때 벽에 닿기 전 마지막 자리 (몸 여유 margin만큼 상하좌우도 비어 있어야 한다).
        -- 순간이동·도약처럼 위치를 바로 쓰는 곳은 이걸 거친다 — 벽 너머로 넘어가거나 벽 속에 내려앉지 않게
        -- (10-13 사용자 지적: 굶주린 굴 우두머리 무덤 구더기가 도약 강타로 벽 속에 들어가 숨은 채 끼었다)
        local m = self:TerrainMemo(map)
        if m == nil then return to end
        local free = function(q)
            if self:CellBlocked(m, q) then return false end
            if margin <= 0 then return true end
            return not self:CellBlocked(m, q + Vector2(margin, 0)) and not self:CellBlocked(m, q - Vector2(margin, 0))
                and not self:CellBlocked(m, q + Vector2(0, margin)) and not self:CellBlocked(m, q - Vector2(0, margin))
        end
        local offset = to - from
        local count = math.max(1, math.ceil(offset:Magnitude() / 0.2))
        local last = from
        for i = 1, count do
            local q = from + offset * (i / count)
            if not free(q) then return last end
            last = q
        end
        return last
    end

    method any NearestFreePoint(Entity map, Vector2 p, number maxRadius)
        -- p가 벽 칸이면 가장 가까운 빈 칸 중심 (maxRadius칸 안, 없으면 nil). 벽이 아니면 p 그대로
        local m = self:TerrainMemo(map)
        if m == nil or not self:CellBlocked(m, p) then return p end
        local cx = math.floor((p.x - m.ox) / m.gx + 0.5)
        local cy = math.floor((p.y - m.oy) / m.gy + 0.5)
        local best, bestD = nil, 1e9
        for r = 1, math.max(1, math.floor(maxRadius)) do
            for dx = -r, r do
                for dy = -r, r do
                    if math.max(math.abs(dx), math.abs(dy)) == r then
                        local q = Vector2(m.ox + (cx + dx) * m.gx, m.oy + (cy + dy) * m.gy)
                        local d = (q - p):Magnitude()
                        if d < bestD and not self:CellBlocked(m, q) then best, bestD = q, d end
                    end
                end
            end
            if best ~= nil then return best end
        end
        return nil
    end

    method boolean HasLineOfSight(Entity map, Vector2 from, Vector2 to)
        if not isvalid(map) then return false end
        local m = self:TerrainMemo(map)
        if m == nil then return true end
        local offset = to - from
        local count = math.max(1, math.ceil(offset:Magnitude() / 0.2))
        for i = 1, count do
            if self:CellBlocked(m, from + offset * (i / count)) then return false end
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method integer GroundDecal(string ruid, number pxW, number pxH, Entity instigator, Vector3 center, number radius, Color tint)
        -- 바닥 장판 그림(스프라이트, 발밑 기준 피벗)을 반지름 radius 원을 덮게 늘여 깐다. 반복 재생 → 끝나면 _EffectService:RemoveEffect(serial)
        -- (코덱스 장판 그림 poison-ground 160×80 · fire-ground 140×70 등. 그림 높이는 지름의 pxH/pxW)
        local scale = (radius * 2) / (pxW / 100)
        local height = (pxH / 100) * scale
        return _EffectService:PlayEffect(ruid, instigator, center - Vector3(0, height * 0.5, 0), 0, Vector3(scale, scale, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 2, Color = tint })
    end

end
