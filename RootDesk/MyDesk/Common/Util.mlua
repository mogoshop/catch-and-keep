-- 여러 시스템이 같이 쓰는 도우미. 같은 코드를 컴포넌트마다 복사하지 않기 위해 둔다.
--   Notify          : 특정 플레이어 화면 안내 (서버 → 그 클라이언트)
--   AfterSpawn      : 스폰 직후 컴포넌트 조회 실패 대비 재시도 (MSW: 첫 프레임에 GetComponent가 nil일 수 있음)
--   PlayersNear     : 맵의 살아 있는 플레이어 중 반경 안
--   NearestPlayerDistance, OwnerPlayerOf, Distance
@Logic
script Util extends Logic

    property integer SpawnRetryCount = 5
    property number SpawnRetryInterval = 0.1
    property any ListMemo = nil               -- 맵Id·종류 → { at, list } 맵 전체 컴포넌트 목록 (0.2초 재사용)
    property number ListMemoSec = 0.2
    property integer SkillShakeCount = 0       -- 내 스킬 화면 흔들림 횟수 (메이커 확인용)
    property table Telegraphs = {}            -- 클라이언트: 범위 예고 id → { rim, fill, decal, timer }
    property integer TelegraphSeq = 0
    property number BossRimSpin = 40           -- 보스 범위 예고 고리가 도는 빠르기 (도/초, 시계 방향)
    property any TileMemo = nil               -- 맵Id → { tiles, ox, oy, gx, gy, cells = 칸키 → 막힘 } (일반 Lua 테이블이라 any)
    property number FrameSwapOverlap = 0.03    -- 프레임 그림: 다음 장을 먼저 걸고 앞 장은 이만큼 뒤에 지운다 (지우고 걸면 한 화면 빈다 · SkillEffects.PlaySeq와 같은 방식 · 10-31 갈래 E)
    property integer FrameFadeSteps = 3        -- 프레임 그림 끝 옅어짐 단계 수 (PlayFramesHold fadeSec > 0일 때 · 같은 장을 낮은 투명도로 갈아 끼운다)
    property number SlashArtPerOld = 1.9       -- 10-31 C 7종 중립 베기 배율 = 예전 FxSlash 배율 × 이 값: 예전 클립 배율 1의 폭 2.145칸(audit P01 1.18/0.55) ÷ 새 그림 내용 폭 113px(알파>16 최대 · 02) → 플레이어 평타 0.55 → 1.04배 = 내용 1.18×0.70칸
    property integer SlashArtOrder = 6         -- 베기 층 MapLayer0 6 (몸 앞 · FramesFxOrder와 같음)
    property table SlashLogged = {}            -- [VRF] 부르는 쪽(player·summon·monster)마다 처음 한 번

    @ExecSpace("Client")
    method void Notify(string text)
        -- 서버에서 _Util:Notify(text, userId) 로 부른다 (마지막 인자 = 받을 사람)
        _NoticeFeed:Push(text)
    end

    -- 메시지 세 갈래 (10-11 팀 QA: 위쪽 가운데·왼쪽 아래로 흩어져 보기 불편했다 — docs/ui/message-rules.md)
    --   · Notify: 왼쪽 아래 안내 줄 — 획득·기록·창 안의 결과 (골드, 구매, 판매, 보상 내역)
    --   · Warn:   내 캐릭터 머리 위 짧은 글씨 — 지금 한 행동이 안 된 이유 (마나 부족, 혼이 멀다, 이미 마을)
    --   · Banner: 왼쪽 알림 판(안내 줄 바로 위) — 진행 사건 (레벨 업, 의뢰 완료, 업적, 난이도 열림, 층 정리)
    @ExecSpace("Client")
    method void Warn(string text)
        -- 서버에서 _Util:Warn(text, userId). 창이 열려 있으면 머리 위 글씨가 가려지므로 안내 줄로 (창 밖 가장자리 — NoticeFeed)
        -- 「안 된 이유」라 공통 실패 소리를 함께 낸다 (10-29 45-3 · 연달아 와도 0.5초에 한 번)
        _UIKit:Sound("fail")
        if _UIKit:AnyWindowOpen() then _NoticeFeed:Push(text) return end
        _HudMain:ShowWarn(text)
    end

    @ExecSpace("Client")
    method void Banner(string title, string detail)
        -- 서버에서 _Util:Banner(title, detail, userId)
        _UXFeedback:Show(title, detail, "")
    end

    @ExecSpace("ServerOnly")
    method void NotifyMap(Entity map, string text)
        -- 그 맵 안의 모든 사람에게 알림
        for _, p in ipairs(self:PlayersInMap(map)) do self:Notify(text, p.PlayerComponent.UserId) end
    end

    -- 알림 채널 (10-31 실플레이 피드백 B-4 · docs/evidence/2026-10-31-playfeedback-B/notice-channels.md)
    --   A 「상단 띠」(HudMap.TopPush): 습격 · 보스 등장/처치 · 퀘스트 목표 달성 · 일지 완료 · 맵 입장 — 한 번에 하나
    --   B 「왼쪽 알림 더미」(NoticeFeed): Notify · Warn(창이 떠 있을 때) — 최대 3줄(모바일 2) · 같은 글 10초 안 ×N
    --   C 「오른쪽 추적기」: 퀘스트 추적기 안 일지 진행 (JournalWindow → HudMain.SetJournalTrack)
    --   D 「줍기 표시」(HudMain.PickupPop): 골드·아이템 획득을 캐릭터 발밑 작은 글씨로
    @ExecSpace("Client")
    method void NotifyTop(string key, string title, string line, integer prio)
        -- 서버에서 _Util:NotifyTop(key, title, line, prio, userId). 채널 A를 끄면(HudMap.TopChannelOn) 예전처럼 안내 줄 한 줄
        if _HudMap.TopChannelOn then
            _HudMap:TopPush(key, title, line, prio)
            return
        end
        _NoticeFeed:Push(line ~= "" and (title .. " — " .. line) or title)
    end

    @ExecSpace("ServerOnly")
    method void NotifyTopMap(Entity map, string key, string title, string line, integer prio)
        -- 그 맵 안의 모든 사람에게 채널 A 한 줄
        for _, p in ipairs(self:PlayersInMap(map)) do self:NotifyTop(key, title, line, prio, p.PlayerComponent.UserId) end
    end

    @ExecSpace("Client")
    method void NotifyPickup(string text)
        -- 서버에서 _Util:NotifyPickup(text, userId): 줍기 결과(골드 +N · 아이템 이름)는 발밑 작은 글씨 (채널 D)
        _HudMain:PickupPop(text)
    end

    @ExecSpace("ServerOnly")
    method void AfterSpawn(Entity e, string componentName, any onReady, any onFail)
        -- e의 componentName 컴포넌트가 잡히면 onReady(comp), 끝내 실패하면 onFail() (nil 가능)
        self:TryAfterSpawn(e, componentName, onReady, onFail, 0)
    end

    @ExecSpace("ServerOnly")
    method void TryAfterSpawn(Entity e, string componentName, any onReady, any onFail, integer attempt)
        if not isvalid(e) then return end
        local ok, comp = pcall(function() return e:GetComponent(componentName) end)
        if ok and comp ~= nil then
            onReady(comp)
            return
        end
        if attempt >= self.SpawnRetryCount then
            if onFail ~= nil then onFail() end
            return
        end
        _TimerService:SetTimerOnce(function() self:TryAfterSpawn(e, componentName, onReady, onFail, attempt + 1) end, self.SpawnRetryInterval)
    end

    method number Distance(Entity a, Entity b)
        local p = a.TransformComponent.WorldPosition
        local q = b.TransformComponent.WorldPosition
        return (Vector2(p.x, p.y) - Vector2(q.x, q.y)):Magnitude()
    end

    @ExecSpace("ServerOnly")
    method table PlayersNear(Entity map, Vector2 center, number radius)
        -- 맵의 살아 있는 플레이어 중 center에서 radius 안 (가까운 순 아님)
        local result = {}
        if not isvalid(map) then return result end
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users == nil then return result end
        for _, u in ipairs(users) do
            if isvalid(u) and not u.PlayerComponent:IsDead() then
                local q = u.TransformComponent.WorldPosition
                if (Vector2(q.x, q.y) - center):Magnitude() <= radius then table.insert(result, u) end
            end
        end
        return result
    end

    @ExecSpace("ServerOnly")
    method table PlayersInMap(Entity map)
        local result = {}
        if not isvalid(map) then return result end
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users == nil then return result end
        for _, u in ipairs(users) do if isvalid(u) then table.insert(result, u) end end
        return result
    end

    @ExecSpace("ServerOnly")
    method number NearestPlayerDistance(Entity map, Vector2 center)
        local best = 999
        for _, u in ipairs(self:PlayersInMap(map)) do
            local q = u.TransformComponent.WorldPosition
            local d = (Vector2(q.x, q.y) - center):Magnitude()
            if d < best then best = d end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method Entity OwnerPlayerOf(Entity attacker)
        -- 막타가 플레이어면 그대로, 그림자면 그 주인 플레이어 (보상·의뢰 귀속)
        if not isvalid(attacker) then return nil end
        if isvalid(attacker.PlayerComponent) then return attacker end
        ---@type ShadowUnit
        local unit = attacker:GetComponent("script.ShadowUnit")
        if unit ~= nil and isvalid(unit.OwnerPlayer) then return unit.OwnerPlayer end
        return nil
    end

    method boolean IsDuelFoe(Entity a, Entity b)
        -- a·b(플레이어 또는 그 소환수)의 주인이 서로 결투 중이고 시작 유예가 지났나 (PvP 적중 판정 — 10-23 결투 군단전)
        local oa = self:OwnerPlayerOf(a)
        local ob = self:OwnerPlayerOf(b)
        if not isvalid(oa) or not isvalid(ob) or oa == ob then return false end
        ---@type PlayerDuel
        local duel = oa:GetComponent("script.PlayerDuel")
        return duel ~= nil and duel:IsOpponent(ob)
    end

    @ExecSpace("ServerOnly")
    method table DuelFoesNear(Entity me, Entity map, Vector2 center, number radius, boolean playersOnly)
        -- me(플레이어·소환수)의 결투 상대 플레이어와 그 소환수 중 반경 안에 살아 있는 것 (엔티티 목록, 플레이어 먼저)
        local out = {}
        local owner = self:OwnerPlayerOf(me)
        if not isvalid(owner) or not isvalid(map) then return out end
        ---@type PlayerDuel
        local duel = owner:GetComponent("script.PlayerDuel")
        if duel == nil or duel.Opponent == "" then return out end
        local foe = _UserService:GetUserEntityByUserId(duel.Opponent)
        if not isvalid(foe) or foe.CurrentMap ~= map or not duel:IsOpponent(foe) then return out end
        if foe.PlayerComponent.Hp > 0 and (self:Pos2(foe) - center):Magnitude() <= radius then table.insert(out, foe) end
        if playersOnly then return out end
        for _, c in ipairs(self:ListOf(map, "script.ShadowUnit")) do
            ---@type ShadowUnit
            local u = c
            if isvalid(c) and u.OwnerPlayer == foe and not u.Dead and u.Hp > 0 and (self:Pos2(u.Entity) - center):Magnitude() <= radius then table.insert(out, u.Entity) end
        end
        return out
    end

    method any TerrainMemo(Entity map)
        -- 맵의 타일맵과 칸 계산값. 맵마다 한 번만 찾고, 칸별 막힘 결과를 계속 기억한다 (실행 중 타일을 바꾸는 코드는 없다).
        if not isvalid(map) then return nil end
        if self.TileMemo == nil then self.TileMemo = {} end
        local memo = self.TileMemo
        local m = memo[map.Id]
        if m ~= nil then
            if m.none then return nil end
            if isvalid(m.entity) then return m end
        end
        local tiles = map:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        if tiles == nil then
            memo[map.Id] = { none = true }
            return nil
        end
        -- ToWorldPosition은 칸 중심을 준다 (GroundPath에서 확인). 칸 = floor((좌표 - 0번 칸 중심) / 크기 + 0.5)
        local c0 = tiles:ToWorldPosition(0, 0)
        local grid = tiles.GridSize
        m = { tiles = tiles, entity = tiles.Entity, ox = c0.x, oy = c0.y, gx = grid.x, gy = grid.y, cells = {} }
        memo[map.Id] = m
        return m
    end

    method boolean CellBlocked(any m, Vector2 point)
        -- 그 지점의 칸이 없거나 충돌 타일이면 막힘. 엔진 조회는 칸마다 한 번만 (시야 판정 실측 0.1ms → 0.05ms).
        local x = math.floor((point.x - m.ox) / m.gx + 0.5)
        local y = math.floor((point.y - m.oy) / m.gy + 0.5)
        local key = x * 100000 + y
        local blocked = m.cells[key]
        if blocked == nil then
            local tile = m.tiles:GetTile(Vector2Int(x, y))
            blocked = tile == nil or tile.IsCollidable
            m.cells[key] = blocked
        end
        return blocked
    end

    method table ListOf(Entity map, string typeName)
        -- 맵 전체에서 그 종류의 컴포넌트 목록. 0.2초 동안 같은 목록을 돌려준다 (10-10 4차 QA: 몬스터 46마리·소환수가 초당 수백 번
        -- 맵 전체를 다시 뒤지며 표를 만들어 서버가 30~70ms씩 멈췄다). 사라진 개체가 섞일 수 있으니 쓰는 쪽에서 isvalid로 거른다
        if not isvalid(map) then return {} end
        if self.ListMemo == nil then self.ListMemo = {} end
        local key = map.Id .. "|" .. typeName
        local now = _UtilLogic.ElapsedSeconds
        local m = self.ListMemo[key]
        if m ~= nil and now - m.at < self.ListMemoSec then return m.list end
        local list = map:GetChildComponentsByTypeName(typeName, true)
        self.ListMemo[key] = { at = now, list = list }
        return list
    end

    method table MonstersNear(Entity map, Vector2 center, number radius)
        -- 살아 있는(보이는) 몬스터 중 반경 안, 가까운 순 (서버·클라이언트 공용)
        local found = {}
        if not isvalid(map) then return found end
        for _, c in ipairs(self:ListOf(map, "script.Monster")) do
            ---@type Monster
            local m = c
            if isvalid(c) and isvalid(c.Entity) and not m.IsDead and c.Entity.Enable then
                local q = c.Entity.TransformComponent.WorldPosition
                local d = (Vector2(q.x, q.y) - center):Magnitude()
                if d <= radius then table.insert(found, { m = m, d = d }) end
            end
        end
        table.sort(found, function(a, b) return a.d < b.d end)
        local list = {}
        for _, f in ipairs(found) do table.insert(list, f.m) end
        return list
    end

    method Monster MonsterInCone(Entity map, Vector2 origin, Vector2 dir, number range, number minCos)
        -- 바라보는 방향 부채꼴(dir과의 각 cos ≥ minCos) 안에서 가장 가까운 몬스터. 키보드·모바일 스킬 조준 보조
        if dir:Magnitude() < 0.01 then return nil end
        local d = dir:Normalize()
        for _, m in ipairs(self:MonstersNear(map, origin, range)) do
            local q = m.Entity.TransformComponent.WorldPosition
            local to = Vector2(q.x, q.y) - origin
            local len = to:Magnitude()
            if len < 0.3 or (to.x * d.x + to.y * d.y) / len >= minCos then return m end
        end
        return nil
    end

    method Monster NearestMonster(Entity map, Vector2 center, number radius)
        local list = self:MonstersNear(map, center, radius)
        return list[1]
    end

    method any NearestComponent(Entity map, string componentName, Vector2 center, number radius)
        -- 맵에서 componentName을 가진 엔티티 중 반경 안 가장 가까운 것의 컴포넌트 (없으면 nil)
        if not isvalid(map) then return nil end
        local best = nil
        local bestDist = radius
        for _, c in ipairs(map:GetChildComponentsByTypeName(componentName, true)) do
            local q = c.Entity.TransformComponent.WorldPosition
            local d = (Vector2(q.x, q.y) - center):Magnitude()
            if d <= bestDist then
                bestDist = d
                best = c
            end
        end
        return best
    end

    method boolean NearNpc(Entity player, string kind)
        -- 상점·의뢰 같은 NPC 기능은 그 NPC 대화 거리 안에서만 (서버 검증용)
        local map = player.CurrentMap
        if not isvalid(map) then return false end
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.WorldNPC", true)) do
            ---@type WorldNPC
            local npc = c
            if npc.Kind == kind and self:Distance(player, c.Entity) <= npc.TalkRange + 0.5 then return true end
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method boolean ShakeEnabled()
        -- 환경 설정 「화면 흔들림」: 기본은 PC 켬 · 모바일 끔 (모바일 멀미 — 10-28 F5 #12-A)
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return false end
        ---@type PlayerSave
        local save = me:GetComponent("script.PlayerSave")
        local v = save ~= nil and save.ScreenShake or -1
        if v == 0 then return false end
        if v == 1 then return true end
        return Environment:IsPCPlatform()
    end

    @ExecSpace("ClientOnly")
    method void SkillShake(Entity caster, number amount, number seconds)
        -- 내 스킬이 맞았을 때 내 화면만 흔든다 (파티원 스킬로는 흔들리지 않는다)
        if not isvalid(caster) or caster ~= _UserService.LocalPlayer or not self:ShakeEnabled() then return end
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then
            cam:ShakeCamera(amount, seconds)
            self.SkillShakeCount = self.SkillShakeCount + 1
        end
    end

    method boolean IsAlive(Entity player)
        -- 플레이어가 살아 있는가 (HP > 0 이고 사망 처리·부활 대기 중이 아님)
        if not isvalid(player) or player.PlayerComponent == nil then return false end
        local pc = player.PlayerComponent
        if pc.Hp <= 0 or pc:IsDead() then return false end
        ---@type PlayerVitals
        local vitals = player:GetComponent("script.PlayerVitals")
        return vitals == nil or not vitals.Dying
    end

    method Vector2 Pos2(Entity e)
        local p = e.TransformComponent.WorldPosition
        return Vector2(p.x, p.y)
    end

    method boolean TileBlocked(Entity terrain, Vector2 point)
        if not isvalid(terrain) then return false end
        local m = self:TerrainMemo(terrain.CurrentMap)
        if m ~= nil and m.entity == terrain then return self:CellBlocked(m, point) end
        local tiles = terrain.RectTileMapComponent
        local tile = tiles:GetTile(tiles:ToCellPosition(Vector3(point.x, point.y, 0)))
        return tile == nil or tile.IsCollidable
    end

    method void SetFlipX(Entity e, boolean value)
        -- 바뀔 때만 쓴다 (매 프레임 같은 값을 다시 쓰던 몬스터 이동 코드 — 10-13 3인 파티 끊김 점검)
        local r = isvalid(e) and e.SpriteRendererComponent or nil
        if isvalid(r) and r.FlipX ~= value then r.FlipX = value end
    end

    method Vector2 ReachablePoint(Entity map, Vector2 from, Vector2 to, number margin)
        -- from에서 to로 곧게 갈 때 벽에 닿기 전 마지막 자리 (몸 여유 margin만큼 상하좌우도 비어 있어야 한다).
        -- 순간이동·도약처럼 위치를 바로 쓰는 곳은 이걸 거친다 — 벽 너머로 넘어가거나 벽 속에 내려앉지 않게
        -- (10-13 사용자 지적: 굶주린 굴 우두머리 무덤 구더기가 도약 강타로 벽 속에 들어가 숨은 채 끼었다)
        local m = self:TerrainMemo(map)
        if m == nil then return to end
        local free = function(q)
            if self:CellBlocked(m, q) then return false end
            if margin <= 0 then return true end
            return not self:CellBlocked(m, q + Vector2(margin, 0)) and not self:CellBlocked(m, q - Vector2(margin, 0))
                and not self:CellBlocked(m, q + Vector2(0, margin)) and not self:CellBlocked(m, q - Vector2(0, margin))
        end
        local offset = to - from
        local count = math.max(1, math.ceil(offset:Magnitude() / 0.2))
        local last = from
        for i = 1, count do
            local q = from + offset * (i / count)
            if not free(q) then return last end
            last = q
        end
        return last
    end

    method any NearestFreePoint(Entity map, Vector2 p, number maxRadius)
        -- p가 벽 칸이면 가장 가까운 빈 칸 중심 (maxRadius칸 안, 없으면 nil). 벽이 아니면 p 그대로
        local m = self:TerrainMemo(map)
        if m == nil or not self:CellBlocked(m, p) then return p end
        local cx = math.floor((p.x - m.ox) / m.gx + 0.5)
        local cy = math.floor((p.y - m.oy) / m.gy + 0.5)
        local best, bestD = nil, 1e9
        for r = 1, math.max(1, math.floor(maxRadius)) do
            for dx = -r, r do
                for dy = -r, r do
                    if math.max(math.abs(dx), math.abs(dy)) == r then
                        local q = Vector2(m.ox + (cx + dx) * m.gx, m.oy + (cy + dy) * m.gy)
                        local d = (q - p):Magnitude()
                        if d < bestD and not self:CellBlocked(m, q) then best, bestD = q, d end
                    end
                end
            end
            if best ~= nil then return best end
        end
        return nil
    end

    method boolean HasLineOfSight(Entity map, Vector2 from, Vector2 to)
        if not isvalid(map) then return false end
        local m = self:TerrainMemo(map)
        if m == nil then return true end
        local offset = to - from
        local count = math.max(1, math.ceil(offset:Magnitude() / 0.2))
        for i = 1, count do
            if self:CellBlocked(m, from + offset * (i / count)) then return false end
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method integer GroundDecal(string ruid, number pxW, number pxH, Entity instigator, Vector3 center, number radius, Color tint)
        -- 바닥 장판 그림(스프라이트, 발밑 기준 피벗)을 반지름 radius 원을 덮게 늘여 깐다. 반복 재생 → 끝나면 _EffectService:RemoveEffect(serial)
        -- (코덱스 장판 그림 poison-ground 160×80 · fire-ground 140×70 등. 그림 높이는 지름의 pxH/pxW)
        local scale = (radius * 2) / (pxW / 100)
        local height = (pxH / 100) * scale
        return _EffectService:PlayEffect(ruid, instigator, center - Vector3(0, height * 0.5, 0), 0, Vector3(scale, scale, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = tint })   -- 바닥(0)과 몸(2) 사이: 몸을 덮지 않는다
    end

    method table TeleFrames(string list, string element)
        -- "phys=r0,r1,r2,r3;fire=…" 목록에서 속성 프레임 RUID 배열 (레이저 4프레임 · 모르는 속성·물리·마법은 phys)
        local key = (element == "fire" or element == "poison" or element == "cold" or element == "light") and element or "phys"
        return self:KeyFrames(list, key)
    end

    method table KeyFrames(string list, string key)
        -- "a=r0,r1,…;b=…" 목록에서 key 줄의 프레임 RUID 배열 (없으면 빈 표) — 레이저 속성(TeleFrames) · 습격 조짐 액트(a1~a4) 공용
        for k, v in string.gmatch(list, "(%w+)=([%w,]+)") do
            if k == key then
                local out = {}
                for r in string.gmatch(v, "%w+") do table.insert(out, r) end
                return out
            end
        end
        return {}
    end

    method string TeleSprite(string list, string element)
        -- "phys=ruid;fire=ruid…" 목록에서 속성 그림 (모르는 속성·물리·마법은 phys)
        local key = (element == "fire" or element == "poison" or element == "cold" or element == "light") and element or "phys"
        for k, v in string.gmatch(list, "(%w+)=(%w+)") do
            if k == key then return v end
        end
        return ""
    end

    @ExecSpace("ClientOnly")
    method integer Telegraph(Entity instigator, Vector2 center, number radius, string element, number seconds)
        -- 범위 예고 (10-21): 실선 원 대신 흐린 빛 테두리(판정 반경 그대로) + 가운데서 바깥으로 차오르는 원판 — 테두리까지 차면 터진다.
        -- 10-22: 보스(BossPattern)가 쓰면 실금 고리가 천천히 돈다 — 일반 몬스터의 흐린 고리와 한눈에 구분된다
        -- 속성 기술은 그 속성 바닥 그림을 테두리 안에 옅게 깐다. seconds 뒤(또는 StopTelegraph) 모두 지운다. 반환값 = 예고 id
        if not isvalid(instigator) or radius <= 0 then return 0 end
        local opt = function(order) return { SortingLayer = "MapLayer0", OrderInLayer = order } end
        local size = 2.56   -- 256px 그림 = 2.56칸
        local pos = Vector3(center.x, center.y, 0)
        local full = radius * 2 / size
        self.TelegraphSeq = self.TelegraphSeq + 1
        local id = self.TelegraphSeq
        local rec = { rim = 0, fill = 0, decal = 0, timer = 0 }
        self.Telegraphs[id] = rec
        -- 바닥(0)과 몬스터·플레이어(2) 사이 1 — 예고가 몸을 덮지 않는다
        local boss = instigator:GetComponent("script.BossPattern") ~= nil
        local rimRuid = self:TeleSprite(boss and _GameConst.SpriteTeleRimBoss or _GameConst.SpriteTeleRim, element)
        rec.rim = _EffectService:PlayEffect(rimRuid, instigator, pos, 0, Vector3(full, full, 1), true, opt(1))
        local ground = ""
        local gw, gh = 140, 70
        if element == "poison" then ground = _GameConst.SpriteGroundPoison gw, gh = 160, 80
        elseif element == "fire" then ground = _GameConst.SpriteGroundFire
        elseif element == "cold" then ground = _GameConst.SpriteGroundCold
        elseif element == "light" then ground = _GameConst.SpriteGroundLantern end
        if ground ~= "" then
            local gs = (radius * 0.85 * 2) / (gw / 100)
            rec.decal = _EffectService:PlayEffect(ground, instigator, pos - Vector3(0, (gh / 100) * gs * 0.5, 0), 0, Vector3(gs, gs, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(1, 1, 1, 0.55) })
        end
        local fillRuid = self:TeleSprite(_GameConst.SpriteTeleFill, element)
        local t = 0
        local step = 0.06
        local function grow()
            local k = 0.12 + 0.88 * math.min(1, t / math.max(0.1, seconds))
            local old = rec.fill
            rec.fill = _EffectService:PlayEffect(fillRuid, instigator, pos, 0, Vector3(full * k, full * k, 1), true, opt(1))
            if old ~= 0 then _EffectService:RemoveEffect(old) end
            if boss and t > 0 then
                local oldRim = rec.rim
                rec.rim = _EffectService:PlayEffect(rimRuid, instigator, pos, -t * self.BossRimSpin, Vector3(full, full, 1), true, opt(1))
                if oldRim ~= 0 then _EffectService:RemoveEffect(oldRim) end
            end
        end
        grow()
        rec.timer = _TimerService:SetTimerRepeat(function()
            t = t + step
            if t >= seconds or self.Telegraphs[id] == nil then
                self:StopTelegraph(id)
                return
            end
            grow()
        end, step)
        return id
    end

    @ExecSpace("ClientOnly")
    method integer TelegraphBand(Entity instigator, Vector2 a, Vector2 b, number width, string element, number seconds)
        -- 사각·선 예고 (10-28 보스 공용 패턴): a → b 띠(폭 width). 테두리 띠 + 가운데 줄에서 양옆으로 차오르는 띠 — 폭까지 차면 터진다.
        -- 64px 그림을 길이·폭으로 늘인다(그림은 가로 방향으로 고르다). StopTelegraph로 지운다. 반환값 = 예고 id
        if not isvalid(instigator) or width <= 0 then return 0 end
        local d = b - a
        local len = d:Magnitude()
        if len <= 0.01 then return 0 end
        local mid = Vector3((a.x + b.x) * 0.5, (a.y + b.y) * 0.5, 0)
        local rot = math.deg(math.atan(d.y, d.x))
        local sx, sy = len / 0.64, width / 0.64
        local opt = { SortingLayer = "MapLayer0", OrderInLayer = 1 }
        self.TelegraphSeq = self.TelegraphSeq + 1
        local id = self.TelegraphSeq
        local rec = { rim = 0, fill = 0, decal = 0, timer = 0 }
        self.Telegraphs[id] = rec
        rec.rim = _EffectService:PlayEffect(self:TeleSprite(_GameConst.SpriteBandRim, element), instigator, mid, rot, Vector3(sx, sy, 1), true, opt)
        local fillRuid = self:TeleSprite(_GameConst.SpriteBandFill, element)
        local t = 0
        local step = 0.06
        local function grow()
            local k = 0.12 + 0.88 * math.min(1, t / math.max(0.1, seconds))
            local old = rec.fill
            rec.fill = _EffectService:PlayEffect(fillRuid, instigator, mid, rot, Vector3(sx, sy * k, 1), true, opt)
            if old ~= 0 then _EffectService:RemoveEffect(old) end
        end
        grow()
        rec.timer = _TimerService:SetTimerRepeat(function()
            t = t + step
            if t >= seconds or self.Telegraphs[id] == nil then
                self:StopTelegraph(id)
                return
            end
            grow()
        end, step)
        return id
    end

    @ExecSpace("ClientOnly")
    method void BeamFx(Entity instigator, Vector2 a, Vector2 b, number width, string element, number seconds)
        -- 레이저 (10-28 보스 공용 패턴): a → b 흰 심 + 속성 빛 띠를 seconds 동안 4프레임(80ms)으로 일렁이게 그리고, 끝에 섬광 · 줄을 따라 불꽃을 튀긴다
        -- 10-28 밤 코덱스 정식 그림은 128×64 — 길이는 len / 1.28, 굵기는 64px 높이 기준 (예전 임시 64×64 그림은 len / 0.64)
        if not isvalid(instigator) then return end
        local d = b - a
        local len = d:Magnitude()
        if len <= 0.01 then return end
        local frames = self:TeleFrames(_GameConst.SpriteBeam, element)
        if #frames == 0 then return end
        local mid = Vector3((a.x + b.x) * 0.5, (a.y + b.y) * 0.5, 0)
        local rot = math.deg(math.atan(d.y, d.x))
        local opt = { SortingLayer = "MapLayer0", OrderInLayer = 6 }
        local scale = Vector3(len / 1.28, width * 1.25 / 0.64, 1)
        local serial = _EffectService:PlayEffect(frames[1], instigator, mid, rot, scale, true, opt)
        local fs = width * 1.7 / 0.96
        local flare = _EffectService:PlayEffect(self:TeleSprite(_GameConst.SpriteBeamFlare, element), instigator, Vector3(b.x, b.y, 0), 0, Vector3(fs, fs, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 7 })
        local n = math.max(2, math.floor(len / 1.4))
        for i = 0, n do
            local p = a + d * (i / n)
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, instigator, Vector3(p.x, p.y, 0), 0, Vector3(0.45, 0.45, 1), false, nil)
        end
        local tick = 0
        local timer = 0
        timer = _TimerService:SetTimerRepeat(function()
            tick = tick + 1
            local old = serial
            serial = _EffectService:PlayEffect(frames[tick % #frames + 1], instigator, mid, rot, scale, true, opt)
            if old ~= 0 then _EffectService:RemoveEffect(old) end
            if tick * 0.08 >= seconds then
                _TimerService:ClearTimer(timer)
                _EffectService:RemoveEffect(serial)
                if flare ~= 0 then _EffectService:RemoveEffect(flare) end
            end
        end, 0.08)
    end

    @ExecSpace("ClientOnly")
    method void ElementBurst(Entity instigator, Vector3 pos, number radius, string element, Color color)
        -- 범위 기술이 터지는 순간 (10-22): BigExplosion은 Color 옵션을 무시하고 늘 주황 불덩이라(메이커 실측) 화염·물리에만 쓴다.
        -- 냉기·독·번개는 색이 먹는 SparkExplosion + 옅은 Aura로 그 속성 색 그대로 터진다
        if element == "fire" or element == "" or element == "phys" then
            _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, instigator, pos, 0, Vector3(radius * 0.3, radius * 0.3, 1), false, nil)
            return
        end
        _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, instigator, pos, 0, Vector3(radius * 0.55, radius * 0.55, 1), false, { Color = color })
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, instigator, pos, 0, Vector3(radius * 0.8, radius * 0.8, 1), false, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(color.r, color.g, color.b, 0.55) })
    end

    @ExecSpace("ClientOnly")
    method integer ZoneRim(Entity instigator, Vector2 center, number radius, string element)
        -- 남아 있는 장판·안개의 범위 고리 (차오름 없음 · 반복 재생 → _EffectService:RemoveEffect). 보스면 실금 고리, 아니면 흐린 고리
        if not isvalid(instigator) or radius <= 0 then return 0 end
        local boss = instigator:GetComponent("script.BossPattern") ~= nil
        local full = radius * 2 / 2.56
        return _EffectService:PlayEffect(self:TeleSprite(boss and _GameConst.SpriteTeleRimBoss or _GameConst.SpriteTeleRim, element), instigator, Vector3(center.x, center.y, 0), 0, Vector3(full, full, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1 })
    end

    @ExecSpace("ClientOnly")
    method void StopTelegraph(integer id)
        -- 범위 예고 지우기 (공격이 끊기거나 시간이 다 됐을 때)
        local rec = self.Telegraphs[id]
        if rec == nil then return end
        self.Telegraphs[id] = nil
        if rec.timer ~= 0 then _TimerService:ClearTimer(rec.timer) end
        if rec.rim ~= 0 then _EffectService:RemoveEffect(rec.rim) end
        if rec.fill ~= 0 then _EffectService:RemoveEffect(rec.fill) end
        if rec.decal ~= nil and rec.decal ~= 0 then _EffectService:RemoveEffect(rec.decal) end
    end

    method table Frames(string ruids)
        -- 「|」로 이은 프레임 RUID → 목록
        local list = {}
        for r in string.gmatch(ruids, "[^|]+") do table.insert(list, r) end
        return list
    end

    method void PlayFrames(string ruids, Entity instigator, Vector3 pos, number rot, Vector3 scale, number frameSec, Color tint, integer order)
        -- 프레임 그림 여러 장을 한 번 재생한다 (클라이언트에서 부른다 · 액트 4 이펙트 등) — 모든 장이 frameSec씩 (마지막 장도 frameSec)
        --   10-31 갈래 E(audit A-2): 예전 SetTimerRepeat 판은 첫 호출이 바로 와 첫 장을 건너뛰었다((장 수 − 1) × 간격만 보임 · 메이커 10-30 S48-SPIN-PLAYBACK-01) → PlayFramesHold로
        self:PlayFramesHold(ruids, instigator, pos, rot, scale, frameSec, frameSec, 0, tint, order)
    end

    method table FramePlan(integer n, number frameSec, number holdSec, number fadeSec)
        -- 프레임 그림 한 번 재생 계획 (순수 계산 · tests/quality/skillfx_e.lua): 장 i(1..n)는 시작 + (i−1) × frameSec에 뜬다 —
        --   첫 장도 frameSec 동안 보이고 · 마지막 장은 max(frameSec, holdSec) 동안 잡고 · fadeSec > 0이면 그 뒤 FrameFadeSteps번 옅어지며(같은 장 · 투명도만) 사라진다.
        --   반환 { steps = { { at, idx, alpha } … }, holdAt = 마지막 장이 뜬 시각, clearAt = 다 지우는 시각 }
        local steps = {}
        local f = math.max(0.001, frameSec)
        local count = math.max(0, n)
        for i = 1, count do table.insert(steps, { at = (i - 1) * f, idx = i, alpha = 1 }) end
        local holdAt = math.max(0, count - 1) * f
        local clearAt = holdAt + math.max(f, holdSec)
        local k = self.FrameFadeSteps
        if count > 0 and fadeSec > 0 and k > 0 then
            for j = 1, k do table.insert(steps, { at = clearAt + fadeSec * (j - 1) / k, idx = count, alpha = 1 - j / (k + 1) }) end
            clearAt = clearAt + fadeSec
        end
        return { steps = steps, holdAt = holdAt, clearAt = clearAt }
    end

    method void PlayFramesHold(string ruids, Entity instigator, Vector3 pos, number rot, Vector3 scale, number frameSec, number holdSec, number fadeSec, Color tint, integer order)
        -- 프레임 그림 한 번 재생 + 마지막 장 잡기 + 옅어짐 (클라이언트에서 부른다 · 10-31 갈래 E). 계획은 FramePlan.
        --   장마다 SetTimerOnce · 다음 장 시각은 시작 시각 기준(타이머가 늦어도 밀림이 쌓이지 않음 · 장을 건너뛰지 않음) · 다음 장을 먼저 걸고 앞 장은 FrameSwapOverlap 뒤에 지운다.
        --   instigator가 사라지면 그 자리에서 지운다
        local list = self:Frames(ruids)
        if #list == 0 or not isvalid(instigator) then return end
        self:PlayFramesPlan(list, instigator, pos, rot, scale, self:FramePlan(#list, frameSec, holdSec, fadeSec), tint, order)
    end

    method table FramePlanMs(string ms, integer n, number holdSec, number fadeSec)
        -- 장별 지속(ms · 쉼표 · 코덱스 timing 제안)으로 한 번 재생 계획 (순수 계산 · 10-31 갈래 E2 뼈 창 꽂힘 60,60,70,70,70,70 = 400ms) — 모양은 FramePlan과 같다.
        --   장 수와 ms 개수가 다르면 첫 값(없으면 0.1초)을 고른 간격으로. 마지막 장은 max(그 장 지속, holdSec) · fadeSec 옅어짐
        local durs = {}
        for v in string.gmatch(ms or "", "[^,]+") do table.insert(durs, math.max(0.001, (tonumber(v) or 0) / 1000)) end
        local count = math.max(0, n)
        if #durs ~= count then
            local f = #durs > 0 and durs[1] or 0.1
            durs = {}
            for i = 1, count do durs[i] = f end
        end
        local steps = {}
        local at = 0
        for i = 1, count do
            table.insert(steps, { at = at, idx = i, alpha = 1 })
            if i < count then at = at + durs[i] end
        end
        local holdAt = at
        local clearAt = holdAt + math.max(count > 0 and durs[count] or 0, holdSec)
        local k = self.FrameFadeSteps
        if count > 0 and fadeSec > 0 and k > 0 then
            for j = 1, k do table.insert(steps, { at = clearAt + fadeSec * (j - 1) / k, idx = count, alpha = 1 - j / (k + 1) }) end
            clearAt = clearAt + fadeSec
        end
        return { steps = steps, holdAt = holdAt, clearAt = clearAt }
    end

    method void PlayFramesMs(string ruids, Entity instigator, Vector3 pos, number rot, Vector3 scale, string ms, number holdSec, number fadeSec, Color tint, integer order)
        -- 장별 지속(ms)으로 한 번 재생 (클라이언트에서 부른다 · 10-31 갈래 E2) — 재생 방식은 PlayFramesHold와 같다(PlayFramesPlan)
        local list = self:Frames(ruids)
        if #list == 0 or not isvalid(instigator) then return end
        self:PlayFramesPlan(list, instigator, pos, rot, scale, self:FramePlanMs(ms, #list, holdSec, fadeSec), tint, order)
    end

    method integer MsCount(string ms)
        -- 장별 ms 문자열(쉼표)의 값 개수 (10-31 통일 공정 5종 · 그 자리 장 수와 같을 때만 새 길 — 다르면 부르는 쪽이 예전 길)
        local n = 0
        for _ in string.gmatch(ms or "", "[^,]+") do n = n + 1 end
        return n
    end

    method number MsTailSec(string ms, integer k)
        -- 장별 ms 문자열의 마지막 k개 합(초) — 지속 효과 끝 잦아듦 길이 (10-31 통일 공정 5종)
        local durs = {}
        for v in string.gmatch(ms or "", "[^,]+") do table.insert(durs, math.max(0.001, (tonumber(v) or 0) / 1000)) end
        local s = 0
        for i = math.max(1, #durs - k + 1), #durs do s = s + durs[i] end
        return s
    end

    method table FramePlanLoopMs(string ms, integer n, integer releaseN, number loopSec, number fadeSec)
        -- 지속 효과 계획 (순수 계산 · 10-31 통일 공정 5종 원형 판·독안개): 앞 n − releaseN장을 장별 ms로 되풀이해 loopSec을 채우고(적어도 한 바퀴 · 장 단위) →
        --   잦아듦 releaseN장을 한 번 → 마지막 장 fadeSec 동안 FrameFadeSteps번 옅어짐(예전 「마지막 장 페이드」) · 모양은 FramePlan과 같다 { steps, holdAt, clearAt } + loopFrames
        --   ms 개수가 장 수와 다르거나 반복 장·잦아듦 장이 없으면 nil (부르는 쪽이 예전 길)
        local durs = {}
        for v in string.gmatch(ms or "", "[^,]+") do table.insert(durs, math.max(0.001, (tonumber(v) or 0) / 1000)) end
        local count = math.max(0, n)
        local rel = math.max(0, releaseN)
        local loopN = count - rel
        if count == 0 or #durs ~= count or loopN < 1 or rel < 1 then return nil end
        local steps = {}
        local at = 0
        local i = 0
        local goal = math.max(0, loopSec)
        while (i < loopN or at < goal - 0.0005) and i < 4000 do
            local idx = i % loopN + 1
            table.insert(steps, { at = at, idx = idx, alpha = 1 })
            at = at + durs[idx]
            i = i + 1
        end
        for j = loopN + 1, count do
            table.insert(steps, { at = at, idx = j, alpha = 1 })
            if j < count then at = at + durs[j] end
        end
        local holdAt = at
        local clearAt = holdAt + durs[count]
        local k = self.FrameFadeSteps
        if fadeSec > 0 and k > 0 then
            for j = 1, k do table.insert(steps, { at = clearAt + fadeSec * (j - 1) / k, idx = count, alpha = 1 - j / (k + 1) }) end
            clearAt = clearAt + fadeSec
        end
        return { steps = steps, holdAt = holdAt, clearAt = clearAt, loopFrames = i }
    end

    method void PlayFramesLoopMs(string ruids, Entity instigator, Vector3 pos, number rot, Vector3 scale, string ms, integer releaseN, number loopSec, number fadeSec, Color tint, integer order)
        -- 지속 효과 재생 (클라이언트에서 부른다 · 10-31 통일 공정 5종): 반복 장 → 잦아듦 releaseN장 → 마지막 장 옅어짐 (계획 FramePlanLoopMs · 재생 PlayFramesPlan — 장마다 SetTimerOnce · 시작 시각 기준)
        --   계획이 안 서면(ms 개수 ≠ 장 수) 예전 PlayFramesLoop(첫 값 간격 · loopSec)
        local list = self:Frames(ruids)
        if #list == 0 or not isvalid(instigator) then return end
        local plan = self:FramePlanLoopMs(ms, #list, releaseN, loopSec, fadeSec)
        if plan == nil then
            local first = tonumber(string.match(ms or "", "^%s*([%d%.]+)")) or 100
            self:PlayFramesLoop(ruids, instigator, pos, rot, scale, math.max(0.02, first / 1000), loopSec, tint, order)
            return
        end
        self:PlayFramesPlan(list, instigator, pos, rot, scale, plan, tint, order)
    end

    method void PlayFramesPlan(table list, Entity instigator, Vector3 pos, number rot, Vector3 scale, table plan, Color tint, integer order)
        -- 계획(FramePlan · FramePlanMs)대로 그린다: 장마다 SetTimerOnce · 시작 시각 기준 · 다음 장 먼저 걸고 앞 장은 FrameSwapOverlap 뒤에 지움 · instigator가 사라지면 지움
        local steps = plan.steps
        if #steps == 0 or not isvalid(instigator) then return end
        local t0 = _UtilLogic.ElapsedSeconds
        local serial = 0
        local overlap = self.FrameSwapOverlap
        local function drop(old)
            if old == 0 then return end
            if overlap > 0 then _TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(old) end, overlap)
            else _EffectService:RemoveEffect(old) end
        end
        local function show(st)
            local old = serial
            local c = Color(tint.r, tint.g, tint.b, tint.a * st.alpha)
            serial = _EffectService:PlayEffect(list[st.idx], instigator, pos, rot, scale, true, { SortingLayer = "MapLayer0", OrderInLayer = order, Color = c })
            drop(old)
        end
        local i = 1
        show(steps[1])
        local step = nil
        step = function()
            if not isvalid(instigator) then
                if serial ~= 0 then _EffectService:RemoveEffect(serial) serial = 0 end
                return
            end
            i = i + 1
            if i > #steps then
                if serial ~= 0 then _EffectService:RemoveEffect(serial) serial = 0 end
                return
            end
            show(steps[i])
            local due = i < #steps and steps[i + 1].at or plan.clearAt
            _TimerService:SetTimerOnce(step, math.max(0.01, t0 + due - _UtilLogic.ElapsedSeconds))
        end
        local first = #steps > 1 and steps[2].at or plan.clearAt
        _TimerService:SetTimerOnce(step, math.max(0.01, first))
    end

    method boolean SkillSlashFx(Entity instigator, Vector3 pos, number rot, number oldScale, boolean right, Color tint, string tag)
        -- 10-31 C 7종 중립 베기 (GameConst.FxSkillSlash · 무채색 4장 · 오른쪽 기준): 칸이 차면 한 번 그리고 true · 비면 false (부르는 쪽이 예전 메이플 FxSlash 그대로)
        --   크기 = 예전 클립 배율 × SlashArtPerOld (보이는 폭 같게) · 왼쪽(right false)은 가로 배율 음수(가로 거울 — 예전 그림은 왼쪽을 봐서 오른쪽일 때 FlipX) · rot은 예전과 같은 값 · 색은 부르는 쪽 Tint
        --   클라이언트에서 부른다 (Multicast 안) · 장 넘김은 PlayFramesMs (클라이언트 SetTimerOnce)
        local ruids = _GameConst.FxSkillSlash
        if ruids == "" or not isvalid(instigator) then return false end
        local s = oldScale * self.SlashArtPerOld
        local ms = math.max(20, _GameConst.FxSkillC7FrameMs)
        self:PlayFramesMs(ruids, instigator, pos, rot, Vector3(right and s or -s, s, 1), tostring(ms), 0, 0, tint, self.SlashArtOrder)
        if not self.SlashLogged[tag] and not Environment:IsPublishedPlay() then
            self.SlashLogged[tag] = true
            log(string.format("[VRF] c7 slash %s n=%d ms=%d scale=%.2f mirror=%s", tag, #self:Frames(ruids), ms, s, tostring(not right)))
        end
        return true
    end

    method void PlayFramesLoop(string ruids, Entity instigator, Vector3 pos, number rot, Vector3 scale, number frameSec, number seconds, Color tint, integer order)
        -- 프레임 그림을 seconds 동안 되풀이한다 (46-4 거인 회전 베기·저주 장판 · 클라이언트에서 부른다). 끝나거나 instigator가 사라지면 지운다
        --   10-31 갈래 E: PlayFramesHold와 같은 방식(첫 장 frameSec · 시작 시각 기준 SetTimerOnce · 다음 장 먼저 걸고 앞 장은 FrameSwapOverlap 뒤에)
        local list = self:Frames(ruids)
        if #list == 0 or not isvalid(instigator) then return end
        local f = math.max(0.001, frameSec)
        local total = math.max(f, seconds)
        local t0 = _UtilLogic.ElapsedSeconds
        local overlap = self.FrameSwapOverlap
        local k = 0
        local serial = _EffectService:PlayEffect(list[1], instigator, pos, rot, scale, true, { SortingLayer = "MapLayer0", OrderInLayer = order, Color = tint })
        local step = nil
        step = function()
            local old = serial
            serial = 0
            k = k + 1
            if k * f >= total - 0.001 or _UtilLogic.ElapsedSeconds - t0 >= total - 0.001 or not isvalid(instigator) then
                if old ~= 0 then _EffectService:RemoveEffect(old) end
                return
            end
            serial = _EffectService:PlayEffect(list[k % #list + 1], instigator, pos, rot, scale, true, { SortingLayer = "MapLayer0", OrderInLayer = order, Color = tint })
            if old ~= 0 then
                if overlap > 0 then _TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(old) end, overlap)
                else _EffectService:RemoveEffect(old) end
            end
            _TimerService:SetTimerOnce(step, math.max(0.01, t0 + math.min(total, (k + 1) * f) - _UtilLogic.ElapsedSeconds))
        end
        _TimerService:SetTimerOnce(step, math.min(f, total))
    end

end
