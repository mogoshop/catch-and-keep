-- 게임 전역 상수: 맵 이름, 모델 id, 공용 리소스 RUID, 난이도 규칙. 문자열을 코드 곳곳에 직접 쓰지 않고 여기서 꺼내 쓴다.
-- 콘텐츠 수치(아이템·스킬·몬스터·의뢰)는 data/*.csv → Data/Gen*.mlua 에 있다.
@Logic
script GameConst extends Logic

    -- 맵 (보통 난이도 이름. 악몽·지옥은 MapFor가 접미사를 붙인다)
    property string MapTown = "town"
    property string MapDepth = "depth"
    property string MapLobby = "map01"                -- 월드 시작 맵 = 정적 방의 로비 (캐릭터·게임 고르기). 나머지 맵은 모두 인스턴스 맵 (docs/design/30)
    property integer RoomMaxMembers = 4               -- 게임 방(공개·비공개) 최대 인원
    property number BossSkillMinRadius = 2.4          -- 보스 범위 기술(내려찍기·변종 기술) 최소 반경 — 일반 몬스터 범위 기술(2.0~2.2)보다 늘 크게 (10-22 사용자 C안)
    property string FinalBossSourceId = "ash_king"   -- 처치 시 다음 난이도 개방 (마지막 액트 = 액트 4 재의 왕, 10-20 · 이전: 바렌)
    property integer ActCount = 4                     -- 액트 수 (웨이포인트·의뢰 일지 탭, 액트 이동 · 10-20 액트 4 「심연의 문」)
    property string SoulThieves = ",hell_priest,"     -- 혼 빼앗기 (액트 4): 땅의 혼 구슬을 끌어가 먹는 몬스터 sourceId (SoulOrb.CheckThief)
    property string NoSoulSources = "|apostate_archbishop|shade_smith|shade_keeperdaughter|shade_deserter|"   -- 쓰러져도 혼이 나오지 않는다 (docs/design/31: 오렌의 혼은 조각이 문 아래로 끌고 갔다 · 그림자 인형은 주인에게 돌아간다)
    property string ShadeSources = "shade_smith,shade_keeperdaughter,shade_deserter"   -- 재의 왕이 불러내는 그림자 인형 (하르크 · 미라 · 엘리안, AshKingRite)

    -- 레벨 차이 보정 (디아블로식): 나보다 높은 몬스터는 덜 아프게 맞고, 더 아프게 때리고, 혼도 잘 안 뽑힌다
    property number LevelGapGrace = 1             -- 이 레벨 차이까지는 보정 없음
    property number LevelGapDmgPerLevel = 0.035   -- 그 위로 1레벨마다 내가 주는 피해 -3.5%
    property number LevelGapDmgFloor = 0.25       -- 아무리 높아도 최소 25%
    property number LevelGapTakenPerLevel = 0.015 -- 그 위로 1레벨마다 몬스터가 주는 피해 +1.5%
    property number LevelGapTakenCap = 0.45       -- 최대 +45%
    property number LevelGapExtractPerLevel = 0.03 -- 그 위로 1레벨마다 혼 추출 확률 ×(1-3%)
    property number LevelGapExtractFloor = 0.3    -- 최소 ×0.3
    property number ExpHighMonsterGrace = 5       -- 몬스터가 나보다 이만큼 넘게 높으면 경험치 ×(내 레벨+5)/몬스터 레벨

