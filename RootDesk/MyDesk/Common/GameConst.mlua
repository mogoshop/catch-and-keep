    -- 10-31 맵 v5 윗부분 반투명 (방안 B · DarkVision.TopFadeTick · docs/evidence/2026-10-31-map-v5-toppart/TOP-FADE.md): 내 아바타 발이 윗부분 그림(Art…Top · Default/5) 뒤에 있으면
    --   그 그림을 내 화면에서만 옅게 한다 — 발밑 이름표(엔진 순서 <5)까지 가려져 제단·간헐천 뒤에서 내 위치를 잃던 것(메이커 8차 △). 클라이언트 전용 · 서버 타이머 없음
    property boolean TopFadeOn = true          -- 끄면 판정 타이머를 만들지 않고 그림은 늘 불투명 (비활성 스위치)
    property number TopFadeAlpha = 0.35        -- 가릴 때 그림 알파 배율 (원래 색 알파 × 이 값)
    property number TopFadeSec = 0.15          -- 1 ↔ TopFadeAlpha 바뀌는 데 걸리는 시간(초)
    property number TopFadeTick = 0.1          -- 판정·보간 주기(초)
    property number TopFadeRange = 6           -- 그림에서 이 칸 수보다 멀면 검사 생략 (그림이 더 크면 그림 반 크기)
    property integer TopFadeMax = 30           -- 맵당 반투명 대상 상한 (표본 sanctum 17 · sulfurmarsh 7)
    property number TopFadeWidthFrac = 0.9     -- 판정 가로 폭 = 캔버스 폭 × 이 값 (캔버스 양옆 투명 여백을 조금 덜어 낸다)

    method string BaseMapName(string mapName)
        -- 난이도 맵 이름에서 접미사를 뗀다 (map01_nm → map01)
        for i = 1, 2 do
            local suffix = _GameData:GetDifficulty(i).suffix
            local n = string.len(suffix)
            if n > 0 and string.sub(mapName, -n) == suffix then return string.sub(mapName, 1, string.len(mapName) - n) end
        end
        return mapName
    end

    method number LevelGapDealt(integer attackerLevel, integer monsterLevel)
        -- 내(소환수는 주인) 레벨보다 높은 몬스터에게 주는 피해 배율 (1 이하)
        local over = monsterLevel - attackerLevel - self.LevelGapGrace
        if over <= 0 then return 1 end
        return math.max(self.LevelGapDmgFloor, 1 - self.LevelGapDmgPerLevel * over)
    end

    method number LevelGapTaken(integer monsterLevel, integer targetLevel)
        -- 나(소환수는 주인)보다 높은 몬스터가 주는 피해 배율 (1 이상)
        local over = monsterLevel - targetLevel - self.LevelGapGrace
        if over <= 0 then return 1 end
        return 1 + math.min(self.LevelGapTakenCap, self.LevelGapTakenPerLevel * over)
    end

    method number LevelGapExtract(integer playerLevel, integer monsterLevel)
        -- 나보다 높은 몬스터의 혼 추출 확률 배율
        local over = monsterLevel - playerLevel - self.LevelGapGrace
        if over <= 0 then return 1 end
        return math.max(self.LevelGapExtractFloor, 1 - self.LevelGapExtractPerLevel * over)
    end

    method integer LevelOf(Entity actor)
        -- 레벨 차이 판단용: 플레이어는 그 레벨, 소환수는 주인 레벨 (모르면 0 = 보정 없음)
        local owner = _Util:OwnerPlayerOf(actor)
        if not isvalid(owner) then return 0 end
        ---@type PlayerStats
        local stats = owner:GetComponent("script.PlayerStats")
        return stats ~= nil and stats.Level or 0
    end

    method any ShrineInfo(string kind)
        -- 맵 이벤트 신전 종류 (D2 신전): 이름 · 효과 문구 · 빛 색
        local t = {
            fury = { short = "분노", name = "분노의 신전", desc = "주는 피해 +25%", color = Color(1, 0.4, 0.3, 1) },
            ward = { short = "수호", name = "수호의 신전", desc = "받는 피해 -25%", color = Color(0.45, 0.65, 1, 1) },
            wisdom = { short = "지혜", name = "지혜의 신전", desc = "경험치 +30%", color = Color(1, 0.85, 0.35, 1) },
            soul = { short = "혼", name = "혼의 신전", desc = "혼 추출 확률 +15%p", color = Color(0.78, 0.5, 1, 1) },
            legion = { short = "군세", name = "군세의 신전", desc = "소환수 피해 +30%", color = Color(0.45, 1, 0.55, 1) },
            spring = { short = "샘", name = "샘의 신전", desc = "생명·마나 가득", color = Color(0.4, 1, 1, 1) },
        }
        return t[kind]
    end

    method string RandomShrineKind()
        local kinds = { "fury", "ward", "wisdom", "soul", "legion", "spring" }
        return kinds[_UtilLogic:RandomIntegerRange(1, #kinds)]
    end

    method string EventArt(string list, integer act)
        -- 맵 이벤트 장치 그림 목록("a1=값;a2=값…")에서 그 액트 값 (없거나 비면 "" — 부르는 쪽이 모델 기본 그림을 둔다)
        local want = "a" .. tostring(math.max(1, act))
        for k, v in string.gmatch(list, "(%w+)=([%w_]*)") do
            if k == want then return v end
        end
        return ""
    end

    method integer DifficultyOfMap(string mapName)
        -- 맵 이름 접미사로 난이도 (map01_nm → 1, _hell → 2, 없으면 0)
        for i = 1, 2 do
            local suffix = _GameData:GetDifficulty(i).suffix
            local n = string.len(suffix)
            if n > 0 and string.sub(mapName, -n) == suffix then return i end
        end
        return 0
    end

    method string LevelText(string text, string mapName)
        -- 이름 속 「(Lv a~b)」를 그 맵 난이도의 실제 레벨로 바꾼다 (ScaleLevel). 맵 데이터는 보통 기준이라서
        local diff = self:DifficultyOfMap(mapName)
        if diff <= 0 then return text end
        local out = string.gsub(text, "Lv%s*(%d+)%s*~%s*(%d+)", function(a, b) return "Lv " .. tostring(self:ScaleLevel(math.floor(tonumber(a)), diff)) .. "~" .. tostring(self:ScaleLevel(math.floor(tonumber(b)), diff)) end)
        if out == text then out = string.gsub(text, "Lv%s*(%d+)", function(a) return "Lv " .. tostring(self:ScaleLevel(math.floor(tonumber(a)), diff)) end) end
        return out
    end

    method integer ScaleLevel(integer level, integer difficulty)
        -- 보통 몬스터 레벨 → 그 난이도 레벨 (10-20 액트 4 결정 「구간 눌러 담기」, difficulty.csv levelFrom~levelTo).
        -- 보통 1~40을 악몽 41~70 · 지옥 71~99에 비율로 옮긴다. 보통 끝(40)을 넘는 값(심연 레벨대 끝)은 같은 기울기로 잇고 레벨 상한에서 멈춘다
        if difficulty <= 0 then return level end
        local normal = _GameData:GetDifficulty(0)
        local d = _GameData:GetDifficulty(difficulty)
        if d == nil or normal == nil then return level end
        local span = math.max(1, normal.levelTo - 1)
        local scaled = d.levelFrom + math.floor((level - 1) * (d.levelTo - d.levelFrom) / span + 0.5)
        return math.max(1, math.min(math.floor(_GameData.levelCap), scaled))
    end

    method string BeltIcon(string kind)
        -- 벨트 물건 종류 → ui_icons 키
        if kind == "hp" then return "potion_hp" end
        if kind == "mp" then return "potion_mp" end
        if kind == "rv" then return "potion_rv" end
        if kind == "tp" then return "icon_scroll" end
        return ""
    end

    method string BeltName(string kind)
        if kind == "hp" then return "생명 물약" end
        if kind == "mp" then return "마나 물약" end
        if kind == "rv" then return "회복 물약" end
        if kind == "tp" then return "귀환 두루마리" end
        return "빈 칸"
    end

    method Vector2 GetTownArrival()
        -- 마을 도착 위치 (config townArrivalX/Y — 맵 빌드의 마을 출구 포털과 같은 값)
        return Vector2(_GameData.townArrivalX, _GameData.townArrivalY)
    end

    method number EntrySafeRadius(string mapName)
        -- 입구·출구 둘레에 몬스터를 두지 않는 반경 (config entrySafeRadius — 작은 맵은 짧은 변 비율까지 줄인다)
        local r = _GameData.entrySafeRadius
        local info = _GameData:GetMapInfo(self:BaseMapName(mapName))
        if info ~= nil and info.w ~= nil and info.h ~= nil then
            r = math.min(r, math.max(_GameData.entrySafeMin, math.min(info.w, info.h) * _GameData.entrySafeMapFrac))
        end
        return r
    end

    method string MapFor(string baseMap, integer difficulty)
        -- 난이도별 맵 이름 = 보통 맵 + difficulty.csv mapSuffix (_nm / _hell)
        return baseMap .. _GameData:GetDifficulty(difficulty).suffix
    end

    method string DepthMapFor(integer floor, string nonce)
        -- 심도 층별 방 모양 (10-20 A안): 1층은 작은 방, 5층마다 보스 층은 넓은 마당 3종, 나머지는 9종에서 고른다.
        -- 도전 고유값(nonce)과 층으로 정해지므로 파티원이 따로 방을 열어도 같은 맵이 나온다. 바로 앞 두 층과 같은 모양은 피한다
        if floor <= 1 then return self.MapDepth end
        local bosses = { "depth3", "depth10", "depth11" }
        if floor % 5 == 0 then return bosses[self:DepthHash(nonce, floor) % #bosses + 1] end
        local pool = { self.MapDepth, "depth2", "depth4", "depth5", "depth6", "depth7", "depth8", "depth9", "depth12" }
        -- 바로 앞 두 층(보스 층 제외)과 겹치지 않게 다음 칸으로 민다
        local prev, prev2 = self.MapDepth, ""
        local pick = prev
        for f = 2, floor do
            if f % 5 ~= 0 then
                local i = self:DepthHash(nonce, f) % #pool + 1
                while pool[i] == prev or pool[i] == prev2 do i = i % #pool + 1 end
                pick = pool[i]
                prev2 = prev
                prev = pick
            end
        end
        return pick
    end

    method integer DepthHash(string nonce, integer floor)
        -- 문자열 → 0 이상 정수 (같은 입력이면 어느 서버에서도 같은 값)
        local h = 5381
        local text = (nonce or "") .. ":" .. tostring(floor)
        for i = 1, #text do h = (h * 33 + string.byte(text, i)) % 2147483647 end
        -- 끝 글자만 다른 입력(층 2·3·4…)이 연속된 값이 되지 않게 곱해 섞고 윗자리를 쓴다
        h = (h * 2654435761) % 4294967296
        return math.floor(h / 65536)
    end

    method integer DepthRunStart(string nonce)
        -- 심도 키 고유값 끝의 「~시작초」(DateTime.UtcNow 초) — 층을 옮겨도 같은 값이라 한 번의 도전 시간을 잰다. 없으면 0
        local s = string.match(nonce or "", "~(%d+)$")
        return s ~= nil and math.floor(tonumber(s)) or 0
    end

    method string MakeDepthKey(integer floor, integer difficulty, integer act, string nonce)
        -- 심도 인스턴스 룸 키 "depth:층:난이도:액트:고유값" (10-20: 심도는 액트별 — 액트마다 레벨대·몬스터가 다르다)
        return "depth:" .. tostring(floor) .. ":" .. tostring(difficulty) .. ":" .. tostring(act) .. ":" .. nonce
    end

    method table ParseDepthKey(string key)
        -- { floor, difficulty, act, nonce }. 심도 룸 키가 아니면 floor 0 (메이커는 다중 반환 선언을 등록하지 않는다)
        local parts = {}
        for p in string.gmatch(key, "[^:]+") do table.insert(parts, p) end
        local f = tonumber(parts[2] or "")
        local d = tonumber(parts[3] or "")
        local a = tonumber(parts[4] or "")
        if parts[1] ~= "depth" or #parts < 5 or f == nil or d == nil or a == nil then return { floor = 0, difficulty = 0, act = 1, nonce = "" } end
        return { floor = math.floor(f), difficulty = math.floor(d), act = math.floor(a), nonce = table.concat(parts, ":", 5) }
    end

    method boolean NoSoul(string sourceId)
        -- 혼 구슬을 남기지 않는 적 (ShadowSystem)
        return string.find(self.NoSoulSources, "|" .. sourceId .. "|", 1, true) ~= nil
    end

    method boolean IsShade(string sourceId)
        -- 재의 왕의 그림자 인형 (전리품 없음 · 쓰러지면 주인에게 돌아간다)
        return string.sub(sourceId, 1, 6) == "shade_"
    end

    method string ActBossSource(integer act)
        -- 액트 최종 보스 sourceId (심연 열쇠를 떨군다). 묘지기 여왕 · 대사제 · 제독
        local list = { "grave_queen", "high_priest", "admiral", "ash_king" }   -- 액트 4 재의 왕 (3단계에서 들어온다)
        return list[act] or ""
    end

    method integer ActOfBossSource(string sourceId)
        -- 액트 최종 보스면 그 액트, 아니면 0
        for act = 1, self.ActCount do
            if self:ActBossSource(act) == sourceId then return act end
        end
        return 0
    end

    method table DepthBand(integer act, integer difficulty)
        -- 심도 레벨대 { min, max } = 그 액트 보스 레벨 ~ +depthLevelSpan (+ 난이도 가산). 10-20: 깊이 내려가도 레벨이 액트를 앞지르지 않게
        local m = _GameData:GetMonsterStats(self:ActBossSource(act))
        local base = m ~= nil and m.level or 12
        local min = self:ScaleLevel(base, difficulty)
        return { min = min, max = math.min(math.floor(_GameData.levelCap), min + math.floor(_GameData.depthLevelSpan)) }
    end

    method table DepthBosses(integer act)
        -- 5층마다 보스 층에 번갈아 나오는 그 액트의 이름 있는 적 (본선 최종 보스는 의뢰와 얽혀 쓰지 않는다)
        if act == 2 then return { "serka", "tombking", "librarian" } end
        if act == 3 then return { "smugglerboss", "crabking", "drownedpriest", "madkeeper" } end
        if act == 4 then return { "sulfurqueen", "prisonwarden", "forgedemon", "apostate", "fallenknight" } end
        return { "headsman", "skelcaptain", "relickeeper" }
    end

    method string RoomKind()
        -- 지금 방 종류: "lobby"(정적 방) · "game"(게임 방 game:…) · "depth"(심연 depth:…) · "charsel"(옛 선택 방) · 그 밖 ""
        if not _RoomService:IsInstanceRoom() then return "lobby" end
        local key = _RoomService.RoomKey or ""
        local kind = string.match(key, "^(%a+):")
        return kind or ""
    end

    method boolean InGameRoom()
        return self:RoomKind() == "game"
    end

    method table GameRoomMaps(integer difficulty)
        -- 게임 방에 담는 맵: 그 난이도의 마을·사냥터·곁가지 전부 (심연·로비 제외)
        -- 손으로 지은 맵 시안(kind handmade, 10-28)은 메이커에서만 — 라이브 방에 실려 몬스터를 채우지 않게
        local list = {}
        local published = Environment:IsPublishedPlay()
        for id, info in pairs(_GameData.MapInfo) do
            if info.kind ~= "instance" and (info.kind ~= "handmade" or not published) then table.insert(list, self:MapFor(id, difficulty)) end
        end
        table.sort(list)
        return list
    end

    method boolean IsTown(Entity map)
        -- 액트마다 마을이 있다 (잿불 야영지 · 오아시스 시장) — maps.csv kind = town
        return isvalid(map) and self:IsTownName(map.Name)
    end

    method Color AuraColor(string effect)
        -- 오오라 계열 색 (아이콘이 없을 때 칩·소환수 칸의 색 원): 공격 붉은 · 속도 노랑 · 방어 하늘 · 회복 초록 · 약화 보라
        if effect == "dmg" or effect == "crit" or effect == "thorns" then return Color(1, 0.48, 0.4, 1) end
        if effect == "haste" or effect == "move" then return Color(1, 0.85, 0.35, 1) end
        if effect == "regen" then return Color(0.5, 0.95, 0.55, 1) end
        if effect == "corrode" then return Color(0.75, 0.45, 1, 1) end
        return Color(0.5, 0.83, 1, 1)
    end

    method string AuraHex(string effect)
        local c = self:AuraColor(effect)
        return string.format("#%02X%02X%02X", math.floor(c.r * 255), math.floor(c.g * 255), math.floor(c.b * 255))
    end

    method boolean IsTownName(string mapName)
        local info = _GameData:GetMapInfo(self:BaseMapName(mapName))
        return info ~= nil and info.kind == "town"
    end

    method integer ActOfMap(string mapName)
        -- 맵이 속한 액트 (maps.csv act, 없으면 1)
        local info = _GameData:GetMapInfo(self:BaseMapName(mapName))
        if info == nil or info.act == nil then return 1 end
        return math.floor(info.act)
    end

    method string TownOfAct(integer act)
        -- 그 액트의 마을 (보통 맵 이름). 없으면 액트 1 마을
        for id, info in pairs(_GameData.MapInfo) do
            if info.kind == "town" and math.floor(info.act or 1) == act then return id end
        end
        return self.MapTown
    end

    method string ActRegionName(integer act)
        -- 액트 지역 이름 (의뢰 일지 제목 등 · data/regions.csv와 같은 이름)
        if act == 2 then return "모래 폐허" end
        if act == 3 then return "폭풍 해안" end
        if act == 4 then return "심연의 땅" end
        return "무덤 왕국"
    end

    method string ActTownName(integer act)
        -- 화면 표시용 마을 이름 (잿불 야영지 / 오아시스 시장)
        local info = _GameData:GetMapInfo(self:TownOfAct(act))
        return info ~= nil and info.name or "마을"
    end

    method string WithRo(string word)
        -- 「~로 / ~으로」: 마지막 글자에 받침이 없거나 ㄹ 받침이면 로, 아니면 으로 (UTF-8 한글 음절만 판단)
        local n = string.len(word)
        if n < 3 then return word .. "로" end
        local b1, b2, b3 = string.byte(word, n - 2, n)
        local code = ((b1 & 0x0F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
        if code < 0xAC00 or code > 0xD7A3 then return word .. "로" end
        local jong = (code - 0xAC00) % 28
        if jong == 0 or jong == 8 then return word .. "로" end
        return word .. "으로"
    end

    method string DifficultyName(integer difficulty)
        return _GameData:GetDifficulty(difficulty).name
    end

    method integer ResistPenalty(integer difficulty)
        -- 저항 페널티 (difficulty.csv, 03장 5절: 보통 0 / 악몽 30 / 지옥 60 — D2 원작은 40 / 100)
        return math.floor(_GameData:GetDifficulty(difficulty).resistPenalty)
    end

    method number DeathExpLossPct(integer difficulty)
        -- 사망 시 경험치 손실 % (difficulty.csv, D2: 보통 0 / 악몽 5 / 지옥 10)
        return _GameData:GetDifficulty(difficulty).deathExpLossPct
    end

end
