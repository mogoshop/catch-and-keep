-- 게임 전역 상수: 맵 이름, 모델 id, 공용 리소스 RUID, 난이도 규칙. 문자열을 코드 곳곳에 직접 쓰지 않고 여기서 꺼내 쓴다.
-- 콘텐츠 수치(아이템·스킬·몬스터·의뢰)는 data/*.csv → Data/Gen*.mlua 에 있다.
@Logic
script GameConst extends Logic

    -- 맵 (보통 난이도 이름. 악몽·지옥은 MapFor가 접미사를 붙인다)
    property string MapTown = "town"
    property string MapDepth = "depth"
    property string FinalBossSourceId = "grave_queen"   -- 처치 시 다음 난이도 개방 (현재 영역 1까지)

    -- 레벨 차이 보정 (디아블로식): 나보다 높은 몬스터는 덜 아프게 맞고, 더 아프게 때리고, 혼도 잘 안 뽑힌다
    property number LevelGapGrace = 1             -- 이 레벨 차이까지는 보정 없음
    property number LevelGapDmgPerLevel = 0.035   -- 그 위로 1레벨마다 내가 주는 피해 -3.5%
    property number LevelGapDmgFloor = 0.25       -- 아무리 높아도 최소 25%
    property number LevelGapTakenPerLevel = 0.015 -- 그 위로 1레벨마다 몬스터가 주는 피해 +1.5%
    property number LevelGapTakenCap = 0.45       -- 최대 +45%
    property number LevelGapExtractPerLevel = 0.03 -- 그 위로 1레벨마다 혼 추출 확률 ×(1-3%)
    property number LevelGapExtractFloor = 0.3    -- 최소 ×0.3
    property number ExpHighMonsterGrace = 5       -- 몬스터가 나보다 이만큼 넘게 높으면 경험치 ×(내 레벨+5)/몬스터 레벨

    -- 런타임 스폰 모델 id
    property string ModelShadowUnit = "shadowunit"
    property string ModelSoulOrb = "soulorb"
    property string ModelProjectile = "projectile"
    property string StarterLamp = "lamp1|1|1|망자를 부르는 등불|minion=20|2|"   -- 새 캐릭터 시작 장비 (소환수 공격·생명 +20%)
    property string SpriteArrow = "bdf149709f8e4f998295898db054f51d"   -- 몬스터 화살 (오른쪽을 본다)
    property string ModelLootDrop = "lootdrop"
    property string ModelCorpse = "playercorpse"
    property string ModelWarpGate = "warpgate"
    property string ModelDepthGate = "depthgate"

    -- 전리품 아이콘
    property string IconGold = "94b7d89e2f514e269e04250dd4b7d989"
    property string IconHpPotion = "234aca1a4ce946119b68e3717991e775"
    property string IconMpPotion = "7e9b39b73f4945b1a8d77db6c99a6946"
    property string IconItem = "b72a08a78ebd4a3ea633e4d7b18f67e8"
    property string IconRune = "68219a8c8c1c4a43b2311c88d4a76204"

    -- 효과음
    property string SfxHit = "4b2b7c555a8c47ec8c80b626067dba84"
    property string SfxDeath = "5c83e3feda2642d9a795d4f596fd065e"
    property string SfxSwing = "410c41f38b3a434ba64c71b48f711bf4"     -- 휘두르기 (빗나가도)
    property string SfxImpact = "54dd4e4d322649059ac7debea505b143"    -- 맞았을 때만
    -- 타격 이펙트 (animationclip)
    property string FxHit = "1ce3b9be19764a70a6229665e15adf42"        -- 맞은 자리 불꽃
    property string FxSlash = "34cee7428d694e3a91e8a4aca8dd04ac"      -- 기본 공격 궤적
    property string FxDeath = "459a24129e144e469ba2dfe958fcec3c"      -- 쓰러질 때 연기
    property string SfxTeleport = "01423d14bbdb47ccadc47a63282cdf7c"
    property string SfxLevelUp = "401ca227c0c844569422a53bd21ab647"
    property string SfxWind = "960d62d9bf614fac842b243a95748988"
    property string SfxCrow = "5b585718c91c4253ac860d1c76c19ab2"
    property string SfxSoul = "07ad8b1cf0b84b4384582a8b59f33e8f"       -- 혼 추출·흡수 (1.15초)
    property string SfxSummon = "13c63fa45ad543c8889003b5b9bc7a63"     -- 소환 성공의 낮은 파동 (1.04초)
    property string SfxCurse = "9fc0a82bbf62442daa37294f6d873f2b"      -- 저주 적용 (1.04초)
    property string SfxTreasure = "d266ab4070b044488f153d43255475c8"   -- 희귀 전리품 획득 (1.36초)

    method string BaseMapName(string mapName)
        -- 난이도 맵 이름에서 접미사를 뗀다 (map01_nm → map01)
        for i = 1, 2 do
            local suffix = _GameData:GetDifficulty(i).suffix
            local n = string.len(suffix)
            if n > 0 and string.sub(mapName, -n) == suffix then return string.sub(mapName, 1, string.len(mapName) - n) end
        end
        return mapName
    end

    method number LevelGapDealt(integer attackerLevel, integer monsterLevel)
        -- 내(소환수는 주인) 레벨보다 높은 몬스터에게 주는 피해 배율 (1 이하)
        local over = monsterLevel - attackerLevel - self.LevelGapGrace
        if over <= 0 then return 1 end
        return math.max(self.LevelGapDmgFloor, 1 - self.LevelGapDmgPerLevel * over)
    end

    method number LevelGapTaken(integer monsterLevel, integer targetLevel)
        -- 나(소환수는 주인)보다 높은 몬스터가 주는 피해 배율 (1 이상)
        local over = monsterLevel - targetLevel - self.LevelGapGrace
        if over <= 0 then return 1 end
        return 1 + math.min(self.LevelGapTakenCap, self.LevelGapTakenPerLevel * over)
    end

    method number LevelGapExtract(integer playerLevel, integer monsterLevel)
        -- 나보다 높은 몬스터의 혼 추출 확률 배율
        local over = monsterLevel - playerLevel - self.LevelGapGrace
        if over <= 0 then return 1 end
        return math.max(self.LevelGapExtractFloor, 1 - self.LevelGapExtractPerLevel * over)
    end

    method integer LevelOf(Entity actor)
        -- 레벨 차이 판단용: 플레이어는 그 레벨, 소환수는 주인 레벨 (모르면 0 = 보정 없음)
        local owner = _Util:OwnerPlayerOf(actor)
        if not isvalid(owner) then return 0 end
        ---@type PlayerStats
        local stats = owner:GetComponent("script.PlayerStats")
        return stats ~= nil and stats.Level or 0
    end

    method any ShrineInfo(string kind)
        -- 맵 이벤트 신전 종류 (D2 신전): 이름 · 효과 문구 · 빛 색
        local t = {
            fury = { name = "분노의 신전", desc = "주는 피해 +25%", color = Color(1, 0.4, 0.3, 1) },
            ward = { name = "수호의 신전", desc = "받는 피해 -25%", color = Color(0.45, 0.65, 1, 1) },
            wisdom = { name = "지혜의 신전", desc = "경험치 +30%", color = Color(1, 0.85, 0.35, 1) },
            soul = { name = "혼의 신전", desc = "혼 추출 확률 +15%p", color = Color(0.78, 0.5, 1, 1) },
            legion = { name = "군세의 신전", desc = "소환수 피해 +30%", color = Color(0.45, 1, 0.55, 1) },
            spring = { name = "샘의 신전", desc = "생명·마나 가득", color = Color(0.4, 1, 1, 1) },
        }
        return t[kind]
    end

    method string RandomShrineKind()
        local kinds = { "fury", "ward", "wisdom", "soul", "legion", "spring" }
        return kinds[_UtilLogic:RandomIntegerRange(1, #kinds)]
    end

    method integer DifficultyOfMap(string mapName)
        -- 맵 이름 접미사로 난이도 (map01_nm → 1, _hell → 2, 없으면 0)
        for i = 1, 2 do
            local suffix = _GameData:GetDifficulty(i).suffix
            local n = string.len(suffix)
            if n > 0 and string.sub(mapName, -n) == suffix then return i end
        end
        return 0
    end

    method string LevelText(string text, string mapName)
        -- 이름 속 「(Lv a~b)」를 그 맵 난이도의 실제 레벨로 바꾼다 (difficulty.csv levelBonus — 지금 악몽 +15 · 지옥 +30). 맵 데이터는 보통 기준이라서
        local bonus = _GameData:GetDifficulty(self:DifficultyOfMap(mapName)).levelBonus
        if bonus == nil or bonus <= 0 then return text end
        local out = string.gsub(text, "Lv%s*(%d+)%s*~%s*(%d+)", function(a, b) return "Lv " .. tostring(tonumber(a) + bonus) .. "~" .. tostring(tonumber(b) + bonus) end)
        if out == text then out = string.gsub(text, "Lv%s*(%d+)", function(a) return "Lv " .. tostring(tonumber(a) + bonus) end) end
        return out
    end

    method string BeltIcon(string kind)
        -- 벨트 물건 종류 → ui_icons 키
        if kind == "hp" then return "potion_hp" end
        if kind == "mp" then return "potion_mp" end
        if kind == "rv" then return "potion_rv" end
        if kind == "tp" then return "icon_scroll" end
        return ""
    end

    method string BeltName(string kind)
        if kind == "hp" then return "생명 물약" end
        if kind == "mp" then return "마나 물약" end
        if kind == "rv" then return "회복 물약" end
        if kind == "tp" then return "귀환 두루마리" end
        return "빈 칸"
    end

    method Vector2 GetTownArrival()
        -- 마을 도착 위치 (config townArrivalX/Y — 맵 빌드의 마을 출구 포털과 같은 값)
        return Vector2(_GameData.townArrivalX, _GameData.townArrivalY)
    end

    method string MapFor(string baseMap, integer difficulty)
        -- 난이도별 맵 이름 = 보통 맵 + difficulty.csv mapSuffix (_nm / _hell)
        return baseMap .. _GameData:GetDifficulty(difficulty).suffix
    end

    method string MakeDepthKey(integer floor, integer difficulty, string nonce)
        -- 심도 인스턴스 룸 키 "depth:층:난이도:고유값"
        return "depth:" .. tostring(floor) .. ":" .. tostring(difficulty) .. ":" .. nonce
    end

    method table ParseDepthKey(string key)
        -- { floor, difficulty, nonce }. 심도 룸 키가 아니면 floor 0 (메이커는 다중 반환 선언을 등록하지 않는다)
        local parts = {}
        for p in string.gmatch(key, "[^:]+") do table.insert(parts, p) end
        local f = tonumber(parts[2] or "")
        local d = tonumber(parts[3] or "")
        if parts[1] ~= "depth" or #parts < 4 or f == nil or d == nil then return { floor = 0, difficulty = 0, nonce = "" } end
        return { floor = math.floor(f), difficulty = math.floor(d), nonce = table.concat(parts, ":", 4) }
    end

    method boolean IsTown(Entity map)
        -- 액트마다 마을이 있다 (잿불 야영지 · 오아시스 시장) — maps.csv kind = town
        return isvalid(map) and self:IsTownName(map.Name)
    end

    method boolean IsTownName(string mapName)
        local info = _GameData:GetMapInfo(self:BaseMapName(mapName))
        return info ~= nil and info.kind == "town"
    end

    method integer ActOfMap(string mapName)
        -- 맵이 속한 액트 (maps.csv act, 없으면 1)
        local info = _GameData:GetMapInfo(self:BaseMapName(mapName))
        if info == nil or info.act == nil then return 1 end
        return math.floor(info.act)
    end

    method string TownOfAct(integer act)
        -- 그 액트의 마을 (보통 맵 이름). 없으면 액트 1 마을
        for id, info in pairs(_GameData.MapInfo) do
            if info.kind == "town" and math.floor(info.act or 1) == act then return id end
        end
        return self.MapTown
    end

    method string ActTownName(integer act)
        -- 화면 표시용 마을 이름 (잿불 야영지 / 오아시스 시장)
        local info = _GameData:GetMapInfo(self:TownOfAct(act))
        return info ~= nil and info.name or "마을"
    end

    method string WithRo(string word)
        -- 「~로 / ~으로」: 마지막 글자에 받침이 없거나 ㄹ 받침이면 로, 아니면 으로 (UTF-8 한글 음절만 판단)
        local n = string.len(word)
        if n < 3 then return word .. "로" end
        local b1, b2, b3 = string.byte(word, n - 2, n)
        local code = ((b1 & 0x0F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
        if code < 0xAC00 or code > 0xD7A3 then return word .. "로" end
        local jong = (code - 0xAC00) % 28
        if jong == 0 or jong == 8 then return word .. "로" end
        return word .. "으로"
    end

    method string DifficultyName(integer difficulty)
        return _GameData:GetDifficulty(difficulty).name
    end

    method integer ResistPenalty(integer difficulty)
        -- 저항 페널티 (difficulty.csv, 03장 5절: 보통 0 / 악몽 30 / 지옥 60 — D2 원작은 40 / 100)
        return math.floor(_GameData:GetDifficulty(difficulty).resistPenalty)
    end

    method number DeathExpLossPct(integer difficulty)
        -- 사망 시 경험치 손실 % (difficulty.csv, D2: 보통 0 / 악몽 5 / 지옥 10)
        return _GameData:GetDifficulty(difficulty).deathExpLossPct
    end

end
