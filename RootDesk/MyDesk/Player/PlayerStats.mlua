-- 캐릭터 능력치: 경험치·레벨·4대 능력치·마나·골드·난이도, 장비 추가치(속성 포함), 이동 속도. 서버 권위.
-- 곡선·상한 수치는 data/config.csv → _GameData. 공식 근거: docs/design/03-core-rules-and-combat.md
@Component
script PlayerStats extends Component

    @Sync
    @TargetUserSync
    property integer KillStreak = 0          -- 연쇄 처치 수 (막타 주인 기준 · streakWindowSec 안에 이어지면 · 10-28 F2 #14-B)
    property number StreakLastAt = 0
    property number StreakExp = 0            -- 이번 연쇄에서 번 처치 경험치 (끝날 때 보너스 %의 바탕)
    property string ShrineKind = ""          -- 신전 축복 (MapShrine): fury · ward · wisdom · soul · legion
    @Sync
    property number ShrineUntil = 0          -- 축복이 끝나는 서버 시각 (ServerElapsedSeconds)
    @Sync
    property number PotionCurseUntil = 0     -- 모래 미라 저주: 이 서버 시각까지 물약 회복 -30% (버프 줄 표시용 동기화)
    @Sync
    property integer Level = 1
    @Sync
    property integer Exp = 0
    @Sync
    property integer ExpToNext = 100
    @Sync
    property integer Str = 15
    @Sync
    property integer Dex = 25
    @Sync
    property integer Vit = 15
    @Sync
    property integer Ene = 25
    @Sync
    property integer StatPoints = 0
    @Sync
    property integer SkillPoints = 1
    property table AuraVals = {}               -- 받은 그림자 오오라 효과 → 효과량 (10-24 사용자: 플레이어에게도 · 서버 값)
    property number AuraUntil = 0
    @Sync
    property integer CorrodeAmount = 0         -- 부식 오오라로 깎인 모든 저항 (CorrodeUntil까지 · 서버 시각)
    @Sync
    property number CorrodeUntil = 0
    @Sync
    property number Mana = 25
    @Sync
    property number MaxMana = 25
    @Sync
    property integer Gold = 0
    @Sync
    property integer Difficulty = 0          -- 0 보통 / 1 악몽 / 2 지옥
    @Sync
    property integer MaxDifficulty = 0       -- 개방된 최고 난이도

    -- 장비 추가치 (ApplyEquipmentMods가 갱신, 능력치 창 표시용으로 동기화)
    @Sync
    property number BonusLife = 0
    @Sync
    property number BonusMana = 0
    @Sync
    property number BonusDamage = 0
    @Sync
    property number BonusDamagePct = 0
    @Sync
    property number BonusDefense = 0
    @Sync
    property integer BonusStr = 0
    @Sync
    property integer BonusDex = 0
    @Sync
    property integer BonusVit = 0
    @Sync
    property integer BonusEne = 0
    @Sync
    property number BonusMinionPct = 0
    @Sync
    property number BonusExtractPct = 0
    @Sync
    property number BonusMF = 0
    @Sync
    property number BonusGF = 0
    @Sync
    property number BonusRegen = 0
    @Sync
    property integer BonusDeploy = 0         -- 배치 한도 (룬워드, 합산 최대 +2)
    property string FirstKills = ""         -- 보스·최상위 첫 처치 기록 (예전 첫 처치 확정 보상용 — 10-13에 보상은 없앴고 저장 호환으로만 남김)
    @Sync
    property integer BonusShadowCap = 0      -- 그림자 절대 상한 + (세트 완성 효과, 최대 shadowCapBonusMax)
    @Sync
    property number BonusLeech = 0           -- 생명력 흡수 %
    @Sync
    property number BonusMs = 0              -- 이동 속도 % (신발)
    @Sync
    property number BonusIas = 0             -- 공격 속도 % (장갑·무기)
    @Sync
    property number BonusFcr = 0             -- 시전 속도 % (반지·목걸이)
    @Sync
    property number BonusCurse = 0           -- 저주 범위 %
    @Sync
    property number BonusMinionPoison = 0    -- 소환수 공격에 독 (초당)
    @Sync
    property integer BonusAllSkills = 0      -- 배운 모든 스킬 레벨 +N (유니크 고유 효과, 최대 2 · docs/design/19)
    @Sync
    property integer BonusTreeCommand = 0    -- 소환 계열 메인 스킬 레벨 +N (최대 3)
    @Sync
    property integer BonusTreeSoul = 0       -- 영혼 계열 메인 스킬 레벨 +N (최대 3)
    @Sync
    property integer BonusTreeCurse = 0      -- 저주 계열 메인 스킬 레벨 +N (최대 3)
    @Sync
    property string BonusSkillLv = ""        -- 단일 스킬 레벨 "bone_spear=2,raise_skeleton=1" (스킬마다 최대 3)
    @Sync
    property number BonusSpellDmg = 0        -- 영혼 스킬 피해 %
    @Sync
    property number BonusCurseDur = 0        -- 저주 지속 %
    @Sync
    property number BonusCurseEff = 0        -- 수치형 저주 효과 %
    @Sync
    property number BonusMinionIas = 0       -- 소환수 공격 속도 %
    @Sync
    property number BonusMinionRes = 0       -- 소환수 모든 저항 %
    @Sync
    property string ElemDamage = ""          -- 무기 속성 피해 "fire=6,cold=4"
    @Sync
    property integer ResFire = 0
    @Sync
    property integer ResCold = 0
    @Sync
    property integer ResLight = 0
    @Sync
    property integer ResPoison = 0

    property table RawResists = {}           -- 장비 저항 합 (난이도 바뀌면 다시 계산)
    property number BaseSpeed = 0
    @Sync
    property number BoneArmor = 0            -- 뼈 갑옷 남은 흡수량 (docs/design/16, 버프 줄 표시)
    @Sync
    property number BoneArmorMax = 0
    @Sync
    property number ChillUntil = 0           -- 냉기 둔화가 끝나는 서버 시각 (버프 줄 표시용 동기화)
    property number StaggerUntil = 0         -- 거구 몬스터 강타에 휘청임 (이동 ×0.5, 짧다)
    @Sync
    property number HuntUntil = 0            -- 강화 「사냥꾼의 걸음」: 처치 뒤 이동 속도가 오르는 서버 시각 (버프 줄 표시용 동기화)
    @Sync
    property number AfterStepUntil = 0       -- 강화 「잔걸음」(44 결정 4): 질주 뒤 이동 속도가 오르는 서버 시각 (버프 줄 표시용 동기화)
    @Sync
    property number AfterStepPct = 0
    property number ArmorSoaked = 0          -- 강화 「터지는 갑옷」: 지금 뼈 갑옷이 막은 피해 합 (다 깨질 때 터뜨리고 0 · 새로 두르면 0)
    property integer ArmorRingSerial = 0     -- 클라이언트: 뼈 갑옷 몸 고리 입자 (44 §4-1 B — 남은 흡수량만큼 진하게)
    property integer ArmorRingStep = 0       -- 클라이언트: 지금 그린 고리 단계 (0 = 없음 · 1~4)
    -- 10-31 실플레이 갈래 E (audit P15 「뼈방패가 충격적」): 값만 되돌리면 예전 그대로
    property number ArmorRingAlphaMin = 0.55  -- 몸 고리 투명도: 거의 깨짐(1단계) (예전 0.30 — 사실상 안 보였다)
    property number ArmorRingAlphaMax = 0.85  -- 가득(4단계) (예전 0.75)
    property Color ArmorRingColor = Color(1, 0.98, 0.9, 1)   -- 뼈 흰빛 (예전 상아 0.93,0.87,0.72 — 창백한 피부·회백 망토와 같은 톤)
    property boolean ArmorRingLive = true     -- 고리를 몸에 붙인 입자 엔티티(BasicParticleComponent)로 — 단계가 바뀌어도 다시 틀지 않고 색(투명도)만 바꾼다 · 안 뿜으면 아래 예전 입자로
    property Entity ArmorRingEntity = nil     -- 클라이언트: 그 엔티티
    property number ArmorRingCheckSec = 0.3   -- 만든 뒤 이 시간에 실제로 뿜는지(IsEmitting) 확인
    property number ArmorRingOverlap = 0.5    -- 예전 입자 경로: 새 고리를 먼저 틀고 앞 고리는 이만큼 뒤에 지운다 (지우고 다시 틀면 반짝이가 끊겼다)
    -- 결투 상대의 저주·속박·독 (10-23 결투 군단전). 지속은 몬스터에게 거는 것의 절반 (SkillEffects가 줄여서 넘긴다)
    property number PvpAmpPct = 0            -- 약화의 낙인: 결투 상대에게 받는 피해 +%
    property number PvpAmpUntil = 0
    property number PvpWeakenPct = 0         -- 쇠약: 주는 피해 −%
    property number PvpWeakenUntil = 0
    property number PvpDecayPct = 0          -- 쇠퇴: 이동·주는 피해 −%
    property number PvpDecayUntil = 0
    property number RootUntil = 0            -- 뼈 감옥: 이동 불가
    property number PvpPoisonUntil = 0
    property integer PvpPoisonTimer = 0
    @Sync
    property number ShockUntil = 0           -- 번개 연쇄에 맞은 표시가 끝나는 서버 시각 (버프 줄 「감전」 칩, 표시만)
    property integer RegenTimer = 0
    property number RegenCarry = 0           -- 생명 재생의 1 미만 나머지

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self.RawResists = { fire = 0, cold = 0, light = 0, poison = 0 }
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then self.BaseSpeed = movement.InputSpeed * _GameData.playerSpeedMul end
        self.ExpToNext = self:CalcExpToNext(self.Level)
        self:Recalculate(true)
        self.RegenTimer = _TimerService:SetTimerRepeat(function() self:Regen() end, 1)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.RegenTimer ~= 0 then _TimerService:ClearTimer(self.RegenTimer) end
    end

    -- ───────── 경험치·레벨 ─────────

    method integer CalcExpToNext(integer level)
        -- expToNext(n) = round(coef × n^exp)
        return math.floor(_GameData.expCurveCoef * (level ^ _GameData.expCurveExp) + 0.5)
    end

    @ExecSpace("ServerOnly")
    method void GainExp(integer amount)
        -- 여러 단계 레벨업 가능: 레벨마다 능력치·스킬 포인트, 생명·마나 회복
        local cap = math.floor(_GameData.levelCap)
        if self.Level >= cap or amount <= 0 then return end
        self.Exp = self.Exp + amount
        local leveled = false
        while self.Exp >= self.ExpToNext and self.Level < cap do
            self.Exp = self.Exp - self.ExpToNext
            self.Level = self.Level + 1
            self.StatPoints = self.StatPoints + math.floor(_GameData.statPerLevel)
            self.SkillPoints = self.SkillPoints + math.floor(_GameData.skillPerLevel)
            self.ExpToNext = self:CalcExpToNext(self.Level)
            leveled = true
        end
        if leveled then
            self:Recalculate(true)
            -- 주인 레벨까지 힘을 내는 그림자(본래 레벨이 더 높은 그림자)는 레벨업과 함께 강해진다
            ---@type ShadowCommander
            local commander = self.Entity:GetComponent("script.ShadowCommander")
            if commander ~= nil then commander:RefreshAllUnitStats() end
            self:NotifyLevelUp(self.Level, self.Entity.PlayerComponent.UserId)
            self:LevelUpPillar(self.Entity.CurrentMap.Id)   -- 빛기둥은 같은 맵의 모두에게 (10-28 F2 #16-A)
            _GameEvents:Emit("LevelUp", { player = self.Entity, level = self.Level })   -- 테스트 플레이 기록 (Telemetry)
        end
    end

    method number ShrineBonus(string kind)
        -- 그 종류의 신전 축복(MapShrine)이 지금 걸려 있으면 1, 아니면 0
        if self.ShrineKind ~= kind then return 0 end
        if _UtilLogic.ServerElapsedSeconds >= self.ShrineUntil then return 0 end
        return 1
    end

    @ExecSpace("ServerOnly")
    method void OnStreakKill(integer exp)
        -- 내가 막타(소환수 포함)를 친 처치: streakWindowSec 안에 이어지면 연쇄 +1, 아니면 지난 연쇄를 끝내고 새로 시작
        local now = _UtilLogic.ElapsedSeconds
        if self.KillStreak > 0 and now - self.StreakLastAt > _GameData.streakWindowSec then self:EndStreak() end
        self.KillStreak = self.KillStreak + 1
        self.StreakExp = self.StreakExp + exp
        self.StreakLastAt = now
    end

    @ExecSpace("ServerOnly")
    method void StreakTick()
        -- 1초마다: 연쇄가 끊겼으면 끝낸다 (사망해도 끝)
        if self.KillStreak > 0 and (_UtilLogic.ElapsedSeconds - self.StreakLastAt > _GameData.streakWindowSec or not _Util:IsAlive(self.Entity)) then self:EndStreak() end
    end

    @ExecSpace("ServerOnly")
    method void EndStreak()
        -- 연쇄 끝: 10연속 이상이면 그 연쇄에서 번 처치 경험치의 3~10%를 보너스로 (사용자 #14-B 「과하지 않게」)
        local n = self.KillStreak
        local base = self.StreakExp
        self.KillStreak = 0
        self.StreakExp = 0
        if n < _GameData.streakShowFrom then return end
        local pct = _GameData.streakBonusPct10
        if n >= 100 then pct = _GameData.streakBonusPct100 elseif n >= 50 then pct = _GameData.streakBonusPct50 elseif n >= 25 then pct = _GameData.streakBonusPct25 end
        local bonus = math.floor(base * pct / 100 + 0.5)
        if bonus <= 0 then return end   -- 낮은 몬스터라 보너스가 0이면 「+0」을 띄우지 않는다 (머리 위 콤보가 흐려지며 끝난다)
        self:GainExp(bonus)
        self:ShowStreakEnd(n, bonus, self.Entity.PlayerComponent.UserId)
        log(string.format("[VRF] streak end n=%d base=%d pct=%d bonus=%d", n, math.floor(base), math.floor(pct), bonus))
    end

    @ExecSpace("Client")
    method void ShowStreakEnd(integer n, integer bonus)
        -- 연쇄 끝 보상 글자 (본인 화면 · 캐릭터 머리 위)
        if self.Entity ~= _UserService.LocalPlayer then return end
        _HudMain:ExtractPop(_Util:Pos2(self.Entity), "COMBO " .. tostring(n) .. " · 경험치 +" .. tostring(bonus), Color(1, 0.78, 0.4, 1))
    end

    method integer ExpForKill(integer monsterLevel, integer grade)
        -- killExpCoef(15) × 레벨^1.3 × 등급 배율(1/3/12). 몬스터가 3레벨 이상 낮으면 레벨마다 15%씩 감쇠(최저 5%), 5레벨 넘게 높아도 감쇠
        local gradeMult = 1
        if grade == 2 then gradeMult = 3 elseif grade >= 3 then gradeMult = 12 end
        local base = _GameData.killExpCoef * (monsterLevel ^ 1.3) * gradeMult
        local diff = self.Level - monsterLevel
        -- 낮은 몬스터 감쇠: 3레벨부터 레벨마다 15%씩, 최저 5% (10-24 사용자 L-B: 5레벨부터면 노말 끝이 Lv44까지 앞서갔다)
        if diff >= 3 then base = base * math.max(0.05, 1 - (diff - 2) * 0.15) end
        -- 너무 높은 몬스터(내 레벨 +5 초과)는 경험치를 (내 레벨+5)/몬스터 레벨로 줄인다 — 높은 난이도로 건너뛰어 레벨을 날로 먹지 않게
        local grace = _GameConst.ExpHighMonsterGrace
        if monsterLevel > self.Level + grace then base = base * (self.Level + grace) / monsterLevel end
        -- 지혜의 신전: 경험치 +30%
        base = base * (1 + 0.3 * self:ShrineBonus("wisdom"))
        -- 초반 가속: 그림자 해금(Lv5) 전까지 처치 경험치를 올린다 (config earlyExpLevel·earlyExpMult)
        if self.Level < _GameData.earlyExpLevel then base = base * _GameData.earlyExpMult end
        -- 높은 레벨 몬스터 보정: 맵 레벨은 맵마다 1씩 오르는데 처치 경험치가 못 따라가 액트 3에서 7레벨까지 뒤처졌다 (10-13 W1)
        -- 10-23: 보정은 expHighLevelTo(50) 레벨까지만 오른다 (상한이 없으면 Lv70 넘는 몬스터에 +460% 이상 — 지옥 끝 Lv96)
        if monsterLevel > _GameData.expHighLevelFrom then base = base * (1 + _GameData.expHighLevelPct / 100 * (math.min(monsterLevel, _GameData.expHighLevelTo) - _GameData.expHighLevelFrom)) end
        -- 같은 맵 인원 보정 (D2 players X — 몬스터 생명이 인원만큼 늘어난 대가, CoopRules · 10-13 X2)
        base = base * _CoopRules:ExpMul(self.Entity.CurrentMap)
        -- 몬스터 밀도 보정 (densityExpMult — 10-09에 1로: 넓은 맵 이동량 대비 레벨업이 느렸다. 드롭은 densityRewardMult 그대로)
        if grade < 3 then base = base * _GameData.densityExpMult end
        return math.max(1, math.floor(base + 0.5))
    end

    @ExecSpace("ServerOnly")
    method integer LoseExp(number pct)
        -- 사망 손실: 현재 레벨 구간 안에서만 (레벨은 내려가지 않음)
        if pct <= 0 then return 0 end
        local loss = math.min(math.floor(self.ExpToNext * pct / 100), self.Exp)
        self.Exp = self.Exp - loss
        return loss
    end

    @ExecSpace("Client")
    method void NotifyLevelUp(integer level)
        -- 본인만 (10-28 F2 #16-A: 소리·카메라·글자는 본인, 빛기둥만 같은 맵): 알림 + 효과음 1.0 + 카메라 살짝 + 머리 위 「레벨 업」 + 이 레벨에 열린 스킬
        local opened = {}
        for _, def in pairs(_SkillData.Skills) do
            if def.kind ~= "node" and math.floor(def.row) == level then table.insert(opened, def.name) end
        end
        local body = "능력치 +" .. tostring(math.floor(_GameData.statPerLevel)) .. " · 스킬 +" .. tostring(math.floor(_GameData.skillPerLevel))
        if #opened > 0 then body = body .. "\n새 스킬: " .. table.concat(opened, " · ") .. " (스킬 창 K)" else body = body .. "\n메뉴의 능력치·스킬에서 포인트를 쓰세요" end
        _UXFeedback:Show("레벨 업 · Lv " .. tostring(level), body, _GameData:GetUiIcon("menu_char"))
        _SoundDirector:PlayEffect(_GameConst.SfxLevelUp, 1.0)
        _ParticleService:PlayBasicParticle(BasicParticleType.Buff, self.Entity, self.Entity.TransformComponent.WorldPosition, 0, Vector3(1, 1, 1), false, nil)
        _Util:SkillShake(self.Entity, 0.08, 0.12)
        _HudMain:ExtractPop(_Util:Pos2(self.Entity), "레벨 업  Lv " .. tostring(level), Color(1, 0.86, 0.45, 1))
    end

    @ExecSpace("Multicast")
    method void LevelUpPillar(string mapId)
        -- 레벨업 빛기둥 (코덱스 feel-fx-v1 8프레임 · 750ms 1회): 같은 맵에 있는 사람 화면에만, 캐릭터 발밑에 붙여 클라이언트 전용으로 그린다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(self.Entity) or not isvalid(me.CurrentMap) or me.CurrentMap.Id ~= mapId then return end
        local ruids = {}
        for i = 1, 8 do table.insert(ruids, _GameData:GetUiIcon("fx_levelup_" .. tostring(i))) end
        if ruids[1] == "" then return end
        local fx = _SpawnService:SpawnByModelId("artsprite", "LevelUpPillar", self.Entity.TransformComponent.WorldPosition, self.Entity)
        if not isvalid(fx) then return end
        local sp = fx.SpriteRendererComponent
        sp.SpriteRUID = ruids[1]
        sp.SortingLayer = "MapLayer0"
        sp.OrderInLayer = 7
        fx.TransformComponent.Position = Vector3(0, 0, -0.02)
        local ps = self.Entity.TransformComponent.Scale
        fx.TransformComponent.Scale = Vector3(0.6 / math.max(0.1, math.abs(ps.x)), 0.6 / math.max(0.1, math.abs(ps.y)), 1)   -- 256×512px → 폭 1.5칸 · 높이 3칸
        local delays = { 0.09, 0.08, 0.08, 0.09, 0.11, 0.09, 0.09, 0.12 }
        local t = 0
        for i = 2, 8 do
            t = t + delays[i - 1]
            local ruid = ruids[i]
            _TimerService:SetTimerOnce(function() if isvalid(fx) then fx.SpriteRendererComponent.SpriteRUID = ruid end end, t)
        end
        _TimerService:SetTimerOnce(function() if isvalid(fx) then fx:Destroy() end end, t + delays[8])
        self:LevelUpRing()
    end

    @ExecSpace("ClientOnly")
    method void LevelUpRing()
        -- 빛기둥 발밑 고리 (코덱스 feel-fx-v2 6프레임 · 75ms씩): 바닥에 깔려 퍼지는 빛 — 캐릭터 뒤(바닥 쪽)에 그린다
        local ruids = {}
        for i = 1, 6 do table.insert(ruids, _GameData:GetUiIcon("fx_levelup_ring_" .. tostring(i))) end
        if ruids[1] == "" then return end
        local ring = _SpawnService:SpawnByModelId("artsprite", "LevelUpRing", self.Entity.TransformComponent.WorldPosition, self.Entity)
        if not isvalid(ring) then return end
        local sp = ring.SpriteRendererComponent
        sp.SpriteRUID = ruids[1]
        sp.SortingLayer = "MapLayer0"
        sp.OrderInLayer = 1
        ring.TransformComponent.Position = Vector3(0, 0, 0.01)
        local ps = self.Entity.TransformComponent.Scale
        ring.TransformComponent.Scale = Vector3(0.62 / math.max(0.1, math.abs(ps.x)), 0.62 / math.max(0.1, math.abs(ps.y)), 1)   -- 256×128px → 폭 1.6칸
        for i = 2, 6 do
            local ruid = ruids[i]
            _TimerService:SetTimerOnce(function() if isvalid(ring) then ring.SpriteRendererComponent.SpriteRUID = ruid end end, 0.075 * (i - 1))
        end
        _TimerService:SetTimerOnce(function() if isvalid(ring) then ring:Destroy() end end, 0.075 * 6)
        log("[VRF] levelup ring 6 frames")
    end

    -- ───────── 생명·마나 ─────────

    @ExecSpace("ServerOnly")
    method void Recalculate(boolean fill)
        -- 최대 생명·마나 = 기본 + 레벨 + 능력치 + 장비. fill이면 가득, 아니면 비율 유지
        local pc = self.Entity.PlayerComponent
        local maxHp = math.floor(_GameData.playerBaseHp + (self.Level - 1) * _GameData.playerHpPerLevel + (self.Vit + self.BonusVit - 15) * _GameData.vitLife + self.BonusLife)
        local maxMana = _GameData.playerBaseMana + (self.Level - 1) * 2 + (self.Ene + self.BonusEne - 25) * _GameData.eneMana + self.BonusMana
        local hpRatio = 1
        if pc.MaxHp > 0 then hpRatio = pc.Hp / pc.MaxHp end
        local manaRatio = 1
        if self.MaxMana > 0 then manaRatio = self.Mana / self.MaxMana end
        pc.MaxHp = math.max(1, maxHp)
        self.MaxMana = math.max(1, maxMana)
        if fill then
            pc.Hp = pc.MaxHp
            self.Mana = self.MaxMana
        else
            pc.Hp = math.max(1, math.floor(pc.MaxHp * hpRatio))
            self.Mana = self.MaxMana * manaRatio
        end
    end

    @ExecSpace("ServerOnly")
    method void Regen()
        -- 마나: 초당 최대치 manaRegenPct + 정신 보정 / 생명: 초당 hpRegenPct + 장비 재생 (config.csv)
        -- 생명은 정수라 1 미만은 RegenCarry에 모았다가 채운다 (낮은 레벨에서 1씩 올라 너무 빨랐던 것 수정)
        self:StreakTick()
        local pc = self.Entity.PlayerComponent
        if not _Util:IsAlive(self.Entity) then return end
        self:RefreshSpeed()
        -- 가득 차 있으면 다시 쓰지 않는다 (@Sync — 10-13 3인 파티 끊김 점검)
        local mana = math.min(self.MaxMana, self.Mana + self.MaxMana * _GameData.manaRegenPct + (self.Ene + self.BonusEne) * _GameData.manaRegenPerEne)
        if mana ~= self.Mana then self.Mana = mana end
        if pc.Hp >= pc.MaxHp then
            self.RegenCarry = 0
            return
        end
        self.RegenCarry = self.RegenCarry + pc.MaxHp * (_GameData.hpRegenPct + self:AuraAmount("regen") / 100) + self.BonusRegen   -- 그림자 재생 오오라
        local add = math.floor(self.RegenCarry)
        if add <= 0 then return end
        self.RegenCarry = self.RegenCarry - add
        pc.Hp = math.min(pc.MaxHp, pc.Hp + add)
    end

    @ExecSpace("ServerOnly")
    method void ApplyPotionCurse(number seconds)
        -- 모래 미라에게 맞음: 물약 회복 -30% (새로 걸릴 때만 알림)
        local now = _UtilLogic.ServerElapsedSeconds
        if self.PotionCurseUntil < now then _Util:Warn("미라의 저주 — 물약 회복 -30% (5초)", self.Entity.PlayerComponent.UserId) end
        self.PotionCurseUntil = now + seconds
    end

    method number PotionMult()
        -- 물약 회복 배율 (미라 저주 중 0.7)
        if _UtilLogic.ServerElapsedSeconds < self.PotionCurseUntil then return 0.7 end
        return 1
    end

    @ExecSpace("ServerOnly")
    method void Heal(number hp, number mana)
        -- 물약·흡수 등 회복의 공통 진입점
        local pc = self.Entity.PlayerComponent
        if not _Util:IsAlive(self.Entity) then return end
        if hp > 0 then pc.Hp = math.min(pc.MaxHp, pc.Hp + math.floor(hp)) end
        if mana > 0 then self.Mana = math.min(self.MaxMana, self.Mana + mana) end
    end

    @ExecSpace("ServerOnly")
    method boolean SpendMana(number amount)
        if self.Mana < amount then return false end
        self.Mana = self.Mana - amount
        return true
    end

    @ExecSpace("ServerOnly")
    method void AddGold(integer amount)
        self.Gold = math.max(0, self.Gold + amount)
    end

    -- ───────── 장비 추가치 ─────────

    @ExecSpace("ServerOnly")
    method void ApplyEquipmentMods(table t)
        -- PlayerInventory가 장비 옵션 합계를 넘긴다 (키는 ItemData.StatName 참고)
        local function v(k) return t[k] or 0 end
        self.BonusDamage = v("dmgFlat")
        self.BonusDamagePct = v("dmgPct")
        self.BonusDefense = v("def")
        self.BonusLife = v("life")
        self.BonusMana = v("mana")
        self.BonusStr = math.floor(v("str"))
        self.BonusDex = math.floor(v("dex"))
        self.BonusVit = math.floor(v("vit"))
        self.BonusEne = math.floor(v("ene"))
        self.BonusMinionPct = v("minion")
        self.BonusExtractPct = v("extract")
        self.BonusMF = v("mf")
        self.BonusGF = v("gf")
        self.BonusRegen = v("regen")
        self.BonusDeploy = math.min(2, math.floor(v("deploy")))
        self.BonusShadowCap = math.min(math.floor(_GameData.shadowCapBonusMax), math.floor(v("shadowCap")))
        self.BonusLeech = v("leech")
        self.BonusMs = v("ms")
        self.BonusIas = v("ias")
        self.BonusFcr = v("fcr")
        self.BonusCurse = v("curse")
        self.BonusMinionPoison = v("minionPoison")
        self.BonusAllSkills = math.min(2, math.floor(v("allSkills")))
        self.BonusTreeCommand = math.min(3, math.floor(v("treeCommand")))
        self.BonusTreeSoul = math.min(3, math.floor(v("treeSoul")))
        self.BonusTreeCurse = math.min(3, math.floor(v("treeCurse")))
        local single = {}
        for k, n in pairs(t) do
            local id = string.match(k, "^sk_([%w_]+)$")
            if id ~= nil and math.floor(n) > 0 then table.insert(single, id .. "=" .. tostring(math.min(3, math.floor(n)))) end
        end
        table.sort(single)
        self.BonusSkillLv = table.concat(single, ",")
        self.BonusSpellDmg = v("spellDmg")
        self.BonusCurseDur = v("curseDur")
        self.BonusCurseEff = v("curseEff")
        self.BonusMinionIas = v("minionIas")
        self.BonusMinionRes = v("minionRes")
        local all = v("allRes")
        self.RawResists = { fire = v("fireRes") + all, cold = v("coldRes") + all, light = v("lightRes") + all, poison = v("poisonRes") + all }
        self:RefreshResists()
        local elem = {}
        for _, e in ipairs({ "fire", "cold", "light", "poison" }) do
            if v(e .. "Dmg") > 0 then table.insert(elem, e .. "=" .. tostring(math.floor(v(e .. "Dmg")))) end
        end
        self.ElemDamage = table.concat(elem, ",")
        self:RefreshSpeed()
        self:Recalculate(false)
    end

    -- ───────── 속성 ─────────

    method number GetAttackInterval(number base)
        -- 공격 속도(장갑·무기)만큼 기본 공격 간격이 짧아진다 (상한 iasCap) · 그림자 신속 오오라
        return base / (1 + self:GetIas() / 100) / self:AuraMult("haste")
    end

    method number GetCastCooldownMult()
        -- 시전 속도(반지·목걸이)만큼 스킬 재사용 대기가 짧아진다 (상한 fcrCap) · 그림자 신속 오오라도 시전을 빠르게
        return 1 / (1 + math.min(self:GetFcr(), _GameData.fcrCap) / 100) / self:AuraMult("haste")
    end

    @ExecSpace("ServerOnly")
    method void ReceiveAura(string effect, number value)
        -- 그림자 오오라 (ShadowUnit.AbilityTick): 범위 안에 있는 동안 auraTickSec마다 갱신, 벗어나면 auraHoldSec 뒤 사라진다. 같은 효과는 가장 센 것
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.AuraUntil then self.AuraVals = {} end
        local hadMove = (self.AuraVals["move"] or 0) > 0
        self.AuraVals[effect] = math.max(self.AuraVals[effect] or 0, value)
        self.AuraUntil = now + _GameData.auraHoldSec
        if effect == "move" and not hadMove then self:RefreshSpeed() end
    end

    method number AuraAmount(string effect)
        if _UtilLogic.ElapsedSeconds >= self.AuraUntil then return 0 end
        return self.AuraVals[effect] or 0
    end

    method number AuraMult(string kind)
        -- dmg 주는 피해 / haste 공격·시전 속도 / guard 받는 피해
        if kind == "guard" then return math.max(0.1, 1 - self:AuraAmount("guard") / 100) end
        return 1 + self:AuraAmount(kind) / 100
    end

    method number GetFcr()
        -- 시전 속도 % = 장비 + 민첩 × dexFcrPct (10-11)
        return self.BonusFcr + (self.Dex + self.BonusDex) * _GameData.dexFcrPct
    end

    @ExecSpace("ServerOnly")
    method void RefreshResists()
        -- 장비 저항 - 난이도 페널티, 상한 resistCap, 하한 -100 (난이도가 바뀌면 다시 부른다)
        local penalty = _GameConst:ResistPenalty(self.Difficulty)
        local cap = _GameData.resistCap
        local raw = self.RawResists
        -- 의뢰 영구 보상 독 저항 (난이도 페널티 전에 더한다)
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        local questPoison = quest ~= nil and quest.PoisonBonus or 0
        local questLight = quest ~= nil and quest.LightBonus or 0
        local questFire = quest ~= nil and quest.FireBonus or 0
        self.ResFire = math.floor(math.max(-100, math.min(cap, (raw.fire or 0) + questFire - penalty)))
        self.ResCold = math.floor(math.max(-100, math.min(cap, (raw.cold or 0) - penalty)))
        self.ResLight = math.floor(math.max(-100, math.min(cap, (raw.light or 0) + questLight - penalty)))
        self.ResPoison = math.floor(math.max(-100, math.min(cap, (raw.poison or 0) + questPoison - penalty)))
    end

    method number GetResist(string element)
        -- 변종 몬스터의 부식 오오라 안에 있으면 모든 저항이 깎인다 (10-24 B안)
        local corrode = (_UtilLogic.ServerElapsedSeconds < self.CorrodeUntil and self.CorrodeAmount or 0) - self:AuraAmount("resist")   -- 그림자 저항 오오라는 더한다
        if element == "fire" then return self.ResFire - corrode end
        if element == "cold" then return self.ResCold - corrode end
        if element == "light" then return self.ResLight - corrode end
        if element == "poison" then return self.ResPoison - corrode end
        return 0
    end

    @ExecSpace("ServerOnly")
    method void ReceiveCorrode(number amount)
        -- 부식 오오라 범위 안: auraHoldSec 동안 저항 -amount (가장 센 것 하나). 버프 줄에 약화로 보인다
        local now = _UtilLogic.ServerElapsedSeconds
        if now >= self.CorrodeUntil then self.CorrodeAmount = 0 end
        self.CorrodeAmount = math.max(self.CorrodeAmount, math.floor(amount + 0.5))
        self.CorrodeUntil = now + _GameData.auraHoldSec
    end

    method number GetElemDamage(string element)
        local v = string.match("," .. self.ElemDamage, "," .. element .. "=([%d%.]+)")
        if v == nil then return 0 end
        return tonumber(v)
    end

    -- ───────── 이동 속도 ─────────

    @ExecSpace("ServerOnly")
    method void RefreshSpeed()
        -- 기본 × (1 + 장비 %) × 냉기 둔화(0.6). 속도를 바꾸는 곳은 여기 하나. 바뀔 때만 쓴다
        -- (10-13 사용자 지적: 디버프 없이 갑자기 아주 느려졌다 → Regen이 1초마다 이걸 불러, 둔화 끝 복구 타이머를 놓쳐도 다시 맞춘다)
        local movement = self.Entity.MovementComponent
        if not isvalid(movement) or self.BaseSpeed <= 0 then return end
        local mult = 1 + self.BonusMs / 100 + self:AuraAmount("move") / 100   -- 그림자 기동 오오라
        -- 이동 「가벼운 걸음」 (10-20) + 강화 「사냥꾼의 걸음」 (10-24) · 「잔걸음」 (10-29 44 결정 4 — 질풍 걸음 +2%/랭크 자리): 장비 이동 속도와 더한다
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then
            local step = book:GetPowerLevel("swift_step")
            if step > 0 then mult = mult + book:GetEffectPower("swift_step", step) / 100 end
            if _UtilLogic.ServerElapsedSeconds < self.HuntUntil then mult = mult + 0.04 * book:Node("step_hunt") end
        end
        if _UtilLogic.ServerElapsedSeconds < self.AfterStepUntil then mult = mult + self.AfterStepPct / 100 end
        if _UtilLogic.ServerElapsedSeconds < self.ChillUntil then mult = mult * 0.6 end
        if _UtilLogic.ServerElapsedSeconds < self.StaggerUntil then mult = mult * 0.5 end
        if _UtilLogic.ServerElapsedSeconds < self.PvpDecayUntil then mult = mult * math.max(0.3, 1 - self.PvpDecayPct / 100) end
        if _UtilLogic.ServerElapsedSeconds < self.RootUntil then mult = 0 end
        local want = self.BaseSpeed * mult
        if math.abs(movement.InputSpeed - want) > 0.001 then
            if movement.InputSpeed < want * 0.9 and not Environment:IsPublishedPlay() then log(string.format("[VRF] speed restored %.2f → %.2f", movement.InputSpeed, want)) end
            movement.InputSpeed = want
        end
    end

    @ExecSpace("ServerOnly")
    method void OnHuntKill()
        -- 강화 「사냥꾼의 걸음」: 나나 내 소환수가 처치하면 3초간 이동 속도 +4%/랭크 (RewardSystem이 기여자마다 부른다)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil or book:Node("step_hunt") <= 0 then return end
        local fresh = _UtilLogic.ServerElapsedSeconds >= self.HuntUntil
        self.HuntUntil = _UtilLogic.ServerElapsedSeconds + 3
        if fresh then self:RefreshSpeed() end
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ServerElapsedSeconds >= self.HuntUntil then self:RefreshSpeed() end
        end, 3.05)
    end

    @ExecSpace("ServerOnly")
    method void StartAfterStep(number pct, number seconds)
        -- 강화 「잔걸음」: 질주 뒤 seconds 동안 이동 속도 +pct% (다시 질주하면 시간·수치를 새로)
        self.AfterStepPct = pct
        self.AfterStepUntil = _UtilLogic.ServerElapsedSeconds + seconds
        self:RefreshSpeed()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ServerElapsedSeconds >= self.AfterStepUntil then self:RefreshSpeed() end
        end, seconds + 0.05)
    end

    @ExecSpace("ServerOnly")
    method number SoakBoneArmor(number final)
        -- 뼈 갑옷이 먼저 받는다 (몬스터 공격 MonsterAttack.CalcDamage · 결투 AbsorbBoneArmor 공통). 남은 피해를 돌려준다.
        -- 다 깨지면 강화 「터지는 갑옷」(44 결정 4 · 가시 갑옷 자리)이 그 갑옷이 막은 피해 합 × 배율을 둘레로 터뜨린다 (판정이 끝난 뒤 · 0.05초)
        if self.BoneArmor <= 0 or final <= 0 then return final end
        local absorbed = math.min(final, self.BoneArmor)
        self.BoneArmor = self.BoneArmor - absorbed
        self.ArmorSoaked = self.ArmorSoaked + absorbed
        if self.BoneArmor <= 0 then
            self.BoneArmor = 0
            local soaked = self.ArmorSoaked
            self.ArmorSoaked = 0
            ---@type SkillBook
            local book = self.Entity:GetComponent("script.SkillBook")
            local mul = book ~= nil and book:ArmorBurstMul(book:Node("armor_thorns")) or 0
            if mul > 0 and soaked > 0 then
                local me = self.Entity
                _TimerService:SetTimerOnce(function()
                    ---@type SkillEffects
                    local fx = isvalid(me) and me:GetComponent("script.SkillEffects") or nil
                    if fx ~= nil then fx:ArmorBurst(soaked * mul) end
                end, 0.05)
            end
        end
        return final - math.floor(absorbed)
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- 뼈 갑옷 몸 고리 (44 §4-1 B: 예전엔 버프 칩 숫자뿐이었다): 남은 흡수량 비율을 4단계로 나눠 단계가 바뀔 때만 다시 그린다 (모든 클라이언트)
        if name ~= "BoneArmor" and name ~= "BoneArmorMax" then return end
        local ratio = self.BoneArmorMax > 0 and math.max(0, math.min(1, self.BoneArmor / self.BoneArmorMax)) or 0
        local step = self.BoneArmor > 0 and math.max(1, math.ceil(ratio * 4)) or 0
        if step == self.ArmorRingStep then return end
        self.ArmorRingStep = step
        log(string.format("[VRF] bone armor ring step=%d (%d/%d)", step, math.floor(self.BoneArmor), math.floor(self.BoneArmorMax)))
        if step <= 0 or not isvalid(self.Entity) then
            self:StopArmorRing()
            return
        end
        -- 뼈 흰빛 기운: 가득 ArmorRingAlphaMax(0.85) → 거의 깨짐 ArmorRingAlphaMin(0.55) (코덱스 H-5 뼈 갑옷 고리가 승인되면 그 그림 · 몸 앞·뒤 두 층으로)
        local c = self.ArmorRingColor
        local color = Color(c.r, c.g, c.b, self:ArmorRingAlpha(step))
        if self.ArmorRingLive and self:TintArmorRing(color) then return end
        self:PlayArmorRingParticle(color)
    end

    method number ArmorRingAlpha(integer step)
        -- 몸 고리 4단계 → 투명도 (순수 계산 · tests/quality/skillfx_e.lua): 1단계 ArmorRingAlphaMin … 4단계 ArmorRingAlphaMax · 0 = 없음
        if step <= 0 then return 0 end
        local t = (math.min(4, step) - 1) / 3
        return self.ArmorRingAlphaMin + (self.ArmorRingAlphaMax - self.ArmorRingAlphaMin) * t
    end

    @ExecSpace("ClientOnly")
    method boolean TintArmorRing(Color color)
        -- 몸에 붙은 고리 입자 엔티티: 있으면 색(투명도)만 바꾼다 · 없으면 만든다 (artsprite 그림은 끄고 BasicParticleComponent Enchant 반복). 못 만들면 false
        local e = self.ArmorRingEntity
        if e ~= nil and isvalid(e) then
            local live = e.BasicParticleComponent
            if not isvalid(live) then return false end
            live.Color = color
            return true
        end
        e = _SpawnService:SpawnByModelId("artsprite", "BoneArmorRing", self.Entity.TransformComponent.WorldPosition, self.Entity)
        if not isvalid(e) then return false end
        e.SpriteRendererComponent.Enable = false
        local added = e:AddComponent("BasicParticleComponent")
        if added == nil or not isvalid(added) then
            e:Destroy()
            return false
        end
        ---@type BasicParticleComponent
        local bp = added
        bp.ParticleType = BasicParticleType.Enchant
        bp.Loop = true
        bp.Prewarm = true
        bp.SortingLayer = "MapLayer0"
        bp.OrderInLayer = 5
        bp.Color = color
        local ps = self.Entity.TransformComponent.Scale
        local psx, psy = math.max(0.1, math.abs(ps.x)), math.max(0.1, math.abs(ps.y))
        e.TransformComponent.Position = Vector3(0, 0.45 / psy, 0)
        e.TransformComponent.Scale = Vector3(0.95 / psx, 0.95 / psy, 1)
        bp:Play()
        self.ArmorRingEntity = e
        -- 안전장치: ArmorRingCheckSec 뒤에도 안 뿜으면 이 경로를 끄고 예전 서비스 입자로 (메이커 확인 전)
        _TimerService:SetTimerOnce(function()
            if self.ArmorRingEntity ~= e or not isvalid(e) then return end
            local p = e.BasicParticleComponent
            local emitting = isvalid(p) and p.IsEmitting
            log(string.format("[VRF] bone armor ring live emitting=%s step=%d", tostring(emitting), self.ArmorRingStep))
            if not emitting then
                self.ArmorRingLive = false
                e:Destroy()
                self.ArmorRingEntity = nil
                if self.ArmorRingStep > 0 then
                    local c = self.ArmorRingColor
                    self:PlayArmorRingParticle(Color(c.r, c.g, c.b, self:ArmorRingAlpha(self.ArmorRingStep)))
                end
            end
        end, self.ArmorRingCheckSec)
        return true
    end

    @ExecSpace("ClientOnly")
    method void PlayArmorRingParticle(Color color)
        -- 예전 경로(서비스 입자 · 몸 +0.45): 새 고리를 먼저 틀고 앞 고리는 ArmorRingOverlap 뒤에 지운다 (지우고 다시 틀면 퍼지던 반짝이가 끊겼다)
        local old = self.ArmorRingSerial
        self.ArmorRingSerial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.Enchant, self.Entity, Vector3(0, 0.45, 0), 0, Vector3(0.95, 0.95, 1), true, { Color = color, SortingLayer = "MapLayer0", OrderInLayer = 5 })
        if old ~= 0 then _TimerService:SetTimerOnce(function() _ParticleService:RemoveParticle(old) end, self.ArmorRingOverlap) end
    end

    @ExecSpace("ClientOnly")
    method void StopArmorRing()
        -- 갑옷이 다 깨졌다: 고리 입자·엔티티를 지운다
        if self.ArmorRingSerial ~= 0 then _ParticleService:RemoveParticle(self.ArmorRingSerial) end
        self.ArmorRingSerial = 0
        if self.ArmorRingEntity ~= nil and isvalid(self.ArmorRingEntity) then self.ArmorRingEntity:Destroy() end
        self.ArmorRingEntity = nil
    end

    @ExecSpace("ServerOnly")
    method void ApplyChill(number seconds)
        -- 냉기 둔화 (냉기 저항만큼 시간 감소)
        local dur = seconds * math.max(0.2, 1 - self.ResCold / 100)
        self.ChillUntil = _UtilLogic.ServerElapsedSeconds + dur
        self:RefreshSpeed()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ServerElapsedSeconds >= self.ChillUntil then self:RefreshSpeed() end
        end, dur + 0.05)
    end

    @ExecSpace("ServerOnly")
    method boolean ApplyPvpCurse(string kind, number pct, number duration, Entity source)
        -- 결투 상대의 저주: 낙인(amp) · 쇠약(weaken) · 쇠퇴(decay)만 플레이어에게 듣는다 (공포·혼란 등은 보스처럼 면역). 걸리면 true
        local now = _UtilLogic.ServerElapsedSeconds
        local name = ""
        if kind == "amp" then
            self.PvpAmpPct = now < self.PvpAmpUntil and math.max(self.PvpAmpPct, pct) or pct
            self.PvpAmpUntil = now + duration
            name = "약화의 낙인"
        elseif kind == "weaken" then
            self.PvpWeakenPct = now < self.PvpWeakenUntil and math.max(self.PvpWeakenPct, pct) or pct
            self.PvpWeakenUntil = now + duration
            name = "쇠약"
        elseif kind == "decay" then
            self.PvpDecayPct = now < self.PvpDecayUntil and math.max(self.PvpDecayPct, pct) or pct
            self.PvpDecayUntil = now + duration
            name = "쇠퇴"
            self:RefreshSpeed()
            _TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:RefreshSpeed() end end, duration + 0.05)
        else
            return false
        end
        _Util:Warn(name .. "에 걸렸습니다 (" .. string.format("%.0f", duration) .. "초)", self.Entity.PlayerComponent.UserId)
        return true
    end

    @ExecSpace("ServerOnly")
    method number AbsorbBoneArmor(number final)
        -- 결투 상대의 공격도 뼈 갑옷이 먼저 받는다 (몬스터 공격과 같은 SoakBoneArmor — 「터지는 갑옷」 포함). 남은 피해를 돌려준다
        return self:SoakBoneArmor(final)
    end

    method number PvpTakenMult()
        -- 결투 상대에게 받는 피해 배율 (낙인)
        if _UtilLogic.ServerElapsedSeconds >= self.PvpAmpUntil then return 1 end
        return 1 + self.PvpAmpPct / 100
    end

    method number PvpDealtMult()
        -- 내가 주는 피해 배율 (쇠약 · 쇠퇴)
        local now = _UtilLogic.ServerElapsedSeconds
        local m = 1
        if now < self.PvpWeakenUntil then m = m * math.max(0.1, 1 - self.PvpWeakenPct / 100) end
        if now < self.PvpDecayUntil then m = m * math.max(0.1, 1 - self.PvpDecayPct / 100) end
        return m
    end

    @ExecSpace("ServerOnly")
    method void ApplyRoot(number seconds)
        -- 결투 상대의 뼈 감옥: seconds 동안 이동 불가 (공격·스킬은 된다)
        self.RootUntil = math.max(self.RootUntil, _UtilLogic.ServerElapsedSeconds + seconds)
        self:RefreshSpeed()
        _Util:Warn("뼈 감옥에 갇혔습니다", self.Entity.PlayerComponent.UserId)
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ServerElapsedSeconds >= self.RootUntil then self:RefreshSpeed() end
        end, seconds + 0.05)
    end

    @ExecSpace("ServerOnly")
    method void ApplyPvpPoison(number dps, number seconds, Entity source)
        -- 결투 상대의 독: 0.5초마다 dps×0.5를 독 저항만큼 줄여 깎는다 (다시 걸면 시간만 새로)
        self.PvpPoisonUntil = _UtilLogic.ServerElapsedSeconds + seconds
        if self.PvpPoisonTimer ~= 0 then return end
        local tick = dps * 0.5 * math.max(0, 1 - self:GetResist("poison") / 100)
        self.PvpPoisonTimer = _TimerService:SetTimerRepeat(function()
            ---@type PlayerVitals
            local vitals = isvalid(self.Entity) and self.Entity:GetComponent("script.PlayerVitals") or nil
            if vitals == nil or _UtilLogic.ServerElapsedSeconds >= self.PvpPoisonUntil then
                _TimerService:ClearTimer(self.PvpPoisonTimer)
                self.PvpPoisonTimer = 0
                return
            end
            vitals:TakeDuelDamage(tick, source)
        end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method void ClearPvpEffects()
        -- 결투가 끝나면 남은 저주·속박·독을 지운다
        self.PvpAmpUntil = 0
        self.PvpWeakenUntil = 0
        self.PvpDecayUntil = 0
        self.RootUntil = 0
        self.PvpPoisonUntil = 0
        self:RefreshSpeed()
    end

    @ExecSpace("ServerOnly")
    method void ApplyStagger(number seconds)
        -- 거구 몬스터(archetypes.csv brute) 강타에 맞으면 잠깐 휘청인다 (이동 ×0.5). 냉기 둔화와 따로 겹친다
        self.StaggerUntil = math.max(self.StaggerUntil, _UtilLogic.ServerElapsedSeconds + seconds)
        self:RefreshSpeed()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ServerElapsedSeconds >= self.StaggerUntil then self:RefreshSpeed() end
        end, seconds + 0.05)
    end

    -- ───────── 피해 계산 보조 ─────────

    method number GetMeleeDamage(number baseDamage)
        -- (기본 + 장비 추가) × (1 + 민첩 × dexMeleePct/100 + 장비 %) — 10-11: 힘(통솔)은 소환수 몫이 됐다
        return (baseDamage + self.BonusDamage) * (1 + (self.Dex + self.BonusDex) * _GameData.dexMeleePct / 100 + self.BonusDamagePct / 100)
    end

    method number GetMinionPct()
        -- 소환수 공격·생명 % = 장비 + 통솔(예전 힘)이 시작값 15를 넘은 만큼 × strMinionPct (docs/design/16)
        return self.BonusMinionPct + math.max(0, self.Str + self.BonusStr - 15) * _GameData.strMinionPct
    end

    method number GetSpellPowerPct()
        -- 영혼 스킬 피해 보너스: 정신 1당 eneSpellPct% + 장비 피해 % + 영혼 스킬 피해 % (docs/design/19)
        return (self.Ene + self.BonusEne) * _GameData.eneSpellPct + self.BonusDamagePct + self.BonusSpellDmg
    end

    method integer GetSkillLevelBonus(string id, string tree)
        -- 메인 스킬 하나에 더하는 장비 레벨: 모든 스킬(≤2) + 계열(≤3) + 단일 스킬(≤3) (docs/design/19)
        local bonus = self.BonusAllSkills
        if tree == "command" then bonus = bonus + self.BonusTreeCommand
        elseif tree == "soul" then bonus = bonus + self.BonusTreeSoul
        elseif tree == "curse" then bonus = bonus + self.BonusTreeCurse end
        local one = string.match("," .. self.BonusSkillLv, "," .. id .. "=(%d+)")
        if one ~= nil then bonus = bonus + tonumber(one) end
        return bonus
    end

    method number GetDefense()
        -- 방어 = 장비 + 민첩/dexPerDefense (D2 규칙). 물리 피해 감소 = 100/(100+방어)
        return self.BonusDefense + math.floor((self.Dex + self.BonusDex) / _GameData.dexPerDefense)
    end

    method number GetIas()
        -- 공격 속도 % = 장비 + 민첩 × dexIasPct (상한 iasCap)
        return math.min(_GameData.iasCap, self.BonusIas + (self.Dex + self.BonusDex) * _GameData.dexIasPct)
    end

    method number GetBasicCriticalChancePct()
        -- 민첩(장비 포함)은 평타 치명타 확률을 높인다. 소환수·주문에는 전이하지 않는다.
        return math.max(0, math.min(_GameData.basicCritChanceCap, (self.Dex + self.BonusDex) * _GameData.basicCritPerDex))
    end

    -- ───────── 요청 ─────────

    @ExecSpace("Server")
    method void RequestAddStat(string statName)
        -- 살아 있는 소유자만 투자한다. 사망 중 재계산으로 생명이 1이 되는 것을 막는다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.StatPoints <= 0 or not _Util:IsAlive(self.Entity) then return end
        if statName == "Str" then self.Str = self.Str + 1
        elseif statName == "Dex" then self.Dex = self.Dex + 1
        elseif statName == "Vit" then self.Vit = self.Vit + 1
        elseif statName == "Ene" then self.Ene = self.Ene + 1
        else return end
        self.StatPoints = self.StatPoints - 1
        self:Recalculate(false)
    end

    @ExecSpace("Server")
    method void RequestAutoStats(string preset)
        -- 추천 분배 (docs/design/16): 남은 포인트를 성향 비율대로 한 번에 나눈다. 소환형 통솔3·활력2 / 주문형 정신3·활력2 / 균형 통솔2·정신1·활력2
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.StatPoints <= 0 or not _Util:IsAlive(self.Entity) then return end
        local cycle = { summon = { "Str", "Vit", "Str", "Vit", "Str" }, spell = { "Ene", "Vit", "Ene", "Vit", "Ene" }, balance = { "Str", "Vit", "Ene", "Vit", "Str" } }
        local order = cycle[preset]
        if order == nil then return end
        local spent = 0
        while self.StatPoints > 0 do
            local stat = order[spent % #order + 1]
            if stat == "Str" then self.Str = self.Str + 1
            elseif stat == "Vit" then self.Vit = self.Vit + 1
            elseif stat == "Ene" then self.Ene = self.Ene + 1 end
            self.StatPoints = self.StatPoints - 1
            spent = spent + 1
        end
        self:Recalculate(false)
        log("[VRF] auto stats " .. preset .. " spent=" .. tostring(spent))
    end

    @ExecSpace("ServerOnly")
    method integer ResetStats()
        -- 능력치 초기화: 시작값(통솔 15 · 민첩 25 · 활력 15 · 정신 25)보다 올린 만큼 돌려준다 (돌려준 포인트 수)
        local refund = math.max(0, self.Str - 15) + math.max(0, self.Dex - 25) + math.max(0, self.Vit - 15) + math.max(0, self.Ene - 25)
        self.Str, self.Dex, self.Vit, self.Ene = 15, 25, 15, 25
        self.StatPoints = self.StatPoints + refund
        self:Recalculate(false)
        return refund
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method boolean HasFirstKill(string key)
        return string.find("," .. self.FirstKills .. ",", "," .. key .. ",", 1, true) ~= nil
    end

    @ExecSpace("ServerOnly")
    method void MarkFirstKill(string key)
        -- 보스·최상위 첫 처치 기록 ("sourceId@난이도", 저장됨)
        if self:HasFirstKill(key) then return end
        if self.FirstKills == "" then self.FirstKills = key else self.FirstKills = self.FirstKills .. "," .. key end
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        return { fk = self.FirstKills, lv = self.Level, exp = self.Exp, str = self.Str, dex = self.Dex, vit = self.Vit, ene = self.Ene, sp = self.StatPoints, skp = self.SkillPoints, gold = self.Gold, diff = self.Difficulty, maxDiff = self.MaxDifficulty }
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        if d == nil then return end
        self.Level = d.lv or 1
        self.Exp = d.exp or 0
        self.Str = d.str or 15
        self.Dex = d.dex or 25
        self.Vit = d.vit or 15
        self.Ene = d.ene or 25
        self.StatPoints = d.sp or 0
        self.SkillPoints = d.skp or 0
        self.Gold = d.gold or 0
        self.Difficulty = d.diff or 0
        self.MaxDifficulty = d.maxDiff or 0
        self.FirstKills = d.fk or ""
        self.ExpToNext = self:CalcExpToNext(self.Level)
        self:RefreshResists()
        self:Recalculate(true)
    end

end
