-- 캐릭터 능력치: 경험치·레벨·4대 능력치·마나·골드·난이도, 장비 추가치(속성 포함), 이동 속도. 서버 권위.
-- 곡선·상한 수치는 data/config.csv → _GameData. 공식 근거: docs/design/03-core-rules-and-combat.md
@Component
script PlayerStats extends Component

    @Sync
    property string ShrineKind = ""          -- 신전 축복 (MapShrine): fury · ward · wisdom · soul · legion
    @Sync
    property number ShrineUntil = 0          -- 축복이 끝나는 서버 시각 (ServerElapsedSeconds)
    @Sync
    property number PotionCurseUntil = 0     -- 모래 미라 저주: 이 서버 시각까지 물약 회복 -30% (버프 줄 표시용 동기화)
    @Sync
    property integer Level = 1
    @Sync
    property integer Exp = 0
    @Sync
    property integer ExpToNext = 100
    @Sync
    property integer Str = 15
    @Sync
    property integer Dex = 25
    @Sync
    property integer Vit = 15
    @Sync
    property integer Ene = 25
    @Sync
    property integer StatPoints = 0
    @Sync
    property integer SkillPoints = 1
    @Sync
    property number Mana = 25
    @Sync
    property number MaxMana = 25
    @Sync
    property integer Gold = 0
    @Sync
    property integer Difficulty = 0          -- 0 보통 / 1 악몽 / 2 지옥
    @Sync
    property integer MaxDifficulty = 0       -- 개방된 최고 난이도

    -- 장비 추가치 (ApplyEquipmentMods가 갱신, 능력치 창 표시용으로 동기화)
    @Sync
    property number BonusLife = 0
    @Sync
    property number BonusMana = 0
    @Sync
    property number BonusDamage = 0
    @Sync
    property number BonusDamagePct = 0
    @Sync
    property number BonusDefense = 0
    @Sync
    property integer BonusStr = 0
    @Sync
    property integer BonusDex = 0
    @Sync
    property integer BonusVit = 0
    @Sync
    property integer BonusEne = 0
    @Sync
    property number BonusMinionPct = 0
    @Sync
    property number BonusExtractPct = 0
    @Sync
    property number BonusMF = 0
    @Sync
    property number BonusGF = 0
    @Sync
    property number BonusRegen = 0
    @Sync
    property integer BonusDeploy = 0         -- 배치 한도 (룬워드, 합산 최대 +2)
    property string FirstKills = ""         -- 보스·최상위 첫 처치 기록 (예전 첫 처치 확정 보상용 — 10-13에 보상은 없앴고 저장 호환으로만 남김)
    @Sync
    property integer BonusShadowCap = 0      -- 그림자 절대 상한 + (세트 완성 효과, 최대 shadowCapBonusMax)
    @Sync
    property number BonusLeech = 0           -- 생명력 흡수 %
    @Sync
    property number BonusMs = 0              -- 이동 속도 % (신발)
    @Sync
    property number BonusIas = 0             -- 공격 속도 % (장갑·무기)
    @Sync
    property number BonusFcr = 0             -- 시전 속도 % (반지·목걸이)
    @Sync
    property number BonusCurse = 0           -- 저주 범위 %
    @Sync
    property number BonusMinionPoison = 0    -- 소환수 공격에 독 (초당)
    @Sync
    property integer BonusAllSkills = 0      -- 배운 모든 스킬 레벨 +N (유니크 고유 효과, 최대 2 · docs/design/19)
    @Sync
    property integer BonusTreeCommand = 0    -- 소환 계열 메인 스킬 레벨 +N (최대 3)
    @Sync
    property integer BonusTreeSoul = 0       -- 영혼 계열 메인 스킬 레벨 +N (최대 3)
    @Sync
    property integer BonusTreeCurse = 0      -- 저주 계열 메인 스킬 레벨 +N (최대 3)
    @Sync
    property string BonusSkillLv = ""        -- 단일 스킬 레벨 "bone_spear=2,raise_skeleton=1" (스킬마다 최대 3)
    @Sync
    property number BonusSpellDmg = 0        -- 영혼 스킬 피해 %
    @Sync
    property number BonusCurseDur = 0        -- 저주 지속 %
    @Sync
    property number BonusCurseEff = 0        -- 수치형 저주 효과 %
    @Sync
    property number BonusMinionIas = 0       -- 소환수 공격 속도 %
    @Sync
    property number BonusMinionRes = 0       -- 소환수 모든 저항 %
    @Sync
    property string ElemDamage = ""          -- 무기 속성 피해 "fire=6,cold=4"
    @Sync
    property integer ResFire = 0
    @Sync
    property integer ResCold = 0
    @Sync
    property integer ResLight = 0
    @Sync
    property integer ResPoison = 0

    property table RawResists = {}           -- 장비 저항 합 (난이도 바뀌면 다시 계산)
    property number BaseSpeed = 0
    @Sync
    property number BoneArmor = 0            -- 뼈 갑옷 남은 흡수량 (docs/design/16, 버프 줄 표시)
    @Sync
    property number BoneArmorMax = 0
    @Sync
    property number ChillUntil = 0           -- 냉기 둔화가 끝나는 서버 시각 (버프 줄 표시용 동기화)
    @Sync
    property number ShockUntil = 0           -- 번개 연쇄에 맞은 표시가 끝나는 서버 시각 (버프 줄 「감전」 칩, 표시만)
    property integer RegenTimer = 0
    property number RegenCarry = 0           -- 생명 재생의 1 미만 나머지

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self.RawResists = { fire = 0, cold = 0, light = 0, poison = 0 }
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then self.BaseSpeed = movement.InputSpeed * _GameData.playerSpeedMul end
        self.ExpToNext = self:CalcExpToNext(self.Level)
        self:Recalculate(true)
        self.RegenTimer = _TimerService:SetTimerRepeat(function() self:Regen() end, 1)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.RegenTimer ~= 0 then _TimerService:ClearTimer(self.RegenTimer) end
    end

    -- ───────── 경험치·레벨 ─────────

    method integer CalcExpToNext(integer level)
        -- expToNext(n) = round(coef × n^exp)
        return math.floor(_GameData.expCurveCoef * (level ^ _GameData.expCurveExp) + 0.5)
    end

    @ExecSpace("ServerOnly")
    method void GainExp(integer amount)
        -- 여러 단계 레벨업 가능: 레벨마다 능력치·스킬 포인트, 생명·마나 회복
        local cap = math.floor(_GameData.levelCap)
        if self.Level >= cap or amount <= 0 then return end
        self.Exp = self.Exp + amount
        local leveled = false
        while self.Exp >= self.ExpToNext and self.Level < cap do
            self.Exp = self.Exp - self.ExpToNext
            self.Level = self.Level + 1
            self.StatPoints = self.StatPoints + math.floor(_GameData.statPerLevel)
            self.SkillPoints = self.SkillPoints + math.floor(_GameData.skillPerLevel)
            self.ExpToNext = self:CalcExpToNext(self.Level)
            leveled = true
        end
        if leveled then
            self:Recalculate(true)
            -- 주인 레벨까지 힘을 내는 그림자(본래 레벨이 더 높은 그림자)는 레벨업과 함께 강해진다
            ---@type ShadowCommander
            local commander = self.Entity:GetComponent("script.ShadowCommander")
            if commander ~= nil then commander:RefreshAllUnitStats() end
            self:NotifyLevelUp(self.Level, self.Entity.PlayerComponent.UserId)
        end
    end

    method number ShrineBonus(string kind)
        -- 그 종류의 신전 축복(MapShrine)이 지금 걸려 있으면 1, 아니면 0
        if self.ShrineKind ~= kind then return 0 end
        if _UtilLogic.ServerElapsedSeconds >= self.ShrineUntil then return 0 end
        return 1
    end

    @ExecSpace("ServerOnly")
    method integer ExpForKill(integer monsterLevel, integer grade)
        -- killExpCoef(15) × 레벨^1.3 × 등급 배율(1/3/12). 몬스터가 5레벨 이상 낮으면 감쇠, 10 이상이면 5%, 5레벨 넘게 높아도 감쇠
        local gradeMult = 1
        if grade == 2 then gradeMult = 3 elseif grade >= 3 then gradeMult = 12 end
        local base = _GameData.killExpCoef * (monsterLevel ^ 1.3) * gradeMult
        local diff = self.Level - monsterLevel
        if diff >= 10 then base = base * 0.05
        elseif diff >= 5 then base = base * (1 - (diff - 4) * 0.15) end
        -- 너무 높은 몬스터(내 레벨 +5 초과)는 경험치를 (내 레벨+5)/몬스터 레벨로 줄인다 — 높은 난이도로 건너뛰어 레벨을 날로 먹지 않게
        local grace = _GameConst.ExpHighMonsterGrace
        if monsterLevel > self.Level + grace then base = base * (self.Level + grace) / monsterLevel end
        -- 지혜의 신전: 경험치 +30%
        base = base * (1 + 0.3 * self:ShrineBonus("wisdom"))
        -- 초반 가속: 그림자 해금(Lv5) 전까지 처치 경험치를 올린다 (config earlyExpLevel·earlyExpMult)
        if self.Level < _GameData.earlyExpLevel then base = base * _GameData.earlyExpMult end
        -- 높은 레벨 몬스터 보정: 맵 레벨은 맵마다 1씩 오르는데 처치 경험치가 못 따라가 액트 3에서 7레벨까지 뒤처졌다 (10-13 W1)
        if monsterLevel > _GameData.expHighLevelFrom then base = base * (1 + _GameData.expHighLevelPct / 100 * (monsterLevel - _GameData.expHighLevelFrom)) end
        -- 같은 맵 인원 보정 (D2 players X — 몬스터 생명이 인원만큼 늘어난 대가, CoopRules · 10-13 X2)
        base = base * _CoopRules:ExpMul(self.Entity.CurrentMap)
        -- 몬스터 밀도 보정 (densityExpMult — 10-09에 1로: 넓은 맵 이동량 대비 레벨업이 느렸다. 드롭은 densityRewardMult 그대로)
        if grade < 3 then base = base * _GameData.densityExpMult end
        return math.max(1, math.floor(base + 0.5))
    end

    @ExecSpace("ServerOnly")
    method integer LoseExp(number pct)
        -- 사망 손실: 현재 레벨 구간 안에서만 (레벨은 내려가지 않음)
        if pct <= 0 then return 0 end
        local loss = math.min(math.floor(self.ExpToNext * pct / 100), self.Exp)
        self.Exp = self.Exp - loss
        return loss
    end

    @ExecSpace("Client")
    method void NotifyLevelUp(integer level)
        _UXFeedback:Show("레벨 업 · Lv " .. tostring(level), "능력치 +" .. tostring(math.floor(_GameData.statPerLevel)) .. " · 스킬 +" .. tostring(math.floor(_GameData.skillPerLevel)) .. "\n메뉴의 능력치·스킬에서 포인트를 쓰세요", _GameData:GetUiIcon("menu_char"))
        _SoundDirector:PlayEffect(_GameConst.SfxLevelUp, 0.8)
        _ParticleService:PlayBasicParticle(BasicParticleType.Buff, self.Entity, self.Entity.TransformComponent.WorldPosition, 0, Vector3(1, 1, 1), false, nil)
    end

    -- ───────── 생명·마나 ─────────

    @ExecSpace("ServerOnly")
    method void Recalculate(boolean fill)
        -- 최대 생명·마나 = 기본 + 레벨 + 능력치 + 장비. fill이면 가득, 아니면 비율 유지
        local pc = self.Entity.PlayerComponent
        local maxHp = math.floor(_GameData.playerBaseHp + (self.Level - 1) * _GameData.playerHpPerLevel + (self.Vit + self.BonusVit - 15) * _GameData.vitLife + self.BonusLife)
        local maxMana = _GameData.playerBaseMana + (self.Level - 1) * 2 + (self.Ene + self.BonusEne - 25) * _GameData.eneMana + self.BonusMana
        local hpRatio = 1
        if pc.MaxHp > 0 then hpRatio = pc.Hp / pc.MaxHp end
        local manaRatio = 1
        if self.MaxMana > 0 then manaRatio = self.Mana / self.MaxMana end
        pc.MaxHp = math.max(1, maxHp)
        self.MaxMana = math.max(1, maxMana)
        if fill then
            pc.Hp = pc.MaxHp
            self.Mana = self.MaxMana
        else
            pc.Hp = math.max(1, math.floor(pc.MaxHp * hpRatio))
            self.Mana = self.MaxMana * manaRatio
        end
    end

    @ExecSpace("ServerOnly")
    method void Regen()
        -- 마나: 초당 최대치 manaRegenPct + 정신 보정 / 생명: 초당 hpRegenPct + 장비 재생 (config.csv)
        -- 생명은 정수라 1 미만은 RegenCarry에 모았다가 채운다 (낮은 레벨에서 1씩 올라 너무 빨랐던 것 수정)
        local pc = self.Entity.PlayerComponent
        if not _Util:IsAlive(self.Entity) then return end
        self:RefreshSpeed()
        -- 가득 차 있으면 다시 쓰지 않는다 (@Sync — 10-13 3인 파티 끊김 점검)
        local mana = math.min(self.MaxMana, self.Mana + self.MaxMana * _GameData.manaRegenPct + (self.Ene + self.BonusEne) * _GameData.manaRegenPerEne)
        if mana ~= self.Mana then self.Mana = mana end
        if pc.Hp >= pc.MaxHp then
            self.RegenCarry = 0
            return
        end
        self.RegenCarry = self.RegenCarry + pc.MaxHp * _GameData.hpRegenPct + self.BonusRegen
        local add = math.floor(self.RegenCarry)
        if add <= 0 then return end
        self.RegenCarry = self.RegenCarry - add
        pc.Hp = math.min(pc.MaxHp, pc.Hp + add)
    end

    @ExecSpace("ServerOnly")
    method void ApplyPotionCurse(number seconds)
        -- 모래 미라에게 맞음: 물약 회복 -30% (새로 걸릴 때만 알림)
        local now = _UtilLogic.ServerElapsedSeconds
        if self.PotionCurseUntil < now then _Util:Warn("미라의 저주 — 물약 회복 -30% (5초)", self.Entity.PlayerComponent.UserId) end
        self.PotionCurseUntil = now + seconds
    end

    method number PotionMult()
        -- 물약 회복 배율 (미라 저주 중 0.7)
        if _UtilLogic.ServerElapsedSeconds < self.PotionCurseUntil then return 0.7 end
        return 1
    end

    @ExecSpace("ServerOnly")
    method void Heal(number hp, number mana)
        -- 물약·흡수 등 회복의 공통 진입점
        local pc = self.Entity.PlayerComponent
        if not _Util:IsAlive(self.Entity) then return end
        if hp > 0 then pc.Hp = math.min(pc.MaxHp, pc.Hp + math.floor(hp)) end
        if mana > 0 then self.Mana = math.min(self.MaxMana, self.Mana + mana) end
    end

    @ExecSpace("ServerOnly")
    method boolean SpendMana(number amount)
        if self.Mana < amount then return false end
        self.Mana = self.Mana - amount
        return true
    end

    @ExecSpace("ServerOnly")
    method void AddGold(integer amount)
        self.Gold = math.max(0, self.Gold + amount)
    end

    -- ───────── 장비 추가치 ─────────

    @ExecSpace("ServerOnly")
    method void ApplyEquipmentMods(table t)
        -- PlayerInventory가 장비 옵션 합계를 넘긴다 (키는 ItemData.StatName 참고)
        local function v(k) return t[k] or 0 end
        self.BonusDamage = v("dmgFlat")
        self.BonusDamagePct = v("dmgPct")
        self.BonusDefense = v("def")
        self.BonusLife = v("life")
        self.BonusMana = v("mana")
        self.BonusStr = math.floor(v("str"))
        self.BonusDex = math.floor(v("dex"))
        self.BonusVit = math.floor(v("vit"))
        self.BonusEne = math.floor(v("ene"))
        self.BonusMinionPct = v("minion")
        self.BonusExtractPct = v("extract")
        self.BonusMF = v("mf")
        self.BonusGF = v("gf")
        self.BonusRegen = v("regen")
        self.BonusDeploy = math.min(2, math.floor(v("deploy")))
        self.BonusShadowCap = math.min(math.floor(_GameData.shadowCapBonusMax), math.floor(v("shadowCap")))
        self.BonusLeech = v("leech")
        self.BonusMs = v("ms")
        self.BonusIas = v("ias")
        self.BonusFcr = v("fcr")
        self.BonusCurse = v("curse")
        self.BonusMinionPoison = v("minionPoison")
        self.BonusAllSkills = math.min(2, math.floor(v("allSkills")))
        self.BonusTreeCommand = math.min(3, math.floor(v("treeCommand")))
        self.BonusTreeSoul = math.min(3, math.floor(v("treeSoul")))
        self.BonusTreeCurse = math.min(3, math.floor(v("treeCurse")))
        local single = {}
        for k, n in pairs(t) do
            local id = string.match(k, "^sk_([%w_]+)$")
            if id ~= nil and math.floor(n) > 0 then table.insert(single, id .. "=" .. tostring(math.min(3, math.floor(n)))) end
        end
        table.sort(single)
        self.BonusSkillLv = table.concat(single, ",")
        self.BonusSpellDmg = v("spellDmg")
        self.BonusCurseDur = v("curseDur")
        self.BonusCurseEff = v("curseEff")
        self.BonusMinionIas = v("minionIas")
        self.BonusMinionRes = v("minionRes")
        local all = v("allRes")
        self.RawResists = { fire = v("fireRes") + all, cold = v("coldRes") + all, light = v("lightRes") + all, poison = v("poisonRes") + all }
        self:RefreshResists()
        local elem = {}
        for _, e in ipairs({ "fire", "cold", "light", "poison" }) do
            if v(e .. "Dmg") > 0 then table.insert(elem, e .. "=" .. tostring(math.floor(v(e .. "Dmg")))) end
        end
        self.ElemDamage = table.concat(elem, ",")
        self:RefreshSpeed()
        self:Recalculate(false)
    end

    -- ───────── 속성 ─────────

    method number GetAttackInterval(number base)
        -- 공격 속도(장갑·무기)만큼 기본 공격 간격이 짧아진다 (상한 iasCap)
        return base / (1 + self:GetIas() / 100)
    end

    method number GetCastCooldownMult()
        -- 시전 속도(반지·목걸이)만큼 스킬 재사용 대기가 짧아진다 (상한 fcrCap)
        return 1 / (1 + math.min(self:GetFcr(), _GameData.fcrCap) / 100)
    end

    method number GetFcr()
        -- 시전 속도 % = 장비 + 민첩 × dexFcrPct (10-11)
        return self.BonusFcr + (self.Dex + self.BonusDex) * _GameData.dexFcrPct
    end

    @ExecSpace("ServerOnly")
    method void RefreshResists()
        -- 장비 저항 - 난이도 페널티, 상한 resistCap, 하한 -100 (난이도가 바뀌면 다시 부른다)
        local penalty = _GameConst:ResistPenalty(self.Difficulty)
        local cap = _GameData.resistCap
        local raw = self.RawResists
        -- 의뢰 영구 보상 독 저항 (난이도 페널티 전에 더한다)
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        local questPoison = quest ~= nil and quest.PoisonBonus or 0
        local questLight = quest ~= nil and quest.LightBonus or 0
        self.ResFire = math.floor(math.max(-100, math.min(cap, (raw.fire or 0) - penalty)))
        self.ResCold = math.floor(math.max(-100, math.min(cap, (raw.cold or 0) - penalty)))
        self.ResLight = math.floor(math.max(-100, math.min(cap, (raw.light or 0) + questLight - penalty)))
        self.ResPoison = math.floor(math.max(-100, math.min(cap, (raw.poison or 0) + questPoison - penalty)))
    end

    method number GetResist(string element)
        if element == "fire" then return self.ResFire end
        if element == "cold" then return self.ResCold end
        if element == "light" then return self.ResLight end
        if element == "poison" then return self.ResPoison end
        return 0
    end

    method number GetElemDamage(string element)
        local v = string.match("," .. self.ElemDamage, "," .. element .. "=([%d%.]+)")
        if v == nil then return 0 end
        return tonumber(v)
    end

    -- ───────── 이동 속도 ─────────

    @ExecSpace("ServerOnly")
    method void RefreshSpeed()
        -- 기본 × (1 + 장비 %) × 냉기 둔화(0.6). 속도를 바꾸는 곳은 여기 하나. 바뀔 때만 쓴다
        -- (10-13 사용자 지적: 디버프 없이 갑자기 아주 느려졌다 → Regen이 1초마다 이걸 불러, 둔화 끝 복구 타이머를 놓쳐도 다시 맞춘다)
        local movement = self.Entity.MovementComponent
        if not isvalid(movement) or self.BaseSpeed <= 0 then return end
        local mult = 1 + self.BonusMs / 100
        -- 망령 걸음 「가벼운 걸음」 (10-20): 장비 이동 속도와 더한다
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then
            local step = book:GetPowerLevel("swift_step")
            if step > 0 then mult = mult + book:GetEffectPower("swift_step", step) / 100 end
        end
        if _UtilLogic.ServerElapsedSeconds < self.ChillUntil then mult = mult * 0.6 end
        local want = self.BaseSpeed * mult
        if math.abs(movement.InputSpeed - want) > 0.001 then
            if movement.InputSpeed < want * 0.9 then log(string.format("[VRF] speed restored %.2f → %.2f", movement.InputSpeed, want)) end
            movement.InputSpeed = want
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyChill(number seconds)
        -- 냉기 둔화 (냉기 저항만큼 시간 감소)
        local dur = seconds * math.max(0.2, 1 - self.ResCold / 100)
        self.ChillUntil = _UtilLogic.ServerElapsedSeconds + dur
        self:RefreshSpeed()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ServerElapsedSeconds >= self.ChillUntil then self:RefreshSpeed() end
        end, dur + 0.05)
    end

    -- ───────── 피해 계산 보조 ─────────

    method number GetMeleeDamage(number baseDamage)
        -- (기본 + 장비 추가) × (1 + 민첩 × dexMeleePct/100 + 장비 %) — 10-11: 힘(통솔)은 소환수 몫이 됐다
        return (baseDamage + self.BonusDamage) * (1 + (self.Dex + self.BonusDex) * _GameData.dexMeleePct / 100 + self.BonusDamagePct / 100)
    end

    method number GetMinionPct()
        -- 소환수 공격·생명 % = 장비 + 통솔(예전 힘)이 시작값 15를 넘은 만큼 × strMinionPct (docs/design/16)
        return self.BonusMinionPct + math.max(0, self.Str + self.BonusStr - 15) * _GameData.strMinionPct
    end

    method number GetSpellPowerPct()
        -- 영혼 스킬 피해 보너스: 정신 1당 eneSpellPct% + 장비 피해 % + 영혼 스킬 피해 % (docs/design/19)
        return (self.Ene + self.BonusEne) * _GameData.eneSpellPct + self.BonusDamagePct + self.BonusSpellDmg
    end

    method integer GetSkillLevelBonus(string id, string tree)
        -- 메인 스킬 하나에 더하는 장비 레벨: 모든 스킬(≤2) + 계열(≤3) + 단일 스킬(≤3) (docs/design/19)
        local bonus = self.BonusAllSkills
        if tree == "command" then bonus = bonus + self.BonusTreeCommand
        elseif tree == "soul" then bonus = bonus + self.BonusTreeSoul
        elseif tree == "curse" then bonus = bonus + self.BonusTreeCurse end
        local one = string.match("," .. self.BonusSkillLv, "," .. id .. "=(%d+)")
        if one ~= nil then bonus = bonus + tonumber(one) end
        return bonus
    end

    method number GetDefense()
        -- 방어 = 장비 + 민첩/dexPerDefense (D2 규칙). 물리 피해 감소 = 100/(100+방어)
        return self.BonusDefense + math.floor((self.Dex + self.BonusDex) / _GameData.dexPerDefense)
    end

    method number GetIas()
        -- 공격 속도 % = 장비 + 민첩 × dexIasPct (상한 iasCap)
        return math.min(_GameData.iasCap, self.BonusIas + (self.Dex + self.BonusDex) * _GameData.dexIasPct)
    end

    method number GetBasicCriticalChancePct()
        -- 민첩(장비 포함)은 평타 치명타 확률을 높인다. 소환수·주문에는 전이하지 않는다.
        return math.max(0, math.min(_GameData.basicCritChanceCap, (self.Dex + self.BonusDex) * _GameData.basicCritPerDex))
    end

    -- ───────── 요청 ─────────

    @ExecSpace("Server")
    method void RequestAddStat(string statName)
        -- 살아 있는 소유자만 투자한다. 사망 중 재계산으로 생명이 1이 되는 것을 막는다.
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.StatPoints <= 0 or not _Util:IsAlive(self.Entity) then return end
        if statName == "Str" then self.Str = self.Str + 1
        elseif statName == "Dex" then self.Dex = self.Dex + 1
        elseif statName == "Vit" then self.Vit = self.Vit + 1
        elseif statName == "Ene" then self.Ene = self.Ene + 1
        else return end
        self.StatPoints = self.StatPoints - 1
        self:Recalculate(false)
    end

    @ExecSpace("Server")
    method void RequestAutoStats(string preset)
        -- 추천 분배 (docs/design/16): 남은 포인트를 성향 비율대로 한 번에 나눈다. 소환형 통솔3·활력2 / 주문형 정신3·활력2 / 균형 통솔2·정신1·활력2
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.StatPoints <= 0 or not _Util:IsAlive(self.Entity) then return end
        local cycle = { summon = { "Str", "Vit", "Str", "Vit", "Str" }, spell = { "Ene", "Vit", "Ene", "Vit", "Ene" }, balance = { "Str", "Vit", "Ene", "Vit", "Str" } }
        local order = cycle[preset]
        if order == nil then return end
        local spent = 0
        while self.StatPoints > 0 do
            local stat = order[spent % #order + 1]
            if stat == "Str" then self.Str = self.Str + 1
            elseif stat == "Vit" then self.Vit = self.Vit + 1
            elseif stat == "Ene" then self.Ene = self.Ene + 1 end
            self.StatPoints = self.StatPoints - 1
            spent = spent + 1
        end
        self:Recalculate(false)
        log("[VRF] auto stats " .. preset .. " spent=" .. tostring(spent))
    end

    @ExecSpace("ServerOnly")
    method integer ResetStats()
        -- 능력치 초기화: 시작값(통솔 15 · 민첩 25 · 활력 15 · 정신 25)보다 올린 만큼 돌려준다 (돌려준 포인트 수)
        local refund = math.max(0, self.Str - 15) + math.max(0, self.Dex - 25) + math.max(0, self.Vit - 15) + math.max(0, self.Ene - 25)
        self.Str, self.Dex, self.Vit, self.Ene = 15, 25, 15, 25
        self.StatPoints = self.StatPoints + refund
        self:Recalculate(false)
        return refund
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method boolean HasFirstKill(string key)
        return string.find("," .. self.FirstKills .. ",", "," .. key .. ",", 1, true) ~= nil
    end

    @ExecSpace("ServerOnly")
    method void MarkFirstKill(string key)
        -- 보스·최상위 첫 처치 기록 ("sourceId@난이도", 저장됨)
        if self:HasFirstKill(key) then return end
        if self.FirstKills == "" then self.FirstKills = key else self.FirstKills = self.FirstKills .. "," .. key end
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        return { fk = self.FirstKills, lv = self.Level, exp = self.Exp, str = self.Str, dex = self.Dex, vit = self.Vit, ene = self.Ene, sp = self.StatPoints, skp = self.SkillPoints, gold = self.Gold, diff = self.Difficulty, maxDiff = self.MaxDifficulty }
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        if d == nil then return end
        self.Level = d.lv or 1
        self.Exp = d.exp or 0
        self.Str = d.str or 15
        self.Dex = d.dex or 25
        self.Vit = d.vit or 15
        self.Ene = d.ene or 25
        self.StatPoints = d.sp or 0
        self.SkillPoints = d.skp or 0
        self.Gold = d.gold or 0
        self.Difficulty = d.diff or 0
        self.MaxDifficulty = d.maxDiff or 0
        self.FirstKills = d.fk or ""
        self.ExpToNext = self:CalcExpToNext(self.Level)
        self:RefreshResists()
        self:Recalculate(true)
    end

end
