-- 플레이어 저장 관리자 (UserDataStorage, docs: msw-scripting datastorage 8장 패턴).
-- 키 3개: Char(레벨·능력치·골드·스킬) / Inv(가방·장비·포션) / Shadow(보관함·정수)
-- 입장 시 BatchGet 1회 → 각 컴포넌트에 적용. 2분마다 바뀐 키만 BatchSetAsync, 퇴장 시 BatchSetAndWait.
-- 바뀜 판단: 마지막으로 "저장 확인된" 문자열과 비교 (각 저장 호출이 자기가 보낸 문자열을 들고 간다)
@Component
script PlayerSave extends Component

    property number AutoSaveInterval = 120
    property number LoadDelay = 1.0
    property boolean IsLoadSuccess = false
    property table LastSaved = {}       -- key → 저장 확인된 문자열
    property integer TimerId = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 다른 컴포넌트가 기본값을 채운 뒤 불러온다
        self.LastSaved = {}
        _TimerService:SetTimerOnce(function() self:Load() end, self.LoadDelay)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Save(false) end, self.AutoSaveInterval, self.AutoSaveInterval)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ServerOnly")
    method any Storage()
        return _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
    end

    @ExecSpace("ServerOnly")
    method void Load()
        if not isvalid(self.Entity) then return end
        local ds = self:Storage()
        local code, pages = ds:BatchGetAndWait({ "Char", "Inv", "Shadow" })
        if code ~= 0 then
            log_error("[PlayerSave] 불러오기 실패 " .. tostring(code))
            return
        end
        local loaded = {}
        while true do
            local datas = pages:GetCurrentPageDatas()
            if datas == nil then break end
            for i = 1, #datas do loaded[datas[i].KeyInfo.Key] = datas[i].Value end
            if pages.IsLastPage then break end
            if pages:LoadNextPageAndWait() ~= 0 then
                log_error("[PlayerSave] 다음 페이지 실패")
                return
            end
            pages:MoveToNextPageAndWait()
        end
        local char = self:Decode(loaded["Char"])
        if char ~= nil then
            ---@type PlayerStats
            local stats = self.Entity:GetComponent("script.PlayerStats")
            if stats ~= nil then stats:LoadSaveData(char.stats) end
            ---@type SkillBook
            local book = self.Entity:GetComponent("script.SkillBook")
            if book ~= nil then book:LoadSaveData(char.skills) end
            ---@type PlayerQuest
            local quest = self.Entity:GetComponent("script.PlayerQuest")
            if quest ~= nil then quest:LoadSaveData(char.quest) end
            ---@type PlayerTravel
            local travel = self.Entity:GetComponent("script.PlayerTravel")
            if travel ~= nil then travel:LoadSaveData(char.travel) end
        end
        local inv = self:Decode(loaded["Inv"])
        if inv ~= nil then
            ---@type PlayerInventory
            local c = self.Entity:GetComponent("script.PlayerInventory")
            if c ~= nil then c:LoadSaveData(inv) end
        end
        local shadow = self:Decode(loaded["Shadow"])
        if shadow ~= nil then
            ---@type ShadowOwner
            local c = self.Entity:GetComponent("script.ShadowOwner")
            if c ~= nil then c:LoadSaveData(shadow) end
        end
        for k, v in pairs(loaded) do self.LastSaved[k] = v end
        -- 처음 온 플레이어는 마을(잿불 야영지)에서 시작한다 (시작 맵 설정은 사냥터)
        if char == nil then
            log("[PlayerSave] 첫 접속 → 마을로 이동")
            _TeleportService:TeleportToMapPosition(self.Entity, Vector3(0, -1.2, 0), "town")
        end
        self.IsLoadSuccess = true
        local lv = 1
        if char ~= nil and char.stats ~= nil then lv = char.stats.lv or 1 end
        log(string.format("[PlayerSave] 불러오기 완료 (키 %d개, Lv%d)", self:Count(loaded), lv))
    end

    @ExecSpace("ServerOnly")
    method any Decode(any raw)
        if raw == nil or raw == "" then return nil end
        local ok, t = pcall(function() return _HttpService:JSONDecode(raw) end)
        if ok then return t end
        log_error("[PlayerSave] 해석 실패")
        return nil
    end

    @ExecSpace("ServerOnly")
    method integer Count(table t)
        local n = 0
        for _ in pairs(t) do n = n + 1 end
        return n
    end

    @ExecSpace("ServerOnly")
    method table Collect()
        -- 현재 상태 → key별 JSON 문자열
        local out = {}
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if stats ~= nil and book ~= nil then
            local travelData = nil
            ---@type PlayerTravel
            local travel = self.Entity:GetComponent("script.PlayerTravel")
            if travel ~= nil then travelData = travel:GetSaveData() end
            local questData = nil
            ---@type PlayerQuest
            local quest = self.Entity:GetComponent("script.PlayerQuest")
            if quest ~= nil then questData = quest:GetSaveData() end
            out["Char"] = _HttpService:JSONEncode({ v = 1, stats = stats:GetSaveData(), skills = book:GetSaveData(), quest = questData, travel = travelData })
        end
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if inv ~= nil then out["Inv"] = _HttpService:JSONEncode(inv:GetSaveData()) end
        ---@type ShadowOwner
        local owner = self.Entity:GetComponent("script.ShadowOwner")
        if owner ~= nil then out["Shadow"] = _HttpService:JSONEncode(owner:GetSaveData()) end
        return out
    end

    @ExecSpace("ServerOnly")
    method void Save(boolean isLeaving)
        -- 불러오기 전에는 절대 저장하지 않는다 (빈 기본값으로 덮어쓰기 방지)
        if not self.IsLoadSuccess or not isvalid(self.Entity) then return end
        local all = self:Collect()
        local changed = {}
        for k, v in pairs(all) do
            if self.LastSaved[k] ~= v then changed[k] = v end
        end
        if next(changed) == nil then return end
        local ds = self:Storage()
        if isLeaving then
            local code, ok = ds:BatchSetAndWait(changed)
            self:OnSaved(changed, ok)
            if code ~= 0 then log_error("[PlayerSave] 퇴장 저장 실패 " .. tostring(code)) end
        else
            ds:BatchSetAsync(changed, function(code, ok)
                self:OnSaved(changed, ok)
                if code ~= 0 then log_warning("[PlayerSave] 자동 저장 실패 " .. tostring(code)) end
            end)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnSaved(table sent, any successKeys)
        -- 저장이 확인된 키만 "마지막 저장값"으로 기록
        local n = 0
        for i = 1, #successKeys do
            local k = successKeys[i]
            if sent[k] ~= nil then
                self.LastSaved[k] = sent[k]
                n = n + 1
            end
        end
        log("[PlayerSave] 저장 " .. tostring(n) .. "개 키")
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        if event.UserId ~= self.Entity.PlayerComponent.UserId then return end
        if self.TimerId ~= 0 then
            _TimerService:ClearTimer(self.TimerId)
            self.TimerId = 0
        end
        self:Save(true)
    end

end
