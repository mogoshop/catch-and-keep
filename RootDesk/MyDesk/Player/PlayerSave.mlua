-- 플레이어 저장 관리자 (UserDataStorage, msw-scripting datastorage 8장 패턴). 계정당 캐릭터 슬롯 MaxSlots(4) + 계정 공용 창고.
-- 저장 키:
--   Account  : 슬롯 요약 { v, slots = { ["1"] = { name, lv, diff, created }, ... } } — 캐릭터 선택 창(CharSelectWindow)
--   Stash    : 계정 공용 창고 { v, items }
--   Char_N   : N번 캐릭터 stats·skills·quest·travel·settings·journal
--   Inv_N    : inv·belt·corpses
--   Shadow_N : shadow
-- 슬롯이 생기기 전 저장(Char·Inv·Shadow)은 지우지 않고 1번 캐릭터로 옮긴다 (그 캐릭터 첫 저장 때 Char_1… 생성, 원본은 백업으로 남는다).
-- 입장: Account·Stash 읽기 → 선택 창 → 고른 슬롯 3키만 읽기. 심도 같은 방 이동은 고른 슬롯을 이어서 불러온다 (MarkSlotTravel).
-- 캐릭터 삭제는 슬롯 목록에서만 뺀다 (저장 데이터는 남겨 두고, 그 칸에 새 캐릭터를 만들면 덮어쓴다).
-- 2분마다 바뀐 키만 BatchSetAsync, 퇴장·인스턴스 이동 전 BatchSetAndWait. 바뀜 판단 = 마지막으로 "저장 확인된" 문자열과 비교
@Component
script PlayerSave extends Component

    property integer Version = 2
    property number AutoSaveInterval = 120
    property number LoadDelay = 1.0
    property boolean IsLoadSuccess = false
    property table LastSaved = {}
    property integer TimerId = 0
    property integer AudioSaveTimer = 0
    property table AudioSettings = { bgm = 55, effects = 100, ambience = 100 }
    @Sync
    property string AudioDigest = ""
    @Sync
    property string AudioSavedDigest = ""
    @TargetUserSync property integer PetFilter = 2   -- 고양이 재가 주워 올 물건 (PetSystem.Wants: 0 쉬기 · 1 전부 · 2 쓸 만한 것 · 3 희귀 이상 · 4 유니크·세트·룬), Char.settings에 함께 저장
    property integer MaxSlots = 4
    @Sync
    property integer Slot = 0                 -- 고른 캐릭터 슬롯 (0 = 아직 안 고름)
    @Sync
    property boolean BootDone = false         -- 첫 진입 준비 끝 (선택 창을 띄웠거나 캐릭터를 다 불러왔다) → 로딩 화면을 끈다
    @Sync
    property boolean Selecting = false        -- 캐릭터 선택 창을 띄울 때 (CharSelectWindow)
    @Sync
    property string SlotDigest = ""           -- "번호|이름|레벨|난이도|외형;…" (빈 슬롯은 번호만 · 외형 "m-1-1" = 성별-머리 색-눈 색)
    property table Account = {}
    property table StashItems = {}
    property table StashCounts = {}            -- 창고 탭별 개수 (v2 · 4탭 × 100칸)
    property table Grail = {}                  -- 아이템 도감 key 목록 (계정 공용 · Account 키의 grail)
    @Sync
    property boolean GuideSeen = false         -- 게임 안내를 본 계정 (Account 키의 guide) — 첫 진입 때 한 번만 저절로 띄운다 (GuideWindow)
    @Sync
    property integer InputMode = 0            -- PC 이동 방식 (Account 키의 input): 0 아직 안 고름 · 1 마우스 · 2 키보드 — 첫 진입 때 고른다 (GuideWindow)
    @Sync
    property string GuideCards = ""            -- 본 상황 안내 카드 키 ","로 (Account 키의 cards) — 그림자 해금·첫 그림자·군단 확장 (GuideCoach)
    property string SlotMemoryName = "CharSlotV1"
    property string PendingRoom = ""           -- 다른 채널의 방을 골라 워프해 왔다 → 로비에 도착하면 그 방으로 (RoomSystem.OnLobbyReady)
    property boolean InSelectRoom = false      -- 메뉴 「캐릭터 선택으로」로 온 선택용 인스턴스 방 (고르면 정적 방으로 돌아간다)
    property boolean Switching = false         -- 방 이동을 요청한 뒤 (중복 요청 막기)

    method table Sections()
        -- 불러오는 순서가 중요하다: 능력치 → 소지품(장착 효과가 능력치에 반영) 순. key = 고른 슬롯의 키, base = 이전 형식 이름
        local sfx = "_" .. tostring(self.Slot)
        return {
            { key = "Char" .. sfx, base = "Char", parts = { { "stats", "script.PlayerStats" }, { "skills", "script.SkillBook" }, { "quest", "script.PlayerQuest" }, { "travel", "script.PlayerTravel" }, { "settings", "script.PlayerSave" }, { "journal", "script.PlayerJournal" } } },
            { key = "Inv" .. sfx, base = "Inv", parts = { { "inv", "script.PlayerInventory" }, { "belt", "script.PlayerBelt" }, { "corpses", "script.PlayerCorpses" } } },
            { key = "Shadow" .. sfx, base = "Shadow", parts = { { "shadow", "script.ShadowOwner" } } },
        }
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self.LastSaved = {}
        self.AudioDigest = ""
        self.AudioSavedDigest = ""
        self.AudioSettings = { bgm = 55, effects = 100, ambience = 100 }
        _TimerService:SetTimerOnce(function() self:Load() end, self.LoadDelay)
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Save(false) end, self.AutoSaveInterval, self.AutoSaveInterval)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        self:CancelAudioSave()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ServerOnly")
    method any Storage()
        return _DataStorageService:GetUserDataStorage(self.Entity.PlayerComponent.ProfileCode)
    end

    -- ───────── 불러오기 ─────────

    @ExecSpace("ServerOnly")
    method void Load()
        -- 1) 계정(슬롯 요약)·공용 창고 → 2) 방 이동 중이면 그 슬롯을 바로, 아니면 캐릭터 선택 창
        if not isvalid(self.Entity) then return end
        local first = self:BatchGet({ "Account", "Stash" })
        if first == nil then return end
        local account = self:Decode(first["Account"])
        local stash = self:Decode(first["Stash"])
        if (first["Account"] ~= nil and first["Account"] ~= "" and account == nil) or (first["Stash"] ~= nil and first["Stash"] ~= "" and stash == nil) then
            self:Protect()
            return
        end
        if account == nil then
            -- 처음 슬롯을 쓰는 계정: 이전 저장(Char·Inv·Shadow)이 있으면 1번 캐릭터로 옮긴다
            account = { v = 1, slots = {} }
            local legacy = self:BatchGet({ "Char", "Inv", "Shadow" })
            if legacy == nil then return end
            if legacy["Char"] ~= nil and legacy["Char"] ~= "" then
                local char = self:Decode(legacy["Char"])
                if char == nil then
                    self:Protect()
                    return
                end
                local st = char.stats or {}
                -- legacy = 1: 슬롯 키(Char_1…)가 아직 없으니 이전 키에서 읽는다 — 세 키가 모두 저장되면 표시를 끈다 (OnSaved · 이전 키 자체는 되돌리기용으로 남겨 둔다)
                account.slots["1"] = { name = self:DefaultName(1), lv = tonumber(st.lv) or 1, diff = tonumber(st.diff) or 0, created = DateTime.UtcNow.Elapsed, legacy = 1 }
                if stash == nil then
                    local inv = self:Migrate("Inv", self:Decode(legacy["Inv"]))
                    if inv ~= nil and inv.inv ~= nil and inv.inv.stash ~= nil then stash = { v = 1, items = inv.inv.stash } end
                end
                log("[VRF] slots: 이전 저장을 1번 캐릭터로 옮김 lv=" .. tostring(account.slots["1"].lv))
            end
        end
        if type(account.slots) ~= "table" then account.slots = {} end
        self.Account = account
        self.Grail = {}
        if type(account.grail) == "table" then for _, key in ipairs(account.grail) do table.insert(self.Grail, key) end end
        self.GuideSeen = tonumber(account.guide) == 1
        self.InputMode = math.floor(tonumber(account.input) or 0)
        self.GuideCards = type(account.cards) == "string" and account.cards or ""
        self.StashItems = {}
        self.StashCounts = {}
        if stash ~= nil and type(stash.items) == "table" then for _, x in ipairs(stash.items) do table.insert(self.StashItems, x) end end
        if stash ~= nil and type(stash.counts) == "table" then for _, c in ipairs(stash.counts) do table.insert(self.StashCounts, tonumber(c) or 0) end end
        if first["Account"] ~= nil then self.LastSaved["Account"] = first["Account"] end
        if first["Stash"] ~= nil then self.LastSaved["Stash"] = first["Stash"] end
        self:PublishSlots()
        local slot = self:TakeSlotTravel()
        if slot == 0 then slot = self:TakeWarpSlot() end
        if slot > 0 and self:SlotInfo(slot) ~= nil then
            self:LoadSlot(slot)
            return
        end
        -- 캐릭터를 고르는 동안은 보통 야영지에 둔다 (월드 시작 맵은 사냥터). slot -1 = 메뉴에서 온 선택용 방
        self.InSelectRoom = slot < 0 and _RoomService:IsInstanceRoom()
        self.Selecting = true
        self.BootDone = true
        -- 10-21 방 구조: 캐릭터는 로비(정적 방 map01)에서 고른다 — 마을은 게임 방 안에 있다 (docs/design/30)
        log("[VRF] slots: 캐릭터 선택 대기 " .. self.SlotDigest)
    end

    @ExecSpace("ServerOnly")
    method void Protect()
        -- 깨진 저장을 기본 캐릭터로 덮어쓰지 않는다
        self.IsLoadSuccess = false
        _Util:Notify("저장 데이터를 읽지 못했습니다. 기존 데이터 보호를 위해 저장을 중단합니다", self.Entity.PlayerComponent.UserId)
    end

    method string DefaultName(integer slot)
        local nick = self.Entity.PlayerComponent.Nickname
        if nick == nil or nick == "" then nick = "망자" end
        if slot <= 1 then return nick end
        return nick .. " " .. tostring(slot)
    end

    method string CharName()
        -- 지금 캐릭터 이름 (캐릭터 선택에서 지은 이름, 없으면 계정 닉네임)
        local info = self.Slot > 0 and self:SlotInfo(self.Slot) or nil
        if info ~= nil and info.name ~= nil and info.name ~= "" then return tostring(info.name) end
        return self.Entity.PlayerComponent.Nickname
    end

    method string LookOf(any info)
        -- 슬롯 외형 (예전 캐릭터는 지금 기본 외형 = 남·검은 머리·보라 눈)
        if info == nil or type(info.look) ~= "string" or info.look == "" then return "m-1-1" end
        return info.look
    end

    method string Look()
        -- 지금 캐릭터 외형 (PlayerInventory.ApplyAppearance)
        return self:LookOf(self.Slot > 0 and self:SlotInfo(self.Slot) or nil)
    end

    method any SlotInfo(integer slot)
        if type(self.Account.slots) ~= "table" then return nil end
        return self.Account.slots[tostring(slot)]
    end

    @ExecSpace("ServerOnly")
    method void PublishSlots()
        -- 선택 창용 요약: "1|이름|레벨|난이도;2;3|…"  (이름의 | ; 는 저장할 때 걸러진다)
        local parts = {}
        for i = 1, self.MaxSlots do
            local info = self:SlotInfo(i)
            if info == nil then table.insert(parts, tostring(i))
            else table.insert(parts, table.concat({ tostring(i), tostring(info.name or ""), tostring(math.floor(tonumber(info.lv) or 1)), tostring(math.floor(tonumber(info.diff) or 0)), self:LookOf(info) }, "|")) end
        end
        self.SlotDigest = table.concat(parts, ";")
    end

    @ExecSpace("ServerOnly")
    method void LoadSlot(integer slot)
        -- 고른 캐릭터의 3키를 읽어 컴포넌트에 넣는다. 이전 저장에서 옮긴 캐릭터(legacy)는 슬롯 키가 생길 때까지 이전 키를 읽는다
        self.Slot = slot
        local info = self:SlotInfo(slot)
        local fromLegacy = info ~= nil and info.legacy ~= nil
        local keys = {}
        for _, sec in ipairs(self:Sections()) do table.insert(keys, fromLegacy and sec.base or sec.key) end
        local raw = self:BatchGet(keys)
        if raw == nil then
            self.Slot = 0
            return
        end
        local loaded = {}
        for _, sec in ipairs(self:Sections()) do loaded[sec.key] = raw[fromLegacy and sec.base or sec.key] end
        local decoded = {}
        for _, sec in ipairs(self:Sections()) do
            local raw = loaded[sec.key]
            local data = self:Decode(raw)
            if raw ~= nil and raw ~= "" and data == nil then
                self.Slot = 0
                self:Protect()
                return
            end
            decoded[sec.key] = data
        end
        -- 공용 창고를 먼저 넣는다 (가방이 가득 차 지급품이 창고로 가는 경우 뒤에서 덮어쓰지 않게)
        self:ApplyStash()
        for _, sec in ipairs(self:Sections()) do
            local data = self:Migrate(sec.base, decoded[sec.key])
            if data ~= nil then
                for _, part in ipairs(sec.parts) do
                    local comp = self.Entity:GetComponent(part[2])
                    if comp ~= nil then comp:LoadSaveData(data[part[1]]) end
                end
            end
        end
        -- 이전 저장에서 옮긴 경우 슬롯 키 내용과 다르므로 "저장된 값"으로 기억하지 않는다 → 첫 저장에서 Char_1… 생성
        if not fromLegacy then for k, v in pairs(loaded) do self.LastSaved[k] = v end end
        self:FinishLoad(false)
    end

    @ExecSpace("ServerOnly")
    method void ApplyStash()
        -- 계정 공용: 아이템 도감 → 창고 (창고를 넣으며 도감에 없던 것을 더한다)
        ---@type PlayerJournal
        local journal = self.Entity:GetComponent("script.PlayerJournal")
        if journal ~= nil then journal:LoadGrail(self.Grail) end
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if inv ~= nil then inv:LoadStash(self.StashItems, self.StashCounts) end
    end

    @ExecSpace("ServerOnly")
    method void FinishLoad(boolean isNew)
        -- 불러오기 마무리: 저장 허용 → 선택 창 닫기 → 마을/이어하기·소환수·심도 이동 이어가기
        self.IsLoadSuccess = true
        self.Selecting = false
        self.BootDone = true
        -- 머리 위 이름표 = 지금 캐릭터 이름 (10-23: 엔진 기본값인 계정 닉네임이 남아 예전 이름이 보였다 · 파티 목록은 캐릭터 이름)
        local tag = self.Entity.NameTagComponent
        if isvalid(tag) then tag.Name = self:CharName() end
        self.AudioDigest = self:AudioKey(self.AudioSettings)
        self.AudioSavedDigest = self.AudioDigest
        -- 의뢰 진행까지 불러온 뒤 난이도별 웨이포인트·열린 액트를 다시 맞춘다 (웨이포인트 창 난이도 미리보기)
        ---@type PlayerTravel
        local travelInfo = self.Entity:GetComponent("script.PlayerTravel")
        if travelInfo ~= nil then
            travelInfo:SyncDiffInfo()
            travelInfo:MigrateScrolls()   -- 10-11: 귀환 두루마리가 가방 물건이 됐다
        end
        -- 10-21 방 구조: 게임 방에 막 들어왔으면 그 액트 마을의 도착 자리로 (방 이동은 맵의 기본 자리에 놓는다).
        -- 로비면 아래에서 심연 이어가기 → 돌아갈 게임 방 → 방 창 (RoomSystem.OnLobbyReady)
        local roomKind = _GameConst:RoomKind()
        if roomKind == "game" then
            ---@type PlayerTravel
            local travel = self.Entity:GetComponent("script.PlayerTravel")
            local map = self.Entity.CurrentMap
            if travel ~= nil and isvalid(map) and _GameConst:IsTown(map) then travel:Go(map.Name, _GameConst:GetTownArrival()) end
        end
        -- 10-11 스킬·능력치 개편 전 저장이면 포인트를 모두 돌려준다 (docs/design/16)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then book:MigrateRework() end
        _UndeadSystem:RestoreRoomTravel(self.Entity)
        local continuing = self:ContinueDepthTravel()
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        if quest ~= nil then quest:OnLoadFinished() end
        local me = self.Entity
        if roomKind == "game" then _RankingSystem:RecordProgressLater(me) end   -- 성장 순위 (10-24): 레벨이 그대로인 사람도 들어올 때 한 번 적는다
        if roomKind == "lobby" and not continuing then
            -- 로비: 돌아갈 방·워프로 고른 방이 없으면 방 창. 채널 상한(+방 예약 자리) 초과 확인은 방을 고르기 전에만 (출시 환경 전용 · ChannelSystem)
            local joining = self.PendingRoom ~= ""
            _RoomSystem:OnLobbyReady(me)
            if not joining then _TimerService:SetTimerOnce(function() if isvalid(me) and self.IsLoadSuccess and _GameConst:RoomKind() == "lobby" then _ChannelSystem:CheckOverflow(me) end end, 3) end
        end
        log("[PlayerSave] 불러오기 완료 (슬롯 " .. tostring(self.Slot) .. ", 새 캐릭터 " .. tostring(isNew) .. ")")
    end

    -- ───────── 캐릭터 선택 (CharSelectWindow) ─────────

    @ExecSpace("Server")
    method void RequestSelectSlot(integer slot)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.Selecting then return end
        if slot < 1 or slot > self.MaxSlots or self:SlotInfo(slot) == nil or self.Switching then return end
        if self.InSelectRoom then
            self:LeaveSelectRoom(slot)
            return
        end
        self:LoadSlot(slot)
    end

    @ExecSpace("Server")
    method void RequestCreateSlot(integer slot, string name, string look)
        -- 빈 칸에 새 캐릭터: 이름·외형(성별·머리 색·눈 색)을 정해 기본 상태로 시작하고 곧바로 저장해 슬롯을 확정한다
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.Selecting then return end
        if slot < 1 or slot > self.MaxSlots or self:SlotInfo(slot) ~= nil or self.Switching then return end
        local clean = self:CleanName(name)
        if clean == "" then clean = self:DefaultName(slot) end
        local parsed = _GameData:ParseLook(look)   -- 잘못된 값은 기본으로
        local safeLook = parsed.g .. "-" .. tostring(parsed.h) .. "-" .. tostring(parsed.f)
        self.Account.slots[tostring(slot)] = { name = clean, lv = 1, diff = 0, created = DateTime.UtcNow.Elapsed, look = safeLook }
        self.Slot = slot
        self:PublishSlots()
        self:ApplyStash()
        -- 첫 장비: 망자를 부르는 등불 (예전 첫 의뢰 보상 — 10-10 의뢰 개편으로 시작 장비가 됐다)
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if inv ~= nil then
            inv:PutBagItems({ _GameConst.StarterLamp })
            inv:ApplyAppearance()   -- 고른 외형을 바로 입힌다
        end
        if self.InSelectRoom then
            -- 선택용 방: 기본 상태를 저장해 슬롯을 확정하고 정적 방에서 새로 불러온다
            self.IsLoadSuccess = true
            self:Save(true)
            _Util:Notify("새 캐릭터 「" .. clean .. "」", senderUserId)
            self:LeaveSelectRoom(slot)
            return
        end
        self:FinishLoad(true)
        self:Save(true)
        _Util:Notify("새 캐릭터 「" .. clean .. "」", senderUserId)
    end

    @ExecSpace("Server")
    method void RequestCharSelect()
        -- 메뉴 「캐릭터 선택으로」: 지금 캐릭터를 저장하고 선택용 인스턴스 방으로 옮긴다.
        -- 방을 옮기면 플레이어 엔티티가 새로 만들어지므로 이전 캐릭터의 상태(소환수·버프·쿨타임)가 남지 않는다
        local uid = self.Entity.PlayerComponent.UserId
        if senderUserId ~= uid or not self.IsLoadSuccess or self.Selecting or self.Switching or self.Slot <= 0 then return end
        if not _Util:IsAlive(self.Entity) then
            _Util:Notify("쓰러진 상태에서는 캐릭터를 바꿀 수 없다", uid)
            return
        end
        self:Save(true)
        for k, v in pairs(self:Collect()) do
            if self.LastSaved[k] ~= v then
                _Util:Notify("저장에 실패해 캐릭터 선택으로 가지 않았다. 잠시 뒤 다시 시도하세요", uid)
                return
            end
        end
        self.IsLoadSuccess = false   -- 옮기는 동안 더 저장하지 않는다 (이미 저장됨)
        self.Switching = true
        self:MarkTravel(-1)
        if _RoomService:IsInstanceRoom() then
            -- 게임 방 → 로비에서 고른다 (인스턴스 방끼리는 바로 못 옮긴다). 로비 Load가 -1을 받아 선택 창을 연다
            _RoomSystem:ClearReturn(uid)
            local moved = _RoomService:MoveUsersToStaticRoom({ uid }, _GameConst.MapLobby)
            if moved == nil or moved == 0 then
                self:TakeSlotTravel()
                self.IsLoadSuccess = true
                self.Switching = false
                _Util:Notify("캐릭터 선택으로 이동하지 못했다. 잠시 뒤 다시 시도하세요", uid)
            end
            log("[VRF] slots: 게임 방 → 로비 캐릭터 선택 moved=" .. tostring(moved))
            return
        end
        -- 인스턴스 방에는 인스턴스 맵만 쓸 수 있다 → 심도 맵을 배경으로 (룸 키가 "depth:"가 아니면 DepthDirector는 아무것도 하지 않는다)
        local key = "charsel:" .. uid
        local ok, moved = pcall(function()
            _RoomService:CreateInstanceRoom(key, { _GameConst.MapDepth }, 30)
            return _RoomService:MoveUserToInstanceRoom(key, uid, _GameConst.MapDepth)
        end)
        if not ok or not moved then
            self:TakeSlotTravel()
            self.IsLoadSuccess = true
            self.Switching = false
            _Util:Notify("캐릭터 선택으로 이동하지 못했다. 잠시 뒤 다시 시도하세요", uid)
            return
        end
        log("[VRF] slots: 캐릭터 선택 방으로 이동 (슬롯 " .. tostring(self.Slot) .. " 저장)")
    end

    @ExecSpace("ServerOnly")
    method void LeaveSelectRoom(integer slot)
        -- 선택용 방에서 고른 캐릭터로: 정적 방(그 캐릭터 난이도의 마을)으로 돌아가며 그 슬롯을 바로 불러온다
        local uid = self.Entity.PlayerComponent.UserId
        local info = self:SlotInfo(slot)
        self.Switching = true
        self:MarkTravel(slot)
        local town = _GameConst.MapLobby   -- 10-21: 로비로 돌아가 그 캐릭터를 불러온 뒤 방을 고른다
        local ok, moved = pcall(function() return _RoomService:MoveUserToStaticRoom(uid, town) end)
        if not ok or not moved then
            self:TakeSlotTravel()
            self.Switching = false
            _Util:Notify("이동하지 못했다. 다시 골라 주세요", uid)
            return
        end
        log("[VRF] slots: 선택 방 → " .. town .. " (슬롯 " .. tostring(slot) .. ")")
    end

    @ExecSpace("Server")
    method void RequestDeleteSlot(integer slot)
        -- 슬롯 목록에서만 뺀다 (저장 데이터는 남는다 — 그 칸에 새 캐릭터를 만들면 덮어쓴다)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.Selecting then return end
        local info = self:SlotInfo(slot)
        if info == nil then return end
        self.Account.slots[tostring(slot)] = nil
        self:PublishSlots()
        local json = self:AccountJson()
        local code, ok = self:Storage():BatchSetAndWait({ Account = json })
        if code == 0 then self.LastSaved["Account"] = json else log_error("[PlayerSave] 슬롯 삭제 저장 실패 " .. tostring(code)) end
        _Util:Notify("캐릭터 「" .. tostring(info.name) .. "」 삭제", senderUserId)
    end

    method string CleanName(string name)
        -- 이름: 앞뒤 공백 제거, 구분 문자(| ;) 제거, 최대 10글자
        local s = string.gsub(name or "", "[|;\n\r\t]", "")
        s = string.gsub(s, "^%s+", "")
        s = string.gsub(s, "%s+$", "")
        return _UIKit:Clip(s, 10)
    end

    -- ───────── 방 이동 (심도) 때 고른 슬롯 이어가기 ─────────

    @ExecSpace("ServerOnly")
    method void MarkSlotTravel()
        -- 방을 옮기기 직전에 부른다 → 목적지 방의 Load가 선택 창 없이 같은 캐릭터를 불러온다 (2분 안)
        if self.Slot <= 0 then return end
        self:MarkTravel(self.Slot)
    end

    @ExecSpace("ServerOnly")
    method void MarkTravel(integer slot)
        -- slot > 0: 그 캐릭터를 바로 불러오기 / -1: 선택용 방 (선택 창)
        local code, memory = _RoomService:GetSharedMemory(self.SlotMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil then return end
        memory:SetVariableAndWait(self.Entity.PlayerComponent.UserId, _HttpService:JSONEncode({ slot = slot, created = DateTime.UtcNow.Elapsed }))
    end

    @ExecSpace("ServerOnly")
    method integer TakeSlotTravel()
        local code, memory = _RoomService:GetSharedMemory(self.SlotMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil then return 0 end
        local uid = self.Entity.PlayerComponent.UserId
        local result = memory:GetVariableAndWait(uid)
        if result.Code ~= SharedMemoryResultCode.OK or result.Info == nil then return 0 end
        memory:DeleteVariableAndWait(uid)
        local ok, data = pcall(function() return _HttpService:JSONDecode(result.Info.Value) end)
        if not ok or type(data) ~= "table" or type(data.created) ~= "number" or DateTime.UtcNow.Elapsed - data.created > 120000 then return 0 end
        return math.floor(tonumber(data.slot) or 0)
    end

    @ExecSpace("ServerOnly")
    method integer TakeWarpSlot()
        -- 채널 이동(월드 인스턴스 워프)으로 왔으면 워프 데이터의 슬롯을 바로 불러온다 (2분 안). 방 공유 메모리는 인스턴스마다 따로라 워프 데이터로 넘긴다
        local ok, record = pcall(function() return _TeleportService:GetWarpRecord(self.Entity.PlayerComponent.UserId) end)
        if not ok or record == nil or record.Data == nil or record.Data == "" then return 0 end
        local okData, data = pcall(function() return _HttpService:JSONDecode(record.Data) end)
        if not okData or type(data) ~= "table" or (data.kind ~= "channel" and data.kind ~= "room") or type(data.created) ~= "number" then return 0 end
        if DateTime.UtcNow.Elapsed - data.created > 120000 then return 0 end
        if data.kind == "room" and type(data.room) == "string" then self.PendingRoom = data.room end   -- 다른 채널의 방을 골라 왔다
        log("[VRF] channel: 워프로 도착 → 슬롯 " .. tostring(data.slot))
        return math.floor(tonumber(data.slot) or 0)
    end

    @ExecSpace("ServerOnly")
    method boolean WarpToChannel(string instanceId, string roomId)
        -- 채널 이동 (ChannelSystem.RequestMove): 지금 캐릭터를 저장하고 그 월드 인스턴스로 워프한다. 도착하면 TakeWarpSlot이 같은 캐릭터를 불러온다.
        -- 되살린 언데드·버프는 캐릭터 선택과 같이 이어지지 않는다 (그림자 군단은 저장돼 있다)
        local uid = self.Entity.PlayerComponent.UserId
        if not self.IsLoadSuccess or self.Selecting or self.Switching or self.Slot <= 0 then return false end
        if not _Util:IsAlive(self.Entity) then
            _Util:Notify("쓰러진 상태에서는 채널을 옮길 수 없다", uid)
            return false
        end
        self:Save(true)
        for k, v in pairs(self:Collect()) do
            if self.LastSaved[k] ~= v then
                _Util:Notify("저장에 실패해 채널을 옮기지 않았다. 잠시 뒤 다시 시도하세요", uid)
                return false
            end
        end
        self.IsLoadSuccess = false   -- 옮기는 동안 더 저장하지 않는다 (이미 저장됨)
        self.Switching = true
        -- roomId가 있으면 도착한 채널의 로비에서 그 방으로 바로 들어간다 (RoomSystem.RequestJoin)
        local data = _HttpService:JSONEncode({ kind = roomId ~= "" and "room" or "channel", room = roomId, slot = self.Slot, created = DateTime.UtcNow.Elapsed })
        local ok, moved = pcall(function() return _TeleportService:WarpUserToWorldInstanceAndWait(uid, instanceId, data) end)
        if not ok or not moved then
            -- 메이커는 nil (출시 환경 전용). 실패하면 이 자리에서 계속 논다
            self.IsLoadSuccess = true
            self.Switching = false
            _Util:Notify("채널을 옮기지 못했다 (가득 찼거나 닫히는 채널). 다른 채널을 고르세요", uid)
            log("[VRF] channel: 워프 실패 ok=" .. tostring(ok) .. " moved=" .. tostring(moved))
            return false
        end
        log("[VRF] channel: 워프 → " .. instanceId .. " (슬롯 " .. tostring(self.Slot) .. ")")
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean StageDepthTravel(string destination)
        local code, memory = _RoomService:GetSharedMemory("DepthContinuationV1")
        if code ~= SharedMemoryResultCode.OK or memory == nil then return false end
        local data = { destination = destination, created = DateTime.UtcNow.Elapsed }
        return memory:SetVariableAndWait(self.Entity.PlayerComponent.UserId, _HttpService:JSONEncode(data)).Code == SharedMemoryResultCode.OK
    end

    @ExecSpace("ServerOnly")
    method void ClearDepthTravel()
        -- 취소됐거나 귀환으로 바뀐 다음 층 예약을 지운다 (나중에 마을에서 엉뚱하게 다음 층으로 보내지 않게).
        local code, memory = _RoomService:GetSharedMemory("DepthContinuationV1")
        if code ~= SharedMemoryResultCode.OK or memory == nil then return end
        memory:DeleteVariableAndWait(self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("ServerOnly")
    method void RollbackRoomTravel()
        -- 방 이동 준비를 되돌린다: 소환수 전달·다음 층 예약 삭제, 거둬 둔 그림자 재소환.
        if not isvalid(self.Entity) then return end
        _UndeadSystem:CancelRoomTravel(self.Entity)
        self:ClearDepthTravel()
        ---@type ShadowCommander
        local commander = self.Entity:GetComponent("script.ShadowCommander")
        if commander ~= nil then commander:ScheduleRedeploy(0.5) end
    end

    @ExecSpace("ServerOnly")
    method boolean ContinueDepthTravel()
        -- 서로 다른 인스턴스 방 사이에는 정적 방을 거친다. 소환수 전달은 최종 목적지에서만 소비한다. 이어가면 true
        -- 10-21: 게임 방 → 심연 1층도 로비를 거친다 (DepthGate)
        if _RoomService:IsInstanceRoom() then return false end
        local code, memory = _RoomService:GetSharedMemory("DepthContinuationV1")
        if code ~= SharedMemoryResultCode.OK or memory == nil then return false end
        local uid = self.Entity.PlayerComponent.UserId
        local result = memory:GetVariableAndWait(uid)
        if result.Code ~= SharedMemoryResultCode.OK or result.Info == nil then return false end
        local ok, data = pcall(function() return _HttpService:JSONDecode(result.Info.Value) end)
        if not ok or type(data) ~= "table" or type(data.created) ~= "number" or DateTime.UtcNow.Elapsed - data.created > 120000 then
            memory:DeleteVariableAndWait(uid)
            return false
        end
        local key = _GameConst:ParseDepthKey(data.destination or "")
        if key.floor < 1 or key.difficulty < 0 or key.difficulty > 2 then return false end
        if memory:DeleteVariableAndWait(uid) ~= SharedMemoryResultCode.OK then return false end
        _TimerService:SetTimerOnce(function()
            if not _Util:IsAlive(self.Entity) then return end
            self:MarkSlotTravel()
            -- 층마다 방 모양이 다르다 (GameConst.DepthMapFor)
            local depthMap = _GameConst:DepthMapFor(key.floor, key.nonce)
            local ok, room = pcall(function() return _RoomService:CreateInstanceRoom(data.destination, { depthMap }, 30) end)
            if (not ok or room == nil) and depthMap ~= _GameConst.MapDepth then
                -- 돌림 맵을 인스턴스 방으로 못 열면 (메이커가 인스턴스 맵으로 못 읽은 경우 등) 기본 심도 맵으로 연다
                log_warning("[DepthTravel] " .. depthMap .. " 방 생성 실패 → " .. _GameConst.MapDepth)
                depthMap = _GameConst.MapDepth
                pcall(function() return _RoomService:CreateInstanceRoom(data.destination, { depthMap }, 30) end)
            end
            local moved = _RoomService:MoveUserToInstanceRoom(data.destination, uid, depthMap)
            if not moved and depthMap ~= _GameConst.MapDepth then
                moved = _RoomService:MoveUserToInstanceRoom(data.destination, uid, _GameConst.MapDepth)
            end
            if not moved then
                -- 실패한 경우 마을에서 소환수를 돌려준다.
                _UndeadSystem:RetargetRoomTravel(self.Entity, _RoomService.StaticRoomKey)
                _UndeadSystem:RestoreRoomTravel(self.Entity)
                _Util:Notify("다음 층 이동에 실패했습니다. 마을에서 다시 입장하세요", uid)
                _RoomSystem:OnLobbyReady(self.Entity)
            end
        end, 0.5)
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean PrepareRoomMove(string destKey)
        -- 방을 옮기기 직전 (게임 방 들어가기·나가기 · RoomSystem): 저장 확인 → 더 저장하지 않게 → 그림자·언데드 맡기기 → 같은 캐릭터 이어 불러오기 표시
        local uid = self.Entity.PlayerComponent.UserId
        if not self.IsLoadSuccess or self.Selecting or self.Switching or self.Slot <= 0 then return false end
        self:Save(true)
        for k, v in pairs(self:Collect()) do
            if self.LastSaved[k] ~= v then
                _Util:Notify("저장에 실패해 이동하지 않았다. 잠시 뒤 다시 시도하세요", uid)
                return false
            end
        end
        _UndeadSystem:StashForRoomTravel(self.Entity, destKey)
        ---@type ShadowCommander
        local commander = self.Entity:GetComponent("script.ShadowCommander")
        if commander ~= nil then commander:StashForTravel() end
        self.IsLoadSuccess = false   -- 옮기는 동안 더 저장하지 않는다 (이미 저장됨)
        self.Switching = true
        self:MarkSlotTravel()
        return true
    end

    @ExecSpace("ServerOnly")
    method void CancelRoomMove()
        -- 방 이동 실패: 저장 허용·이어 불러오기 표시 지우기·맡긴 그림자 되돌리기
        self:TakeSlotTravel()
        self.IsLoadSuccess = true
        self.Switching = false
        self:RollbackRoomTravel()
    end

    @ExecSpace("ServerOnly")
    method any BatchGet(table keys)
        local code, pages = self:Storage():BatchGetAndWait(keys)
        if code ~= 0 then
            log_error("[PlayerSave] 불러오기 실패 " .. tostring(code))
            return nil
        end
        local loaded = {}
        while true do
            local datas = pages:GetCurrentPageDatas()
            if datas == nil then break end
            for i = 1, #datas do loaded[datas[i].KeyInfo.Key] = datas[i].Value end
            if pages.IsLastPage then break end
            if pages:LoadNextPageAndWait() ~= 0 then
                log_error("[PlayerSave] 다음 페이지 실패")
                return nil
            end
            pages:MoveToNextPageAndWait()
        end
        return loaded
    end

    @ExecSpace("ServerOnly")
    method any Migrate(string base, any data)
        -- 버전 1(구역 나누기 전) 저장을 현재 형식으로
        if data == nil or (data.v ~= nil and data.v >= 2) then return data end
        if base == "Inv" then
            return { inv = { bag = data.bag, equip = data.equip }, belt = { hp = data.hp, mp = data.mp, rv = data.rv }, corpses = data.corpses }
        end
        if base == "Shadow" then return { shadow = data } end
        return data
    end

    @ExecSpace("ServerOnly")
    method any Decode(any raw)
        if raw == nil or raw == "" then return nil end
        local ok, t = pcall(function() return _HttpService:JSONDecode(raw) end)
        if ok and type(t) == "table" then return t end
        log_error("[PlayerSave] 해석 실패")
        return nil
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method table Collect()
        -- 섹션별 JSON. 직렬화할 수 없는 값이 섞인 부분이 있으면 그 섹션은 이번에 건너뛴다
        -- (저장소의 이전 값을 유지 — 반쪽 데이터로 덮어쓰지 않는다) 그리고 어느 부분인지 남긴다
        local out = {}
        for _, sec in ipairs(self:Sections()) do
            local data = { v = self.Version }
            local broken = ""
            for _, part in ipairs(sec.parts) do
                local comp = self.Entity:GetComponent(part[2])
                if comp ~= nil then
                    local ok, value = pcall(function()
                        local saved = comp:GetSaveData()
                        _HttpService:JSONEncode({ x = saved })
                        return saved
                    end)
                    if ok then data[part[1]] = value else broken = part[1] end
                end
            end
            if broken == "" then
                out[sec.key] = _HttpService:JSONEncode(data)
            else
                log_error("[PlayerSave] " .. sec.key .. "." .. broken .. " 직렬화 실패 — 이 섹션 저장을 건너뛴다")
            end
        end
        -- 계정 공용 창고와 슬롯 요약 (이 캐릭터의 레벨·난이도)
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if inv ~= nil then
            -- 빈 Lua 표는 JSON 타입이 불명확해 인코딩이 실패한다 → 비면 개수만
            local items = inv:GetStashData()
            local stash = { v = 2, count = #items, counts = inv:GetStashCounts() }
            if #items > 0 then stash.items = items end
            out["Stash"] = _HttpService:JSONEncode(stash)
        end
        local info = self:SlotInfo(self.Slot)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if info ~= nil and stats ~= nil then
            info.lv = stats.Level
            info.diff = stats.Difficulty
        end
        out["Account"] = self:AccountJson()
        return out
    end

    method string AccountJson()
        -- 빈 Lua 표는 JSON 인코딩이 실패한다 → 캐릭터가 없으면 slots를 빼고 개수만
        local data = { v = 1, count = 0 }
        local slots = {}
        for k, info in pairs(self.Account.slots or {}) do
            slots[k] = info
            data.count = data.count + 1
        end
        if data.count > 0 then data.slots = slots end
        -- 아이템 도감 (계정 공용). 비면 넣지 않는다
        ---@type PlayerJournal
        local journal = self.Entity:GetComponent("script.PlayerJournal")
        if journal ~= nil and self.IsLoadSuccess then self.Grail = journal:GetGrailList() end
        if #self.Grail > 0 then data.grail = self.Grail end
        if self.GuideSeen then data.guide = 1 end
        if self.InputMode > 0 then data.input = self.InputMode end
        if self.GuideCards ~= "" then data.cards = self.GuideCards end
        return _HttpService:JSONEncode(data)
    end

    @ExecSpace("Server")
    method void RequestGuideSeen()
        -- 게임 안내를 한 번 띄웠다 (클라이언트 GuideWindow) → 계정에 남겨 다른 캐릭터·다음 접속에는 저절로 띄우지 않는다 (다음 저장 때 Account에 들어간다)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or self.GuideSeen then return end
        self.GuideSeen = true
        log("[VRF] guide seen saved for account")
    end

    @ExecSpace("Server")
    method void RequestInputMode(integer mode)
        -- PC 이동 방식 저장 (1 마우스 · 2 키보드) → 다음 저장 때 Account에 들어가 다른 캐릭터·다음 접속에도 그대로
        if senderUserId ~= self.Entity.PlayerComponent.UserId or (mode ~= 1 and mode ~= 2) then return end
        self.InputMode = mode
        log("[VRF] input mode saved " .. tostring(mode))
    end

    @ExecSpace("Server")
    method void RequestGuideCard(string key)
        -- 상황 안내 카드 하나를 봤다 (클라이언트 GuideCoach) → 계정에 남겨 다른 캐릭터·다음 접속에는 다시 띄우지 않는다
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if not string.match(key, "^[%a_]+$") or string.find("," .. self.GuideCards .. ",", "," .. key .. ",", 1, true) then return end
        self.GuideCards = self.GuideCards == "" and key or (self.GuideCards .. "," .. key)
        log("[VRF] guide card saved " .. key .. " → " .. self.GuideCards)
    end

    @ExecSpace("ServerOnly")
    method void Save(boolean wait)
        -- 불러오기 전에는 절대 저장하지 않는다 (빈 기본값으로 덮어쓰기 방지)
        if not self.IsLoadSuccess or self.Slot <= 0 or not isvalid(self.Entity) then return end
        local changed = {}
        for k, v in pairs(self:Collect()) do
            if self.LastSaved[k] ~= v then changed[k] = v end
        end
        if next(changed) == nil then return end
        if changed["Account"] ~= nil then self:PublishSlots() end
        if wait then
            local code, ok = self:Storage():BatchSetAndWait(changed)
            self:OnSaved(changed, ok)
            if code ~= 0 then log_error("[PlayerSave] 저장 실패 " .. tostring(code)) end
        else
            self:Storage():BatchSetAsync(changed, function(code, ok)
                self:OnSaved(changed, ok)
                if code ~= 0 then log_warning("[PlayerSave] 자동 저장 실패 " .. tostring(code)) end
            end)
        end
    end

    @ExecSpace("ServerOnly")
    method void OnSaved(table sent, any successKeys)
        -- 저장이 확인된 키만 "마지막 저장값"으로 (실패한 키는 다음에 다시)
        if successKeys == nil then return end
        for i = 1, #successKeys do
            local k = successKeys[i]
            if sent[k] ~= nil then
                self.LastSaved[k] = sent[k]
                if k == "Char_" .. tostring(self.Slot) then
                    local data = self:Decode(sent[k])
                    if data ~= nil then self.AudioSavedDigest = self:AudioKey(self:NormalizeAudio(data.settings)) end
                end
            end
        end
        -- 이전 저장에서 옮긴 캐릭터: 슬롯 키 셋이 모두 저장되면 표시를 지우고 계정을 곧바로 다시 저장한다
        local info = self:SlotInfo(self.Slot)
        if info ~= nil and info.legacy ~= nil then
            local all = true
            for _, sec in ipairs(self:Sections()) do if self.LastSaved[sec.key] == nil then all = false end end
            if all then
                info.legacy = nil
                log("[VRF] slots: " .. tostring(self.Slot) .. "번 캐릭터 슬롯 키 저장 완료 — 이전 저장 표시 해제")
                self:Save(false)
            end
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        if event.UserId ~= self.Entity.PlayerComponent.UserId then return end
        self:CancelAudioSave()
        if self.TimerId ~= 0 then
            _TimerService:ClearTimer(self.TimerId)
            self.TimerId = 0
        end
        -- 거래 중이면 올린 물건을 먼저 가방으로 돌려놓고 저장한다 (10-13: 이벤트 순서가 정해져 있지 않아 저장이 먼저면 물건이 사라졌다)
        ---@type PlayerTrade
        local trade = self.Entity:GetComponent("script.PlayerTrade")
        if trade ~= nil and trade.Partner ~= "" then trade:Cancel("거래가 취소되었다") end
        self:Save(true)
    end

    method table NormalizeAudio(any data)
        local result = { bgm = 55, effects = 100, ambience = 100 }
        if type(data) ~= "table" then return result end
        for key, fallback in pairs(result) do
            local value = data[key]
            if type(value) == "number" and value == value then result[key] = math.floor(math.max(0, math.min(100, value)) + 0.5) end
        end
        return result
    end

    method string AudioKey(table data)
        return tostring(data.bgm) .. "," .. tostring(data.effects) .. "," .. tostring(data.ambience)
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        -- Char.settings에 함께 저장한다. 슬라이더/버튼 입력마다 저장소를 호출하지 않는다.
        local data = self:NormalizeAudio(self.AudioSettings)
        data.petFilter = self.PetFilter
        return data
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(any data)
        self.AudioSettings = self:NormalizeAudio(data)
        local pet = type(data) == "table" and data.petFilter or nil
        self.PetFilter = (type(pet) == "number" and pet == pet) and math.floor(math.max(0, math.min(4, pet))) or 2
    end

    @ExecSpace("Server")
    method void RequestPetFilter(integer filter)
        -- 고양이 창에서 고른 등급 (저장은 소리 설정처럼 2초 뒤 한 번)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.IsLoadSuccess then return end
        local f = math.floor(math.max(0, math.min(4, filter)))
        if f == self.PetFilter then return end
        self.PetFilter = f
        self:CancelAudioSave()
        self.AudioSaveTimer = _TimerService:SetTimer(self, function()
            self.AudioSaveTimer = 0
            self:Save(false)
        end, 2, false, 2)
    end

    @ExecSpace("Server")
    method void RequestAudioSettings(integer bgm, integer effects, integer ambience)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not self.IsLoadSuccess then return end
        local nextValues = self:NormalizeAudio({ bgm = bgm, effects = effects, ambience = ambience })
        local key = self:AudioKey(nextValues)
        if key == self.AudioDigest then return end
        self.AudioSettings = nextValues
        self.AudioDigest = key
        self:CancelAudioSave()
        self.AudioSaveTimer = _TimerService:SetTimer(self, function()
            self.AudioSaveTimer = 0
            self:Save(false)
        end, 2, false, 2)
    end

    @ExecSpace("ServerOnly")
    method void CancelAudioSave()
        if self.AudioSaveTimer ~= 0 then _TimerService:ClearTimer(self.AudioSaveTimer) self.AudioSaveTimer = 0 end
    end

end
