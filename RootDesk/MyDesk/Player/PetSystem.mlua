-- 펫: 주인 곁을 따라다니며 바닥 전리품을 주워 온다. 첫 펫은 고양이 「재」(숯의 동생 — 10-23 사용자 결정: 오픈 30일 무료 패스는 받으면 영구, 그 뒤 유료 패스).
-- 10-24 사용자: 능력은 모두 재와 같고 모습만 다른 펫을 여러 마리 판다 (data/pets.csv — 닥스훈트 먼지 · 여우 불씨 · 부엉이 등불 · 고슴도치 가시 · 박쥐 그을음).
-- 소유 = 펫마다 월드 상점 패스 (freePass · paidPass, 크리에이터 센터에 등록한 상품 ID). 받기 기록이 플랫폼에 남아 저장 데이터와 무관하다.
-- 데리고 다니는 펫 = PlayerSave.PetPick (캐릭터마다, 없으면 가진 펫 중 pets.csv 순서 첫째) — 펫은 한 번에 한 마리.
-- 줍는 물건 = 캐릭터마다 고르는 등급 (PlayerSave.PetFilter: 0 쉬기 · 1 전부 · 2 쓸 만한 것 · 3 희귀 이상 · 4 유니크·세트·룬).
-- 서버는 목표·도착 시각·줍기만 정하고, 고양이 그림은 클라이언트마다 맵 아래 artsprite로 그린다 (MotionSmoother 대역과 같은 방식 — 서버 위치를 쓰지 않아 끊기지 않는다).
-- 10-31 사용자 실플레이 「펫이 하루 종일 뛰어다닌다 — 캐릭터 주변을 배회하다 아이템이 나오면 가지러 가는 정도」 (갈래 A-4, 펫 5종 공통):
--   서 있기 — 주인 곁(FollowStop 2칸 안, 다가갈 때는 StandDist 1.75칸 자리)에 서 있고 NudgeMinSec~NudgeMaxSec(2~4초)마다 NudgeDist(0.3칸) 안 미세 이동만. 배회 없음.
--   따라가기 — 주인과 FollowStart(3칸) 넘게 벌어질 때만 걷기 시작해 FollowStop(2칸) 안에 들면 멈춘다.
--   줍기 — 주인 둘레 Reach(8칸) 안 전리품을 가서 줍고(기존 등급 필터·가방 여유 그대로) 주인 곁으로 돌아온다. 목표 전환은 RetargetSec(0.4초) 간격 이상.
--   그림자(소환수)는 이 파일과 무관 — MotionSmoother 그대로.
@Logic
script PetSystem extends Logic

    property string FreePassId = "I41RHM870"   -- 「오픈 기념 고양이 재」 무료 패스 (판매 10-25 ~ 11-25 · 크리에이터 센터 10-24 등록) — pets.csv jae와 같다
    property string PaidPassId = "Q0TQOT864"   -- 「고양이 재」 유료 패스 (상시 · 300 코인 · 10-24 등록)
    property number FrameSeconds = 0.11
    property number IdleFrameSeconds = 0.22
    property number Scale = 1.0
    property number Reach = 8                  -- 주인에게서 이 거리 안의 전리품만 (10-31 A-4: 6 → 8)
    property number Speed = 7                  -- 주워 오는 속도 (초당 월드 단위)
    property number FollowSpeed = 6            -- 따라붙을·돌아올 때 최소 속도 (주인이 더 빠르면 주인 속도 × 1.3)
    property number FollowStart = 3            -- 10-31 A-4: 주인과 이 거리(칸) 넘게 벌어져야 따라가기 시작
    property number FollowStop = 2             -- 10-31 A-4: 따라가기·돌아오기는 주인 이 거리 안에 들면 멈춘다
    property number StandDist = 1.75           -- 10-31 A-4: 따라갈 때 노리는 자리 = 주인에게서 펫 쪽으로 이 거리 (1.5~2칸 안에 서게)
    property number NudgeDist = 0.3            -- 10-31 A-4: 서 있는 동안 미세 이동 최대 거리(칸)
    property number NudgeSpeed = 1.2           -- 미세 이동 속도 (걷기 그림)
    property number NudgeMinSec = 2            -- 10-31 A-4: 미세 이동 간격 최소(초)
    property number NudgeMaxSec = 4            -- 10-31 A-4: 미세 이동 간격 최대(초)
    property number RetargetSec = 0.4          -- 10-31 A-4: 줍기 목표 전환 최소 간격(초) — 하나 줍고 다음 것으로 바로 꺾지 않게
    property integer TimerId = 0
    @Sync property SyncTable<string, integer> Owned   -- userId → 1 (펫이 한 마리라도 있다) · "userId|펫 key" → 1 (그 펫의 패스 보유)
    property any Checked = nil                 -- 서버: userId → 확인 시각
    property any Jobs = nil                    -- 서버: userId → { drop, at, pos }
    property any NextJobAt = nil               -- 서버: userId → 다음 줍기 목표를 정해도 되는 시각 (RetargetSec)
    property any Skip = nil                    -- 서버: drop entity id → 다시 볼 시각 (가방이 가득 차 못 주운 것)
    property any Vis = nil                     -- 클라이언트: userId → { e, pos, goal, goalUntil, frame, flip }
    property number LastFrameAt = 0

    method void OnBeginPlay()
        -- 서버: 상점 구매 처리 · 보유 확인 · 줍기 / 클라이언트: 고양이 그리기
        self.Checked = {}
        self.Jobs = {}
        self.NextJobAt = {}
        self.Skip = {}
        self.Vis = {}
        if self:IsServer() then
            _WorldShopService:SetProcessPurchaseCallback(function(info) return self:ProcessPurchase(info) end)
            self.TimerId = _TimerService:SetTimerRepeat(function() self:ServerTick() end, 0.15)
            log("[VRF] PetSystem server ready free=" .. self.FreePassId .. " paid=" .. self.PaidPassId)
        else
            log("[VRF] PetSystem client ready")
        end
    end

    method void OnEndPlay()
        -- 주기 타이머 해제 (클라이언트는 고양이 그림도 지운다)
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        if self.Vis ~= nil then
            for _, v in pairs(self.Vis) do if isvalid(v.e) then v.e:Destroy() end end
        end
        self.Vis = {}
    end

    method boolean HasPet(string userId)
        -- 이 사람에게 펫이 한 마리라도 있는가 (서버·클라이언트 공용)
        return userId ~= "" and (self.Owned[userId] or 0) == 1
    end

    method boolean Owns(string userId, string key)
        -- 이 사람이 그 펫의 패스를 가졌는가
        return userId ~= "" and (self.Owned[userId .. "|" .. key] or 0) == 1
    end

    method any ActivePet(string userId, Entity p)
        -- 데리고 다니는 펫: 고른 펫(PlayerSave.PetPick)을 가졌으면 그 펫, 아니면 가진 펫 중 첫째 (없으면 nil)
        if not self:HasPet(userId) then return nil end
        local pick = ""
        if isvalid(p) then
            ---@type PlayerSave
            local save = p:GetComponent("script.PlayerSave")
            if save ~= nil then pick = save.PetPick end
        end
        if pick ~= "" and self:Owns(userId, pick) then return _GameData:GetPet(pick) end
        for _, pet in ipairs(_GameData:GetPets()) do
            if self:Owns(userId, pet.key) then return pet end
        end
        return nil
    end

    method any PetOfProduct(string productId)
        -- 상품 ID → 펫 (무료·유료 패스 모두)
        if productId == "" then return nil end
        for _, pet in ipairs(_GameData:GetPets()) do
            if pet.freePass == productId or pet.paidPass == productId then return pet end
        end
        return nil
    end

    -- ───────── 서버: 상점 ─────────

    @ExecSpace("ServerOnly")
    method boolean ProcessPurchase(any info)
        -- 월드 상점 구매 지급. 펫 패스면 바로 보유로 표시한다 (모르는 상품은 실패로 두어 다음 접속 때 다시 온다)
        if info == nil then return false end
        local id = info.ProductId
        local pet = self:PetOfProduct(id)
        if pet ~= nil then
            self.Owned[info.UserId .. "|" .. pet.key] = 1
            self.Owned[info.UserId] = 1
            _LogStorageService:LogPurchaseInfo(info, "pet " .. id)
            local p = _UserService:GetUserEntityByUserId(info.UserId)
            if isvalid(p) then
                -- 새로 산 펫을 바로 데리고 다닌다
                ---@type PlayerSave
                local save = p:GetComponent("script.PlayerSave")
                if save ~= nil and save.IsLoadSuccess then save.PetPick = pet.key end
                _Util:Notify("펫 「" .. pet.name .. "」가 곁에 왔습니다 — 메뉴 → 펫에서 주울 물건을 고르세요", info.UserId)
            end
            log("[VRF] PetSystem purchase " .. id .. " " .. info.UserId)
            return true
        end
        -- 펫이 아니면 후원 패스인지 (상점 지급 콜백은 하나뿐 — Shop/Supporter.mlua)
        if _Supporter:ProcessPurchase(info) then return true end
        log_warning("[PetSystem] 모르는 상품 구매 " .. tostring(id))
        return false
    end

    @ExecSpace("ServerOnly")
    method void CheckOwner(string userId)
        -- 접속한 사람의 패스 보유를 펫마다 플랫폼에 묻는다 (기다리는 호출이라 타이머 안에서)
        self.Checked[userId] = _UtilLogic.ElapsedSeconds
        _TimerService:SetTimerOnce(function()
            local owned = {}
            for _, pet in ipairs(_GameData:GetPets()) do
                local has = false
                for _, id in ipairs({ pet.freePass, pet.paidPass }) do
                    if not has and id ~= "" then
                        local ok, r = pcall(function() return _WorldShopService:UserHasPassAndWait(userId, id) end)
                        if ok and r == true then has = true end
                    end
                end
                if has then
                    self.Owned[userId .. "|" .. pet.key] = 1
                    self.Owned[userId] = 1
                    table.insert(owned, pet.key)
                end
            end
            log("[VRF] PetSystem owner check " .. userId .. " = " .. table.concat(owned, ","))
        end, 0.1)
    end

    -- ───────── 서버: 줍기 ─────────

    @ExecSpace("ServerOnly")
    method void ServerTick()
        -- 사람마다: 하던 심부름이 끝났으면 줍고, 놀고 있으면 가장 가까운 주울 물건으로 보낸다
        local now = _UtilLogic.ElapsedSeconds
        local present = {}
        for id, p in pairs(_UserService.UserEntities) do
            present[id] = true
            if self.Checked[id] == nil then self:CheckOwner(id) end
            if self:HasPet(id) and isvalid(p) then self:TickOwner(id, p, now) end
        end
        for id, _ in pairs(self.Jobs) do if not present[id] then self.Jobs[id] = nil end end
        for id, _ in pairs(self.NextJobAt) do if not present[id] then self.NextJobAt[id] = nil end end
        for id, _ in pairs(self.Checked) do if not present[id] then self.Checked[id] = nil end end
    end

    @ExecSpace("ServerOnly")
    method void TickOwner(string userId, Entity p, number now)
        local job = self.Jobs[userId]
        if job ~= nil and now < job.at then return end
        local from = _Util:Pos2(p)
        if job ~= nil then
            -- 도착: 아직 바닥에 있고 주울 수 있으면 줍는다 (가방이 가득 차 못 주우면 잠시 건너뛴다)
            self.Jobs[userId] = nil
            self.NextJobAt[userId] = now + self.RetargetSec
            from = job.pos
            if isvalid(job.drop) and p.CurrentMap == job.map then
                ---@type LootDrop
                local drop = job.drop:GetComponent("script.LootDrop")
                ---@type PlayerInventory
                local inv = p:GetComponent("script.PlayerInventory")
                if drop ~= nil and inv ~= nil and drop:CanTake(userId) then
                    inv:Pickup(drop)
                    if isvalid(job.drop) and not drop.Taken then self.Skip[job.drop.Id] = now + 8 end
                end
            end
        end
        if p.PlayerComponent.Hp <= 0 then return end
        if now < (self.NextJobAt[userId] or 0) then return end   -- 10-31 A-4: 목표 전환 최소 간격
        ---@type PlayerSave
        local save = p:GetComponent("script.PlayerSave")
        local filter = save ~= nil and save.PetFilter or 2
        if filter <= 0 then return end
        local map = p.CurrentMap
        if not isvalid(map) then return end
        local me = _Util:Pos2(p)
        local best, bestD = nil, 1e9
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.LootDrop", true)) do
            ---@type LootDrop
            local drop = c
            local skipUntil = self.Skip[c.Entity.Id]
            if (skipUntil == nil or now >= skipUntil) and drop:CanTake(userId) and self:Wants(drop, filter) then
                local q = _Util:Pos2(c.Entity)
                if (q - me):Magnitude() <= self.Reach then
                    local d = (q - from):Magnitude()
                    if d < bestD then best, bestD = c.Entity, d end
                end
            end
        end
        if best == nil then return end
        local goal = _Util:Pos2(best)
        local secs = 0.15 + bestD / self.Speed
        self.Jobs[userId] = { drop = best, at = now + secs, pos = goal, map = map }
        log(string.format("[VRF] pet fetch uid=%s dist=%.1f fromOwner=%.1f secs=%.2f", userId, bestD, (goal - me):Magnitude(), secs))
        self:ShowFetch(userId, goal.x, goal.y, secs)
    end

    method boolean Wants(LootDrop drop, integer filter)
        -- 고른 등급에 맞는 물건인가 (1 전부 · 2 쓸 만한 것 · 3 희귀 이상 · 4 유니크·세트·룬)
        local kind = drop.Kind
        if kind == "rune" then return true end
        if kind == "gold" then return filter <= 3 end
        if kind == "tp" or kind == "hp" or kind == "mp" then return filter <= 2 end
        if kind ~= "item" then return false end
        if drop.ItemString ~= "" and _ItemData:IsStack(_ItemData:Parse(drop.ItemString).base) then return filter <= 2 end
        local need = { 0, 1, 2, 3 }
        return drop.Rarity >= (need[filter] or 0)
    end

    @ExecSpace("Multicast")
    method void ShowFetch(string userId, number x, number y, number secs)
        -- 모든 화면: 이 사람의 펫이 (x, y)로 secs초 안에 달려간다
        if self.Vis == nil then return end
        local v = self.Vis[userId]
        if v == nil then return end
        v.goal = Vector2(x, y)
        v.goalUntil = _UtilLogic.ElapsedSeconds + secs + 0.25
        v.speed = math.max(self.Speed, (Vector2(x, y) - v.pos):Magnitude() / math.max(0.1, secs))
    end

    -- ───────── 클라이언트: 그리기 ─────────

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 내 맵의 펫 주인마다 그림을 하나씩 두고 따라가게 한다 (심부름 중이면 목표로)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or self.Vis == nil then return end
        local map = me.CurrentMap
        local now = _UtilLogic.ElapsedSeconds
        local seen = {}
        for id, p in pairs(_UserService.UserEntities) do
            if isvalid(p) and p.CurrentMap == map and self:HasPet(id) and isvalid(map) then
                local pet = self:ActivePet(id, p)
                if pet ~= nil then
                    seen[id] = true
                    self:DrawPet(id, p, map, now, delta, pet)
                end
            end
        end
        for id, v in pairs(self.Vis) do
            if not seen[id] or v.map ~= map then
                if isvalid(v.e) then v.e:Destroy() end
                self.Vis[id] = nil
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void DrawPet(string id, Entity p, Entity map, number now, number delta, table pet)
        -- 10-31 A-4: 주인 곁에 서 있다가(미세 이동만) 3칸 넘게 벌어지면 따라가 2칸 안에서 멈추고, 심부름(ShowFetch)이 오면 줍고 돌아온다 (PetDecide)
        --   (10-24: 매 프레임 쫓아가 달리기·서기가 계속 바뀌던 버벅임 → 서기 상태를 유지하는 상태 기계로)
        local owner = _Util:Pos2(p)
        local v = self.Vis[id]
        if v == nil or not isvalid(v.e) then
            local start = owner + Vector2(-self.StandDist, -0.1)
            local e = _SpawnService:SpawnByModelId("artsprite", "Pet_" .. id, Vector3(start.x, start.y, 0), map)
            if not isvalid(e) then return end
            local sr = e.SpriteRendererComponent
            sr.SpriteRUID = self:Frame(pet.idle, 0)
            local psr = p.AvatarRendererComponent
            if isvalid(psr) then
                sr.SortingLayer = psr.SortingLayer
                sr.OrderInLayer = psr.OrderInLayer
            end
            v = { e = e, pos = start, goal = nil, goalUntil = 0, speed = self.Speed, flip = 1, last = owner, map = map, moving = false,
                dest = nil, mode = "stand", nudgeAt = now + self.NudgeMinSec, ownerVel = Vector2(0, 0) }
            self.Vis[id] = v
        end
        -- 주인 속도 (부드럽게) — 따라붙는 빠르기를 정한다
        local vel = (owner - v.last) * (1 / math.max(0.001, delta))
        v.last = owner
        v.ownerVel = v.ownerVel + (vel - v.ownerVel) * math.min(1, delta * 6)
        if (v.pos - owner):Magnitude() > 9 and not (v.goal ~= nil and now < v.goalUntil) then
            -- 맵 이동·순간이동으로 너무 멀다: 곧장 곁으로
            v.pos = owner + Vector2(-self.StandDist, -0.1)
            v.dest = nil
            v.mode = "stand"
        end
        local target = self:PetDecide(v, owner, now)
        local speed = v.stepSpeed or 0
        if target ~= nil and v.mode == "nudge" and v.dest ~= nil and target == v.dest and not v.checked then
            -- 미세 이동 자리도 벽 너머는 고르지 않는다 (처음 한 번만 확인)
            v.checked = true
            v.dest = _Util:ReachablePoint(map, v.pos, v.dest, 0.2)
            target = v.dest
        end
        v.moving = false
        if target ~= nil then
            local d = target - v.pos
            local dist = d:Magnitude()
            local step = speed * delta
            if dist <= math.max(step, 0.02) then
                v.pos = target
                if v.mode == "nudge" then
                    v.mode = "stand"
                    v.dest = nil
                end
            else
                v.pos = v.pos + d * (step / dist)
                v.moving = true
                if math.abs(d.x) > 0.02 then v.flip = d.x > 0 and 1 or -1 end   -- 코덱스 그림은 오른쪽을 본다
            end
        elseif v.ownerVel:Magnitude() < 0.1 and math.abs(owner.x - v.pos.x) > 0.3 then
            v.flip = owner.x > v.pos.x and 1 or -1   -- 서 있는 동안은 주인 쪽을 본다
        end
        local bob = v.moving and math.abs(math.sin(now * 14)) * 0.06 or math.sin(now * 2.4) * 0.015
        local t = v.e.TransformComponent
        t.WorldPosition = Vector3(v.pos.x, v.pos.y + bob, 0)
        local scale = self.Scale * pet.scale
        t.Scale = Vector3(scale * v.flip, scale, 1)
        -- 프레임: 걷기·달리기는 달리기 그림 (걸을 때는 조금 느리게), 쉬면 대기 그림 (펫을 바꾸면 다음 프레임부터 그 펫 그림)
        local frames = (v.moving and pet.run ~= "") and pet.run or pet.idle
        local frameSec = v.moving and (speed <= self.NudgeSpeed and self.FrameSeconds * 1.6 or self.FrameSeconds) or self.IdleFrameSeconds
        local f = math.floor(now / frameSec)
        local ruid = self:Frame(frames, f)
        if v.e.SpriteRendererComponent.SpriteRUID ~= ruid then v.e.SpriteRendererComponent.SpriteRUID = ruid end
    end

    method any PetDecide(table v, Vector2 owner, number now)
        -- 펫 움직임 상태 기계 (10-31 A-4 · 엔진 호출 없음 — tests/quality/chase_pet.lua). 반환 = 갈 자리(없으면 nil) · 속도는 v.stepSpeed
        --   fetch : 심부름(goal) 시간 안 — 전리품 자리로 · 끝나면 return
        --   return/follow : 주인 쪽 StandDist 자리로 — FollowStop 안에 들면 stand
        --   stand : 주인과 FollowStart 넘게 벌어지면 follow · 아니면 nudgeAt마다 NudgeDist 안 미세 이동(nudge, FollowStop 밖으로는 안 나감)
        local fromOwner = (v.pos - owner):Magnitude()
        if v.goal ~= nil and now < v.goalUntil then
            v.mode = "fetch"
            v.dest = nil
            v.stepSpeed = v.speed
            return v.goal
        end
        if v.goal ~= nil then
            v.goal = nil
            v.mode = "return"   -- 줍고 돌아온다
        end
        local follow = math.max(self.FollowSpeed, v.ownerVel:Magnitude() * 1.3)
        if v.mode == "return" or v.mode == "follow" then
            if fromOwner <= self.FollowStop then
                v.mode = "stand"
                v.dest = nil
                v.nudgeAt = now + self.NudgeMinSec + _UtilLogic:RandomDouble() * (self.NudgeMaxSec - self.NudgeMinSec)
                v.stepSpeed = 0
                return nil
            end
            v.stepSpeed = follow
            return self:StandSpot(v, owner)
        end
        if fromOwner > self.FollowStart then
            v.mode = "follow"
            v.dest = nil
            v.stepSpeed = follow
            return self:StandSpot(v, owner)
        end
        v.stepSpeed = self.NudgeSpeed
        if v.mode == "nudge" and v.dest ~= nil then return v.dest end
        v.mode = "stand"
        if now < (v.nudgeAt or 0) then return nil end
        v.nudgeAt = now + self.NudgeMinSec + _UtilLogic:RandomDouble() * (self.NudgeMaxSec - self.NudgeMinSec)
        local a = _UtilLogic:RandomDouble() * math.pi * 2
        local r = (0.3 + _UtilLogic:RandomDouble() * 0.7) * self.NudgeDist
        local want = v.pos + Vector2(math.cos(a) * r, math.sin(a) * r * 0.7)
        if (want - owner):Magnitude() > self.FollowStop then return nil end   -- 곁을 벗어나는 미세 이동은 건너뛴다
        v.mode = "nudge"
        v.dest = want
        v.checked = false
        return v.dest
    end

    method Vector2 StandSpot(table v, Vector2 owner)
        -- 따라가기·돌아오기 자리: 주인에게서 지금 펫 쪽으로 StandDist (겹쳐 있으면 주인 왼쪽)
        local away = v.pos - owner
        if away:Magnitude() < 0.05 then return owner + Vector2(-self.StandDist, -0.1) end
        return owner + away:Normalize() * self.StandDist
    end

    method string Frame(string list, integer i)
        -- "a,b,c"에서 i번째 (돌아가며)
        local out = {}
        for x in string.gmatch(list, "[^,]+") do table.insert(out, x) end
        if #out == 0 then return "" end
        return out[(i % #out) + 1]
    end

end
