-- 이동: 맵 이동(모든 포털·웨이포인트·귀환의 공통 진입점), 웨이포인트 활성화·이동, 난이도 전환, 귀환 두루마리.
-- 귀환 두루마리는 고정 키가 없다: 플레이어가 벨트 칸에 넣어 그 칸으로 쓴다 (PlayerBelt).
-- 귀환 (D2 방식): 사냥터 그 자리에 마을로 가는 포털을 열고, 마을에 그 자리로 돌아오는 짝 포털을 연다.
-- 파티원은 언제든 두 포털을 쓴다. 주인이 마을 쪽 포털로 돌아가면 두 포털이 함께 닫힌다. 새로 쓰면 예전 짝은 닫힌다.
@Component
script PlayerTravel extends Component

    @Sync
    property string Known = "camp"          -- 활성화한 웨이포인트 id (","로 연결)
    @Sync
    property string Visited = ""            -- 한 번이라도 들어간 사냥터 (보통 맵 이름, ","로 연결) — 의뢰 일지 열람 조건 (D2처럼 그 지역에 가면 읽힌다)
    @Sync
    property integer TownScroll = 0         -- 예전 저장의 귀환 두루마리 개수 (10-11부터 가방 물건 — MigrateScrolls가 가방으로 옮기고, 가방이 차서 남은 것만 여기)
    property any FieldGate = nil              -- 귀환 두루마리로 사냥터에 연 포털 (마을로)
    property any TownGate = nil               -- 그 짝으로 마을에 연 포털 (사냥터 그 자리로)
    property number PortalGap = 1.3           -- 사냥터 포털을 연 사람에게서 이만큼 옆에 연다 (포털 반경 0.6 밖이라 열자마자 빨려 들지 않는다)
    property number WaypointRange = 2.2
    property any ResumeAt = nil              -- 저장된 마지막 사냥터 자리 { m, x, y, t } (재접속 때 한 번 쓴다)
    property number ResumeWindowSec = 900    -- 끊긴 뒤 이 시간(15분) 안에 다시 들어오면 그 자리로
    property integer Diff = 0                -- 지금 Known/Visited가 속한 난이도 (난이도마다 웨이포인트·방문 기록이 따로 — D2)
    property table KnownBy = {}              -- "0"/"1"/"2" → Known 문자열 (다른 난이도 것)
    property table VisitedBy = {}            -- "0"/"1"/"2" → Visited 문자열
    @Sync
    property string KnownAll = ""            -- 난이도별 활성화 웨이포인트 "0=camp,x|1=camp|2=camp" (웨이포인트 창이 다른 난이도 목록을 미리 본다)
    @Sync
    property string ActOpenAll = ""          -- 난이도별 열린 마지막 액트 "0=2|1=1|2=1"
    @Sync
    property number ArrivedAt = -100         -- 이 맵에 들어온 시각 (서버) — 도착 직후 포털에 다시 빨려 들어가지 않게 (WarpGate)
    @Sync
    property integer Act = 1                 -- 지금 액트 (10-24 @Sync: 웨이포인트·NPC·랭킹 창이 클라이언트에서 읽는데 늘 1이었다) (마을 귀환·사망 부활·웨이포인트 창 첫 탭). 마지막으로 들어간 액트 맵 기준

    method integer Difficulty()
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return 0 end
        return stats.Difficulty
    end

    @ExecSpace("ServerOnly")
    method void Go(string mapName, Vector2 pos)
        -- 이동 전 예약·장판·공격 입력을 끊어 이전 맵의 효과가 새 맵에 적용되지 않게 한다.
        self:CancelCombat()
        self:ResetLocalInput(self.Entity.PlayerComponent.UserId)
        -- 그림자는 이동 전에 기억하고 회수, 도착하면 다시 소환된다 (ShadowCommander.OnMapEnter)
        ---@type ShadowCommander
        local commander = self.Entity:GetComponent("script.ShadowCommander")
        if commander ~= nil then commander:StashForTravel() end
        _UndeadSystem:Follow(self.Entity)   -- 언데드는 도착 뒤 다시 일어나 따라온다 (D2)
        local sameMap = isvalid(self.Entity.CurrentMap) and self.Entity.CurrentMap.Name == mapName
        self:ShowTravel(mapName, self.Entity.PlayerComponent.UserId)   -- 이동 화면으로 먼저 덮는다 (MapTransition)
        _TeleportService:TeleportToMapPosition(self.Entity, Vector3(pos.x, pos.y, 0), mapName)
        -- 같은 맵 안 이동(같은 맵 웨이포인트 등)은 OnMapEnter가 없어 거둔 그림자가 돌아오지 않았다 (10-28 메이커 확인) → 여기서 다시 부른다
        if sameMap and commander ~= nil then commander:ScheduleRedeploy(1) end
    end

    @ExecSpace("ServerOnly")
    method void CancelCombat()
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then book:CancelPending() end
        local effects = self.Entity:GetComponent("script.SkillEffects")
        if effects ~= nil then effects:CancelActiveEffects() end
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        if attack ~= nil then attack:CancelAttack() end
    end

    @ExecSpace("Client")
    method void ShowTravel(string mapName)
        if self.Entity ~= _UserService.LocalPlayer then return end
        _MapTransition:Begin(mapName)
    end

    @ExecSpace("Client")
    method void ResetLocalInput()
        local cc = self.Entity:GetComponent("script.ClickControl")
        if cc ~= nil then cc:Cancel() end
        _MobilePad:ClearGesture()
    end

    method string TownMap()
        -- 지금 액트·난이도의 마을 맵 이름
        return _GameConst:MapFor(_GameConst:TownOfAct(self.Act), self:Difficulty())
    end

    @ExecSpace("ServerOnly")
    method void GoTown()
        -- 10-21 방 구조: 게임 방에는 마을이 함께 있다 → 같은 방 안의 맵 이동. 심연(다른 방)에서는 로비를 거쳐 원래 게임 방으로
        -- (10-20 메이커 확인: 심연에서 쓰러진 뒤 마을 이동이 실패해 심연에 남은 채 다시 쓰러지기를 되풀이했다)
        if _RoomService:IsInstanceRoom() and not _GameConst:InGameRoom() then
            self:LeaveInstanceToTown()
            return
        end
        self:Go(self:TownMap(), _GameConst:GetTownArrival())
    end

    @ExecSpace("ServerOnly")
    method void LeaveInstanceToTown()
        -- 심연 문(DepthDirector.SaveAll)과 같은 순서: 언데드·그림자 맡기기 → 저장 → 로비로 (RoomSystem이 돌아갈 게임 방으로 다시 넣는다)
        local uid = self.Entity.PlayerComponent.UserId
        ---@type PlayerSave
        local save = self.Entity:GetComponent("script.PlayerSave")
        _UndeadSystem:StashForRoomTravel(self.Entity, _RoomService.StaticRoomKey)
        ---@type ShadowCommander
        local commander = self.Entity:GetComponent("script.ShadowCommander")
        if commander ~= nil then commander:StashForTravel() end
        if save ~= nil then
            save:ClearDepthTravel()
            save:Save(true)
            save:MarkSlotTravel()
        end
        local moved = _RoomService:MoveUsersToStaticRoom({ uid }, _GameConst.MapLobby)
        log("[VRF] leave instance → lobby moved=" .. tostring(moved))
        if (moved == nil or moved == 0) and save ~= nil then
            save:RollbackRoomTravel()
            _Util:Notify("마을로 돌아가지 못했습니다. 잠시 뒤 다시 시도하세요", uid)
        end
    end

    method boolean ActUnlocked(integer act)
        -- 액트 2부터는 지금 난이도에서 앞 액트의 마지막 의뢰(액트 보스)를 끝내야 열린다 (D2)
        if act <= 1 then return true end
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        return quest ~= nil and quest:IsActDone(act - 1)
    end

    @ExecSpace("Server")
    method void RequestActTravel(integer act)
        -- 카라반 대장(야영지·오아시스) · 선장(항구): 열린 다른 액트의 마을로 (그 NPC 곁에서만)
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or pc.Hp <= 0 or act == self.Act then return end
        if act < 1 or act > _GameConst.ActCount then return end
        if not _Util:NearNpc(self.Entity, "caravan") and not _Util:NearNpc(self.Entity, "captain") and not _Util:NearNpc(self.Entity, "scout") then return end
        if not self:ActUnlocked(act) then
            local why = "아직 길이 열리지 않았다 — 묘지기 여왕 오르넬라를 쓰러뜨려야 사막길이 열린다"
            if act == 3 then why = "아직 바다가 열리지 않았다 — 대사제 알하자르를 쓰러뜨려야 출항한다" end
            if act == 4 then why = "아직 북쪽 길이 열리지 않았다 — 익사한 제독 바렌을 쓰러뜨려야 떠난다" end
            _Util:Warn(why, pc.UserId)
            return
        end
        log("[VRF] act travel " .. tostring(self.Act) .. " -> " .. tostring(act))
        self.Act = act
        self:GoTown()
    end

    @ExecSpace("ServerOnly")
    method void OnMapEnter(Entity enteredMap)
        -- 들어간 사냥터를 기록한다 (난이도 접미사는 떼고 보통 맵 이름으로)
        if not isvalid(enteredMap) then return end
        self.ArrivedAt = _UtilLogic.ElapsedSeconds
        local base = _GameConst:BaseMapName(enteredMap.Name)
        local info = _GameData:GetMapInfo(base)
        if info ~= nil and info.kind ~= "instance" then self.Act = _GameConst:ActOfMap(base) end
        if string.find("," .. self.Visited .. ",", "," .. base .. ",", 1, true) ~= nil then return end
        self.Visited = self.Visited == "" and base or (self.Visited .. "," .. base)
    end

    method boolean HasVisited(string baseMap)
        return string.find("," .. self.Visited .. ",", "," .. baseMap .. ",", 1, true) ~= nil
    end

    -- ───────── 웨이포인트 ─────────

    @ExecSpace("ServerOnly")
    method void Activate(string id)
        if self:IsKnown(id) then return end
        self.Known = self.Known .. "," .. id
        self:SyncDiffInfo()
        local w = _WaypointData:Get(id)
        if w ~= nil then _Util:Banner("웨이포인트 활성화 · " .. w.name, "웨이포인트에서 언제든 이곳으로 이동할 수 있다", self.Entity.PlayerComponent.UserId) end
    end

    method boolean IsKnown(string id)
        return string.find("," .. self.Known .. ",", "," .. id .. ",", 1, true) ~= nil
    end

    method boolean NearWaypoint()
        return _Util:NearestComponent(self.Entity.CurrentMap, "script.Waypoint", _Util:Pos2(self.Entity), self.WaypointRange) ~= nil
    end

    @ExecSpace("Server")
    method void RequestTravel(string id)
        -- 웨이포인트 위에서만, 활성화한 곳으로만. 지금 난이도의 맵으로
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or pc.Hp <= 0 then return end
        if not self:IsKnown(id) or not self:NearWaypoint() then return end
        local w = _WaypointData:Get(id)
        if w == nil or not self:ActUnlocked(math.floor(w.act or 1)) then return end
        self:Go(_GameConst:MapFor(w.map, self:Difficulty()), Vector2(w.x, w.y))
    end

    @ExecSpace("Server")
    method void RequestTravelIn(string id, integer diff)
        -- 웨이포인트 창에서 고른 난이도·맵으로 간다. 난이도는 맵을 고를 때 바뀐다 (10-10 QA: 액트·난이도 버튼은 보기만, 이동은 맵 선택 때만)
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or pc.Hp <= 0 or not self:NearWaypoint() then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or diff < 0 or diff > stats.MaxDifficulty then return end
        if diff ~= stats.Difficulty and _GameConst:InGameRoom() then
            -- 게임 방은 만들 때 난이도가 정해진다 (방 안의 맵이 그 난이도뿐)
            _Util:Warn("다른 난이도는 「게임 나가기」 뒤 그 난이도로 방을 만들어 간다", pc.UserId)
            return
        end
        local w = _WaypointData:Get(id)
        if w == nil or not self:IsKnownIn(diff, id) or not self:ActUnlockedIn(diff, math.floor(w.act or 1)) then return end
        if diff ~= stats.Difficulty then
            stats.Difficulty = diff
            stats:RefreshResists()    -- 난이도 저항 페널티 다시 계산
            -- 난이도마다 웨이포인트·방문 기록·의뢰가 따로다
            self:SwitchDifficulty(diff)
            ---@type PlayerQuest
            local quest = self.Entity:GetComponent("script.PlayerQuest")
            if quest ~= nil then quest:SwitchDifficulty(diff) end
            self:SyncDiffInfo()
        end
        self:Go(_GameConst:MapFor(w.map, diff), Vector2(w.x, w.y))
    end

    @ExecSpace("Server")
    method void RequestDifficulty(integer diff)
        -- 웨이포인트에서 난이도 변경 (개방된 것만) → 그 난이도의 마을로
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or pc.Hp <= 0 or not self:NearWaypoint() then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or diff < 0 or diff > stats.MaxDifficulty or diff == stats.Difficulty then return end
        if _GameConst:InGameRoom() then
            _Util:Warn("다른 난이도는 「게임 나가기」 뒤 그 난이도로 방을 만들어 간다", pc.UserId)
            return
        end
        stats.Difficulty = diff
        stats:RefreshResists()    -- 난이도 저항 페널티 다시 계산
        -- 난이도마다 웨이포인트·방문 기록·의뢰가 따로다 (처음 가는 난이도는 야영지 웨이포인트·1번 의뢰부터)
        self:SwitchDifficulty(diff)
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        if quest ~= nil then quest:SwitchDifficulty(diff) end
        -- 새 난이도는 액트 1 마을에서 시작한다 (D2)
        self.Act = 1
        self:GoTown()
    end

    -- ───────── 귀환 두루마리 ─────────

    @ExecSpace("ServerOnly")
    method void MigrateScrolls()
        -- 예전 저장의 귀환 두루마리 개수(tp)를 가방 물건으로 옮긴다 (불러오기 끝에 한 번). 가방이 가득 차 남은 개수는 TownScroll에 두고 계속 쓸 수 있다
        if self.TownScroll <= 0 then return end
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if inv == nil then return end
        local before = self.TownScroll
        self.TownScroll = inv:AddStack("tp", before)
        log("[VRF] 귀환 두루마리 " .. tostring(before - self.TownScroll) .. "장을 가방으로 옮김 (남음 " .. tostring(self.TownScroll) .. ")")
    end

    @ExecSpace("ServerOnly")
    method boolean UseTownScroll()
        -- 벨트 칸의 귀환 두루마리: 바로 옮기지 않고 사냥터 옆에 마을 포털, 마을에 되돌아올 포털을 연다 (D2)
        local pc = self.Entity.PlayerComponent
        if pc.Hp <= 0 then return false end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return false end
        if _GameConst:IsTown(map) then
            _Util:Warn("이미 마을이다", pc.UserId)
            return false
        end
        if map:GetComponent("script.DepthDirector") ~= nil then
            -- 심연은 하강 도전 — 층을 정복하고 문으로 나간다 (돌아올 포털을 열 수 없다)
            _Util:Warn("심연에서는 귀환 두루마리를 쓸 수 없다 — 층을 정복하고 왼쪽 문으로 나가라", pc.UserId)
            return false
        end
        local townName = self:TownMap()
        local town = _EntityService:GetEntityByPath("/maps/" .. townName)
        if not isvalid(town) then
            _Util:Warn("지금은 마을 포털을 열 수 없다", pc.UserId)
            return false
        end
        ---@type PlayerInventory
        local inv = self.Entity:GetComponent("script.PlayerInventory")
        if inv ~= nil and inv:TakeStack("tp", 1) then
            -- 가방의 귀환 두루마리를 쓴다
        elseif self.TownScroll > 0 then
            self.TownScroll = self.TownScroll - 1
        else
            _Util:Warn("귀환 두루마리가 없다 (상인에게 구입)", pc.UserId)
            return false
        end
        self:OpenTownPortal(map, town, _Util:Pos2(self.Entity))
        return true
    end

    @ExecSpace("ServerOnly")
    method void OpenTownPortal(Entity field, Entity town, Vector2 here)
        -- 예전 짝을 닫고 새 짝을 연다. 마을 쪽 포털은 연 자리(here)로 돌려보낸다 — 사냥터 포털은 그 옆이라 돌아와도 다시 빨려 들지 않는다
        self:ClosePortal(0)
        local name = self:OwnerName()
        local fieldSpot = self:FreeSpot(field, here, { Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1), Vector2(0.7, 0.7), Vector2(-0.7, 0.7), Vector2(0.7, -0.7), Vector2(-0.7, -0.7) }, self.PortalGap)
        -- 마을 쪽은 파티원 포털끼리 이름표가 겹치지 않게 넓게 (10-24: 1.4 간격이면 「되돌아가기 · 이름」 두 줄이 겹쳤다)
        local townSpot = self:FreeSpot(town, Vector2(4, -3.6), { Vector2(0, 0), Vector2(-1, 0), Vector2(1, 0), Vector2(-2, 0), Vector2(0, -0.7), Vector2(-1, -0.7), Vector2(1, -0.7), Vector2(-2, -0.7) }, 2.6)
        -- 이름표 「{가는 곳} - {주인}」 (10-24 사용자: 누구 포털인지·어디로 가는지 구분)
        self.FieldGate = self:SpawnPortal(field, fieldSpot, town.Name, Vector2(0, 0), self:PlaceName(town.Name) .. " - " .. name, false)
        self.TownGate = self:SpawnPortal(town, townSpot, field.Name, here, self:PlaceName(field.Name) .. " - " .. name, true)
        log("[VRF] 귀환 포털 열림 " .. field.Name .. " (" .. string.format("%.1f,%.1f", fieldSpot.x, fieldSpot.y) .. ") ↔ " .. town.Name)
    end

    @ExecSpace("ServerOnly")
    method any SpawnPortal(Entity map, Vector2 at, string targetMap, Vector2 targetPos, string label, boolean ownerCloses)
        -- 주인·파티원만 쓰는 귀환 포털 하나 (WarpGate.CanUse). ownerCloses: 주인이 지나가면 짝까지 닫힌다
        local e = _SpawnService:SpawnByModelId(_GameConst.ModelWarpGate, "ReturnGate", Vector3(at.x, at.y, 0), map)
        if not isvalid(e) then return nil end
        local ownerId = self.Entity.PlayerComponent.UserId
        _Util:AfterSpawn(e, "script.WarpGate", function(comp)
            ---@type WarpGate
            local gate = comp
            gate.TargetMap = targetMap
            gate.TargetPos = targetPos
            gate.Label = label
            gate.OwnerUserId = ownerId
            gate.OwnerCloses = ownerCloses
        end, nil)
        return e
    end

    @ExecSpace("ServerOnly")
    method void ClosePortal(number delay)
        -- 짝 포털 둘을 닫는다. 지금 짝만 붙잡아 두어 그사이 새로 연 짝은 닫지 않는다
        local a = self.FieldGate
        local b = self.TownGate
        self.FieldGate = nil
        self.TownGate = nil
        local close = function()
            if a ~= nil and isvalid(a) then a:Destroy() end
            if b ~= nil and isvalid(b) then b:Destroy() end
        end
        if delay <= 0 then close() else _TimerService:SetTimerOnce(close, delay) end
    end

    method string PlaceName(string mapName)
        -- 맵 표시 이름 (난이도 접미사 뗀 maps.csv name, 없으면 맵 id)
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(mapName))
        if info ~= nil and info.name ~= nil and info.name ~= "" then return (string.gsub(tostring(info.name), "%s*%(Lv[^%)]*%)", "")) end   -- 「(Lv 1~3)」은 뗀다
        return mapName
    end

    method string OwnerName()
        ---@type PlayerSave
        local save = self.Entity:GetComponent("script.PlayerSave")
        if save ~= nil then return save:CharName() end
        return self.Entity.PlayerComponent.Nickname
    end

    @ExecSpace("ServerOnly")
    method Vector2 FreeSpot(Entity map, Vector2 center, table dirs, number dist)
        -- center + dir*dist 중 걸을 수 있고 다른 포털과 겹치지 않는 첫 자리 (없으면 첫 후보)
        local memo = _Util:TerrainMemo(map)
        local gates = map:GetChildComponentsByTypeName("script.WarpGate", true)
        for _, d in ipairs(dirs) do
            local p = center + d * dist
            local ok = true
            if memo ~= nil then
                for _, o in ipairs({ Vector2(0, 0), Vector2(0.35, 0), Vector2(-0.35, 0), Vector2(0, 0.35), Vector2(0, -0.35) }) do
                    if _Util:CellBlocked(memo, p + o) then ok = false break end
                end
            end
            if ok then
                for _, g in ipairs(gates) do
                    local q = g.Entity.TransformComponent.WorldPosition
                    if (Vector2(q.x, q.y) - p):Magnitude() < 1.2 then ok = false break end
                end
            end
            if ok then return p end
        end
        return center + dirs[1] * dist
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- 나가면 연 포털을 닫는다 (주인이 없는 포털은 파티원도 못 쓴다)
        self:ClosePortal(0)
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method void SwitchDifficulty(integer diff)
        -- 지금 난이도의 기록을 보관하고 새 난이도의 기록을 꺼낸다
        if diff == self.Diff then return end
        self.KnownBy[tostring(self.Diff)] = self.Known
        self.VisitedBy[tostring(self.Diff)] = self.Visited
        self.Diff = diff
        self.Known = self.KnownBy[tostring(diff)] or "camp"
        self.Visited = self.VisitedBy[tostring(diff)] or ""
        self:SyncDiffInfo()
    end

    @ExecSpace("ServerOnly")
    method void SyncDiffInfo()
        -- 웨이포인트 창이 난이도를 바꿔 보기만 할 때 쓸 값: 난이도별 활성화 웨이포인트와 열린 액트
        self.KnownBy[tostring(self.Diff)] = self.Known
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        local known, acts = {}, {}
        for d = 0, 2 do
            local key = tostring(d)
            table.insert(known, key .. "=" .. (self.KnownBy[key] or "camp"))
            local open = 1
            if quest ~= nil then
                local index = 1
                if d == quest.Diff then index = quest.Index
                elseif quest.ByDiff[key] ~= nil then index = quest.ByDiff[key].i or 1 end
                for a = 2, 2 do
                    local last = _QuestData:LastOfAct(a - 1)
                    if last > 0 and index > last then open = a end
                end
            end
            table.insert(acts, key .. "=" .. tostring(open))
        end
        local k, a = table.concat(known, "|"), table.concat(acts, "|")
        if self.KnownAll ~= k then self.KnownAll = k end
        if self.ActOpenAll ~= a then self.ActOpenAll = a end
    end

    method string KnownIn(integer diff)
        -- 그 난이도에서 활성화한 웨이포인트 목록 (지금 난이도면 Known 그대로)
        if diff == self:Difficulty() then return self.Known end
        local v = string.match("|" .. self.KnownAll .. "|", "|" .. tostring(diff) .. "=([^|]*)|")
        return v or "camp"
    end

    method boolean IsKnownIn(integer diff, string id)
        return string.find("," .. self:KnownIn(diff) .. ",", "," .. id .. ",", 1, true) ~= nil
    end

    method boolean ActUnlockedIn(integer diff, integer act)
        -- 그 난이도에서 액트가 열렸는가 (지금 난이도면 의뢰 진행으로 바로 판단)
        if act <= 1 then return true end
        if diff == self:Difficulty() then return self:ActUnlocked(act) end
        local v = tonumber(string.match("|" .. self.ActOpenAll .. "|", "|" .. tostring(diff) .. "=(%d+)|"))
        return v ~= nil and v >= act
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        -- 보통은 예전 이름(known/vis), 악몽·지옥은 known1/vis1 · known2/vis2
        self.KnownBy[tostring(self.Diff)] = self.Known
        self.VisitedBy[tostring(self.Diff)] = self.Visited
        local out = { known = self.KnownBy["0"] or "camp", tp = self.TownScroll, at = self:CurrentSpot(), vis = self.VisitedBy["0"] or "", act = self.Act }
        for k = 1, 2 do
            local key = tostring(k)
            if self.KnownBy[key] ~= nil then out["known" .. key] = self.KnownBy[key] end
            if self.VisitedBy[key] ~= nil then out["vis" .. key] = self.VisitedBy[key] end
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        -- 능력치(난이도)가 먼저 불러와진 뒤에 온다 → 지금 난이도의 기록을 꺼낸다.
        -- 예전 저장(난이도 구분 없음)의 기록은 보통 난이도 것으로 본다
        if d == nil then return end
        self.KnownBy = { ["0"] = d.known or "camp" }
        self.VisitedBy = { ["0"] = type(d.vis) == "string" and d.vis or "" }
        for k = 1, 2 do
            local key = tostring(k)
            if type(d["known" .. key]) == "string" then self.KnownBy[key] = d["known" .. key] end
            if type(d["vis" .. key]) == "string" then self.VisitedBy[key] = d["vis" .. key] end
        end
        self.TownScroll = d.tp or 0
        self.ResumeAt = d.at
        self.Act = math.max(1, math.floor(tonumber(d.act) or 1))
        if not self:ActUnlocked(self.Act) then self.Act = 1 end
        local diff = self:Difficulty()
        self.Diff = diff
        self.Known = self.KnownBy[tostring(diff)] or "camp"
        self.Visited = self.VisitedBy[tostring(diff)] or ""
        self:SyncDiffInfo()
    end

    @ExecSpace("ServerOnly")
    method table CurrentSpot()
        -- 저장할 현재 자리: 마을이 아닌 일반(정적) 사냥터에 살아 있을 때만
        local map = self.Entity.CurrentMap
        -- 10-21 방 구조: 로비·게임 방은 이어하기 자리를 남기지 않는다 (방은 끊기면 사라진다 — 디아블로2처럼 로비에서 다시 고른다)
        if not isvalid(map) or map.Name == _GameConst.MapLobby or _GameConst:IsTown(map) or _RoomService:IsInstanceRoom() or not _Util:IsAlive(self.Entity) then return nil end
        if not isvalid(_EntityService:GetEntityByPath("/maps/" .. map.Name)) then return nil end
        local p = _Util:Pos2(self.Entity)
        return { m = map.Name, x = p.x, y = p.y, t = DateTime.UtcNow.Elapsed }
    end

    @ExecSpace("ServerOnly")
    method boolean TryResume()
        -- 재접속: 끊긴 지 ResumeWindowSec 안이면 마지막 사냥터 자리로 돌아간다 (휴대폰 앱 전환으로 끊겨도 마을로 튕기지 않게)
        local at = self.ResumeAt
        self.ResumeAt = nil
        if type(at) ~= "table" or type(at.m) ~= "string" or type(at.t) ~= "number" then return false end
        local age = (DateTime.UtcNow.Elapsed - at.t) / 1000
        if age < 0 or age > self.ResumeWindowSec then return false end
        if not isvalid(_EntityService:GetEntityByPath("/maps/" .. at.m)) then return false end
        log("[VRF] resume map=" .. at.m .. " age=" .. tostring(math.floor(age)))
        self:Go(at.m, Vector2(tonumber(at.x) or 0, tonumber(at.y) or 0))
        return true
    end

end
