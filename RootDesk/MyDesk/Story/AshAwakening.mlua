-- 재의 왕이 깨어난 뒤의 4장 (10-23 사용자: 「오렌을 잡고 나서 재의 왕이 부활하니 더 긴박하게 — 화면이 붉어지고, 한 번씩 떨리고, 메테오가 무작위로」).
-- 켜지는 때: 지금 난이도에서 고르의 정체가 드러났고(PlayerQuest.StoryStage == "r" — 심장의 사도를 쓰러뜨린 순간부터) 4장 맵에 있을 때.
-- 재의 왕을 쓰러뜨리면(단계 "4") 꺼진다. 심연(DepthDirector)은 제외.
-- 10-23 2차: 이야기 카드가 닫히고 4초 뒤 한 번에 깨어난다 — 안내 하나 (사용자: 「하늘이 핏빛으로 물든다 - 몬스터가 각성 상태가 됩니다」 하나로)
--   붉은 하늘   : 하늘이 핏빛 · 심장 박동처럼 밝기가 뛴다 (DarkVision.SetAwake)
--   땅울림      : 깨어날 때 크게 한 번, 그 뒤 이따금 길게 흔들린다
--   군세 각성   : 그 플레이어가 있는 4장 맵의 모든 몬스터에 몬스터 상태 「각성」 (monster_states.csv awaken — 이동·공격 속도 +20% · 붉은 몸 · 이름 아래 「각성」)
--   운석        : 몇 초 뒤부터 서버가 사냥터(마을·옥좌 제외)에서 플레이어마다 이따금 — 예고 원 뒤 그 자리에 화염 피해 (최대 생명의 %, 화염 저항 적용)
-- 위쪽 가운데 붉은 안내 (HudMap.ShowAlert). 클라이언트가 깨어날 때 서버에 알린다 (ReachPhase 4) — 안내보다 운석·각성이 먼저 오지 않게.
-- 접속할 때마다 처음부터 다시 연다 (서버 기록은 나가면 지운다).
@Logic
script AshAwakening extends Logic

    property number MeteorEvery = 11          -- 플레이어마다 평균 간격(초) ± MeteorJitter
    property number MeteorJitter = 4
    property number MeteorRadius = 1.3
    property number MeteorWarn = 1.4          -- 예고 원이 차오르는 시간
    property number MeteorHpPct = 0.16        -- 최대 생명의 16% (화염 저항만큼 줄어든다, 저항은 최대 75%)
    property number TremorMin = 14            -- 땅울림 간격(초)
    property number TremorMax = 26
    property string StateId = "awaken"        -- 군세 각성 때 몬스터에 붙이는 상태 (monster_states.csv — 배율·색·이름은 표에서)
    property number AlertSeconds = 4.2        -- 깨어남 안내가 떠 있는 시간
    property number FirstMeteorDelay = 4      -- 깨어난 뒤 첫 운석까지(초) — 안내를 읽을 틈
    property integer TimerId = 0
    -- 서버
    property table NextMeteor = {}            -- userId → 다음 운석 시각
    property table Phase = {}                 -- userId → 그 클라이언트가 연 단계 (0~4)
    property table AwakenedMaps = {}          -- 맵 id → 맵 (군세가 깨어난 맵 — 조건이 깨지면 되돌린다)
    property integer TickCount = 0
    -- 클라이언트
    property integer ClientPhase = 0          -- 0 = 아직 · 4 = 깨어남 (서버 Phase와 같은 값)
    property number SeqAt = 0                 -- 깨어난 시각 (0 = 아직)
    property number AwakeSince = 0            -- 처음 깨어난 것을 본 시각 (0 = 아직)
    property number StartDelay = 4            -- 깨어난 뒤 이만큼 기다렸다가 연출 (심장의 사도 처치 2.5초 뒤에 이야기 카드가 온다 — 그 전에 시작하면 카드 뒤에 묻힌다)
    property number NextTremor = 0
    property boolean ClientAwake = false

    method void OnBeginPlay()
        -- 서버는 운석·군세, 클라이언트는 단계 진행·하늘빛·땅울림 (한 스크립트, 실행 쪽마다 다른 주기)
        self.NextMeteor = {}
        self.Phase = {}
        self.AwakenedMaps = {}
        self.ClientAwake = false
        self.ClientPhase = 0
        self.SeqAt = 0
        self.AwakeSince = 0
        if self:IsServer() then
            self.TimerId = _TimerService:SetTimerRepeat(function() self:ServerTick() end, 0.5)
        else
            self.TimerId = _TimerService:SetTimerRepeat(function() self:ClientTick() end, 0.25)
        end
    end

    method void OnEndPlay()
        -- 세션 종료 시 주기 타이머를 해제한다
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    method boolean IsAwake(Entity player, Entity map)
        -- 이 플레이어에게 재의 왕이 깨어난 4장인가
        if not isvalid(player) or not isvalid(map) then return false end
        if map:GetComponent("script.DepthDirector") ~= nil then return false end
        if _GameConst:ActOfMap(map.Name) ~= 4 then return false end
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        -- 재의 왕을 쓰러뜨린 순간(보고 전)부터 끈다 — 하늘이 밝아지는 것(DarkVision.Cleared)과 같은 때
        return quest ~= nil and quest:StoryStage() == "r" and not quest:ActBossDown(4)
    end

    method boolean MeteorMap(Entity map)
        -- 운석은 사냥터에서만: 마을 · 옥좌(재의 왕 결전은 그 나름의 불기둥이 있다) 제외
        if _GameConst:IsTown(map) then return false end
        return _GameConst:BaseMapName(map.Name) ~= "throne"
    end

    method number Rand(number lo, number hi)
        -- lo ~ hi 사이 실수
        return lo + (hi - lo) * _UtilLogic:RandomDouble()
    end

    -- ───────── 서버: 단계 · 운석 · 군세 ─────────

    @ExecSpace("Server")
    method void ReachPhase(integer phase)
        -- 클라이언트가 깨어남 안내를 띄웠다 (4). 첫 운석은 안내를 읽을 틈을 두고 떨어뜨린다
        if senderUserId == nil or senderUserId == "" then return end
        self.Phase[senderUserId] = math.max(0, math.min(4, phase))
        if phase >= 3 then self.NextMeteor[senderUserId] = _UtilLogic.ElapsedSeconds + self.FirstMeteorDelay end
        log("[VRF] AshAwakening phase " .. tostring(phase) .. " " .. senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void ServerTick()
        -- 플레이어마다: 운석 단계면 다음 운석 시각에 그 곁에 떨어뜨린다. 군세 단계인 플레이어가 있는 맵은 몬스터를 깨운다
        local now = _UtilLogic.ElapsedSeconds
        local present = {}
        local wantMaps = {}
        for id, p in pairs(_UserService.UserEntities) do
            present[id] = true
            local map = isvalid(p) and p.CurrentMap or nil
            local awake = isvalid(map) and self:IsAwake(p, map)
            local phase = self.Phase[id] or 0
            if awake and phase >= 4 then wantMaps[map.Id] = map end
            if awake and phase >= 3 and _Util:IsAlive(p) and self:MeteorMap(map) then
                local at = self.NextMeteor[id]
                if at == nil then
                    self.NextMeteor[id] = now + self:Rand(self.MeteorEvery - self.MeteorJitter, self.MeteorEvery + self.MeteorJitter)
                elseif now >= at then
                    self.NextMeteor[id] = now + self:Rand(self.MeteorEvery - self.MeteorJitter, self.MeteorEvery + self.MeteorJitter)
                    self:DropMeteor(p, map)
                end
            elseif self.NextMeteor[id] ~= nil and (phase < 3 or not awake or not self:MeteorMap(map)) then
                self.NextMeteor[id] = nil
            end
        end
        -- 나간 사람의 기록은 지운다 (다시 들어오면 단계를 처음부터 연다)
        for id, _ in pairs(self.Phase) do
            if not present[id] then self.Phase[id] = nil self.NextMeteor[id] = nil end
        end
        -- 군세: 1초마다 맵의 몬스터 배율을 맞춘다 (새로 나온 몬스터도 곧 깨어난다)
        self.TickCount = self.TickCount + 1
        if self.TickCount % 2 ~= 0 then return end
        for mapId, map in pairs(self.AwakenedMaps) do
            if wantMaps[mapId] == nil then
                if isvalid(map) then self:SetState(map, "") end
                self.AwakenedMaps[mapId] = nil
            end
        end
        for mapId, map in pairs(wantMaps) do
            self.AwakenedMaps[mapId] = map
            self:SetState(map, self.StateId)
        end
    end

    @ExecSpace("ServerOnly")
    method void SetState(Entity map, string id)
        -- 이 맵 몬스터의 상태를 맞춘다 (각성을 붙이거나 뗀다 — 바뀐 몬스터만 Monster.SetMonsterState가 속도를 다시 계산)
        local changed = 0
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local m = c
            if m.MonsterState ~= id then
                m:SetMonsterState(id)
                changed = changed + 1
            end
        end
        if changed > 0 then log(string.format("[VRF] AshAwakening state %s '%s' n=%d", map.Name, id, changed)) end
    end

    @ExecSpace("ServerOnly")
    method void DropMeteor(Entity player, Entity map)
        -- 플레이어 곁(0~2.2칸) 한 곳: 예고 → MeteorWarn초 뒤 그 자리에 있는 플레이어 모두 화염 피해 (피할 수 있게 발밑 바로 아래는 드물다)
        local at = _Util:Pos2(player)
        local a = self:Rand(0, math.pi * 2)
        local r = self:Rand(0.4, 2.2)
        local c = Vector2(at.x + math.cos(a) * r, at.y + math.sin(a) * r * 0.7)
        self:MeteorWarnFx(map.Name, c, self.MeteorRadius, self.MeteorWarn)
        _TimerService:SetTimerOnce(function()
            if not isvalid(map) then return end
            self:MeteorBoomFx(map.Name, c, self.MeteorRadius)
            for _, u in ipairs(_Util:PlayersNear(map, c, self.MeteorRadius)) do
                ---@type PlayerVitals
                local vitals = u:GetComponent("script.PlayerVitals")
                ---@type PlayerStats
                local st = u:GetComponent("script.PlayerStats")
                if vitals ~= nil then
                    local res = st ~= nil and math.max(0, math.min(75, st:GetResist("fire"))) or 0
                    vitals:TakeTickDamage(u.PlayerComponent.MaxHp * self.MeteorHpPct * (1 - res / 100))
                end
            end
        end, self.MeteorWarn)
        log(string.format("[VRF] AshAwakening meteor %s (%.1f,%.1f)", map.Name, c.x, c.y))
    end

    @ExecSpace("Multicast")
    method void MeteorWarnFx(string mapName, Vector2 c, number radius, number seconds)
        -- 예고: 화염 장판 원 + 끝무렵 하늘에서 불덩이가 내려온다 (같은 맵에 있는 사람만)
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.CurrentMap) or p.CurrentMap.Name ~= mapName then return end
        local map = p.CurrentMap
        _Util:Telegraph(map, c, radius, "fire", seconds)
        local drops = { { 0.42, 3.0, 0.5 }, { 0.28, 1.9, 0.6 }, { 0.14, 0.9, 0.7 } }
        for _, d in ipairs(drops) do
            _TimerService:SetTimerOnce(function()
                if not isvalid(map) then return end
                _ParticleService:PlayBasicParticle(BasicParticleType.FireBall, map, Vector3(c.x + d[2] * 0.35, c.y + d[2], 0), 0, Vector3(d[3], d[3], 1), false, { SortingLayer = "MapLayer0", OrderInLayer = 6 })
            end, math.max(0, seconds - d[1]))
        end
    end

    @ExecSpace("Multicast")
    method void MeteorBoomFx(string mapName, Vector2 c, number radius)
        -- 떨어짐: 불 폭발 + 가까우면 화면이 흔들린다
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(p.CurrentMap) or p.CurrentMap.Name ~= mapName then return end
        local map = p.CurrentMap
        _Util:ElementBurst(map, Vector3(c.x, c.y, 0), radius, "fire", Color(1, 0.5, 0.3, 1))
        _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, map, Vector3(c.x, c.y, 0), 0, Vector3(radius * 0.6, radius * 0.6, 1), false, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(0.5, 0.42, 0.38, 0.8) })
        local d = (_Util:Pos2(p) - c):Magnitude()
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) and d < 6 then cam:ShakeCamera(d < 2 and 0.3 or 0.15, 0.3) end
        if d < 7 then _SoundDirector:PlayEffect(_GameConst.SfxImpact, d < 2 and 0.8 or 0.45) end
    end

    -- ───────── 클라이언트: 단계 진행 · 붉은 하늘 · 땅울림 ─────────

    @ExecSpace("ClientOnly")
    method boolean StoryBusy()
        -- 이야기 카드가 떠 있거나 기다리는 중 (심장의 사도를 쓰러뜨린 뒤 「꺼져 가는 불씨」·「행상의 정체」 14쪽이 먼저 나온다)
        return _StoryCard.Active or #_StoryCard.Queue > 0
    end

    @ExecSpace("ClientOnly")
    method void ClientTick()
        -- 깨어났으면 이야기 카드가 닫힌 뒤 한 번에 연출한다. 켜져 있는 동안 하늘빛을 맞추고 이따금 땅이 울린다
        local p = _UserService.LocalPlayer
        if not isvalid(p) then return end
        local map = p.CurrentMap
        local awake = self:IsAwake(p, map)
        local now = _UtilLogic.ElapsedSeconds
        if awake and self.AwakeSince == 0 then self.AwakeSince = now end
        local settled = self.AwakeSince > 0 and now >= self.AwakeSince + self.StartDelay
        if awake and settled and self.ClientPhase == 0 and not self:StoryBusy() and not _HudMap:BannerShowing() then
            self.ClientPhase = 4
            self.SeqAt = now
            self:Awaken(map)
            self:ReachPhase(4)
        end
        local sky = awake and self.ClientPhase >= 1
        if sky ~= self.ClientAwake then
            self.ClientAwake = sky
            _DarkVision:SetAwake(sky)
            log("[VRF] AshAwakening " .. (sky and "on" or "off"))
        end
        if awake and self.ClientPhase >= 2 and now >= self.NextTremor then
            self.NextTremor = now + self:Rand(self.TremorMin, self.TremorMax)
            self:Tremor(map, false)
        end
    end

    @ExecSpace("ClientOnly")
    method void Awaken(Entity map)
        -- 깨어나는 순간: 안내 하나 + 붉은 하늘 · 큰 땅울림 · 몬스터마다 붉은 불티
        _DarkVision:SetAwake(true)
        self.ClientAwake = true
        self:Tremor(map, true)
        self.NextTremor = _UtilLogic.ElapsedSeconds + self:Rand(8, 12)
        _SoundDirector:PlayEffect(_GameConst.SfxCurse, 0.9)
        self:AwakenFx(map)
        local st = _GameData:GetMonsterState(self.StateId)
        _HudMap:ShowAlert("하늘이 핏빛으로 물든다", "몬스터가 「" .. (st ~= nil and st.name or "각성") .. "」 상태가 됩니다", self.AlertSeconds)
        log("[VRF] AshAwakening client awaken")
    end

    @ExecSpace("ClientOnly")
    method void AwakenFx(Entity map)
        -- 군세 각성: 이 맵 몬스터마다 붉은 불꽃이 한 번 터진다 (가까운 것부터 최대 30)
        if not isvalid(map) then return end
        local me = _Util:Pos2(_UserService.LocalPlayer)
        local list = {}
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            local e = c.Entity
            if isvalid(e) and e.Enable then
                local at = _Util:Pos2(e)
                table.insert(list, { at = at, d = (at - me):Magnitude() })
            end
        end
        table.sort(list, function(a, b) return a.d < b.d end)
        for i = 1, math.min(30, #list) do
            local at = list[i].at
            -- 원 모양(ElementBurst의 장판)은 운석 예고 원과 헷갈려 불티만 튄다
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, map, Vector3(at.x, at.y + 0.5, 0), 0, Vector3(0.8, 0.8, 1), false, { SortingLayer = "MapLayer0", OrderInLayer = 8, Color = Color(1, 0.22, 0.15, 1) })
        end
    end

    @ExecSpace("ClientOnly")
    method void Tremor(Entity map, boolean big)
        -- 땅울림: 길게 흔들리고 낮은 울림, 주변에 먼지가 인다 (첫 땅울림은 더 크게)
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then cam:ShakeCamera(big and 0.42 or 0.28, big and 2.2 or 1.5) end
        _SoundDirector:PlayEffect(_GameConst.SfxSummon, big and 0.9 or 0.7)
        local p = _UserService.LocalPlayer
        if not isvalid(map) or not isvalid(p) then return end
        local at = _Util:Pos2(p)
        for i = 1, big and 6 or 3 do
            local x = at.x + self:Rand(-4, 4)
            local y = at.y + self:Rand(-2, 2)
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, map, Vector3(x, y, 0), 0, Vector3(0.8, 0.8, 1), false, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(0.45, 0.38, 0.34, 0.7) })
        end
    end

end
