-- 액트 최종 보스를 쓰러뜨린 순간 (클라이언트, docs/design/31 §7 · D2식): 흰 섬광 · 길게 흔들림 · 보스 자리에서 연달아 터지는 빛 · 큰 알림.
-- 어둠이 걷히는 것은 DarkVision이 의뢰 상태(PlayerQuest.ActBossDown)를 보고 천천히 밝힌다. 마을 사람 「!」는 HudMap.RenderCheerMarks.
-- 서버: ProgressionSystem.OnMonsterKilled → 그 맵의 플레이어마다 Play(..., userId)
@Logic
script ActClearFx extends Logic

    property string Flash = "BossFlash"     -- GameHUD 전체 화면 흰 판 (tools/build/ui.cjs)
    property number FlashStart = 0
    property number FlashLen = 1.4

    @ExecSpace("Client")
    method void Play(Vector3 pos, integer act, string bossName)
        -- 쓰러진 자리에서 2초 동안 빛이 연달아 터지고, 섬광이 걷힌 뒤 「해방」 알림
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local map = player.CurrentMap
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then cam:ShakeCamera(0.45, 1.6) end
        self.FlashStart = _UtilLogic.ElapsedSeconds
        _UIKit:SetColor(self.Flash, Color(1, 0.97, 0.9, 0.85))
        _UIKit:SetEnabled(self.Flash, true)
        _SoundDirector:PlayEffect(_GameConst.SfxLevelUp, 0.9)
        for i = 0, 8 do
            _TimerService:SetTimerOnce(function()
                if not isvalid(map) then return end
                local a = i * 2.4
                local r = 0.4 + i * 0.12
                local p = Vector3(pos.x + math.cos(a) * r, pos.y + 0.6 + math.sin(a) * r * 0.6, 0)
                local s = 0.9 + i * 0.12
                if i % 3 == 2 then
                    _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, map, p, 0, Vector3(s, s, 1), false, nil)
                else
                    _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, map, p, 0, Vector3(s * 1.3, s * 1.3, 1), false, { Color = Color(0.85, 0.75, 1, 1) })
                end
                if i == 8 then
                    -- 마지막: 풀려난 혼들이 빛으로 흩어진다
                    _ParticleService:PlayBasicParticle(BasicParticleType.Aura, map, Vector3(pos.x, pos.y + 0.4, 0), 0, Vector3(4, 4, 1), false, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(1, 0.95, 0.8, 0.6) })
                    if isvalid(cam) then cam:ShakeCamera(0.7, 0.5) end
                end
            end, i * 0.24)
        end
        _TimerService:SetTimerOnce(function()
            local title = _GameData:GetStory("act" .. tostring(act) .. "_title")
            _UXFeedback:ShowTinted((title ~= "" and title or ("액트 " .. tostring(act))) .. " — 해방",
                bossName .. " 처치 · 사냥터의 어둠이 걷혔다. 마을 사람들이 너를 기다린다", _GameData:GetUiIcon("q_done"), Color(1, 0.9, 0.65, 1))
        end, 2.2)
        log("[VRF] act clear fx act=" .. tostring(act) .. " " .. bossName)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 섬광이 천천히 걷힌다
        if self.FlashStart <= 0 then return end
        local t = (_UtilLogic.ElapsedSeconds - self.FlashStart) / self.FlashLen
        if t >= 1 then
            self.FlashStart = 0
            _UIKit:SetEnabled(self.Flash, false)
            return
        end
        _UIKit:SetColor(self.Flash, Color(1, 0.97, 0.9, 0.85 * (1 - t) * (1 - t)))
    end

end
