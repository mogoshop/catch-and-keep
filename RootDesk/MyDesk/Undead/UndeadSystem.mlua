-- 언데드 (디아블로2 네크로맨서 소환): 해골 전사·해골 마법사. 혼 하나를 소모해 일으킨다.
-- 혼은 한 번만 쓴다 — 해골·추출 중 하나 (D2의 시체와 같다).
-- 뼈 의식(10-29 · 해골 폭탄 병합: 1기 폭탄 · 2기 회오리 · 3기 화살 · 5기 거인 합체)·뼈 성찬(10-20): 일으킨 해골을 소모하는 스킬. 되살림·망자 폭쇄는 10-20에 빠졌다 (되살림 코드는 kind "revive"로 남아 있지만 부르는 스킬이 없다).
-- 수: D2 규칙 — 스킬 1~3레벨은 레벨만큼, 이후 2 + 레벨/3 (20레벨 8기, undeadCountMax). 꽉 차면 가장 오래된 것이 무너진다.
-- 되살림: 원본 몬스터 그대로 reviveSeconds(180초), 동시 수 = 스킬 레벨 (reviveCountMax 5).
-- 주인이 맵을 옮기면 다시 일으켜 따라오고, 주인이 죽으면 모두 무너진다. 그림자(영구 수집)와 달리 영구 저장하지 않는다. 방 이동은 공유 메모리의 일회성 전달을 쓴다.
-- 유닛 엔티티는 그림자와 같은 shadowunit 모델(ShadowUnit, Kind만 다름)을 쓴다.
-- 첫 처치 맛보기 그림자 (기획서 39 결정 #3A, 10-29 · SpawnTaste)는 10-31 사용자 결정으로 제거했다 — 되살림 칸을 빌리던 임시 경로도 함께 뺐다.
@Logic
script UndeadSystem extends Logic

    property string MageStand = "8b20897f0de04e76a742460b6cbadb41"   -- 리치 stand
    property string MageMove = "82965e5a9a6a4a9295a9dcb72c158c10"    -- 리치 move
    property string MageAttack = "2eb9f0c278734f558d87ac12159e09b5"  -- 리치 attack1

    property table Owned = {}            -- userId → { rec, ... } (오래된 순)
    property table TravelEpochs = {}      -- userId → 이동 번호 (이전 이동의 지연 생성 취소)
    property string TravelMemoryName = "UndeadRoomTravelV1"
    property integer Serial = 0
    property number SoulReach = 1.5      -- 조준점에서 혼을 찾는 거리
    property table Giants = {}            -- userId → 뼈 거인 상태 목록 { { host = 거인이 된 해골 기록, mates = 합쳐진 넷의 기록, epoch, kind }, ... } (뼈 의식 5기 · 48-4 한 플레이어 riteGiantMax 2마리 · 비면 nil)
    property table GiantCharges = {}      -- userId → 5기 충전 { charges, nextAt, period } (48 Q2 C2 · 메모리만 · 저장 안 함)
    property table TwinHunts = {}         -- userId → 쌍칼 후열 사냥 상태 { [유닛 id] = { target, targetId, reachAt, seenAt, ban } } (48 §1-4)
    property integer GiantEpoch = 0
    -- 거인 3종 그림 배율 (10-30 갈래 E · 시각만): 거인 그림(192 캔버스)이 등록되면 몸 배율 = 해골 배율 × 이 값. 1.2 = 지금 화면 키 유지
    --   (riteGiantScale 1.8 × 변이 그림 높이 128 ÷ 거인 그림 192). 46 §3-1 안은 1.0(해골 배율 그대로) — 메이커 E-M1 화면으로 코덱스가 정한다
    property number GiantArtScale = 1.2

    method table Elements()
        return { "fire", "cold", "light", "poison" }
    end

    method integer CountFor(integer slvl)
        -- 해골 전사·마법사 최대 수 (D2): 1, 2, 3, 3, 3, 4, 4, 4, 5 … 20레벨 8
        if slvl <= 0 then return 0 end
        if slvl <= 3 then return slvl end
        return math.min(math.floor(_GameData.undeadCountMax), 2 + math.floor(slvl / 3))
    end

    method integer ReviveCountFor(integer slvl)
        return math.min(math.floor(_GameData.reviveCountMax), slvl)
    end

    @ExecSpace("ServerOnly")
    method table LiveUnits(Entity player, string kinds)
        -- 살아 있는 해골 목록 { rec, unit } (kinds = "skeleton" 또는 "skeleton,mage"), 생명 낮은 순
        local list = {}
        for _, rec in ipairs(self:ListOf(player)) do
            if string.find("," .. kinds .. ",", "," .. rec.kind .. ",", 1, true) ~= nil and isvalid(rec.entity) then
                ---@type ShadowUnit
                local u = rec.entity:GetComponent("script.ShadowUnit")
                if u ~= nil and not u.Dead and u.Hp > 0 and not u.Bombing and not u.Giant then table.insert(list, { rec = rec, unit = u }) end   -- 돌진 중·거인은 바칠 수 없다
            end
        end
        table.sort(list, function(a, b) return a.unit.Hp / math.max(1, a.unit.MaxHp) < b.unit.Hp / math.max(1, b.unit.MaxHp) end)
        return list
    end

    @ExecSpace("ServerOnly")
    method void Detach(Entity player, table rec)
        -- 목록에서만 뺀다 (엔티티는 돌진·폭발이 끝날 때 스스로 사라진다). 수 표시를 바로 줄인다
        local list = self:ListOf(player)
        for i, r in ipairs(list) do
            if r == rec then table.remove(list, i) break end
        end
        rec.entity = nil
        self:RefreshSummary(player)
    end

    @ExecSpace("ServerOnly")
    method void NoteLost(Entity player, table rec, string reason)
        -- 실기록이 영구로 빠진 뒤에만 호출한다. 이동 재생성·편성 예측·거인 예약은 손실이 아니다.
        if rec == nil or rec.lossReported or not isvalid(player) then return end
        rec.lossReported = true
        _GameEvents:Emit("SummonLost", { player = player, kind = rec.kind, reason = reason })
    end

    @ExecSpace("ServerOnly")
    method void DetachConsumed(Entity player, table rec)
        local existed = false
        for _, r in ipairs(self:ListOf(player)) do if r == rec then existed = true break end end
        self:Detach(player, rec)
        if existed then self:NoteLost(player, rec, "consumed") end
    end

    @ExecSpace("ServerOnly")
    method boolean SkeletonBomb(Entity player, Vector2 target, number mult, number radius, integer count)
        -- 해골 폭탄 (10-20 사용자 제안): 생명이 가장 낮은 해골 전사 count기가 붉게 깜빡이며 조준점 근처 적에게 돌진해 터진다.
        -- 피해 = 그 해골 공격력 × mult (반경 radius). 돌진 중 쓰러져도 그 자리에서 터진다 (ShadowUnit.BombExplode)
        local picks = self:LiveUnits(player, "skeleton")
        if #picks == 0 then
            _Util:Warn("터뜨릴 해골 전사가 없습니다 — 해골 전사를 먼저 일으키세요", player.PlayerComponent.UserId)
            return false
        end
        local foe = _Util:NearestMonster(player.CurrentMap, target, 2.5)
        for i = 1, math.min(count, #picks) do
            local pick = picks[i]
            self:DetachConsumed(player, pick.rec)
            pick.unit:StartBomb(foe ~= nil and foe.Entity or nil, target, pick.unit.Atk * mult, radius)
        end
        log(string.format("[VRF] skeleton bomb n=%d mult=%.2f radius=%.2f foe=%s", math.min(count, #picks), mult, radius, tostring(foe ~= nil)))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean BoneRite(Entity player, integer stage, Vector2 target, number rankMul, Entity lock)
        -- 뼈 의식 2·3·5기 (기획서 43 §3-1). 2·3기는 생명이 가장 낮은 해골 전사부터 stage기를 바친다 (폭탄과 같은 순서 · 「뼈 파편」은 터지지 않는다).
        -- 5기는 바치지 않고 합친다 (StartGiant). 피해 = 바친 해골 평균 공격력 × 단계 배율 × rankMul (해골 공격력이 이미 캐릭터 레벨·숙련·장비를 따른다)
        local userId = player.PlayerComponent.UserId
        if stage == 5 then
            -- 46-1: 5기는 해골 전사 + 마법사 참여 다섯 (GiantPlan · 고리 예고와 같은 계획 — 서버 목록을 RosterView로 같은 모양으로 넘긴다)
            local plan = self:GiantPlanFor(player)
            if plan == nil then
                _Util:Warn("해골이 " .. tostring(5 - self:GiantPoolCount(self:RosterView(player))) .. "기 모자랍니다", userId)
                log("[VRF] rite stage=5 short pool=" .. tostring(self:GiantPoolCount(self:RosterView(player))))
                return false
            end
            return self:StartGiant(player, plan)
        end
        local picks = self:LiveUnits(player, "skeleton")
        if #picks < stage then
            _Util:Warn("해골 전사가 " .. tostring(stage - #picks) .. "기 모자랍니다", userId)
            log(string.format("[VRF] rite stage=%d skel=%d short", stage, #picks))
            return false
        end
        ---@type SkillEffects
        local fx = player:GetComponent("script.SkillEffects")
        if fx == nil then return false end
        local used = {}
        local sum = 0
        for i = 1, stage do
            local pick = picks[i]
            sum = sum + pick.unit.Atk
            table.insert(used, { pos = _Util:Pos2(pick.unit.Entity), unit = pick.unit })
            self:DetachConsumed(player, pick.rec)
            pick.unit.Dead = true   -- 판단·피격을 멈춘다 (쓰러짐 알림·뼈 파편 없음). 엔티티는 아래에서 치운다
        end
        local avg = sum / stage
        if stage == 2 then
            for _, u in ipairs(used) do
                fx:ClipFx(fx.FxShardHit, Vector3(u.pos.x, u.pos.y + 0.4, 0), 0.5, 0.6, 0)   -- 무너지는 뼛가루 (임시)
                if isvalid(u.unit.Entity) then u.unit.Entity:Destroy() end
            end
            fx:RiteWhirl(target, avg * _GameData.riteWhirlMul * rankMul)
        else
            fx:RiteArrows(used, target, avg * _GameData.riteArrowMul * rankMul, lock)
        end
        log(string.format("[VRF] rite stage=%d skel=%d consumed=%d avgAtk=%.0f rankMul=%.2f", stage, #picks, stage, avg, rankMul))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean StartGiant(Entity player, table plan)
        -- 뼈 의식 5기 거인 (46-1 · 기획서 46 §2-7 · §10-1): 참여 다섯(plan.picks · 소환 순서 앞 다섯) 가운데 이긴 종류(plan.type)의 해골 중
        -- 생명 비율이 가장 높은 하나(같으면 목록 앞)가 거인 몸이 되고 나머지 넷(종류 무관)은 목록에서 빠져 합쳐진다 (소모 아님 · 「~」).
        -- 46-3: 거인 생명 = 다섯 생명 합 × 종류 hpMul · 기본 공격 = 다섯 공격 합 × 종류 atkMul (rite_giants.csv · 46 결정 4 초안) · 받는 피해·간격·반경·도발은 ShadowUnit.StartGiant가 종류 줄로.
        -- riteGiantSeconds 뒤 남은 생명 비율대로 다섯으로 갈라진다 (EndGiant). 거인이 쓰러지면 다섯 모두 무너진다
        local uid = player.PlayerComponent.UserId
        if self:GiantCapReached(player) then
            _Util:Warn("거인은 두 기까지 세울 수 있습니다", uid)   -- 48 §9 후보 1 (상한 riteGiantMax)
            log(string.format("[VRF] giant cap count=%d cap=%d", self:GiantCount(player), self:GiantMax()))
            return false
        end
        if not self:GiantChargeReady(player) then
            log("[VRF] giant charge empty")   -- SkillBook 재사용 덮개(GiantChargeCover)가 먼저 막는다 · 여기는 서버 마지막 확인
            return false
        end
        local picks = {}
        for _, v in ipairs(plan.picks) do
            local u = isvalid(v.rec.entity) and v.rec.entity:GetComponent("script.ShadowUnit") or nil
            if u == nil or u.Dead or u.Hp <= 0 or u.Bombing or u.Giant then
                log("[VRF] rite stage=5 plan stale (unit gone)")
                return false
            end
            table.insert(picks, { rec = v.rec, unit = u, key = self:GiantKey(v) })
        end
        local host = nil
        for _, pick in ipairs(picks) do
            if pick.key == plan.type and (host == nil or pick.unit.Hp / math.max(1, pick.unit.MaxHp) > host.unit.Hp / math.max(1, host.unit.MaxHp)) then host = pick end
        end
        if host == nil then return false end
        local mates = {}
        local atk, maxHp, hp = host.unit.Atk, host.unit.MaxHp, host.unit.Hp
        for _, pick in ipairs(picks) do
            if pick ~= host then
                atk = atk + pick.unit.Atk
                maxHp = maxHp + pick.unit.MaxHp
                hp = hp + pick.unit.Hp
                pick.rec.currentHp = pick.unit.Hp
                pick.rec.merged = true   -- 46-0 R1: 거인에 합쳐진 기록 = 자리는 쓰되 서 있지 않음 (편성 계획 PlanList에 「~」로 들어간다)
                local from = _Util:Pos2(pick.unit.Entity)
                self:Detach(player, pick.rec)
                pick.unit.Dead = true
                if isvalid(pick.unit.Entity) then pick.unit.Entity:Destroy() end
                table.insert(mates, pick.rec)
                ---@type SkillEffects
                local fx = player:GetComponent("script.SkillEffects")
                if fx ~= nil then fx:ClipFx(fx.FxShardHit, Vector3(from.x, from.y + 0.4, 0), 0.5, 0.6, 0) end
            end
        end
        self.GiantEpoch = self.GiantEpoch + 1
        local epoch = self.GiantEpoch
        host.rec.giant = true
        local giants = self.Giants[uid] or {}
        table.insert(giants, { host = host.rec, mates = mates, epoch = epoch, kind = plan.type })
        self.Giants[uid] = giants
        local cover = self:GiantChargeUse(player)
        local spec = _GameData:GetGiant(plan.type)
        local gAtk, gHp, gMax = math.floor(atk * spec.atkMul), hp * spec.hpMul, maxHp * spec.hpMul
        host.unit:StartGiant(plan.type, gAtk, gMax, gHp, self:GiantLook(plan.type))
        self:RefreshSummary(player)
        _TimerService:SetTimerOnce(function() self:EndGiant(player, epoch, true) end, _GameData.riteGiantSeconds)
        log(string.format("[VRF] rite stage=5 giant type=%s counts=%s tie=%s banner=%s host=%s atk=%d hp=%.0f/%.0f sec=%.0f", plan.type, self:GiantCountsText(plan), tostring(plan.tie), tostring(plan.bannerUsed),
            host.rec.kind .. ":" .. (host.rec.form or ""), gAtk, gHp, gMax, _GameData.riteGiantSeconds))
        log(string.format("[VRF] giant count=%d cap=%d kinds=%s charge=%d cover=%.1f", #giants, self:GiantMax(), self:GiantKindsText(player), self:GiantChargeState(player).charges, cover))
        return true
    end

    -- ───────── 거인 인구 (48-4 · 호출처마다 뜻이 다른 함수 — 「서 있나」와 「상한에 닿았나」를 섞지 않는다) ─────────

    method integer GiantMax()
        -- 한 플레이어 뼈 거인 상한 (config riteGiantMax · 48-4 = 2)
        return math.max(1, math.floor(_GameData.riteGiantMax))
    end

    method integer CountKinds(string text)
        -- 「shield,mage」 쉼표 목록의 칸 수 ("" = 0)
        local n = 0
        for _ in string.gmatch(text or "", "[^,]+") do n = n + 1 end
        return n
    end

    method integer GiantCount(Entity player)
        -- 서 있는 뼈 거인 수: 서버 = Giants 목록 · 클라이언트 = 동기화된 ShadowCommander.GiantKind 쉼표 목록 (RefreshSummary)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return 0 end
        if self:IsServer() then
            local giants = self.Giants[player.PlayerComponent.UserId]
            return giants ~= nil and #giants or 0
        end
        ---@type ShadowCommander
        local cmd = player:GetComponent("script.ShadowCommander")
        return self:CountKinds(cmd ~= nil and cmd.GiantKind or "")
    end

    method boolean GiantStandingAny(Entity player)
        -- 거인이 하나라도 서 있나 (안내 띠·HUD 「거인 중」 표시 · 편성 미리보기 giant 같은 「존재」 판단)
        return self:GiantCount(player) > 0
    end

    method boolean GiantCapReached(Entity player)
        -- 거인 상한에 닿았나 (뼈 의식 5기를 건너뛰는 판단 RiteBestStage · StartGiant 거절) — 하나만 서 있으면 false
        return self:GiantCount(player) >= self:GiantMax()
    end

    @ExecSpace("ServerOnly")
    method string GiantKindsText(Entity player)
        -- 서 있는 거인 종류 쉼표 목록 「shield,mage」 (세운 순서 · ShadowCommander.GiantKind 동기화 값)
        local kinds = {}
        for _, g in ipairs(self.Giants[player.PlayerComponent.UserId] or {}) do table.insert(kinds, g.kind or "basic") end
        return table.concat(kinds, ",")
    end

    -- ───────── 5기 충전 (48 Q2 C2) ─────────
    -- 5기 단계만 충전 riteGiantCharges(2)회. 한 번에 한 칸씩 차오르고(직렬) 한 칸 길이 = riteGiantCd(30초) × 시전 속도 보정(PlayerStats.GetCastCooldownMult — 예전 재사용 계산 그대로).
    -- 하위 단계(1기 bone_rite · 2기 rite_whirl · 3기 rite_arrow)의 재사용 덮개와 섞지 않는다 — 5기 충전은 이 표만 쓰고 저장하지 않는다(재사용 덮개처럼 메모리만).
    -- 장기 가동률은 예전과 같다(한 칸 길이마다 거인 하나). 다른 것은 모아 둔 두 칸으로 처음 한 번 연달아 둘(초기 버스트)을 세울 수 있다는 것뿐

    method integer GiantChargeMax()
        return math.max(1, math.floor(_GameData.riteGiantCharges))
    end

    method table GiantChargeStep(table st, number now, integer max)
        -- 충전 진행 (순수): 진행 중인 칸이 끝났으면 한 칸 채우고, 아직 모자라면 다음 칸을 이어서 시작한다(직렬 · 다음 칸 길이 = st.period). 다 차면 nextAt 0
        while st.charges < max and st.nextAt > 0 and now >= st.nextAt do
            st.charges = st.charges + 1
            if st.charges < max then st.nextAt = st.nextAt + st.period else st.nextAt = 0 end
        end
        if st.charges >= max then
            st.charges = max
            st.nextAt = 0
        end
        return st
    end

    method boolean GiantChargeSpend(table st, number now, number period, integer max)
        -- 한 칸 쓴다 (순수). 차오르는 칸이 없으면 지금부터 period 뒤에 한 칸이 찬다 · 이미 차오르는 중이면 그 칸을 그대로 이어 간다(동시에 둘이 차지 않는다)
        st.period = period
        self:GiantChargeStep(st, now, max)
        if st.charges <= 0 then return false end
        st.charges = st.charges - 1
        if st.nextAt <= 0 then st.nextAt = now + period end
        return true
    end

    method number GiantChargeCoverOf(table st, number now, integer max)
        -- 5기 재사용 덮개 길이 (순수): 칸이 남아 있으면 0 · 다 썼으면 다음 칸이 찰 때까지
        self:GiantChargeStep(st, now, max)
        if st.charges > 0 then return 0 end
        return math.max(0, st.nextAt - now)
    end

    method number GiantChargePeriod(Entity player)
        -- 한 칸 길이 = riteGiantCd × 시전 속도 보정 (SkillBook.CastRite가 예전에 5기 재사용에 곱하던 값 그대로)
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        local mul = stats ~= nil and stats:GetCastCooldownMult() or 1
        return _GameData.riteGiantCd * mul
    end

    @ExecSpace("ServerOnly")
    method table GiantChargeState(Entity player)
        -- 그 플레이어의 충전 표 (처음 = 가득 · 다음 칸 길이는 지금 시전 속도로)
        local uid = player.PlayerComponent.UserId
        local max = self:GiantChargeMax()
        local st = self.GiantCharges[uid]
        if st == nil then
            st = { charges = max, nextAt = 0, period = 0 }
            self.GiantCharges[uid] = st
        end
        st.period = self:GiantChargePeriod(player)
        self:GiantChargeStep(st, _UtilLogic.ElapsedSeconds, max)
        return st
    end

    @ExecSpace("ServerOnly")
    method boolean GiantChargeReady(Entity player)
        -- 5기 충전이 한 칸 이상 있나
        return self:GiantChargeState(player).charges > 0
    end

    @ExecSpace("ServerOnly")
    method number GiantChargeCover(Entity player)
        -- SkillBook이 5기 재사용 덮개(rite_giant)에 거는 길이 (0 = 바로 또 쓸 수 있음)
        local st = self:GiantChargeState(player)
        return self:GiantChargeCoverOf(st, _UtilLogic.ElapsedSeconds, self:GiantChargeMax())
    end

    @ExecSpace("ServerOnly")
    method number GiantChargeUse(Entity player)
        -- 거인이 선 뒤 한 칸 쓴다 → 덮개 길이를 돌려준다 (칸이 없으면 -1)
        local st = self:GiantChargeState(player)
        local now = _UtilLogic.ElapsedSeconds
        if not self:GiantChargeSpend(st, now, self:GiantChargePeriod(player), self:GiantChargeMax()) then return -1 end
        local cover = self:GiantChargeCoverOf(st, now, self:GiantChargeMax())
        log(string.format("[VRF] giant charge use left=%d next=%.1f period=%.1f cover=%.1f", st.charges, st.nextAt > 0 and (st.nextAt - now) or 0, st.period, cover))
        return cover
    end

    -- ───────── 거인 고르기 (46-1 · 기획서 46 §2-7 · §10-1 · 서버·클라이언트 같은 순수 함수) ─────────

    method table GiantFallback()
        -- 동률 fallback 순서 (§10-2 F1): 방패 → 대검 → 쌍칼 → 마법사 → 기본 · 공방 깃발 줄 칸 순서도 같다
        return { "shield", "greatsword", "twin", "mage", "basic" }
    end

    method string GiantKey(table r)
        -- 거인 종류 키: 마법사는 변이와 무관하게 mage · 전사 일반형 basic · 전사 변이 그대로
        if r.kind == "mage" then return "mage" end
        if (r.form or "") == "" then return "basic" end
        return r.form
    end

    method table GiantPool(table roster)
        -- 참여 후보: EncodeRoster 모양 기록 가운데 해골 전사·마법사이고 거인 몸(!)·합쳐짐(~)·아직 못 바침(?)이 아닌 것 (목록 순서 = 소환 순서 그대로)
        local pool = {}
        for _, r in ipairs(roster or {}) do
            if (r.kind == "skeleton" or r.kind == "mage") and not r.giant and not r.merged and not r.notReady then table.insert(pool, r) end
        end
        return pool
    end

    method integer GiantPoolCount(table roster)
        return #self:GiantPool(roster)
    end

    method table GiantPlan(table roster, string banner)
        -- ① 참여 다섯 = 후보 앞 다섯 (결과 종류·깃발·생명과 무관 · E1) ② 5종 한 줄 투표 ③ 동률 최다 안에서만 깃발 ④ 아니면 fallback 순서 첫 동률.
        --   돌려줌 { type, picks(다섯 기록), counts(종류 → 수), tie, bannerUsed } · 후보 5 미만이면 nil. 목록·기록은 바꾸지 않는다
        local pool = self:GiantPool(roster)
        if #pool < 5 then return nil end
        local picks = {}
        local counts = {}
        for _, k in ipairs(self:GiantFallback()) do counts[k] = 0 end
        for i = 1, 5 do
            picks[i] = pool[i]
            local k = self:GiantKey(pool[i])
            counts[k] = (counts[k] or 0) + 1
        end
        local top = 0
        for _, k in ipairs(self:GiantFallback()) do top = math.max(top, counts[k]) end
        local tied = {}
        for _, k in ipairs(self:GiantFallback()) do if counts[k] == top then table.insert(tied, k) end end
        local kind = tied[1]
        local bannerUsed = false
        if #tied > 1 and (banner or "") ~= "" then
            for _, k in ipairs(tied) do
                if k == banner then
                    kind = banner
                    bannerUsed = true
                end
            end
        end
        return { type = kind, picks = picks, counts = counts, tie = #tied > 1, bannerUsed = bannerUsed }
    end

    method string GiantCountsText(table plan)
        -- 로그·검사용 「greatsword3,shield2」 (fallback 순서 · 0 생략)
        local parts = {}
        for _, k in ipairs(self:GiantFallback()) do
            if (plan.counts[k] or 0) > 0 then table.insert(parts, k .. tostring(plan.counts[k])) end
        end
        return table.concat(parts, ",")
    end

    method table GiantPlanFor(Entity player)
        -- 그 플레이어의 거인 계획: 서버 = RosterView(실제 목록 · 「?」 거르기) · 클라이언트 = 동기화된 UndeadRoster — 같은 GiantPlan · 같은 깃발(SkillBook.RiteBanner)
        local roster = {}
        if self:IsServer() then roster = self:RosterView(player) else roster = self:RosterOf(player).list end
        ---@type SkillBook
        local book = player:GetComponent("script.SkillBook")
        return self:GiantPlan(roster, book ~= nil and book.RiteBanner or "")
    end

    @ExecSpace("ServerOnly")
    method void EndGiant(Entity player, integer epoch, boolean respawn)
        -- 거인이 갈라진다: 거인 몸은 원래 해골로, 합쳐졌던 넷은 각자 최대 생명 × 남은 비율로 목록에 돌아온다 (respawn이면 그 자리에 다시 세운다).
        -- epoch 0 = 맵 이동·방 이동 직전 강제로 (LiveRecords) — 엔티티 없이 기록만 돌려 두면 따라오기가 다섯을 다시 세운다.
        -- 해골 최대 수를 넘으면 넘는 몫은 돌아오지 않는다 (거인 중에 새로 일으킨 경우)
        -- 48-4: 거인이 둘이면 epoch로 그 거인만 갈라진다 (epoch 0 = 모두) · 정원은 다른 거인에 아직 합쳐져 있는 기록까지 종류별로 센다
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local uid = player.PlayerComponent.UserId
        local giants = self.Giants[uid]
        if giants == nil then return end
        if epoch <= 0 then
            local all = {}
            for _, x in ipairs(giants) do table.insert(all, x) end
            for _, x in ipairs(all) do self:EndGiant(player, x.epoch, respawn) end
            return
        end
        local g = nil
        for i, x in ipairs(giants) do
            if x.epoch == epoch then
                g = x
                table.remove(giants, i)
                break
            end
        end
        if g == nil then return end
        if #giants == 0 then self.Giants[uid] = nil end
        g.host.giant = nil
        local ratio = 0
        local at = _Util:Pos2(player)
        if isvalid(g.host.entity) then
            ---@type ShadowUnit
            local u = g.host.entity:GetComponent("script.ShadowUnit")
            if u ~= nil and not u.Dead and u.Hp > 0 then
                ratio = u:EndGiant()
                at = _Util:Pos2(u.Entity)
            end
        end
        if ratio <= 0 then
            for _, rec in ipairs(g.mates) do self:NoteLost(player, rec, "host_gone") end
            log("[VRF] rite giant end ratio=0 (host gone)")
            self:RefreshSummary(player)
            return
        end
        local list = self:ListOf(player)
        -- 종류별 정원 (46-1: 넷에 마법사가 섞일 수 있다) — 거인 중에 새로 일으켜 정원을 넘는 몫은 돌아오지 않는다
        local have = { skeleton = 0, mage = 0 }
        for _, r in ipairs(list) do if have[r.kind] ~= nil then have[r.kind] = have[r.kind] + 1 end end
        for _, other in ipairs(self.Giants[uid] or {}) do
            for _, r in ipairs(other.mates) do if have[r.kind] ~= nil then have[r.kind] = have[r.kind] + 1 end end   -- 남은 거인에 합쳐진 기록도 자리를 쓴다
        end
        local max = { skeleton = self:MaxFor(player, "skeleton", self:SkillLevel(player, "raise_skeleton")), mage = self:MaxFor(player, "mage", self:SkillLevel(player, "raise_mage")) }
        local back = 0
        for _, rec in ipairs(g.mates) do
            rec.merged = nil
            if have[rec.kind] ~= nil and have[rec.kind] < max[rec.kind] then
                rec.currentHp = math.max(1, math.floor(rec.hp * ratio))
                rec.entity = nil
                table.insert(list, rec)
                have[rec.kind] = have[rec.kind] + 1
                back = back + 1
                if respawn and _Util:IsAlive(player) then self:SpawnUnit(player, rec, at, nil, nil) end
            else
                self:NoteLost(player, rec, "trimmed")
            end
        end
        self:RefreshSummary(player)
        log(string.format("[VRF] rite giant split back=%d/%d ratio=%.2f respawn=%s giants=%d", back, #g.mates, ratio, tostring(respawn), self:GiantCount(player)))
    end

    method table GiantStateOrder()
        -- 거인 그림 기본 동작 (tools/register_giant_visuals.cjs STATES와 같은 순서) — 모두 있어야 거인 그림을 쓴다.
        --   장 수는 정하지 않는다 (s48v2-A · 예전 납품 stand4·move6·attack6·skill6·hit2·split6은 그때 그림의 장 수일 뿐 · 재생은 MotionSmoother.FramePick)
        local order = { "stand", "move", "attack", "skill", "hit", "split" }
        return order
    end

    method table GiantExtraStates(table set)
        -- 48 §7-2 기술별 동작 (K-4 · 있을 때만 · 장 수는 종마다 다름 — register_giant_visuals.cjs EXTRA_STATES): 없으면 GiantMotionKey가 지금 skill 그림 · 쌍칼 연속 베기는 평타 그림을 쓴다
        --   s48v2-A: skill1 · skill2 다음에 표(set)에 있는 그 밖의 새 동작 키도 이름 순서로 (기본 동작은 빼고) — 새 몸 줄이 오면 코드 수정 없이 외형에 실린다
        --   (방패 함성 몸 = shield skill1 · C 등록 검증표와 같은 키 · 별칭 없음)
        local extra = { "skill1", "skill2" }
        if set ~= nil then
            local more = {}
            for st, _ in pairs(set) do
                local known = false
                for _, b in ipairs(self:GiantStateOrder()) do if b == st then known = true end end
                for _, b in ipairs(extra) do if b == st then known = true end end
                if not known then table.insert(more, st) end
            end
            table.sort(more)
            for _, st in ipairs(more) do table.insert(extra, st) end
        end
        return extra
    end

    method table GiantLook(string form)
        -- Five approved visual sets only; no selection, skill, damage or unlock policy change.
        --   서기·걷기·기술·피격·갈라짐 = 첫 칸 (클라이언트 FrameClip이 이어 넘김) · 공격 = 타격 칸 (기존 소환수 공격 규칙 — 서버 피해 시점에 타격 칸이 오게)
        --   48-6: attackFirst = 공격 첫 칸(쌍칼 연속 베기가 평타 그림을 처음부터 반복) · skill1/skill2 = 등록돼 있으면 첫 칸 (없어도 거인 그림은 쓴다)
        -- Missing/incomplete registration retains the existing art. Empty skeleton form means basic.
        if form == "" then form = "basic" end
        if form ~= "basic" and form ~= "mage" and form ~= "shield" and form ~= "greatsword" and form ~= "twin" then return nil end
        local set = _GameData:GetMonsterFrames("giant_" .. form)
        if set == nil then return nil end
        local look = { form = form }
        for _, st in ipairs(self:GiantStateOrder()) do
            local f = set[st]
            if f == nil or f.r == nil or #f.r == 0 then return nil end
            local idx = 1
            if st == "attack" then idx = math.max(1, math.min(#f.r, f.s or (#f.r // 2 + 1))) end
            if (f.r[idx] or "") == "" then return nil end
            look[st] = f.r[idx]
            local total = 0
            for _, d in ipairs(f.d or {}) do total = total + d end
            look[st .. "Sec"] = total
            if st == "attack" and (f.r[1] or "") ~= "" then
                look.attackFirst = f.r[1]
                look.attackFirstSec = total
            end
        end
        for _, st in ipairs(self:GiantExtraStates(set)) do
            local f = set[st]
            if f ~= nil and f.r ~= nil and #f.r > 0 and (f.r[1] or "") ~= "" then
                look[st] = f.r[1]
                local total = 0
                for _, d in ipairs(f.d or {}) do total = total + d end
                look[st .. "Sec"] = total
                -- s48v2-A: 몸 타격 칸(monster_frames impact → s)이 있으면 동작 시작부터 그 칸까지 시간 (서버 타격 시각 맞춤 확인용 · 그림만)
                if f.s ~= nil and f.s > 1 then
                    local hitAt = 0
                    for k = 1, f.s - 1 do hitAt = hitAt + (f.d[k] or 0) end
                    look[st .. "Hit"] = hitAt
                end
            end
        end
        return look
    end

    @ExecSpace("ServerOnly")
    method table PlanList(Entity player)
        -- 편성 계획 입력 (46-0 R1): 실제 목록(오래된 순 · 거인 몸 포함) 뒤에 거인에 합쳐진 넷(merged · 「~」)을 붙인 새 표.
        --   합쳐진 넷은 변이 자리를 쓰고(PickForm) 정원도 차지하지만(SlotCount) 서 있지 않고(SteadyRoster) 무너뜨릴 대상도 아니다(TrimVictims).
        --   조회만 한다 — 목록이 없는 플레이어도 Owned에 등록하지 않는다
        local out = {}
        local uid = player.PlayerComponent.UserId
        for _, rec in ipairs(self.Owned[uid] or {}) do table.insert(out, rec) end
        for _, g in ipairs(self.Giants[uid] or {}) do   -- 48-4: 거인 둘이면 둘 다의 넷 (종류별 정원은 SlotCount가 r.kind로 센다 — 옛 GiantReserved(전사만)는 지웠다)
            for _, rec in ipairs(g.mates) do
                rec.merged = true
                table.insert(out, rec)
            end
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method boolean NotReady(table rec)
        -- 아직 바칠 수 없는 기록 (46-0 · 「?」): 엔티티가 아직 없음(맵 이동 뒤 따라오기 전) · 쓰러짐 · 돌진 중 — LiveUnits 거르기와 같은 조건 (거인 몸·합쳐짐은 따로 표시)
        if not isvalid(rec.entity) then return true end
        ---@type ShadowUnit
        local u = rec.entity:GetComponent("script.ShadowUnit")
        return u == nil or u.Dead or u.Hp <= 0 or u.Bombing
    end

    @ExecSpace("ServerOnly")
    method table RosterView(Entity player)
        -- 동기화용 가벼운 기록 (EncodeRoster 입력 · GiantPlan 서버 입력과 같은 모양): PlanList 순서 그대로 { kind, form, giant, merged, notReady, rec }
        local out = {}
        for _, rec in ipairs(self:PlanList(player)) do
            if rec.kind == "skeleton" or rec.kind == "mage" then
                local wait = false
                if not rec.giant and not rec.merged then wait = self:NotReady(rec) end
                table.insert(out, { kind = rec.kind, form = rec.form or "", giant = rec.giant, merged = rec.merged, notReady = wait or nil, rec = rec })
            end
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method boolean BoneOffering(Entity player, number healPct, number radius, number frenzyPct)
        -- 뼈 성찬 (10-20): 생명이 가장 낮은 해골(전사·마법사) 1기를 바쳐, 주인 반경 radius 안 모든 소환수(그림자·해골) 생명을
        -- 최대 생명의 healPct% 회복하고 3초간 받는 피해 -20%. 강화 「피의 고양」이면 5초간 공격 속도 +frenzyPct%
        local picks = self:LiveUnits(player, "skeleton,mage")
        if #picks == 0 then
            _Util:Warn("바칠 해골이 없습니다 — 해골 전사·마법사를 먼저 일으키세요", player.PlayerComponent.UserId)
            return false
        end
        local pick = picks[1]
        local from = _Util:Pos2(pick.unit.Entity)
        self:DetachConsumed(player, pick.rec)
        pick.unit.Dead = true
        pick.unit.Entity:Destroy()
        local center = _Util:Pos2(player)
        local now = _UtilLogic.ElapsedSeconds
        local healed = 0
        ---@type SkillEffects
        local fx = player:GetComponent("script.SkillEffects")
        for _, comp in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            ---@type ShadowUnit
            local u = comp
            if u.OwnerPlayer == player and not u.Dead and u.Hp > 0 and isvalid(u.Entity) and (_Util:Pos2(u.Entity) - center):Magnitude() <= radius then
                u.Hp = math.min(u.MaxHp, u.Hp + u.MaxHp * healPct / 100)
                u.OfferUntil = now + 3
                if frenzyPct > 0 then
                    u.FrenzyUntil = now + 5
                    u.FrenzyPct = frenzyPct
                    -- 강화 「피의 고양」을 받은 소환수에 5초 붉은 기운 (44 §3-2: 공격 속도가 오른 것이 보이지 않았다)
                    if fx ~= nil then fx:StatusFxOn(u.Entity, "frenzy", 5) end
                end
                healed = healed + 1
            end
        end
        if fx ~= nil then
            fx:ClipFx(fx.FxOffering, Vector3(center.x, center.y + 0.2, 0), 1.1 * radius / 4, 0.9, 0)
            fx:ClipFx(fx.FxBlast, Vector3(from.x, from.y + 0.4, 0), 0.45, 0.8, 0)
        end
        log(string.format("[VRF] bone offering healed=%d pct=%.1f radius=%.1f", healed, healPct, radius))
        return true
    end

    @ExecSpace("ServerOnly")
    method void SkeletonBurst(ShadowUnit unit)
        -- 해골 전사 강화 「뼈 파편」: 쓰러질 때 반경 1.5 안 적에게 해골 공격력 × (0.5 × 랭크 + 0.5) 피해 (docs/design/16)
        local player = unit.OwnerPlayer
        if not isvalid(player) then return end
        local rank = self:SkillLevel(player, "skel_burst")
        if rank <= 0 or not isvalid(unit.Entity) then return end
        local p = _Util:Pos2(unit.Entity)
        local damage = unit.Atk * (0.5 * rank + 0.5)
        ---@type PlayerAttack
        local atk = player:GetComponent("script.PlayerAttack")
        if atk == nil then return end
        local hits = 0
        for _, m in ipairs(_Util:MonstersNear(unit.Entity.CurrentMap, p, 1.5)) do
            if not m.IsDead then
                atk:SkillHitOne(m.Entity, "skill.skel_burst", damage)
                hits = hits + 1
            end
        end
        log(string.format("[VRF] skeleton burst rank=%d dmg=%.0f hits=%d", rank, damage, hits))
        -- 뼈 파열은 모든 클라이언트에 (44 §3-2: 예전엔 서버에서만 불러 보이는지 알 수 없었다 — 주인 SkillEffects의 Multicast로)
        ---@type SkillEffects
        local fx = player:GetComponent("script.SkillEffects")
        if fx ~= nil then fx:StatusFx("boneburst", Vector3(p.x, p.y, 0), 1.5) end
    end

    method integer MaxFor(Entity player, string kind, integer slvl)
        -- 실제 최대 수 = 메인 랭크 규칙 + 강화 (뼈 군단 · 마법사 증원 · 군세) — docs/design/16
        if kind == "revive" then return self:ReviveCountFor(slvl) + self:SkillLevel(player, "revive_legion") end
        local node = kind == "mage" and "mage_legion" or "skel_legion"
        local choice = 0
        if kind ~= "mage" then
            ---@type PlayerQuest
            local quest = player:GetComponent("script.PlayerQuest")
            if quest ~= nil then choice = quest:ChoiceTier(1, "command") end   -- 선택 보상 1차 군단 「해골 하나 더」
        end
        return self:CountFor(slvl) + self:SkillLevel(player, node) + choice
    end

    @ExecSpace("ServerOnly")
    method table ListOf(Entity player)
        -- 주인별 목록 (무너진 것은 정리)
        local uid = player.PlayerComponent.UserId
        local list = self.Owned[uid]
        if list == nil then
            list = {}
            self.Owned[uid] = list
        end
        return list
    end

    -- ───────── 일으키기 ─────────

    method boolean IsValuableSoul(SoulOrb orb)
        -- 정예·무리 우두머리·최상위·보스 혼 = 그림자 추출용으로 아껴 둘 혼 (해골·폭쇄가 아무렇게나 쓰면 안 된다 — 10-11)
        return orb.Rank ~= "" and orb.Rank ~= "normal"
    end

    method SoulOrb FindUsableSoul(Entity player, Vector2 target, number radius)
        -- 해골·되살림·망자 폭쇄가 쓸 혼: 조준점 근처 일반 혼을 먼저. 귀한 혼(정예 이상)은 바로 그 혼을 겨눴을 때만(0.6 안)
        local orb = self:FindSoul(player, target, radius, true)
        if orb ~= nil then return orb end
        return self:FindSoul(player, target, math.min(radius, 0.6), false)
    end

    method SoulOrb FindSoul(Entity player, Vector2 target, number radius, boolean commonOnly)
        -- 다른 사람의 혼·이미 예약된 혼은 건너뛰고 내 혼만 찾는다. commonOnly면 일반 혼만 (귀한 혼은 추출용으로 남긴다)
        local best = nil
        local distance = radius
        if not isvalid(player.CurrentMap) then return nil end
        for _, comp in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.SoulOrb", true)) do
            ---@type SoulOrb
            local orb = comp
            if isvalid(orb.Entity) and orb.Entity.Enable and not orb.Consumed and not orb.Reserved and orb.OwnerUserId == player.PlayerComponent.UserId
                and not (commonOnly and self:IsValuableSoul(orb)) then
                local d = (_Util:Pos2(orb.Entity) - target):Magnitude()
                if d <= distance then
                    best = orb
                    distance = d
                end
            end
        end
        return best
    end

    method SoulOrb FindSoulInDirection(Entity player, Vector2 origin, Vector2 direction, number reach)
        -- 모바일 드래그·키보드 바라보는 방향: 그 방향의 내 일반 혼을 골라 정확한 위치에 시전한다 (귀한 혼은 자동으로 고르지 않는다)
        if not isvalid(player.CurrentMap) or direction:Magnitude() < 0.05 then return nil end
        local dir = direction:Normalize()
        local best = nil
        local bestScore = math.huge
        for _, comp in ipairs(player.CurrentMap:GetChildComponentsByTypeName("script.SoulOrb", true)) do
            ---@type SoulOrb
            local orb = comp
            if isvalid(orb.Entity) and orb.Entity.Enable and not orb.Consumed and not orb.Reserved and orb.OwnerUserId == player.PlayerComponent.UserId
                and not self:IsValuableSoul(orb) then
                local to = _Util:Pos2(orb.Entity) - origin
                local distance = to:Magnitude()
                if distance <= reach and distance > 0.05 then
                    local alignment = to:Normalize():Dot(dir)
                    local score = distance + (1 - alignment) * 3
                    if alignment >= 0.65 and score < bestScore then best = orb bestScore = score end
                end
            end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method boolean Raise(Entity player, string kind, integer slvl, Vector2 target, any onComplete, any canCommit)
        local userId = player.PlayerComponent.UserId
        local me = _Util:Pos2(player)
        if (target - me):Magnitude() > 5 then
            _Util:Warn("혼이 너무 멀리 있습니다", userId)
            return false
        end
        if (kind == "skeleton" or kind == "mage") and self:PlanFor(player, kind, slvl, self:PlanList(player), 0).blocked then
            -- 48-4: 정원이 모두 거인 몸·합쳐진 기록이라 교체할 개체가 없다 (거인은 무너뜨리지 않는다) → 추가 소환 없음 (혼·마나·재사용 그대로)
            _Util:Warn("정원이 모두 거인에 들어가 있습니다", userId)
            log(string.format("[VRF] roster raise blocked kind=%s giants=%d", kind, self:GiantCount(player)))
            return false
        end
        local orb = self:FindUsableSoul(player, target, self.SoulReach)
        if orb == nil then
            _Util:Warn("근처에 내 혼이 없습니다 — 몬스터를 처치한 뒤 소환하세요", userId)
            log("[VRF] summon rejected: no owned soul")
            return false
        end
        if kind == "revive" and (orb.Rank == "unique" or orb.Rank == "boss") then
            _Util:Warn("최상위·보스는 되살릴 수 없습니다", userId)
            return false
        end
        local pos = _Util:Pos2(orb.Entity)
        local rec = self:MakeRecord(player, kind, slvl, orb)
        orb.Reserved = true
        local finished = false
        local fail = function()
            if finished then return end
            finished = true
            if isvalid(orb.Entity) then orb.Reserved = false end
            self:DestroyEntity(rec)
            if onComplete ~= nil then onComplete(false) end
        end
        local spawned = self:SpawnUnit(player, rec, pos, function()
            if finished then self:DestroyEntity(rec) return end
            if not _Util:IsAlive(player) or not isvalid(orb.Entity) or player.CurrentMap ~= orb.Entity.CurrentMap then fail() return end
            if canCommit ~= nil and not canCommit() then fail() return end
            -- 한도를 넘으면 가장 오래된 것이 무너진다: 조용히 사라지지 않게 알린다 (정원·교체 계산은 편성 미리보기 RosterPreview와 같은 PlanFor → PlanNext)
            local plan = self:PlanFor(player, kind, slvl, self:PlanList(player), 0)   -- 뼈 거인에 합쳐진 넷도 자리를 차지한다 (46-0: 변이까지 · PlanList의 「~」 기록)
            -- 변이는 MakeRecord 때 같은 계획으로 정했다. 생성을 기다리는 사이 목록(사망·이동)·희망 편성·정원이 바뀌어 지금 계획(변이 + 무너질 기록)이 다르면
            --   혼을 쓰기 전에 거절한다 — 혼·마나·재사용·옛 개체 그대로 (B-DRAFT-01 · 변이만 지키고 새 교체를 따로 적용하지 않는다)
            if (kind == "skeleton" or kind == "mage") and (plan.blocked or not self:SamePlan(rec, plan)) then
                if not Environment:IsPublishedPlay() then log(string.format("[VRF] roster raise rejected stale plan kind=%s planned=%s now=%s victims=%d/%d", kind, rec.planForm or "", plan.form, #(rec.planVictims or {}), #plan.victims)) end
                _Util:Warn("소환하는 사이 편성이 바뀌어 취소했습니다 · 다시 사용해 주세요", userId)
                fail()
                return
            end
            rec.planVictims = nil
            finished = true
            orb:Consume()
            if plan.full then
                local names = { skeleton = "해골 전사", mage = "해골 마법사", revive = "되살린 몬스터" }
                _Util:Notify((names[kind] or kind) .. "는 지금 최대 " .. tostring(plan.max) .. "기 — 가장 오래된 하나가 무너졌습니다 (스킬 레벨을 올리면 늘어납니다)", userId)
            end
            self:TrimOldest(player, kind, plan.keep)
            table.insert(self:ListOf(player), rec)
            if (kind == "skeleton" or kind == "mage") and not Environment:IsPublishedPlay() then
                log(string.format("[VRF] roster raised kind=%s form=%s planned=%s match=%s trimmed=%d direct=%s", kind, rec.form or "", rec.planForm or "", tostring(plan.form == (rec.planForm or "")), #plan.victims, tostring(plan.direct)))
            end
            self:RefreshSummary(player)
            self:PlaySummonFx(player, pos)
            _GameEvents:Emit("UndeadRaised", { player = player, kind = kind })
            if onComplete ~= nil then onComplete(true) end
        end, fail)
        if not spawned then orb.Reserved = false return false end
        _TimerService:SetTimerOnce(function() if not finished then fail() end end, 1)
        return true
    end

    -- 확정된 소환에만 표시한다. PNG는 애니메이션 clip이 아니므로 장식 모델로 재생한다.
    @ExecSpace("ServerOnly")
    method void PlaySummonFx(Entity player, Vector2 pos)
        if not isvalid(player.CurrentMap) then return end
        local fx = _SpawnService:SpawnByModelId("summonritual", "SummonRitual", Vector3(pos.x, pos.y, 0), player.CurrentMap)
        if not isvalid(fx) then return end
        fx.TransformComponent.Scale = Vector3(0.1, 0.055, 1)
        for i = 1, 6 do
            local step = i
            _TimerService:SetTimerOnce(function()
                if not isvalid(fx) then return end
                local t = step / 6
                fx.TransformComponent.Scale = Vector3(0.1 + 0.07 * t, 0.055 + 0.035 * t, 1)
                fx.SpriteRendererComponent.Color = Color(0.85, 0.75, 1, 1 - t)
            end, step * 0.12)
        end
        fx:Destroy(0.8)
    end

    @ExecSpace("ServerOnly")
    method table MakeRecord(Entity player, string kind, integer slvl, SoulOrb orb)
        -- 일으킬 때 숙련과 장비 소환수 보너스를 확정한다. 이동 때는 재적용하지 않는다.
        self.Serial = self.Serial + 1
        local rec = { id = "ud" .. tostring(self.Serial), kind = kind, ownerEntityId = player.Id, expireAt = 0, entity = nil, element = "", ratio = 0 }
        local base = self:GetBaseStats(kind, slvl, self:SkillLevel(player, "skeleton_mastery"), _GameConst:LevelOf(player))
        if kind == "skeleton" then
            local m = _GameData:GetMonsterStats("skel_warrior")
            rec.atk = base.atk
            rec.hp = base.hp
            rec.cooldown = _GameData.skeletonCooldown
            rec.range = 0.8
            rec.speed = _GameData.skeletonSpeed
            rec.stand = m ~= nil and m.stand or ""
            rec.move = m ~= nil and m.move or ""
            rec.attack = m ~= nil and m.attack or ""
            rec.scale = 0.55          -- 필드의 해골 전사(1배)보다 확실히 작게
            rec.tint = Color(0.78, 0.9, 0.95, 1)   -- 10-28 F5 B-1: 필드 해골 수비병(흰 뼈)과 같은 그림이라 소환수는 서늘한 아군 색조 (예전 0.92, 0.9, 0.82)
            -- 변이 = 다음 소환 계획 (I03 단계 2 · 미리보기 RosterPreview와 같은 PlanFor). 이 계획이 스냅샷이다
            local plan = self:PlanFor(player, kind, slvl, self:PlanList(player), 0)
            rec.planForm = plan.form
            rec.planVictims = plan.victims   -- 확정 직전 다시 맞춰 볼 무너질 기록 (Raise · SamePlan)
            self:LogPlan("plan", kind, plan)
            self:ApplySkeletonForm(player, rec, plan.form)
        elseif kind == "mage" then
            -- 48-2 (갈래 B MageBolts 연결): 속성 = 화염 · 냉기 · 뼈 · 영혼 (+ 「저주 속성」 노드면 저주) 무작위 · 피해 속성 · 몸 칠 · 일으킬 때의 마법사 랭크(특성 구간)
            rec.school = _MageBolts:PickSchool(self:SkillLevel(player, "mage_curse") > 0)
            rec.element = _MageBolts:ElementOf(rec.school)
            rec.mageRank = slvl
            rec.ratio = 1
            rec.atk = base.atk * (1 + _GameData.mageFocusPct / 100 * self:SkillLevel(player, "mage_focus"))   -- 강화 「원소 집중」
            rec.hp = base.hp
            rec.cooldown = _GameData.mageCooldown
            rec.range = _GameData.mageRange
            rec.speed = _GameData.skeletonSpeed
            -- 해골 마법사는 전사와 다른 그림: 메이플 「리치」(mob/6090000, 로브 입은 해골 마법사) 서기·이동·공격1. 속성 색은 그대로 입힌다
            rec.stand = self.MageStand
            rec.move = self.MageMove
            rec.attack = self.MageAttack
            rec.scale = 0.5
            rec.tint = _MageBolts:BodyTint(rec.school)
            local plan = self:PlanFor(player, kind, slvl, self:PlanList(player), 0)   -- 46-1부터 마법사도 거인에 합쳐질 수 있다 (PlanList 「~」)
            rec.planForm = plan.form
            rec.planVictims = plan.victims
            self:LogPlan("plan", kind, plan)
            self:ApplyMageForm(player, rec, plan.form)
        else
            -- 동시 개체 수 상한 이후에도 투자 레벨에 따라 능력치가 성장한다.
            local mul = self:GetReviveMultiplier(slvl) / _GameData.shadowStatMul
            -- 되살린 몬스터도 힘은 주인 레벨까지 (Lv10이 악몽 Lv31을 되살려도 Lv10 힘)
            local prof = _ShadowConfig:GetProfile(orb.SourceId, orb.Grade, _ShadowConfig:EffectiveLevel(orb.Level, _GameConst:LevelOf(player)), mul)
            rec.atk = prof.atk
            rec.hp = prof.hp
            rec.cooldown = prof.cooldown
            rec.range = prof.range
            rec.speed = prof.speed
            rec.element = prof.element
            rec.ratio = prof.ratio
            rec.resists = prof.resists
            rec.stand = orb.StandRUID
            rec.move = orb.MoveRUID
            local source = _GameData:GetMonsterStats(orb.SourceId)
            rec.attack = source ~= nil and source.attack or ""
            rec.scale = source ~= nil and source.summonScale or 1   -- 원본 크기와 상관없이 소환수끼리 비슷한 크기 (10-10 QA)
            rec.tint = Color(0.6, 1, 0.65, 0.9)
            rec.variant = orb.Variant        -- 되살린 변종 우두머리는 능력도 그대로
            rec.expireAt = _UtilLogic.ElapsedSeconds + _GameData.reviveSeconds + 30 * self:SkillLevel(player, "revive_long")   -- 강화 「오래 버팀」
        end
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        local equipment = stats ~= nil and math.max(0.1, 1 + stats:GetMinionPct() / 100) or 1   -- 장비 + 통솔
        -- 호령 오라도 숙련처럼 일으키는 순간 확정한다 (다음 소환부터 적용)
        ---@type SkillBook
        local book = player:GetComponent("script.SkillBook")
        local aura = book ~= nil and book:GetCommandAura() or { atk = 0, speed = 0, resist = 0 }
        equipment = equipment * (1 + aura.atk / 100)
        rec.atk = math.max(1, math.floor(rec.atk * equipment))
        rec.hp = math.max(1, math.floor(rec.hp * equipment))
        rec.speed = rec.speed * (1 + aura.speed / 100)
        rec.auraResist = aura.resist
        return rec
    end

    method Color ElementTint(string element)
        if element == "fire" then return Color(1, 0.55, 0.4, 1) end
        if element == "cold" then return Color(0.55, 0.75, 1, 1) end
        if element == "light" then return Color(1, 0.95, 0.5, 1) end
        return Color(0.55, 1, 0.5, 1)
    end

    method table GetBaseStats(string kind, integer level, integer masteryLevel, integer ownerLevel)
        -- 소환 레코드와 스킬 창이 동일한 숙련·반올림 순서를 사용한다. 장비는 호출부에서 적용한다.
        -- 기본값 × 주인 레벨 성장(몬스터 곡선 × summonGrowthMul) × 스킬 레벨 % × 숙련 %
        local mastery = 1 + _GameData.skeletonMasteryPct * masteryLevel / 100
        -- 스킬 레벨 %: 해골 전사 skeletonSkillLvPct(12) · 마법사 undeadSkillLvPct(14) — 10-24 사용자 (c)
        local skill = 1 + (kind == "skeleton" and _GameData.skeletonSkillLvPct or _GameData.undeadSkillLvPct) * math.max(0, level - 1) / 100
        local lv = math.max(1, ownerLevel)
        local hpGrow = 1 + _GameData.monsterHpPerLevel * _GameData.summonGrowthMul * (lv - 1)
        local atkGrow = 1 + _GameData.monsterDmgPerLevel * _GameData.summonGrowthMul * (lv - 1)
        local atkBase, hpBase = _GameData.skeletonAtkBase, _GameData.skeletonHpBase
        if kind == "mage" then atkBase, hpBase = _GameData.mageAtkBase, _GameData.mageHpBase
        elseif kind ~= "skeleton" then return {} end
        return { atk = math.floor(atkBase * atkGrow * skill * mastery), hp = math.floor(hpBase * hpGrow * skill * mastery) }
    end

    @ExecSpace("ServerOnly")
    method void ApplySkeletonForm(Entity player, table rec, string pick)
        -- 해골 전사 변이 편성 (10-24 사용자 C안 · 48-1): 변이(대검 · 쌍칼)마다 랭크 수만큼 해골이 그 모습으로 선다. 일으킬 때 아직 자리가 남은 변이를
        -- 대검 → 쌍칼 순으로 채우고, 다 차면 기본형. 쓰러진 해골의 자리는 다음에 일으키는 해골이 잇는다
        -- 대검 = 범위 베기·느림·단단 / 쌍칼 = 빠름·약함·후열 사냥(ShadowUnit.TwinHunt*)
        -- 48-1 진화: raise_skeleton 효과 레벨(장비 +스킬 포함 · Q6) skelEvolveRank(8) 이상이면 기본형 = 방패 해골 (pick "shield" — BaseForm) · 받는 피해↓·도발
        --   이미 서 있는 해골은 일으킨 순간의 기록 그대로다 (진화해도 다시 만들거나 무너뜨리지 않는다 · 다음 일으키기부터 방패)
        -- 어느 변이로 설지(pick)는 다음 소환 계획 PlanFor(PlanNext + BaseForm)가 정한다 (자동 = 위 규칙 · 직접 = 희망 수 · I03 단계 2 — MakeRecord).
        -- 세기는 늘 노드 랭크(FormQuota) · 방패는 진화 단계(EvolveStep) — 직접 편성 희망 수를 낮춰도 서는 개체의 방어·속도·범위는 그대로다 (B-R01)
        local quota = self:FormQuota(player, "skeleton")
        local gs = pick == "greatsword" and quota.greatsword or 0
        local sh = pick == "shield" and self:EvolveStep(self:SkillLevel(player, "raise_skeleton")) or 0
        local tw = pick == "twin" and quota.twin or 0
        rec.form = ""
        if gs > 0 then
            rec.form = "greatsword"
            rec.hp = math.floor(rec.hp * 1.2)
            rec.cooldown = rec.cooldown * 1.4
            rec.radiusMul = 1.8
            rec.basicMul = 0.65 + 0.15 * gs
        elseif sh > 0 then
            rec.form = "shield"
            rec.hp = math.floor(rec.hp * 1.1)
            rec.guard = self:EvolveGuard(sh)   -- 20/25/30 (진화 1·2·3단계 = 효과 레벨 8·14·20 · 예전 방패 변이 노드 1·2·3랭크 값)
            rec.taunt = true
        elseif tw > 0 then
            rec.form = "twin"
            rec.hp = math.floor(rec.hp * 0.85)
            rec.cooldown = rec.cooldown / (1.2 + 0.1 * tw)
        end
        self:ApplyFormLook(rec)
    end

    @ExecSpace("ServerOnly")
    method void ApplyMageForm(Entity player, table rec, string pick)
        -- 48-2: 해골 마법사 변이는 없다 (FormOrder("mage") 비어 있음 · 몸 1종). 속성·특성은 MakeRecord의 rec.school · rec.mageRank (MageBolts)
        --   옛 변이 칸(bolts · boltMul · pierce · hex · blast · aura 변종)은 쓰지 않는다 — pick은 늘 "" (PlanNext)
        rec.form = ""
    end

    @ExecSpace("ServerOnly")
    method void ApplyFormLook(table rec)
        -- 변이 해골 그림 = 코덱스 전용 프레임 (monster_frames.csv form_skelform_<변이> · 10-24 사용자 승인). 서기·걷기 첫 장과 공격 타격 장을 주면
        -- 클라이언트(MotionSmoother.FrameClip)가 프레임을 넘긴다. 그림 자체에 색이 있어 물들이지 않는다 (예전 임시: 바르그 축소 · 푸른/붉은 물들이기)
        -- 해골 마법사 변이도 같은 방식 (form_mageform_<변이> · 10-24 코덱스 130 프레임). 원소는 화살 색으로만 보인다 (몸은 물들이지 않는다)
        if (rec.kind ~= "skeleton" and rec.kind ~= "mage") or (rec.form or "") == "" then return end
        local prefix = rec.kind == "mage" and "mageform_" or "skelform_"
        local frames = _GameData:GetMonsterFrames(prefix .. rec.form)
        if frames == nil or frames.stand == nil then return end
        rec.stand = frames.stand.r[1]
        rec.move = frames.move ~= nil and frames.move.r[1] or rec.stand
        if frames.attack ~= nil then rec.attack = frames.attack.r[math.min(#frames.attack.r, frames.attack.s or math.floor(#frames.attack.r / 2) + 1)] end
        rec.scale = rec.kind == "mage" and 0.5 or 0.55   -- 일반 해골·마법사와 같은 몸 크기 (대검은 칼 때문에 캔버스만 넓다)
        rec.tint = Color(1, 1, 1, 1)
    end

    method number GetReviveMultiplier(integer level)
        -- 다음 소환 미리보기와 실제 생성에서 같은 배율을 사용한다.
        return _GameData.reviveStatMul * (1 + math.max(0, level - 1) * _GameData.reviveStatPerLvPct / 100)
    end

    @ExecSpace("ServerOnly")
    method void TrimOldest(Entity player, string kind, integer keep)
        -- kind가 keep 개를 넘으면 가장 오래된 것부터 무너뜨린다 (D2). 누구를 무너뜨릴지는 TrimVictims (편성 미리보기와 공유)
        local list = self:ListOf(player)
        for _, victim in ipairs(self:TrimVictims(list, kind, keep)) do
            self:DestroyEntity(victim)
            self:RemoveRec(list, victim)
            self:NoteLost(player, victim, "trimmed")
        end
    end

    -- ───────── 편성 규칙 (일으키기·편성 미리보기 공용 · 읽기만 하는 함수) ─────────

    method table FormOrder(string kind)
        -- 변이를 채우는 순서 (10-24 사용자 C안 · 48-1): 전사 대검 → 쌍칼 (방패는 변이가 아니라 진화한 기본형 — BaseForm) · 마법사 광기 → 저주 → 쌍발 → 관통 → 폭발
        if kind == "mage" then return {} end   -- 48-2: 마법사 변이(광기·저주·쌍발·관통·폭발) 삭제 — 몸 1종 · 속성은 rec.school
        if kind == "skeleton" then return { "greatsword", "twin" } end
        return {}
    end

    method table ShownForms(string kind)
        -- 편성 줄에 보일 모습 순서: 일반 → (전사: 진화한 방패) → 변이 순서 (48-1 · SkillBook.RosterLine이 p.units를 이 순서로 읽으면 방패가 보인다)
        local out = { "" }
        if kind == "skeleton" then table.insert(out, "shield") end
        for _, f in ipairs(self:FormOrder(kind)) do table.insert(out, f) end
        return out
    end

    method integer EvolveRank()
        -- 해골 전사가 방패 해골로 진화하는 raise_skeleton 효과 레벨 (공방 단계 줄 8번째 칸 표식)
        return math.floor(_GameData.skelEvolveRank)
    end

    method integer EvolveStep(integer level)
        -- 진화 단계 (48-1): 0 = 일반 · 1·2·3 = 방패 (효과 레벨 skelEvolveRank·GuardRank2·GuardRank3 = 8·14·20)
        if level >= _GameData.skelEvolveGuardRank3 then return 3 end
        if level >= _GameData.skelEvolveGuardRank2 then return 2 end
        if level >= _GameData.skelEvolveRank then return 1 end
        return 0
    end

    method number EvolveGuard(integer step)
        -- 진화한 방패 해골 받는 피해 -% (20/25/30)
        return _GameData.skelEvolveGuardPct + _GameData.skelEvolveGuardStep * (math.max(1, step) - 1)
    end

    method string BaseForm(Entity player, string kind)
        -- 변이 자리가 없을 때 서는 기본형: 해골 전사는 효과 레벨 8부터 "shield"(방패 해골) · 그 전과 마법사는 ""
        if kind ~= "skeleton" then return "" end
        if self:EvolveStep(self:SkillLevel(player, "raise_skeleton")) > 0 then return "shield" end
        return ""
    end

    method table FormQuota(Entity player, string kind)
        -- 변이별 자리 수 = 그 변이 강화 노드 랭크 (skel_greatsword · skel_twin · mage_aura …) — skel_shield는 48-1에 지웠다(방패 = 진화)
        local quota = {}
        local prefix = kind == "mage" and "mage_" or "skel_"
        for _, form in ipairs(self:FormOrder(kind)) do quota[form] = self:SkillLevel(player, prefix .. form) end
        return quota
    end

    method table ParseHope(string text)
        -- 희망 편성 (I03 단계 2 · 코덱스 A안): "s:d:shield=1,greatsword=0,twin=2/m:a:aura=1" → { skeleton = { direct, want }, mage = { direct, want } }.
        -- 종류가 없거나 모드가 a면 자동 (현행 규칙 그대로 · 옛 저장 ""). want는 저장된 희망 수 그대로 — 배운 랭크·정원으로 자르지 않는다 (장비를 바꿔도 덮어쓰지 않는다 · B-R02)
        -- 48-1: 옛 저장의 shield=N은 FormOrder에 없어 읽을 때 버린다 → 그 몫은 기본형(진화 뒤 방패)으로 채워진다 · 다음 저장(EncodeHope)에서 사라진다
        local out = { skeleton = { direct = false, want = {} }, mage = { direct = false, want = {} } }
        for part in string.gmatch(text or "", "[^/]+") do
            local k, mode, body = string.match(part, "^([sm]):([ad]):(.*)")
            if k ~= nil then
                local kind = k == "m" and "mage" or "skeleton"
                local entry = { direct = mode == "d", want = {} }
                for _, form in ipairs(self:FormOrder(kind)) do
                    local n = string.match("," .. body .. ",", "," .. form .. "=(%d+),")
                    if n ~= nil then entry.want[form] = math.min(99, math.floor(tonumber(n) or 0)) end
                end
                out[kind] = entry
            end
        end
        return out
    end

    method string EncodeHope(table hopes)
        -- ParseHope의 반대 (변이 순서 고정 · 자동이고 희망 수도 없는 종류는 빼서 옛 저장과 같은 "")
        local parts = {}
        for _, kind in ipairs({ "skeleton", "mage" }) do
            local h = hopes[kind]
            if h ~= nil then
                local items = {}
                for _, form in ipairs(self:FormOrder(kind)) do
                    local n = (h.want or {})[form]
                    if n ~= nil then table.insert(items, form .. "=" .. tostring(math.max(0, math.floor(n)))) end
                end
                if h.direct or #items > 0 then table.insert(parts, (kind == "mage" and "m:" or "s:") .. (h.direct and "d:" or "a:") .. table.concat(items, ",")) end
            end
        end
        return table.concat(parts, "/")
    end

    method table HopeOf(Entity player, string kind)
        -- 그 플레이어의 희망 편성 (서버 = SkillBook.FormHope · 클라이언트 = 주인에게 동기화된 같은 문자열)
        ---@type SkillBook
        local book = isvalid(player) and player:GetComponent("script.SkillBook") or nil
        local hopes = self:ParseHope(book ~= nil and book.FormHope or "")
        return hopes[kind] or { direct = false, want = {} }
    end

    method table PlaceQuota(string kind, table quota, table hope, integer max)
        -- 배치 수 = 이번 계획에서 변이마다 세울 최대 수. 자동 = 노드 랭크 그대로 (현행) · 직접 = min(희망 수, 노드 랭크), 변이 순서대로 정원 max 안에서 자른다.
        -- 잘린 몫(cut)은 표시용으로만 돌려준다 — 저장된 희망 수는 바꾸지 않는다. 세기는 이 값이 아니라 노드 랭크(FormQuota)를 쓴다 (B-R01)
        local place = {}
        local cut = {}
        local clipped = false
        local direct = hope ~= nil and hope.direct == true
        local room = math.max(0, max)
        for _, form in ipairs(self:FormOrder(kind)) do
            local rank = quota[form] or 0
            if direct then
                local want = math.max(0, math.floor((hope.want or {})[form] or 0))   -- 직접 편성에서 빈 칸은 0 = 일반형으로 채운다
                local n = math.min(want, rank, room)
                place[form] = n
                room = room - n
                if n < want then
                    clipped = true
                    cut[form] = want - n
                end
            else
                place[form] = rank
            end
        end
        return { quota = place, direct = direct, clipped = clipped, cut = cut }
    end

    method table PlanNext(string kind, integer max, table quota, table hope, table list, integer reserved)
        -- 다음 소환 계획 (I03 단계 2): 편성 미리보기(PreviewFrom)·실제 일으키기(MakeRecord·Raise)·장기 편성(SteadyRoster)이 함께 부르는 하나의 순수 함수. 목록·기록·Serial은 바꾸지 않는다.
        -- 입력 = 정원 max · 노드 랭크 quota · 희망 편성 hope · 지금 목록 list(오래된 순, 뼈 거인 몸 포함) · 거인 예약 reserved
        -- 출력 = 다음 변이 form · 새 개체 전에 남길 수 keep · 무너질 기록 victims(가장 오래된 것부터 · 거인 몸 제외) · 배치 수 place
        -- 자동 = 현행 그대로: 무너질 개체도 센 채로 고른다 (PickForm 먼저 · 10-24 규칙, 옛 결과와 같다).
        -- 직접 = 무너질 가장 오래된 개체를 뺀 남은 편성에서 희망 수에 모자란 첫 변이 → 정원이 찬 뒤에도 희망 수로 모인다
        local slots = self:SlotCount(max, kind, list, reserved)
        local victims = self:TrimVictims(list, kind, slots.keep)
        local place = self:PlaceQuota(kind, quota, hope, max)
        local form = ""
        if place.direct then
            local remain = {}
            for _, r in ipairs(list) do
                local gone = false
                for _, v in ipairs(victims) do
                    if v == r then gone = true end
                end
                if not gone then table.insert(remain, r) end
            end
            form = self:PickForm(kind, place.quota, remain, nil)
        else
            form = self:PickForm(kind, quota, list, nil)
        end
        -- 48-4 blocked: 무너뜨릴 수 있는 기록을 다 빼도 새 개체가 들어갈 자리가 없다 (정원이 거인 몸·합쳐진 넷뿐) → 추가 소환 없음
        return { form = form, max = max, have = slots.have, keep = slots.keep, full = slots.full, reserved = slots.reserved, victims = victims,
            place = place.quota, direct = place.direct, clipped = place.clipped, cut = place.cut, blocked = max <= 0 or slots.have - #victims >= max }
    end

    method table PlanFor(Entity player, string kind, integer slvl, table list, integer reserved)
        -- 플레이어 기준 PlanNext: 정원 MaxFor(장비·뼈 군단·선택 보상 포함) · 노드 랭크 FormQuota · 희망 편성 HopeOf
        -- 48-1: 변이 자리가 없으면 기본형 BaseForm (효과 레벨 8부터 방패) — 미리보기 PreviewFrom도 같은 규칙
        local plan = self:PlanNext(kind, self:MaxFor(player, kind, slvl), self:FormQuota(player, kind), self:HopeOf(player, kind), list, reserved)
        if plan.form == "" then plan.form = self:BaseForm(player, kind) end
        return plan
    end

    method boolean SamePlan(table rec, table plan)
        -- 일으키기 확정 직전: 기록을 만들 때의 계획(변이 · 무너질 기록 순서·정체)과 지금 계획이 같은가 (B-DRAFT-01)
        if (rec.planForm or "") ~= plan.form then return false end
        local before = rec.planVictims or {}
        if #before ~= #plan.victims then return false end
        for i, v in ipairs(plan.victims) do
            if before[i] ~= v then return false end
        end
        return true
    end

    method void LogPlan(string tag, string kind, table plan)
        -- [VRF] 다음 소환 계획 (메이커 확인용 · 출시 서버에서는 끈다)
        if Environment:IsPublishedPlay() then return end
        log(string.format("[VRF] roster %s kind=%s form=%s direct=%s max=%d have=%d keep=%d victims=%d clipped=%s", tag, kind, plan.form, tostring(plan.direct), plan.max, plan.have, plan.keep, #plan.victims, tostring(plan.clipped)))
    end

    method string PickForm(string kind, table quota, table list, table exclude)
        -- 일으킬 때 고르는 변이: list(오래된 순 · exclude 제외)에서 자리가 남은 첫 변이, 없으면 "" (일반형).
        -- 무너뜨리기(TrimVictims) 전에 고르므로 정원이 찬 상태에서도 교체될 개체의 변이를 센다
        local used = {}
        for _, form in ipairs(self:FormOrder(kind)) do used[form] = 0 end
        for _, other in ipairs(list) do
            if other ~= exclude and other.kind == kind and used[other.form or ""] ~= nil then used[other.form] = used[other.form] + 1 end
        end
        for _, form in ipairs(self:FormOrder(kind)) do
            if used[form] < (quota[form] or 0) then return form end
        end
        return ""
    end

    method table SlotPlan(Entity player, string kind, integer slvl, table list, integer reserved)
        -- 일으킬 때 정원: max = MaxFor · 나머지는 SlotCount (편성 미리보기의 반복 계산 SteadyRoster도 같은 SlotCount)
        return self:SlotCount(self:MaxFor(player, kind, slvl), kind, list, reserved)
    end

    method table SlotCount(integer max, string kind, table list, integer reserved)
        -- have = 목록의 같은 종류(거인에 합쳐진 「~」 기록 포함) + 이름 없는 예약 reserved(옛 동기화 「|N」) · keep = 새 개체를 넣기 전 남길 수.
        --   46-0 R1: 예약 수 = reserved + 「~」 기록 수 (하나로) — 거인 몸은 목록에 남아 TrimVictims가 건너뛴다
        local res = reserved
        local have = reserved
        for _, r in ipairs(list) do
            if r.kind == kind then
                have = have + 1
                if r.merged then res = res + 1 end
            end
        end
        return { max = max, reserved = res, have = have, keep = math.max(0, max - 1 - res), full = have >= max }
    end

    method table TrimVictims(table list, string kind, integer keep)
        -- kind가 keep을 넘을 때 무너질 기록 (가장 오래된 것부터 · 뼈 거인 몸은 빼고). 목록은 바꾸지 않는다
        --   거인에 합쳐진 「~」 기록은 세지 않는다 (SlotCount가 예약으로 이미 keep에서 뺐다)
        local count = 0
        for _, rec in ipairs(list) do if rec.kind == kind and not rec.merged then count = count + 1 end end
        local victims = {}
        for _, rec in ipairs(list) do
            if count <= keep then break end
            if rec.kind == kind and not rec.giant and not rec.merged then
                table.insert(victims, rec)
                count = count - 1
            end
        end
        return victims
    end

    method void RemoveRec(table list, table rec)
        for i, r in ipairs(list) do
            if r == rec then
                table.remove(list, i)
                return
            end
        end
    end

    -- ───────── 편성 미리보기 (I03 · 읽기 전용) ─────────

    method table RosterPreview(Entity player, string kind)
        -- 스킬 창 안내용: 지금 일반형·변이 수, 정원, 다음 소환 변이와 교체될 기록, 정원·우선순위 때문에 서지 못하는 변이.
        -- 실제 일으키기와 같은 함수(MaxFor·FormQuota·PickForm·SlotPlan·TrimVictims)만 부르고 기록·Serial·목록은 만들거나 바꾸지 않는다
        -- (돌려주는 list는 조회한 목록 그대로라 읽기만 한다 · 목록이 없던 플레이어도 Owned에 등록하지 않는다)
        local roster = self:RosterOf(player)
        return self:PreviewFrom(player, kind, roster.list, roster.reserved)
    end

    method table PreviewFrom(Entity player, string kind, table list, integer reserved)
        local slvl = self:SkillLevel(player, kind == "mage" and "raise_mage" or "raise_skeleton")   -- 시전과 같은 유효 랭크 (SkillBook.Cast → Raise)
        local quota = self:FormQuota(player, kind)          -- 노드 랭크 (세기 · 자동 편성의 자리 수)
        local hope = self:HopeOf(player, kind)              -- 희망 편성 (자동/직접 · 저장된 희망 수 그대로 · I03 단계 2)
        local res = kind == "skeleton" and reserved or 0   -- 이름 없는 예약(옛 동기화 「|N」)은 해골 전사만 · 「~」 기록은 종류별로 SlotCount가 센다
        local plan = self:PlanNext(kind, self:MaxFor(player, kind, slvl), quota, hope, list, res)   -- 실제 일으키기(MakeRecord·Raise)와 같은 계획
        if plan.form == "" then plan.form = self:BaseForm(player, kind) end   -- 48-1: PlanFor와 같은 기본형 (진화 뒤 방패)
        local counts = {}
        counts[""] = 0
        for _, form in ipairs(self:FormOrder(kind)) do counts[form] = 0 end
        -- 표시용 (INT1725-OBS-02): units = 뼈 거인 몸을 뺀 일반형·변이 수 · bodies = 거인 몸 수. counts·have(진단·정원 계산)는 그대로 거인 몸을 센다
        local units = {}
        local bodies = 0
        for _, r in ipairs(list) do
            if r.kind == kind and not r.merged then   -- 합쳐진 넷은 「거인에 N」(reserved)으로만 센다
                counts[r.form or ""] = (counts[r.form or ""] or 0) + 1
                if r.giant then bodies = bodies + 1 else units[r.form or ""] = (units[r.form or ""] or 0) + 1 end
            end
        end
        -- 두 가지 장기 편성: steady = 거인이 없을 때(빈 목록부터 · 투자 판단 기준) · steadyNow = 지금 목록·뼈 거인(몸 고정 + 예약)이 유지되는 동안
        local steady = self:SteadyRoster(kind, plan.max, quota, hope, {}, 0)
        local giant = plan.reserved > 0
        for _, r in ipairs(list) do if r.kind == kind and r.giant then giant = true end end
        local steadyNow = steady
        if giant then steadyNow = self:SteadyRoster(kind, plan.max, quota, hope, list, res) end
        local idle = {}
        local idleNow = {}
        for _, form in ipairs(self:FormOrder(kind)) do
            -- 서지 못하는 변이: 자동 = 배운 변이 · 직접 = 희망 수를 1 이상 둔 변이 (희망 0은 플레이어가 고른 일반형이라 「0기」 경고가 아니다)
            local wanted = quota[form] > 0
            if hope.direct then wanted = wanted and ((hope.want or {})[form] or 0) > 0 end
            if wanted and (steady[form] or 0) == 0 then table.insert(idle, { form = form, need = self:ExtraSlotsFor(kind, plan.max, quota, hope, form) }) end
            if wanted and (steadyNow[form] or 0) == 0 then table.insert(idleNow, form) end
        end
        local preview = { kind = kind, level = slvl, max = plan.max, have = plan.have, reserved = plan.reserved, extraReserved = res, full = plan.full, keep = plan.keep, giant = giant,
            list = list, counts = counts, units = units, bodies = bodies, quota = quota, steady = steady, steadyNow = steadyNow, idle = idle, idleNow = idleNow, nextForm = "", replaces = {},
            hope = hope, direct = plan.direct, want = hope.want or {}, place = plan.place, clipped = plan.clipped, cut = plan.cut,
            blocked = plan.blocked, baseForm = self:BaseForm(player, kind) }
        if slvl > 0 and plan.max > 0 then
            preview.nextForm = plan.form
            preview.replaces = plan.victims
        end
        return preview
    end

    method table SteadyRoster(string kind, integer slots, table quota, table hope, table seed, integer reserved)
        -- seed 목록(오래된 순 · 뼈 거인 몸 포함)·거인 예약 reserved·희망 편성 hope에서 실제 일으키기와 같은 계획(PlanNext: PickForm · SlotCount.keep · TrimVictims)으로
        -- 죽음 없이 계속 일으킬 때 변이별로 서는 최대 수 (정원 slots). seed {} · reserved 0 = 거인이 없을 때의 장기 편성.
        -- 0인 변이 = 그 조건에서는 노드를 찍어도 한 기도 서지 못한다. seed는 바꾸지 않는다 (복사본으로 돌린다)
        local seen = {}
        seen[""] = 0
        for _, form in ipairs(self:FormOrder(kind)) do seen[form] = 0 end
        if slots <= 0 then return seen end
        local total = slots
        for _, form in ipairs(self:FormOrder(kind)) do total = total + (quota[form] or 0) end
        local warm = 3 * total + 2
        local list = {}
        for _, r in ipairs(seed) do
            if r.kind == kind then table.insert(list, { kind = kind, form = r.form or "", giant = r.giant, merged = r.merged }) end
        end
        for i = 1, warm * 2 do
            local plan = self:PlanNext(kind, slots, quota, hope, list, reserved)
            if not plan.blocked then   -- 48-4: 정원이 거인으로 막히면 실제 Raise도 거절한다
                for _, victim in ipairs(plan.victims) do self:RemoveRec(list, victim) end
                table.insert(list, { kind = kind, form = plan.form })
            end
            if i > warm then
                local now = {}
                -- 46-0 R1 (RB-OBS-03): 거인 몸(!)·합쳐진 넷(~)은 자리는 쓰되 서 있지 않다 — 「서 있는 수」에서 뺀다 (예전엔 몸이 쌍칼이면 쌍칼 1기로 셌다)
                for _, r in ipairs(list) do
                    if not r.giant and not r.merged then now[r.form] = (now[r.form] or 0) + 1 end
                end
                for f, n in pairs(now) do
                    if n > (seen[f] or 0) then seen[f] = n end
                end
            end
        end
        return seen
    end

    method integer ExtraSlotsFor(string kind, integer slots, table quota, table hope, string form)
        -- form이 서려면 정원이 몇 기 더 있어야 하나 (0 = 이미 선다 · 찾지 못하면 -1) — 같은 희망 편성 hope로 잰다
        local total = 1
        for _, f in ipairs(self:FormOrder(kind)) do total = total + (quota[f] or 0) end
        for extra = 0, total do
            if (self:SteadyRoster(kind, slots + extra, quota, hope, {}, 0)[form] or 0) > 0 then return extra end
        end
        return -1
    end

    method string EncodeRoster(table list, integer reserved)
        -- 클라이언트 편성 미리보기 입력 (ShadowCommander.UndeadRoster): 오래된 순 "s:shield,s:,m:aura!" + "|이름 없는 예약 수"
        --   표시 하나 (46-0): ! = 뼈 거인 몸 · ~ = 거인에 합쳐짐(변이 담음 · PlanList 끝) · ? = 아직 바칠 수 없음(엔티티 없음·쓰러짐·돌진 — RosterView)
        local parts = {}
        for _, rec in ipairs(list) do
            if rec.kind == "skeleton" or rec.kind == "mage" then
                local mark = ""
                if rec.giant then mark = "!" elseif rec.merged then mark = "~" elseif rec.notReady then mark = "?" end
                table.insert(parts, (rec.kind == "mage" and "m:" or "s:") .. (rec.form or "") .. mark)
            end
        end
        return table.concat(parts, ",") .. "|" .. tostring(reserved)
    end

    method table DecodeRoster(string text)
        local list = {}
        local body, reserved = string.match(text or "", "^(.*)|(%d+)$")
        for item in string.gmatch(body or "", "[^,]+") do
            local k, form, mark = string.match(item, "^([sm]):(%a*)([!~?]?)$")
            if k ~= nil then table.insert(list, { kind = k == "m" and "mage" or "skeleton", form = form, giant = mark == "!" or nil, merged = mark == "~" or nil, notReady = mark == "?" or nil }) end
        end
        return { list = list, reserved = math.floor(tonumber(reserved) or 0) }
    end

    method table RosterOf(Entity player)
        -- 서버 = 실제 목록·거인 예약 · 클라이언트 = 동기화된 UndeadRoster (같은 모양의 가벼운 기록).
        -- 조회만 한다: 서버에서 아직 목록이 없는 플레이어는 지역 빈 표 (ListOf처럼 Owned에 등록하지 않는다)
        if self:IsServer() then return { list = self:PlanList(player), reserved = 0 } end   -- 46-0: 합쳐진 넷은 「~」 기록으로 (예약 수는 SlotCount가 센다)
        ---@type ShadowCommander
        local cmd = player:GetComponent("script.ShadowCommander")
        return self:DecodeRoster(cmd ~= nil and cmd.UndeadRoster or "")
    end

    method string FormName(string kind, string form)
        -- 「방패 해골」·「광기 마법사」 = 그 변이 노드 이름 · 일반형은 「해골 전사」·「해골 마법사」
        if kind ~= "mage" and form == "shield" then return "방패 해골" end   -- 48-1 진화한 기본형 (노드 없음)
        if form ~= "" then
            local def = _SkillData:Get((kind == "mage" and "mage_" or "skel_") .. form)
            if def ~= nil then return def.name end
        end
        return kind == "mage" and "해골 마법사" or "해골 전사"
    end

    method table NodeForm(string id)
        -- 변이 노드 id → { kind, form } (변이 노드가 아니면 form = "")
        for _, kind in ipairs({ "skeleton", "mage" }) do
            local prefix = kind == "mage" and "mage_" or "skel_"
            for _, form in ipairs(self:FormOrder(kind)) do
                if id == prefix .. form then return { kind = kind, form = form } end
            end
        end
        return { kind = "", form = "" }
    end

    @ExecSpace("ServerOnly")
    method boolean SpawnUnit(Entity player, table rec, Vector2 pos, any onReady, any onFail)
        local map = player.CurrentMap
        if not isvalid(map) then return false end
        local unit = _SpawnService:SpawnByModelId(_GameConst.ModelShadowUnit, "Undead_" .. rec.kind, Vector3(pos.x, pos.y, 0), map)
        if not isvalid(unit) then return false end
        rec.entity = unit
        local offset = self:FormationOffset(#self:ListOf(player))
        _Util:AfterSpawn(unit, "script.ShadowUnit", function(comp)
            ---@type ShadowUnit
            local u = comp
            if not _Util:IsAlive(player) or player.CurrentMap ~= map or rec.entity ~= unit then
                if isvalid(unit) then unit:Destroy() end
                if rec.entity == unit then rec.entity = nil end
                if onFail ~= nil then onFail() end
                return
            end
            -- 이번 주 심연 규칙 「뼈의 풍년」: 해골 전사·마법사 공격 (심연 방에서 일어날 때만, 기록은 그대로)
            local atk = rec.atk
            if rec.kind == "skeleton" or rec.kind == "mage" then atk = math.floor(atk * _WeeklyRules:MapMul(map, "skel")) end
            u:Setup(player, rec.id, atk, rec.hp, rec.stand, rec.move, offset)
            u.Hp = math.min(u.MaxHp, rec.currentHp or rec.hp)
            u.Kind = rec.kind
            local index = 0
            for _, other in ipairs(self:ListOf(player)) do
                if other == rec then break end
                if other.kind == rec.kind then index = index + 1 end
            end
            u.FormationIndex = index
            u.AttackRUID = rec.attack or ""
            unit.TransformComponent.Scale = Vector3(rec.scale or 1, rec.scale or 1, 1)
            u.AttackCooldown = rec.cooldown
            u.AttackRange = rec.range
            u.Element = rec.element
            u.ElementRatio = rec.ratio
            u.Resists = rec.resists or {}
            u.BonusResist = rec.auraResist or 0
            u.Variant = rec.variant or ""
            u.RadiusMult = rec.radiusMul or 1   -- 해골 변이 (ApplySkeletonForm)
            u.BasicMult = rec.basicMul or 1
            u.GuardPct = rec.guard or 0
            u.Taunt = rec.taunt == true
            u.MageSchool = rec.school or ""    -- 48-2 해골 마법사 속성 · 랭크 (ShadowUnit이 속성 투사체·특성 구간을 고른다 · 옛 기록 ""는 Element로)
            u.MageRank = rec.mageRank or 0
            u.BoltCount = rec.bolts or 1       -- 48-2 이후 변이 칸은 비어 기본값 (옛 기록 호환)
            u.BoltMult = rec.boltMul or 1
            u.BoltPierce = rec.pierce or 0
            u.HexPct = rec.hex or 0
            u.BlastMult = rec.blast or 0
            u.ShadowTint = rec.tint
            unit.SpriteRendererComponent.Color = rec.tint
            u:SetBaseSpeed(rec.speed)
            if onReady ~= nil then onReady() end
        end, function()
            if isvalid(unit) then unit:Destroy() end
            if rec.entity == unit then rec.entity = nil end
            if onFail ~= nil then onFail() end
        end)
        if rec.expireAt > 0 then
            local id = rec.id
            local delay = math.max(0.1, rec.expireAt - _UtilLogic.ElapsedSeconds)
            _TimerService:SetTimerOnce(function() self:Expire(player, id) end, delay)
        end
        return true
    end

    method Vector2 FormationOffset(integer index)
        -- 주인 둘레 고리 (그림자 대형 바깥쪽)
        local angle = index * 0.9
        local r = 1.6 + (index % 3) * 0.35
        return Vector2(math.cos(angle) * r, math.sin(angle) * r * 0.7)
    end

    -- ───────── 소멸 ─────────

    @ExecSpace("ServerOnly")
    method void DestroyEntity(table rec)
        if isvalid(rec.entity) then rec.entity:Destroy() end
        rec.entity = nil
    end

    @ExecSpace("ServerOnly")
    method void Remove(Entity player, string id)
        if not isvalid(player) then return end
        local list = self:ListOf(player)
        for i, rec in ipairs(list) do
            if rec.id == id then
                self:DestroyEntity(rec)
                table.remove(list, i)
                break
            end
        end
        self:RefreshSummary(player)
    end

    @ExecSpace("ServerOnly")
    method void RemoveLost(Entity player, string id, string reason)
        if not isvalid(player) then return end
        local removed = nil
        for _, rec in ipairs(self:ListOf(player)) do if rec.id == id then removed = rec break end end
        self:Remove(player, id)
        if removed ~= nil then self:NoteLost(player, removed, reason) end
    end

    @ExecSpace("ServerOnly")
    method void OnUnitDied(Entity player, string id)
        -- ShadowUnit(Kind ~= shadow)이 쓰러지면 부른다. 뼈 거인이 쓰러지면 합쳐졌던 넷도 함께 무너진다
        if isvalid(player) then
            local uid = player.PlayerComponent.UserId
            local giants = self.Giants[uid]
            if giants ~= nil then
                for i, g in ipairs(giants) do
                    if g.host.id == id then
                        table.remove(giants, i)
                        for _, rec in ipairs(g.mates) do self:NoteLost(player, rec, "died") end
                        log("[VRF] rite giant fell mates=" .. tostring(#g.mates) .. " giants=" .. tostring(#giants))
                        break
                    end
                end
                if #giants == 0 then self.Giants[uid] = nil end
            end
            self:TwinHuntClear(player, id, "")
        end
        self:RemoveLost(player, id, "died")
    end

    @ExecSpace("ServerOnly")
    method void Expire(Entity player, string id)
        -- 되살림 시간이 끝남 (맵 이동으로 다시 만든 개체의 옛 타이머는 기록이 없어 그냥 지나간다)
        if not isvalid(player) then return end
        self:RemoveLost(player, id, "expired")
    end

    @ExecSpace("ServerOnly")
    method void DismissRecords(Entity player, boolean reportLoss)
        -- 사망·명시적 해제 시 모두 정리하고, 이전 맵의 따라오기 타이머도 무효화한다.
        local uid = player.PlayerComponent.UserId
        self.TravelEpochs[uid] = (self.TravelEpochs[uid] or 0) + 1
        local giants = self.Giants[uid] or {}
        self.Giants[uid] = nil   -- 거인과 합쳐진 넷도 함께 사라진다 (둘 다)
        self.TwinHunts[uid] = nil
        local list = self:ListOf(player)
        for _, rec in ipairs(list) do self:DestroyEntity(rec) end
        self.Owned[player.PlayerComponent.UserId] = {}
        self:RefreshSummary(player)
        if reportLoss then
            for _, rec in ipairs(list) do self:NoteLost(player, rec, "dismissed") end
            for _, g in ipairs(giants) do for _, rec in ipairs(g.mates) do self:NoteLost(player, rec, "dismissed") end end
        end
    end

    @ExecSpace("ServerOnly")
    method void DismissAll(Entity player)
        self:DismissRecords(player, true)
    end

    -- ───────── 맵 이동 ─────────

    @ExecSpace("ServerOnly")
    method string RemovedReason(Entity player, table rec, number now)
        if rec.expireAt > 0 and rec.expireAt <= now then return "expired" end
        if rec.ownerEntityId ~= nil and rec.ownerEntityId ~= player.Id then return "owner_changed" end
        if (rec.currentHp or rec.hp) <= 0 then return "died" end
        if isvalid(rec.entity) then
            local u = rec.entity:GetComponent("script.ShadowUnit")
            if u ~= nil and (u.Dead or u.Hp <= 0) then return "died" end
        end
        return "invalid"   -- 죽음이 확인되지 않은 무효 기록을 전투 사망으로 추정하지 않는다.
    end

    @ExecSpace("ServerOnly")
    method table LiveRecords(Entity player)
        -- 현재 체력·남은 시간을 보존하고 죽거나 만료된 유닛은 이동 대상에서 제외한다.
        -- 뼈 거인은 이동 전에 먼저 갈라 둔다 (다섯 기록이 남은 생명 비율로 목록에 돌아와 함께 따라간다)
        self:EndGiant(player, 0, false)
        local live = {}
        local lost = {}
        local now = _UtilLogic.ElapsedSeconds
        for _, rec in ipairs(self:ListOf(player)) do
            local alive = (rec.ownerEntityId == nil or rec.ownerEntityId == player.Id) and (rec.expireAt == 0 or rec.expireAt > now)
            if isvalid(rec.entity) then
                local u = rec.entity:GetComponent("script.ShadowUnit")
                if u == nil or u.Dead or u.Hp <= 0 then alive = false
                else rec.currentHp = u.Hp end
            end
            if alive and (rec.currentHp or rec.hp) > 0 then table.insert(live, rec)
            else
                table.insert(lost, { rec = rec, reason = self:RemovedReason(player, rec, now) })
                self:DestroyEntity(rec)
            end
        end
        self.Owned[player.PlayerComponent.UserId] = live
        for _, entry in ipairs(lost) do self:NoteLost(player, entry.rec, entry.reason) end
        return live
    end

    @ExecSpace("ServerOnly")
    method void Follow(Entity player)
        -- 일반 포털·귀환·웨이포인트: 이동 번호가 최신일 때만 같은 체력으로 다시 만든다.
        local uid = player.PlayerComponent.UserId
        local epoch = (self.TravelEpochs[uid] or 0) + 1
        self.TravelEpochs[uid] = epoch
        local list = self:LiveRecords(player)
        for _, rec in ipairs(list) do self:DestroyEntity(rec) end
        self:RefreshSummary(player)
        if #list == 0 then return end
        _TimerService:SetTimerOnce(function()
            if not _Util:IsAlive(player) or self.TravelEpochs[uid] ~= epoch then return end
            local p = _Util:Pos2(player)
            local count = 0
            for _, rec in ipairs(self:LiveRecords(player)) do
                if not isvalid(rec.entity) and self:SpawnUnit(player, rec, p, nil, nil) then count = count + 1 end
            end
            self:RefreshSummary(player)
            log("[VRF] undead followed map=" .. player.CurrentMap.Name .. " count=" .. tostring(count))
        end, 1.2)
    end

    @ExecSpace("ServerOnly")
    method table TravelSnapshot(Entity player, string destination)
        -- 엔티티·Color 객체는 제외한다. UTC 시각을 써서 방마다 다른 경과 시간에도 수명을 유지한다.
        local now = _UtilLogic.ElapsedSeconds
        local utc = DateTime.UtcNow.Elapsed
        local units = {}
        local fields = { "kind", "atk", "hp", "currentHp", "cooldown", "range", "speed", "stand", "move", "attack", "scale", "element", "ratio", "resists", "variant", "auraResist", "form", "radiusMul", "basicMul", "guard", "taunt", "bolts", "boltMul", "pierce", "hex", "blast", "school", "mageRank" }   -- form~taunt: 해골 변이 편성 · bolts~blast: 옛 마법사 변이 · school·mageRank: 48-2 마법사 속성
        for _, rec in ipairs(self:LiveRecords(player)) do
            local data = {}
            for _, key in ipairs(fields) do data[key] = rec[key] end
            data.tint = { rec.tint.r, rec.tint.g, rec.tint.b, rec.tint.a }
            data.expires = rec.expireAt > 0 and (utc + math.max(0, rec.expireAt - now) * 1000) or 0
            table.insert(units, data)
        end
        local snapshot = { destination = destination, created = utc, unitCount = #units }
        if #units > 0 then snapshot.units = units end
        return snapshot
    end

    @ExecSpace("ServerOnly")
    method boolean StashForRoomTravel(Entity player, string destination)
        -- 심도 입장·다음 층·귀환 직전에만 전달한다. 실패하면 이동을 중단해 소환수를 잃지 않는다.
        local code, memory = _RoomService:GetSharedMemory(self.TravelMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil then
            _Util:Notify("소환수 이동 준비에 실패했습니다. 다시 시도해주세요", player.PlayerComponent.UserId)
            return false
        end
        local snapshot = self:TravelSnapshot(player, destination)
        local result = memory:SetVariableAndWait(player.PlayerComponent.UserId, _HttpService:JSONEncode(snapshot))
        if result.Code ~= SharedMemoryResultCode.OK then
            _Util:Notify("소환수 이동 준비에 실패했습니다. 다시 시도해주세요", player.PlayerComponent.UserId)
            return false
        end
        log("[VRF] undead room stash count=" .. tostring(snapshot.unitCount) .. " to=" .. destination)
        return true
    end

    @ExecSpace("ServerOnly")
    method void CancelRoomTravel(Entity player)
        -- 방 이동이 취소되면 전달 예약만 지운다. 소환수는 떠나지 않았으므로 그대로 남는다.
        local code, memory = _RoomService:GetSharedMemory(self.TravelMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil or not isvalid(player) then return end
        memory:DeleteVariableAndWait(player.PlayerComponent.UserId)
    end

    @ExecSpace("ServerOnly")
    method void RetargetRoomTravel(Entity player, string destination)
        local code, memory = _RoomService:GetSharedMemory(self.TravelMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil then return end
        local uid = player.PlayerComponent.UserId
        local result = memory:GetVariableAndWait(uid)
        if result.Code ~= SharedMemoryResultCode.OK or result.Info == nil then return end
        local ok, data = pcall(function() return _HttpService:JSONDecode(result.Info.Value) end)
        if not ok or type(data) ~= "table" then return end
        data.destination = destination
        memory:SetVariableAndWait(uid, _HttpService:JSONEncode(data))
    end

    @ExecSpace("ServerOnly")
    method void RestoreRoomTravel(Entity player)
        -- PlayerSave.Load 완료 뒤 목적지 방에서 한 번 소비한다. 2분 지난 전달은 폐기하며 영구 저장은 하지 않는다.
        local code, memory = _RoomService:GetSharedMemory(self.TravelMemoryName)
        if code ~= SharedMemoryResultCode.OK or memory == nil then return end
        local uid = player.PlayerComponent.UserId
        local result = memory:GetVariableAndWait(uid)
        if result.Code == SharedMemoryResultCode.NotFound then return end
        if result.Code ~= SharedMemoryResultCode.OK or result.Info == nil then return end
        local ok, snapshot = pcall(function() return _HttpService:JSONDecode(result.Info.Value) end)
        local utc = DateTime.UtcNow.Elapsed
        if not ok or type(snapshot) ~= "table" or type(snapshot.created) ~= "number" or utc - snapshot.created > 120000 then
            memory:DeleteVariableAndWait(uid)
            return
        end
        if snapshot.destination ~= _RoomService.RoomKey then return end
        if memory:DeleteVariableAndWait(uid) ~= SharedMemoryResultCode.OK then return end
        self:DismissRecords(player, false)   -- 같은 소환 기록을 방으로 옮기는 정리: 손실 아님
        if not _Util:IsAlive(player) then return end
        local list = self:ListOf(player)
        for _, data in ipairs(snapshot.units or {}) do
            if (data.expires == 0 or data.expires > utc) and (data.currentHp or 0) > 0 then
                self.Serial = self.Serial + 1
                data.id = "ud" .. tostring(self.Serial)
                data.entity = nil
                data.ownerEntityId = player.Id
                data.expireAt = data.expires > 0 and (_UtilLogic.ElapsedSeconds + (data.expires - utc) / 1000) or 0
                local tint = data.tint
                data.tint = Color(tint[1], tint[2], tint[3], tint[4])
                self:ApplyFormLook(data)   -- 예전 임시 그림으로 저장된 변이 해골도 새 그림으로
                table.insert(list, data)
            end
        end
        log("[VRF] undead room restored count=" .. tostring(#list) .. " room=" .. _RoomService.RoomKey)
        self:Follow(player)
    end

    @ExecSpace("ServerOnly")
    method integer RallyAll(Entity player, number seconds)
        -- 언데드 집결. 따라온 수
        local n = 0
        for _, rec in ipairs(self:ListOf(player)) do
            if isvalid(rec.entity) then
                ---@type ShadowUnit
                local u = rec.entity:GetComponent("script.ShadowUnit")
                if u ~= nil then
                    u:Rally(seconds)
                    n = n + 1
                end
            end
        end
        return n
    end

    -- ───────── 쌍칼 후열 사냥 (48 §1-4 · ShadowUnit.TwinHunt*가 부른다 · 상태는 여기 TwinHunts에) ─────────

    @ExecSpace("ServerOnly")
    method boolean IsTwinHunter(Entity player, string unitId)
        -- 그 유닛이 쌍칼 해골인가 (거인 몸 제외 · 일으킨 순간의 기록 form 기준)
        if not isvalid(player) or unitId == "" then return false end
        for _, rec in ipairs(self:ListOf(player)) do
            if rec.id == unitId then return rec.kind == "skeleton" and rec.form == "twin" and not rec.giant end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method table TwinHuntState(Entity player, string unitId)
        -- 쌍칼 하나의 사냥 상태 { target, targetId, reachAt, seenAt, ban(대상 id → 다시 고를 수 있는 시각) }
        local uid = player.PlayerComponent.UserId
        local all = self.TwinHunts[uid]
        if all == nil then
            all = {}
            self.TwinHunts[uid] = all
        end
        local st = all[unitId]
        if st == nil then
            st = { target = nil, targetId = "", reachAt = 0, seenAt = 0, ban = {} }
            all[unitId] = st
        end
        return st
    end

    @ExecSpace("ServerOnly")
    method integer TwinHuntLoad(Entity player, string targetId, string exceptUnitId)
        -- 그 대상을 지금 사냥 중인 다른 쌍칼 수 (목록에 살아 있는 쌍칼 기록만 센다 — 쓰러지거나 바쳐진 쌍칼의 옛 상태는 세지 않는다)
        local all = self.TwinHunts[player.PlayerComponent.UserId]
        if all == nil then return 0 end
        local n = 0
        for _, rec in ipairs(self:ListOf(player)) do
            local st = all[rec.id]
            if rec.id ~= exceptUnitId and st ~= nil and st.targetId == targetId and rec.form == "twin" and not rec.giant and isvalid(rec.entity) then n = n + 1 end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method Entity TwinHuntTargetOf(Entity player, string unitId)
        -- 그 쌍칼이 지금 사냥 중인 대상 (없으면 nil)
        local all = self.TwinHunts[player.PlayerComponent.UserId]
        if all == nil or all[unitId] == nil or all[unitId].targetId == "" then return nil end
        return all[unitId].target
    end

    @ExecSpace("ServerOnly")
    method void TwinHuntClear(Entity player, string unitId, string reason)
        -- reason "" = 유닛이 사라짐(상태 통째로 지움) · 그 밖(manual 등) = 지금 대상만 놓는다 (돌아온 대상 금지 시간 ban은 그대로)
        if not isvalid(player) then return end
        local all = self.TwinHunts[player.PlayerComponent.UserId]
        if all == nil or all[unitId] == nil then return end
        if reason == "" then
            all[unitId] = nil
            return
        end
        local st = all[unitId]
        if st.targetId == "" then return end
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] twin hunt return reason=%s id=%s unit=%s", reason, st.targetId, unitId)) end
        st.target = nil
        st.targetId = ""
    end

    method table TwinHuntDecide(table st, table cur, table cands, number now)
        -- 쌍칼 후열 사냥 판단 (순수 · 서버·오프라인 검사 공용 · st를 고친다)
        --   st = TwinHuntState · cur = 지금 대상 { alive, inCombat(주인 교전 범위 7 안·시야), reach(공격 거리 안·시야) } (대상 없으면 nil)
        --   cands = 후보 { id, entity, dist, load(그 대상에 붙은 다른 쌍칼 수) } — 부르는 쪽이 원거리 · 보스 아님 · 주인 경계 5.5 안 · 시야로 거른다
        --   돌려줌 { keep(지금 대상 계속), pick(새 대상 후보 또는 nil), drop("" · dead · range · stuck) }
        local out = { keep = false, pick = nil, drop = "" }
        for id, untilAt in pairs(st.ban) do
            if untilAt <= now then st.ban[id] = nil end
        end
        if st.targetId ~= "" then
            if now - st.seenAt > 1 then st.reachAt = now end   -- 집결·수동 조준으로 판단이 끊겼다 → 막힘 시계를 새로 잰다
            st.seenAt = now
            if cur == nil or not cur.alive then out.drop = "dead"
            elseif not cur.inCombat then out.drop = "range"
            elseif cur.reach then st.reachAt = now
            elseif now - st.reachAt >= _GameData.twinHuntStuck then out.drop = "stuck" end
            if out.drop == "" then
                out.keep = true
                return out
            end
            if out.drop ~= "dead" then st.ban[st.targetId] = now + _GameData.twinHuntBan end   -- 멀어졌거나 막힌 대상은 잠시 후보에서 뺀다
            st.target = nil
            st.targetId = ""
        end
        local best = nil
        for _, c in ipairs(cands) do
            if (st.ban[c.id] or 0) <= now and c.load < _GameData.twinHuntCap and (best == nil or c.dist < best.dist) then best = c end
        end
        if best ~= nil then
            st.target = best.entity
            st.targetId = best.id
            st.reachAt = now
            st.seenAt = now
            out.pick = best
        end
        return out
    end

    -- ───────── 표시 ─────────

    method integer SkillLevel(Entity player, string id)
        ---@type SkillBook
        local book = player:GetComponent("script.SkillBook")
        if book == nil then return 0 end
        return book:GetPowerLevel(id)
    end

    @ExecSpace("ServerOnly")
    method void RefreshSummary(Entity player)
        -- 상태줄 "해골 3/4 · 마법사 1/1 · 되살림 2" → ShadowCommander.UndeadSummary (동기화)
        ---@type ShadowCommander
        local cmd = player:GetComponent("script.ShadowCommander")
        if cmd == nil then return end
        local n = { skeleton = 0, mage = 0, revive = 0 }
        for _, rec in ipairs(self:ListOf(player)) do
            n[rec.kind] = (n[rec.kind] or 0) + 1
            if isvalid(rec.entity) then
                local unit = rec.entity:GetComponent("script.ShadowUnit")
                if unit ~= nil then unit.FormationIndex = n[rec.kind] - 1 end
            end
        end
        -- 48-4: 거인에 합쳐진 넷은 목록 밖이지만 정원을 쓴다 → 상태줄 「해골 n/max」에 종류별로 더한다 (거인 몸은 목록 안이라 이미 셌다 · 몸 포함 정원 표시)
        local merged = { skeleton = 0, mage = 0 }
        local bodies = { skeleton = 0, mage = 0 }
        local names = {}
        for _, g in ipairs(self.Giants[player.PlayerComponent.UserId] or {}) do
            for _, r in ipairs(g.mates) do if merged[r.kind] ~= nil then merged[r.kind] = merged[r.kind] + 1 end end
            if g.host ~= nil and bodies[g.host.kind] ~= nil then bodies[g.host.kind] = bodies[g.host.kind] + 1 end
            table.insert(names, _GameData:GetGiant(g.kind or "basic").name)
        end
        local parts = {}
        local sk = self:SkillLevel(player, "raise_skeleton")
        local mg = self:SkillLevel(player, "raise_mage")
        if sk > 0 then table.insert(parts, "해골 " .. tostring(n.skeleton + merged.skeleton) .. "/" .. tostring(self:MaxFor(player, "skeleton", sk))) end
        if mg > 0 then table.insert(parts, "마법사 " .. tostring(n.mage + merged.mage) .. "/" .. tostring(self:MaxFor(player, "mage", mg))) end
        if n.revive > 0 then table.insert(parts, "되살림 " .. tostring(n.revive)) end   -- 되살림 스킬은 10-20에 빠졌다 (옛 기록 호환 · 맛보기 그림자는 10-31 제거)
        if #names > 0 then table.insert(parts, table.concat(names, " · ")) end   -- 46-6 「대검 거인」 · 48 §9 둘이면 「방패 거인 · 마법사 거인」
        cmd.UndeadSummary = table.concat(parts, " · ")
        -- 46-1: 소환수 배지·의식 예측 수 = 바칠 수 있는 수 (거인 몸 제외 · 48-4 몸 둘이면 둘 다)
        cmd.MinionCounts = tostring(math.max(0, n.skeleton - bodies.skeleton)) .. "," .. tostring(math.max(0, n.mage - bodies.mage)) .. "," .. tostring(n.revive)
        local giantKind = self:GiantKindsText(player)   -- 48-4: 「shield,mage」 쉼표 목록 (클라이언트 GiantCount = 칸 수)
        if cmd.GiantKind ~= giantKind then cmd.GiantKind = giantKind end
        cmd.UndeadRoster = self:EncodeRoster(self:RosterView(player), 0)   -- 스킬 창 편성 미리보기 (I03) · 46-0: 합쳐진 넷 「~」 · 아직 못 바침 「?」
    end

end
