-- 추출 대상 몬스터의 HP·사망·리스폰. 처치되면 ShadowSystem에 추출 판정을 요청한다.
-- 사망 애니메이션은 StateComponent(DEAD) → StateAnimationComponent의 die 키로 재생된다.
@Component
script ShadowMonster extends Component

    property number MaxHp = 60
    property integer Grade = 1              -- 1 일반, 2 정예, 3 보스
    property integer Level = 1              -- 경험치·드롭 레벨
    property string SourceId = "mob"        -- 그림자의 원본 몬스터 종류
    property number RespawnDelay = 6
    property number HideDelay = 0.8
    property boolean DebugLog = false

    @Sync
    property number Hp = 0
    @Sync
    property boolean IsDead = false

    property Entity LastAttacker = nil
    property Vector2 SpawnPosition = Vector2(0, 0)

    -- 상태 효과 (서버). 시각은 _UtilLogic.ElapsedSeconds 기준
    property number AmpUntil = 0
    property number AmpPct = 0
    property number WeakenUntil = 0
    property number WeakenPct = 0
    property number PoisonUntil = 0
    property number PoisonDps = 0
    property Entity PoisonSource = nil
    property integer PoisonTimer = 0
    @Sync
    property string CurseTag = ""        -- 대상 정보 UI 표시용

    -- 정예 수식어 (D2 정예 접사 단순화): 강인한(생명) / 흉포한(피해) / 신속한(속도)
    @Sync
    property string Affix = ""
    property number BaseMaxHp = 0
    property number BaseSpeed = 0
    property number AffixDamageMult = 1

    @ExecSpace("ServerOnly")
    method void RollAffix()
        -- 정예만, 등장할 때마다 새로 굴린다
        if self.BaseMaxHp <= 0 then self.BaseMaxHp = self.MaxHp end
        local movement = self.Entity.MovementComponent
        if self.BaseSpeed <= 0 and isvalid(movement) then self.BaseSpeed = movement.InputSpeed end
        self.MaxHp = self.BaseMaxHp
        self.AffixDamageMult = 1
        if isvalid(movement) and self.BaseSpeed > 0 then movement.InputSpeed = self.BaseSpeed end
        self.Affix = ""
        if self.Grade ~= 2 then return end
        local r = _UtilLogic:RandomIntegerRange(1, 3)
        if r == 1 then
            self.Affix = "강인한"
            self.MaxHp = self.BaseMaxHp * 1.7
        elseif r == 2 then
            self.Affix = "흉포한"
            self.AffixDamageMult = 1.5
        else
            self.Affix = "신속한"
            if isvalid(movement) then movement.InputSpeed = self.BaseSpeed * 1.5 end
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyCurse(string kind, number pct, number duration)
        -- 저주: amp(받는 피해 증가) / weaken(주는 피해 감소)
        local now = _UtilLogic.ElapsedSeconds
        if kind == "amp" then
            self.AmpPct = math.max(self.AmpPct, pct)
            self.AmpUntil = now + duration
            self.CurseTag = "약화의 낙인"
        elseif kind == "weaken" then
            self.WeakenPct = math.max(self.WeakenPct, pct)
            self.WeakenUntil = now + duration
            self.CurseTag = "쇠약"
        end
    end

    method number GetDamageTakenMultiplier()
        if _UtilLogic.ElapsedSeconds < self.AmpUntil then return 1 + self.AmpPct / 100 end
        return 1
    end

    method number GetDamageDealtMultiplier()
        local m = self.AffixDamageMult
        if _UtilLogic.ElapsedSeconds < self.WeakenUntil then m = m * math.max(0.1, 1 - self.WeakenPct / 100) end
        return m
    end

    @ExecSpace("ServerOnly")
    method void ApplyPoison(number dps, number duration, Entity source)
        -- 독: 0.5초마다 피해. 더 센 독이 들어오면 덮어쓴다
        self.PoisonDps = math.max(self.PoisonDps, dps)
        self.PoisonUntil = _UtilLogic.ElapsedSeconds + duration
        self.PoisonSource = source
        if self.PoisonTimer ~= 0 then return end
        self.PoisonTimer = _TimerService:SetTimerRepeat(function() self:PoisonTick() end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method void PoisonTick()
        if self.IsDead or _UtilLogic.ElapsedSeconds > self.PoisonUntil then
            _TimerService:ClearTimer(self.PoisonTimer)
            self.PoisonTimer = 0
            self.PoisonDps = 0
            return
        end
        self:TakeDamage(self.PoisonDps * 0.5, self.PoisonSource)
    end

    @ExecSpace("ServerOnly")
    method void TakeDamage(number amount, Entity attacker)
        -- 히트 판정을 거치지 않는 피해(독 등). 처치 처리는 HandleHitEvent와 같다
        if self.IsDead then return end
        if isvalid(attacker) then self.LastAttacker = attacker end
        self.Hp = self.Hp - amount * self:GetDamageTakenMultiplier()
        if self.Hp <= 0 then self:Die() end
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 리스폰 위치를 기억하고 HP를 채운다
        self:RollAffix()
        self.Hp = self.MaxHp
        local pos = self.Entity.TransformComponent.WorldPosition
        self.SpawnPosition = Vector2(pos.x, pos.y)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- 마지막 공격자를 기록하고 HP가 0이 되는 순간 한 번만 사망 처리
        if self.IsDead then return end
        if isvalid(event.AttackerEntity) then
            self.LastAttacker = event.AttackerEntity
            -- 추격형은 자기를 때린 대상(플레이어 또는 그림자)을 쫓는다
            local chase = self.Entity.AIChaseComponent
            if isvalid(chase) then chase:SetTarget(event.AttackerEntity) end
        end
        self.Hp = self.Hp - event.TotalDamage
        if self.Hp <= 0 then
            self:Die()
        end
    end

    @ExecSpace("ServerOnly")
    method void Die()
        -- 사망 연출 → 추출 판정 → 숨김 → 리스폰 예약
        self.IsDead = true
        if self.DebugLog then
            local me = self.Entity.TransformComponent.WorldPosition
            local who = "-"
            local dist = -1
            if isvalid(self.LastAttacker) then
                local a = self.LastAttacker.TransformComponent.WorldPosition
                who = self.LastAttacker.Name
                dist = (Vector2(a.x, a.y) - Vector2(me.x, me.y)):Magnitude()
            end
            log(string.format("[ShadowMonster] 사망 %s at %.2f,%.2f by %s dist %.2f", self.Entity.Name, me.x, me.y, who, dist))
        end
        local sc = self.Entity.StateComponent
        if isvalid(sc) then sc:ChangeState("DEAD") end
        _ShadowSystem:OnMonsterKilled(self.Entity, self.LastAttacker, self.SourceId, self.Grade)
        _TimerService:SetTimerOnce(function() self:Hide() end, self.HideDelay)
        if self.RespawnDelay < 0 then
            -- 소환된 졸개 등 리스폰 없는 몬스터는 치운다
            _TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self.Entity:Destroy() end end, self.HideDelay + 0.2)
            return
        end
        _TimerService:SetTimerOnce(function() self:Respawn() end, self.RespawnDelay)
    end

    @ExecSpace("ServerOnly")
    method void Hide()
        -- 시체를 치운다
        if not isvalid(self.Entity) then return end
        self.Entity:SetVisible(false)
        self.Entity:SetEnable(false)
    end

    @ExecSpace("ServerOnly")
    method void Respawn()
        -- 처음 위치에서 HP를 채워 다시 등장
        if not isvalid(self.Entity) then return end
        self.LastAttacker = nil
        self:RollAffix()
        self.Hp = self.MaxHp
        self.IsDead = false
        self.AmpUntil = 0
        self.WeakenUntil = 0
        self.PoisonUntil = 0
        self.CurseTag = ""
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then movement:SetWorldPosition(self.SpawnPosition) end
        self.Entity:SetEnable(true)
        self.Entity:SetVisible(true)
        local sc = self.Entity.StateComponent
        if isvalid(sc) then sc:ChangeState("IDLE") end
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.IsChaseNearPlayer = false end  -- 다시 선공하지 않는 상태로
    end

end
