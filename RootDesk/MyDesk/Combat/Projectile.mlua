-- 날아가는 투사체 (서버가 움직이고 판정한다). 지나가며 닿은 상대만 맞고, Pierce면 꿰뚫어 사거리 끝까지 간다.
--   Team "player" (기본): 몬스터를 맞힌다. 피해는 쏜 플레이어의 PlayerAttack.SkillHitOne (HitEvent 경로)
--   Team "monster": 플레이어·그림자를 맞힌다. 피해는 쏜 몬스터의 MonsterAttack.HitOne — 움직여서 피할 수 있다
-- 모양·스프라이트는 Projectile 모델 (Body 없음, Translate로 이동). 몬스터 화살은 쏠 때 그림을 바꾼다.
@Component
script Projectile extends Component

    property Entity Terrain = nil
    property Entity Owner = nil
    property Vector2 Dir = Vector2(1, 0)
    property number Speed = 10
    property number Range = 5
    property number Radius = 0.45            -- 판정 반경 (몬스터 발밑 기준, 투사체 높이 HeightOffset만큼 내려서 잰다)
    property number HeightOffset = 0.3
    property number AngleOffset = 0          -- 스프라이트가 왼쪽을 보면 180 (모델 값)
    property number Damage = 0
    property string Info = ""
    property boolean Pierce = true
    property string Team = "player"
    property boolean Launched = false
    property number Traveled = 0
    property table HitIds = {}
    property boolean DebugLog = false
    property number Homing = 0               -- 0이면 직선. 양수면 초당 이 라디안만큼 가까운 적 쪽으로 꺾는다 (영혼 격류)
    @Sync
    property Color TintColor = Color(1, 1, 1, 1)
    @Sync
    property string SkinRuid = ""            -- 스킬 투사체 그림 (서버에서 바꾼 SpriteRUID는 클라이언트에 안 보여서 동기화 값으로 칠한다)

    @ExecSpace("ServerOnly")
    method void Launch(Entity owner, Vector2 dir, number speed, number range, number damage, string info, boolean pierce)
        -- 방향(정규화)·속도·사거리·피해를 정하고 날린다. 스프라이트를 진행 방향으로 돌린다 (AngleOffset = 원본이 보는 방향 보정)
        self.Owner = owner
        local tiles = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        self.Terrain = tiles ~= nil and tiles.Entity or nil
        self.Dir = dir:Normalize()
        self.Speed = speed
        self.Range = range
        self.Damage = damage
        self.Info = info
        self.Pierce = pierce
        self.Traveled = 0
        self.HitIds = {}
        self.Entity.TransformComponent.ZRotation = math.deg(math.atan(self.Dir.y, self.Dir.x)) + self.AngleOffset
        self.Launched = true
        if self.DebugLog then log("[Projectile] launched " .. info .. " dmg=" .. tostring(math.floor(damage))) end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        if not self.Launched then return end
        if not isvalid(self.Owner) or self.Owner.CurrentMap ~= self.Entity.CurrentMap then
            self:Finish()
            return
        end
        if self.Team == "player" and not _Util:IsAlive(self.Owner) then self:Finish() return end
        if self.Team == "monster" then
            local body = self.Owner:GetComponent("script.Monster")
            if body == nil or body.IsDead then self:Finish() return end
        end
        if self.Team == "minion" then
            local unit = self.Owner:GetComponent("script.ShadowUnit")
            if unit == nil or unit.Dead or not _Util:IsAlive(unit.OwnerPlayer) then self:Finish() return end
        end
        if self.Homing > 0 then self:Steer(delta) end
        -- 이동을 잘게 나눠 저프레임·빠른 화살도 벽과 적을 건너뛰지 않게 한다.
        local distance = math.min(self.Speed * math.max(0, delta), math.max(0, self.Range - self.Traveled))
        local count = math.max(1, math.ceil(distance / 0.2))
        local step = distance / count
        for i = 1, count do
            local p = _Util:Pos2(self.Entity) - Vector2(0, self.HeightOffset) + self.Dir * step
            if _Util:TileBlocked(self.Terrain, p) then self:Finish() return end
            self.Entity.TransformComponent:Translate(self.Dir.x * step, self.Dir.y * step)
            self.Traveled = self.Traveled + step
            self:CheckHits(p)
            if not self.Launched then return end
        end
        if self.Traveled >= self.Range then self:Finish() end
    end

    @ExecSpace("ServerOnly")
    method void Steer(number delta)
        -- 반경 3.5 안 가장 가까운(아직 안 맞힌) 적 쪽으로 방향을 조금씩 돌린다.
        local p = _Util:Pos2(self.Entity) - Vector2(0, self.HeightOffset)
        local target = nil
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, p, 3.5)) do
            if not self.HitIds[m.Entity.Id] then target = m break end
        end
        if target == nil then return end
        local want = (_Util:Pos2(target.Entity) - p)
        if want:Magnitude() < 0.01 then return end
        local cur = math.atan(self.Dir.y, self.Dir.x)
        local goal = math.atan(want.y, want.x)
        local diff = (goal - cur + math.pi) % (2 * math.pi) - math.pi
        local step = math.max(-self.Homing * delta, math.min(self.Homing * delta, diff))
        local a = cur + step
        self.Dir = Vector2(math.cos(a), math.sin(a))
        self.Entity.TransformComponent.ZRotation = math.deg(a) + self.AngleOffset
    end

    @ExecSpace("ServerOnly")
    method void Tint(Color color)
        -- 같은 투사체 모델을 스킬마다 다른 색으로 보이게 한다 (클라이언트는 동기화된 값으로 칠한다)
        self.TintColor = color
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.Color = color end
    end

    @ExecSpace("ServerOnly")
    method void Skin(string ruid, number scale)
        -- 같은 투사체 모델에 스킬 그림(메이플 스킬 애니메이션)을 입힌다
        self.SkinRuid = ruid
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.SpriteRUID = ruid end
        self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 늦게 들어온 클라이언트: 이미 정해진 그림·색을 바로 입힌다
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        if self.SkinRuid ~= "" then sprite.SpriteRUID = self.SkinRuid end
        sprite.Color = self.TintColor
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        if name == "TintColor" then sprite.Color = self.TintColor
        elseif name == "SkinRuid" and self.SkinRuid ~= "" then sprite.SpriteRUID = self.SkinRuid end
    end

    @ExecSpace("ServerOnly")
    method void CheckHits(Vector2 p)
        if self.Team == "monster" then self:HitDefenders(p) return end
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, p, self.Radius)) do
            local key = m.Entity.Id
            if not self.HitIds[key] then
                self.HitIds[key] = true
                ---@type PlayerAttack
                if self.Team == "minion" then
                    local unit = self.Owner:GetComponent("script.ShadowUnit")
                    if unit ~= nil then unit:HitOne(m.Entity) end
                else
                    local atk = self.Owner:GetComponent("script.PlayerAttack")
                    local beforeHp = m.Hp
                    local hitPos = m.Entity.TransformComponent.WorldPosition + Vector3(0, self.HeightOffset, 0)
                    if atk ~= nil then atk:SkillHitOne(m.Entity, self.Info, self.Damage) end
                    if self.Info == "skill.bone_shard" and m.Hp < beforeHp then
                        local effects = self.Owner:GetComponent("script.SkillEffects")
                        if effects ~= nil then effects:BoneShardImpact(hitPos) end
                    end
                end
                if not self.Pierce then self:Finish() return end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void HitDefenders(Vector2 p)
        -- 몬스터 투사체: 반경 안 살아 있는 플레이어·그림자 하나에 닿으면 맞히고 사라진다
        ---@type MonsterAttack
        local atk = self.Owner:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local map = self.Entity.CurrentMap
        local victim = nil
        for _, u in ipairs(_Util:PlayersNear(map, p, self.Radius)) do victim = u end
        if victim == nil then
            for _, comp in ipairs(map:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
                ---@type ShadowUnit
                local unit = comp
                if victim == nil and not unit.Dead and (_Util:Pos2(unit.Entity) - p):Magnitude() <= self.Radius then victim = unit.Entity end
            end
        end
        if victim == nil then return end
        self.HitIds[victim.Id] = true
        atk:HitOne(victim)
        self:Finish()
    end

    @ExecSpace("ServerOnly")
    method void Finish()
        -- 사거리 끝·첫 명중(관통 아님)·주인 이탈 시 사라진다
        if not self.Launched then return end
        self.Launched = false
        local n = 0
        for _ in pairs(self.HitIds) do n = n + 1 end
        if self.DebugLog then log("[Projectile] end " .. self.Info .. " hits=" .. tostring(n) .. " traveled=" .. string.format("%.1f", self.Traveled)) end
        self.Entity:Destroy()
    end

end
