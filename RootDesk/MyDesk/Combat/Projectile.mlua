-- 날아가는 투사체. 판정은 서버가 내부 위치(SimPos)로 하고, 그림은 각 클라이언트가 발사 위치·방향·속도·서버 시각으로
-- 매 프레임 직접 그린다 (10-10 QA: 서버가 위치를 옮기면 동기화 간격만큼 뚝뚝 끊겨 「스티커가 날아가는」 것처럼 보였다).
-- 지나가며 닿은 상대만 맞고, Pierce면 꿰뚫어 사거리 끝까지 간다 (MaxHits가 있으면 그만큼 맞히고 멈춘다).
--   Team "player" (기본): 몬스터를 맞힌다. 피해는 쏜 플레이어의 PlayerAttack.SkillHitOne (HitEvent 경로)
--   Team "monster": 플레이어·그림자를 맞힌다. 피해는 쏜 몬스터의 MonsterAttack.HitOne — 움직여서 피할 수 있다
-- 모양·스프라이트는 Projectile 모델 (Body 없음, Translate로 이동). 몬스터 화살은 쏠 때 그림을 바꾼다.
@Component
script Projectile extends Component

    property Entity Terrain = nil
    property Entity Owner = nil
    @Sync
    property Vector2 Dir = Vector2(1, 0)
    @Sync
    property number Speed = 10
    @Sync
    property number Range = 5
    @Sync
    property Vector2 StartPos = Vector2(0, 0)  -- 발사 위치 (클라이언트 그림 기준)
    @Sync
    property number StartAt = 0               -- 발사 서버 시각 (_UtilLogic.ServerElapsedSeconds)
    @Sync
    property boolean Flying = false
    property Vector2 SimPos = Vector2(0, 0)   -- 서버 판정용 위치 (Transform은 옮기지 않는다)
    property Vector2 ViewPos = Vector2(0, 0)  -- 클라이언트: 유도 투사체의 그림 위치
    property number ViewStartAt = -1         -- 클라이언트: 그리기 시작한 발사(StartAt) — 재사용 투사체면 다시 맞춘다
    property any Ghosts = nil                -- 클라이언트: 잔상 {serial=true} (10-10 QA: 스티커 한 장이 나가는 것 같았다 → 같은 그림의 옅은 잔상 꼬리)
    property number NextGhostAt = 0
    property Vector2 ViewDir = Vector2(1, 0)  -- 클라이언트: 고정 대상 추적 중 진행 방향
    @Sync
    property Entity Shooter = nil            -- 쏜 플레이어·몬스터·소환수 (클라이언트가 그림을 그 손에서 출발시킨다)
    property number ViewDist = 0             -- 클라이언트: 그린 비행 거리
    @Sync
    property Entity Lock = nil               -- 고정 대상: 그 몬스터를 따라가 닿으면 끝난다 (골편 투척, 10-10 2차 QA)
    property number ViewT0 = 0               -- 클라이언트 시계 기준 발사 시각 (서버 시각은 네트워크 단위로만 바뀌어 계단식으로 움직였다)
    property number Radius = 0.45            -- 판정 반경 (몬스터 발밑 기준, 투사체 높이 HeightOffset만큼 내려서 잰다)
    property number HeightOffset = 0.3
    @Sync
    property number AngleOffset = 0          -- 스프라이트가 왼쪽을 보면 180 (모델 값)
    property number Damage = 0
    property string Info = ""
    property boolean Pierce = true
    property number SpikePct = 0             -- 골편 강화 「뼈 가시」: 꿰뚫을 때마다 피해 +% (docs/design/16)
    property integer PierceHits = 0          -- 지금까지 맞힌 적 수
    property integer MaxHits = 0             -- 관통해도 이만큼 맞히면 멈춘다 (0 = 제한 없음 · 스킬 레벨 구간 SkillBook.GetPierceCap, 10-24)
    property integer Bounces = 0             -- 골편 강화 「튕김」: 맞힌 뒤 가까운 다른 적에게 튈 남은 횟수
    property integer Splits = 0              -- 서리 혼 (10-28 투사체 A안 「쪼개짐」): 처음 맞은 적에서 갈라질 서리 파편 수
    property number BurstRadius = 0          -- 저주 불꽃 (10-28 투사체 A안 「폭발」): 저주 걸린 적에 맞으면 이 반경에 화염 폭발 (0 = 없음)
    property number MinionMul = 1            -- 해골 마법사 투사체 한 발 배율 (48 §2-2 · MageBolts.MageTraits) — 소환수 갈래 피해는 쏜 마법사 공격 × 이 값 (ShadowUnit.HitBolt)
    property string Team = "player"
    property boolean Launched = false
    property number Traveled = 0
    property table HitIds = {}
    property boolean DebugLog = false
    @Sync
    property number Homing = 0               -- 0이면 직선. 양수면 초당 이 라디안만큼 가까운 적 쪽으로 꺾는다 (영혼 격류)
    @Sync
    property Color TintColor = Color(1, 1, 1, 1)
    @Sync
    property string SkinRuid = ""
    @Sync
    property string ViewKind = ""            -- "bone_shard": 쏜 사람 화면에서는 직접 그린 예측 뼛조각을 보이고 이 투사체는 숨긴다
    property boolean LocalView = false       -- 클라이언트 전용 예측 투사체 (판정 없음, 사거리 끝에서 스스로 사라진다)
    property boolean ViewHidden = false            -- 스킬 투사체 그림 (서버에서 바꾼 SpriteRUID는 클라이언트에 안 보여서 동기화 값으로 칠한다)
    @Sync
    property string Style = ""               -- 44-1 A 있는 그림 재조합: 스킬마다 꼬리·맞은 자리 모양 ("spear" 긴 창·꽂힘 · "torrent" 혼 꼬리 · "rite"/"rite_push" 뼈 화살 · "" 기본)
    property integer ViewFrame = 0           -- 클라이언트: 「|」로 이은 프레임 그림(코덱스 납품분)의 지금 칸 (SkinFrame)
    property number HitSparkScale = 0.6      -- 투사체 명중 불꽃(P11 · 저주 불꽃·서리 혼·골편 공통) 크기 (10-31 갈래 E · 예전 0.45)
    property number TorrentHitScale = 0.6    -- 영혼 격류 명중 혼 구슬(P28) 크기 (예전 0.38)
    property number SpearHitScale = 1.0      -- 뼈 창 꽂힘(P05 · 128px = 1.28칸) 배율 (10-31 갈래 E2 · 코덱스 renderer_scale_proposal 1 · 예전 대기 자리 0.9)

    @ExecSpace("ServerOnly")
    method void Launch(Entity owner, Vector2 dir, number speed, number range, number damage, string info, boolean pierce)
        -- 방향(정규화)·속도·사거리·피해를 정하고 날린다. 스프라이트를 진행 방향으로 돌린다 (AngleOffset = 원본이 보는 방향 보정)
        self.Owner = owner
        self.Shooter = owner
        local tiles = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        self.Terrain = tiles ~= nil and tiles.Entity or nil
        self.Dir = dir:Normalize()
        self.Speed = speed
        self.Range = range
        self.Damage = damage
        self.Info = info
        self.Pierce = pierce
        self.Traveled = 0
        self.HitIds = {}
        self.Entity.TransformComponent.ZRotation = math.deg(math.atan(self.Dir.y, self.Dir.x)) + self.AngleOffset
        self.SimPos = _Util:Pos2(self.Entity)
        self.StartPos = self.SimPos
        self.StartAt = _UtilLogic.ServerElapsedSeconds
        if isvalid(self.Lock) then self.Range = math.max(range, (_Util:Pos2(self.Lock) - (self.SimPos - Vector2(0, self.HeightOffset))):Magnitude() + 2) end
        self.Flying = true
        self.Launched = true
        if self.DebugLog then log("[Projectile] launched " .. info .. " dmg=" .. tostring(math.floor(damage))) end
    end

    method void OnUpdate(number delta)
        if self:IsClient() then
            self:DrawFlight(delta)
            return
        end
        if not self.Launched then return end
        if not isvalid(self.Owner) or self.Owner.CurrentMap ~= self.Entity.CurrentMap then
            self:Finish()
            return
        end
        if self.Team == "player" and not _Util:IsAlive(self.Owner) then self:Finish() return end
        if self.Team == "monster" then
            local body = self.Owner:GetComponent("script.Monster")
            if body == nil or body.IsDead then self:Finish() return end
        end
        if self.Team == "minion" then
            local unit = self.Owner:GetComponent("script.ShadowUnit")
            if unit == nil or unit.Dead or not _Util:IsAlive(unit.OwnerPlayer) then self:Finish() return end
        end
        if self.Homing > 0 then self:Steer(delta) end
        -- 이동을 잘게 나눠 저프레임·빠른 화살도 벽과 적을 건너뛰지 않게 한다.
        local distance = math.min(self.Speed * math.max(0, delta), math.max(0, self.Range - self.Traveled))
        local count = math.max(1, math.ceil(distance / 0.2))
        local step = distance / count
        for i = 1, count do
            if self.Lock ~= nil then self:SteerToLock() end
            local p = self.SimPos - Vector2(0, self.HeightOffset) + self.Dir * step
            if _Util:TileBlocked(self.Terrain, p) then self:Finish() return end
            self.SimPos = self.SimPos + self.Dir * step
            self.Traveled = self.Traveled + step
            self:CheckHits(p)
            if not self.Launched then return end
        end
        if self.Traveled >= self.Range then self:Finish() end
    end

    @ExecSpace("ServerOnly")
    method void SteerToLock()
        -- 고정 대상 발밑(+높이)을 향해 매 걸음 방향을 다시 잡는다. 대상이 죽거나 사라지면 그 방향 그대로 날아간다
        local m = isvalid(self.Lock) and self.Lock:GetComponent("script.Monster") or nil
        if m == nil or m.IsDead or self.Lock.CurrentMap ~= self.Entity.CurrentMap then
            self.Lock = nil
            return
        end
        local want = _Util:Pos2(self.Lock) - (self.SimPos - Vector2(0, self.HeightOffset))
        if want:Magnitude() > 0.05 then self.Dir = want:Normalize() end
    end

    @ExecSpace("ServerOnly")
    method void Steer(number delta)
        -- 반경 3.5 안 가장 가까운(아직 안 맞힌) 적 쪽으로 방향을 조금씩 돌린다.
        local p = self.SimPos - Vector2(0, self.HeightOffset)
        local target = nil
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, p, 3.5)) do
            if not self.HitIds[m.Entity.Id] then target = m break end
        end
        if target == nil then return end
        local want = (_Util:Pos2(target.Entity) - p)
        if want:Magnitude() < 0.01 then return end
        local cur = math.atan(self.Dir.y, self.Dir.x)
        local goal = math.atan(want.y, want.x)
        local diff = (goal - cur + math.pi) % (2 * math.pi) - math.pi
        local step = math.max(-self.Homing * delta, math.min(self.Homing * delta, diff))
        local a = cur + step
        self.Dir = Vector2(math.cos(a), math.sin(a))
    end

    @ExecSpace("ClientOnly")
    method void DrawFlight(number delta)
        -- 10-10 3차 QA: 「골편이 지팡이가 아니라 엄청 멀리서 출발한다」 — 처음 본 순간 서버에서 이미 날아간 거리만큼 건너뛰어
        -- 그렸다(네트워크 지연·생성 지연만큼). 이제 늘 쏜 사람의 지금 위치(손 높이)에서 출발하고, 서버보다 뒤처진 만큼은
        -- 1.4배 빠르게 날아 따라잡는다. 고정 대상(Lock)은 이 화면의 몬스터 위치까지, 유도는 동기화된 방향으로, 직선은 사거리까지
        if not self.Flying or self.SkinRuid == "" then return end
        if self:HideForPrediction() then return end
        local now = _UtilLogic.ElapsedSeconds
        if self.ViewStartAt ~= self.StartAt then
            self.ViewStartAt = self.StartAt
            self:UpdateVisible()
            self.ViewT0 = now - math.max(0, math.min(0.5, _UtilLogic.ServerElapsedSeconds - self.StartAt))
            self.ViewDir = self.Dir
            self.ViewDist = 0
            self.ViewPos = self.StartPos
            if isvalid(self.Shooter) and self.Shooter.CurrentMap == self.Entity.CurrentMap then
                local hand = _Util:Pos2(self.Shooter) + Vector2(0, self.HeightOffset) + self.Dir * 0.35
                if (hand - self.StartPos):Magnitude() < 2 then self.ViewPos = hand end
            end
            -- 10-31 골편 20장: 골편 계열 그림 순환 시작 (내가 쏜 것만 · 출시 서버 끔)
            if self:MirrorSkin() and not Environment:IsPublishedPlay() and isvalid(self.Shooter) and self.Shooter == _UserService.LocalPlayer then
                log(string.format("[VRF] shard frames start n=%d ms=%d left=%s local=%s", #_Util:Frames(self.SkinRuid), _GameConst.FxSkillShardFrameMs, tostring(self.Dir.x < 0), tostring(self.LocalView)))
            end
        end
        local expected = self.Speed * (now - self.ViewT0)
        local boost = self.ViewDist < expected - 0.05 and 1.4 or 1
        local step = self.Speed * math.max(0, delta) * boost
        if self.Lock ~= nil and isvalid(self.Lock) then
            local aim = _Util:Pos2(self.Lock) + Vector2(0, self.HeightOffset)
            local to = aim - self.ViewPos
            local dist = to:Magnitude()
            if dist > 0.01 then self.ViewDir = to / dist end
            self.ViewPos = self.ViewPos + self.ViewDir * step
            -- 닿으면 놓고 그 방향 그대로 꿰뚫어 간다 (서버도 명중 순간 Lock을 푼다)
            if dist <= step then self.Lock = nil end
        elseif self.Homing > 0 then
            self.ViewDir = self.Dir
            self.ViewPos = self.ViewPos + self.ViewDir * step
        else
            step = math.min(step, math.max(0, self.Range - self.ViewDist))
            self.ViewPos = self.ViewPos + self.ViewDir * step
        end
        self.ViewDist = self.ViewDist + step
        self:AdvanceFrame()
        self:DropGhost(self.Entity.TransformComponent)
        local t = self.Entity.TransformComponent
        t.WorldPosition = Vector3(self.ViewPos.x, self.ViewPos.y, t.WorldPosition.z)
        t.ZRotation = math.deg(math.atan(self.ViewDir.y, self.ViewDir.x)) + self.AngleOffset
        self:FaceMirror()
        -- 예측 뼛조각은 서버처럼 벽에 닿거나 사거리 끝·관통 상한에서 사라진다 (서버 투사체는 서버 Finish가 없앤다)
        if self.LocalView and self.MaxHits > 0 then
            for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, self.ViewPos - Vector2(0, self.HeightOffset), self.Radius)) do
                self.HitIds[m.Entity.Id] = true
            end
        end
        if self.LocalView and (self.ViewDist >= self.Range - 0.01 or self:HitCapReached() or _Util:TileBlocked(self.Terrain, self.ViewPos - Vector2(0, self.HeightOffset))) then
            self.Flying = false
            self.Entity:Destroy()
        end
    end

    @ExecSpace("ClientOnly")
    method boolean HideForPrediction()
        -- 내가 쏜 골편의 서버 투사체: 누르는 순간 직접 그린 예측 뼛조각이 이미 날고 있으니 이 그림은 숨긴다
        if self.LocalView or self.ViewKind == "" or not isvalid(self.Shooter) or self.Shooter ~= _UserService.LocalPlayer then return false end
        if not self.ViewHidden then
            local fx = self.Shooter:GetComponent("script.SkillEffects")
            ---@type SkillEffects
            local effects = fx
            if effects == nil or not effects:RecentlyPredicted() then return false end
            self.ViewHidden = true
            local sprite = self.Entity.SpriteRendererComponent
            if isvalid(sprite) then sprite.Enable = false end
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method void PlayLocal(Entity shooter, Vector2 dir, number speed, number range, string skin, number scale, Entity lock)
        -- 클라이언트 전용 예측 투사체: 서버 Launch와 같은 값으로 날리고 그림만 그린다 (판정·피해 없음)
        self.LocalView = true
        self.HitIds = {}
        self.Shooter = shooter
        local tiles = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        self.Terrain = tiles ~= nil and tiles.Entity or nil
        self.Dir = dir:Normalize()
        self.Speed = speed
        self.Lock = lock
        self.StartPos = _Util:Pos2(self.Entity)
        self.Range = range
        if isvalid(lock) then self.Range = math.max(range, (_Util:Pos2(lock) - (self.StartPos - Vector2(0, self.HeightOffset))):Magnitude() + 2) end
        self.StartAt = _UtilLogic.ServerElapsedSeconds
        self.SkinRuid = skin
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then
            sprite.SpriteRUID = self:SkinFrame()
            sprite.Color = self.TintColor
        end
        self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1)
        self.Flying = true
        self:UpdateVisible()
    end

    @ExecSpace("ClientOnly")
    method void DropGhost(TransformComponent t)
        -- 스킬 그림 투사체만: 0.035초마다 같은 그림을 옅게 그 자리에 남겨 0.14초 뒤 지운다 (날아가는 궤적이 보이게)
        -- 44-1 A: 영혼 격류(torrent)는 더 촘촘하고 오래 남는 혼 꼬리 · 뼈 창(spear)은 긴 몸 그대로 짧은 잔상 (가로·세로 배율을 따로 쓴다)
        if self.SkinRuid == "" or _UtilLogic.ElapsedSeconds < self.NextGhostAt then return end
        local gap, life, alpha, shrink = 0.035, 0.14, 0.4, 0.85
        if self.Style == "torrent" then gap, life, alpha, shrink = 0.022, 0.26, 0.5, 0.75
        elseif self.Style == "spear" then gap, life, alpha, shrink = 0.03, 0.1, 0.32, 0.95 end
        self.NextGhostAt = _UtilLogic.ElapsedSeconds + gap
        if self.Ghosts == nil then self.Ghosts = {} end
        local sx, sy = t.Scale.x * shrink, t.Scale.y * shrink
        local body = self.Entity.SpriteRendererComponent
        if isvalid(body) and body.FlipY then sy = -sy end   -- 10-31 골편 20장: 왼쪽으로 나는 골편 계열은 잔상도 같은 가로 거울 (FaceMirror)
        local serial = _EffectService:PlayEffect(self:SkinFrame(), self.Entity, t.WorldPosition, t.ZRotation, Vector3(sx, sy, 1), false, { Alpha = alpha, Color = self.TintColor })
        if serial == 0 then return end
        local ghosts = self.Ghosts
        ghosts[serial] = true
        _TimerService:SetTimerOnce(function()
            if ghosts[serial] then
                ghosts[serial] = nil
                _EffectService:RemoveEffect(serial)
            end
        end, life)
    end

    method boolean MirrorSkin()
        -- 10-31 골편 20장: 골편 계열 투사체 그림(GameConst.FxSkillShardThrow·SpearShard·StormShard·BoneArrow · 오른쪽 기준 · 코덱스 「horizontal mirror permitted」)인가
        local s = self.SkinRuid
        if s == "" or string.find(s, "|", 1, true) == nil then return false end
        return s == _GameConst.FxSkillShardThrow or s == _GameConst.FxSkillSpearShard or s == _GameConst.FxSkillStormShard or s == _GameConst.FxSkillBoneArrow
    end

    method number FrameSec()
        -- 프레임 그림 장 간격: 골편 계열은 GameConst.FxSkillShardFrameMs(코덱스 100ms) · 나머지는 예전 0.08초
        if self:MirrorSkin() then return math.max(0.02, _GameConst.FxSkillShardFrameMs / 1000) end
        return 0.08
    end

    @ExecSpace("ClientOnly")
    method void FaceMirror()
        -- 골편 계열 그림은 오른쪽 기준: 왼쪽 반쪽으로 날면(진행 각 90°~270°) 회전만으로는 위아래가 뒤집혀 보인다 → FlipY (회전 180° + FlipY = 가로 거울). 다른 그림은 늘 끔
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local flip = self:MirrorSkin() and self.ViewDir.x < 0
        if sprite.FlipY ~= flip then sprite.FlipY = flip end
    end

    method string SkinFrame()
        -- 그림 한 장이면 그대로, 「|」로 이은 프레임(코덱스 납품분 · GameConst.FxSkill*)이면 지금 칸 (클라이언트는 AdvanceFrame이 FrameSec마다 넘긴다)
        if string.find(self.SkinRuid, "|", 1, true) == nil then return self.SkinRuid end
        local list = _Util:Frames(self.SkinRuid)
        if #list == 0 then return "" end
        return list[self.ViewFrame % #list + 1]
    end

    @ExecSpace("ClientOnly")
    method void AdvanceFrame()
        -- 프레임 그림 투사체만: 날아가는 동안 FrameSec(예전 0.08초 · 골편 계열 FxSkillShardFrameMs)마다 다음 칸 (한 장짜리 그림은 아무것도 안 한다)
        if string.find(self.SkinRuid, "|", 1, true) == nil then return end
        local frame = math.floor((_UtilLogic.ElapsedSeconds - self.ViewT0) / self:FrameSec())
        if frame == self.ViewFrame then return end
        self.ViewFrame = frame
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) and not self.ViewHidden then sprite.SpriteRUID = self:SkinFrame() end
    end

    @ExecSpace("ServerOnly")
    method void Tint(Color color)
        -- 같은 투사체 모델을 스킬마다 다른 색으로 보이게 한다 (클라이언트는 동기화된 값으로 칠한다)
        self.TintColor = color
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.Color = color end
    end

    @ExecSpace("ServerOnly")
    method void Skin(string ruid, number scale)
        -- 같은 투사체 모델에 스킬 그림(메이플 스킬 애니메이션)을 입힌다
        self:SkinXY(ruid, scale, scale)
    end

    @ExecSpace("ServerOnly")
    method void SkinXY(string ruid, number sx, number sy)
        -- 44-1 A: 진행 방향(가로)·두께(세로) 배율을 따로 — 뼈 창은 같은 궤적 그림을 가늘고 길게 늘인다. 「|」 프레임 그림이면 첫 칸
        self.SkinRuid = ruid
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.SpriteRUID = self:SkinFrame() end
        self.Entity.TransformComponent.Scale = Vector3(sx, sy, 1)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 늦게 들어온 클라이언트: 이미 정해진 그림·색을 바로 입힌다. 그림·발사 전이면 숨긴다 (UpdateVisible)
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        sprite.Color = self.TintColor
        self:UpdateVisible()
    end

    @ExecSpace("ClientOnly")
    method void UpdateVisible()
        -- 10-11 QA 「골편 쏠 때 캐릭터 옆 파란 화살」: 모델 기본 그림(파란 얼음 화살)이 그림(SkinRuid)·발사(Flying)
        -- 동기화가 오기 전 몇 프레임 손 앞에 보였다. 그림이 정해지고 날기 시작한 투사체만 그린다
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        if self.SkinRuid == "" or not self.Flying then
            sprite.Enable = false
            return
        end
        if self:HideForPrediction() then return end
        local frame = self:SkinFrame()
        if sprite.SpriteRUID ~= frame then sprite.SpriteRUID = frame end
        sprite.Enable = true
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 남은 잔상 정리
        if self.Ghosts == nil then return end
        for serial, _ in pairs(self.Ghosts) do
            self.Ghosts[serial] = nil
            _EffectService:RemoveEffect(serial)
        end
    end

    method boolean ShakesOnHit()
        -- 화면을 흔드는 투사체 (평타·골편 투척처럼 잦은 것은 제외)
        return self.Info == "skill.bone_spear" or self.Info == "skill.soul_torrent"
    end

    @ExecSpace("Multicast")
    method void HitFx(Vector3 pos, Color color, Entity shooter, boolean shake, string style)
        -- 맞은 자리에서 투사체 색 불꽃이 튄다 (맞았는지 보이게). 뼈 창·영혼 격류는 쏜 사람 화면만 살짝 흔든다 (10-28 F5 C-3)
        -- 44-1 A 있는 그림 재조합: 스킬마다 맞은 자리 모양이 다르다 — 뼈 창 = 진행 방향으로 꽂히는 빛 파열 · 영혼 격류 = 빨려드는 혼 ·
        --   뼈 화살 마지막 발 = 큰 뼛가루 충격 (코덱스 H-1 꽂힘 그림 GameConst.FxSkillSpearHit가 오면 그 프레임으로)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local map = me.CurrentMap
        local angle = math.deg(math.atan(self.Dir.y, self.Dir.x))
        if style == "spear" then
            if _GameConst.FxSkillSpearHit ~= "" then
                -- 10-31 갈래 E2 P05: 꽂힘 6장 장별 60·60·70·70·70·70ms(합 400ms) · 표적 중심 · 진행 방향 · 마지막 장(창대가 남은 장)은 효과가 끝날 때까지
                _Util:PlayFramesMs(_GameConst.FxSkillSpearHit, map, pos, angle, Vector3(self.SpearHitScale, self.SpearHitScale, 1), _GameConst.FxSkillSpearHitMs, 0, 0, Color(1, 1, 1, 1), 6)
            else
                _ParticleService:PlayBasicParticle(BasicParticleType.PillarBurst, map, pos, angle - 90, Vector3(0.42, 0.55, 1), false, { Color = Color(0.95, 0.9, 0.78, 0.95) })
                _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, map, pos, 0, Vector3(0.32, 0.22, 1), false, { Color = Color(0.85, 0.8, 0.7, 0.9) })
            end
        elseif style == "torrent" then
            _ParticleService:PlayBasicParticle(BasicParticleType.ChargeOrb, map, pos, 0, Vector3(self.TorrentHitScale, self.TorrentHitScale, 1), false, { Color = color })
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, map, pos, 0, Vector3(0.3, 0.3, 1), false, { Color = color })
        elseif style == "rite_push" then
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, map, pos, 0, Vector3(0.75, 0.5, 1), false, { Color = Color(0.95, 0.9, 0.78, 1) })
            _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, map, pos - Vector3(0, 0.25, 0), 0, Vector3(0.6, 0.28, 1), false, nil)
            _Util:SkillShake(shooter, 0.1, 0.14)
        else
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, map, pos, 0, Vector3(self.HitSparkScale, self.HitSparkScale, 1), false, { Color = color })
        end
        if shake and style ~= "rite_push" then _Util:SkillShake(shooter, 0.06, 0.09) end
        if style ~= "" and not Environment:IsPublishedPlay() and shooter == me then log("[VRF] projectile hit fx style=" .. style) end
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        if name == "TintColor" then sprite.Color = self.TintColor
        elseif name == "SkinRuid" or name == "Flying" or name == "ViewKind" then self:UpdateVisible() end
    end

    @ExecSpace("ServerOnly")
    method void CheckHits(Vector2 p)
        if self.Team == "monster" then self:HitDefenders(p) return end
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, p, self.Radius)) do
            local key = m.Entity.Id
            if not self.HitIds[key] then
                self.HitIds[key] = true
                ---@type PlayerAttack
                if self.Team == "minion" then
                    -- 해골 마법사 속성 투사체 (48 §2-6): 피해는 쏜 마법사 공격 기준(ShadowUnit.CalcDamage) — 뼈 창 가시(꿰뚫을수록 +SpikePct%) ·
                    --   불꽃 폭발(BurstRadius · 늘 · ×0.3) · 서리 파편(Splits · 처음 맞은 적에서 한 번)은 소환수 갈래에서 따로 (캐릭터 HexBurst·FrostSplit은 PlayerAttack 피해라 쓰지 않는다)
                    ---@type ShadowUnit
                    local unit = self.Owner:GetComponent("script.ShadowUnit")
                    if unit ~= nil then
                        unit:HitBolt(m.Entity, self.MinionMul * (1 + self.SpikePct / 100 * self.PierceHits), self.BurstRadius)
                        if self.Splits > 0 then
                            unit:MageSplit(_Util:Pos2(m.Entity), self.HitIds, self.Splits)
                            self.Splits = 0
                        end
                    end
                    self.PierceHits = self.PierceHits + 1   -- 뼈 창 마법사 관통 MaxHits · 가시
                    self:HitFx(m.Entity.TransformComponent.WorldPosition + Vector3(0, self.HeightOffset, 0), self.TintColor, self.Owner, self:ShakesOnHit(), self.Style)
                else
                    local atk = self.Owner:GetComponent("script.PlayerAttack")
                    local beforeHp = m.Hp
                    local hitPos = m.Entity.TransformComponent.WorldPosition + Vector3(0, self.HeightOffset, 0)
                    local dmg = self.Damage * (1 + self.SpikePct / 100 * self.PierceHits)   -- 「뼈 가시」: 꿰뚫을수록 세게
                    self.PierceHits = self.PierceHits + 1
                    local bounced = false
                    if self.Info == "skill.bone_shard" and self.Bounces > 0 then
                        -- 「튕김」: 맞힌 자리에서 가까운 다른 적에게 새 뼛조각 (한 발이 튈 수 있는 횟수는 랭크만큼). 「뼈 가시」는 튈 때마다 세진다 (10-28 A안)
                        ---@type SkillEffects
                        local effects = self.Owner:GetComponent("script.SkillEffects")
                        if effects ~= nil then bounced = effects:ShardBounce(_Util:Pos2(m.Entity), self.HitIds, self.Damage * (1 + self.SpikePct / 100), self.Bounces - 1, self.SpikePct) end
                        self.Bounces = 0
                    end
                    -- 「뼈 가시」(44 결정 4): 더 튀지 못하는 마지막 뼛조각(튕김을 다 썼거나 튈 적이 없다)에도 가시가 박힌다 — 예전엔 튕길 때만 붙어 튕김 0이면 효과 0
                    if self.Info == "skill.bone_shard" and self.SpikePct > 0 and not bounced then
                        dmg = dmg * (1 + self.SpikePct / 100)
                        log(string.format("[VRF] shard spike last hit +%d%% dmg=%.0f", math.floor(self.SpikePct), dmg))
                    end
                    if atk ~= nil then atk:SkillHitOne(m.Entity, self.Info, dmg) end
                    if self.Info == "skill.frost_soul" and self.Splits > 0 then
                        -- 서리 혼 「쪼개짐」: 처음 맞은 적에서 서리 파편이 가까운 다른 적들에게 갈라져 나간다 (파편은 다시 갈라지지 않는다)
                        local effects = self.Owner:GetComponent("script.SkillEffects")
                        if effects ~= nil then effects:FrostSplit(_Util:Pos2(m.Entity), self.HitIds, self.Damage, self.Splits) end
                        self.Splits = 0
                    end
                    if self.Info == "skill.hex_flame" and self.BurstRadius > 0 and m:IsCursed() then
                        -- 저주 불꽃 「폭발」: 저주 걸린 적에 맞으면 둘레의 다른 적에게 화염 폭발
                        local effects = self.Owner:GetComponent("script.SkillEffects")
                        if effects ~= nil then effects:HexBurst(_Util:Pos2(m.Entity), self.Damage, self.BurstRadius, m.Entity.Id) end
                    end
                    if self.Info == "skill.bone_shard" and m.Hp < beforeHp then
                        local effects = self.Owner:GetComponent("script.SkillEffects")
                        if effects ~= nil then effects:BoneShardImpact(hitPos) end
                    elseif m.Hp < beforeHp then
                        self:HitFx(hitPos, self.TintColor, self.Owner, self:ShakesOnHit(), self.Style)
                    end
                end
                -- 10-11 QA: 고른 적에 닿아도 사라지지 않고 꿰뚫어 그 방향 그대로 사거리 끝까지 간다 (맞은 자리엔 타격 이펙트만 남는다)
                if m.Entity == self.Lock then self.Lock = nil end
                if not self.Pierce or self:HitCapReached() then self:Finish() return end
            end
        end
        -- 결투 상대 플레이어·그 소환수 (10-23 결투 군단전: 예전엔 몬스터만 봐서 뼈 창·골편·화살이 상대에게 맞지 않았다)
        for _, foe in ipairs(_Util:DuelFoesNear(self.Owner, self.Entity.CurrentMap, p, self.Radius + 0.25, false)) do
            local key = foe.Id
            if not self.HitIds[key] then
                self.HitIds[key] = true
                local hitPos = foe.TransformComponent.WorldPosition + Vector3(0, self.HeightOffset, 0)
                if self.Team == "minion" then
                    ---@type ShadowUnit
                    local unit = self.Owner:GetComponent("script.ShadowUnit")
                    if unit ~= nil then unit:HitBolt(foe, self.MinionMul, 0) end
                else
                    local atk = self.Owner:GetComponent("script.PlayerAttack")
                    local dmg = self.Damage * (1 + self.SpikePct / 100 * self.PierceHits)
                    self.PierceHits = self.PierceHits + 1
                    if atk ~= nil then atk:SkillHitOne(foe, self.Info, dmg) end
                end
                self:HitFx(hitPos, self.TintColor, self.Owner, self:ShakesOnHit(), self.Style)
                if foe == self.Lock then self.Lock = nil end
                if not self.Pierce or self:HitCapReached() then self:Finish() return end
            end
        end
    end

    method boolean HitCapReached()
        -- 관통 상한: 맞힌 적 수가 MaxHits에 닿았다
        if self.MaxHits <= 0 then return false end
        local n = 0
        for _ in pairs(self.HitIds) do n = n + 1 end
        return n >= self.MaxHits
    end

    @ExecSpace("ServerOnly")
    method void HitDefenders(Vector2 p)
        -- 몬스터 투사체: 반경 안 살아 있는 플레이어·그림자 하나에 닿으면 맞히고 사라진다
        ---@type MonsterAttack
        local atk = self.Owner:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local map = self.Entity.CurrentMap
        local victim = nil
        for _, u in ipairs(_Util:PlayersNear(map, p, self.Radius)) do victim = u end
        if victim == nil then
            for _, comp in ipairs(_Util:ListOf(map, "script.ShadowUnit")) do
                ---@type ShadowUnit
                local unit = comp
                if victim == nil and isvalid(comp) and not unit.Dead and (_Util:Pos2(unit.Entity) - p):Magnitude() <= self.Radius then victim = unit.Entity end
            end
        end
        if victim == nil then return end
        self.HitIds[victim.Id] = true
        self:HitFx(victim.TransformComponent.WorldPosition + Vector3(0, self.HeightOffset + 0.2, 0), self.TintColor, self.Owner, self:ShakesOnHit(), self.Style)
        atk:HitOne(victim)
        self:Finish()
    end

    @ExecSpace("ServerOnly")
    method void Finish()
        -- 사거리 끝·첫 명중(관통 아님)·주인 이탈 시 사라진다
        if not self.Launched then return end
        self.Launched = false
        local n = 0
        for _ in pairs(self.HitIds) do n = n + 1 end
        if self.DebugLog then log("[Projectile] end " .. self.Info .. " hits=" .. tostring(n) .. " traveled=" .. string.format("%.1f", self.Traveled)) end
        self.Entity:Destroy()
    end

end
