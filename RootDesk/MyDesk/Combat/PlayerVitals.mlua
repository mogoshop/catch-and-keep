-- 플레이어 피격·사망·부활. 사망 규칙은 디아블로2와 같다:
--   골드: 보유 골드의 (레벨)% 손실, 최대 deathGoldPctCap(20)%
--   장비: 착용 장비가 죽은 자리의 시체에 남고(PlayerCorpses), 마을에서 맨몸으로 부활
--   경험치: 난이도별 손실(difficulty.csv, 악몽 5% / 지옥 10%, 레벨 유지), 시체를 되찾으면 deathExpRecover(75%) 회복
--   결투 패배는 예외: 장비를 떨구지 않고 제자리 부활 (PlayerDuel)
@Component
script PlayerVitals extends Component

    property number InvincibleSeconds = 0.8
    property number RespawnInvincible = 2
    property number InvincibleUntil = 0
    property boolean Dying = false
    property integer TimerId = 0
    property boolean HitStateDetached = false
    property string LastHitBy = ""           -- 마지막으로 때린 플레이어 userId (소환수면 주인, 몬스터·장판이면 "") — 결투 패배 판정용
    property number LastHitAt = 0
    property string LastHitSource = ""       -- 마지막으로 때린 것 (몬스터 이름 · 플레이어 · 장판) — 테스트 플레이 기록의 사망 원인
    property number BlinkUntil = 0           -- 클라이언트: 피격 무적 깜빡임이 끝나는 시각 (내 시계)
    property number BlinkStart = 0
    @Sync
    property boolean Downed = false          -- 11-04 M-2: 쓰러져 부활을 기다리는 중 (서버가 정하고 모든 클라이언트가 쓰러짐 자세·생명 0 표시에 쓴다)
    property boolean PoseShown = false       -- 클라이언트: 쓰러짐 자세를 지금 그리고 있다
    property string FallAction = "dead"      -- 쓰러짐 몸짓 (메이플 아바타 동작 이름 · 빈 문자열이면 몸짓 없이 눕힘·흐림만)
    property number FallRotate = 90          -- 아바타를 눕히는 각도(도) — 메이플 「dead」 몸짓은 선 자세라(11-04 메이커 확인) 몸통을 90도 눕힌다 · 0이면 돌리지 않는다

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 엔진이 피격 생명 차감을 언제 하는지(우리 핸들러 앞/뒤)에 기대지 않고, 0 이하가 되면 바로 사망 처리한다.
        -- 피격·독·결투 등 어떤 경로로 깎여도 같다
        -- 엔진의 모든 피격→HIT 전환을 끈다. 실제 중단 여부와 자세는 아래의 피해 기준이 함께 결정한다.
        local state = self.Entity.StateComponent
        if isvalid(state) then state:DisconnectHitEvent() end
        self.TimerId = _TimerService:SetTimerRepeat(function() self:CheckDeath() end, 0.1)
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        self:TickBlink()
        self:TickFallPose()
        -- 플레이어 상태 머신은 클라이언트에도 피격을 듣는다. 초기화/맵 이동/부활 뒤 한 번씩 해제한다.
        if self.HitStateDetached then return end
        local state = self.Entity.StateComponent
        if not isvalid(state) then return end
        state:DisconnectHitEvent()
        self.HitStateDetached = true
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleMapChanged(EntityMapChangedEvent event)
        self.HitStateDetached = false
    end

    @ExecSpace("Client")
    method void PrepareHitState()
        self.HitStateDetached = false
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
    end

    @ExecSpace("ServerOnly")
    method void TakeTickDamage(number amount)
        -- 장판 같은 지속 피해: 무적 시간을 걸지 않는다 (잦은 작은 피해가 큰 공격을 막아 주지 않게). 생명만 깎는다
        if self.Dying or amount <= 0 then return end
        self.LastHitBy = ""
        self.LastHitAt = _UtilLogic.ElapsedSeconds
        self.LastHitSource = "장판·지속 피해"
        local pc = self.Entity.PlayerComponent
        if pc.Hp <= 0 then return end
        pc.Hp = math.max(0, pc.Hp - math.floor(amount + 0.5))
        self:CheckDeath()
    end

    @ExecSpace("ServerOnly")
    method void TakeDuelDamage(number amount, Entity source)
        -- 결투 상대의 지속 피해(독안개 · 혼 흡수): 틱 피해처럼 무적 없이 깎되, 쓰러지면 결투 패배로 판정되게 때린 사람을 남긴다
        if self.Dying or amount <= 0 then return end
        local owner = _Util:OwnerPlayerOf(source)
        self.LastHitBy = (isvalid(owner) and isvalid(owner.PlayerComponent)) and owner.PlayerComponent.UserId or ""
        self.LastHitAt = _UtilLogic.ElapsedSeconds
        self.LastHitSource = "플레이어"
        local pc = self.Entity.PlayerComponent
        if pc.Hp <= 0 then return end
        pc.Hp = math.max(0, pc.Hp - math.floor(amount + 0.5))
        self:CheckDeath()
    end

    method string SourceName(Entity attacker, Entity owner)
        -- 사망 원인 표시용 이름: 몬스터 이름(정예·보스 구분) · 플레이어 · 모르면 엔티티 이름
        if isvalid(owner) and isvalid(owner.PlayerComponent) then return "플레이어" end
        if not isvalid(attacker) then return "?" end
        ---@type Monster
        local m = attacker:GetComponent("script.Monster")
        if m == nil then
            ---@type Projectile
            local proj = attacker:GetComponent("script.Projectile")
            if proj ~= nil and isvalid(proj.Owner) then
                ---@type Monster
                local shooter = proj.Owner:GetComponent("script.Monster")
                m = shooter
            end
        end
        if m ~= nil then return (m.Horde and "떼 · " or "") .. _GameData:GetMonsterName(m.SourceId) .. (m.Grade >= 3 and "(보스)" or (m.Grade == 2 and "(정예)" or "")) end   -- 떼 사망은 「떼 · 」로 (텔레메트리 사망 원인)
        return attacker.Name
    end

    @ExecSpace("ServerOnly")
    method void CheckDeath()
        if self.Dying or not isvalid(self.Entity) then return end
        local pc = self.Entity.PlayerComponent
        if pc.Hp > 0 then return end
        pc.Hp = 0
        self:Die()
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- 생명 차감은 엔진(PlayerComponent)이 한다. 여기서는 무적 시간 시작과 피격 자세만 (사망은 CheckDeath).
        -- 무적·사망 중 피격 차단은 공격 쪽 IsAttackTarget이 CanBeHit으로 거른다 (맞은 뒤에 되돌리지 않는다)
        if self.Dying then return end
        local owner = _Util:OwnerPlayerOf(event.AttackerEntity)
        self.LastHitBy = (isvalid(owner) and isvalid(owner.PlayerComponent)) and owner.PlayerComponent.UserId or ""
        self.LastHitAt = _UtilLogic.ElapsedSeconds
        self.LastHitSource = self:SourceName(event.AttackerEntity, owner)
        self.InvincibleUntil = _UtilLogic.ElapsedSeconds + self.InvincibleSeconds
        self:CheckDeath()
        -- 큰 피해만 준비 중 공격을 끊는다. 가벼운 피해는 예약 타격과 조작을 유지한다.
        local pc = self.Entity.PlayerComponent
        local ratio = event.TotalDamage / math.max(1, pc.MaxHp)
        if not self.Dying and ratio >= 0.15 then
            local attack = self.Entity:GetComponent("script.PlayerAttack")
            if attack ~= nil then attack:InterruptSwing(0.18) end
        end
        self:HitFeel(ratio, pc.UserId)
        self:Blink(self.InvincibleSeconds)
    end

    @ExecSpace("Multicast")
    method void Blink(number seconds)
        -- 피격 무적 동안 반투명 깜빡임 (메이플식). 같은 맵의 모두에게 보인다 — 「지금은 안 맞는다」가 눈에 보이게
        local now = _UtilLogic.ElapsedSeconds
        self.BlinkStart = now
        self.BlinkUntil = now + seconds
    end

    @ExecSpace("ClientOnly")
    method void TickBlink()
        -- 0.08초 간격으로 반투명(0.62) ↔ 거의 불투명(0.95), 끝나면 1로 되돌린다
        if self.BlinkUntil <= 0 then return end
        local avatar = self.Entity.AvatarRendererComponent
        if not isvalid(avatar) then return end
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.BlinkUntil then
            self.BlinkUntil = 0
            avatar:SetAlpha(self.Downed and 0.75 or 1)
            return
        end
        local phase = math.floor((now - self.BlinkStart) / 0.08) % 2
        -- 11-04 기획 65 P-5: 예전 0.35 ↔ 0.85는 떼에 계속 맞는 동안 절반이 거의 투명해 몬스터 무리 속에서 캐릭터가 사라졌다 → 깜빡임은 남기고 바닥을 0.62로
        avatar:SetAlpha(phase == 0 and 0.62 or 0.95)
    end

    @ExecSpace("ClientOnly")
    method void TickFallPose()
        -- 11-04 M-2 쓰러짐 자세: Downed가 바뀔 때만 — 몸짓(FallAction) + 잿빛·반투명, 일어나면 원래 색 (코덱스 그림 없이 메이플 아바타 동작)
        if self.Downed == self.PoseShown then return end
        local avatar = self.Entity.AvatarRendererComponent
        if not isvalid(avatar) then return end
        self.PoseShown = self.Downed
        local root = avatar:GetAvatarRootEntity()
        if self.Downed then
            avatar:SetColor(0.62, 0.6, 0.66, 1)
            avatar:SetAlpha(0.75)
            local body = avatar:GetBodyEntity()
            if self.FallAction ~= "" and isvalid(body) then body:SendEvent(ActionStateChangedEvent(self.FallAction, self.FallAction, 1, SpriteAnimClipPlayType.Onetime)) end
            if self.FallRotate ~= 0 and isvalid(root) then root.TransformComponent.ZRotation = self.FallRotate end
        else
            avatar:SetColor(1, 1, 1, 1)
            avatar:SetAlpha(1)
            if self.FallRotate ~= 0 and isvalid(root) then root.TransformComponent.ZRotation = 0 end
        end
        log(string.format("[VRF] fall pose %s uid=%s action=%s rot=%.0f", self.Downed and "down" or "up", self.Entity.PlayerComponent.UserId, self.FallAction, self.FallRotate))
    end

    @ExecSpace("Client")
    method void HitFeel(number ratio)
        -- 내가 맞았을 때: 카메라 흔들림 + 둔탁한 소리. 생명의 15% 넘게 깎이면 더 세게
        -- HIT 자세는 쓰지 않는다: 엔진 HIT 상태(약 0.5초)는 이동 입력을 막아, 몬스터 여럿에게 둘러싸이면
        -- 맞을 때마다 다시 걸려 제자리에 묶였다 (10-13 사용자 지적, 메이커 측정: HIT 동안 방향키 이동량 0). 대신 무적 깜빡임(Blink)
        local cam = _CameraService:GetCurrentCameraComponent()
        local heavy = ratio >= 0.15
        if isvalid(cam) then cam:ShakeCamera(heavy and 0.22 or 0.1, heavy and 0.25 or 0.12) end
        _SoundDirector:PlayEffect(_GameConst.SfxImpact, heavy and 0.7 or 0.45)
    end

    method boolean CanBeHit()
        -- 공격 판정 대상인가: 살아 있고, 사망 처리 중이 아니고, 무적 시간이 지났다
        if self.Dying or self.Entity.PlayerComponent.Hp <= 0 then return false end
        return _UtilLogic.ElapsedSeconds >= self.InvincibleUntil
    end

    @ExecSpace("ServerOnly")
    method void Die()
        if self.Dying then return end
        self.Dying = true
        local travel = self.Entity:GetComponent("script.PlayerTravel")
        if travel ~= nil then
            travel:CancelCombat()
            travel:ResetLocalInput(self.Entity.PlayerComponent.UserId)
        end
        local pc = self.Entity.PlayerComponent
        self.Entity.StateComponent:ChangeState("DEAD")
        self.Downed = true
        ---@type PlayerDuel
        local duel = self.Entity:GetComponent("script.PlayerDuel")
        -- 결투 패배는 결투 상대(또는 그 소환수)에게 맞아 쓰러졌을 때만 (10-13: 결투를 걸어 두고 몬스터에게 죽어도 사망 벌칙이 없던 구멍)
        local byOpponent = duel ~= nil and duel.Opponent ~= "" and self.LastHitBy == duel.Opponent and _UtilLogic.ElapsedSeconds - self.LastHitAt <= 5
        local inDuel = false
        local duelWinner = ""
        if byOpponent then
            duelWinner = duel.Opponent
            inDuel = duel:OnOwnerDied()
        elseif duel ~= nil and duel.Opponent ~= "" then duel:Abort("결투 중 다른 원인으로 쓰러져 결투가 중단되었습니다") end
        -- 소환수가 무너진다 (D2). 결투에서 져도 같다 — 10-23: 예전엔 결투 패배면 군단을 두고 제자리에서 체력 가득 부활해,
        -- 보스전에서 친구에게 마지막 일격을 맞아 무료로 되살아나는 구멍이 됐다
        ---@type ShadowCommander
        local commander = self.Entity:GetComponent("script.ShadowCommander")
        if commander ~= nil then commander:RecallAll() end
        _UndeadSystem:DismissAll(self.Entity)
        local goldLost = 0
        local expLost = 0
        -- 심도 (10-20 하강 구조): 목숨 하나 — 쓰러지면 그 도전이 끝나고 마을로. 사망 벌칙·시체는 없다
        local depth = isvalid(self.Entity.CurrentMap) and self.Entity.CurrentMap:GetComponent("script.DepthDirector") or nil
        ---@type DepthDirector
        local dd = depth
        local inDepth = dd ~= nil and dd.Floor > 0
        if inDepth then
            _GameEvents:Emit("PlayerDied", { player = self.Entity, map = self.Entity.CurrentMap, cause = self.LastHitSource })
            self:NotifyDepthEnd(dd.Floor, pc.UserId)
            log("[VRF] depth run over floor=" .. tostring(dd.Floor) .. " user=" .. pc.UserId)
            _TimerService:SetTimerOnce(function() self:Revive(false) end, pc.RespawnDuration)
            return
        end
        if inDuel then
            -- 결투 패배 (10-23 사용자): 경험치는 잃지 않고, 가진 골드의 duelGoldDropPct%를 그 자리에 떨군다 (이긴 사람 몫)
            goldLost = self:DropDuelGold(duelWinner)
        else
            local lost = self:ApplyDeathPenalty()
            goldLost = lost.gold
            expLost = lost.exp
        end
        -- 시체: 착용 장비와 되찾을 경험치 (결투 패배도 같다 — 장비는 주인만 되찾는다)
        -- 11-04 M-1 (기획 65 · 사용자 승인): 노말 · 캐릭터 Lv < corpseKeepGearBelowLv면 장비는 그대로 입는다 (골드·경험치 규칙은 그대로 · 결투 패배는 제외)
        local keepGear = not inDuel and self:KeepsGear()
        local deathPos = _Util:Pos2(self.Entity)
        local deathMap = self.Entity.CurrentMap
        ---@type PlayerCorpses
        local corpses = self.Entity:GetComponent("script.PlayerCorpses")
        local corpseKey = ""
        if corpses ~= nil then corpseKey = corpses:LeaveCorpse(deathPos, math.floor(expLost * _GameData.deathExpRecover), keepGear) end
        _GameEvents:Emit("PlayerDied", { player = self.Entity, map = self.Entity.CurrentMap, cause = self.LastHitSource })
        -- 파티 구출 (기획서 39 #12A · 10-29): 같은 맵에 살아 있는 파티원이 있으면 바로 마을로 보내지 않고 구출을 기다린다
        -- (일으키면 ReviveInPlace, 시간이 지나거나 「마을에서 부활」이면 PartyRescue가 Revive(false)). 결투 패배는 제외
        local rescue = not inDuel and _PartyRescue:BeginDown(self.Entity)
        local wait = rescue and _GameData.rescueWaitSec or pc.RespawnDuration
        local hint = corpseKey ~= "" and self:CorpseHint(deathMap, deathPos) or ""
        log(string.format("[VRF] death band uid=%s gold=%d exp=%d keepGear=%s corpse=%s rescue=%s wait=%.1f hint=%s", pc.UserId, goldLost, expLost, tostring(keepGear), corpseKey ~= "" and "yes" or "no", tostring(rescue), wait, hint))
        self:NotifyDeath(goldLost, expLost, inDuel, keepGear, hint, wait, rescue, self:TownName(), pc.UserId)
        if rescue then return end
        _TimerService:SetTimerOnce(function() self:Revive(false) end, pc.RespawnDuration)
    end

    @ExecSpace("ServerOnly")
    method boolean KeepsGear()
        -- 11-04 M-1: 노말 난이도 · 캐릭터 레벨 < corpseKeepGearBelowLv (0 = 끔)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or _GameData.corpseKeepGearBelowLv <= 0 then return false end
        local diff = isvalid(self.Entity.CurrentMap) and _GameConst:DifficultyOfMap(self.Entity.CurrentMap.Name) or stats.Difficulty
        return stats.Difficulty == 0 and diff == 0 and stats.Level < _GameData.corpseKeepGearBelowLv
    end

    method string ShortMapName(string mapName)
        -- 맵 표시 이름에서 「(Lv 1~3)」 같은 괄호를 뗀다
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(mapName))
        local name = info ~= nil and info.name or mapName
        return (string.gsub(name, "%s*%(.-%)", ""))
    end

    method string TownName()
        -- 부활할 마을 이름 (사망 띠 「N초 뒤 잿불 야영지에서 일어납니다」)
        ---@type PlayerTravel
        local travel = self.Entity:GetComponent("script.PlayerTravel")
        if travel == nil then return "야영지" end
        return self:ShortMapName(travel:TownMap())
    end

    method string CorpseHint(Entity map, Vector2 pos)
        -- 시체 위치 안내: 「피 묻은 황무지 · 잿불 야영지 문에서 동쪽 14칸」 (그 맵에서 가장 가까운 포털 기준 8방향 · 위 = 북)
        if not isvalid(map) then return "" end
        local text = self:ShortMapName(map.Name)
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        if info == nil then return text end
        local best, bestD = nil, 1e9
        for _, f in ipairs(info.features) do
            if f.kind == "portal" then
                local d = (Vector2(f.x, f.y) - pos):Magnitude()
                if d < bestD then best, bestD = f, d end
            end
        end
        if best == nil then return text end
        local gate = (string.gsub(best.label or "", "%s*%(.-%)", ""))
        if bestD < 3 then return text .. " · " .. gate .. " 문 옆" end
        local v = pos - Vector2(best.x, best.y)
        local dirs = { "동쪽", "북동쪽", "북쪽", "북서쪽", "서쪽", "남서쪽", "남쪽", "남동쪽" }
        local a = math.atan(v.y, v.x)
        local i = math.floor((a / (2 * math.pi)) * 8 + 0.5) % 8 + 1
        return text .. " · " .. gate .. " 문에서 " .. dirs[i] .. " " .. tostring(math.floor(bestD + 0.5)) .. "칸"
    end

    @ExecSpace("ServerOnly")
    method void ReviveInPlace(Vector2 pos, number hpPct)
        -- 파티 구출로 쓰러진 자리에서 일어난다: 부활 위치를 그 자리로 잠깐 바꿔 Respawn → 시체 회수 → 생명 hpPct · 부활 무적. 마을로 보내지 않는다
        if not isvalid(self.Entity) or not self.Dying then return end
        local pc = self.Entity.PlayerComponent
        local keep = pc.RespawnPosition
        pc.RespawnPosition = Vector3(pos.x, pos.y, 0)
        pc:Respawn()
        -- 엔진이 다음 프레임에 부활 위치를 읽어도 되게 1초 뒤 되돌린다 (평소 사망은 Respawn 뒤 마을로 옮기므로 기본값이어야 한다)
        _TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self.Entity.PlayerComponent.RespawnPosition = keep end end, 1)
        self:PrepareHitState(pc.UserId)
        self.Dying = false
        self.Downed = false
        self.InvincibleUntil = _UtilLogic.ElapsedSeconds + self.RespawnInvincible
        -- 그 자리 시체(장비 · 되찾을 경험치)를 함께 회수 — 장비가 돌아와 최대 생명이 바뀐 뒤에 생명을 정한다
        ---@type PlayerCorpses
        local corpses = self.Entity:GetComponent("script.PlayerCorpses")
        local recovered = corpses ~= nil and corpses:RecoverAt(pos, 2.0)
        pc.Hp = math.max(1, math.floor(pc.MaxHp * hpPct))
        log("[VRF] rescue revive uid=" .. pc.UserId .. " hp=" .. tostring(pc.Hp) .. "/" .. tostring(pc.MaxHp) .. " corpse=" .. tostring(recovered))
    end

    @ExecSpace("ServerOnly")
    method integer DropDuelGold(string winnerUserId)
        -- 결투 패배: 골드 duelGoldDropPct%를 쓰러진 자리에 떨군다. 이긴 사람만 줍는다 (이긴 사람이 맵에 없으면 떨구지 않는다)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local winner = _UserService:GetUserEntityByUserId(winnerUserId)
        if stats == nil or not isvalid(winner) or winner.CurrentMap ~= self.Entity.CurrentMap then return 0 end
        local amount = math.floor(stats.Gold * _GameData.duelGoldDropPct / 100)
        if amount <= 0 then return 0 end
        stats:AddGold(-amount)
        _LootSystem:Spawn(_Util:Pos2(self.Entity), winnerUserId, "gold", "", amount, 0)
        log("[VRF] duel gold drop " .. tostring(amount) .. " → " .. winnerUserId)
        return amount
    end

    @ExecSpace("ServerOnly")
    method table ApplyDeathPenalty()
        -- 반환 { gold, exp } (메이커는 다중 반환 선언을 등록하지 않는다)
        -- 골드: 레벨%(최대 deathGoldPctCap) / 경험치: 난이도별 비율
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return { gold = 0, exp = 0 } end
        local goldLost = math.floor(stats.Gold * math.min(stats.Level, _GameData.deathGoldPctCap) / 100)
        stats:AddGold(-goldLost)
        local expLost = stats:LoseExp(_GameConst:DeathExpLossPct(stats.Difficulty))
        return { gold = goldLost, exp = expLost }
    end

    @ExecSpace("ServerOnly")
    method void Revive(boolean inPlace)
        if not isvalid(self.Entity) then return end
        local pc = self.Entity.PlayerComponent
        pc:Respawn()
        self:PrepareHitState(pc.UserId)
        pc.Hp = pc.MaxHp
        self.Dying = false
        self.Downed = false
        self.InvincibleUntil = _UtilLogic.ElapsedSeconds + self.RespawnInvincible
        if inPlace then return end
        ---@type PlayerTravel
        local travel = self.Entity:GetComponent("script.PlayerTravel")
        if travel ~= nil then travel:GoTown() end
    end

    @ExecSpace("Client")
    method void NotifyDepthEnd(integer floor)
        _NoticeFeed:Push("심연 " .. tostring(floor) .. "층에서 쓰러졌습니다 — 도전이 끝났습니다 (사망 벌칙 없음, 주운 것은 남습니다)")
        _UXFeedback:Show("심연 도전 끝 · " .. tostring(floor) .. "층", "쓰러지면 그 도전이 끝납니다 · 사망 벌칙 없음 · 다시 들어가려면 심연 열쇠", _GameData:GetUiIcon("abyss_key"))
    end

    @ExecSpace("Client")
    method void NotifyDeath(integer goldLost, integer expLost, boolean inDuel, boolean keptGear, string corpseHint, number waitSec, boolean rescue, string townName)
        -- 알림 줄 한 줄 + 사망 띠 (11-04 M-2: 화면 가운데 아래 · 잃은 것 · 시체 위치 · 부활까지 남은 초)
        local gear = keptGear and "장비는 그대로입니다" or "장비는 시체에 남았습니다"
        local corpse = corpseHint ~= "" and ("시체 위치: " .. corpseHint .. " · 미니맵 「내 시체」") or ""
        if inDuel then
            _NoticeFeed:Push("결투에서 패배했습니다. 골드 " .. tostring(goldLost) .. "을(를) 떨어뜨렸습니다. " .. gear)
            _HudMain:ShowDeathBand("결투에서 패배했습니다", "골드 " .. tostring(goldLost) .. " 떨어뜨림 · " .. gear, corpse, townName, waitSec, false)
            return
        end
        local text = "사망했습니다. 골드 " .. tostring(goldLost) .. " 손실. " .. gear
        local body = "골드 " .. tostring(goldLost) .. " 손실 · " .. gear
        if expLost > 0 then
            text = text .. " (경험치 " .. tostring(expLost) .. " 손실, 시체를 찾으면 75% 회복)"
            body = body .. " · 경험치 " .. tostring(expLost) .. " 손실 (시체를 찾으면 75% 회복)"
        end
        _NoticeFeed:Push(text)
        _HudMain:ShowDeathBand("사망했습니다", body, corpse, townName, waitSec, rescue)
    end

end
