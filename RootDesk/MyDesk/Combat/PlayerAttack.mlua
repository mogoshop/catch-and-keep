-- 플레이어 기본 공격. 공격 키(Ctrl)·클릭·모바일 공격 버튼으로 가까운 적 쪽(없으면 바라보는 쪽) 사각 범위를 친다.
-- 기본 피해 12: 같은 레벨 일반 몬스터가 2~4대에 쓰러지는 D2 감각 (25는 한 방이었다).
-- 탑다운 맵이라 위아래 깊이(y)도 넉넉하게 잡는다.
-- 네크로맨서 스킬(골편 투척 등)은 Phase 1에서 이 자리를 대체한다.
@Component
script PlayerAttack extends AttackComponent

    property integer Damage = 12
    property Vector2 RangeSize = Vector2(1.6, 1.4)
    property number RangeOffsetX = 0.7
    property number AimRange = 1.7            -- 자동 조준: 이 거리 안 가장 가까운 적 쪽으로 친다
    property number Windup = 0.16              -- 누른 뒤 판정까지 (아바타 휘두르기와 맞춘다)
    property number SkillDamage = 0           -- SkillBook이 판정 직전에 넣는 스킬 피해
    property Entity SelectedTarget = nil       -- PC가 고른 적. 가까운 다른 적으로 바꾸지 않는다
    property Entity AutoTarget = nil           -- 자동 조준도 공격마다 흔들리지 않게 유지
    property integer AttackEpoch = 0
    property number LastAttackAt = -99
    @Sync
    property string AttackPhase = "idle"
    property number ReadyAt = 0
    property boolean BufferedAttack = false
    property number InputBufferSeconds = 0.12
    property number InterruptedUntil = 0
    property integer StrikeCount = 0
    property boolean DebugCombat = false
    property integer SwingTimer = 0
    property integer ReadyTimer = 0
    property integer PhaseTimer = 0
    property boolean ReplayNextSwing = false
    property number ContactPauseUntil = 0
    property number NextContactPauseAt = 0
    property number ContactRestoreRate = 1
    property Entity OnlyTarget = nil          -- SkillHitOne 판정 중에만: 이 대상 말고는 맞지 않는다

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandlePlayerActionEvent(PlayerActionEvent event)
        -- 서버에서만 판정한다 (이벤트는 서버·클라이언트 양쪽에서 온다)
        if event.ActionName ~= "Attack" then return end
        self:DoAttack()
    end

    @ExecSpace("ServerOnly")
    method void DoAttack()
        -- 공격 속도(ias)로 줄어든 간격보다 빨리 오면 무시 (연타 방지). 마을에서는 공격하지 않는다 (D2)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local interval = _GameData.baseAttackInterval
        if stats ~= nil then interval = stats:GetAttackInterval(interval) end
        if _GameConst:IsTown(self.Entity.CurrentMap) then return end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.InterruptedUntil then return end
        if now < self.ReadyAt then
            -- 회복 끝 120ms 안의 한 입력만 예약한다. 연타가 무한 대기열을 만들지 않는다.
            if self.ReadyAt - now <= self.InputBufferSeconds then self.BufferedAttack = true end
            return
        end
        if not _Util:IsAlive(self.Entity) then return end
        local me = _Util:Pos2(self.Entity)
        local dir = Vector2(self.Entity.PlayerControllerComponent.LookDirectionX >= 0 and 1 or -1, 0)
        local target = self:ResolveTarget()
        -- 선택한 적이 아직 멀면 접근을 기다린다. 옆의 다른 적을 치지 않는다.
        if isvalid(self.SelectedTarget) and target == nil then return end
        self.LastAttackAt = now
        if isvalid(target) then
            local to = _Util:Pos2(target) - me
            if to:Magnitude() > 0.05 then dir = to:Normalize() end
            if math.abs(dir.x) > 0.05 then self.Entity.PlayerControllerComponent.LookDirectionX = dir.x >= 0 and 1 or -1 end
        end
        -- 공격 속도에 맞춰 준비/타격/회복을 함께 축소한다. 준비 중 이동하면 공격을 취소한다.
        self.AttackEpoch = self.AttackEpoch + 1
        self.BufferedAttack = false
        self.ReadyAt = now + interval
        self.AttackPhase = "windup"
        local replay = self.ReplayNextSwing
        self.ReplayNextSwing = false
        self:PresentAcceptedSwing(dir, interval, replay, self.Entity.PlayerComponent.UserId)
        local aimDir = dir
        local epoch = self.AttackEpoch
        local map = self.Entity.CurrentMap
        local origin = me
        local contact = math.min(interval * 0.5, self.Windup * interval / _GameData.baseAttackInterval)
        if self.DebugCombat then log("[VRF-COMBAT] player windup epoch=" .. tostring(epoch)) end
        self.SwingTimer = _TimerService:SetTimerOnce(function()
            self.SwingTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or self.Entity.CurrentMap ~= map or not _Util:IsAlive(self.Entity) then return end
            if (_Util:Pos2(self.Entity) - origin):Magnitude() > 0.18 then
                self.AttackPhase = "recovery"
                return
            end
            self.AttackPhase = "active"
            self.StrikeCount = self.StrikeCount + 1
            self:Strike(aimDir)
            if self.DebugCombat then log("[VRF-COMBAT] player active epoch=" .. tostring(epoch)) end
            self.PhaseTimer = _TimerService:SetTimerOnce(function()
                self.PhaseTimer = 0
                if epoch == self.AttackEpoch then self.AttackPhase = "recovery" end
            end, math.min(0.05, interval * 0.15))
        end, contact)
        self.ReadyTimer = _TimerService:SetTimerOnce(function()
            self.ReadyTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or self.Entity.CurrentMap ~= map then return end
            self.AttackPhase = "idle"
            -- 타이머의 소수점 오차 때문에 예약 입력만 남고 다음 타이머가 사라지지 않게 한다.
            self.ReadyAt = math.min(self.ReadyAt, _UtilLogic.ElapsedSeconds)
            if self.BufferedAttack then
                self.BufferedAttack = false
                self.ReplayNextSwing = true
                self:DoAttack()
                self.ReplayNextSwing = false
            end
        end, interval)
    end

    @ExecSpace("ServerOnly")
    method void CancelAttack()
        -- 이동·사망에서는 대상/예약/판정을 모두 버린다.
        self:InterruptSwing(0)
        self.ReadyAt = 0
        self.SelectedTarget = nil
        self.AutoTarget = nil
    end

    @ExecSpace("ServerOnly")
    method void InterruptSwing(number seconds)
        -- 피격 중단은 선택 대상을 보존하되, 이전 준비 동작과 입력 예약은 되살리지 않는다.
        self.AttackEpoch = self.AttackEpoch + 1
        self.BufferedAttack = false
        self.ReplayNextSwing = false
        if self.SwingTimer ~= 0 then _TimerService:ClearTimer(self.SwingTimer) self.SwingTimer = 0 end
        if self.ReadyTimer ~= 0 then _TimerService:ClearTimer(self.ReadyTimer) self.ReadyTimer = 0 end
        if self.PhaseTimer ~= 0 then _TimerService:ClearTimer(self.PhaseTimer) self.PhaseTimer = 0 end
        self.InterruptedUntil = _UtilLogic.ElapsedSeconds + math.max(0, seconds)
        self.ReadyAt = math.max(self.ReadyAt, self.InterruptedUntil)
        self.AttackPhase = "idle"
    end

    method void OnEndPlay()
        -- 양쪽 수명 종료: 서버는 판정, 클라이언트는 로컬 타격 정지를 복구한다.
        if self:IsServer() then self:CancelAttack() else self:ReleaseContactPause() end
    end

    @ExecSpace("Client")
    method void PresentAcceptedSwing(Vector2 dir, number interval, boolean replay)
        -- 예약으로 시작된 공격도 실제 아바타 모션을 재생한다. 피해 이벤트는 다시 내보내지 않는다.
        if self.Entity ~= _UserService.LocalPlayer or not _Util:IsAlive(self.Entity) then return end
        local controller = self.Entity.PlayerControllerComponent
        if math.abs(dir.x) > 0.05 then controller.LookDirectionX = dir.x >= 0 and 1 or -1 end
        local rate = 1.33 * _GameData.baseAttackInterval / math.max(0.1, interval)
        local animations = self.Entity.AvatarStateAnimationComponent
        if isvalid(animations) then animations.StateToAvatarBodyActionSheet["ATTACK"] = AvatarBodyActionElement("attack", rate) end
        if replay then
            self.Entity.StateComponent:ChangeState("ATTACK")
            self.Entity:SendEvent(BodyActionStateChangeEvent(true, MapleAvatarBodyActionState.Attack, 0, 2147483647, rate))
        end
        if self.DebugCombat then log("[VRF-COMBAT] accepted motion replay=" .. tostring(replay) .. " rate=" .. tostring(rate)) end
    end

    @ExecSpace("ClientOnly")
    method void ContactPause(boolean heavy)
        -- 공격자 자신의 아바타만 짧게 멈춘다. 이동/판정/다른 유저의 시간은 바꾸지 않는다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local avatar = self.Entity.AvatarRendererComponent
        local now = _UtilLogic.ElapsedSeconds
        if not isvalid(avatar) or now < self.NextContactPauseAt or self.ContactPauseUntil > 0 then return end
        self.ContactRestoreRate = avatar.PlayRate
        self.ContactPauseUntil = now + (heavy and 0.045 or 0.025)
        self.NextContactPauseAt = now + 0.16
        avatar.PlayRate = 0
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 타격 정지는 반복 명중으로 연장하지 않으며 이동/사망/맵 이탈에서도 해제한다.
        if self.ContactPauseUntil > 0 and (_UtilLogic.ElapsedSeconds >= self.ContactPauseUntil or not _Util:IsAlive(self.Entity)) then self:ReleaseContactPause() end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleMapChanged(EntityMapChangedEvent event)
        -- 이전 맵의 접촉 정지를 다음 맵으로 가져가지 않는다.
        self:ReleaseContactPause()
    end

    @ExecSpace("ClientOnly")
    method void ReleaseContactPause()
        -- 다른 상태 전환이 이미 속도를 바꿨다면 덮어쓰지 않는다.
        local avatar = self.Entity.AvatarRendererComponent
        if self.ContactPauseUntil > 0 and isvalid(avatar) and avatar.PlayRate == 0 then avatar.PlayRate = self.ContactRestoreRate end
        self.ContactPauseUntil = 0
    end

    @ExecSpace("Server")
    method void RequestSelectTarget(Entity target)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        self:SetSelectedTarget(target)
    end

    @ExecSpace("ServerOnly")
    method void SetSelectedTarget(Entity target)
        if target ~= nil and (not self:IsLiveMonster(target) or _Util:Distance(self.Entity, target) > 24) then return end
        self.SelectedTarget = target
        self.AutoTarget = nil
    end

    method boolean IsLiveMonster(Entity target)
        if not isvalid(target) or not target.Enable or target.CurrentMap ~= self.Entity.CurrentMap then return false end
        ---@type Monster
        local monster = target:GetComponent("script.Monster")
        return monster ~= nil and not monster.IsDead and monster.Hp > 0
    end

    method boolean CanReach(Entity target)
        return isvalid(target) and _Util:Distance(self.Entity, target) <= self.AimRange
            and _Util:HasLineOfSight(self.Entity.CurrentMap, _Util:Pos2(self.Entity), _Util:Pos2(target))
    end

    @ExecSpace("ServerOnly")
    method Entity ResolveTarget()
        if self.SelectedTarget ~= nil then
            if self:IsLiveMonster(self.SelectedTarget) then
                if self:CanReach(self.SelectedTarget) then return self.SelectedTarget end
                return nil
            end
            self.SelectedTarget = nil
        end
        if self:IsLiveMonster(self.AutoTarget) and self:CanReach(self.AutoTarget) then return self.AutoTarget end
        self.AutoTarget = nil
        local me = _Util:Pos2(self.Entity)
        local facing = self.Entity.PlayerControllerComponent.LookDirectionX >= 0 and 1 or -1
        -- 키보드·모바일은 바라보는 반원 안에서 고른다. 뒤의 적 때문에 갑자기 돌아서지 않는다.
        for _, monster in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, me, self.AimRange)) do
            if (_Util:Pos2(monster.Entity).x - me.x) * facing >= -0.1 and self:CanReach(monster.Entity) then
                self.AutoTarget = monster.Entity
                return self.AutoTarget
            end
        end
        return nil
    end

    @ExecSpace("ServerOnly")
    method void Strike(Vector2 dir)
        -- 실제 판정: 조준 방향 앞 사각 범위 (방향으로 회전)
        if not isvalid(self.Entity) or self.Entity.PlayerComponent.Hp <= 0 then return end
        local me = _Util:Pos2(self.Entity)
        local center = me + Vector2(0, 0.2) + dir * self.RangeOffsetX
        local angle = math.deg(math.atan(dir.y, dir.x))
        self:AttackFast(BoxShape(center, self.RangeSize, angle), "player.basic", nil)
        self:PlaySwing(Vector3(center.x, center.y, 0), dir)
    end

    @ExecSpace("ServerOnly")
    method void SkillAttack(Vector2 center, Vector2 size, number angle, string info, number damage)
        -- SkillBook 스킬 판정 (info = "skill.*"). angle < 0 이면 원(반지름 size.x)
        self.SkillDamage = damage
        if angle < 0 then
            self:AttackFast(CircleShape(center, size.x), info, nil)
        else
            self:AttackFast(BoxShape(center, size, angle), info, nil)
        end
    end

    @ExecSpace("ServerOnly")
    method void SkillHitOne(Entity target, string info, number damage)
        -- 투사체처럼 대상 하나만 맞히는 스킬 판정 (같은 자리에 겹친 다른 몬스터는 제외)
        if not isvalid(target) then return end
        self.SkillDamage = damage
        self.OnlyTarget = target
        local q = target.TransformComponent.WorldPosition
        self:AttackFast(CircleShape(Vector2(q.x, q.y + 0.3), 0.6), info, nil)
        self.OnlyTarget = nil
    end

    method string SkillElement(string attackInfo)
        if attackInfo == "skill.corpse_blast" then return "fire" end
        return "magic"
    end

    method number ResistFactor(Entity defender, Monster monster, string element)
        -- 1 - 저항/100 (면역 100 이상이면 0)
        local res = 0
        if monster ~= nil then
            res = monster:GetResist(element)
        elseif isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local ds = defender:GetComponent("script.PlayerStats")
            if ds ~= nil then res = ds:GetResist(element) end
        end
        return math.max(0, 1 - res / 100)
    end

    method void OnAttack(Entity defender)
        -- 냉기 피해가 있으면 맞은 몬스터를 둔화 (D2 냉기)
        if not self:IsServer() then return end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or stats:GetElemDamage("cold") <= 0 then return end
        ---@type Monster
        local monster = defender:GetComponent("script.Monster")
        if monster ~= nil then monster:ApplyChill(2) end
    end

    @ExecSpace("Multicast")
    method void PlaySwing(Vector3 pos, Vector2 dir)
        -- 휘두르기 궤적(리소스가 왼쪽을 본다: 오른쪽이면 뒤집고, 위아래로는 기울인다) + 휘두르는 소리. 맞는 소리는 몬스터 쪽(HitFx)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayCombat(_GameConst.SfxSwing, pos, 0.35, self.Entity == me and 1 or 0)
        local right = dir.x >= 0
        local rot = math.deg(math.atan(dir.y, dir.x))
        if not right then rot = rot - 180 end
        if rot > 180 then rot = rot - 360 elseif rot < -180 then rot = rot + 360 end
        _EffectService:PlayEffect(_GameConst.FxSlash, self.Entity, Vector3(pos.x, pos.y + 0.3, 0), rot, Vector3(0.55, 0.55, 1), false, { FlipX = right, PlayRate = 1.5, Color = Color(0.75, 0.7, 1, 0.9) })
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- 기본 피해 × 힘·장비 보정 (스킬은 SkillDamage), 저주(약화의 낙인) 등 대상 배율 적용
        -- 속성: 스킬은 스킬 고유 속성, 기본 공격은 물리 + 장비 무기 속성 피해. 각각 대상 저항으로 줄인다
        local dmg = self.Damage
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        ---@type Monster
        local monster = defender:GetComponent("script.Monster")
        if string.sub(attackInfo, 1, 6) == "skill." then
            dmg = self.SkillDamage * self:ResistFactor(defender, monster, self:SkillElement(attackInfo))
        else
            if stats ~= nil then dmg = stats:GetMeleeDamage(self.Damage) end
            dmg = dmg * self:ResistFactor(defender, monster, "phys")
            if stats ~= nil then
                for _, e in ipairs({ "fire", "cold", "light", "poison" }) do
                    local v = stats:GetElemDamage(e)
                    if v > 0 then dmg = dmg + v * self:ResistFactor(defender, monster, e) end
                end
            end
        end
        if monster ~= nil then dmg = dmg * monster:GetDamageTakenMultiplier() end
        -- 결투(PvP): 플레이어 대상 피해는 1/4 (D2도 PvP 피해를 크게 줄인다)
        if isvalid(defender.PlayerComponent) then dmg = dmg * 0.25 end
        local final = math.max(1, math.floor(dmg + 0.5))
        -- 생명력 흡수 (룬 드락, 룬워드 「검은 서약」)
        if self:IsServer() and stats ~= nil and stats.BonusLeech > 0 then
            local pc = self.Entity.PlayerComponent
            if pc.Hp > 0 then pc.Hp = math.min(pc.MaxHp, pc.Hp + math.max(1, math.floor(final * stats.BonusLeech / 100))) end
        end
        return final
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 그림자·이미 죽은 몬스터는 제외. 플레이어는 결투 중인 상대만
        if isvalid(defender.PlayerComponent) then
            if defender == self.Entity then return false end
            ---@type PlayerDuel
            local duel = self.Entity:GetComponent("script.PlayerDuel")
            if duel == nil or not duel:IsOpponent(defender) then return false end
            -- 무적 시간·사망 처리 중이면 제외 (엔진이 맞자마자 생명을 깎으므로 여기서 막아야 한다)
            ---@type PlayerVitals
            local vitals = defender:GetComponent("script.PlayerVitals")
            if vitals ~= nil and not vitals:CanBeHit() then return false end
            return __base:IsAttackTarget(defender, attackInfo)
        end
        if attackInfo == "player.basic" and not _Util:HasLineOfSight(self.Entity.CurrentMap, _Util:Pos2(self.Entity), _Util:Pos2(defender)) then return false end
        if defender:GetComponent("script.ShadowUnit") ~= nil then return false end
        if self.OnlyTarget ~= nil and defender ~= self.OnlyTarget then return false end
        ---@type Monster
        local monster = defender:GetComponent("script.Monster")
        if monster ~= nil and monster.IsDead then return false end
        return __base:IsAttackTarget(defender, attackInfo)
    end

end
