-- 몬스터 반격. 사거리 안의 가장 가까운 플레이어 또는 그림자를 일정 간격으로 때린다.
-- 이동은 AIWander/AIChase가 맡고, 이 컴포넌트는 판정만 한다 (설계 7장: 매 프레임 탐색 금지).
@Component
script MonsterAttack extends AttackComponent

    property integer Damage = 8
    property integer BaseDamage = 0       -- 스포너가 레벨 보정할 때 기준값
    property string Element = ""          -- 공격 속성 (fire/cold/light/poison). 피해 중 ElementRatio만큼이 그 속성
    property number ElementRatio = 0.5
    property number AttackRange = 0.8
    property number AttackRadius = 0.5
    property number AttackCooldown = 1.5
    property number ScanInterval = 0.4

    property number CooldownTimer = 0
    property number ScanTimer = 0
    property Entity CurrentTarget = nil   -- 단일 대상 공격: 범위 안이라도 이 대상만 맞는다
    property number SlamDamage = 0        -- 보스 광역기 피해 (0이면 일반 공격)

    @ExecSpace("ServerOnly")
    method void Slam(Vector2 center, number radius, number damage)
        -- 보스 패턴용 원형 광역 공격 (단일 대상 제한 없음)
        self.SlamDamage = damage
        self.CurrentTarget = nil
        self:AttackFast(CircleShape(center, radius), "monster.slam", nil)
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- 살아 있을 때만, ScanInterval마다 대상 탐색
        ---@type ShadowMonster
        local monster = self.Entity:GetComponent("script.ShadowMonster")
        if monster == nil or monster.IsDead or not self.Entity.Enable then return end
        self.CooldownTimer = self.CooldownTimer - delta
        self.ScanTimer = self.ScanTimer - delta
        if self.CooldownTimer > 0 or self.ScanTimer > 0 then return end
        self.ScanTimer = self.ScanInterval
        local target = self:FindTarget()
        if target == nil then return end
        self.CooldownTimer = self.AttackCooldown
        self.CurrentTarget = target
        local p = target.TransformComponent.WorldPosition
        self:AttackFast(CircleShape(Vector2(p.x, p.y + 0.3), self.AttackRadius), "monster.basic", nil)
    end

    @ExecSpace("ServerOnly")
    method Entity FindTarget()
        -- 사거리 안의 가장 가까운 플레이어·그림자
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return nil end
        local m = self.Entity.TransformComponent.WorldPosition
        local myPos = Vector2(m.x, m.y)
        local best = nil
        local bestDist = self.AttackRange
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users ~= nil then
            for _, u in ipairs(users) do
                if isvalid(u) and not u.PlayerComponent:IsDead() then
                    local q = u.TransformComponent.WorldPosition
                    local d = (Vector2(q.x, q.y) - myPos):Magnitude()
                    if d < bestDist then bestDist = d best = u end
                end
            end
        end
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            local q = c.Entity.TransformComponent.WorldPosition
            local d = (Vector2(q.x, q.y) - myPos):Magnitude()
            if d < bestDist then bestDist = d best = c.Entity end
        end
        return best
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- 쇠약 저주가 걸려 있으면 피해 감소. 플레이어 방어(장비)는 받는 쪽에서 줄인다
        local dmg = self.Damage
        if attackInfo == "monster.slam" then dmg = self.SlamDamage end
        ---@type ShadowMonster
        local monster = self.Entity:GetComponent("script.ShadowMonster")
        if monster ~= nil then dmg = dmg * monster:GetDamageDealtMultiplier() end
        if isvalid(defender.PlayerComponent) then
            -- 물리 부분은 방어로, 속성 부분은 저항으로 줄인다. 정예 인챈트는 같은 속성 피해 +50%
            ---@type PlayerStats
            local stats = defender:GetComponent("script.PlayerStats")
            local element = self:GetElement(monster)
            local ratio = 0
            if element ~= "" then ratio = self.ElementRatio end
            if monster ~= nil and monster.AffixElement ~= "" then ratio = math.min(1, ratio + 0.5) end
            local phys = dmg * (1 - ratio)
            local elem = dmg * ratio
            if stats ~= nil then
                phys = phys * (100 / (100 + stats.BonusDefense))
                elem = elem * math.max(0, 1 - stats:GetResist(element) / 100)
            end
            dmg = phys + elem
        end
        return math.max(1, math.floor(dmg + 0.5))
    end

    method string GetElement(ShadowMonster monster)
        if monster ~= nil and monster.AffixElement ~= "" then return monster.AffixElement end
        return self.Element
    end

    method void OnAttack(Entity defender)
        -- 냉기 공격은 플레이어를 잠시 둔화 / 특수 행동(치고 빠지기)에 알림
        if not self:IsServer() then return end
        ---@type ShadowMonster
        local monster = self.Entity:GetComponent("script.ShadowMonster")
        if self:GetElement(monster) == "cold" and isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local stats = defender:GetComponent("script.PlayerStats")
            if stats ~= nil then stats:ApplyChill(1.5) end
        end
        ---@type MonsterBehavior
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil then behavior:OnAttacked(defender) end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 고른 대상 하나만 (광역기는 범위 전체). 플레이어(살아 있음)와 그림자만 대상이 될 수 있다
        if attackInfo ~= "monster.slam" and defender ~= self.CurrentTarget then return false end
        if isvalid(defender.PlayerComponent) then
            if defender.PlayerComponent:IsDead() then return false end
            return __base:IsAttackTarget(defender, attackInfo)
        end
        if defender:GetComponent("script.ShadowUnit") ~= nil then
            return __base:IsAttackTarget(defender, attackInfo)
        end
        return false
    end

end
