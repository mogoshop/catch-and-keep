-- 몬스터 특수 행동 (06장 4절 AI 유형). Mode:
--   "hitrun" : 공격 직후 잠시 대상에게서 물러났다가 다시 덤빈다 (시체 까마귀)
--   "burrow" : 플레이어가 가까이 올 때까지 땅속에 숨어 있다(희미하게 보이고 맞지 않음). 오래 혼자면 다시 숨는다 (무덤 구더기)
--   "coward" : 근처 같은 종족이 죽으면 잠시 흩어져 달아났다가 다시 덤빈다 (D2 폴른 — 타락 꼬마악마)
--   "ranged" : 사거리 끝에 멈춰 쏘고, 너무 가까우면 물러선다 (D2 다크 레인저 — 광신 궁수)
--   "phase"  : 주기적으로 반투명해져 받는 피해 -50% (모래 망령). 반투명 PhaseSeconds · 실체 SolidSeconds
-- 이동은 AIChase가 맡고, 이 컴포넌트는 AIChase를 잠시 끄고 직접 움직인다.
@Component
script MonsterBehavior extends Component

    property string Mode = "hitrun"
    property number RetreatSeconds = 0.9
    property number EmergeRange = 2.2
    property number ReburrowSeconds = 8
    property number CheckInterval = 0.3
    property number FleeSeconds = 2.2
    property number FleeRadius = 5
    property number KeepRange = 1.8
    property number RangedRetreatSeconds = 0.65
    property number RangedRetreatCooldown = 2.8
    property number RetreatReadyAt = 0
    property number EmergeUntil = 0
    property number EmergeSeconds = 0.55
    property number RetreatCheckAt = 0
    property Vector2 RetreatCheckPos = Vector2(0, 0)
    property Entity RangeTarget = nil

    @Sync
    property boolean Burrowed = false
    @Sync
    property boolean Phased = false          -- phase: 반투명 (받는 피해 -50%)
    property number PhaseSeconds = 2.5
    property number SolidSeconds = 4.5
    property number PhaseNextAt = 0
    property number AppliedAlpha = 1
    property number RetreatUntil = 0
    property Vector2 RetreatDir = Vector2(0, 0)
    property number LonelySince = 0
    property number CheckTimer = 0
    property boolean AppliedBurrow = false

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        if self.Mode == "burrow" then self:SetBurrowed(true) end
    end

    @ExecSpace("ServerOnly")
    method void OnAttacked(Entity target)
        -- MonsterAttack이 공격 직후 부른다
        if self.Mode ~= "hitrun" or not isvalid(target) then return end
        local p = self.Entity.TransformComponent.WorldPosition
        local q = target.TransformComponent.WorldPosition
        local away = Vector2(p.x - q.x, p.y - q.y)
        if away:Magnitude() < 0.01 then away = Vector2(1, 0) end
        self.RetreatDir = away:Normalize()
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        local ready = attack ~= nil and attack.AttackAnimationUntil or 0
        self.RetreatUntil = math.max(_UtilLogic.ElapsedSeconds, ready) + self.RetreatSeconds
        self:TrackRetreat()
        self.RetreatCheckAt = math.max(_UtilLogic.ElapsedSeconds, ready)
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.Enable = false end
    end

    method void OnUpdate(number delta)
        -- 서버: 행동 판단 / 클라이언트: 숨은 상태 표시
        if self:IsServer() then self:ServerTick(delta) else self:ClientTick() end
    end

    @ExecSpace("ServerOnly")
    method void ServerTick(number delta)
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil or monster.IsDead or not self.Entity.Enable then return end
        local status = monster:Status()
        if status ~= nil and (status:IsStunned() or status:IsConfused()) then return end   -- 혼란 중 이동은 MonsterStatus가 맡는다
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil and _UtilLogic.ElapsedSeconds < attack.AttackAnimationUntil then return end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.EmergeUntil then
            self:DriveMotion(Vector2(0, 0))
            return
        end
        if self.RetreatUntil > 0 then
            if now < self.RetreatUntil and self:RetreatPathOpen(self.RetreatDir) then
                -- 실제로 벽에 막혔으면 같은 방향으로 계속 달리지 않는다.
                if now - self.RetreatCheckAt >= 0.25 then
                    local moved = (_Util:Pos2(self.Entity) - self.RetreatCheckPos):Magnitude()
                    self:TrackRetreat()
                    if moved < 0.03 then self:EndRetreat() return end
                end
                self:DriveMotion(self.RetreatDir)
            else
                self:EndRetreat()
            end
            return
        end
        if self.Mode == "phase" then
            self:PhaseTick(now)
            return
        end
        if self.Mode == "burrow" and not self.Burrowed then
            self:ResumeMovement()
        end
        if self.Mode ~= "burrow" and self.Mode ~= "ranged" then return end
        self.CheckTimer = self.CheckTimer - delta
        if self.CheckTimer > 0 then return end
        self.CheckTimer = self.CheckInterval
        if self.Mode == "ranged" then
            self:RangedTick()
            return
        end
        local near = self:NearestDefenderDistance()
        if self.Burrowed then
            if near <= self.EmergeRange then self:SetBurrowed(false) end
            return
        end
        if near > 4 then
            if self.LonelySince == 0 then self.LonelySince = now end
            if now - self.LonelySince > self.ReburrowSeconds then self:SetBurrowed(true) end
        else
            self.LonelySince = 0
        end
    end

    @ExecSpace("ServerOnly")
    method void PhaseTick(number now)
        -- 모래 망령: 실체 ↔ 반투명을 번갈아 (반투명 동안 받는 피해 -50%, Monster.GetDamageTakenMultiplier)
        if self.PhaseNextAt <= 0 then self.PhaseNextAt = now + self.SolidSeconds * (0.5 + _UtilLogic:RandomDouble()) end
        if now < self.PhaseNextAt then return end
        self.Phased = not self.Phased
        self.PhaseNextAt = now + (self.Phased and self.PhaseSeconds or self.SolidSeconds)
    end

    @ExecSpace("ServerOnly")
    method void RangedTick()
        -- 사격과 거리 유지가 같은 살아 있는 대상(플레이어·소환수)을 본다. 짧게 후퇴한 뒤 반격한다.
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        self.RangeTarget = atk ~= nil and atk:FindTarget() or nil
        local chase = self.Entity.AIChaseComponent
        if not isvalid(self.RangeTarget) then
            if isvalid(chase) then chase.Enable = true end
            return
        end
        if isvalid(chase) then chase.Enable = false end
        local now = _UtilLogic.ElapsedSeconds
        if _Util:Distance(self.RangeTarget, self.Entity) < self.KeepRange and now >= self.RetreatReadyAt then
            local away = _Util:Pos2(self.Entity) - _Util:Pos2(self.RangeTarget)
            if away:Magnitude() < 0.01 then away = Vector2(1, 0) end
            self.RetreatDir = away:Normalize()
            self.RetreatReadyAt = now + self.RangedRetreatCooldown
            if self:RetreatPathOpen(self.RetreatDir) then
                self.RetreatUntil = now + self.RangedRetreatSeconds
                self:TrackRetreat()
                self:DriveMotion(self.RetreatDir)
                return
            end
        end
        self:DriveMotion(Vector2(0, 0))
    end

    @ExecSpace("ServerOnly")
    method void DriveMotion(Vector2 direction)
        -- 네이티브 추적을 잠시 끈 이동도 MOVE 모션을 유지한다. 공격·경직 모션은 덮어쓰지 않는다.
        self.Entity.MovementComponent:MoveToDirection(direction, 0)
        local state = self.Entity.StateComponent
        if not isvalid(state) then return end
        local current = state.CurrentStateName
        if current == "ATTACK" or current == "HIT" or current == "DEAD" then return end
        local nextState = direction:Magnitude() > 0.01 and "MOVE" or "IDLE"
        if current ~= nextState then state:ChangeState(nextState) end
        if math.abs(direction.x) > 0.05 then self.Entity.SpriteRendererComponent.FlipX = direction.x > 0 end
    end

    @ExecSpace("ServerOnly")
    method void TrackRetreat()
        -- 저속 갱신마다 실제 이동량을 비교해 막힌 후퇴를 끝낸다.
        self.RetreatCheckAt = _UtilLogic.ElapsedSeconds
        self.RetreatCheckPos = _Util:Pos2(self.Entity)
    end

    method boolean RetreatPathOpen(Vector2 dir)
        -- 발밑 중심·양옆을 검사한다. 벽·절벽으로 무리하게 후퇴하지 않는다.
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return false end
        local p = _Util:Pos2(self.Entity)
        local side = Vector2(-dir.y, dir.x) * 0.22
        for _, offset in ipairs({ Vector2(0, 0), side, side * -1 }) do
            if not _Util:HasLineOfSight(map, p + offset, p + offset + dir * 0.45) then return false end
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void EndRetreat()
        -- 후퇴 후 즉시 사격/추적으로 돌아간다. 원거리 적은 쿨다운 동안 자리에서 반격할 수 있다.
        self.RetreatUntil = 0
        self:DriveMotion(Vector2(0, 0))
        self:ResumeMovement()
    end

    method boolean CanBeginAttack()
        -- 매복의 출현 준비·도주·후퇴 중에는 공격을 시작하지 않는다.
        local now = _UtilLogic.ElapsedSeconds
        return not self.Burrowed and now >= self.EmergeUntil and now >= self.RetreatUntil
    end

    @ExecSpace("ServerOnly")
    method void ResumeMovement()
        -- 공격 회복/경직 해제도 특수 행동의 이동 소유권을 존중한다.
        local chase = self.Entity.AIChaseComponent
        if not self:CanBeginAttack() then
            if isvalid(chase) then chase.Enable = false end
            return
        end
        if self.Mode == "ranged" then self:RangedTick() return end
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil and attack.SpacingControlled then
            if isvalid(chase) then chase.Enable = false end
            return
        end
        if isvalid(chase) then chase.Enable = true end
    end

    @ExecSpace("ServerOnly")
    method void AlertPack()
        -- 내가 죽었다: 근처의 같은 종족 겁쟁이들이 잠시 흩어진다 (Monster.Die가 부른다)
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        ---@type Monster
        local me = self.Entity:GetComponent("script.Monster")
        if me == nil then return end
        local myPos = _Util:Pos2(self.Entity)
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.MonsterBehavior", true)) do
            ---@type MonsterBehavior
            local other = c
            if other ~= self and other.Mode == "coward" and _Util:Distance(other.Entity, self.Entity) < self.FleeRadius then
                ---@type Monster
                local m = other.Entity:GetComponent("script.Monster")
                if m ~= nil and not m.IsDead and m.SourceId == me.SourceId then other:Flee(myPos) end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void Flee(Vector2 from)
        -- from에서 멀어지는 쪽으로 FleeSeconds 동안 달아난다 (끝나면 hitrun과 같은 길로 다시 추적)
        self:FleeFor(from, self.FleeSeconds)
    end

    @ExecSpace("ServerOnly")
    method void FleeFor(Vector2 from, number seconds)
        -- 공포 저주도 같은 도주를 쓴다. seconds 동안 달아난 뒤 원래 추적으로 돌아간다.
        local p = _Util:Pos2(self.Entity)
        local away = Vector2(p.x - from.x, p.y - from.y)
        if away:Magnitude() < 0.01 then
            local a = _UtilLogic:RandomDouble() * math.pi * 2
            away = Vector2(math.cos(a), math.sin(a))
        end
        self.RetreatDir = away:Normalize()
        self.RetreatUntil = _UtilLogic.ElapsedSeconds + seconds
        self:TrackRetreat()
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil then attack:CancelPending() end
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.Enable = false end
    end

    @ExecSpace("ServerOnly")
    method number NearestDefenderDistance()
        -- 무덤 구더기는 소환수에도 반응하지만 벽 뒤·사망한 대상에는 반응하지 않는다.
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        local target = attack ~= nil and attack:FindDefender(math.max(4.1, self.EmergeRange)) or nil
        if not isvalid(target) then return 999 end
        return _Util:Distance(target, self.Entity)
    end

    @ExecSpace("ServerOnly")
    method void SetBurrowed(boolean value)
        -- 숨으면 맞지 않고(HitComponent 끔) 움직이지 않는다
        self.Burrowed = value
        self.LonelySince = 0
        self.RetreatUntil = 0
        self.EmergeUntil = value and 0 or (_UtilLogic.ElapsedSeconds + self.EmergeSeconds)
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil then attack:CancelPending() end
        local hit = self.Entity.HitComponent
        if isvalid(hit) then hit.Enable = not value end
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.Enable = false end
        if value then
            self:DriveMotion(Vector2(0, 0))
        else
            self:EmergeFx(self.Entity.TransformComponent.WorldPosition)
        end
    end

    @ExecSpace("ServerOnly")
    method void ResetBehavior()
        -- 리스폰은 이전 후퇴·도주·거리 유지 대상을 이어받지 않는다.
        self.RetreatUntil = 0
        self.RetreatReadyAt = 0
        self.EmergeUntil = 0
        self.LonelySince = 0
        self.CheckTimer = 0
        self.RangeTarget = nil
        if self.Mode == "burrow" then self:SetBurrowed(true) end
        self.Phased = false
        self.PhaseNextAt = 0
    end

    @ExecSpace("Multicast")
    method void EmergeFx(Vector3 pos)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        -- 등장 예고는 발밑에서 짧게 끝낸다. 구더기와 주변 적의 실루엣을 가리지 않는다.
        local serial = _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(0.28, 0.1, 1), false, { ParticleCount = 8 })
        if serial ~= 0 then _TimerService:SetTimerOnce(function() _ParticleService:RemoveParticle(serial) end, 0.35) end
    end

    @ExecSpace("ClientOnly")
    method void ClientTick()
        -- 숨은 동안 거의 보이지 않게, 모래 망령은 반투명 동안 흐릿하게
        -- (색조 갱신이 알파를 1로 되돌려도 다시 맞춘다 — 실제 스프라이트 알파와 비교)
        local alpha = self.Burrowed and 0.12 or (self.Phased and 0.35 or 1)
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local c = sprite.Color
        if math.abs(c.a - alpha) < 0.01 then return end
        self.AppliedAlpha = alpha
        self.AppliedBurrow = self.Burrowed
        sprite.Color = Color(c.r, c.g, c.b, alpha)
    end

end
