-- 몬스터 특성: 종족 저항, 정예 수식어(06장 3절 단순화), 변종 능력(오오라·특수 기술), 색조(악마 분위기 재채색).
--   강인한 생명 ×1.7 / 흉포한 피해 ×1.5 / 신속한 속도 ×1.5 / 불꽃·냉기·번개 인챈트 (공격에 속성 + 같은 속성 저항 +50)
--   변종(variants.csv): 변종 우두머리(스포너 variantChance) 또는 최상위·보스 고유(monsters.csv innate). 잡아서 추출하면 그림자가 그대로 쓴다
@Component
script MonsterTraits extends Component

    property string Resists = ""             -- "fire=50,poison=75" (100 이상 = 면역)
    property string Tint = ""                -- "r,g,b"
    @Sync
    property string Affix = ""
    @Sync
    property string AffixElement = ""
    @Sync
    property number NovaWarnSeconds = 1.2     -- 변종 범위 기술 예고 시간 (초속 1.2칸으로 반경 밖으로 걸어 나갈 수 있게)
    property string Variant = ""             -- 변종 능력 id (오오라·특수 기술)
    property number AbilityTimer = 1
    @Sync
    property string TintSync = ""
    property number HpMult = 1
    property number DamageMult = 1
    property number SpeedMult = 1
    property table ResistTable = {}
    property string ResistParsed = "?"
    property string AppliedTint = ""
    property number FlashUntil = 0           -- 피격 번쩍임 (클라이언트)
    property Color FlashRestore = Color(1, 1, 1, 1)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self.TintSync = self.Tint
    end

    @ExecSpace("ServerOnly")
    method void Roll(integer grade)
        -- 정예(등급 2)만 수식어 하나. 등장할 때마다 새로
        self.HpMult = 1
        self.DamageMult = 1
        self.SpeedMult = 1
        self.Affix = ""
        self.AffixElement = ""
        if self.Variant == "" then self.Variant = self:InnateVariant() end
        local v = _GameData:GetVariant(self.Variant)
        if v ~= nil and v.weight > 0 then
            -- 변종 우두머리: 이름표는 능력 이름 (수식어 대신)
            self.Affix = v.name .. " 우두머리"
            return
        end
        if grade ~= 2 then return end
        local r = _UtilLogic:RandomIntegerRange(1, 6)
        if r == 1 then
            self.Affix = "강인한"
            self.HpMult = 1.7
        elseif r == 2 then
            self.Affix = "흉포한"
            self.DamageMult = 1.5
        elseif r == 3 then
            self.Affix = "신속한"
            self.SpeedMult = 1.5
        elseif r == 4 then
            self.Affix = "불꽃 인챈트"
            self.AffixElement = "fire"
        elseif r == 5 then
            self.Affix = "냉기 인챈트"
            self.AffixElement = "cold"
        else
            self.Affix = "번개 인챈트"
            self.AffixElement = "light"
        end
    end

    method string InnateVariant()
        ---@type Monster
        local body = self.Entity:GetComponent("script.Monster")
        if body == nil then return "" end
        local m = _GameData:GetMonsterStats(body.SourceId)
        if m == nil then return "" end
        return m.innate
    end

    method void OnUpdate(number delta)
        -- 서버: 변종 능력 / 클라이언트: 색조
        if self:IsServer() then self:AbilityTick(delta) else
            self:TintTick()
            self:FlashTick()
        end
    end

    @ExecSpace("ServerOnly")
    method void AbilityTick(number delta)
        -- 변종 능력 실행: 오오라는 주기적으로 주변 몬스터에게, 기술은 플레이어·그림자가 가까우면
        if self.Variant == "" then return end
        self.AbilityTimer = self.AbilityTimer - delta
        if self.AbilityTimer > 0 then return end
        ---@type Monster
        local body = self.Entity:GetComponent("script.Monster")
        local v = _GameData:GetVariant(self.Variant)
        if body == nil or v == nil or body.IsDead or not self.Entity.Enable then
            self.AbilityTimer = 1
            return
        end
        local pos = _Util:Pos2(self.Entity)
        if v.kind == "aura" then
            self.AbilityTimer = _GameData.auraTickSec
            for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, pos, v.radius)) do m:ReceiveAura(v.effect, v.value) end
            return
        end
        -- 기술: 보스는 BossPattern이 따로 쓰므로 건너뛴다
        if self.Entity:GetComponent("script.BossPattern") ~= nil then
            self.AbilityTimer = 999
            return
        end
        local players = _Util:PlayersNear(self.Entity.CurrentMap, pos, v.radius)
        if #players == 0 then
            self.AbilityTimer = 0.5
            return
        end
        self.AbilityTimer = v.interval
        -- 예고: NovaWarnSeconds 동안 그 자리에 경고 원 → 같은 자리에서 터진다. 원 밖으로 나가면 피할 수 있다
        self:WarnFx(Vector3(pos.x, pos.y, 0), v.radius, v.element)
        local map = self.Entity.CurrentMap
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or body.IsDead or not self.Entity.Enable or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            ---@type MonsterAttack
            local atk = self.Entity:GetComponent("script.MonsterAttack")
            if atk ~= nil then atk:Slam(pos, v.radius, atk.Damage * v.mult) end
            if v.element == "cold" then
                for _, p in ipairs(_Util:PlayersNear(map, pos, v.radius)) do
                    ---@type PlayerStats
                    local st = p:GetComponent("script.PlayerStats")
                    if st ~= nil then st:ApplyChill(1.5) end
                end
            end
            self:NovaFx(Vector3(pos.x, pos.y, 0), v.radius, v.element)
        end, self.NovaWarnSeconds)
    end

    @ExecSpace("Multicast")
    method void WarnFx(Vector3 pos, number radius, string element)
        -- 범위 기술 예고: 바닥에 붉은(냉기는 푸른) 원 + 몬스터가 힘을 모으는 빛
        local color = Color(1, 0.25, 0.15, 0.85)
        if element == "cold" then color = Color(0.4, 0.75, 1, 0.85) end
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, Vector3(radius, radius, 1), false, { Color = color })
        _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, self.Entity, Vector3(0, 0.4, 0), 0, Vector3(0.6, 0.6, 1), false, { Color = color })
    end

    @ExecSpace("Multicast")
    method void NovaFx(Vector3 pos, number radius, string element)
        local color = Color(1, 0.6, 0.3, 1)
        if element == "cold" then color = Color(0.5, 0.8, 1, 1) end
        _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, self.Entity, pos, 0, Vector3(radius * 0.3, radius * 0.3, 1), false, { Color = color })
    end

    method number GetResist(string element)
        if self.ResistParsed ~= self.Resists then
            self.ResistTable = {}
            for k, v in string.gmatch(self.Resists, "(%a+)=(%-?%d+)") do self.ResistTable[k] = tonumber(v) end
            self.ResistParsed = self.Resists
        end
        local r = self.ResistTable[element] or 0
        if self.AffixElement ~= "" and self.AffixElement == element then r = r + 50 end
        return r
    end

    @ExecSpace("Multicast")
    method void HitFx(Vector3 pos, boolean heavy, Entity attacker)
        -- 붉게 번쩍 + 잠깐 멈춤(타격 정지) + 타격음. 강타면 친 사람 화면만 흔들림 (타격 불꽃은 쓰지 않음: 평타 연출은 휘두르기 궤적만)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundService:PlaySoundAtPos(_GameConst.SfxImpact, pos, me, 0.45)
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then
            if self.FlashUntil <= 0 then self.FlashRestore = sprite.Color end
            self.FlashUntil = _UtilLogic.ElapsedSeconds + 0.1
            sprite.Color = Color(1, 0.35, 0.35, self.FlashRestore.a)
            sprite.PlayRate = 0
        end
        if heavy and attacker == me then
            local cam = _CameraService:GetCurrentCameraComponent()
            if isvalid(cam) then cam:ShakeCamera(0.12, 0.15) end
        end
    end

    @ExecSpace("ClientOnly")
    method void FlashTick()
        -- 0.06초 뒤 애니메이션 재개, 0.1초 뒤 원래 색 (색조가 그 사이 바뀌었으면 새 색조)
        if self.FlashUntil <= 0 then return end
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.FlashUntil - 0.04 then sprite.PlayRate = 1 end
        if now < self.FlashUntil then return end
        self.FlashUntil = 0
        sprite.Color = self.FlashRestore
        self.AppliedTint = ""
    end

    @ExecSpace("ClientOnly")
    method void TintTick()
        -- 동기화된 색조가 바뀌었을 때만 칠한다 (늦게 들어온 클라이언트 포함)
        if self.TintSync == self.AppliedTint then return end
        self.AppliedTint = self.TintSync
        local r, g, b = string.match(self.TintSync, "([%d%.]+),([%d%.]+),([%d%.]+)")
        local sprite = self.Entity.SpriteRendererComponent
        if r ~= nil and isvalid(sprite) then sprite.Color = Color(tonumber(r), tonumber(g), tonumber(b), 1) end
    end

end
