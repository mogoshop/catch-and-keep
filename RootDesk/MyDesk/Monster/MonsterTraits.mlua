-- 몬스터 특성: 종족 저항, 정예 수식어(06장 3절 단순화), 변종 능력(오오라·특수 기술), 색조(악마 분위기 재채색).
--   강인한 생명 ×1.7 / 흉포한 피해 ×1.5 / 신속한 속도 ×1.5 / 불꽃·냉기·번개 인챈트 (공격에 속성 + 같은 속성 저항 +50)
--   변종(variants.csv): 변종 우두머리(스포너 variantChance) 또는 최상위·보스 고유(monsters.csv innate). 잡아서 추출하면 그림자가 그대로 쓴다
@Component
script MonsterTraits extends Component

    property string Resists = ""             -- "fire=50,poison=75" (100 이상 = 면역)
    property string Tint = ""                -- "r,g,b"
    @Sync
    property string Affix = ""
    @Sync
    property string AffixElement = ""
    @Sync
    property number NovaWarnSeconds = 1.2     -- 변종 범위 기술 예고 시간 (초속 1.2칸으로 반경 밖으로 걸어 나갈 수 있게)
    @Sync
    property string Variant = ""             -- 변종 능력 id (오오라·특수 기술)
    property number AbilityTimer = 1
    property number CloudSeconds = 4          -- 독안개 지속
    property number CloudTick = 0.5           -- 독안개 피해 간격
    @Sync
    property string TintSync = ""
    property number HpMult = 1
    property number DamageMult = 1
    property number SpeedMult = 1
    property table ResistTable = {}
    property string ResistParsed = "?"
    property string AppliedTint = ""
    property number FlashUntil = 0           -- 피격 번쩍임 (클라이언트)
    property Color FlashRestore = Color(1, 1, 1, 1)
    property number PauseUntil = 0
    property number NextPauseAt = 0
    property number PauseRestoreRate = 1
    property number NextContactFxAt = 0
    property integer ContactCount = 0
    property integer ContactEffectCount = 0
    property integer ContactPauseCount = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        self.TintSync = self.Tint
    end

    @ExecSpace("ServerOnly")
    method void Roll(integer grade)
        -- 정예(등급 2)만 수식어 하나. 등장할 때마다 새로
        self.HpMult = 1
        self.DamageMult = 1
        self.SpeedMult = 1
        self.Affix = ""
        self.AffixElement = ""
        if self.Variant == "" then self.Variant = self:InnateVariant() end
        local v = _GameData:GetVariant(self.Variant)
        if v ~= nil and v.weight > 0 then
            -- 변종 우두머리: 이름표는 능력 이름 (수식어 대신)
            self.Affix = v.name .. " 우두머리"
            return
        end
        if grade ~= 2 then return end
        local r = _UtilLogic:RandomIntegerRange(1, 6)
        if r == 1 then
            self.Affix = "강인한"
            self.HpMult = 1.7
        elseif r == 2 then
            self.Affix = "흉포한"
            self.DamageMult = 1.5
        elseif r == 3 then
            self.Affix = "신속한"
            self.SpeedMult = 1.5
        elseif r == 4 then
            self.Affix = "불꽃 인챈트"
            self.AffixElement = "fire"
        elseif r == 5 then
            self.Affix = "냉기 인챈트"
            self.AffixElement = "cold"
        else
            self.Affix = "번개 인챈트"
            self.AffixElement = "light"
        end
    end

    method string InnateVariant()
        ---@type Monster
        local body = self.Entity:GetComponent("script.Monster")
        if body == nil then return "" end
        local m = _GameData:GetMonsterStats(body.SourceId)
        if m == nil then return "" end
        return m.innate
    end

    method void OnUpdate(number delta)
        -- 서버: 변종 능력 / 클라이언트: 색조
        if self:IsServer() then self:AbilityTick(delta) else
            self:TintTick()
            self:FlashTick()
        end
    end

    @ExecSpace("ServerOnly")
    method void AbilityTick(number delta)
        -- 변종 능력 실행: 오오라는 주기적으로 주변 몬스터에게, 기술은 플레이어·그림자가 가까우면
        if self.Variant == "" then return end
        self.AbilityTimer = self.AbilityTimer - delta
        if self.AbilityTimer > 0 then return end
        ---@type Monster
        local body = self.Entity:GetComponent("script.Monster")
        local v = _GameData:GetVariant(self.Variant)
        if body == nil or v == nil or body.IsDead or not self.Entity.Enable then
            self.AbilityTimer = 1
            return
        end
        local pos = _Util:Pos2(self.Entity)
        if v.kind == "aura" then
            self.AbilityTimer = _GameData.auraTickSec
            for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, pos, v.radius)) do m:ReceiveAura(v.effect, v.value) end
            return
        end
        -- 기술: 보스는 BossPattern이 따로 쓰므로 건너뛴다
        if self.Entity:GetComponent("script.BossPattern") ~= nil then
            self.AbilityTimer = 999
            return
        end
        local players = _Util:PlayersNear(self.Entity.CurrentMap, pos, v.radius)
        if #players == 0 then
            self.AbilityTimer = 0.5
            return
        end
        self.AbilityTimer = v.interval
        -- 예고: NovaWarnSeconds 동안 그 자리에 경고 원 → 같은 자리에서 터진다. 원 밖으로 나가면 피할 수 있다
        self:WarnFx(Vector3(pos.x, pos.y, 0), v.radius, v.element)
        local map = self.Entity.CurrentMap
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or body.IsDead or not self.Entity.Enable or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            ---@type MonsterAttack
            local atk = self.Entity:GetComponent("script.MonsterAttack")
            if v.kind == "cloud" then
                -- 독안개: 그 자리에 CloudSeconds 동안 남아 CloudTick마다 독 피해 (총 공격력 × mult)
                if atk ~= nil then self:StartCloud(pos, v.radius, atk.Damage * v.mult, v.element) end
                return
            end
            if atk ~= nil then atk:SlamWithElement(pos, v.radius, atk.Damage * v.mult, v.element) end
            if v.element == "cold" then
                for _, p in ipairs(_Util:PlayersNear(map, pos, v.radius)) do
                    ---@type PlayerStats
                    local st = p:GetComponent("script.PlayerStats")
                    if st ~= nil then st:ApplyChill(1.5) end
                end
            end
            self:NovaFx(Vector3(pos.x, pos.y, 0), v.radius, v.element)
        end, self.NovaWarnSeconds)
    end

    @ExecSpace("ServerOnly")
    method void StartCloud(Vector2 pos, number radius, number totalDamage, string element)
        -- 독안개: 몬스터가 쓰러져도 안개는 남는다 (엔티티가 사라지면 멈춘다)
        local ticks = math.max(1, math.floor(self.CloudSeconds / self.CloudTick + 0.5))
        local map = self.Entity.CurrentMap
        local n = 0
        local timerId = 0
        timerId = _TimerService:SetTimerRepeat(function()
            n = n + 1
            if not isvalid(self.Entity) or self.Entity.CurrentMap ~= map or n > ticks then
                _TimerService:ClearTimer(timerId)
                return
            end
            ---@type MonsterAttack
            local atk = self.Entity:GetComponent("script.MonsterAttack")
            if atk ~= nil then atk:SlamWithElement(pos, radius, totalDamage / ticks, element) end
            if n % 2 == 1 then self:CloudFx(Vector3(pos.x, pos.y, 0), radius) end
        end, self.CloudTick)
        self:CloudFx(Vector3(pos.x, pos.y, 0), radius)
    end

    @ExecSpace("Multicast")
    method void CloudFx(Vector3 pos, number radius)
        -- 독안개: 초록 안개가 피어오른다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, Vector3(radius, radius, 1), false, { Color = Color(0.35, 0.9, 0.3, 0.45) })
        _ParticleService:PlayBasicParticle(BasicParticleType.RisingSteam, self.Entity, pos, 0, Vector3(radius * 0.6, radius * 0.6, 1), false, { Color = Color(0.4, 0.85, 0.35, 0.6) })
    end

    method Color ElementColor(string element)
        -- 범위 기술 색: 화염 주황 · 냉기 파랑 · 번개 노랑 · 독 초록 · 물리 붉은색
        if element == "cold" then return Color(0.4, 0.75, 1, 0.95) end
        if element == "fire" then return Color(1, 0.5, 0.1, 0.95) end
        if element == "light" then return Color(1, 0.95, 0.35, 0.95) end
        if element == "poison" then return Color(0.4, 0.95, 0.3, 0.95) end
        return Color(1, 0.25, 0.15, 0.95)
    end

    @ExecSpace("Multicast")
    method void WarnFx(Vector3 pos, number radius, string element)
        -- 범위 기술 예고: 판정 반경 그대로의 선명한 붉은(냉기는 푸른) 테두리 + 옅은 안쪽 + 몬스터가 힘을 모으는 빛.
        -- 예전에는 흐릿한 큰 오라 입자만 있어 무엇인지·어디까지인지 읽기 어려웠다.
        local color = self:ElementColor(element)
        local fill = Color(color.r, color.g, color.b, 0.28)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk ~= nil then atk:DrawNovaWarning(Vector2(pos.x, pos.y), radius, color, self.NovaWarnSeconds) end
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, Vector3(radius, radius, 1), false, { Color = fill })
        _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, self.Entity, Vector3(0, 0.4, 0), 0, Vector3(0.6, 0.6, 1), false, { Color = color })
        if (_Util:Pos2(me) - Vector2(pos.x, pos.y)):Magnitude() <= radius + 2.5 then _HudMain:HintDanger("nova") end
    end

    @ExecSpace("Multicast")
    method void NovaFx(Vector3 pos, number radius, string element)
        local color = Color(1, 0.6, 0.3, 1)
        if element ~= "" then
            local c = self:ElementColor(element)
            color = Color(c.r, c.g, c.b, 1)
        end
        _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, self.Entity, pos, 0, Vector3(radius * 0.3, radius * 0.3, 1), false, { Color = color })
        -- 속성마다 한 겹 더: 번개는 내리꽂는 번개, 화염은 바닥 불길
        if element == "light" then _ParticleService:PlayBasicParticle(BasicParticleType.LightningStrike, self.Entity, pos, 0, Vector3(0.6, 0.6, 1), false, { Color = color })
        elseif element == "fire" then _ParticleService:PlayBasicParticle(BasicParticleType.FireField, self.Entity, pos, 0, Vector3(radius * 0.4, radius * 0.4, 1), false, { Color = color }) end
    end

    method number GetResist(string element)
        if self.ResistParsed ~= self.Resists then
            self.ResistTable = {}
            for k, v in string.gmatch(self.Resists, "(%a+)=(%-?%d+)") do self.ResistTable[k] = tonumber(v) end
            self.ResistParsed = self.Resists
        end
        local r = self.ResistTable[element] or 0
        if self.AffixElement ~= "" and self.AffixElement == element then r = r + 50 end
        return r
    end

    @ExecSpace("Multicast")
    method void HitFx(Vector3 pos, boolean heavy, Entity attacker)
        -- 접촉 섬광/타격음은 명중에만 생성한다. 가벼운 연타로 애니메이션 정지를 연장하지 않는다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        self.ContactCount = self.ContactCount + 1
        local owned = attacker == me
        local material = "flesh"
        local body = self.Entity:GetComponent("script.Monster")
        local source = body ~= nil and body.SourceId or ""
        if string.find(source, "skel", 1, true) ~= nil then material = "bone"
        elseif string.find(source, "wraith", 1, true) ~= nil then material = "spirit" end
        _SoundDirector:PlayContact(material, pos, heavy, owned)
        local now = _UtilLogic.ElapsedSeconds
        local color = Color(0.85, 0.48, 0.35, 0.85)
        if material == "bone" then color = Color(0.9, 0.82, 0.65, 0.85)
        elseif material == "spirit" then color = Color(0.65, 0.6, 0.95, 0.85) end
        if now >= self.NextContactFxAt then
            self.NextContactFxAt = now + 0.06
            local size = heavy and 0.32 or (owned and 0.22 or 0.14)
            local serial = _EffectService:PlayEffect(_GameConst.FxHit, self.Entity, pos, 0, Vector3(size, size, 1), false, { PlayRate = 1.8, Color = color })
            if serial ~= 0 then self.ContactEffectCount = self.ContactEffectCount + 1 end
        end
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then
            if self.FlashUntil <= 0 then self.FlashRestore = sprite.Color end
            self.FlashUntil = now + 0.09
            sprite.Color = Color(color.r, color.g, color.b, self.FlashRestore.a)
            if now >= self.NextPauseAt and self.PauseUntil <= 0 then
                self.ContactPauseCount = self.ContactPauseCount + 1
                self.PauseRestoreRate = sprite.PlayRate
                self.PauseUntil = now + (heavy and 0.055 or 0.025)
                self.NextPauseAt = now + 0.16
                sprite.PlayRate = 0
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void FlashTick()
        -- 색과 재생 속도의 복구 시간을 분리한다. 연타는 속도 복구를 뒤로 미루지 않는다.
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local now = _UtilLogic.ElapsedSeconds
        if self.PauseUntil > 0 and now >= self.PauseUntil then
            if sprite.PlayRate == 0 then sprite.PlayRate = self.PauseRestoreRate end
            self.PauseUntil = 0
        end
        if self.FlashUntil <= 0 or now < self.FlashUntil then return end
        self.FlashUntil = 0
        sprite.Color = self.FlashRestore
        self.AppliedTint = ""
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 종료 시 타격 정지와 임시 색을 남기지 않는다.
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then
            if self.PauseUntil > 0 and sprite.PlayRate == 0 then sprite.PlayRate = self.PauseRestoreRate end
            if self.FlashUntil > 0 then sprite.Color = self.FlashRestore end
        end
        self.PauseUntil = 0
        self.FlashUntil = 0
    end

    @ExecSpace("ClientOnly")
    method void TintTick()
        -- 동기화된 색조가 바뀌었을 때만 칠한다 (늦게 들어온 클라이언트 포함)
        if self.FlashUntil > 0 or self.TintSync == self.AppliedTint then return end
        self.AppliedTint = self.TintSync
        local r, g, b = string.match(self.TintSync, "([%d%.]+),([%d%.]+),([%d%.]+)")
        local sprite = self.Entity.SpriteRendererComponent
        if r ~= nil and isvalid(sprite) then sprite.Color = Color(tonumber(r), tonumber(g), tonumber(b), 1) end
    end

end
