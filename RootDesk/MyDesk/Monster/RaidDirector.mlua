-- 습격 (기획서 41 · 10-28 사용자 결정 §8): 맵에서 처치가 쌓이면 화면 밖 사방에서 약한 「떼」가 밀려온다.
-- 트리거 = 그 맵 처치 누적 difficulty.raidTrigger(보통 20 · 악몽 15 · 지옥 12) + 최소 간격 raidMinGapSec + 맵당 횟수 raidWaves(2 · 2 · 3).
--   금지 = 마을 · 보스 맵(보스 등급 몬스터가 있는 맵) · 심연 방 · 보통의 곁가지 · 입구 안전 반경 · 보스·끝방 우두머리 둘레 raidBossGuard.
-- 자리 = 불린 사람(처치를 채운 막타 주인) 둘레 반지름 raidRadiusMin~Max 8방향 — ReachablePoint로 벽 앞까지 당기고 raidMinReach 미만이면 그 방향은 버린다 (벽 너머 금지 · 시야 트인 방향만).
-- 떼 = 맵 출현 목록 중 무리 유형 우선 · 생명 최저 종에 Monster.Horde (생명 ×raidHordeHpMul · 피해 ×raidHordeDmgMul · 수식어 없음 · 수명 raidHordeLifeSec · 리스폰 없음 · 등급 horde).
--   악몽은 정예 우두머리 1 · 지옥은 변종 우두머리 1 + 2파(첫 파 raidPhase2At를 잡으면 raidPhase2Size).
-- 상한 = 플레이어당 raidCap(25/30/40) · 맵 raidMapCap · 방 raidRoomMobCap 넘으면 건너뛴다 ([TEL] raid skip).
-- 11-03 개편 (사용자 결정 A + 1 + 3 · docs/design/64): 글귀 「습격이 온다」·상단 띠 없음 →
--   [1] 파도: 규모 N을 raidWaveSize(4)씩 raidWaveGapSec(7)초 간격 파도로, 파도마다 8방향 고리에서 다른 방향(+3칸씩 돌아 135°씩 바뀐다). 모든 파도를 잡거나 수명이 끝나야 격퇴.
--       지옥 2파는 첫 파도 묶음의 raidPhase2At를 잡으면 raidPhase2Size 규모를 파도로 더 붙인다.
--   [3] 간격: 한 방향 최대 raidDirMax(3)마리(넘치면 가장 가까운 옆 방향) · 방향마다 바깥으로 raidSpawnGap(1.2)칸 줄 · 속도 2단(raidHordeSpeedFast/Slow 번갈아 · 줄 앞이 빠름).
--   [A] 파도마다 raidWarnSec(1.5)초 예고 = 가장자리 붉은 맥동 + 미니맵 붉은 점 + 북소리(HudMain) → 소환 직후 raidRiseSec(0.5)초 땅을 뚫고 솟음(MonsterTraits.RiseTick · 그동안 제자리).
--       첫 습격 1회만 안내 줄 「사방에서 떼가 몰려옵니다」(PlayerQuest.StorySeen raidintro).
-- 보상 = 떼 처치 경험치 ×raidExpMul(RewardSystem) · 격퇴(떼 전멸)하면 불린 사람 발밑 골드 주머니(raidGoldPerLevel × 맵 레벨 + raidGoldBase) + 「습격 격퇴 · N마리」.
-- 소환수 진형은 바꾸지 않는다 (10-28 사용자 #5-C).
@Logic
script RaidDirector extends Logic

    property table Maps = {}            -- 서버: map.Id → { map, kills, count, nextAt, quietUntil, spawnedAt, active }
    property integer TickTimer = 0
    property integer Serial = 0
    property string LastRingReach = ""  -- 마지막 고리 재기의 8방향 닿은 거리 (no-dir 진단 로그용)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 처치를 세고 1초마다 진행 중인 습격을 돌본다
        _GameEvents:Subscribe("MonsterKilled", "RaidDirector", function(e) self:OnMonsterKilled(e) end)
        self.TickTimer = _TimerService:SetTimerRepeat(function() self:Tick() end, 1)
        log("[VRF] RaidDirector ready")
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- 타이머·구독 정리
        if self.TickTimer ~= 0 then _TimerService:ClearTimer(self.TickTimer) end
        self.TickTimer = 0
        _GameEvents:Unsubscribe("MonsterKilled", "RaidDirector")
    end

    -- ───────── 다른 시스템이 묻는 값 ─────────

    method number ExpMul(Entity map)
        -- 떼 처치 경험치 배율 (RewardSystem · 보통 0.25 · 악몽 0.10 · 지옥 0.05)
        local d = _GameData:GetDifficulty(isvalid(map) and _GameConst:DifficultyOfMap(map.Name) or 0)
        return (d ~= nil and d.raidExpMul) or 0.25
    end

    -- ───────── 맵 상태 ─────────

    @ExecSpace("ServerOnly")
    method table State(Entity map)
        -- 맵별 누적. 맵이 잠들었다 깨어나면(스포너 SpawnedAt가 바뀜) 처음부터 — 횟수 상한도 함께 (R-A)
        local s = self.Maps[map.Id]
        local sp = map:GetFirstChildComponentByTypeName("script.MonsterSpawner", true)
        local at = sp ~= nil and sp.SpawnedAt or 0
        if s == nil then
            s = { map = map, kills = 0, count = 0, nextAt = 0, quietUntil = 0, spawnedAt = at, active = nil }
            self.Maps[map.Id] = s
        elseif s.spawnedAt ~= at then
            if s.active ~= nil then self:Finish(s, "sleep") end
            s.kills, s.count, s.nextAt, s.quietUntil, s.spawnedAt = 0, 0, 0, 0, at
        end
        return s
    end

    @ExecSpace("ServerOnly")
    method string Blocked(Entity map, any d)
        -- 이 맵에서 습격이 서지 않는 이유 ("" = 된다)
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        if info == nil then return "info" end
        if info.kind == "town" or info.kind == "instance" then return info.kind end
        if map:GetComponent("script.DepthDirector") ~= nil then return "depth" end   -- 심연 (#9-A)
        if info.kind == "side" and (d.raidSide or 0) < 1 then return "side" end       -- 보통은 곁가지 없음 (#2-B · #8-A)
        local sp = map:GetFirstChildComponentByTypeName("script.MonsterSpawner", true)
        if sp == nil or sp.SpawnedAt <= 0 then return "spawner" end
        return ""
    end

    @ExecSpace("ServerOnly")
    method boolean NearEntry(Entity map, Vector2 p)
        -- 입구·웨이포인트 안전 반경 안 (스포너와 같은 기준 — 막 들어온 사람이 바로 둘러싸이지 않게)
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        if info == nil then return false end
        local r = _GameConst:EntrySafeRadius(map.Name)
        for _, f in ipairs(info.features) do
            if (f.kind == "portal" or f.kind == "waypoint" or f.kind == "depth") and (Vector2(f.x, f.y) - p):Magnitude() < r then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method string BossGuard(Entity map, Vector2 center)
        -- 보스 등급 몬스터가 있는 맵은 통째로, 끝방 이름 있는 적 둘레 raidBossGuard 안도 금지 (토템 졸개와 겹치지 않게)
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local m = c
            if isvalid(m.Entity) and not m.IsDead then
                if m.Grade >= 3 then return "bossmap" end
                if m.NamedId ~= "" and (_Util:Pos2(m.Entity) - center):Magnitude() < _GameData.raidBossGuard then return "named" end
            end
        end
        return ""
    end

    -- ───────── 트리거 ─────────

    @ExecSpace("ServerOnly")
    method void OnMonsterKilled(table e)
        -- 떼 처치는 진행 중인 습격에, 다른 처치는 그 맵의 누적에
        local map = e.map
        if not isvalid(map) then return end
        if e.horde then self:OnHordeKilled(map, e.monster) return end
        local s = self:State(map)
        if s.active ~= nil then return end
        local now = _UtilLogic.ElapsedSeconds
        if now < s.quietUntil then return end
        local diff = _GameConst:DifficultyOfMap(map.Name)
        local d = _GameData:GetDifficulty(diff)
        if d == nil or s.count >= (d.raidWaves or 0) then return end
        s.kills = s.kills + 1
        if s.kills < (d.raidTrigger or 20) or now < s.nextAt then return end
        local caller = e.player
        if not _Util:IsAlive(caller) or caller.CurrentMap ~= map then return end
        local why = self:Blocked(map, d)
        if why ~= "" then return end
        self:Begin(s, caller, d, diff)
    end

    @ExecSpace("ServerOnly")
    method void Begin(table s, Entity caller, any d, integer diff)
        -- 자리·규모·상한을 정하고 예고를 띄운 뒤 raidWarnSec 뒤에 소환
        local map = s.map
        local now = _UtilLogic.ElapsedSeconds
        local center = _Util:Pos2(caller)
        local guard = self:BossGuard(map, center)
        if guard == "bossmap" then s.count = 99 return end   -- 보스 맵은 이 방에서 다시 보지 않는다
        if guard ~= "" or self:NearEntry(map, center) then
            s.kills = (d.raidTrigger or 20) - 5   -- 자리가 나쁘면 5마리 더 잡은 뒤 다시 본다
            return
        end
        local pts = self:Spots(map, center)
        if #pts == 0 then
            s.kills = (d.raidTrigger or 20) - 5
            local o = self:RingOrigin(map, center)
            log(string.format("[VRF] raid skip %s reason=no-dir at=(%.2f,%.2f) origin=(%.2f,%.2f) reach=%s", map.Name, center.x, center.y, o.x, o.y, self.LastRingReach))
            return
        end
        local players = _Util:PlayersInMap(map)
        local party = _PartySystem:NearbyMembers(caller, caller)
        local size = math.floor((d.raidSize or 12) + (d.raidPartyAdd or 4) * math.max(0, #party - 1))
        local hordes = self:HordeCount(map)
        local room = self:RoomMobs(map)
        local allow = math.floor(math.min(size, (d.raidCap or 25) * #players - hordes, _GameData.raidMapCap - hordes, _GameData.raidRoomMobCap - room))
        if allow < math.ceil(size * 0.5) then
            s.nextAt = now + _GameData.raidMinGapSec
            s.kills = 0
            _Telemetry:NoteRaid(caller, "raidSkips")
            _Telemetry:Say(string.format("[TEL] raid skip map=%s diff=%d want=%d allow=%d room=%d hordes=%d", map.Name, diff, size, allow, room, hordes))
            log(string.format("[VRF] raid skip %s reason=cap want=%d allow=%d room=%d", map.Name, size, allow, room))
            return
        end
        local species, level = self:PickSpecies(map, diff)
        if species == "" then s.count = 99 log("[VRF] raid skip " .. map.Name .. " reason=no-species") return end
        self.Serial = self.Serial + 1
        -- 이 습격 표를 지역 변수로 들고 있는다: 아래 예고·로그 사이에 s.active가 다른 경로(맵 잠듦 Finish 등)로 비면 s.active.id가 nil 오류(LEA-2007)였다 (10-29 새벽 1건)
        local raid = { id = self.Serial, caller = caller, center = center, size = allow, species = species, level = level, leader = d.raidLeader or 0, phases = d.raidPhases or 1,
            spawned = 0, killed = 0, fled = 0, alive = {}, queue = {}, startAt = now, pts = pts, spawnTimer = 0, phase2 = false, diff = diff, players = #players,
            waves = self:SplitWaves(allow), waveNext = 1, waveTimer = 0, dirStart = _UtilLogic:RandomIntegerRange(0, 7), firstBatch = allow, act = 1 }
        s.active = raid
        s.kills = 0
        s.count = s.count + 1
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        raid.act = info ~= nil and info.act or 1
        _Telemetry:NoteRaid(caller, "raidCount")
        _Telemetry:Say(string.format("[TEL] raid start map=%s diff=%d n=%d players=%d dirs=%d species=%s lv=%d", map.Name, diff, allow, #players, #pts, species, level))
        local o = self:RingOrigin(map, center)
        log(string.format("[VRF] raid warn %s n=%d waves=%d dirs=%d species=%s lv=%d count=%d/%d at=(%.2f,%.2f) shift=%.2f dirs0=%d", map.Name, allow, #raid.waves, #pts, species, level, s.count, d.raidWaves or 0, center.x, center.y, (o - center):Magnitude(),
            #self:RingSpotsFrom(map, center, center, _GameData.raidRadiusMin, _GameData.raidRadiusMax, _GameData.raidMinReach)))
        self:ScheduleWave(s)
    end

    @ExecSpace("ServerOnly")
    method table SplitWaves(integer n)
        -- 규모 n을 raidWaveSize씩 파도로 (끝 파도는 남는 수 · 남는 수가 1이면 앞 파도에 붙인다 — 1마리 파도는 싱겁다)
        local size = math.max(1, math.floor(_GameData.raidWaveSize))
        local out = {}
        local left = n
        while left > 0 do
            table.insert(out, math.min(size, left))
            left = left - size
        end
        if #out >= 2 and out[#out] == 1 then
            out[#out - 1] = out[#out - 1] + 1
            table.remove(out, #out)
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method integer DirIndex(Vector2 center, Vector2 p)
        -- 고리 자리의 8방향 번호 (0 = 오른쪽 · 반시계 45°씩)
        local v = p - center
        return math.floor(math.atan(v.y, v.x) / (math.pi / 4) + 0.5) % 8
    end

    @ExecSpace("ServerOnly")
    method table WaveDirs(table a, integer k)
        -- 파도 k의 방향: 열린 방향 중 가장 오래 앞장서지 않은 방향(바로 전 파도와 다른 방향) · 같으면 8방향 고리에서 파도마다 +3칸(135°) 돈 자리에 가까운 쪽.
        -- 옆 방향 = 앞장 방향에서 가장 가까운 다른 열린 방향 (한 방향 raidDirMax를 넘칠 때만 쓴다). 좁은 길(열린 방향 2개)이면 두 방향이 번갈아 앞장선다
        local want = (a.dirStart + 3 * (k - 1)) % 8
        local function gap(i, j) local g = math.abs(i - j) % 8 return math.min(g, 8 - g) end
        if a.dirUsed == nil then a.dirUsed = {} end
        local best, bestI, bestScore = nil, -1, 1e9
        for _, p in ipairs(a.pts) do
            local i = self:DirIndex(a.center, p)
            local score = (a.dirUsed[i] or -99) * 10 + gap(i, want)
            if score < bestScore then best, bestI, bestScore = p, i, score end
        end
        if best == nil then return {} end
        a.dirUsed[bestI] = k
        local side, sideG = nil, 99
        for _, p in ipairs(a.pts) do
            local i = self:DirIndex(a.center, p)
            if i ~= bestI then
                local g = gap(i, bestI)
                if g < sideG then side, sideG = p, g end
            end
        end
        if side == nil then return { best } end
        return { best, side }
    end

    @ExecSpace("ServerOnly")
    method void ScheduleWave(table s)
        -- 다음 파도: 불린 사람 둘레 자리를 다시 재고(움직였을 수 있다) 방향을 정해 raidWarnSec 예고 → LaunchWave
        local a = s.active
        if a == nil then return end
        a.waveTimer = 0
        local k = a.waveNext
        if k > #a.waves then return end
        local map = s.map
        if _Util:IsAlive(a.caller) and a.caller.CurrentMap == map then
            local center = _Util:Pos2(a.caller)
            local pts = self:Spots(map, center)
            if #pts > 0 then a.pts = pts a.center = center end
        end
        local dirs = self:WaveDirs(a, k)
        if #dirs == 0 then self:Finish(s, "no-dir") return end
        a.waveDirs = dirs
        local n = a.waves[k]
        local flat = { { dirs[1].x, dirs[1].y } }
        if n > _GameData.raidDirMax and dirs[2] ~= nil then table.insert(flat, { dirs[2].x, dirs[2].y }) end
        for _, p in ipairs(_Util:PlayersInMap(map)) do
            local first = false
            if k == 1 then
                ---@type PlayerQuest
                local quest = p:GetComponent("script.PlayerQuest")
                if quest ~= nil and not quest:HasSeenStory("raidintro") then
                    first = true
                    quest:AddStorySeen("raidintro")
                end
            end
            self:Warn(flat, _GameData.raidWarnSec, a.act, first, p.PlayerComponent.UserId)
        end
        local id = a.id
        a.waveTimer = _TimerService:SetTimerOnce(function() if s.active ~= nil and s.active.id == id then self:LaunchWave(s, k) end end, _GameData.raidWarnSec)
        log(string.format("[VRF] raid wave warn %s k=%d/%d n=%d dir=%d side=%d", map.Name, k, #a.waves, n, self:DirIndex(a.center, dirs[1]), dirs[2] ~= nil and self:DirIndex(a.center, dirs[2]) or -1))
    end

    @ExecSpace("ServerOnly")
    method void LaunchWave(table s, integer k)
        -- 파도 k 소환: 첫 파도는 불린 사람이 그 맵에 살아 있어야 한다 (아니면 취소) · 다음 파도 예약
        local a = s.active
        if a == nil then return end
        a.waveTimer = 0
        local map = s.map
        if k == 1 and (not _Util:IsAlive(a.caller) or a.caller.CurrentMap ~= map) then self:Finish(s, "cancel") return end
        self:EnqueueWave(s, k, k == 1 and a.leader > 0)
        a.waveNext = k + 1
        if a.spawnTimer == 0 then a.spawnTimer = _TimerService:SetTimerRepeat(function() self:RunQueue(s) end, _GameData.raidSpawnBatchSec) end
        self:RunQueue(s)
        if a.waveNext <= #a.waves then
            local id = a.id
            a.waveTimer = _TimerService:SetTimerOnce(function() if s.active ~= nil and s.active.id == id then self:ScheduleWave(s) end end, math.max(0.1, _GameData.raidWaveGapSec - _GameData.raidWarnSec))
        end
    end

    @ExecSpace("Client")
    method void Warn(table pts, number sec, integer act, boolean first)
        -- 파도 예고 (본인 화면): HudMain이 가장자리 붉은 맥동·미니맵 붉은 점·바닥 조짐·북소리 (글귀 없음 · 첫 습격만 안내 줄)
        _HudMain:RaidWarn(pts, sec, act, first)
    end

    @ExecSpace("Client")
    method void Defeated(integer n, integer gold)
        -- 격퇴 (같은 맵 모두): 「습격 격퇴 · N마리」
        _HudMain:RaidDefeated(n, gold)
    end

    -- ───────── 자리 ─────────

    @ExecSpace("ServerOnly")
    method table Spots(Entity map, Vector2 center)
        -- 8방향 고리 자리 (P-A): 반지름 9.5~11 → 벽 앞까지 당김 → 5칸 미만·입구 안전 반경 안은 버림
        return self:RingSpots(map, center, _GameData.raidRadiusMin, _GameData.raidRadiusMax, _GameData.raidMinReach)
    end

    @ExecSpace("ServerOnly")
    method table RingSpots(Entity map, Vector2 center, number rMin, number rMax, number minReach)
        -- 공용 고리 자리 (습격의 떼 · 생성 D 유입): 8방향 반지름 rMin~rMax → 벽 앞까지 당김(시야 트인 방향만) → minReach 미만·입구 안전 반경 안은 버림
        -- 재는 시작점은 RingOrigin: 벽에 바짝 붙어 선 사람은 제자리에서 몸 여유 0.4가 안 나와 8방향 모두 0칸이 됐다 (10-29 황무지 no-dir)
        return self:RingSpotsFrom(map, center, self:RingOrigin(map, center), rMin, rMax, minReach)
    end

    @ExecSpace("ServerOnly")
    method table RingSpotsFrom(Entity map, Vector2 center, Vector2 origin, number rMin, number rMax, number minReach)
        -- 고리 자리 본체: origin에서 8방향으로 곧게 재고(벽을 따라 선 사람도 벽과 나란히 잰다) 거리는 center 기준. 방향마다 흔든 각도가 벽에 막히면(벽을 따라 선 사람은
        -- 아래로 조금만 기울어도 0칸) 흔들지 않은 각도 · ±20°도 재서 가장 멀리 닿는 자리를 쓴다
        local out = {}
        local reach = {}
        for i = 0, 7 do
            local r = rMin + _UtilLogic:RandomDouble() * (rMax - rMin)
            local best, bestD = origin, -1
            for _, off in ipairs({ (_UtilLogic:RandomDouble() - 0.5) * 0.35, 0, 0.35, -0.35 }) do
                local ang = i * math.pi / 4 + off
                local q = _Util:ReachablePoint(map, origin, origin + Vector2(math.cos(ang) * r, math.sin(ang) * r), 0.4)
                local dq = (q - center):Magnitude()
                if dq > bestD then best, bestD = q, dq end
                if dq >= minReach then break end
            end
            table.insert(reach, string.format("%.1f", bestD))
            if bestD >= minReach and not self:NearEntry(map, best) then table.insert(out, best) end
        end
        self.LastRingReach = table.concat(reach, "/")
        return out
    end

    @ExecSpace("ServerOnly")
    method Vector2 RingOrigin(Entity map, Vector2 center)
        -- 고리 자리를 재기 시작할 점: 제자리에 몸 여유(상하좌우 0.4)가 있으면 그대로, 없으면(벽에 붙어 섬) 0.8칸 안에서
        -- 여유가 있고 제자리에서 벽 없이 곧게 닿는 가장 가까운 점. 발밑 점이 벽 칸에 걸쳐 있으면 가장 가까운 빈 칸 한가운데
        -- (칸 한가운데는 늘 여유 0.4가 있다). 그런 점이 없으면 제자리 (예전과 같다)
        local m = _Util:TerrainMemo(map)
        if m == nil or self:BodyClear(m, center) then return center end
        if _Util:CellBlocked(m, center) then
            local free = _Util:NearestFreePoint(map, center, 2)
            if free ~= nil then return free end
            return center
        end
        for _, r in ipairs({ 0.2, 0.4, 0.6, 0.8 }) do
            for i = 0, 15 do
                local ang = i * math.pi / 8
                local p = center + Vector2(math.cos(ang) * r, math.sin(ang) * r)
                if self:BodyClear(m, p) and (_Util:ReachablePoint(map, center, p, 0) - p):Magnitude() < 0.01 then return p end
            end
        end
        return center
    end

    @ExecSpace("ServerOnly")
    method boolean BodyClear(any m, Vector2 p)
        -- p와 상하좌우 0.4가 모두 빈 칸 (ReachablePoint의 몸 여유와 같은 기준)
        if _Util:CellBlocked(m, p) then return false end
        return not _Util:CellBlocked(m, p + Vector2(0.4, 0)) and not _Util:CellBlocked(m, p - Vector2(0.4, 0))
            and not _Util:CellBlocked(m, p + Vector2(0, 0.4)) and not _Util:CellBlocked(m, p - Vector2(0, 0.4))
    end

    @ExecSpace("ServerOnly")
    method any PickSpecies(Entity map, integer diff)
        -- 맵 출현 목록(난이도 판) 중 무리 유형 우선 · 생명 최저인 일반 종. 없으면 ""
        local base = _GameConst:BaseMapName(map.Name)
        local sp = _GameData:GetMapSpawns(base)
        if sp == nil then return "", 1 end
        local entries = sp.entries
        if diff == 1 and sp.entriesNm ~= "" then entries = sp.entriesNm elseif diff >= 2 and sp.entriesHell ~= "" then entries = sp.entriesHell end
        local best, bestScore, bestLevel = "", 1e9, 1
        for id, _, lv in string.gmatch(entries, "([%w_]+):(%d+):(%d+)") do
            local src = _GameData:SourceOfModel(id)
            local st = _GameData:GetMonsterStats(src)
            if st ~= nil and (st.grade or 1) < 2 then
                local score = (st.baseHp or 100) - ((_GameData:ArchetypeOf(src) == "swarm") and 1000 or 0)
                if score < bestScore then best, bestScore, bestLevel = id, score, tonumber(lv) end
            end
        end
        return best, _GameConst:ScaleLevel(bestLevel, diff)
    end

    @ExecSpace("ServerOnly")
    method integer HordeCount(Entity map)
        local n = 0
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            if isvalid(c.Entity) and not c.IsDead and c.Horde then n = n + 1 end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method integer RoomMobs(Entity map)
        -- 방(맵 묶음) 전체 살아 있는 몬스터 — 사람 있는 맵만 센다 (잠든 맵은 0)
        local root = map.Parent
        if not isvalid(root) then return 0 end
        local n = 0
        for _, m in ipairs(root.Children:ToTable()) do
            if #_Util:PlayersInMap(m) > 0 then
                for _, c in ipairs(m:GetChildComponentsByTypeName("script.Monster", true)) do
                    if isvalid(c.Entity) and not c.IsDead then n = n + 1 end
                end
            end
        end
        return n
    end

    -- ───────── 소환 ─────────

    @ExecSpace("ServerOnly")
    method void EnqueueWave(table s, integer k, boolean withLeader)
        -- 파도 하나를 줄 세운다 (11-03 사용자 결정 3): 한 방향 최대 raidDirMax · 넘치면 옆 방향, 방향마다 고리 자리에서 바깥으로 raidSpawnGap칸 간격 한 줄.
        -- 소환점은 이 파도·살아 있는 떼 모두와 raidSpawnGap 이상 떨어진다 (벽에 막히면 옆으로 한 칸씩 비켜 본다). 속도는 번갈아 빠름·느림, 줄 앞(플레이어 쪽)이 빠름 → 따라잡아 겹치지 않는다
        local a = s.active
        local map = s.map
        local n = a.waves[k]
        local dirs = a.waveDirs or self:WaveDirs(a, k)
        local cap = math.max(1, math.floor(_GameData.raidDirMax))
        local gapLen = _GameData.raidSpawnGap
        local taken = {}
        for _, h in ipairs(a.alive) do if isvalid(h.e) then table.insert(taken, _Util:Pos2(h.e)) end end   -- 앞 파도가 아직 고리 근처에 있으면 그 자리도 피한다
        local cols = {}
        local left = n
        for ci, base in ipairs(dirs) do
            if left <= 0 then break end
            local c = math.min(cap, left)
            if ci == #dirs then c = left end   -- 열린 방향이 하나뿐이면 그 방향에 다 (드문 경우 · 로그로 남긴다)
            table.insert(cols, { base = base, n = c })
            left = left - c
        end
        local speeds = {}
        for i = 1, n do table.insert(speeds, (i % 2 == 1) and _GameData.raidHordeSpeedFast or _GameData.raidHordeSpeedSlow) end
        local si = 1
        local minGap = 99
        local placed = {}
        local deferred, dropped = 0, 0
        for ci, col in ipairs(cols) do
            local dir = col.base - a.center
            local len = math.max(0.01, dir:Magnitude())
            local u = Vector2(dir.x / len, dir.y / len)
            local side = Vector2(-u.y, u.x)
            local colSpeeds = {}
            for j = 1, col.n do table.insert(colSpeeds, speeds[si]) si = si + 1 end
            table.sort(colSpeeds, function(x, y) return x > y end)
            for j = 0, col.n - 1 do
                local p = self:GapSpot(map, col.base, u, side, j, gapLen, taken)
                local pBase = col.base
                if p == nil and k >= #a.waves then
                    -- 마지막 파도: 다른 열린 방향의 고리 자리에서 한 번 더 (다음 파도로 넘길 곳이 없다)
                    for _, other in ipairs(a.pts) do
                        if p ~= nil then break end
                        if (other - col.base):Magnitude() > 0.5 then
                            local od = other - a.center
                            local ol = math.max(0.01, od:Magnitude())
                            local ou = Vector2(od.x / ol, od.y / ol)
                            p = self:GapSpot(map, other, ou, Vector2(-ou.y, ou.x), 0, gapLen, taken)
                            if p ~= nil then pBase = other end
                        end
                    end
                end
                if p == nil then
                    -- 간격을 지킬 자리가 없다: 겹쳐 놓지 않는다 — 다음 파도로 넘기고, 마지막 파도면 규모에서 뺀다 (11-04 코덱스 검수)
                    if k < #a.waves then
                        a.waves[k + 1] = a.waves[k + 1] + 1
                        deferred = deferred + 1
                    else
                        dropped = dropped + 1
                        log(string.format("[VRF] raid gap drop %s k=%d/%d dir=%d taken=%d", map.Name, k, #a.waves, self:DirIndex(a.center, col.base), #taken))
                    end
                else
                    local near = 99
                    for _, q in ipairs(taken) do near = math.min(near, (q - p):Magnitude()) end
                    minGap = math.min(minGap, near)
                    table.insert(taken, p)
                    table.insert(placed, string.format("%d:%.1f", self:DirIndex(a.center, pBase), colSpeeds[j + 1]))
                    table.insert(a.queue, { p = p, leader = withLeader and ci == 1 and j == 0, speed = colSpeeds[j + 1] })
                end
            end
        end
        log(string.format("[VRF] raid wave %s k=%d/%d n=%d cols=%d minGap=%.2f deferred=%d dropped=%d slots=%s", map.Name, k, #a.waves, n, #cols, minGap >= 99 and -1 or minGap, deferred, dropped, table.concat(placed, ",")))
    end

    @ExecSpace("ServerOnly")
    method any GapSpot(Entity map, Vector2 base, Vector2 u, Vector2 side, integer j, number gapLen, table taken)
        -- 줄의 j번째 자리 (nil = 간격을 지킬 자리가 없다 · 부르는 쪽이 다음 파도로 넘긴다):
        --   ① 고리 자리에서 바깥으로 j칸 → 막혔거나 가까우면 옆으로 ±1·±2·±3칸 (같은 깊이·한 칸 앞·뒤)
        --   ② 가장 가까운 빈 칸 — 이것도 taken과 gapLen 이상이어야 (11-04 코덱스 검수: 예전엔 재검사 없이 돌려 minGap 0.00·0.15가 나왔다)
        --   ③ 고리 자리 둘레 반지름 gapLen~2.5칸 12방향 (닿을 수 있고 간격을 지키는 첫 점)
        local tries = { { j, 0 }, { j, 1 }, { j, -1 }, { j - 1, 1 }, { j - 1, -1 }, { j, 2 }, { j, -2 }, { j + 1, 0 }, { j + 1, 1 }, { j + 1, -1 },
            { j + 1, 2 }, { j + 1, -2 }, { j + 2, 0 }, { j + 2, 1 }, { j + 2, -1 }, { j, 3 }, { j, -3 } }
        for _, t in ipairs(tries) do
            local want = base + u * (gapLen * t[1]) + side * (gapLen * t[2])
            local q = _Util:ReachablePoint(map, base, want, 0.4)
            if (q - want):Magnitude() < 0.05 and self:GapOk(q, gapLen, taken) then return q end
        end
        local free = _Util:NearestFreePoint(map, base + u * (gapLen * j), 2)
        if free ~= nil and self:GapOk(free, gapLen, taken) then return free end
        for _, r in ipairs({ gapLen, (gapLen + 2.5) * 0.5, 2.5 }) do
            for i = 0, 11 do
                local ang = i * math.pi / 6
                local want = base + Vector2(math.cos(ang) * r, math.sin(ang) * r)
                local q = _Util:ReachablePoint(map, base, want, 0.4)
                if (q - want):Magnitude() < 0.05 and self:GapOk(q, gapLen, taken) then return q end
            end
        end
        return nil
    end

    method boolean GapOk(Vector2 q, number gapLen, table taken)
        -- q가 이미 잡힌 자리(이 파도·살아 있는 떼) 모두와 gapLen 이상 떨어졌나
        for _, o in ipairs(taken) do
            if (o - q):Magnitude() < gapLen then return false end
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void RunQueue(table s)
        -- raidSpawnBatchSec마다 raidSpawnBatch마리 (한 프레임에 다 만들지 않는다)
        local a = s.active
        if a == nil then return end
        local map = s.map
        local now = _UtilLogic.ElapsedSeconds
        local caller = a.caller
        for k = 1, math.floor(_GameData.raidSpawnBatch) do
            local item = table.remove(a.queue, 1)
            if item == nil then break end
            local e = _SpawnService:SpawnByModelId(a.species, a.species, Vector3(item.p.x, item.p.y, 0), map)
            if isvalid(e) then
                a.spawned = a.spawned + 1
                table.insert(a.alive, { e = e, at = now })
                local level, leader, diff, speed = a.level, item.leader, a.diff, item.speed or 1
                _Util:AfterSpawn(e, "script.Monster", function(comp)
                    ---@type Monster
                    local m = comp
                    m.Horde = true
                    m.RespawnDelay = -1
                    m.HordeSpeedMul = speed
                    m:ApplyLevel(level, leader)
                    m:RefreshSpeed()
                    if leader then
                        -- 떼 우두머리: 악몽 = 정예(+정예 능력) · 지옥 = 변종 우두머리 (D-A)
                        if diff >= 2 then m:MakeVariant(_GameData:RollVariant(diff))
                        elseif diff == 1 then m:MakeEliteVariant(_GameData:RollEliteVariant(diff)) end
                    end
                    -- 감지 4칸 밖에서도 곧장 온다: SetTarget만으로는 서 있었고(10-28 메이커 실험: 9.4칸 그대로 IDLE), 탐지 범위를 키워야 온다(9.4 → 1.7칸)
                    local chase = e.AIChaseComponent
                    if isvalid(chase) then chase.DetectionRange = _GameData.raidHordeDetect end
                    -- 땅을 뚫고 솟는다 (11-03 A): 클라이언트가 RiseSec초 동안 아래에서 위로 + 알파 0→1 · 그동안 제자리 (추격을 잠깐 끈다)
                    ---@type MonsterTraits
                    local traits = e:GetComponent("script.MonsterTraits")
                    local rise = _GameData.raidRiseSec
                    if traits ~= nil and rise > 0 then
                        traits.RiseSec = rise
                        if isvalid(chase) then chase.Enable = false end
                        _TimerService:SetTimerOnce(function()
                            if isvalid(e) and isvalid(e.AIChaseComponent) and not m.IsDead then e.AIChaseComponent.Enable = true end
                        end, rise)
                        _TimerService:SetTimerOnce(function() if isvalid(e) and traits ~= nil then traits.RiseSec = 0 end end, rise + 1)
                    end
                end, nil)
            end
        end
        if #a.queue == 0 and a.spawnTimer ~= 0 then
            _TimerService:ClearTimer(a.spawnTimer)
            a.spawnTimer = 0
            log(string.format("[VRF] raid spawned %s n=%d wave=%d/%d", map.Name, a.spawned, a.waveNext - 1, #a.waves))
        end
    end

    -- ───────── 진행 ─────────

    @ExecSpace("ServerOnly")
    method void OnHordeKilled(Entity map, Entity monster)
        local s = self.Maps[map.Id]
        if s == nil or s.active == nil then return end
        local a = s.active
        for i, h in ipairs(a.alive) do
            if h.e == monster then table.remove(a.alive, i) break end
        end
        a.killed = a.killed + 1
    end

    @ExecSpace("ServerOnly")
    method void Tick()
        -- 1초마다: 수명·거리로 떼 정리, 빈 맵이면 모두 지움, 지옥 2파, 끝 판정
        for _, s in pairs(self.Maps) do
            if s.active ~= nil and isvalid(s.map) then self:TickRaid(s) end
        end
    end

    @ExecSpace("ServerOnly")
    method void TickRaid(table s)
        local a = s.active
        local map = s.map
        local now = _UtilLogic.ElapsedSeconds
        local players = _Util:PlayersInMap(map)
        local keep = {}
        for _, h in ipairs(a.alive) do
            if isvalid(h.e) then
                ---@type Monster
                local m = h.e:GetComponent("script.Monster")
                if m ~= nil and not m.IsDead then
                    local gone = #players == 0 or now - h.at > _GameData.raidHordeLifeSec or _Util:NearestPlayerDistance(map, _Util:Pos2(h.e)) > _GameData.raidHordeLeash
                    if gone then
                        h.e:Destroy()
                        a.fled = a.fled + 1
                    else
                        table.insert(keep, h)
                    end
                end
            end
        end
        a.alive = keep
        if #players == 0 then
            for _, _ in ipairs(a.queue) do end
            a.queue = {}
            self:Finish(s, "empty")
            return
        end
        -- 지옥 2파: 첫 파도 묶음의 raidPhase2At를 잡았을 때 raidPhase2Size 규모를 파도로 더 붙인다 (파도 예약이 끝났으면 바로 다음 파도)
        if a.phases >= 2 and not a.phase2 and a.killed >= math.ceil(a.firstBatch * _GameData.raidPhase2At) then
            a.phase2 = true
            local n = math.max(1, math.floor(a.firstBatch * _GameData.raidPhase2Size))
            for _, w in ipairs(self:SplitWaves(n)) do table.insert(a.waves, w) end
            if a.waveTimer == 0 then self:ScheduleWave(s) end
            log(string.format("[VRF] raid phase2 %s n=%d waves=%d", map.Name, n, #a.waves))
        end
        if a.waveNext > #a.waves and a.waveTimer == 0 and #a.queue == 0 and #a.alive == 0 and a.spawned > 0 and a.spawnTimer == 0 then
            if a.fled == 0 then self:Victory(s) else self:Finish(s, "timeout") end
        end
    end

    @ExecSpace("ServerOnly")
    method void Victory(table s)
        -- 떼 전멸: 불린 사람 발밑 골드 주머니 + 같은 맵 모두에게 격퇴 띠
        local a = s.active
        local map = s.map
        local sp = map:GetFirstChildComponentByTypeName("script.MonsterSpawner", true)
        local level = sp ~= nil and sp.MapLevel or a.level
        local gold = math.floor(level * _GameData.raidGoldPerLevel + _GameData.raidGoldBase)
        if _Util:IsAlive(a.caller) and a.caller.CurrentMap == map then
            _LootSystem:Spawn(_Util:Pos2(a.caller), a.caller.PlayerComponent.UserId, "gold", "", gold, 0)
            _Telemetry:NoteRaid(a.caller, "raidWins")
        else
            gold = 0
        end
        for _, p in ipairs(_Util:PlayersInMap(map)) do self:Defeated(a.killed, gold, p.PlayerComponent.UserId) end
        -- 「함께 격퇴」 기록 + 마을 게시판 「오늘의 기록」 (기획서 39 #13B · #14A) — 주머니는 위 그대로 불린 사람 하나
        _TownBoard:OnRaidVictory(map, a.caller, a.center)
        log(string.format("[VRF] raid victory %s killed=%d gold=%d sec=%.0f", map.Name, a.killed, gold, _UtilLogic.ElapsedSeconds - a.startAt))
        self:Finish(s, "victory")
    end

    @ExecSpace("ServerOnly")
    method void Finish(table s, string why)
        -- 끝: 다음 습격까지 raidMinGapSec, raidCooldownSec 동안은 처치를 쌓지 않는다
        local a = s.active
        if a == nil then return end
        if a.spawnTimer ~= 0 then _TimerService:ClearTimer(a.spawnTimer) end
        if a.waveTimer ~= 0 then _TimerService:ClearTimer(a.waveTimer) end
        a.waveTimer = 0
        local now = _UtilLogic.ElapsedSeconds
        s.active = nil
        s.nextAt = now + _GameData.raidMinGapSec
        s.quietUntil = now + _GameData.raidCooldownSec
        _Telemetry:Say(string.format("[TEL] raid end map=%s why=%s killed=%d fled=%d spawned=%d sec=%.0f", isvalid(s.map) and s.map.Name or "?", why, a.killed, a.fled, a.spawned, now - a.startAt))
        log(string.format("[VRF] raid end %s why=%s killed=%d fled=%d spawned=%d", isvalid(s.map) and s.map.Name or "?", why, a.killed, a.fled, a.spawned))
    end

end
