-- 몬스터 본체: 생명·레벨·피격·사망·리스폰. 다른 시스템은 이 컴포넌트 하나만 보고, 상태 이상(MonsterStatus)과
-- 특성(MonsterTraits)은 여기의 창구 메서드를 거친다. 처치되면 MonsterKilled 이벤트를 낸다 (보상·혼·의뢰는 구독자 몫).
-- 사망 애니메이션은 StateComponent(DEAD) → StateAnimationComponent의 die 키.
@Component
script Monster extends Component

    property number TickAccum = 0           -- 틱 피해 숫자 모음 (ShowTickDamage)
    property number TickShownAt = -99
    property number SummonDmgAcc = 0        -- 소환수 피해 숫자 모음 (0.4초마다 하나 — 10-28 F5 #13-A)
    property integer SummonDmgTimer = 0
    property integer SummonDmgHits = 0      -- 이번 묶음에 모인 소환수 타격 수 (검증 로그용)
    property integer SummonDmgLogged = 0    -- 합산 숫자 로그는 몬스터마다 처음 2번만
    @Sync
    property number MaxHp = 60              -- 모델 값 = BaseLevel(=모델 Level)에서의 기본 생명
    @Sync
    property integer Grade = 1              -- 1 일반, 2 정예, 3 보스
    @Sync
    property integer Level = 1
    property string SourceId = "mob"        -- 몬스터 종류 (그림자·의뢰·이름)
    property number RespawnDelay = 10       -- 음수면 리스폰 없음 (소환된 졸개·심도)
    @Sync
    property boolean Unique = false         -- 최상위(고유 이름)
    @Sync
    property string DisplayName = ""        -- 이름 있는 적(named.csv)의 이름. 비어 있으면 종류 이름
    property string NamedId = ""            -- 이름 있는 적 id (의뢰 boss·ritual 대상)
    property number HideDelay = 0.8

    @Sync
    property number Hp = 0
    @Sync
    property boolean IsDead = false

    property number BaseHp = 0
    property integer BaseLevel = 0
    property number BaseSpeed = 0
    property boolean LevelApplied = false
    property number StatMul = 1              -- 맵 생명·공격 배율 (MapAmbience.StatMul)
    property number DiffHpMul = 1            -- 난이도 생명 배율 (difficulty.csv monsterHpMul — 악몽·지옥, 10-23)
    property number DiffDmgMul = 1           -- 난이도 공격 배율 (difficulty.csv monsterDmgMul)
    property number PlayerHpMul = 1          -- 같은 맵 인원 보정 (CoopRules — D2 players X). MaxHp에 이미 곱해져 있다
    property Entity LastAttacker = nil
    property table Contributors = {}        -- 이번 생에 피해를 준 플레이어(소환수는 주인) userId → 플레이어 (개인 보상 대상)
    property Vector2 SpawnPosition = Vector2(0, 0)
    @Sync
    property string Arch = ""                -- 몬스터 유형 (archetypes.csv: beast·swarm·brute·guard·ranged·assassin·berserker·soldier)
    @Sync
    property boolean Enraged = false         -- 광전사: 생명 절반 아래에서 광폭 (공격 속도 +40% · 이동 +20%)
    @Sync
    property string MonsterState = ""        -- 몬스터 상태 id (monster_states.csv — 각성 등). 이름 아래 특성 줄에 붙고 몸이 그 색으로 물들며 속도가 바뀐다 (SetMonsterState)
    property number BlockFxAt = 0
    property integer BlockCount = 0
    property number RiteTakenMult = 1        -- 보스 의식이 바꾸는 받는 피해 배율 (근위대장 방패벽 0.4 등, docs/design/40) — 의식이 끝나면 1로
    property number RiteDealtMult = 1        -- 보스 의식이 바꾸는 주는 피해 배율 (대주교 성역 안 졸개 1.3 등)
    property number RiteSpeedMult = 1        -- 보스 의식이 바꾸는 공격 속도 배율 (집게 왕 껍질 깨짐 1.4)
    property number RiteReflect = 0          -- 보스 의식: 받은 피해의 이 비율을 때린 쪽에 되돌린다 (수호왕 영혼 저울 0.3)
    @Sync
    property number RiteShield = 0           -- 보스 의식: 이만큼 피해를 먼저 막는 보호막 (오렌 심장 조각 — 최대 생명 15%)
    @Sync
    property boolean Horde = false           -- 습격의 떼 (RaidDirector · 기획서 41): 생명 ×raidHordeHpMul · 피해 ×raidHordeDmgMul · 수식어 없음 · 리스폰 없음 · 등급 「horde」. 클라이언트는 이름표 「떼 · 」
    property boolean Inflow = false          -- 생성 D 혼합 ② 유입으로 들어온 몬스터 (MonsterSpawner): 일반 등급 그대로 · 죽으면 자리 리스폰 대신 스포너 풀로 돌아간다
    -- 개발용 전투 계측 (I05 · Telemetry DPS, 기본 꺼짐): HP 원장 식별자. 계측이 꺼져 있으면 읽지도 쓰지도 않는다
    property integer DpsRun = 0              -- 이 생명이 기록된 계측 실행 번호 (0 = 기록 밖)
    property integer DpsLife = 0             -- 실행 안의 생명 번호 (첫 등장·리스폰마다 새 번호)
    property integer DpsSeq = 0              -- 이 생명의 HP 원장 순번 (같은 시각의 여러 타격도 각각 다른 번호)
    property integer DpsAttempt = 1          -- 빈 맵 리셋(ResetForEmptyMap)마다 +1 — TTK 시도 경계
    property number DpsLastHp = 0            -- 원장이 마지막으로 본 HP (원장 밖에서 HP가 바뀌면 drift로 따로 남긴다)
    property any DpsTags = nil               -- 공격 쪽이 남긴 출처 꼬리표 목록 (by·info·dmg·at, 최대 4 · DpsTag — 정확히 하나만 맞을 때만 쓴다). 일반 Lua 표라 any

    method MonsterStatus Status()
        ---@type MonsterStatus
        local c = self.Entity:GetComponent("script.MonsterStatus")
        return c
    end

    method MonsterTraits Traits()
        ---@type MonsterTraits
        local c = self.Entity:GetComponent("script.MonsterTraits")
        return c
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 피해 숫자를 발/몸에서 떼어 머리 위에 표시한다. 타격 판정과 HP는 그대로 둔다.
        local numbers = self.Entity.DamageSkinSpawnerComponent
        if isvalid(numbers) then
            local hit = self.Entity.HitComponent
            local height = isvalid(hit) and hit.BoxSize.y or 0.6
            numbers.DamageSkinOffset = Vector2(0, math.max(0.85, height + 0.25))
        end
        self.BaseHp = self.MaxHp
        self.BaseLevel = self.Level
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then self.BaseSpeed = movement.InputSpeed end
        local p = self.Entity.TransformComponent.WorldPosition
        self.SpawnPosition = Vector2(p.x, p.y)
        self.Arch = _GameData:ArchetypeOf(self.SourceId)
        self:Reroll()
        if _Telemetry.DpsOn then _Telemetry:DpsNote(self, "spawn", -1) end
        -- 맵에 고정 배치된 몬스터(최상위·보스)는 맵의 난이도 레벨 가산을 받는다 (스포너 몬스터는 스포너가 ApplyLevel)
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or self.LevelApplied then return end
            ---@type MapAmbience
            local amb = self.Entity.CurrentMap:GetComponent("script.MapAmbience")
            if amb ~= nil and amb.Difficulty > 0 then self:ApplyLevel(_GameConst:ScaleLevel(self.Level, amb.Difficulty), false)
            elseif amb ~= nil and amb.StatMul ~= 1 then self:ApplyLevel(self.Level, false) end
            self:StartQuestGate()
        end, 0.3)
    end

    -- ───────── 의뢰 차례 전에는 숨는 고정 보스 (10-24 사용자) ─────────
    -- 교수대 숲 「목 없는 처형인 고드릭」은 피의 제단 다음 의뢰의 열쇠 적인데, 맵에 늘 서 있어 의뢰 전에 잡히면
    -- 열쇠를 못 얻고 그 게임에서 다시 나오지 않았다. 맵에 고정 배치된 의뢰 대상(정예 이상)은 그 의뢰 차례가 된
    -- 사람(받을 수 있음·진행 중·이미 지남, 또는 바로 앞 의뢰를 끝내고 보고만 남음)이 맵에 있을 때만 나타난다.

    @ExecSpace("ServerOnly")
    method void StartQuestGate()
        if self.Grade < 2 and not self.Unique then return end
        local qi = self:QuestGateIndex()
        if qi <= 0 or self:QuestReached(qi) then return end
        self.Entity.Enable = false
        log("[VRF] quest gate hide " .. self.SourceId .. " until quest " .. tostring(qi))
        local timerId = 0
        timerId = _TimerService:SetTimerRepeat(function()
            if not isvalid(self.Entity) or self.IsDead then
                _TimerService:ClearTimer(timerId)
                return
            end
            if not self:QuestReached(qi) then return end
            _TimerService:ClearTimer(timerId)
            self.Entity.Enable = true
            log("[VRF] quest gate show " .. self.SourceId .. " quest " .. tostring(qi))
        end, 1.5)
    end

    method integer QuestGateIndex()
        -- 이 맵에 고정 배치된 의뢰 대상이면 그 의뢰 번호 (보스·열쇠 적은 map 또는 map1, 문지기는 map1). 아니면 0
        local base = _GameConst:BaseMapName(self.Entity.CurrentMap.Name)
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            if q ~= nil and q.kind ~= "ritual" and q.kind ~= "clear" and q.kind ~= "extract" and (q.map == base or q.map1 == base) then
                for id in string.gmatch(q.target .. "|" .. (q.gate or ""), "[^|]+") do
                    if id == self.SourceId then return i end
                end
            end
        end
        return 0
    end

    method boolean QuestReached(integer qi)
        -- 맵에 있는 누군가가 그 의뢰 차례에 왔는가
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return false end
        for _, u in ipairs(_UserService:GetUsersByMapComponent(map.MapComponent) or {}) do
            ---@type PlayerQuest
            local pq = isvalid(u) and u:GetComponent("script.PlayerQuest") or nil
            if pq ~= nil and (pq.Index >= qi or (pq.Index == qi - 1 and pq.State == 2)) then return true end
        end
        return false
    end

    -- ───────── 레벨·생명 ─────────

    @ExecSpace("ServerOnly")
    method void ApplyLevel(integer level, boolean elite)
        -- 스포너·심도·맵 난이도: 레벨에 맞춰 생명·공격 조정, 정예면 등급 2 (06장 2절)
        self.LevelApplied = true
        self.Level = level
        -- 맵 생명·공격 배율 (액트 1 3번 맵부터 1.3 등, maps.csv statMul)
        local map = self.Entity.CurrentMap
        ---@type MapAmbience
        local amb = isvalid(map) and map:GetComponent("script.MapAmbience") or nil
        self.StatMul = (amb ~= nil and amb.StatMul > 0) and amb.StatMul or 1
        -- 난이도 배율 (10-23: 레벨만 올리면 악몽·지옥이 보통보다 쉬웠다 — 플레이어 군단이 몬스터 생명보다 빨리 자란다). 심연은 DepthDirector 난이도
        local diff = (amb ~= nil and amb.Difficulty) or 0
        if isvalid(map) then
            ---@type DepthDirector
            local depth = map:GetComponent("script.DepthDirector")
            if depth ~= nil then diff = depth.Difficulty end
        end
        local d = _GameData:GetDifficulty(diff)
        self.DiffHpMul = (d ~= nil and d.monsterHpMul) or 1
        self.DiffDmgMul = (d ~= nil and d.monsterDmgMul) or 1
        if elite and self.Grade == 1 then self.Grade = 2 end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk ~= nil then atk:ScaleToLevel(self.BaseLevel, level) end
        local hpBefore = self.Hp
        self:Reroll()
        if _Telemetry.DpsOn then _Telemetry:DpsNote(self, "rebase", hpBefore) end   -- 레벨 적용 재설정: 새 생명도 전투 회복도 아니다
    end

    @ExecSpace("ServerOnly")
    method void Reroll()
        -- 등장할 때마다: 수식어 다시 굴림 → 최대 생명·속도 다시 계산 → 생명 가득
        local traits = self:Traits()
        if traits ~= nil then traits:Roll(self.Grade) end
        self.Enraged = false
        self:RecomputeMaxHp()
        self:RefreshSpeed()
        self.Hp = self.MaxHp
    end

    @ExecSpace("ServerOnly")
    method void RecomputeMaxHp()
        local k = _GameData.monsterHpPerLevel
        local hp = self.BaseHp * (1 + k * (self.Level - 1)) / (1 + k * (self.BaseLevel - 1))
        if self.Grade == 2 and not self.Unique then hp = hp * _GameData.eliteHpMul end
        if self.Grade >= 3 then
            -- 10-10 QA: 보스가 너무 약했다. 10-13 W2: 액트 2·3 보스는 「벽」 배율 (액트 1 여왕은 그대로)
            hp = hp * (self.Level >= _GameData.bossWallFromLevel and _GameData.bossWallHpMul or _GameData.bossHpMul)
        end
        hp = hp * self.StatMul * self.DiffHpMul
        if self.Horde then hp = hp * _GameData.raidHordeHpMul end   -- 떼는 새 등급 (기존 종 수치는 그대로 — 10-28 공정성 원칙)
        local traits = self:Traits()
        if traits ~= nil then hp = hp * traits.HpMult end
        self.MaxHp = math.max(1, hp)
        self.PlayerHpMul = 1   -- 인원 보정은 CoopRules가 다음 틱에 다시 곱한다

    end

    @ExecSpace("ServerOnly")
    method void RefreshSpeed()
        -- 기본 속도 × 수식어(신속한) × 상태(냉기 둔화) × 몬스터 상태(각성)
        local movement = self.Entity.MovementComponent
        if not isvalid(movement) or self.BaseSpeed <= 0 then return end
        local mult = 1
        local traits = self:Traits()
        if traits ~= nil then mult = mult * traits.SpeedMult end
        local status = self:Status()
        if status ~= nil then mult = mult * status:SpeedMult() end
        if self.Enraged then mult = mult * 1.2 end
        movement.InputSpeed = self.BaseSpeed * mult * self:StateMul("speed")
    end

    -- ───────── 창구 (다른 시스템은 이것만 쓴다) ─────────

    method string GetRank()
        -- monster_ranks.csv의 등급: boss / unique(고유 이름) / elite / normal
        if self.Grade >= 3 then return "boss" end
        if self.Unique then return "unique" end
        local traits = self:Traits()
        if traits ~= nil and traits.Champion then return "champion" end   -- 변종 우두머리 (악몽 이후 능력 붙은 정예는 정예 그대로)
        if self.Grade == 2 then return "elite" end
        if self.Horde then return "horde" end   -- 습격의 떼 (monster_ranks horde · 추출 0.08 · 골드만)
        return "normal"
    end

    method number GetResist(string element)
        -- 저항 붕괴 저주는 모든 저항을 낮춘다 (음수면 더 아프게 맞는다) · 화염은 화염 한정 감소와 큰 값만 (MonsterStatus.ResistBreakFor · 48 FIRE-01)
        local traits = self:Traits()
        local base = traits ~= nil and traits:GetResist(element) or 0
        local status = self:Status()
        if status ~= nil then base = base - status:ResistBreakFor(element) end
        return base
    end

    method number GetDamageTakenMultiplier()
        -- 상태 이상(저주 등) × 모래 망령 반투명(-50%)
        local m = 1
        local status = self:Status()
        if status ~= nil then m = status:TakenMult() end
        ---@type MonsterBehavior
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and behavior.Phased then m = m * 0.5 end
        ---@type Act3Rite
        local rite = self.Entity:GetComponent("script.Act3Rite")
        if rite ~= nil and rite.Shell then m = m * 0.6 end   -- 바위 집게 왕 껍질 (받는 피해 -40%)
        ---@type AshKingRite
        local ash = self.Entity:GetComponent("script.AshKingRite")
        if ash ~= nil and ash.Exposed then m = m * (1 + ash.ExposedPct / 100) end   -- 재의 왕 심장 노출 (받는 피해 +30%)
        if ash ~= nil and ash.ShadesAlive > 0 then m = m * ash.ShadeGuard end   -- 그림자 인형이 왕을 감싼다 (docs/design/31 §6)
        ---@type BossPattern
        local bp = self.Entity:GetComponent("script.BossPattern")
        if bp ~= nil and _UtilLogic.ElapsedSeconds < bp.WardUntil then m = 0 end   -- 보스 위상 2초 무적 (10-24 S-D)
        return m * self.RiteTakenMult
    end

    method number GetDamageDealtMultiplier()
        local m = 1
        local traits = self:Traits()
        if traits ~= nil then m = traits.DamageMult end
        local status = self:Status()
        if status ~= nil then m = m * status:WeakenMult() * status:AuraMult("dmg") * status:SoulMult() end
        ---@type BossPattern
        local bp = self.Entity:GetComponent("script.BossPattern")
        if bp ~= nil then m = m * bp.RageMult end
        if self.Grade >= 3 then m = m * _GameData.bossDmgMul end
        if self.Horde then m = m * _GameData.raidHordeDmgMul end
        return m * self.RiteDealtMult
    end

    method number GetAttackSpeedMultiplier()
        -- 질풍 오오라 × 형제 분노(+30%) × 몬스터 상태(각성)
        local m = 1
        local status = self:Status()
        if status ~= nil then m = status:AuraMult("haste") end
        ---@type BossPattern
        local bp = self.Entity:GetComponent("script.BossPattern")
        if bp ~= nil and bp.RageMult > 1 then m = m * 1.3 end
        m = m * self.RiteSpeedMult
        if self.Enraged then m = m * 1.4 end
        return m * self:StateMul("attack")
    end

    -- ───────── 몬스터 유형 (archetypes.csv · docs/design/29) ─────────

    method boolean ArchActive(string arch)
        -- 이 유형의 동작을 쓰는가. 보스·보스 패턴(BossPattern)이 있는 고유 몬스터는 자기 패턴만 쓴다
        if self.Arch ~= arch or self.Grade >= 3 then return false end
        return self.Entity:GetComponent("script.BossPattern") == nil
    end

    method number GuardMult(Entity attacker)
        -- 방패: 바라보는 쪽(앞)에서 온 공격은 35% 막는다. 옆·뒤는 그대로. 리소스가 왼쪽을 보므로 FlipX = 오른쪽
        if not self:ArchActive("guard") or self.IsDead or not isvalid(attacker) then return 1 end
        local renderer = self.Entity.SpriteRendererComponent
        if not isvalid(renderer) then return 1 end
        local facing = renderer.FlipX and 1 or -1
        local dx = _Util:Pos2(attacker).x - _Util:Pos2(self.Entity).x
        if dx * facing < 0.15 then return 1 end
        self.BlockCount = self.BlockCount + 1
        local now = _UtilLogic.ElapsedSeconds
        if self:IsServer() and now >= self.BlockFxAt then
            self.BlockFxAt = now + 0.7
            self:BlockFx(facing)
        end
        return 0.65
    end

    @ExecSpace("Multicast")
    method void BlockFx(integer facing)
        -- 막음: 몸 앞쪽에 짧은 흰 불꽃
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        ---@type FrameAnimator
        local anim = self.Entity:GetComponent("script.FrameAnimator")
        if anim ~= nil then anim:Flash("block", 0.3) end
        local p = self.Entity.TransformComponent.WorldPosition
        local hit = self.Entity.HitComponent
        local h = (isvalid(hit) and hit.BoxSize.y or 0.6) * math.abs(self.Entity.TransformComponent.Scale.y)   -- 판정 상자는 몸 크기를 따라 커진다
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, Vector3(p.x + facing * 0.35, p.y + h * 0.55, p.z), 0, Vector3(0.35, 0.35, 1), false, { Color = Color(0.85, 0.9, 1, 0.8) })
    end

    @ExecSpace("ServerOnly")
    method void CheckEnrage()
        -- 광전사: 생명 절반 아래로 처음 떨어지면 광폭 (다시 등장하면 풀린다)
        if self.Enraged or self.IsDead or self.Hp <= 0 or self.Hp > self.MaxHp * 0.5 then return end
        if not self:ArchActive("berserker") then return end
        self.Enraged = true
        self:RefreshSpeed()
        local traits = self:Traits()
        if traits ~= nil then traits.TintSync = "1,0.55,0.5" end   -- 붉게 (다시 등장하면 Roll이 원래 색으로)
        self:EnrageFx()
    end

    @ExecSpace("Multicast")
    method void EnrageFx()
        -- 광폭: 붉은 기운이 한 번 터진다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local p = self.Entity.TransformComponent.WorldPosition
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, Vector3(p.x, p.y + 0.5, p.z), 0, Vector3(0.9, 0.9, 1), false, { Color = Color(1, 0.25, 0.15, 0.85) })
    end

    method string GetVariant()
        -- 변종 능력 id (variants.csv). 무작위 변종 우두머리 또는 최상위·보스 고유
        local traits = self:Traits()
        if traits == nil then return "" end
        return traits.Variant
    end

    @ExecSpace("ServerOnly")
    method void MakeEliteVariant(string code)
        -- 악몽부터: 정예에게 능력 하나 (우두머리 몸 색·등급은 그대로 정예 — 10-24 C안)
        local traits = self:Traits()
        if traits == nil or code == "" or self.Grade ~= 2 then return end
        traits.Variant = code
        self:Reroll()
    end

    @ExecSpace("ServerOnly")
    method void MakeVariant(string id)
        -- 스포너가 변종 우두머리로 만든다: 등급 2(정예 생명) + 능력
        local traits = self:Traits()
        if traits == nil or id == "" then return end
        if self.Grade == 1 then self.Grade = 2 end
        traits.Variant = id
        traits.Champion = true
        self:Reroll()
    end

    @ExecSpace("ServerOnly")
    method void ReceiveAura(string effect, number value)
        local status = self:Status()
        if status ~= nil then status:ReceiveAura(effect, value) end
    end

    method string GetAffixElement()
        local traits = self:Traits()
        if traits == nil then return "" end
        return traits.AffixElement
    end

    @ExecSpace("ServerOnly")
    method void SetMonsterState(string id)
        -- 몬스터 상태를 붙이거나("" = 뗀다) 속도를 다시 계산한다. 색·이름 표시는 클라이언트가 MonsterState를 보고 맞춘다 (MonsterTraits.TintTick · HudMain.TargetStatus)
        if self.MonsterState == id then return end
        self.MonsterState = id
        self:RefreshSpeed()
    end

    method number StateMul(string kind)
        -- 몬스터 상태의 배율: speed = 이동 · attack = 공격 속도 (상태가 없으면 1)
        local st = _GameData:GetMonsterState(self.MonsterState)
        if st == nil then return 1 end
        return 1 + (kind == "speed" and st.speedPct or st.attackPct) / 100
    end

    method string GetAffixName()
        local traits = self:Traits()
        if traits == nil then return "" end
        return traits.Affix
    end

    method string GetCurseTag()
        local status = self:Status()
        if status == nil then return "" end
        return status.CurseTag
    end

    @ExecSpace("ServerOnly")
    method void ApplyCurse(string kind, number pct, number duration)
        local status = self:Status()
        if status ~= nil then status:ApplyCurse(kind, pct, duration) end
    end

    @ExecSpace("ServerOnly")
    method void ApplyCurseFrom(string kind, number pct, number duration, Entity source)
        local status = self:Status()
        if status ~= nil then status:ApplyCurseFrom(kind, pct, duration, source) end
    end

    @ExecSpace("ServerOnly")
    method void ApplyRoot(number seconds, Entity source)
        local status = self:Status()
        if status ~= nil then status:ApplyRoot(seconds, source) end
    end

    @ExecSpace("ServerOnly")
    method void LifeTapFor(Entity attacker, number damage)
        -- 생명 약탈이 걸린 대상을 때리면 때린 플레이어·소환수가 피해의 일부를 회복한다.
        local status = self:Status()
        if status == nil or damage <= 0 or not isvalid(attacker) then return end
        local pct = status:LifeTap()
        if pct <= 0 then return end
        local heal = damage * pct / 100
        ---@type PlayerStats
        local stats = attacker:GetComponent("script.PlayerStats")
        if stats ~= nil then stats:Heal(heal, 0) return end
        ---@type ShadowUnit
        local unit = attacker:GetComponent("script.ShadowUnit")
        if unit ~= nil and not unit.Dead and unit.Hp > 0 then unit.Hp = math.min(unit.MaxHp, unit.Hp + heal) end
    end

    @ExecSpace("ServerOnly")
    method void ApplyPoison(number dps, number duration, Entity source)
        local status = self:Status()
        if status ~= nil then status:ApplyPoison(dps, duration, source) end
    end

    method boolean IsCursed()
        -- 플레이어 저주가 하나라도 걸려 있나 (저주 불꽃 추가 피해)
        local status = self:Status()
        return status ~= nil and status:HasCurse()
    end

    @ExecSpace("ServerOnly")
    method void ApplyFrost(number seconds, Entity source, number damage, number markPct)
        -- 서리 혼 둔화 + 「파쇄」용 출처 기억 + 강화 「서리 표식」 세기 (0 = 표식 없음)
        local status = self:Status()
        if status ~= nil then status:ApplyFrost(seconds, source, damage, markPct) end
    end

    @ExecSpace("ServerOnly")
    method void ApplyChill(number seconds)
        local status = self:Status()
        if status ~= nil then status:ApplyChill(seconds) end
    end

    -- ───────── 피격·사망 ─────────

    @ExecSpace("ServerOnly")
    method void TakeDamage(number amount, Entity attacker)
        -- 히트 판정을 거치지 않는 피해(독·흡수). 출처를 모르는 옛 호출 — 계측에는 tick.unknown (TakeDamageAs와 같은 본문)
        self:TakeDamageAs(amount, attacker, "tick")
    end

    @ExecSpace("ServerOnly")
    method void TakeDamageAs(number amount, Entity attacker, string path)
        -- 히트 판정을 거치지 않는 피해(독·흡수). 저항은 호출한 쪽에서 이미 반영, 저주 배율·레벨 차이만 여기서.
        -- path = 계측 출처 ("tick" 또는 "tick.poison"·"tick.confuse"·"tick.thorns_aura"·"tick.curse_thorns" 같은 고정 글자 — 호출 쪽 패치 요청). 게임 계산에는 쓰지 않는다
        if self.IsDead then return end
        if isvalid(attacker) then
            self.LastAttacker = attacker
            self:NoteContributor(attacker)
        end
        local gap = 1
        local lv = _GameConst:LevelOf(attacker)
        if lv > 0 then gap = _GameConst:LevelGapDealt(lv, self.Level) end
        local dealt = amount * self:GetDamageTakenMultiplier() * gap
        self:ApplyHpDamage(dealt, attacker, path)
        -- 틱 피해는 히트 판정을 거치지 않아 엔진이 숫자를 띄우지 않는다 → 0.45초마다 모아 작게 띄운다 (10-10 QA: 독안개 피해가 안 보임)
        self.TickAccum = self.TickAccum + dealt
        local now = _UtilLogic.ElapsedSeconds
        if now - self.TickShownAt >= 0.45 or self.Hp <= 0 then
            local shown = math.floor(self.TickAccum + 0.5)
            self.TickAccum = 0
            self.TickShownAt = now
            if shown > 0 then self:ShowTickDamage(shown) end
        end
        if self.Hp <= 0 then self:Die() else self:CheckEnrage() end
    end

    @ExecSpace("ServerOnly")
    method void QueueSummonDamage(number amount)
        -- 소환수 타격 숫자는 0.4초 모아 하나로 (집중 대상당 초당 약 2.5회 · 내 타격 숫자가 묻히지 않게)
        self.SummonDmgAcc = self.SummonDmgAcc + amount
        self.SummonDmgHits = self.SummonDmgHits + 1
        if self.SummonDmgTimer ~= 0 then return end
        self.SummonDmgTimer = _TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self:FlushSummonDamage() end end, 0.4)
    end

    @ExecSpace("ServerOnly")
    method void FlushSummonDamage()
        -- 모은 소환수 피해를 숫자 하나로 띄운다 (사망 직전에도 불러 남은 몫을 비운다)
        if self.SummonDmgTimer ~= 0 then _TimerService:ClearTimer(self.SummonDmgTimer) end
        self.SummonDmgTimer = 0
        local amount = math.floor(self.SummonDmgAcc + 0.5)
        self.SummonDmgAcc = 0
        if amount > 0 and self.SummonDmgLogged < 2 then
            self.SummonDmgLogged = self.SummonDmgLogged + 1
            log(string.format("[VRF] summon sum %s shown=%d hits=%d", self.Entity.Name, amount, self.SummonDmgHits))
        end
        self.SummonDmgHits = 0
        if amount > 0 and isvalid(self.Entity) then self:ShowSummonDamage(amount) end
    end

    @ExecSpace("Multicast")
    method void ShowSummonDamage(integer amount)
        -- 소환수 피해 합산 숫자: 내 타격(0.95)보다 작고 옅게
        if not isvalid(self.Entity) then return end
        -- Play: 선택 인자는 5개를 모두 넘겨야 한다 (일부만 넘기면 LEA-3005) · 오프셋은 엔진 기본 (두 번 더해진다)
        _DamageSkinService:Play(self.Entity, "6ba67548f43f48f29eb23dafd0766383", 0, { amount }, DamageSkinTweenType.Volcano, false, Vector2(0, 0), Vector2(0.42, 0.42), 1.9, 0.8, LitMode.Default)   -- 메이커 확인: 0.6은 내 숫자(설정 0.95)보다 크게 보였다
    end

    @ExecSpace("Multicast")
    method void ShowTickDamage(integer amount)
        -- 독·흡수 같은 지속 피해 숫자. 평타 숫자보다 작고 옅게, 머리 위에서
        if not isvalid(self.Entity) then return end
        -- 위치는 엔진 기본(평타 숫자와 같은 머리 위). 추가 오프셋을 주면 두 번 더해져 두 칸 위로 떴다 (메이커 확인)
        -- Play: 선택 인자는 5개를 모두 넘겨야 한다 (일부만 넘기면 LEA-3005)
        _DamageSkinService:Play(self.Entity, "6ba67548f43f48f29eb23dafd0766383", 0, { amount }, DamageSkinTweenType.DefaultMini, false, Vector2(0, 0), Vector2(0.85, 0.85), 1.2, 1, LitMode.Default)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- 피해 계산(저항·저주 포함)은 공격 쪽 CalcDamage가 이미 했다
        if self.IsDead then return end
        if isvalid(event.AttackerEntity) then
            self.LastAttacker = event.AttackerEntity
            self:NoteContributor(event.AttackerEntity)
            local chase = self.Entity.AIChaseComponent
            if isvalid(chase) then chase:SetTarget(event.AttackerEntity) end
        end
        self:ApplyHpDamage(event.TotalDamage, event.AttackerEntity, "hit")
        if self.RiteReflect > 0 then self:RiteReflectTo(event.AttackerEntity, event.TotalDamage * self.RiteReflect) end
        if isvalid(event.AttackerEntity) and event.AttackerEntity:GetComponent("script.ShadowUnit") ~= nil then self:QueueSummonDamage(event.TotalDamage) end
        self:LifeTapFor(event.AttackerEntity, event.TotalDamage)
        self:CheckEnrage()
        local pos = self.Entity.TransformComponent.WorldPosition
        local heavy = event.TotalDamage >= self.MaxHp * _GameData.heavyHitPct
        if isvalid(event.AttackerEntity) then
            local attack = event.AttackerEntity:GetComponent("script.PlayerAttack")
            if attack ~= nil then attack:RegisterBasicContact(heavy) end
        end
        local traits = self:Traits()
        if traits ~= nil then traits:HitFx(Vector3(pos.x, pos.y + 0.4, 0), heavy, event.AttackerEntity) end
        if self.Hp <= 0 then
            self:Die()
            return
        end
        self:HitReact(event.AttackerEntity, event.TotalDamage)
    end

    @ExecSpace("ServerOnly")
    method void ApplyHpDamage(number raw, Entity attacker, string path)
        -- 몬스터 HP를 피해로 깎는 유일한 곳: HandleHitEvent("hit") · TakeDamage/TakeDamageAs("tick"·"tick.<출처>" — 독·가시·반사·혼란). 보호막(RiteAbsorb)은 여기서 한 번만 부른다.
        -- 개발용 전투 계측(Telemetry DPS)이 켜져 있을 때만 깎기 전후를 원장에 한 번 남긴다 — 표시용 숫자 모음(QueueSummonDamage·TickAccum)·CalcDamage·처치 보상은 원장이 아니다
        local before = self.Hp
        local taken = self:RiteAbsorb(raw)
        self.Hp = self.Hp - taken
        local src = ""
        if _Telemetry.DpsOn then src = _Telemetry:DpsHit(self, attacker, path, before, self.Hp, raw, raw - taken) end
        -- 성장 관측 PlayerDealtDamage (D P5): 유효 피해(> 0)가 있을 때만 — 계측 on/off와 무관, 저장 없음, 사용자당 1초에 한 번
        if taken > 0 and before > 0 and isvalid(attacker) then _Telemetry:DealtDamage(self, attacker, path, src) end
    end

    @ExecSpace("ServerOnly")
    method void DpsTag(Entity attacker, string info, integer damage)
        -- 공격 쪽(CalcDamage)이 남기는 출처 꼬리표 — 계측이 꺼져 있으면 아무것도 하지 않는다.
        -- 엔진 HitEvent에는 AttackInfo가 없다: 같은 공격자·같은 TotalDamage로 정확히 맞을 때만 그 이름을 쓰고, 아니면 「미상」 (추정 금지 · Telemetry.DpsTakeTag)
        if not _Telemetry.DpsOn or not isvalid(attacker) then return end
        local now = _UtilLogic.ElapsedSeconds
        local keep = {}
        for _, t in ipairs(self.DpsTags or keep) do
            if now - t.at <= 0.5 then table.insert(keep, t) end
        end
        while #keep >= 4 do table.remove(keep, 1) end
        table.insert(keep, { by = attacker, info = info, dmg = damage, at = now })
        self.DpsTags = keep
    end

    @ExecSpace("ServerOnly")
    method void RestoreHp(number amount, string reason)
        -- 몬스터 회복 창구 (재생 오라·의식 회복 등). 계측이 켜져 있으면 피해와 따로 heal 사건으로 남긴다
        if self.IsDead or amount <= 0 then return end
        local before = self.Hp
        self.Hp = math.min(self.MaxHp, self.Hp + amount)
        if _Telemetry.DpsOn then _Telemetry:DpsNote(self, "heal:" .. reason, before) end
    end

    @ExecSpace("ServerOnly")
    method number RiteAbsorb(number amount)
        -- 보스 의식 보호막(RiteShield)이 먼저 받는다 — 남은 피해만 돌려준다 (docs/design/40 오렌)
        if self.RiteShield <= 0 or amount <= 0 then return amount end
        local soak = math.min(self.RiteShield, amount)
        self.RiteShield = self.RiteShield - soak
        if self.RiteShield <= 0 then log("[VRF] rite shield broken " .. self.SourceId) end
        return amount - soak
    end

    @ExecSpace("ServerOnly")
    method void RiteReflectTo(Entity attacker, number amount)
        -- 보스 의식 반사 (수호왕 영혼 저울): 때린 플레이어는 생명, 소환수는 그 소환수가 받는다
        if not isvalid(attacker) or amount <= 0 then return end
        ---@type ShadowUnit
        local unit = attacker:GetComponent("script.ShadowUnit")
        if unit ~= nil then unit:Hurt(math.floor(amount)) return end
        ---@type PlayerVitals
        local vitals = attacker:GetComponent("script.PlayerVitals")
        if vitals ~= nil then vitals:TakeTickDamage(amount) end
    end

    @ExecSpace("ServerOnly")
    method void NoteContributor(Entity attacker)
        -- 피해를 준 쪽(소환수면 주인)을 개인 보상 대상으로 기억한다
        local owner = _Util:OwnerPlayerOf(attacker)
        if isvalid(owner) and isvalid(owner.PlayerComponent) then self.Contributors[owner.PlayerComponent.UserId] = owner end
    end

    @ExecSpace("ServerOnly")
    method table RewardPlayers(Entity killer)
        -- 개인 보상(D3·이모탈): 피해를 준 플레이어 + 막타 친 사람 근처의 파티원. 같은 맵에 있는 사람만, 막타 친 사람이 맨 앞
        local list = {}
        local seen = {}
        local map = self.Entity.CurrentMap
        local function add(p)
            if not isvalid(p) or not isvalid(p.PlayerComponent) or p.CurrentMap ~= map then return end
            local id = p.PlayerComponent.UserId
            if seen[id] then return end
            seen[id] = true
            table.insert(list, p)
        end
        add(killer)
        for _, p in pairs(self.Contributors) do add(p) end
        for _, p in ipairs(_PartySystem:NearbyMembers(killer, self.Entity)) do add(p) end
        return list
    end

    @ExecSpace("ServerOnly")
    method void HitReact(Entity attacker, number damage)
        -- 명중의 빛/소리는 매번, 행동 중단은 누적 충격과 회복 시간을 통과했을 때만.
        local status = self:Status()
        if status ~= nil then status:ReactToHit(attacker, damage) end
    end

    @ExecSpace("ServerOnly")
    method void Die()
        -- 사망 연출 → MonsterKilled 이벤트 → 숨김 → 리스폰 예약 (또는 제거)
        if self.IsDead then return end
        self.IsDead = true
        if _Telemetry.DpsOn then _Telemetry:DpsNote(self, "death", self.Hp) end
        if self.SummonDmgAcc > 0 or self.SummonDmgTimer ~= 0 then self:FlushSummonDamage() end
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil then attack:CancelPending() end
        local sc = self.Entity.StateComponent
        if isvalid(sc) then sc:ChangeState("DEAD") end
        self:SpreadPoison()
        local status = self:Status()
        if status ~= nil then status:OnDeathSpread() end   -- 역병 저주 · 서리 혼 「파쇄」 (10-20)
        local killer = _Util:OwnerPlayerOf(self.LastAttacker)
        -- 10-28 사용자: 내가 직접(소환수 말고) 막타를 넣은 몬스터는 막타 주인 화면에만 사망 연출 (PlayDeathSound → LastHitFlourish)
        local directId = ""
        if killer ~= nil and isvalid(killer) and self.LastAttacker == killer and isvalid(killer.PlayerComponent) then directId = killer.PlayerComponent.UserId end
        self:PlayDeathSound(self.Entity.TransformComponent.WorldPosition, self.Grade, directId)
        _GameEvents:Emit("MonsterKilled", {
            monster = self.Entity, player = killer, players = self:RewardPlayers(killer),
            sourceId = self.SourceId, grade = self.Grade, rank = self:GetRank(), level = self.Level, variant = self:GetVariant(), map = self.Entity.CurrentMap,
            nest = self.Entity:GetComponent("script.MonsterNest") ~= nil, named = self.NamedId, boss = self:IsFieldBoss(), horde = self.Horde,
        })
        ---@type MonsterBehavior
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and behavior.Mode == "coward" then behavior:AlertPack() end
        -- 10-28 사용자: 의뢰 보스(맵에 놓인 보스 · 이름 있는 끝방 우두머리)를 쓰러뜨리면 그 자리 옆에 마을로 가는 포털 (보고하러 걸어 돌아가지 않게)
        if killer ~= nil and isvalid(killer) and (self:IsFieldBoss() or self.NamedId ~= "") then
            ---@type PlayerTravel
            local travel = killer:GetComponent("script.PlayerTravel")
            if travel ~= nil then travel:OpenBossPortal(self.Entity.CurrentMap, _Util:Pos2(self.Entity), self:ShownName()) end
        end
        _TimerService:SetTimerOnce(function() self:Hide() end, self.HideDelay)
        if self.RespawnDelay < 0 then
            _TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self.Entity:Destroy() end end, self.HideDelay + 0.2)
            return
        end
        local delay = self.RespawnDelay
        if self:IsFieldBoss() then
            -- 맵에 놓인 보스(처형인·여왕 등): bossRespawnSec(5분) 뒤, 남은 시간은 미니맵 머리글에 (10-11)
            _BossRespawn:Start(self.Entity.CurrentMap.Name, self:ShownName())
            _Util:NotifyMap(self.Entity.CurrentMap, _BossRespawn:DownText(self:ShownName()))
            _TimerService:SetTimerOnce(function() self:WaitBossRespawn() end, 1)
            return
        end
        _TimerService:SetTimerOnce(function() self:TryRespawn() end, delay)
    end

    @ExecSpace("ServerOnly")
    method void SetPlayerHpMul(number mul)
        -- 같은 맵 인원이 바뀌었다: 지금 최대 생명을 비율로 바꾸고 남은 생명 비율은 그대로 (이름 있는 적·이벤트 배율이 이미 곱해져 있어 다시 계산하지 않는다)
        if mul <= 0 or math.abs(mul - self.PlayerHpMul) < 0.001 then return end
        local ratio = self.MaxHp > 0 and self.Hp / self.MaxHp or 1
        local hpBefore = self.Hp
        self.MaxHp = math.max(1, self.MaxHp / self.PlayerHpMul * mul)
        self.PlayerHpMul = mul
        if not self.IsDead then self.Hp = math.max(1, self.MaxHp * ratio) end
        if _Telemetry.DpsOn and not self.IsDead then _Telemetry:DpsNote(self, "scale", hpBefore) end   -- 인원 보정: HP가 줄어도 피해가 아니다
    end

    @ExecSpace("ServerOnly")
    method void ResetForEmptyMap()
        -- 맵이 비었다 (CoopRules): 보스·이름 있는 적은 생명과 기여자를 처음으로 — 남이 깎아 둔 보스를 막타만 치고 보상·의뢰를 가져가지 않게
        if self.IsDead then return end
        if self.Hp >= self.MaxHp and next(self.Contributors) == nil then return end
        local hpBefore = self.Hp
        self.Hp = self.MaxHp
        if _Telemetry.DpsOn then _Telemetry:DpsNote(self, "reset", hpBefore) end   -- 새 시도: 이전 전투의 TTK와 잇지 않는다
        self.Contributors = {}
        self.LastAttacker = nil
        log("[VRF] boss reset (map empty) " .. self:ShownName())
    end

    @ExecSpace("ServerOnly")
    method void WaitBossRespawn()
        -- 고정 보스 재등장: 남은 시간(BossRespawn)을 1초마다 본다 — 의뢰가 남은 사람이 오면 CoopRules가 남은 시간을 줄인다 (10-13 M1)
        if not isvalid(self.Entity) or not self.IsDead then return end
        if _BossRespawn:Remaining(self.Entity.CurrentMap.Name, self:ShownName()) > 0 then
            _TimerService:SetTimerOnce(function() self:WaitBossRespawn() end, 1)
            return
        end
        self:TryRespawn()
    end

    method boolean IsFieldBoss()
        -- 다시 나오는 보스 (고유 이름 또는 보스 등급, 리스폰 있음). 소환된 졸개·심도·끝방 이름 있는 적은 RespawnDelay < 0
        return self.RespawnDelay >= 0 and (self.Unique or self.Grade >= 3)
    end

    method string ShownName()
        if self.DisplayName ~= "" then return self.DisplayName end
        return _GameData:GetMonsterName(self.SourceId)
    end

    @ExecSpace("ServerOnly")
    method void SpreadPoison()
        -- 독 확산(패시브): 독에 걸린 채 죽으면 주변 적에게 같은 독이 옮는다. 독을 건 플레이어의 스킬 레벨 기준.
        local status = self:Status()
        if status == nil or status.PoisonDps <= 0 or _UtilLogic.ElapsedSeconds > status.PoisonUntil then return end
        local source = status.PoisonSource
        if not isvalid(source) then return end
        ---@type SkillBook
        local book = source:GetComponent("script.SkillBook")
        if book == nil then return end
        local lv = book:Node("poison_spread")
        if lv <= 0 then return end
        local radius = book:GetEffectPower("poison_spread", lv)
        local dps = status.PoisonDps
        local p = _Util:Pos2(self.Entity)
        local n = 0
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, p, radius)) do
            if m.Entity ~= self.Entity then
                m:ApplyPoison(dps, 2.5, source)
                n = n + 1
            end
        end
        if n > 0 then
            ---@type SkillEffects
            local fx = source:GetComponent("script.SkillEffects")
            if fx ~= nil then fx:Fx("poison", Vector3(p.x, p.y, 0), radius) end
        end
    end

    @ExecSpace("ServerOnly")
    method void TryRespawn()
        -- D2처럼 눈앞에서 되살아나지 않는다: 처음 위치 가까이에 플레이어가 있으면 잠시 뒤 다시 시도
        if not isvalid(self.Entity) or not self.IsDead then return end
        if self:IsFieldBoss() then
            -- 보스는 기다린 사람 앞에 그대로 나온다 (팰월드처럼 시간이 되면 등장)
            self:Respawn()
            _BossRespawn:Clear(self.Entity.CurrentMap.Name, self:ShownName())
            _Util:NotifyMap(self.Entity.CurrentMap, self:ShownName() .. "이(가) 다시 나타났다")
            return
        end
        -- 작은 맵(버려진 우물 24×16 등)은 어디서나 6칸 안에 걸려 거의 되살아나지 않았다 → 숨는 거리를 맵 짧은 변의 1/4까지 줄인다 (10-24)
        local hide = _GameData.respawnHideRadius
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(self.Entity.CurrentMap.Name))
        if info ~= nil and info.w ~= nil and info.h ~= nil then hide = math.min(hide, math.max(3, math.min(info.w, info.h) * 0.25)) end
        -- 포털(플레이어가 연 마을 포털 포함)·웨이포인트 곁 자리는 되살아나지 않고 미룬다 — 그 포털로 돌아온 사람이 바로 둘러싸이지 않게
        local map = self.Entity.CurrentMap
        local safe = _GameConst:EntrySafeRadius(map.Name)
        local nearGate = _Util:NearestComponent(map, "script.WarpGate", self.SpawnPosition, safe) ~= nil
            or _Util:NearestComponent(map, "script.Waypoint", self.SpawnPosition, safe) ~= nil
        if nearGate or _Util:NearestPlayerDistance(map, self.SpawnPosition) < hide then
            _TimerService:SetTimerOnce(function() self:TryRespawn() end, 5)
            return
        end
        self:Respawn()
    end

    @ExecSpace("Multicast")
    method void PlayDeathSound(Vector3 pos, integer grade, string directKillerId)
        local me = _UserService.LocalPlayer
        if isvalid(me) and me.CurrentMap == self.Entity.CurrentMap then
            _SoundDirector:PlayMonsterDeath(self.SourceId, pos)   -- 몬스터별 사망음 (config hitSoundMode)
            _EffectService:PlayEffect(_GameConst.FxDeath, self.Entity, Vector3(pos.x, pos.y + 0.3, 0), 0, Vector3(0.7, 0.7, 1), false, { PlayRate = 1.6 })
            if grade == 2 then self:EliteBurst(me.CurrentMap, pos) end
            if directKillerId ~= "" and isvalid(me.PlayerComponent) and me.PlayerComponent.UserId == directKillerId then self:LastHitFlourish(me, pos, grade) end
        end
    end

    method string GoreKind()
        -- 막타 연출 재질: 뼈(해골·미라·망자) · 혼(망령·그림자) · 바위(골렘·수호상) · 나머지는 살점
        local id = self.SourceId
        local bone = { skelwarrior = true, skelcaptain = true, gravequeen = true, bonenest = true, mummy = true, tombking = true, ashendead = true }
        if bone[id] then return "bone" end
        if string.find(id, "wraith", 1, true) ~= nil or string.find(id, "shade", 1, true) ~= nil then return "spirit" end
        if string.find(id, "golem", 1, true) ~= nil or id == "templeguard" then return "stone" end
        return "flesh"
    end

    @ExecSpace("ClientOnly")
    method void LastHitFlourish(Entity me, Vector3 pos, integer grade)
        -- 10-28 사용자 「내 막타 사망 연출」: 흰 번쩍 → 붉게 물들고 → 검게 타들어 사라짐 + 재질 파편 (막타 주인 화면만).
        -- 한 방에 여럿(뼈 폭풍·파동)이면 0.25초 안 4마리까지 (높은 등급은 늘 보인다). 모바일은 파편 절반
        ---@type PlayerAttack
        local atk = me:GetComponent("script.PlayerAttack")
        local now = _UtilLogic.ElapsedSeconds
        if atk ~= nil then
            if now - atk.FlourishWindowAt > 0.25 then atk.FlourishWindowAt = now atk.FlourishCount = 0 end
            atk.FlourishCount = atk.FlourishCount + 1
            if atk.FlourishCount > 4 and grade < 2 then return end
        end
        local map = me.CurrentMap
        local kind = self:GoreKind()
        local mobile = Environment:IsMobilePlatform()
        local size = (grade >= 2 and 1.6 or 1) * (mobile and 0.6 or 1)
        local fx = {
            bone = { BasicParticleType.DustExplosion, Color(0.94, 0.9, 0.8, 1), 0.55 },
            flesh = { BasicParticleType.GoopSpray, Color(0.5, 0.04, 0.05, 1), 0.45 },
            spirit = { BasicParticleType.SparkRadialExplosion, Color(0.6, 0.78, 1, 1), 0.5 },
            stone = { BasicParticleType.DustExplosion, Color(0.55, 0.5, 0.44, 1), 0.7 },
        }
        local f = fx[kind]
        local at = Vector3(pos.x, pos.y + 0.35, pos.z - 0.05)
        _ParticleService:PlayBasicParticle(f[1], map, at, 0, Vector3(f[3] * size, f[3] * size, 1), false, { Color = f[2] })
        -- 몸 색: 흰 번쩍(0.06) → 붉게(0.2) → 검게 타들며 흐려짐 (서버가 0.8초에 숨긴다). 큰 적은 한 박자 멈췄다 천천히
        local sr = self.Entity.SpriteRendererComponent
        if not isvalid(sr) then return end
        local slow = grade >= 3 and 1.25 or 1   -- 서버가 0.8초에 숨기므로 그 안에서만 늘인다
        local steps = {
            { 0, Color(1, 1, 1, 1) },
            { 0.06, Color(1, 0.35, 0.3, 1) },
            { 0.2, Color(0.55, 0.12, 0.1, 1) },
            { 0.32, Color(0.14, 0.09, 0.08, 0.85) },
            { 0.5, Color(0.08, 0.05, 0.05, 0.35) },
            { 0.62, Color(0.05, 0.03, 0.03, 0) },
        }
        local entity = self.Entity
        local base = sr.Color
        for _, st in ipairs(steps) do
            local c = st[2]
            _TimerService:SetTimerOnce(function() if isvalid(entity) and isvalid(entity.SpriteRendererComponent) then entity.SpriteRendererComponent.Color = c end end, st[1] * slow)
        end
        -- 같은 개체가 다시 살아난다 (Respawn) — 숨겨진 뒤 원래 색으로 되돌려 둔다 (안 그러면 이 화면에서만 투명하게 다시 나온다)
        _TimerService:SetTimerOnce(function() if isvalid(entity) and isvalid(entity.SpriteRendererComponent) then entity.SpriteRendererComponent.Color = base end end, math.max(0.95, 0.62 * slow + 0.3))
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] last hit flourish %s %s grade=%d", self.SourceId, kind, grade)) end
    end

    @ExecSpace("ClientOnly")
    method void EliteBurst(Entity map, Vector3 pos)
        -- 정예 처치 파열 (코덱스 feel-fx-v2 6프레임 · 60~120ms): 정예를 잡았다는 손맛 — 클라이언트 전용 그림 하나를 잠깐 띄운다
        local ruids = {}
        for i = 1, 6 do table.insert(ruids, _GameData:GetUiIcon("fx_elite_burst_" .. tostring(i))) end
        if ruids[1] == "" or not isvalid(map) then return end
        local fx = _SpawnService:SpawnByModelId("artsprite", "EliteBurst", Vector3(pos.x, pos.y + 0.55, pos.z - 0.05), map)
        if not isvalid(fx) then return end
        local sp = fx.SpriteRendererComponent
        sp.SpriteRUID = ruids[1]
        sp.SortingLayer = "MapLayer0"
        sp.OrderInLayer = 7
        fx.TransformComponent.Scale = Vector3(0.85, 0.85, 1)   -- 256px → 2.2칸
        local delays = { 0.06, 0.07, 0.09, 0.09, 0.1, 0.12 }
        local t = 0
        for i = 2, 6 do
            t = t + delays[i - 1]
            local ruid = ruids[i]
            _TimerService:SetTimerOnce(function() if isvalid(fx) then fx.SpriteRendererComponent.SpriteRUID = ruid end end, t)
        end
        log("[VRF] elite burst start " .. self.SourceId)
        _TimerService:SetTimerOnce(function()
            if isvalid(fx) then fx:Destroy() end
            log("[VRF] elite burst end")
        end, t + delays[6])
    end

    @ExecSpace("ServerOnly")
    method void Hide()
        if not isvalid(self.Entity) then return end
        self.Entity:SetVisible(false)
        self.Entity:SetEnable(false)
    end

    @ExecSpace("ServerOnly")
    method void Respawn()
        -- 처음 위치에서 상태를 지우고 다시 등장 (선공하지 않는 상태로)
        if not isvalid(self.Entity) then return end
        self.LastAttacker = nil
        self.Contributors = {}
        local status = self:Status()
        if status ~= nil then status:Reset() end
        self.IsDead = false
        self:Reroll()
        if _Telemetry.DpsOn then _Telemetry:DpsNote(self, "respawn", -1) end   -- 같은 엔티티의 새 생명 (DpsLife 새 번호)
        local movement = self.Entity.MovementComponent
        if isvalid(movement) then movement:SetWorldPosition(self.SpawnPosition) end
        self.Entity:SetEnable(true)
        self.Entity:SetVisible(true)
        local sc = self.Entity.StateComponent
        if isvalid(sc) then sc:ChangeState("IDLE") end
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.IsChaseNearPlayer = false chase.Enable = true end
        ---@type MonsterAttack
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil then
            attack:CancelPending()
            attack:ResetChaseHold()   -- 10-31 A-3: 추격 이력·감지 범위 처음으로
        end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil then behavior:ResetBehavior() end
    end

end
