-- 액트 1 「목 없는 처형인 고드릭」 사형 선고 (docs/design/40 §2 — 10-28 사용자 A안).
--   생명 66% · 33%에서 한 번씩: 가장 가까운 플레이어 발밑에 낙인 원(MarkWarn초 동안 차오름) → 큰 도끼가 떨어져
--   원 안의 플레이어는 최대 생명의 MarkPct% 피해 + 휘청. 원 밖으로 나가면 피한다 (예고 → 피할 틈, 10-24 규칙).
--   공통 보스 틀(BossPattern)은 붙이지 않는다 — 액트 1 초반 난도를 올리지 않고 이 한 가지만 더한다.
-- 죽거나 맵에 플레이어가 없으면 처음 상태로 돌아간다.
@Component
script HeadsmanRite extends Component

    property integer Step = 0                -- 0 = 아직 · 1 = 66% 지남 · 2 = 33% 지남
    property number MarkWarn = 3
    property number MarkRadius = 1.8
    property number MarkPct = 35
    property integer MarkCount = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 시작 표시
        log("[VRF] HeadsmanRite ready")
    end

    method void OnUpdate(number delta)
        -- 서버만: 생명 비율이 문턱을 넘으면 사형 선고
        if not self:IsServer() then return end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil then return end
        if monster.IsDead or not self.Entity.Enable or #_Util:PlayersInMap(self.Entity.CurrentMap) == 0 then
            self:ResetRite()
            return
        end
        local ratio = monster.Hp / math.max(1, monster.MaxHp)
        if (self.Step == 0 and ratio <= 0.66) or (self.Step == 1 and ratio <= 0.33) then
            self.Step = ratio <= 0.33 and 2 or self.Step + 1
            self:Sentence()
        end
    end

    @ExecSpace("ServerOnly")
    method void Sentence()
        -- 가장 가까운 플레이어 발밑에 낙인 → MarkWarn초 뒤 그 자리에 도끼
        local map = self.Entity.CurrentMap
        local here = _Util:Pos2(self.Entity)
        local target = nil
        local best = 99
        for _, p in ipairs(_Util:PlayersNear(map, here, 14)) do
            local d = (_Util:Pos2(p) - here):Magnitude()
            if d < best then
                best = d
                target = p
            end
        end
        if target == nil then return end
        local at = _Util:Pos2(target)
        self.MarkCount = self.MarkCount + 1
        self:MarkFx(at, self.MarkRadius, self.MarkWarn)
        log(string.format("[VRF] headsman sentence %d at (%.1f,%.1f)", self.MarkCount, at.x, at.y))
        local serial = self.MarkCount
        _TimerService:SetTimerOnce(function()
            ---@type Monster
            local monster = self.Entity:GetComponent("script.Monster")
            if not isvalid(self.Entity) or monster == nil or monster.IsDead or self.Entity.CurrentMap ~= map or self.MarkCount ~= serial then return end
            local hit = 0
            for _, p in ipairs(_Util:PlayersNear(map, at, self.MarkRadius)) do
                ---@type PlayerVitals
                local vitals = p:GetComponent("script.PlayerVitals")
                ---@type PlayerStats
                local st = p:GetComponent("script.PlayerStats")
                if vitals ~= nil then vitals:TakeTickDamage(p.PlayerComponent.MaxHp * self.MarkPct / 100) end
                if st ~= nil then st:ApplyStagger(1.0) end
                hit = hit + 1
            end
            self:AxeFx(at, self.MarkRadius)
            log(string.format("[VRF] headsman axe %d hit=%d", serial, hit))
        end, self.MarkWarn)
    end

    @ExecSpace("Multicast")
    method void MarkFx(Vector2 at, number radius, number seconds)
        -- 낙인: 붉은 예고 원(차오름) + 처형인 몸에 붉은 기운
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayRiteCue("headsman", "start", self.Entity)   -- 의식 시작음 (39 #9 ②)
        _Util:Telegraph(self.Entity, at, radius, "", seconds)
        _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, self.Entity, Vector3(0, 0.8, 0), 0, Vector3(1.2, 1.2, 1), false, { Color = Color(1, 0.2, 0.15, 1) })
    end

    @ExecSpace("Multicast")
    method void AxeFx(Vector2 at, number radius)
        -- 도끼가 떨어짐: 붉은 충격 + 화면 흔들림
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayRiteCue("headsman", "done", self.Entity)
        _Util:ElementBurst(self.Entity, Vector3(at.x, at.y, 0), radius, "", Color(0.85, 0.12, 0.1, 1))
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) and (_Util:Pos2(me) - at):Magnitude() <= 10 then cam:ShakeCamera(0.45, 0.35) end
    end

    @ExecSpace("ServerOnly")
    method void ResetRite()
        -- 처음 상태로
        if self.Step == 0 then return end
        self.Step = 0
        self.MarkCount = self.MarkCount + 1   -- 떨어지기 전인 도끼는 취소
        log("[VRF] HeadsmanRite reset")
    end

end
