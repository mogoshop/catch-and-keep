-- 몬스터 공격 판정. 사거리 안의 가장 가까운 플레이어·그림자 하나를 일정 간격으로 친다 (이동은 AIChase/AIWander).
-- 피해 = 기본 × (쇠약·수식어 배율). 플레이어 대상이면 물리 부분은 방어로, 속성 부분은 저항으로 줄인다.
-- 보스 광역기는 Slam (단일 대상 제한 없음).
@Component
script MonsterAttack extends AttackComponent

    property integer Damage = 8
    property string Element = ""          -- 공격 속성 (fire/cold/light/poison). ElementRatio만큼이 그 속성
    property number ElementRatio = 0.5
    property number AttackRange = 0.8
    property number AttackRadius = 0.5
    property number AttackCooldown = 1.5
    property number ScanInterval = 0.4

    property integer BaseDamage = 0
    property number CooldownTimer = 0
    property number ScanTimer = 0
    property Entity CurrentTarget = nil
    property number SlamDamage = 0
    property number ArrowSpeed = 7
    property integer ShotCount = 0
    property number AttackWindup = 0.3
    property number AttackAnimationSeconds = 0.4
    property number AttackAnimationUntil = 0
    @Sync
    property integer AttackEpoch = 0
    property integer WarningSerial = 0
    property integer WarningTimer = 0
    property integer WarningEpoch = -1
    property integer WindupTimer = 0
    property integer RecoveryTimer = 0
    property integer StrikeCount = 0
    property integer CancelCount = 0
    property boolean DebugCombat = false

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 종별 준비/회복 시간을 구분하고 무리의 첫 타격이 한 프레임에 몰리지 않게 한다.
        self.Entity.StateComponent:AddState("ATTACK", MonsterAttackState)
        local body = self:Body()
        local source = body ~= nil and body.SourceId or ""
        self.AttackWindup = 0.35
        self.AttackAnimationSeconds = 0.65
        if source == "rot_zombie" or source == "headsman" then
            self.AttackWindup = 0.6
            self.AttackAnimationSeconds = 0.95
        elseif source == "skel_warrior" or source == "skel_captain" then
            self.AttackWindup = 0.42
            self.AttackAnimationSeconds = 0.72
        elseif source == "corpse_crow" or source == "brood_spider" then
            self.AttackWindup = 0.24
            self.AttackAnimationSeconds = 0.46
        elseif self.AttackRange > 1.5 then
            self.AttackWindup = 0.48
            self.AttackAnimationSeconds = 0.8
        end
        self.CooldownTimer = 0.15 + _UtilLogic:RandomDouble() * 0.3
    end

    method Monster Body()
        ---@type Monster
        local c = self.Entity:GetComponent("script.Monster")
        return c
    end

    @ExecSpace("ServerOnly")
    method void ScaleToLevel(integer baseLevel, integer level)
        -- Monster.ApplyLevel이 부른다: 모델 기본 피해 기준으로 레벨 보정
        if self.BaseDamage <= 0 then self.BaseDamage = self.Damage end
        self.Damage = math.floor(self.BaseDamage * (1 + _GameData.monsterDmgPerLevel * (level - baseLevel)) + 0.5)
    end

    @ExecSpace("ServerOnly")
    method void Slam(Vector2 center, number radius, number damage)
        self.SlamDamage = damage
        self.CurrentTarget = nil
        self:AttackFast(CircleShape(center, radius), "monster.slam", nil)
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        local body = self:Body()
        if body == nil or body.IsDead or not self.Entity.Enable then return end
        local status = body:Status()
        if status ~= nil and status:IsStunned() then return end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and not behavior:CanBeginAttack() then return end
        self.CooldownTimer = self.CooldownTimer - delta
        self.ScanTimer = self.ScanTimer - delta
        if _UtilLogic.ElapsedSeconds < self.AttackAnimationUntil or self.CooldownTimer > 0 or self.ScanTimer > 0 then return end
        self.ScanTimer = self.ScanInterval
        local target = self:FindTarget()
        if target == nil then return end
        self.CooldownTimer = self.AttackCooldown / body:GetAttackSpeedMultiplier()
        self:BeginAttack(target)
    end

    @ExecSpace("ServerOnly")
    method void BeginAttack(Entity target)
        local body = self:Body()
        if body == nil or body.IsDead or not self:IsLiveDefender(target) then return end
        if not self.Entity.Enable then return end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and not behavior:CanBeginAttack() then return end
        local map = self.Entity.CurrentMap
        local aim = _Util:Pos2(target)
        if not _Util:HasLineOfSight(map, _Util:Pos2(self.Entity), aim) then return end
        self.AttackEpoch = self.AttackEpoch + 1
        local epoch = self.AttackEpoch
        self.CurrentTarget = target
        self.AttackAnimationUntil = _UtilLogic.ElapsedSeconds + self.AttackAnimationSeconds
        local chase = self.Entity.AIChaseComponent
        local resumeChase = isvalid(chase) and chase.Enable
        if isvalid(chase) then chase.Enable = false end
        self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
        local dx = aim.x - _Util:Pos2(self.Entity).x
        if math.abs(dx) > 0.05 then self.Entity.SpriteRendererComponent.FlipX = dx > 0 end
        -- 근접은 공격을 시작할 때 바라본 방향 앞쪽만 친다 (등 뒤·옆으로 빠지면 빗나간다)
        local face = aim - _Util:Pos2(self.Entity)
        if face:Magnitude() < 0.05 then face = Vector2(dx >= 0 and 1 or -1, 0) end
        face = face:Normalize()
        self.Entity.StateComponent:ChangeState("ATTACK")
        self:WindupFx(face, self.AttackWindup, epoch)
        if self.DebugCombat then log("[VRF-COMBAT] enemy windup epoch=" .. tostring(epoch)) end
        self.WindupTimer = _TimerService:SetTimerOnce(function()
            self.WindupTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or body.IsDead or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            if not self:IsLiveDefender(target) then return end
            if not _Util:HasLineOfSight(map, _Util:Pos2(self.Entity), aim) then return end
            self.StrikeCount = self.StrikeCount + 1
            if self.DebugCombat then log("[VRF-COMBAT] enemy active epoch=" .. tostring(epoch)) end
            if self.AttackRange > 1.5 then self:Shoot(aim) return end
            -- 준비 동작을 보고 옆·뒤로 빠지면 피할 수 있게: 지금 몬스터 위치에서 처음 바라본 방향 앞쪽 원
            local reach = math.max(0.4, self.AttackRange * 0.55)
            local center = _Util:Pos2(self.Entity) + face * reach + Vector2(0, 0.3)
            self:AttackFast(CircleShape(center, reach), "monster.basic", nil)
            self:SwingFx(Vector3(center.x, center.y, 0), face)
        end, self.AttackWindup)
        self.RecoveryTimer = _TimerService:SetTimerOnce(function()
            self.RecoveryTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or body.IsDead or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            if self.Entity.StateComponent.CurrentStateName == "ATTACK" then self.Entity.StateComponent:ChangeState("IDLE") end
            if behavior ~= nil then behavior:ResumeMovement()
            elseif isvalid(chase) then chase.Enable = resumeChase end
        end, self.AttackAnimationSeconds)
    end

    @ExecSpace("ServerOnly")
    method void CancelPending()
        -- 중단한 공격의 지연 타이머는 경직이 풀려도 되살리지 않는다.
        if self.WindupTimer ~= 0 then _TimerService:ClearTimer(self.WindupTimer) self.WindupTimer = 0 end
        if self.RecoveryTimer ~= 0 then _TimerService:ClearTimer(self.RecoveryTimer) self.RecoveryTimer = 0 end
        self.AttackEpoch = self.AttackEpoch + 1
        self.CancelCount = self.CancelCount + 1
        self.AttackAnimationUntil = 0
        self.CurrentTarget = nil
        self.CooldownTimer = math.max(self.CooldownTimer, 0.35)
        if isvalid(self.Entity) and isvalid(self.Entity.StateComponent) and self.Entity.StateComponent.CurrentStateName == "ATTACK" then
            self.Entity.StateComponent:ChangeState("IDLE")
        end
    end

    @ExecSpace("Multicast")
    method void WindupFx(Vector2 dir, number duration, integer epoch)
        -- 공격 방향의 짧은 지면 표시. 준비가 끝나면 제거해 실제 궤적과 겹치지 않는다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        if epoch < self.AttackEpoch then return end
        self:ClearWindup()
        self.WarningEpoch = epoch
        local reach = math.max(0.4, self.AttackRange * 0.55)
        if self.AttackRange > 1.5 then reach = 0.3 end
        local p = self.Entity.TransformComponent.WorldPosition
        local pos = Vector3(p.x + dir.x * reach, p.y + dir.y * reach + 0.3, p.z)
        self.WarningSerial = _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, Vector3(reach, reach, 1), true, { Color = Color(0.8, 0.35, 0.18, 0.38) })
        self.WarningTimer = _TimerService:SetTimerOnce(function()
            self.WarningTimer = 0
            if self.WarningEpoch == epoch then self:ClearWindup() end
        end, duration)
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- 공격 중단/새 공격의 epoch가 오면 이전 경고 원도 즉시 제거한다.
        if name == "AttackEpoch" and self.WarningEpoch >= 0 and self.WarningEpoch ~= value then self:ClearWindup() end
    end

    @ExecSpace("ClientOnly")
    method void ClearWindup()
        -- 경고 입자와 제거 타이머를 함께 정리한다.
        if self.WarningTimer ~= 0 then _TimerService:ClearTimer(self.WarningTimer) self.WarningTimer = 0 end
        if self.WarningSerial ~= 0 then _ParticleService:RemoveParticle(self.WarningSerial) self.WarningSerial = 0 end
        self.WarningEpoch = -1
    end

    method void OnEndPlay()
        -- 폐기한 적의 판정과 경고가 다음 세션에 남지 않게 한다.
        if self:IsServer() then self:CancelPending() else self:ClearWindup() end
    end

    @ExecSpace("Multicast")
    method void SwingFx(Vector3 pos, Vector2 dir)
        -- 몬스터 근접 궤적: 실제 판정 범위(앞쪽)를 보여 준다. 리소스가 왼쪽을 보므로 오른쪽이면 뒤집는다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local right = dir.x >= 0
        local rot = math.deg(math.atan(dir.y, dir.x))
        if not right then rot = rot - 180 end
        if rot > 180 then rot = rot - 360 elseif rot < -180 then rot = rot + 360 end
        _EffectService:PlayEffect(_GameConst.FxSlash, self.Entity, pos, rot, Vector3(0.45, 0.45, 1), false, { FlipX = right, PlayRate = 1.4, Color = Color(1, 0.45, 0.4, 0.85) })
    end

    method boolean IsLiveDefender(Entity target)
        if not isvalid(target) or not target.Enable or target.CurrentMap ~= self.Entity.CurrentMap then return false end
        if isvalid(target.PlayerComponent) then return target.PlayerComponent.Hp > 0 end
        local unit = target:GetComponent("script.ShadowUnit")
        return unit ~= nil and not unit.Dead and unit.Hp > 0
    end

    @ExecSpace("ServerOnly")
    method void Shoot(Vector2 aim)
        -- 화살 투사체 (초속 ArrowSpeed, 사거리 + 1.5, 첫 대상에서 멈춤). 속성이 있으면 그 색으로 물든다
        local my = _Util:Pos2(self.Entity)
        local dir = aim - my
        if dir:Magnitude() < 0.05 then return end
        dir = dir:Normalize()
        local start = my + Vector2(0, 0.4) + dir * 0.3
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "Arrow_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), self.Entity.CurrentMap)
        if not isvalid(shot) then return end
        local owner = self.Entity
        local originMap = self.Entity.CurrentMap
        local color = self:ElementColor(self:GetElement())
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            local body = isvalid(owner) and owner:GetComponent("script.Monster") or nil
            if body == nil or body.IsDead or not owner.Enable or owner.CurrentMap ~= originMap then
                if isvalid(shot) then shot:Destroy() end
                return
            end
            shot.SpriteRendererComponent.SpriteRUID = _GameConst.SpriteArrow
            shot.SpriteRendererComponent.Color = color
            shot.TransformComponent.Scale = Vector3(1.6, 1.6, 1)
            proj.AngleOffset = 0
            proj.Team = "monster"
            proj.HeightOffset = 0.4
            proj.Radius = 0.4
            proj:Launch(owner, dir, self.ArrowSpeed, self.AttackRange + 1.5, 0, "monster.arrow", false)
        end, function()
            if isvalid(shot) then shot:Destroy() end
        end)
    end

    @ExecSpace("ServerOnly")
    method void HitOne(Entity target)
        -- 투사체가 닿은 대상 하나에 기본 공격 피해 (IsAttackTarget이 CurrentTarget만 통과시킨다)
        if not isvalid(target) then return end
        self.CurrentTarget = target
        local q = target.TransformComponent.WorldPosition
        self:AttackFast(CircleShape(Vector2(q.x, q.y + 0.3), 0.5), "monster.basic", nil)
    end

    method Color ElementColor(string element)
        if element == "fire" then return Color(1, 0.6, 0.35, 1) end
        if element == "cold" then return Color(0.6, 0.85, 1, 1) end
        if element == "light" then return Color(1, 1, 0.6, 1) end
        if element == "poison" then return Color(0.6, 1, 0.5, 1) end
        return Color(1, 1, 1, 1)
    end

    @ExecSpace("ServerOnly")
    method Entity FindTarget()
        -- 공격과 거리 유지가 같은 대상 선정 기준을 사용한다.
        return self:FindDefender(self.AttackRange)
    end

    @ExecSpace("ServerOnly")
    method Entity FindDefender(number range)
        -- 감지 범위 안의 가장 가까운 살아 있는 플레이어·소환수. 장애물 뒤 대상은 제외한다.
        local map = self.Entity.CurrentMap
        local myPos = _Util:Pos2(self.Entity)
        local best = nil
        if not isvalid(map) then return nil end
        local bestDist = range
        for _, u in ipairs(_Util:PlayersNear(map, myPos, range)) do
            local d = _Util:Distance(u, self.Entity)
            if d <= bestDist and self:IsLiveDefender(u) and _Util:HasLineOfSight(map, myPos, _Util:Pos2(u)) then
                bestDist = d
                best = u
            end
        end
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            local d = _Util:Distance(c.Entity, self.Entity)
            if d <= bestDist and self:IsLiveDefender(c.Entity) and _Util:HasLineOfSight(map, myPos, _Util:Pos2(c.Entity)) then
                bestDist = d
                best = c.Entity
            end
        end
        return best
    end

    method string GetElement()
        local body = self:Body()
        if body ~= nil and body:GetAffixElement() ~= "" then return body:GetAffixElement() end
        return self.Element
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        local dmg = self.Damage
        if attackInfo == "monster.slam" then dmg = self.SlamDamage end
        local body = self:Body()
        if body ~= nil then dmg = dmg * body:GetDamageDealtMultiplier() end
        local element = self:GetElement()
        local ratio = 0
        if element ~= "" then ratio = self.ElementRatio end
        if body ~= nil and body:GetAffixElement() ~= "" then ratio = math.min(1, ratio + 0.5) end
        ---@type ShadowUnit
        local shadow = defender:GetComponent("script.ShadowUnit")
        if shadow ~= nil and ratio > 0 then
            -- 그림자도 원본 몬스터의 저항을 이어받는다
            local elem = dmg * ratio
            dmg = dmg - elem + elem * math.max(0, 1 - shadow:GetResist(element) / 100)
        end
        if isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local stats = defender:GetComponent("script.PlayerStats")
            local phys = dmg * (1 - ratio)
            local elem = dmg * ratio
            if stats ~= nil then
                phys = phys * (100 / (100 + stats.BonusDefense))
                elem = elem * math.max(0, 1 - stats:GetResist(element) / 100)
            end
            dmg = phys + elem
        end
        return math.max(1, math.floor(dmg + 0.5))
    end

    method void OnAttack(Entity defender)
        -- 냉기 공격은 플레이어 둔화 / 특수 행동(치고 빠지기)에 알림
        if not self:IsServer() then return end
        if self:GetElement() == "cold" and isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local stats = defender:GetComponent("script.PlayerStats")
            if stats ~= nil then stats:ApplyChill(1.5) end
        end
        ---@type MonsterBehavior
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil then behavior:OnAttacked(defender) end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 고른 대상 하나만 (광역기는 범위 전체). 살아 있는 플레이어와 그림자만
        if attackInfo ~= "monster.slam" and defender ~= self.CurrentTarget then return false end
        if attackInfo == "monster.basic" and not _Util:HasLineOfSight(self.Entity.CurrentMap, _Util:Pos2(self.Entity), _Util:Pos2(defender)) then return false end
        if isvalid(defender.PlayerComponent) then
            if defender.PlayerComponent:IsDead() then return false end
            -- 무적 시간·사망 처리 중이면 제외 (엔진이 맞자마자 생명을 깎으므로 여기서 막아야 한다)
            ---@type PlayerVitals
            local vitals = defender:GetComponent("script.PlayerVitals")
            if vitals ~= nil and not vitals:CanBeHit() then return false end
            return __base:IsAttackTarget(defender, attackInfo)
        end
        if defender:GetComponent("script.ShadowUnit") ~= nil then return __base:IsAttackTarget(defender, attackInfo) end
        return false
    end

end
