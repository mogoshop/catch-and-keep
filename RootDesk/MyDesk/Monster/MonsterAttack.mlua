-- 몬스터 공격 판정. 사거리 안의 가장 가까운 플레이어·그림자 하나를 일정 간격으로 친다 (이동은 AIChase/AIWander).
-- 피해 = 기본 × (쇠약·수식어 배율). 플레이어 대상이면 물리 부분은 방어로, 속성 부분은 저항으로 줄인다.
-- 보스 광역기는 Slam (단일 대상 제한 없음).
-- 10-31 사용자 실플레이 「몹이 산만하게 앞뒤로 왔다갔다 — 올 거면 확실히 와라」 (갈래 A-3):
--   추격 이력(UpdateChaseHold) — 네이티브 AIChase는 대상이 DetectionRange를 넘나들 때마다 추격↔멈춤을 바로 바꾼다(스크립트에 전환 줄이 없다).
--   그래서 감지 범위를 이력으로 바꿔 쓴다: 감지(기본 DetectionRange) 안에 들면 추격 시작 → ChaseHoldSec 동안은 놓치지 않음(범위 ×LoseMul×1.5) →
--   그 뒤 놓치는 거리 = 감지 ×LoseMul → 놓치면 WanderPauseSec 동안 멈췄다가 원래 동작으로. 떼·유입·보스 패턴·다른 곳이 범위를 바꾼 몬스터는 손대지 않는다.
--   근접 간격(UpdateMeleeSpacing) — 공격 사거리(FindTarget과 같은 AttackRange+0.15) 안이면 멈춰서 공격만(물러나기·옆 비키기 없음), 자리 잡기는 사거리 밖에서만.
@Component
script MonsterAttack extends AttackComponent

    property Entity Taunter = nil              -- 방패 해골 도발 (TauntBy)
    property number TauntUntil = 0
    property integer Damage = 8
    property string Element = ""          -- 공격 속성 (fire/cold/light/poison). ElementRatio만큼이 그 속성
    property number ElementRatio = 0.5
    property number AttackRange = 0.8
    property number AttackRadius = 0.5
    property number AttackCooldown = 1.5
    property boolean SkipPlayers = false      -- 지속 피해(독안개) 판정 중: 플레이어는 TickPlayer로 따로 (맞을 때마다 0.8초 무적이 걸리지 않게)
    property number BasicMul = 1              -- 기본 공격(근접·화살·연쇄)에만 곱하는 배율 (bosses.csv basicMul — 액트 보스가 주변 몹보다 약하게 때리던 문제, 10-23)
    property number ScanInterval = 0.4

    property integer BaseDamage = 0
    property number CooldownTimer = 0
    property number ScanTimer = 0
    property Entity CurrentTarget = nil
    property boolean SpacingControlled = false
    property number SpacingTimer = 0
    property number NeighborSpacing = 0.45
    property integer SpacingMode = 0             -- 근접 간격: 0 멈춤 · 1 다가감 (상태를 유지해 제자리 꿈틀거림을 없앤다, 10-10 QA · 10-31 A-3부터 물러남 -1 없음)
    property number SlamDamage = 0
    property string SlamElement = ""       -- 변종 기술 속성 (화염·냉기·번개·독). 그 판정 동안만 피해 전부가 이 속성
    property number ArrowSpeed = 7
    property integer ShotCount = 0
    @Sync
    property number AttackWindup = 0.3           -- 공격 준비 시간 (클라이언트 FrameAnimator가 타격 칸을 이 시점에 맞춘다)
    @Sync
    property number AttackAnimationSeconds = 0.4
    property number AttackAnimationUntil = 0
    property boolean ResumeChaseAfterAttack = false
    @Sync
    property integer AttackEpoch = 0
    property integer WarningSerial = 0
    property integer WarningTimer = 0
    property integer NovaTimer = 0
    property integer NovaTele = 0             -- 클라이언트: 범위 기술 예고 (Util.Telegraph id)
    property integer WindupTele = 0           -- 클라이언트: 근접 강타 예고 (Util.Telegraph id)
    property number WarnLineWidth = 0.1      -- 정예·변종 평타 예고 선 두께 (예전 0.65는 꽉 찬 붉은 점처럼 보였다)
    property string WarningOwner = ""
    property integer WarningEpoch = -1
    property integer WindupTimer = 0
    property integer RecoveryTimer = 0
    property integer StrikeCount = 0
    property integer CancelCount = 0
    property boolean DebugCombat = false
    property integer ChainJumps = 0           -- 번개 연쇄 튕김 수 (monsters.csv chain, 액트 3 — docs/design/17 §3). 0이면 보통 공격
    property number ChainMul = 1              -- 연쇄 한 번의 피해 배율 (튕길 때마다 ×0.85)
    property number ChainRange = 3            -- 다음 대상을 찾는 거리
    property Entity ChainTarget = nil         -- 지금 연쇄가 때리는 대상 하나
    @Sync
    property string Arch = ""                 -- 유형 동작 (archetypes.csv · docs/design/29). 보스·보스 패턴 몬스터는 "" (자기 패턴만)
    property number ReachMul = 1              -- 거구: 내려치기 범위 ×1.35
    property number ArchReadyAt = 0           -- 짐승 덮치기 · 암살자 돌아 들어가기 다음 가능 시각
    property integer ArchSerial = 0
    property integer DashCount = 0            -- 덮치기·돌아 들어가기 횟수 (검증용)
    property integer StaggerCount = 0         -- 거구 강타로 휘청이게 한 횟수 (검증용)
    property number ChaseHoldSec = 1.5        -- 10-31 A-3: 추격을 시작하면 최소 이 시간(초)은 놓치지 않는다
    property number LoseMul = 1.4             -- 10-31 A-3: 놓치는 거리 = 감지 거리(기본 DetectionRange) × 이 값
    property number WanderPauseSec = 0.6      -- 10-31 A-3: 놓친 뒤 원래 동작(배회)으로 돌아가기 전 멈춰 서는 시간(초)
    property number ChaseCheckSec = 0.2       -- 추격 이력 판단 간격(초)
    property integer ChaseState = 0           -- 추격 이력: 0 평소 · 1 추격 중 · 2 놓치고 멈춤 (MonsterSpawner.ChaseCounts가 1을 센다)
    property number ChaseSince = 0
    property boolean ChaseHeld = false        -- 추격 시작 뒤 ChaseHoldSec가 지났다 (범위를 감지×LoseMul로 내렸다)
    property number ChasePauseUntil = 0
    property number ChaseBaseDetect = 0       -- 처음 본 DetectionRange (모델 기본 감지 거리)
    property number ChaseWrote = 0            -- 마지막으로 이쪽이 쓴 DetectionRange (다르면 다른 곳이 바꾼 것 → 손 뗀다)
    property boolean ChaseExternal = false    -- 떼·유입·길 위 사건 등 다른 곳이 감지 범위를 정한 몬스터
    property boolean ChasePaused = false      -- 놓친 뒤 멈춤으로 이쪽이 추적을 껐다
    property number ChaseTimer = 0
    property integer ChaseLoseCount = 0       -- 놓친 횟수 (검증용)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 종별 준비/회복 시간을 구분하고 무리의 첫 타격이 한 프레임에 몰리지 않게 한다.
        self.Entity.StateComponent:AddState("ATTACK", MonsterAttackState)
        -- 서버는 빈 경고 렌더러를 마련하고 클라이언트가 공격 예고 동안만 그린다.
        local line = self.Entity.LineRendererComponent
        if not isvalid(line) then line = self.Entity:AddComponent("LineRendererComponent") end
        if isvalid(line) then
            line.SortingLayer = "MapLayer0"
            line.OrderInLayer = 2
            line.IsFlexible = false
            line.IsSmooth = false
            line.Loop = false
            line.Points:Clear()
        end
        local body = self:Body()
        local source = body ~= nil and body.SourceId or ""
        self.AttackWindup = 0.35
        self.AttackAnimationSeconds = 0.65
        if source == "rot_zombie" or source == "headsman" then
            self.AttackWindup = 0.6
            self.AttackAnimationSeconds = 0.95
        elseif source == "skel_warrior" or source == "skel_captain" then
            self.AttackWindup = 0.42
            self.AttackAnimationSeconds = 0.72
        elseif source == "corpse_crow" or source == "brood_spider" then
            self.AttackWindup = 0.24
            self.AttackAnimationSeconds = 0.46
        elseif self.AttackRange > 1.5 then
            self.AttackWindup = 0.48
            self.AttackAnimationSeconds = 0.8
        end
        -- 유형 동작: 거구는 크게 들었다 내려친다 (예고가 길고 범위가 넓다) · 짐승·암살자는 짧고 빠르다
        local bossLike = body == nil or body.Grade >= 3 or self.Entity:GetComponent("script.BossPattern") ~= nil
        self.Arch = bossLike and "" or _GameData:ArchetypeOf(source)
        if self.Arch == "brute" then
            self.AttackWindup = 0.8
            self.AttackAnimationSeconds = 1.2
            self.ReachMul = 1.35
        elseif self.Arch == "beast" or self.Arch == "assassin" then
            self.AttackWindup = 0.24
            self.AttackAnimationSeconds = 0.5
        end
        self.ArchReadyAt = _UtilLogic.ElapsedSeconds + 1 + _UtilLogic:RandomDouble() * 2
        local stats = _GameData:GetMonsterStats(source)
        self.ChainJumps = stats ~= nil and math.floor(stats.chain or 0) or 0
        if self.ChainJumps > 0 then
            -- 번개 연쇄: 첫 대상 발밑에 0.6초 예고 (처음 보는 공격은 예고 — 06장)
            self.AttackWindup = 0.6
            self.AttackAnimationSeconds = 1.0
        end
        self.CooldownTimer = 0.15 + _UtilLogic:RandomDouble() * 0.3
    end

    method Monster Body()
        ---@type Monster
        local c = self.Entity:GetComponent("script.Monster")
        return c
    end

    @ExecSpace("ServerOnly")
    method void ScaleToLevel(integer baseLevel, integer level)
        -- Monster.ApplyLevel이 부른다: 모델 기본 피해 기준으로 레벨 보정
        if self.BaseDamage <= 0 then self.BaseDamage = self.Damage end
        local body = self:Body()
        local mul = body ~= nil and (body.StatMul * body.DiffDmgMul) or 1   -- 맵 공격 배율 (MapAmbience.StatMul) × 난이도 공격 배율
        -- 생명(Monster.RecomputeMaxHp)과 같은 비율식 (10-23: 예전 1 + 0.2(L − 모델 레벨)은 모델 레벨이 높은 보스가 악몽·지옥에서 생명 ×1.7인데 공격 ×7이 됐다.
        --  모델 레벨이 1인 몬스터와 제 레벨에 놓인 보스는 값이 같다)
        local k = _GameData.monsterDmgPerLevel
        self.Damage = math.floor(self.BaseDamage * (1 + k * (level - 1)) / (1 + k * (math.max(1, baseLevel) - 1)) * mul + 0.5)
    end

    @ExecSpace("ServerOnly")
    method void Slam(Vector2 center, number radius, number damage)
        self.SlamDamage = damage
        self.CurrentTarget = nil
        self:AttackFast(CircleShape(center, radius), "monster.slam", nil)
    end

    @ExecSpace("ServerOnly")
    method void SlamWithElement(Vector2 center, number radius, number damage, string element)
        -- 속성 범위 기술 (판정은 동기라 끝나면 바로 되돌린다)
        self.SlamElement = element
        self:Slam(center, radius, damage)
        self.SlamElement = ""
    end

    @ExecSpace("ServerOnly")
    method void BandWithElement(Vector2 a, Vector2 b, number width, number damage, string element)
        -- 사각·선 범위 기술 (보스 공용 패턴 10-28 — 레이저·돌진·바둑판): a → b 띠(폭 width) 안의 플레이어·그림자. 판정은 Slam과 같은 길(monster.slam)
        local d = b - a
        local len = d:Magnitude()
        if len <= 0.01 then return end
        self.SlamElement = element
        self.SlamDamage = damage
        self.CurrentTarget = nil
        self:AttackFast(BoxShape((a + b) * 0.5, Vector2(len, width), math.deg(math.atan(d.y, d.x))), "monster.slam", nil)
        self.SlamElement = ""
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        local body = self:Body()
        if body == nil or body.IsDead or not self.Entity.Enable then self.SpacingControlled = false return end
        ---@type BossPattern
        local boss = self.Entity:GetComponent("script.BossPattern")
        if boss ~= nil and boss.SlamPhase ~= "idle" then self.SpacingControlled = false return end
        local status = body:Status()
        if status ~= nil and (status:IsStunned() or not status:CanTargetDefenders()) then self.SpacingControlled = false return end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and not behavior:CanBeginAttack() then self.SpacingControlled = false return end
        self.CooldownTimer = self.CooldownTimer - delta
        self.ScanTimer = self.ScanTimer - delta
        self:UpdateChaseHold(delta)
        if _UtilLogic.ElapsedSeconds < self.AttackAnimationUntil then return end
        if self:TryArchMove() then return end
        self:UpdateMeleeSpacing(delta)
        if self.CooldownTimer > 0 or self.ScanTimer > 0 then return end
        self.ScanTimer = self.ScanInterval
        local target = self:FindTarget()
        if target == nil then return end
        self.CooldownTimer = self.AttackCooldown / body:GetAttackSpeedMultiplier()
        self:BeginAttack(target)
    end

    @ExecSpace("ServerOnly")
    method boolean TryArchMove()
        -- 짐승: 2~3칸 떨어진 대상에게 덮쳐 문다 · 암살자: 대상 옆으로 빠르게 돌아 들어가 찌른다. 4초 남짓에 한 번
        if self.Arch ~= "beast" and self.Arch ~= "assassin" then return false end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.ArchReadyAt or self.CooldownTimer > 0.3 then return false end
        local beast = self.Arch == "beast"
        local target = self:FindDefender(beast and 3.2 or 2.8)
        if target == nil then return false end
        local p = _Util:Pos2(self.Entity)
        local to = _Util:Pos2(target) - p
        local d = to:Magnitude()
        if d < (beast and 1.4 or 1.0) then return false end
        self.ArchReadyAt = now + (beast and 4.5 or 4) + _UtilLogic:RandomDouble() * 1.5
        local aim = _Util:Pos2(target)
        if not beast then
            -- 대상의 옆 (지금 내가 있는 쪽으로 90°), 살짝 지나친 자리
            local dir = to:Normalize()
            local side = Vector2(-dir.y, dir.x)
            if _UtilLogic:RandomDouble() < 0.5 then side = side * -1 end
            aim = aim + side * 0.85 + dir * 0.25
            if not _Util:HasLineOfSight(self.Entity.CurrentMap, p, aim) then aim = _Util:Pos2(target) - dir * 0.6 end
        else
            aim = aim - to:Normalize() * 0.55
        end
        self:Dash(target, aim, beast and 0.22 or 0.1)
        return true
    end

    @ExecSpace("ServerOnly")
    method void Dash(Entity target, Vector2 aim, number crouch)
        -- 잠깐 웅크렸다가(crouch초) 빠르게 aim까지 달려가 바로 공격한다. 맞거나 경직되면 중단 (속도는 늘 되돌린다)
        local body = self:Body()
        local movement = self.Entity.MovementComponent
        if body == nil or not isvalid(movement) then return end
        self.ArchSerial = self.ArchSerial + 1
        local serial = self.ArchSerial
        local epoch = self.AttackEpoch
        local map = self.Entity.CurrentMap
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.Enable = false end
        movement:MoveToDirection(Vector2(0, 0), 0)
        local from = _Util:Pos2(self.Entity)
        local path = aim - from
        local dist = path:Magnitude()
        local dashSec = math.max(0.18, math.min(0.4, dist / 7))
        self.AttackAnimationUntil = _UtilLogic.ElapsedSeconds + crouch + dashSec + 0.1
        if math.abs(path.x) > 0.05 then self.Entity.SpriteRendererComponent.FlipX = path.x > 0 end
        self.DashCount = self.DashCount + 1
        self:DashFx(self.Arch == "beast", crouch + dashSec)
        local function resume()
            local behavior = self.Entity:GetComponent("script.MonsterBehavior")
            if behavior ~= nil then behavior:ResumeMovement() elseif isvalid(chase) then chase.Enable = true end
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or serial ~= self.ArchSerial or epoch ~= self.AttackEpoch or body.IsDead or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            local now = _Util:Pos2(self.Entity)
            local go = aim - now
            if go:Magnitude() < 0.05 then return end
            -- RectTile 맵 InputSpeed 1 ≈ 초당 0.836칸 (메이커 실측 — ShadowUnit.WorldPerInput)
            movement.InputSpeed = math.max(2, math.min(12, go:Magnitude() / dashSec / 0.836))
            movement:MoveToDirection(go:Normalize(), 0)
            local state = self.Entity.StateComponent
            if isvalid(state) and state.CurrentStateName ~= "MOVE" then state:ChangeState("MOVE") end
            _TimerService:SetTimerOnce(function()
                if not isvalid(self.Entity) or serial ~= self.ArchSerial then return end
                local st = body:Status()
                local stunned = st ~= nil and st:IsStunned()
                if not stunned then
                    movement:MoveToDirection(Vector2(0, 0), 0)
                    body:RefreshSpeed()
                end
                self.AttackAnimationUntil = 0
                if epoch ~= self.AttackEpoch or body.IsDead or stunned or self.Entity.CurrentMap ~= map then return end
                resume()
                if self:IsLiveDefender(target) and _Util:Distance(target, self.Entity) <= self.AttackRange + 0.45 then
                    self.CooldownTimer = self.AttackCooldown / body:GetAttackSpeedMultiplier()
                    self:BeginAttack(target)
                end
            end, dashSec)
        end, crouch)
    end

    @ExecSpace("Multicast")
    method void DashFx(boolean beast, number seconds)
        -- 덮치기: 도약 동작(있으면) + 발밑 흙먼지 · 돌아 들어가기: 돌진 동작(있으면) + 잔상처럼 몸이 잠깐 옅어진다 (seconds = 웅크림 + 돌진)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local p = self.Entity.TransformComponent.WorldPosition
        ---@type FrameAnimator
        local anim = self.Entity:GetComponent("script.FrameAnimator")
        if anim ~= nil then anim:Flash(beast and "leap" or "dash", seconds) end
        if beast then
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, Vector3(p.x, p.y + 0.1, p.z), 0, Vector3(0.5, 0.3, 1), false, { Color = Color(0.75, 0.62, 0.48, 0.6) })
            return
        end
        local r = self.Entity.SpriteRendererComponent
        if not isvalid(r) then return end
        local c = r.Color
        r.Color = Color(c.r, c.g, c.b, 0.45)
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and isvalid(r) then
                local now = r.Color
                r.Color = Color(now.r, now.g, now.b, 1)
            end
        end, seconds + 0.1)
    end

    @ExecSpace("ServerOnly")
    method void UpdateMeleeSpacing(number delta)
        -- 멀리서는 기존 추적, 마지막 접근에서는 사거리 안쪽에 멈춰 몸을 관통하지 않는다.
        if self.AttackRange > 1.5 then return end
        local chase = self.Entity.AIChaseComponent
        if not isvalid(chase) or not isvalid(self.Entity.MovementComponent) then return end
        self.SpacingTimer = self.SpacingTimer - delta
        if self.SpacingTimer > 0 then return end
        self.SpacingTimer = 0.1
        local target = self:FindDefender(math.max(1.3, self.AttackRange + 0.55))
        if not isvalid(target) then
            self.SpacingMode = 0
            if self.SpacingControlled then
                self.SpacingControlled = false
                local behavior = self.Entity:GetComponent("script.MonsterBehavior")
                if behavior ~= nil then behavior:ResumeMovement() else chase.Enable = true end
            end
            return
        end
        self.SpacingControlled = true
        if chase.Enable then chase.Enable = false end
        local p = _Util:Pos2(self.Entity)
        local to = _Util:Pos2(target) - p
        local distance = to:Magnitude()
        local radial = distance > 0.01 and to:Normalize() or Vector2(1, 0)
        -- 10-31 A-3: 사거리(FindTarget과 같은 AttackRange + 0.15) 안이면 멈춰서 공격만 — 물러나기(-1)·옆 비키기 없음.
        --   다가가기는 사거리 밖에서 시작해 사거리 − 0.1까지 (예전: 사거리 안쪽 wanted ± 폭으로 다가감·물러남 · 겹치면 옆으로 비켜 앞뒤·좌우로 흔들렸다)
        local mode = self:SpacingDecide(distance)
        if mode == 0 then
            local behaviorStop = self.Entity:GetComponent("script.MonsterBehavior")
            if behaviorStop ~= nil then behaviorStop:DriveMotion(Vector2(0, 0))
            else
                self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
                local stopState = self.Entity.StateComponent
                if isvalid(stopState) and stopState.CurrentStateName == "MOVE" then stopState:ChangeState("IDLE") end
            end
            return
        end
        local direction = radial
        local push = Vector2(0, 0)
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, p, self.NeighborSpacing)) do
            if m.Entity ~= self.Entity then
                local away = p - _Util:Pos2(m.Entity)
                local gap = away:Magnitude()
                if gap < 0.01 then away = self.Entity.Id < m.Entity.Id and Vector2(1, 0) or Vector2(-1, 0) gap = 0.01 end
                push = push + away:Normalize() * ((self.NeighborSpacing - gap) / self.NeighborSpacing)
            end
        end
        -- 대상 쪽으로 밀지 않고 둘레로 흩어진다. 공격 준비/회복에는 이 이동을 실행하지 않는다.
        local tangent = push - radial * push:Dot(radial)
        -- 서로 많이 겹칠 때만 옆으로 비킨다 (살짝 닿은 것까지 밀면 계속 흔들렸다)
        if tangent:Magnitude() > 0.35 then direction = direction + tangent * 0.6 end
        if direction:Magnitude() > 0.05 then
            direction = direction:Normalize()
            if not _Util:HasLineOfSight(self.Entity.CurrentMap, p, p + direction * 0.3) then direction = Vector2(0, 0) end
        else direction = Vector2(0, 0) end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil then behavior:DriveMotion(direction)
        else
            self.Entity.MovementComponent:MoveToDirection(direction, 0)
            local state = self.Entity.StateComponent
            local nextState = direction:Magnitude() > 0.01 and "MOVE" or "IDLE"
            if isvalid(state) and state.CurrentStateName ~= nextState then state:ChangeState(nextState) end
            if math.abs(direction.x) > 0.05 then _Util:SetFlipX(self.Entity, direction.x > 0) end
        end
    end

    method integer SpacingDecide(number distance)
        -- 근접 간격 판단 (10-31 A-3): 1 다가감 · 0 멈춤. 물러남(-1)은 쓰지 않는다 (엔진 호출 없음 · tests/quality/chase_pet.lua)
        --   reach = AttackRange + 0.15 (FindTarget과 같음). 다가가던 중이면 reach − 0.1에 닿을 때 멈추고, 멈춘 뒤로는 reach를 벗어나야 다시 다가간다
        local reach = self.AttackRange + 0.15
        if self.SpacingMode == 1 and distance <= reach - 0.1 then self.SpacingMode = 0 end
        if self.SpacingMode ~= 1 then
            if distance > reach then self.SpacingMode = 1 else self.SpacingMode = 0 end
        end
        return self.SpacingMode
    end

    @ExecSpace("ServerOnly")
    method void UpdateChaseHold(number delta)
        -- 추격 이력 (10-31 A-3). ChaseCheckSec마다 가장 가까운 산 플레이어 거리로 ChaseDecide → 감지 범위·멈춤 적용
        self.ChaseTimer = self.ChaseTimer - delta
        if self.ChaseTimer > 0 then return end
        self.ChaseTimer = self.ChaseCheckSec
        if self.ChaseExternal then return end
        local chase = self.Entity.AIChaseComponent
        if not isvalid(chase) then return end
        local body = self:Body()
        if body == nil or body.Horde or body.Inflow or self.Entity:GetComponent("script.BossPattern") ~= nil then
            self.ChaseExternal = true
            return
        end
        if self.ChaseBaseDetect <= 0 then self.ChaseBaseDetect = chase.DetectionRange end
        -- 다른 곳(떼·유입·길 위 사건 = raidHordeDetect)이 범위를 바꿨으면 손 뗀다
        if self.ChaseBaseDetect >= 8 or (self.ChaseWrote > 0 and math.abs(chase.DetectionRange - self.ChaseWrote) > 0.01) then
            self.ChaseExternal = true
            self.ChaseState = 0
            if self.ChasePaused then self:ResumeChase() end
            return
        end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local pos = _Util:Pos2(self.Entity)
        local d = 999
        for _, u in ipairs(_Util:PlayersNear(map, pos, self.ChaseBaseDetect * self.LoseMul * 1.5 + 0.5)) do
            if self:IsLiveDefender(u) then d = math.min(d, (_Util:Pos2(u) - pos):Magnitude()) end
        end
        local now = _UtilLogic.ElapsedSeconds
        local act = self:ChaseDecide(d, now)
        if act == "engage" then
            if self.ChasePaused then self:ResumeChase() end
            self:WriteDetect(chase, self.ChaseBaseDetect * self.LoseMul * 1.5)
        elseif act == "settle" then
            self:WriteDetect(chase, self.ChaseBaseDetect * self.LoseMul)
        elseif act == "lose" then
            self:WriteDetect(chase, self.ChaseBaseDetect)
            self.ChaseLoseCount = self.ChaseLoseCount + 1
            if chase.Enable and not self.SpacingControlled and now >= self.AttackAnimationUntil then
                chase.Enable = false
                self.ChasePaused = true
                self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
                local state = self.Entity.StateComponent
                if isvalid(state) and state.CurrentStateName == "MOVE" then state:ChangeState("IDLE") end
            end
            log(string.format("[VRF] chase lose id=%s d=%.1f lose=%.1f held=%.1f pause=%.1f n=%d", self.Entity.Name, d, self.ChaseBaseDetect * self.LoseMul, now - self.ChaseSince, self.WanderPauseSec, self.ChaseLoseCount))
        elseif act == "resume" then
            if self.ChasePaused then self:ResumeChase() end
        end
    end

    method string ChaseDecide(number d, number now)
        -- 추격 이력 상태 기계 (엔진 호출 없음 · tests/quality/chase_pet.lua). d = 가장 가까운 산 플레이어 거리(없으면 999)
        --   0 평소 → d ≤ 감지이면 engage(1) · 1 추격 중 → ChaseHoldSec 전에는 놓치지 않음, 지나면 settle(범위 감지×LoseMul)
        --   → d > 감지×LoseMul이면 lose(2, WanderPauseSec 멈춤) · 2 멈춤 → 다시 감지 안이면 engage, 시간이 지나면 resume(0)
        local base = self.ChaseBaseDetect
        if self.ChaseState == 1 then
            local held = now - self.ChaseSince >= self.ChaseHoldSec
            if not held then return "" end
            if d > base * self.LoseMul then
                self.ChaseState = 2
                self.ChaseHeld = false
                self.ChasePauseUntil = now + self.WanderPauseSec
                return "lose"
            end
            if not self.ChaseHeld then
                self.ChaseHeld = true
                return "settle"
            end
            return ""
        end
        if d <= base then
            self.ChaseState = 1
            self.ChaseSince = now
            self.ChaseHeld = false
            return "engage"
        end
        if self.ChaseState == 2 and now >= self.ChasePauseUntil then
            self.ChaseState = 0
            return "resume"
        end
        return ""
    end

    @ExecSpace("ServerOnly")
    method void WriteDetect(AIChaseComponent chase, number range)
        chase.DetectionRange = range
        self.ChaseWrote = chase.DetectionRange
    end

    @ExecSpace("ServerOnly")
    method void ResumeChase()
        -- 놓친 뒤 멈춤을 끝낸다: 이쪽이 끈 추적만 다시 켠다 (특수 행동·간격 조절이 맡은 동안은 그쪽 규칙)
        self.ChasePaused = false
        local chase = self.Entity.AIChaseComponent
        if not isvalid(chase) then return end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil then behavior:ResumeMovement()
        elseif not self.SpacingControlled and _UtilLogic.ElapsedSeconds >= self.AttackAnimationUntil then chase.Enable = true end
    end

    @ExecSpace("ServerOnly")
    method void ResetChaseHold()
        -- 리스폰: 추격 이력을 처음으로 (이쪽이 바꾼 감지 범위도 되돌린다)
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) and not self.ChaseExternal and self.ChaseBaseDetect > 0 and self.ChaseWrote > 0 then self:WriteDetect(chase, self.ChaseBaseDetect) end
        self.ChaseState = 0
        self.ChaseHeld = false
        self.ChasePaused = false
        self.ChasePauseUntil = 0
        self.ChaseTimer = 0
    end

    @ExecSpace("ServerOnly")
    method void BeginAttack(Entity target)
        local body = self:Body()
        if body == nil or body.IsDead or not self:IsLiveDefender(target) then return end
        if not self.Entity.Enable then return end
        ---@type BossPattern
        local boss = self.Entity:GetComponent("script.BossPattern")
        if boss ~= nil and boss.SlamPhase ~= "idle" then return end
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and not behavior:CanBeginAttack() then return end
        local map = self.Entity.CurrentMap
        local aim = _Util:Pos2(target)
        if not _Util:HasLineOfSight(map, _Util:Pos2(self.Entity), aim) then return end
        self.AttackEpoch = self.AttackEpoch + 1
        local epoch = self.AttackEpoch
        self.CurrentTarget = target
        self.AttackAnimationUntil = _UtilLogic.ElapsedSeconds + self.AttackAnimationSeconds
        local chase = self.Entity.AIChaseComponent
        local resumeChase = isvalid(chase) and chase.Enable
        self.ResumeChaseAfterAttack = resumeChase
        if isvalid(chase) then chase.Enable = false end
        self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
        local dx = aim.x - _Util:Pos2(self.Entity).x
        if math.abs(dx) > 0.05 then self.Entity.SpriteRendererComponent.FlipX = dx > 0 end
        -- 근접은 공격을 시작할 때 바라본 방향 앞쪽만 친다 (등 뒤·옆으로 빠지면 빗나간다)
        local face = aim - _Util:Pos2(self.Entity)
        if face:Magnitude() < 0.05 then face = Vector2(dx >= 0 and 1 or -1, 0) end
        face = face:Normalize()
        self.Entity.StateComponent:ChangeState("ATTACK")
        if self.ChainJumps > 0 then self:ChainWarnFx(Vector3(aim.x, aim.y, 0), self.AttackWindup)
        else self:WindupFx(face, self.AttackWindup, epoch) end
        if self.DebugCombat then log("[VRF-COMBAT] enemy windup epoch=" .. tostring(epoch)) end
        self.WindupTimer = _TimerService:SetTimerOnce(function()
            self.WindupTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or body.IsDead or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            if not self:IsLiveDefender(target) then return end
            if not _Util:HasLineOfSight(map, _Util:Pos2(self.Entity), aim) then return end
            self.StrikeCount = self.StrikeCount + 1
            if self.DebugCombat then log("[VRF-COMBAT] enemy active epoch=" .. tostring(epoch)) end
            if self.ChainJumps > 0 then self:ChainLightning(target) return end
            if self.AttackRange > 1.5 then self:Shoot(aim) return end
            -- 준비 동작을 보고 옆·뒤로 빠지면 피할 수 있게: 지금 몬스터 위치에서 처음 바라본 방향 앞쪽 원
            local reach = self:MeleeReach()
            local center = self:MeleeCenter(face)
            self:AttackFast(CircleShape(center, reach), "monster.basic", nil)
            self:SwingFx(Vector3(center.x, center.y, 0), face)
        end, self.AttackWindup)
        self.RecoveryTimer = _TimerService:SetTimerOnce(function()
            self.RecoveryTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or body.IsDead or self.Entity.CurrentMap ~= map then return end
            local status = body:Status()
            if status ~= nil and status:IsStunned() then return end
            if self.Entity.StateComponent.CurrentStateName == "ATTACK" then self.Entity.StateComponent:ChangeState("IDLE") end
            if behavior ~= nil then behavior:ResumeMovement()
            elseif isvalid(chase) then chase.Enable = resumeChase end
        end, self.AttackAnimationSeconds)
    end

    @ExecSpace("ServerOnly")
    method void CancelPending()
        -- 중단한 공격의 지연 타이머는 경직이 풀려도 되살리지 않는다.
        if self.WindupTimer ~= 0 then _TimerService:ClearTimer(self.WindupTimer) self.WindupTimer = 0 end
        if self.RecoveryTimer ~= 0 then _TimerService:ClearTimer(self.RecoveryTimer) self.RecoveryTimer = 0 end
        self.AttackEpoch = self.AttackEpoch + 1
        self.CancelCount = self.CancelCount + 1
        self.AttackAnimationUntil = 0
        self.CurrentTarget = nil
        self.CooldownTimer = math.max(self.CooldownTimer, 0.35)
        if isvalid(self.Entity) and isvalid(self.Entity.StateComponent) and self.Entity.StateComponent.CurrentStateName == "ATTACK" then
            self.Entity.StateComponent:ChangeState("IDLE")
        end
    end

    @ExecSpace("Multicast")
    method void WindupFx(Vector2 dir, number duration, integer epoch)
        -- 공격 방향의 짧은 지면 표시. 준비가 끝나면 제거해 실제 궤적과 겹치지 않는다.
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        if epoch < self.AttackEpoch then return end
        ---@type BossPattern
        local boss = self.Entity:GetComponent("script.BossPattern")
        if boss ~= nil and boss.SlamPhase ~= "idle" then return end
        -- 앞모션음 (39 #9 ③): 바닥 표시가 없는 일반 몬스터도 소리로는 알린다 — 유형별 · 근처만 (보스는 Arch가 비어 패턴 소리만)
        _SoundDirector:PlayMonsterWindup(self.Arch, self.Entity.TransformComponent.WorldPosition)
        -- 범위 기술 예고(nova)가 떠 있는 동안에는 더 큰 위험을 덮어쓰지 않는다
        if self.WarningOwner == "nova" or self.WarningOwner == "ult" then return end   -- 보스 궁극기 예고도 덮지 않는다
        -- D2·이모탈처럼 일반 몬스터의 평타에는 바닥 표시를 하지 않는다 (몸짓으로 읽는다). 정예·변종·보스만 얇은 테두리로 예고
        local body = self:Body()
        -- 거구의 크게 드는 강타는 일반 몬스터라도 예고한다 (피하라고 만든 한 방)
        if body ~= nil and body.Grade < 2 and body:GetVariant() == "" and self.Arch ~= "brute" then return end
        self:ClearWindup()
        self.WarningOwner = "basic"
        self.WarningEpoch = epoch
        local drawn = false
        if self.AttackRange > 1.5 then drawn = self:DrawRangedWarning(dir)
        else drawn = self:DrawMeleeWarning(dir, duration) end
        if not drawn then
            local reach = math.max(0.4, self.AttackRange * 0.55)
            if self.AttackRange > 1.5 then reach = 0.3 end
            local p = self.Entity.TransformComponent.WorldPosition
            local pos = Vector3(p.x + dir.x * reach, p.y + dir.y * reach + 0.3, p.z)
            self.WarningSerial = _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, Vector3(reach, reach, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(0.8, 0.35, 0.18, 0.38) })
        end
        self.WarningTimer = _TimerService:SetTimerOnce(function()
            self.WarningTimer = 0
            if self.WarningEpoch == epoch then self:ClearWindup() end
        end, duration)
    end

    method number MeleeReach()
        -- 근접 예고와 실제 원형 판정이 같은 반경을 사용한다.
        return math.max(0.4, self.AttackRange * 0.55) * self.ReachMul
    end

    method Vector2 MeleeCenter(Vector2 dir)
        -- 캐릭터 피격 높이 보정을 포함한 실제 근접 판정 중심이다.
        return _Util:Pos2(self.Entity) + dir * self:MeleeReach() + Vector2(0, 0.3)
    end

    @ExecSpace("ClientOnly")
    method boolean DrawMeleeWarning(Vector2 dir, number duration)
        -- 실제 공격 원 반경의 흐린 빛 테두리 + 차오르는 원판 (Util.Telegraph) — 옆·뒤 회피 거리와 남은 시간을 함께 읽는다.
        if dir:Magnitude() < 0.05 then return false end
        local center = self:MeleeCenter(dir:Normalize())
        local radius = self:MeleeReach()
        if self.WindupTele ~= 0 then _Util:StopTelegraph(self.WindupTele) end
        self.WindupTele = _Util:Telegraph(self.Entity, center, radius, "", duration)
        if self.DebugCombat then log("[VRF] melee warning telegraph center=" .. tostring(center) .. " radius=" .. tostring(radius)) end
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean DrawRangedWarning(Vector2 dir)
        -- 실제 화살의 지면 경로를 선·화살촉으로 표시하고 막힌 타일 앞에서 끊는다.
        local line = self.Entity.LineRendererComponent
        if not isvalid(line) or dir:Magnitude() < 0.05 then return false end
        dir = dir:Normalize()
        local transform = self.Entity.TransformComponent
        local p = transform.WorldPosition
        local start = Vector2(p.x, p.y) + dir * 0.3
        local tip = start
        local range = self.AttackRange + 1.5
        local terrain = self.Entity.CurrentMap:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        local steps = math.ceil(range / 0.2)
        for i = 1, steps do
            local nextPoint = start + dir * math.min(range, i * 0.2)
            if isvalid(terrain) and _Util:TileBlocked(terrain.Entity, nextPoint) then break end
            tip = nextPoint
        end
        if (tip - start):Magnitude() < 0.1 then return false end
        local normal = Vector2(-dir.y, dir.x)
        local head = math.min(0.28, (tip - start):Magnitude() * 0.4)
        local color = Color(1, 0.55, 0.2, 0.9)
        local function addPoint(point)
            local localPoint = transform:ToLocalPoint(Vector3(point.x, point.y, p.z))
            line.Points:Add(LinePoint(Vector2(localPoint.x, localPoint.y), color, self.WarnLineWidth))
        end
        line.Points:Clear()
        addPoint(start)
        addPoint(tip)
        addPoint(tip - dir * head + normal * head * 0.6)
        addPoint(tip)
        addPoint(tip - dir * head - normal * head * 0.6)
        if self.DebugCombat then log("[VRF] ranged warning points=5 length=" .. tostring((tip - start):Magnitude()) .. " dir=" .. tostring(dir)) end
        return true
    end

    @ExecSpace("ClientOnly")
    method void DrawNovaWarning(Vector2 center, number radius, string element, number duration)
        -- 범위 기술 예고: 실제 판정 원(CircleShape) 반경의 흐린 빛 테두리 + 차오르는 원판 (Util.Telegraph). duration 뒤 같은 자리에서 터진다.
        self:ClearWindup()
        if self.WarningOwner == "ult" then return end
        local line = self.Entity.LineRendererComponent
        if self.WarningOwner == "basic" and isvalid(line) then line.Points:Clear() end
        self.WarningOwner = "nova"
        if self.NovaTele ~= 0 then _Util:StopTelegraph(self.NovaTele) end
        self.NovaTele = _Util:Telegraph(self.Entity, center, radius, element, duration)
        if self.NovaTimer ~= 0 then _TimerService:ClearTimer(self.NovaTimer) end
        self.NovaTimer = _TimerService:SetTimerOnce(function()
            self.NovaTimer = 0
            self.NovaTele = 0
            if not isvalid(self.Entity) or self.WarningOwner ~= "nova" then return end
            self.WarningOwner = ""
        end, duration)
    end

    @ExecSpace("ClientOnly")
    method void OnSyncProperty(string name, any value)
        -- 공격 중단/새 공격의 epoch가 오면 이전 경고 원도 즉시 제거한다.
        if name == "AttackEpoch" and self.WarningEpoch >= 0 and self.WarningEpoch ~= value then self:ClearWindup() end
    end

    @ExecSpace("ClientOnly")
    method void ClearWindup()
        -- 경고 입자와 제거 타이머를 함께 정리한다.
        if self.WarningTimer ~= 0 then _TimerService:ClearTimer(self.WarningTimer) self.WarningTimer = 0 end
        if self.WarningSerial ~= 0 then _ParticleService:RemoveParticle(self.WarningSerial) self.WarningSerial = 0 end
        if self.WindupTele ~= 0 then _Util:StopTelegraph(self.WindupTele) self.WindupTele = 0 end
        if self.WarningOwner == "basic" then
            if isvalid(self.Entity.LineRendererComponent) then self.Entity.LineRendererComponent.Points:Clear() end
            self.WarningOwner = ""
        end
        self.WarningEpoch = -1
    end

    method void OnEndPlay()
        -- 폐기한 적의 판정과 경고가 다음 세션에 남지 않게 한다.
        if self:IsServer() then
            self:CancelPending()
        else
            self:ClearWindup()
            if self.NovaTele ~= 0 then _Util:StopTelegraph(self.NovaTele) end
            self.NovaTele = 0
        end
    end

    @ExecSpace("Multicast")
    method void SwingFx(Vector3 pos, Vector2 dir)
        -- 몬스터 근접 궤적: 실제 판정 범위(앞쪽)를 보여 준다. 리소스가 왼쪽을 보므로 오른쪽이면 뒤집는다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local right = dir.x >= 0
        local rot = math.deg(math.atan(dir.y, dir.x))
        if not right then rot = rot - 180 end
        if rot > 180 then rot = rot - 360 elseif rot < -180 then rot = rot + 360 end
        local s = self.Arch == "brute" and 0.72 or 0.45
        -- 10-31 C 7종 중립 베기 4장 (Util.SkillSlashFx · 적색 Tint 그대로 · 비면 예전 메이플 FxSlash)
        if not _Util:SkillSlashFx(self.Entity.CurrentMap, pos, rot, s, right, Color(1, 0.45, 0.4, 0.85), "monster") then
            _EffectService:PlayEffect(_GameConst.FxSlash, self.Entity, pos, rot, Vector3(s, s, 1), false, { FlipX = right, PlayRate = 1.4, Color = Color(1, 0.45, 0.4, 0.85) })
        end
    end

    method boolean IsLiveDefender(Entity target)
        if not isvalid(target) or not target.Enable or target.CurrentMap ~= self.Entity.CurrentMap then return false end
        if isvalid(target.PlayerComponent) then
            if target.PlayerComponent.Hp <= 0 then return false end
            -- 맵에 막 들어온 사람은 arrivalShieldSec 동안 새로 노리지 않는다 (로딩 직후 둘러볼 틈)
            ---@type PlayerTravel
            local travel = target:GetComponent("script.PlayerTravel")
            return travel == nil or _UtilLogic.ElapsedSeconds - travel.ArrivedAt >= _GameData.arrivalShieldSec
        end
        local unit = target:GetComponent("script.ShadowUnit")
        return unit ~= nil and not unit.Dead and unit.Hp > 0
    end

    @ExecSpace("ServerOnly")
    method void Shoot(Vector2 aim)
        -- 화살 투사체 (초속 ArrowSpeed, 사거리 + 1.5, 첫 대상에서 멈춤). 속성이 있으면 그 색으로 물든다
        local my = _Util:Pos2(self.Entity)
        local dir = aim - my
        if dir:Magnitude() < 0.05 then return end
        self:ShootBolt(dir:Normalize(), self.ArrowSpeed, self.AttackRange + 1.5, self:ElementColor(self:GetElement()))
    end

    @ExecSpace("ServerOnly")
    method void ShootBolt(Vector2 dir, number speed, number range, Color color)
        -- 화살 모양 투사체 한 발 (변종 「뼈 탄막」도 이것을 여러 번)
        local my = _Util:Pos2(self.Entity)
        local start = my + Vector2(0, 0.4) + dir * 0.3
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "Arrow_" .. tostring(self.ShotCount), Vector3(start.x, start.y, 0), self.Entity.CurrentMap)
        if not isvalid(shot) then return end
        local fire = self:GetElement() == "fire"
        local cold = self:GetElement() == "cold"
        local owner = self.Entity
        local originMap = self.Entity.CurrentMap
        _Util:AfterSpawn(shot, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            local body = isvalid(owner) and owner:GetComponent("script.Monster") or nil
            if body == nil or body.IsDead or not owner.Enable or owner.CurrentMap ~= originMap then
                if isvalid(shot) then shot:Destroy() end
                return
            end
            -- 서버에서 바꾼 SpriteRUID·색은 클라이언트에 안 보인다 → 동기화 값(Skin·Tint)으로
            -- 화염 몬스터(불꽃 사도·서고 사서·대사제 등)는 코덱스 화염구, 나머지는 화살에 속성 색 (10-11 그림 감사)
            if fire then
                proj:Skin(_GameConst.SpriteFireball, 1.3)
                proj:Tint(Color(1, 1, 1, 1))
            elseif cold then
                proj:Skin(_GameConst.SpriteIceArrow, 1.3)
                proj:Tint(Color(1, 1, 1, 1))
            else
                proj:Skin(_GameConst.SpriteArrow, 1.6)
                proj:Tint(color)
            end
            proj.AngleOffset = 0
            proj.Team = "monster"
            proj.HeightOffset = 0.4
            proj.Radius = 0.4
            proj:Launch(owner, dir, speed, range, 0, "monster.arrow", false)
        end, function()
            if isvalid(shot) then shot:Destroy() end
        end)
    end

    @ExecSpace("ServerOnly")
    method void TickPlayer(Entity player, number damage, string element)
        -- 지속 피해 한 번 (독안개 등): 주는 피해 배율 · 그 속성 저항 · 레벨 차를 반영해 무적 없이 깎는다 (장판과 같은 TakeTickDamage)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        ---@type PlayerVitals
        local vitals = player:GetComponent("script.PlayerVitals")
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        if vitals == nil then return end
        local body = self:Body()
        local dmg = damage * (body ~= nil and body:GetDamageDealtMultiplier() or 1)
        if stats ~= nil then
            dmg = dmg * math.max(0, 1 - stats:GetResist(element ~= "" and element or "poison") / 100)
            if body ~= nil then dmg = dmg * _GameConst:LevelGapTaken(body.Level, stats.Level) end
        end
        vitals:TakeTickDamage(dmg)
    end

    @ExecSpace("ServerOnly")
    method void HitOne(Entity target)
        -- 투사체가 닿은 대상 하나에 기본 공격 피해 (IsAttackTarget이 CurrentTarget만 통과시킨다)
        if not isvalid(target) then return end
        self.CurrentTarget = target
        local q = target.TransformComponent.WorldPosition
        self:AttackFast(CircleShape(Vector2(q.x, q.y + 0.3), 0.5), "monster.basic", nil)
    end

    @ExecSpace("ServerOnly")
    method void ChainLightning(Entity first)
        -- 번개 연쇄: 첫 대상 → 3칸 안의 아직 안 맞은 가장 가까운 플레이어·그림자로 ChainJumps번 튕긴다. 튕길 때마다 피해 ×0.85, 피해는 전부 번개
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local hit = {}
        local points = {}
        local me = _Util:Pos2(self.Entity)
        table.insert(points, Vector3(me.x, me.y + 0.6, 0))
        local cur = first
        local mul = 1
        local count = 0
        for i = 0, self.ChainJumps do
            if cur == nil or not self:IsLiveDefender(cur) then break end
            hit[cur.Id] = true
            local p = _Util:Pos2(cur)
            table.insert(points, Vector3(p.x, p.y + 0.4, 0))
            self.ChainMul = mul
            self.ChainTarget = cur
            self:AttackFast(CircleShape(Vector2(p.x, p.y + 0.3), 0.6), "monster.chain", nil)
            ---@type PlayerStats
            local shocked = isvalid(cur) and cur:GetComponent("script.PlayerStats") or nil   -- 이 번개에 쓰러진 소환수는 곧바로 지워진다 (10-28 오류 로그)
            if shocked ~= nil then shocked.ShockUntil = _UtilLogic.ServerElapsedSeconds + 2.5 end   -- 버프 줄 「감전」 칩 (표시만)
            count = count + 1
            mul = mul * 0.85
            cur = self:NearestDefenderExcept(p, self.ChainRange, hit)
        end
        self.ChainMul = 1
        self.ChainTarget = nil
        if count > 0 then self:ChainFx(points) end
        if self.DebugCombat then log(string.format("[VRF] chain lightning hits=%d", count)) end
    end

    @ExecSpace("ServerOnly")
    method Entity NearestDefenderExcept(Vector2 from, number range, table skip)
        -- from에서 range 안의, skip에 없는 가장 가까운 살아 있는 플레이어·그림자 (벽 너머는 제외)
        local map = self.Entity.CurrentMap
        local best = nil
        local bestDist = range
        for _, u in ipairs(_Util:PlayersNear(map, from, range)) do
            local d = (_Util:Pos2(u) - from):Magnitude()
            if skip[u.Id] == nil and d <= bestDist and self:IsLiveDefender(u) and _Util:HasLineOfSight(map, from, _Util:Pos2(u)) then
                bestDist = d
                best = u
            end
        end
        for _, c in ipairs(_Util:ListOf(map, "script.ShadowUnit")) do
            if not isvalid(c) or not isvalid(c.Entity) then continue end
            local d = (_Util:Pos2(c.Entity) - from):Magnitude()
            if skip[c.Entity.Id] == nil and d <= bestDist and self:IsLiveDefender(c.Entity) and _Util:HasLineOfSight(map, from, _Util:Pos2(c.Entity)) then
                bestDist = d
                best = c.Entity
            end
        end
        return best
    end

    @ExecSpace("Multicast")
    method void ChainWarnFx(Vector3 pos, number seconds)
        -- 첫 대상 발밑 파란 예고 원 + 코덱스 번개 예고 타원 (예고 시간 동안)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayMonsterWindup(self.Arch, self.Entity.TransformComponent.WorldPosition)
        self:DrawNovaWarning(Vector2(pos.x, pos.y), 0.55, "light", seconds)
        local mark = _EffectService:PlayEffect(_GameConst.SpriteLightningWarning, self.Entity, pos, 0, Vector3(1.15, 1.15, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 3 })
        _TimerService:SetTimerOnce(function()
            if mark ~= nil and mark ~= 0 then _EffectService:RemoveEffect(mark) end
        end, math.max(0.1, seconds))
    end

    @ExecSpace("Multicast")
    method void ChainFx(table points)
        -- 번개 줄기: 점 사이마다 코덱스 번개 줄기 그림(256×48, 4장 중 하나)을 늘이고 돌려 0.3초 잇고, 맞은 자리마다 번개 자국·불꽃
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        self:ClearWindup()
        local chains = {}
        for ruid in string.gmatch(_GameConst.SpriteLightningChains, "[^|]+") do table.insert(chains, ruid) end
        local serials = {}
        local opt = { SortingLayer = "MapLayer0", OrderInLayer = 20 }
        for i = 1, #points - 1 do
            local a = points[i]
            local b = points[i + 1]
            local dx = b.x - a.x
            local dy = b.y - a.y
            local len = math.sqrt(dx * dx + dy * dy)
            if len > 0.05 and #chains > 0 then
                local ruid = chains[_UtilLogic:RandomIntegerRange(1, #chains)]
                local mid = Vector3((a.x + b.x) * 0.5, (a.y + b.y) * 0.5, 0)
                table.insert(serials, _EffectService:PlayEffect(ruid, self.Entity, mid, math.deg(math.atan(dy, dx)), Vector3(len / 2.56, 0.9, 1), true, opt))
            end
        end
        for i = 2, #points do
            local p = points[i]
            table.insert(serials, _EffectService:PlayEffect(_GameConst.SpriteLightningHit, self.Entity, p, 0, Vector3(0.9, 0.9, 1), true, opt))
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, p, 0, Vector3(0.3, 0.3, 1), false, { Color = Color(0.7, 0.88, 1, 1) })
        end
        _TimerService:SetTimerOnce(function()
            for _, serial in ipairs(serials) do
                if serial ~= nil and serial ~= 0 then _EffectService:RemoveEffect(serial) end
            end
        end, 0.3)
    end

    method Color ElementColor(string element)
        if element == "fire" then return Color(1, 0.6, 0.35, 1) end
        if element == "cold" then return Color(0.6, 0.85, 1, 1) end
        if element == "light" then return Color(1, 1, 0.6, 1) end
        if element == "poison" then return Color(0.6, 1, 0.5, 1) end
        return Color(1, 1, 1, 1)
    end

    @ExecSpace("ServerOnly")
    method void TauntBy(Entity taunter, number seconds)
        -- 방패 해골의 도발: seconds 동안 사거리 안이면 그 해골부터 노리고, 쫓을 대상도 그 해골로
        self.Taunter = taunter
        self.TauntUntil = _UtilLogic.ElapsedSeconds + seconds
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase:SetTarget(taunter) end
    end

    method Entity FindTarget()
        -- 공격과 거리 유지가 같은 대상 선정 기준을 사용한다.
        -- 근접은 +0.15 여유: 거리 유지(UpdateMeleeSpacing)가 사거리 0.8 ~ 0.9 사이에서 멈추면 영영 못 쳤다
        -- (10-21 메이커: 용암 골렘·방패병이 0.83에 붙어 9초간 0타). 판정 원은 그 거리까지 닿는다
        if self.AttackRange <= 1.5 then return self:FindDefender(self.AttackRange + 0.15) end
        return self:FindDefender(self.AttackRange)
    end

    @ExecSpace("ServerOnly")
    method Entity FindDefender(number range)
        -- 감지 범위 안의 가장 가까운 살아 있는 플레이어·소환수. 장애물 뒤 대상은 제외한다.
        local map = self.Entity.CurrentMap
        local myPos = _Util:Pos2(self.Entity)
        local best = nil
        if not isvalid(map) then return nil end
        local bestDist = range
        -- 방패 해골에게 도발당했으면 그 해골이 닿는 동안 먼저
        if self.Taunter ~= nil and _UtilLogic.ElapsedSeconds < self.TauntUntil and isvalid(self.Taunter) and self:IsLiveDefender(self.Taunter)
            and _Util:Distance(self.Taunter, self.Entity) <= range and _Util:HasLineOfSight(map, myPos, _Util:Pos2(self.Taunter)) then
            return self.Taunter
        end
        for _, u in ipairs(_Util:PlayersNear(map, myPos, range)) do
            local d = _Util:Distance(u, self.Entity)
            if d <= bestDist and self:IsLiveDefender(u) and _Util:HasLineOfSight(map, myPos, _Util:Pos2(u)) then
                bestDist = d
                best = u
            end
        end
        for _, c in ipairs(_Util:ListOf(map, "script.ShadowUnit")) do
            if not isvalid(c) or not isvalid(c.Entity) then continue end
            local d = _Util:Distance(c.Entity, self.Entity)
            if d <= bestDist and self:IsLiveDefender(c.Entity) and _Util:HasLineOfSight(map, myPos, _Util:Pos2(c.Entity)) then
                bestDist = d
                best = c.Entity
            end
        end
        return best
    end

    method string GetElement()
        local body = self:Body()
        if body ~= nil and body:GetAffixElement() ~= "" then return body:GetAffixElement() end
        return self.Element
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        local dmg = self.Damage
        if attackInfo == "monster.slam" then dmg = self.SlamDamage
        elseif self.BasicMul ~= 1 and (attackInfo == "monster.basic" or attackInfo == "monster.chain") then dmg = dmg * self.BasicMul end
        local body = self:Body()
        if body ~= nil then dmg = dmg * body:GetDamageDealtMultiplier() end
        -- 냉혹 오오라: 치명타 확률 (×1.5)
        local cstatus = body ~= nil and body:Status() or nil
        if cstatus ~= nil and cstatus:AuraAmount("crit") > 0 and _UtilLogic:RandomDouble() < cstatus:AuraAmount("crit") / 100 then dmg = dmg * 1.5 end
        local element = self:GetElement()
        local ratio = 0
        if element ~= "" then ratio = self.ElementRatio end
        if body ~= nil and body:GetAffixElement() ~= "" then ratio = math.min(1, ratio + 0.5) end
        if attackInfo == "monster.slam" and self.SlamElement ~= "" then
            element = self.SlamElement
            ratio = 1
        end
        if attackInfo == "monster.chain" then
            -- 번개 연쇄: 전부 번개, 튕길수록 약해진다
            element = "light"
            ratio = 1
            dmg = dmg * self.ChainMul
        end
        ---@type ShadowUnit
        local shadow = defender:GetComponent("script.ShadowUnit")
        if shadow ~= nil then dmg = dmg * shadow:ArchTakenMult() end   -- 방패 그림자 -25%
        if shadow ~= nil and ratio > 0 then
            -- 그림자도 원본 몬스터의 저항을 이어받는다
            local elem = dmg * ratio
            dmg = dmg - elem + elem * math.max(0, 1 - shadow:GetResist(element) / 100)
        end
        if isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local stats = defender:GetComponent("script.PlayerStats")
            -- 모래 미라: 맞으면 5초 동안 물약 회복 -30% (치유 감소 저주)
            if stats ~= nil and body ~= nil and body.SourceId == "sand_mummy" and self:IsServer() then stats:ApplyPotionCurse(5) end
            -- 그림자 오오라를 받은 플레이어: 수호 받는 피해↓ · 가시 평타 반사 (10-24)
            if stats ~= nil then
                dmg = dmg * stats:AuraMult("guard")
                if attackInfo == "monster.basic" and self:IsServer() and body ~= nil and stats:AuraAmount("thorns") > 0 then
                    local back = dmg * stats:AuraAmount("thorns") / 100
                    local victim = defender
                    _TimerService:SetTimerOnce(function() if isvalid(self.Entity) and not body.IsDead then body:TakeDamageAs(back, victim, "tick.thorns_aura") end end, 0.05)
                end
            end
            local phys = dmg * (1 - ratio)
            local elem = dmg * ratio
            if stats ~= nil then
                phys = phys * (100 / (100 + stats:GetDefense()))
                elem = elem * math.max(0, 1 - stats:GetResist(element) / 100)
            end
            dmg = phys + elem
        end
        -- 레벨 차이: 대상(소환수는 주인)보다 높은 몬스터는 더 아프게 때린다
        if body ~= nil then
            local lv = _GameConst:LevelOf(defender)
            if lv > 0 then dmg = dmg * _GameConst:LevelGapTaken(body.Level, lv) end
        end
        -- 수호의 신전: 대상(소환수는 주인)이 축복을 받았으면 받는 피해 -25%
        local guard = _Util:OwnerPlayerOf(defender)
        if isvalid(guard) then
            ---@type PlayerStats
            local gst = guard:GetComponent("script.PlayerStats")
            if gst ~= nil then dmg = dmg * (1 - 0.25 * gst:ShrineBonus("ward")) end
        end
        local final = math.max(1, math.floor(dmg + 0.5))
        -- 뼈 갑옷: 플레이어가 두른 흡수량만큼 대신 막는다 (서버만). 다 깨지면 강화 「터지는 갑옷」이 둘레로 터진다 — PlayerStats.SoakBoneArmor
        --   (10-29 44 결정 4: 막은 피해의 일부를 때린 몬스터에게 작은 틱으로 되돌리던 「가시 갑옷」을 바꿨다)
        if isvalid(defender.PlayerComponent) and self:IsServer() then
            ---@type PlayerStats
            local armorSt = defender:GetComponent("script.PlayerStats")
            if armorSt ~= nil and armorSt.BoneArmor > 0 then final = armorSt:SoakBoneArmor(final) end
        end
        -- 가시 오오라를 받은 그림자를 평타로 때리면 그 일부가 돌아온다 (10-24 B안)
        if shadow ~= nil and attackInfo == "monster.basic" and self:IsServer() and body ~= nil and shadow:AuraAmount("thorns") > 0 then
            local back = final * shadow:AuraAmount("thorns") / 100
            local owner = shadow.OwnerPlayer
            _TimerService:SetTimerOnce(function()
                if isvalid(self.Entity) and not body.IsDead then body:TakeDamageAs(back, owner, "tick.thorns_aura") end
            end, 0.05)
        end
        -- 가시 저주: 준 피해의 일부를 되돌려 받는다 (판정 흐름이 끝난 뒤 적용)
        local status = body ~= nil and body:Status() or nil
        if status ~= nil and self:IsServer() and status:Thorns() > 0 then
            local reflect = final * status:Thorns() / 100
            local source = status.ThornSource
            _TimerService:SetTimerOnce(function()
                if isvalid(self.Entity) and body ~= nil and not body.IsDead then body:TakeDamageAs(reflect, source, "tick.curse_thorns") end
            end, 0.05)
        end
        -- I05: 갑옷 흡수 뒤 계산 최종값 관측 (실효 HP 감소 원장은 아님)
        if self:IsServer() and _Telemetry.DpsOn then _Telemetry:DpsTaken(defender, final) end
        return final
    end

    method void OnAttack(Entity defender)
        -- 냉기 공격은 플레이어 둔화 / 특수 행동(치고 빠지기)에 알림
        if not self:IsServer() then return end
        if self:GetElement() == "cold" and isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local stats = defender:GetComponent("script.PlayerStats")
            if stats ~= nil then stats:ApplyChill(1.5) end
        end
        -- 거구 강타: 맞으면 0.6초 휘청 (이동 ×0.5)
        if self.Arch == "brute" and isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local st = defender:GetComponent("script.PlayerStats")
            if st ~= nil then
                st:ApplyStagger(0.6)
                self.StaggerCount = self.StaggerCount + 1
            end
        end
        ---@type MonsterBehavior
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil then behavior:OnAttacked(defender) end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 고른 대상 하나만 (광역기는 범위 전체). 살아 있는 플레이어와 그림자만
        if attackInfo == "monster.chain" then
            if defender ~= self.ChainTarget then return false end
        elseif attackInfo ~= "monster.slam" and defender ~= self.CurrentTarget then return false end
        if attackInfo == "monster.basic" and not _Util:HasLineOfSight(self.Entity.CurrentMap, _Util:Pos2(self.Entity), _Util:Pos2(defender)) then return false end
        if isvalid(defender.PlayerComponent) then
            if self.SkipPlayers or defender.PlayerComponent:IsDead() then return false end
            -- 무적 시간·사망 처리 중이면 제외 (엔진이 맞자마자 생명을 깎으므로 여기서 막아야 한다)
            ---@type PlayerVitals
            local vitals = defender:GetComponent("script.PlayerVitals")
            if vitals ~= nil and not vitals:CanBeHit() then return false end
            return __base:IsAttackTarget(defender, attackInfo)
        end
        if defender:GetComponent("script.ShadowUnit") ~= nil then return __base:IsAttackTarget(defender, attackInfo) end
        return false
    end

end
