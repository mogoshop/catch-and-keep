-- 보스 패턴: 주기적으로 경고 후 내려찍기(광역), 생명 50% 이하에서 졸개 소환 + 패턴 가속.
-- 피해 판정은 같은 엔티티의 MonsterAttack:Slam을 쓴다. 내려찍기 피해는 몬스터 레벨 보정(공격력 배율)을 따른다.
-- 장판(PoolSeconds > 0): 내려찍은 자리에 PoolSeconds초 동안 남아 0.5초마다 PoolElement 피해 (세르카 독 · 사서 화염).
-- SlamAtTarget: 자기 자리 대신 가장 가까운 플레이어 발밑에 예고한다 (원거리 미니보스).
-- Bonded: 같은 맵의 같은 종류(형제)가 쓰러지면 분노 — 공격 +50% · 공격 속도 +30% (사원 문지기 두 형제).
-- 졸개는 보스 레벨 -2로 맞춘다 (레벨 1 졸개가 높은 맵에서 의미 없어지지 않게).
@Component
script BossPattern extends Component

    property string BossName = "보스"
    property number SlamInterval = 6
    property number SlamWindup = 1.0
    property number SlamRadius = 2.2
    property number SlamDamage = 22
    property number EngageRange = 5
    property string MinionModelId = "graveworm"
    property integer MinionCount = 3
    property number PoolSeconds = 0
    property string PoolElement = ""
    property boolean SlamAtTarget = false
    @Sync
    property boolean PoolActive = false
    @Sync
    property Vector2 PoolCenter = Vector2(0, 0)
    property number PoolRemaining = 0
    property number PoolTick = 0
    property boolean Bonded = false
    property number RageMult = 1             -- 형제 분노 배율 (Monster.GetDamageDealtMultiplier가 읽는다)
    property number BondTimer = 0
    property boolean TwinSeenAlive = false   -- 살아 있는 형제를 본 뒤에만 「형제가 쓰러짐」으로 분노한다 (다시 나타날 때 오작동 방지)

    property number SlamRecovery = 0.65
    @Sync
    property string SlamPhase = "idle"
    @Sync
    property Vector2 SlamCenter = Vector2(0, 0)
    property number PhaseRemaining = 0
    property boolean ResumeChase = false
    property boolean ResumeWander = false
    property integer SlamCount = 0
    property boolean DebugCombat = false

    property number SlamTimer = 3
    property boolean Enraged = false
    property boolean WasDead = false
    property number EngageStart = 0        -- 처음 플레이어와 마주친 시각 (처치 시간 랭킹)

    method void OnBeginPlay()
        -- 내려찍기는 소유 타이머 없는 단계 갱신으로 예고·타격·회복을 순서대로 실행한다.
        if self:IsServer() then log("[VRF] BossPattern phased slam ready " .. self.BossName) end
    end

    method void OnUpdate(number delta)
        -- 클라이언트는 서버가 확정한 타격 원을 표시하고 서버만 전투 단계를 진행한다.
        if self:IsClient() then self:DrawWarning() return end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil then return end
        if monster.IsDead or not self.Entity.Enable then
            self:CancelSlam()
            self:EndPool()
            self:Calm()
            self.TwinSeenAlive = false
            if not self.WasDead and monster.IsDead then self:Announce(self.BossName .. " 처치!") end
            self.WasDead = monster.IsDead
            self.Enraged = false
            self.SlamTimer = 3
            self.EngageStart = 0
            return
        end
        self.WasDead = false
        self:UpdatePool(delta)
        self:CheckBond(delta)
        local status = monster:Status()
        if status ~= nil and status:IsStunned() then self:CancelSlam() return end
        if self.SlamPhase ~= "idle" then
            -- 회피로 반경 밖에 나가도 예고한 자리에 친다. 맵을 떠난 뒤 남는 공격은 취소한다.
            if #_Util:PlayersInMap(self.Entity.CurrentMap) == 0 then self:CancelSlam() return end
            self:HoldMotion()
            self.PhaseRemaining = self.PhaseRemaining - delta
            if self.PhaseRemaining > 0 then return end
            if self.SlamPhase == "windup" then
                self.SlamPhase = "recovery"
                self.PhaseRemaining = self.SlamRecovery
                ---@type MonsterAttack
                local atk = self.Entity:GetComponent("script.MonsterAttack")
                if atk ~= nil then
                    self.Entity.StateComponent:ChangeState("ATTACK")
                    atk:Slam(self.SlamCenter, self.SlamRadius, self:ScaledSlamDamage())
                    self.SlamCount = self.SlamCount + 1
                end
                if self.PoolSeconds > 0 then self:BeginPool() end
                self:SlamFx(Vector3(self.SlamCenter.x, self.SlamCenter.y, 0), self.SlamRadius)
                if self.DebugCombat then log("[VRF] boss slam contact " .. tostring(self.SlamCount)) end
            else
                self:CancelSlam()
            end
            return
        end
        if not self:AnyPlayerNear() then return end
        if self.EngageStart <= 0 then self.EngageStart = _UtilLogic.ElapsedSeconds end
        if not self.Enraged and monster.Hp <= monster.MaxHp * 0.5 then
            self.Enraged = true
            self:SummonMinions()
            self:Announce(self.BossName .. "이(가) 분노했다!")
        end
        self.SlamTimer = self.SlamTimer - delta
        if self.SlamTimer <= 0 then self:BeginSlam() end
    end

    @ExecSpace("ServerOnly")
    method void BeginSlam()
        -- 일반 공격을 먼저 끊고 위치를 고정한다. 예고한 원은 목표를 따라 움직이지 않는다.
        if self.SlamPhase ~= "idle" then return end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil or monster.IsDead or not self.Entity.Enable then return end
        local status = monster:Status()
        if status ~= nil and status:IsStunned() then return end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local chase = self.Entity.AIChaseComponent
        local wander = self.Entity.AIWanderComponent
        self.ResumeChase = isvalid(chase) and (chase.Enable or atk.SpacingControlled
            or (atk.AttackAnimationUntil > _UtilLogic.ElapsedSeconds and atk.ResumeChaseAfterAttack))
        self.ResumeWander = isvalid(wander) and wander.Enable
        atk:CancelPending()
        self.SlamCenter = self:PickSlamCenter()
        self.SlamPhase = "windup"
        self.PhaseRemaining = math.max(0.1, self.SlamWindup)
        local interval = self.Enraged and self.SlamInterval * 0.65 or self.SlamInterval
        self.SlamTimer = math.max(0.5, interval - self.PhaseRemaining - self.SlamRecovery)
        self:HoldMotion()
        if self.Entity.StateComponent.CurrentStateName ~= "IDLE" then self.Entity.StateComponent:ChangeState("IDLE") end
        if self.DebugCombat then log("[VRF] boss slam windup center=" .. tostring(self.SlamCenter) .. " radius=" .. tostring(self.SlamRadius)) end
    end

    @ExecSpace("ServerOnly")
    method void CheckBond(number delta)
        -- 형제 보스: 살아 있던 형제가 내 눈앞에서 쓰러지면 분노한다. 형제가 다시 나타나면(리스폰) 가라앉는다.
        -- 내가 다시 나타났을 때 형제가 이미 죽어 있는 것은 분노 조건이 아니다 (살아 있는 형제를 먼저 봐야 한다)
        if not self.Bonded then return end
        self.BondTimer = self.BondTimer - delta
        if self.BondTimer > 0 then return end
        self.BondTimer = 0.5
        ---@type Monster
        local me = self.Entity:GetComponent("script.Monster")
        local twinAlive = false
        local twinDead = false
        for _, c in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local other = c
            if c.Entity ~= self.Entity and other.SourceId == me.SourceId then
                if other.IsDead then twinDead = true else twinAlive = true end
            end
        end
        if self.RageMult > 1 then
            if twinAlive and not twinDead then
                self:Calm()
                log("[VRF] bond calm " .. me.SourceId)
            end
            return
        end
        if twinAlive and not twinDead then self.TwinSeenAlive = true end
        if twinDead and self.TwinSeenAlive then
            self.TwinSeenAlive = false
            self.RageMult = 1.5
            self.Entity.TransformComponent.Scale = self.Entity.TransformComponent.Scale * 1.15
            self:Announce("형제를 잃은 문지기가 분노했다! (공격 +50%)")
            log("[VRF] bond rage " .. me.SourceId)
        end
    end

    @ExecSpace("ServerOnly")
    method void Calm()
        -- 형제 분노 해제 (내가 죽었거나 형제가 돌아왔다)
        if self.RageMult <= 1 then return end
        self.RageMult = 1
        self.Entity.TransformComponent.Scale = self.Entity.TransformComponent.Scale / 1.15
    end

    @ExecSpace("ServerOnly")
    method Vector2 PickSlamCenter()
        -- 기본은 자기 발밑, SlamAtTarget이면 가장 가까운 플레이어 발밑 (예고 뒤 그 자리를 친다)
        local here = _Util:Pos2(self.Entity)
        if not self.SlamAtTarget then return here + Vector2(0, 0.3) end
        local best = nil
        local bestD = 999
        for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, here, self.EngageRange + 2)) do
            local d = (_Util:Pos2(p) - here):Magnitude()
            if d < bestD then
                best = p
                bestD = d
            end
        end
        if best == nil then return here + Vector2(0, 0.3) end
        return _Util:Pos2(best) + Vector2(0, 0.3)
    end

    @ExecSpace("ServerOnly")
    method number ScaledSlamDamage()
        -- 모델 기준 레벨의 내려찍기 피해 × 레벨 보정 (일반 공격과 같은 비율: 악몽·지옥·이름 있는 적 레벨 가산)
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil or atk.BaseDamage <= 0 then return self.SlamDamage end
        return self.SlamDamage * atk.Damage / atk.BaseDamage
    end

    @ExecSpace("ServerOnly")
    method void BeginPool()
        -- 내려찍은 자리에 장판을 남긴다
        self.PoolCenter = self.SlamCenter
        self.PoolRemaining = self.PoolSeconds
        self.PoolTick = 0.5
        self.PoolActive = true
        self:PoolFx(Vector3(self.SlamCenter.x, self.SlamCenter.y, 0), self.SlamRadius, self.PoolSeconds, self.PoolElement)
    end

    @ExecSpace("ServerOnly")
    method void UpdatePool(number delta)
        -- 0.5초마다 장판 안의 플레이어에게 내려찍기 피해의 12% (속성 100% · 저항·방어 적용).
        -- 판정 공격이 아니라 지속 피해라서 무적 시간을 걸지 않는다 (작은 틱이 내려찍기·일반 공격을 막아 주지 않게)
        if not self.PoolActive then return end
        self.PoolRemaining = self.PoolRemaining - delta
        if self.PoolRemaining <= 0 then self:EndPool() return end
        self.PoolTick = self.PoolTick - delta
        if self.PoolTick > 0 then return end
        self.PoolTick = 0.5
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local keepDamage = atk.SlamDamage
        local keepElement = atk.SlamElement
        atk.SlamDamage = math.max(1, self:ScaledSlamDamage() * 0.12)
        atk.SlamElement = self.PoolElement
        for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, self.PoolCenter, self.SlamRadius * 0.9)) do
            ---@type PlayerVitals
            local vitals = p:GetComponent("script.PlayerVitals")
            if vitals ~= nil then vitals:TakeTickDamage(atk:CalcDamage(self.Entity, p, "monster.slam")) end
        end
        atk.SlamDamage = keepDamage
        atk.SlamElement = keepElement
    end

    @ExecSpace("ServerOnly")
    method void EndPool()
        if not self.PoolActive then return end
        self.PoolActive = false
        self.PoolRemaining = 0
    end

    @ExecSpace("ServerOnly")
    method void HoldMotion()
        -- 예고와 회복 중에는 추적 및 일반 공격의 이동이 서로 덮어쓰지 않는다.
        local chase = self.Entity.AIChaseComponent
        local wander = self.Entity.AIWanderComponent
        if isvalid(chase) then chase.Enable = false end
        if isvalid(wander) then wander.Enable = false end
        self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
    end

    @ExecSpace("ServerOnly")
    method void CancelSlam()
        -- 사망·중단·종료 때 지연 타격을 남기지 않고 살아 있을 때만 원래 추적을 복원한다.
        if self.SlamPhase == "idle" then return end
        self.SlamPhase = "idle"
        self.PhaseRemaining = 0
        if not isvalid(self.Entity) then return end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil or monster.IsDead or not self.Entity.Enable then return end
        local status = monster:Status()
        if status ~= nil and status:IsStunned() then return end
        local chase = self.Entity.AIChaseComponent
        local wander = self.Entity.AIWanderComponent
        if isvalid(chase) then chase.Enable = self.ResumeChase end
        if isvalid(wander) then wander.Enable = self.ResumeWander end
        if self.Entity.StateComponent.CurrentStateName == "ATTACK" then self.Entity.StateComponent:ChangeState("IDLE") end
    end

    @ExecSpace("ClientOnly")
    method void DrawWarning()
        -- 실제 CircleShape와 같은 중심·반경을 그린다. 일반 공격과 렌더러 소유권을 구분한다.
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        local line = self.Entity.LineRendererComponent
        if atk == nil or not isvalid(line) then return end
        local windup = self.SlamPhase == "windup"
        if (not windup and not self.PoolActive) or not self:HasLocalAudience() then
            self:ClearWarning()
            return
        end
        -- 예고 = 주황 굵은 원 · 장판 = 속성 색 얇은 원 (독 초록 / 화염 주황빨강)
        local center = windup and self.SlamCenter or self.PoolCenter
        local radius = windup and self.SlamRadius or self.SlamRadius * 0.9
        local color = Color(1, 0.38, 0.12, 0.95)
        local width = 0.16
        if not windup then
            color = self.PoolElement == "poison" and Color(0.45, 1, 0.3, 0.8) or Color(1, 0.25, 0.1, 0.8)
            width = 0.09
        end
        local transform = self.Entity.TransformComponent
        line.Points:Clear()
        for i = 0, 32 do
            local angle = math.pi * 2 * i / 32
            local p = center + Vector2(math.cos(angle), math.sin(angle)) * radius
            local localPoint = transform:ToLocalPoint(Vector3(p.x, p.y, transform.WorldPosition.z))
            line.Points:Add(LinePoint(Vector2(localPoint.x, localPoint.y), color, width))
        end
        atk.WarningOwner = "boss"
    end

    @ExecSpace("ClientOnly")
    method void ClearWarning()
        -- 자신이 그린 원만 지워 이어지는 일반 공격 예고를 지우지 않는다.
        if not isvalid(self.Entity) then return end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk ~= nil and atk.WarningOwner == "boss" then
            if isvalid(self.Entity.LineRendererComponent) then self.Entity.LineRendererComponent.Points:Clear() end
            atk.WarningOwner = ""
        end
    end

    @ExecSpace("ClientOnly")
    method boolean HasLocalAudience()
        -- 다른 맵의 보스 효과가 현재 화면과 카메라에 나타나지 않는다.
        local me = _UserService.LocalPlayer
        return isvalid(me) and isvalid(self.Entity) and me.CurrentMap == self.Entity.CurrentMap
    end

    method void OnEndPlay()
        -- 타격은 OnUpdate에만 존재하므로 종료 이후 실행될 예약 콜백이 없다.
        if self:IsServer() then self:CancelSlam() else self:ClearWarning() end
    end

    @ExecSpace("ServerOnly")
    method boolean AnyPlayerNear()
        return #_Util:PlayersNear(self.Entity.CurrentMap, _Util:Pos2(self.Entity), self.EngageRange) > 0
    end

    @ExecSpace("ServerOnly")
    method void SummonMinions()
        -- 보스 주위에 리스폰 없는 졸개 (보스 레벨 -2)
        local map = self.Entity.CurrentMap
        local p = self.Entity.TransformComponent.WorldPosition
        ---@type Monster
        local boss = self.Entity:GetComponent("script.Monster")
        local level = boss ~= nil and math.max(1, boss.Level - 2) or 1
        for i = 1, self.MinionCount do
            local ang = math.pi * 2 * i / self.MinionCount
            local pos = Vector3(p.x + math.cos(ang) * 1.5, p.y + math.sin(ang) * 1.0, 0)
            local e = _SpawnService:SpawnByModelId(self.MinionModelId, "BossMinion", pos, map)
            if isvalid(e) then
                _Util:AfterSpawn(e, "script.Monster", function(comp)
                    ---@type Monster
                    local m = comp
                    m.RespawnDelay = -1
                    m:ApplyLevel(level, false)
                end, nil)
            end
        end
    end

    @ExecSpace("Multicast")
    method void SlamFx(Vector3 pos, number radius)
        -- 같은 맵에서만 충격을 보여 주고 가까운 관전자만 카메라를 흔든다.
        if not self:HasLocalAudience() then return end
        _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, self.Entity, pos, 0, Vector3(radius * 0.25, radius * 0.25, 1), false, nil)
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) and (_Util:Pos2(_UserService.LocalPlayer) - Vector2(pos.x, pos.y)):Magnitude() <= 10 then cam:ShakeCamera(0.25, 0.2) end
    end

    @ExecSpace("Multicast")
    method void PoolFx(Vector3 pos, number radius, number seconds, string element)
        -- 장판 입자: 바닥에 낮게 도는 속성 색 소용돌이 (+ 화염은 불길). seconds 뒤 지운다
        if not self:HasLocalAudience() then return end
        local tint = element == "poison" and Color(0.35, 0.95, 0.25, 0.55) or Color(1, 0.35, 0.1, 0.55)
        local serials = {}
        table.insert(serials, _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, pos, 0, Vector3(radius, radius * 0.35, 1), true, { Color = tint }))
        if element == "fire" then
            table.insert(serials, _ParticleService:PlayBasicParticle(BasicParticleType.FireField, self.Entity, pos, 0, Vector3(radius * 0.45, radius * 0.3, 1), true, nil))
        end
        _TimerService:SetTimerOnce(function()
            for _, serial in ipairs(serials) do
                if serial ~= nil and serial > 0 then _ParticleService:RemoveParticle(serial) end
            end
        end, seconds)
    end

    @ExecSpace("Multicast")
    method void Announce(string text)
        -- 현재 전투에 참여하는 맵의 사용자에게만 알린다.
        if not self:HasLocalAudience() then return end
        _ScreenMessageLogic:PrivateMsg(text)
    end

end
