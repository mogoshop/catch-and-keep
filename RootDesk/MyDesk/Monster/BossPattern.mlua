-- 보스 패턴: 주기적으로 경고 후 내려찍기(광역), 생명 50% 이하에서 졸개 소환 + 패턴 가속.
-- 피해 판정은 같은 엔티티의 MonsterAttack:Slam을 쓴다. 내려찍기 피해는 몬스터 레벨 보정(공격력 배율)을 따른다.
-- 장판(PoolSeconds > 0): 내려찍은 자리에 PoolSeconds초 동안 남아 0.5초마다 PoolElement 피해 (세르카 독 · 사서 화염).
-- SlamAtTarget: 자기 자리 대신 가장 가까운 플레이어 발밑에 예고한다 (원거리 미니보스).
-- BondGroup: 같은 맵의 같은 묶음(형제)이 쓰러지면 분노 — 공격 +50% · 공격 속도 +30% (사원 문지기 두 형제: 창·방패).
-- 졸개는 보스 레벨 -2로 맞춘다 (레벨 1 졸개가 높은 맵에서 의미 없어지지 않게).
-- 레이드 강화 (10-21, bosses.csv aura·ult):
--   오라: 싸우는 동안 몸 주위 AuraRadius칸에 늘 켜진 속성 지대 — 0.5초마다 공격력 × AuraMult 피해(냉기는 둔화), 안의 졸개 피해 +25%
--   궁극기: 생명 25%에서 한 번 — marks(플레이어마다 발밑 원 UltWaves번) · half(보스 한쪽 절반을 덮는 큰 원). 쓰는 동안 내려찍기·기술 멈춤
--   기술 순서: 고정 차례 대신 무작위 (같은 기술 연속 없음)
@Component
script BossPattern extends Component

    property string BossName = "보스"
    property number SlamInterval = 6
    property number SlamWindup = 1.0
    property number SlamRadius = 2.2
    property number SlamDamage = 22
    property number EngageRange = 5
    property string MinionModelId = "graveworm"
    property integer MinionCount = 3
    property number PoolSeconds = 0
    @Sync
    property string PoolElement = ""         -- 10-22 동기화: 액트 3·재의 왕은 단계마다 서버에서 바꾼다 → 예고 고리 색이 따라가야 한다
    property boolean SlamAtTarget = false
    @Sync
    property boolean PoolActive = false
    @Sync
    property Vector2 PoolCenter = Vector2(0, 0)
    property number PoolRemaining = 0
    property number PoolTick = 0
    property string BondGroup = ""            -- 형제 묶음 이름 (bosses.csv bond, 비면 없음)
    property number RageMult = 1             -- 형제 분노 배율 (Monster.GetDamageDealtMultiplier가 읽는다)
    property number BondTimer = 0
    property boolean TwinSeenAlive = false   -- 살아 있는 형제를 본 뒤에만 「형제가 쓰러짐」으로 분노한다 (다시 나타날 때 오작동 방지)

    property number SlamRecovery = 0.65
    @Sync
    property string SlamPhase = "idle"
    @Sync
    property Vector2 SlamCenter = Vector2(0, 0)
    property number PhaseRemaining = 0
    property boolean ResumeChase = false
    property boolean ResumeWander = false
    property integer SlamCount = 0
    property boolean DebugCombat = false

    property number SlamTimer = 3
    property string Skills = ""              -- 내려찍기 사이에 쓰는 변종 기술 목록 (bosses.csv skills → GameData.BossSkills)
    property integer SkillIndex = 0
    property number SkillTimer = 4
    property number SkillInterval = 5
    property boolean Enraged = false
    property boolean WasDead = false
    property number EngageStart = 0        -- 처음 플레이어와 마주친 시각 (처치 시간 랭킹)

    @Sync
    property string AuraKind = ""            -- 오라 속성 (비면 없음 · 서버가 bosses.csv에서 채운다 → 오라 색을 위해 동기화)
    @Sync
    property number AuraRadius = 0
    property number AuraMult = 0
    @Sync
    property boolean AuraOn = false
    property number AuraTick = 0
    property integer AuraFx = 0              -- 클라이언트: 오라 입자
    property integer SlamTele = 0            -- 클라이언트: 내려찍기 예고 (Util.Telegraph id)
    property number AuraFxRadius = 0
    property string UltKind = ""
    property string UltName = ""
    property number UltMult = 0
    property integer UltWaves = 1
    property boolean UltDone = false
    property number UltBusyUntil = 0
    property integer UltCount = 0

    method void OnBeginPlay()
        -- 내려찍기는 소유 타이머 없는 단계 갱신으로 예고·타격·회복을 순서대로 실행한다.
        if self:IsServer() then
            ---@type Monster
            local monster = self.Entity:GetComponent("script.Monster")
            local info = monster ~= nil and _GameData:GetBossSkills(monster.SourceId) or nil
            if info ~= nil then
                self.Skills = info.skills
                self.SkillInterval = info.interval
                self.AuraKind = info.aura or ""
                self.AuraRadius = info.auraR or 0
                self.AuraMult = info.auraMult or 0
                self.UltKind = info.ult or ""
                self.UltName = info.ultName or ""
                self.UltMult = info.ultMult or 0
                self.UltWaves = math.max(1, math.floor(info.ultWaves or 1))
            end
            log("[VRF] BossPattern phased slam ready " .. self.BossName .. " skills=" .. self.Skills)
        end
    end

    method void OnUpdate(number delta)
        -- 클라이언트는 서버가 확정한 타격 원을 표시하고 서버만 전투 단계를 진행한다.
        if self:IsClient() then
            self:DrawWarning()
            self:UpdateAuraFx()
            return
        end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil then return end
        if monster.IsDead or not self.Entity.Enable then
            self:CancelSlam()
            self:EndPool()
            self:Calm()
            self.TwinSeenAlive = false
            if not self.WasDead and monster.IsDead then self:Announce(self.BossName .. " 처치!") end
            self.WasDead = monster.IsDead
            self.Enraged = false
            self.SlamTimer = 3
            self.EngageStart = 0
            self.AuraOn = false
            self.UltDone = false
            self.UltBusyUntil = 0
            return
        end
        self.WasDead = false
        self:UpdatePool(delta)
        self:CheckBond(delta)
        local status = monster:Status()
        if status ~= nil and status:IsStunned() then self:CancelSlam() return end
        if self.SlamPhase ~= "idle" then
            -- 회피로 반경 밖에 나가도 예고한 자리에 친다. 맵을 떠난 뒤 남는 공격은 취소한다.
            if #_Util:PlayersInMap(self.Entity.CurrentMap) == 0 then self:CancelSlam() return end
            self:HoldMotion()
            self.PhaseRemaining = self.PhaseRemaining - delta
            if self.PhaseRemaining > 0 then return end
            if self.SlamPhase == "windup" then
                self.SlamPhase = "recovery"
                self.PhaseRemaining = self.SlamRecovery
                ---@type MonsterAttack
                local atk = self.Entity:GetComponent("script.MonsterAttack")
                if atk ~= nil then
                    self.Entity.StateComponent:ChangeState("ATTACK")
                    atk:Slam(self.SlamCenter, self.SlamRadius, self:ScaledSlamDamage())
                    self.SlamCount = self.SlamCount + 1
                end
                if self.PoolSeconds > 0 then self:BeginPool() end
                self:SlamFx(Vector3(self.SlamCenter.x, self.SlamCenter.y, 0), self.SlamRadius)
                if self.DebugCombat then log("[VRF] boss slam contact " .. tostring(self.SlamCount)) end
            else
                self:CancelSlam()
            end
            return
        end
        if not self:AnyPlayerNear() then
            self.AuraOn = false
            return
        end
        self.AuraOn = self.AuraKind ~= "" and self.AuraRadius > 0
        self:UpdateAura(delta)
        if _UtilLogic.ElapsedSeconds < self.UltBusyUntil then
            self:HoldMotion()
            return
        end
        if not self.UltDone and self.UltKind ~= "" and monster.Hp <= monster.MaxHp * 0.25 then
            self.UltDone = true
            self:BeginUlt()
            return
        end
        if self.EngageStart <= 0 then self.EngageStart = _UtilLogic.ElapsedSeconds end
        if not self.Enraged and monster.Hp <= monster.MaxHp * 0.5 then
            self.Enraged = true
            self:SummonMinions()
        end
        self.SlamTimer = self.SlamTimer - delta
        self.SkillTimer = self.SkillTimer - delta
        if self.Skills ~= "" and self.SkillTimer <= 0 and self.SlamTimer > 1.5 then
            -- 기술은 무작위로 고른다 — 같은 기술 연속 없음 (분노하면 더 자주)
            local list = {}
            for id in string.gmatch(self.Skills, "[^;]+") do table.insert(list, id) end
            local pick = _UtilLogic:RandomIntegerRange(1, #list)
            if #list > 1 and pick == self.SkillIndex then pick = pick % #list + 1 end
            self.SkillIndex = pick
            ---@type MonsterTraits
            local traits = self.Entity:GetComponent("script.MonsterTraits")
            local target = nil
            local near = _Util:PlayersNear(self.Entity.CurrentMap, _Util:Pos2(self.Entity), 9)
            if #near > 0 then target = near[1] end
            if traits ~= nil then traits:CastSkill(list[self.SkillIndex], target) end
            self.SkillTimer = self.Enraged and self.SkillInterval * 0.7 or self.SkillInterval
        end
        if self.SlamTimer <= 0 then self:BeginSlam() end
    end

    @ExecSpace("ServerOnly")
    method void BeginSlam()
        -- 일반 공격을 먼저 끊고 위치를 고정한다. 예고한 원은 목표를 따라 움직이지 않는다.
        if self.SlamPhase ~= "idle" then return end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil or monster.IsDead or not self.Entity.Enable then return end
        local status = monster:Status()
        if status ~= nil and status:IsStunned() then return end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local chase = self.Entity.AIChaseComponent
        local wander = self.Entity.AIWanderComponent
        self.ResumeChase = isvalid(chase) and (chase.Enable or atk.SpacingControlled
            or (atk.AttackAnimationUntil > _UtilLogic.ElapsedSeconds and atk.ResumeChaseAfterAttack))
        self.ResumeWander = isvalid(wander) and wander.Enable
        atk:CancelPending()
        self.SlamCenter = self:PickSlamCenter()
        self.SlamPhase = "windup"
        self.PhaseRemaining = math.max(0.1, self.SlamWindup)
        if self.PoolElement == "light" then self:LightWarnFx(Vector3(self.SlamCenter.x, self.SlamCenter.y, 0), self.SlamRadius, self.PhaseRemaining) end
        local interval = self.Enraged and self.SlamInterval * 0.65 or self.SlamInterval
        self.SlamTimer = math.max(0.5, interval - self.PhaseRemaining - self.SlamRecovery)
        self:HoldMotion()
        if self.Entity.StateComponent.CurrentStateName ~= "IDLE" then self.Entity.StateComponent:ChangeState("IDLE") end
        if self.DebugCombat then log("[VRF] boss slam windup center=" .. tostring(self.SlamCenter) .. " radius=" .. tostring(self.SlamRadius)) end
    end

    @ExecSpace("ServerOnly")
    method void CheckBond(number delta)
        -- 형제 보스: 살아 있던 형제가 내 눈앞에서 쓰러지면 분노한다. 형제가 다시 나타나면(리스폰) 가라앉는다.
        -- 내가 다시 나타났을 때 형제가 이미 죽어 있는 것은 분노 조건이 아니다 (살아 있는 형제를 먼저 봐야 한다)
        if self.BondGroup == "" then return end
        self.BondTimer = self.BondTimer - delta
        if self.BondTimer > 0 then return end
        self.BondTimer = 0.5
        ---@type Monster
        local me = self.Entity:GetComponent("script.Monster")
        local twinAlive = false
        local twinDead = false
        for _, c in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local other = c
            ---@type BossPattern
            local otherBond = c.Entity:GetComponent("script.BossPattern")
            if c.Entity ~= self.Entity and otherBond ~= nil and otherBond.BondGroup == self.BondGroup then
                if other.IsDead then twinDead = true else twinAlive = true end
            end
        end
        if self.RageMult > 1 then
            if twinAlive and not twinDead then
                self:Calm()
                log("[VRF] bond calm " .. me.SourceId .. " group " .. self.BondGroup)
            end
            return
        end
        if twinAlive and not twinDead then self.TwinSeenAlive = true end
        if twinDead and self.TwinSeenAlive then
            self.TwinSeenAlive = false
            self.RageMult = 1.5
            self.Entity.TransformComponent.Scale = self.Entity.TransformComponent.Scale * 1.15
            log("[VRF] bond rage " .. me.SourceId .. " group " .. self.BondGroup)
        end
    end

    @ExecSpace("ServerOnly")
    method void Calm()
        -- 형제 분노 해제 (내가 죽었거나 형제가 돌아왔다)
        if self.RageMult <= 1 then return end
        self.RageMult = 1
        self.Entity.TransformComponent.Scale = self.Entity.TransformComponent.Scale / 1.15
    end

    @ExecSpace("ServerOnly")
    method Vector2 PickSlamCenter()
        -- 기본은 자기 발밑, SlamAtTarget이면 가장 가까운 플레이어 발밑 (예고 뒤 그 자리를 친다)
        local here = _Util:Pos2(self.Entity)
        if not self.SlamAtTarget then return here + Vector2(0, 0.3) end
        local best = nil
        local bestD = 999
        for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, here, self.EngageRange + 2)) do
            local d = (_Util:Pos2(p) - here):Magnitude()
            if d < bestD then
                best = p
                bestD = d
            end
        end
        if best == nil then return here + Vector2(0, 0.3) end
        return _Util:Pos2(best) + Vector2(0, 0.3)
    end

    @ExecSpace("ServerOnly")
    method number ScaledSlamDamage()
        -- 모델 기준 레벨의 내려찍기 피해 × 레벨 보정 (일반 공격과 같은 비율: 악몽·지옥·이름 있는 적 레벨 가산)
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil or atk.BaseDamage <= 0 then return self.SlamDamage end
        return self.SlamDamage * atk.Damage / atk.BaseDamage
    end

    @ExecSpace("ServerOnly")
    method void BeginPool()
        -- 내려찍은 자리에 장판을 남긴다
        self.PoolCenter = self.SlamCenter
        self.PoolRemaining = self.PoolSeconds
        self.PoolTick = 0.5
        self.PoolActive = true
        self:PoolFx(Vector3(self.SlamCenter.x, self.SlamCenter.y, 0), self.SlamRadius, self.PoolSeconds, self.PoolElement)
    end

    @ExecSpace("ServerOnly")
    method void UpdatePool(number delta)
        -- 0.5초마다 장판 안의 플레이어에게 내려찍기 피해의 12% (속성 100% · 저항·방어 적용).
        -- 판정 공격이 아니라 지속 피해라서 무적 시간을 걸지 않는다 (작은 틱이 내려찍기·일반 공격을 막아 주지 않게)
        if not self.PoolActive then return end
        self.PoolRemaining = self.PoolRemaining - delta
        if self.PoolRemaining <= 0 then self:EndPool() return end
        self.PoolTick = self.PoolTick - delta
        if self.PoolTick > 0 then return end
        self.PoolTick = 0.5
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local keepDamage = atk.SlamDamage
        local keepElement = atk.SlamElement
        atk.SlamDamage = math.max(1, self:ScaledSlamDamage() * 0.12)
        atk.SlamElement = self.PoolElement
        for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, self.PoolCenter, self.SlamRadius * 0.9)) do
            ---@type PlayerVitals
            local vitals = p:GetComponent("script.PlayerVitals")
            if vitals ~= nil then vitals:TakeTickDamage(atk:CalcDamage(self.Entity, p, "monster.slam")) end
            if self.PoolElement == "cold" then
                -- 냉기 장판 위에서는 둔화 (액트 3 물에 잠긴 사제 · 제독 2단계)
                ---@type PlayerStats
                local st = p:GetComponent("script.PlayerStats")
                if st ~= nil then st:ApplyChill(1.0) end
            end
        end
        atk.SlamDamage = keepDamage
        atk.SlamElement = keepElement
    end

    @ExecSpace("ServerOnly")
    method void EndPool()
        if not self.PoolActive then return end
        self.PoolActive = false
        self.PoolRemaining = 0
    end

    @ExecSpace("ServerOnly")
    method void HoldMotion()
        -- 예고와 회복 중에는 추적 및 일반 공격의 이동이 서로 덮어쓰지 않는다.
        local chase = self.Entity.AIChaseComponent
        local wander = self.Entity.AIWanderComponent
        if isvalid(chase) then chase.Enable = false end
        if isvalid(wander) then wander.Enable = false end
        self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
    end

    @ExecSpace("ServerOnly")
    method void CancelSlam()
        -- 사망·중단·종료 때 지연 타격을 남기지 않고 살아 있을 때만 원래 추적을 복원한다.
        if self.SlamPhase == "idle" then return end
        self.SlamPhase = "idle"
        self.PhaseRemaining = 0
        if not isvalid(self.Entity) then return end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil or monster.IsDead or not self.Entity.Enable then return end
        local status = monster:Status()
        if status ~= nil and status:IsStunned() then return end
        local chase = self.Entity.AIChaseComponent
        local wander = self.Entity.AIWanderComponent
        if isvalid(chase) then chase.Enable = self.ResumeChase end
        if isvalid(wander) then wander.Enable = self.ResumeWander end
        if self.Entity.StateComponent.CurrentStateName == "ATTACK" then self.Entity.StateComponent:ChangeState("IDLE") end
    end

    @ExecSpace("ClientOnly")
    method void DrawWarning()
        -- 내려찍기 예고: 준비가 시작되는 순간 실제 CircleShape 중심·반경에 흐린 빛 테두리 + 차오르는 원판 (Util.Telegraph, 10-21).
        -- 준비가 중간에 끊기면 지운다. 장판은 PoolFx가 바닥 그림 + 테두리로 보여 준다
        local windup = self.SlamPhase == "windup" and self:HasLocalAudience()
        if windup and self.SlamTele == 0 then
            self.SlamTele = _Util:Telegraph(self.Entity, self.SlamCenter, self.SlamRadius, self.PoolElement, math.max(0.1, self.SlamWindup))
        elseif not windup and self.SlamTele ~= 0 then
            _Util:StopTelegraph(self.SlamTele)
            self.SlamTele = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearWarning()
        -- 자신이 그린 원만 지워 이어지는 일반 공격 예고를 지우지 않는다.
        if not isvalid(self.Entity) then return end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk ~= nil and atk.WarningOwner == "boss" then
            if isvalid(self.Entity.LineRendererComponent) then self.Entity.LineRendererComponent.Points:Clear() end
            atk.WarningOwner = ""
        end
    end

    @ExecSpace("ClientOnly")
    method boolean HasLocalAudience()
        -- 다른 맵의 보스 효과가 현재 화면과 카메라에 나타나지 않는다.
        local me = _UserService.LocalPlayer
        return isvalid(me) and isvalid(self.Entity) and me.CurrentMap == self.Entity.CurrentMap
    end

    method void OnEndPlay()
        -- 타격은 OnUpdate에만 존재하므로 종료 이후 실행될 예약 콜백이 없다.
        if self:IsServer() then
            self:CancelSlam()
        else
            self:ClearWarning()
            if self.AuraFx ~= 0 then _ParticleService:RemoveParticle(self.AuraFx) end
            self.AuraFx = 0
            if self.SlamTele ~= 0 then _Util:StopTelegraph(self.SlamTele) end
            self.SlamTele = 0
        end
    end

    @ExecSpace("ServerOnly")
    method boolean AnyPlayerNear()
        return #_Util:PlayersNear(self.Entity.CurrentMap, _Util:Pos2(self.Entity), self.EngageRange) > 0
    end

    @ExecSpace("ServerOnly")
    method void UpdateAura(number delta)
        -- 오라: 0.5초마다 반경 안 플레이어에게 공격력 × AuraMult 속성 피해 (지속 피해라 무적 시간 없음 · 냉기는 둔화), 안의 졸개 피해 +25%
        if not self.AuraOn then return end
        self.AuraTick = self.AuraTick - delta
        if self.AuraTick > 0 then return end
        self.AuraTick = 0.5
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local here = _Util:Pos2(self.Entity)
        local keepDamage = atk.SlamDamage
        local keepElement = atk.SlamElement
        atk.SlamDamage = math.max(1, atk.Damage * self.AuraMult)
        atk.SlamElement = self.AuraKind
        for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, here, self.AuraRadius)) do
            ---@type PlayerVitals
            local vitals = p:GetComponent("script.PlayerVitals")
            if vitals ~= nil then vitals:TakeTickDamage(atk:CalcDamage(self.Entity, p, "monster.slam")) end
            if self.AuraKind == "cold" then
                ---@type PlayerStats
                local st = p:GetComponent("script.PlayerStats")
                if st ~= nil then st:ApplyChill(0.7) end
            end
        end
        atk.SlamDamage = keepDamage
        atk.SlamElement = keepElement
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, here, self.AuraRadius)) do
            if m.Entity ~= self.Entity then m:ReceiveAura("dmg", 25) end
        end
    end

    @ExecSpace("ClientOnly")
    method void UpdateAuraFx()
        -- 오라 지대: 보스를 따라다니는 속성 색 소용돌이 (반경이 바뀌면 다시 건다).
        -- 10-22: 바닥 층(몸 아래)에 옅게 깔고, 내려찍기 예고·충격 동안은 끈다 — 예고 고리와 겹쳐 난잡해 보였다
        local want = self.AuraOn and self.AuraRadius > 0 and self.SlamPhase == "idle" and self:HasLocalAudience()
        if self.AuraFx ~= 0 and (not want or self.AuraFxRadius ~= self.AuraRadius) then
            _ParticleService:RemoveParticle(self.AuraFx)
            self.AuraFx = 0
        end
        if not want or self.AuraFx ~= 0 then return end
        local c = self:ElementTint(self.AuraKind)
        local r = self.AuraRadius
        self.AuraFxRadius = r
        self.AuraFx = _ParticleService:PlayBasicParticleAttached(BasicParticleType.SpinField, self.Entity, Vector3(0, 0.05, 0), 0, Vector3(r, r * 0.4, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(c.r, c.g, c.b, 0.3) })
    end

    method Color ElementTint(string element)
        -- 오라·궁극기 색: 독 초록 · 냉기 하늘 · 번개 흰 노랑 · 화염(기본) 주황빨강
        if element == "poison" then return Color(0.45, 1, 0.3, 1) end
        if element == "cold" then return Color(0.5, 0.85, 1, 1) end
        if element == "light" then return Color(1, 0.95, 0.5, 1) end
        return Color(1, 0.35, 0.12, 1)
    end

    @ExecSpace("ServerOnly")
    method void BeginUlt()
        -- 궁극기 (생명 25%, 한 번): 멈춰 서서 기를 모은 뒤 UltWaves번 — 예고 1.5초 → 그 자리에서 터진다
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        local chase = self.Entity.AIChaseComponent
        local resume = isvalid(chase) and (chase.Enable or atk.SpacingControlled)
        atk:CancelPending()
        local gap = 1.9
        local total = self.UltWaves * gap + 0.6
        self.UltBusyUntil = _UtilLogic.ElapsedSeconds + total
        self.UltCount = self.UltCount + 1
        self:HoldMotion()
        if self.Entity.StateComponent.CurrentStateName ~= "IDLE" then self.Entity.StateComponent:ChangeState("IDLE") end
        self:UltBanner()
        log("[VRF] boss ult " .. self.UltName .. " kind=" .. self.UltKind .. " waves=" .. tostring(self.UltWaves))
        local map = self.Entity.CurrentMap
        local serial = self.UltCount
        for w = 1, self.UltWaves do
            _TimerService:SetTimerOnce(function() self:UltWave(map, serial) end, 0.6 + (w - 1) * gap)
        end
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or self.UltCount ~= serial then return end
            if isvalid(chase) and resume then chase.Enable = true end
        end, total)
    end

    @ExecSpace("ServerOnly")
    method void UltWave(Entity map, integer serial)
        -- 한 번: 원 위치를 정해 예고하고 1.5초 뒤 같은 자리에 터뜨린다
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if not isvalid(self.Entity) or monster == nil or monster.IsDead or self.Entity.CurrentMap ~= map or self.UltCount ~= serial then return end
        local here = _Util:Pos2(self.Entity)
        local centers = {}
        local radius = 1.6
        if self.UltKind == "half" then
            -- 가장 가까운 플레이어 쪽 절반을 덮는다 (반대쪽이 안전)
            local side = 1
            local players = _Util:PlayersNear(map, here, 14)
            if #players > 0 and _Util:Pos2(players[1]).x < here.x then side = -1 end
            radius = 6
            table.insert(centers, here.x + side * 5.2)
            table.insert(centers, here.y)
        else
            for _, p in ipairs(_Util:PlayersNear(map, here, 14)) do
                local at = _Util:Pos2(p)
                table.insert(centers, at.x)
                table.insert(centers, at.y)
            end
        end
        if #centers == 0 then return end
        self:UltWarnFx(centers, radius, self.AuraKind, 1.5)
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or monster.IsDead or self.Entity.CurrentMap ~= map then return end
            ---@type MonsterAttack
            local atk = self.Entity:GetComponent("script.MonsterAttack")
            if atk == nil then return end
            for i = 1, #centers, 2 do
                local c = Vector2(centers[i], centers[i + 1])
                atk:SlamWithElement(c, radius, atk.Damage * self.UltMult, self.AuraKind)
                for _, p in ipairs(_Util:PlayersNear(map, c, radius)) do
                    ---@type PlayerStats
                    local st = p:GetComponent("script.PlayerStats")
                    if st ~= nil then
                        if self.AuraKind == "cold" then st:ApplyChill(2) else st:ApplyStagger(0.8) end
                    end
                end
            end
            self:UltBoomFx(centers, radius, self.AuraKind)
        end, 1.5)
    end

    @ExecSpace("Multicast")
    method void UltBanner()
        -- 궁극기 기 모으기: 보스 몸에 속성 빛 + 화면 흔들림 (글 알림은 띄우지 않는다 — 10-21 사용자: 대사·공략 문구 금지)
        if not self:HasLocalAudience() then return end
        local c = self:ElementTint(self.AuraKind)
        _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, self.Entity, Vector3(0, 0.6, 0), 0, Vector3(1.4, 1.4, 1), false, { Color = c })
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then cam:ShakeCamera(0.2, 0.5) end
    end

    @ExecSpace("Multicast")
    method void UltWarnFx(table centers, number radius, string element, number seconds)
        -- 궁극기 예고: 원마다 흐린 빛 테두리 + 차오르는 원판 (Util.Telegraph). 그동안 평타 예고가 겹치지 않게 막는다
        if not self:HasLocalAudience() then return end
        for i = 1, #centers, 2 do
            _Util:Telegraph(self.Entity, Vector2(centers[i], centers[i + 1]), radius, element, seconds)
        end
        ---@type MonsterAttack
        local atk = self.Entity:GetComponent("script.MonsterAttack")
        if atk == nil then return end
        atk.WarningOwner = "ult"
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and atk.WarningOwner == "ult" then atk.WarningOwner = "" end
        end, seconds)
    end

    @ExecSpace("Multicast")
    method void UltBoomFx(table centers, number radius, string element)
        -- 궁극기 터짐: 원마다 큰 폭발 + 속성 기둥, 화면 흔들림
        if not self:HasLocalAudience() then return end
        local c = self:ElementTint(element)
        for i = 1, #centers, 2 do
            local pos = Vector3(centers[i], centers[i + 1], 0)
            _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, self.Entity, pos, 0, Vector3(radius * 0.3, radius * 0.3, 1), false, { Color = c })
            _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, pos, 0, Vector3(radius, radius, 1), false, { Color = Color(c.r, c.g, c.b, 0.7) })
        end
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then cam:ShakeCamera(0.4, 0.35) end
    end

    @ExecSpace("ServerOnly")
    method void SummonMinions()
        -- 보스 주위에 리스폰 없는 졸개 (보스 레벨 -2)
        local map = self.Entity.CurrentMap
        local p = self.Entity.TransformComponent.WorldPosition
        ---@type Monster
        local boss = self.Entity:GetComponent("script.Monster")
        local level = boss ~= nil and math.max(1, boss.Level - 2) or 1
        for i = 1, self.MinionCount do
            local ang = math.pi * 2 * i / self.MinionCount
            local pos = Vector3(p.x + math.cos(ang) * 1.5, p.y + math.sin(ang) * 1.0, 0)
            local e = _SpawnService:SpawnByModelId(self.MinionModelId, "BossMinion", pos, map)
            if isvalid(e) then
                _Util:AfterSpawn(e, "script.Monster", function(comp)
                    ---@type Monster
                    local m = comp
                    m.RespawnDelay = -1
                    m:ApplyLevel(level, false)
                end, nil)
            end
        end
    end

    @ExecSpace("Multicast")
    method void SlamFx(Vector3 pos, number radius)
        -- 같은 맵에서만 충격을 보여 주고 가까운 관전자만 카메라를 흔든다.
        if not self:HasLocalAudience() then return end
        _ParticleService:PlayBasicParticle(BasicParticleType.BigExplosion, self.Entity, pos, 0, Vector3(radius * 0.25, radius * 0.25, 1), false, nil)
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) and (_Util:Pos2(_UserService.LocalPlayer) - Vector2(pos.x, pos.y)):Magnitude() <= 10 then cam:ShakeCamera(0.25, 0.2) end
    end

    @ExecSpace("Multicast")
    method void LightWarnFx(Vector3 pos, number radius, number seconds)
        -- 낙뢰 장판(제독 3단계) 예고: 내려찍기 준비 동안 목표 자리에 코덱스 낙뢰 예고 그림
        if not self:HasLocalAudience() then return end
        local mark = _Util:GroundDecal(_GameConst.SpriteGroundLightningWarning, 140, 70, self.Entity, pos, radius, Color(1, 1, 1, 0.95))
        _TimerService:SetTimerOnce(function() if mark ~= nil and mark ~= 0 then _EffectService:RemoveEffect(mark) end end, math.max(0.1, seconds))
    end

    @ExecSpace("Multicast")
    method void PoolFx(Vector3 pos, number radius, number seconds, string element)
        -- 장판 입자: 바닥에 낮게 도는 속성 색 소용돌이 (+ 화염은 불길). seconds 뒤 지운다
        if not self:HasLocalAudience() then return end
        local tint = Color(1, 0.35, 0.1, 0.55)
        if element == "poison" then tint = Color(0.35, 0.95, 0.25, 0.55)
        elseif element == "cold" then tint = Color(0.45, 0.8, 1, 0.55)
        elseif element == "light" then tint = Color(0.75, 0.9, 1, 0.55) end
        local serials = {}
        local full = radius * 0.9 * 2 / 2.56
        local rim = _EffectService:PlayEffect(_Util:TeleSprite(_GameConst.SpriteTeleRimBoss, element), self.Entity, pos, 0, Vector3(full, full, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1 })   -- 장판 범위 테두리 (보스 실금 고리)
        table.insert(serials, _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, pos, 0, Vector3(radius, radius * 0.35, 1), true, { SortingLayer = "MapLayer0", OrderInLayer = 1, Color = Color(tint.r, tint.g, tint.b, 0.3) }))
        if element == "fire" then
            table.insert(serials, _ParticleService:PlayBasicParticle(BasicParticleType.FireField, self.Entity, pos, 0, Vector3(radius * 0.45, radius * 0.3, 1), true, nil))
        end
        -- 바닥 그림 (코덱스 독·화염 장판 · 액트 3 냉기·등불빛 장판). 이펙트 Color 옵션은 스프라이트 색을 못 바꾸므로 속성마다 전용 그림
        local decal = 0
        local impact = 0
        if element == "poison" then decal = _Util:GroundDecal(_GameConst.SpriteGroundPoison, 160, 80, self.Entity, pos, radius, Color(1, 1, 1, 0.85))
        elseif element == "cold" then decal = _Util:GroundDecal(_GameConst.SpriteGroundCold, 140, 70, self.Entity, pos, radius, Color(1, 1, 1, 0.9))
        elseif element == "light" then
            decal = _Util:GroundDecal(_GameConst.SpriteGroundLantern, 140, 70, self.Entity, pos, radius, Color(1, 1, 1, 0.9))
            -- 꽂히는 순간 낙뢰 그림 0.4초
            impact = _Util:GroundDecal(_GameConst.SpriteGroundLightningImpact, 140, 70, self.Entity, pos, radius, Color(1, 1, 1, 1))
            _TimerService:SetTimerOnce(function() if impact ~= 0 then _EffectService:RemoveEffect(impact) end end, 0.4)
            table.insert(serials, _ParticleService:PlayBasicParticle(BasicParticleType.SparkLoop, self.Entity, pos, 0, Vector3(radius * 0.5, radius * 0.3, 1), true, { Color = Color(0.75, 0.9, 1, 0.9) }))
            _ParticleService:PlayBasicParticle(BasicParticleType.LightningStrikeSharpTall, self.Entity, pos, 0, Vector3(radius * 0.4, radius * 0.4, 1), false, { Color = Color(0.7, 0.88, 1, 1) })
        elseif _GameConst:ActOfMap(self.Entity.CurrentMap.Name) == 4 then decal = _Util:GroundDecal(_GameConst.SpriteGroundLava, 140, 70, self.Entity, pos, radius, Color(1, 1, 1, 0.9))   -- 액트 4: 용암 장판
        else decal = _Util:GroundDecal(_GameConst.SpriteGroundFire, 140, 70, self.Entity, pos, radius, Color(1, 1, 1, 0.85)) end
        _TimerService:SetTimerOnce(function()
            for _, serial in ipairs(serials) do
                if serial ~= nil and serial > 0 then _ParticleService:RemoveParticle(serial) end
            end
            if decal ~= nil and decal ~= 0 then _EffectService:RemoveEffect(decal) end
            if rim ~= nil and rim ~= 0 then _EffectService:RemoveEffect(rim) end
        end, seconds)
    end

    @ExecSpace("Multicast")
    method void Announce(string text)
        -- 현재 전투에 참여하는 맵의 사용자에게만 알린다.
        if not self:HasLocalAudience() then return end
        _NoticeFeed:Push(text)
    end

end
