-- 몬스터 상태 이상: 저주(약화의 낙인·쇠약), 독, 냉기 둔화. 시각은 _UtilLogic.ElapsedSeconds 기준.
-- 바깥에서는 Monster의 창구(ApplyCurse·ApplyPoison·ApplyChill)를 거쳐 부른다.
@Component
script MonsterStatus extends Component

    property number AmpUntil = 0
    property number AmpPct = 0
    property number WeakenUntil = 0
    property number WeakenPct = 0
    property number PoisonUntil = 0
    property number PoisonDps = 0
    property Entity PoisonSource = nil
    property integer PoisonTimer = 0
    property number ChillUntil = 0
    property number AuraDmg = 0              -- 받은 오오라 (변종 우두머리): 피해 % / 속도 % / 받는 피해 감소 %
    property number AuraHaste = 0
    property number AuraGuard = 0
    property number AuraUntil = 0
    property boolean HasteRefreshPending = false
    @Sync
    property number KnockUntil = 0           -- 넉백·경직 (서버). 그동안 이동·공격·특수 행동을 멈춘다
    property number StaggerUntil = 0
    property number PoiseDamage = 0
    property number PoiseHitAt = -99
    property number InterruptReadyAt = 0
    property integer InterruptCount = 0
    property string CurseTag = ""            -- 대상 정보 UI 표시

    method Monster Body()
        ---@type Monster
        local c = self.Entity:GetComponent("script.Monster")
        return c
    end

    @ExecSpace("ServerOnly")
    method void ApplyCurse(string kind, number pct, number duration)
        -- amp: 받는 피해 증가 / weaken: 주는 피해 감소
        local now = _UtilLogic.ElapsedSeconds
        if kind == "amp" then
            self.AmpPct = math.max(self.AmpPct, pct)
            self.AmpUntil = now + duration
            self.CurseTag = "약화의 낙인"
        elseif kind == "weaken" then
            self.WeakenPct = math.max(self.WeakenPct, pct)
            self.WeakenUntil = now + duration
            self.CurseTag = "쇠약"
        end
    end

    method number TakenMult()
        local m = self:AuraMult("guard")
        if _UtilLogic.ElapsedSeconds < self.AmpUntil then m = m * (1 + self.AmpPct / 100) end
        return m
    end

    @ExecSpace("ServerOnly")
    method void ReceiveAura(string effect, number value)
        -- 변종 우두머리 오오라: 범위 안에 있는 동안 auraTickSec마다 갱신, 벗어나면 auraHoldSec 뒤 사라진다
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.AuraUntil then
            self.AuraDmg = 0
            self.AuraHaste = 0
            self.AuraGuard = 0
        end
        local hadHaste = self.AuraHaste > 0
        if effect == "dmg" then self.AuraDmg = math.max(self.AuraDmg, value)
        elseif effect == "haste" then self.AuraHaste = math.max(self.AuraHaste, value)
        elseif effect == "guard" then self.AuraGuard = math.max(self.AuraGuard, value) end
        self.AuraUntil = now + _GameData.auraHoldSec
        if effect == "haste" and not hadHaste then self:RefreshSpeedLater() end
    end

    @ExecSpace("ServerOnly")
    method void RefreshSpeedLater()
        -- 질풍 오오라: 지금 속도를 올리고, 오오라가 끝나면 되돌린다
        local body = self:Body()
        if body == nil then return end
        body:RefreshSpeed()
        if self.HasteRefreshPending then return end
        self.HasteRefreshPending = true
        _TimerService:SetTimerOnce(function()
            self.HasteRefreshPending = false
            if not isvalid(self.Entity) then return end
            if _UtilLogic.ElapsedSeconds >= self.AuraUntil then body:RefreshSpeed() else self:RefreshSpeedLater() end
        end, _GameData.auraHoldSec + 0.05)
    end

    method number AuraMult(string kind)
        -- dmg: 주는 피해 배율 / haste: 속도 배율 / guard: 받는 피해 배율
        if _UtilLogic.ElapsedSeconds >= self.AuraUntil then return 1 end
        if kind == "dmg" then return 1 + self.AuraDmg / 100 end
        if kind == "haste" then return 1 + self.AuraHaste / 100 end
        if kind == "guard" then return math.max(0.1, 1 - self.AuraGuard / 100) end
        return 1
    end

    method number WeakenMult()
        if _UtilLogic.ElapsedSeconds < self.WeakenUntil then return math.max(0.1, 1 - self.WeakenPct / 100) end
        return 1
    end

    method number SpeedMult()
        local m = self:AuraMult("haste")
        if _UtilLogic.ElapsedSeconds < self.ChillUntil then m = m * 0.5 end
        return m
    end

    @ExecSpace("ServerOnly")
    method void ApplyPoison(number dps, number duration, Entity source)
        -- 0.5초마다 피해. 더 센 독이 들어오면 덮어쓴다. 독 저항으로 줄인다
        self.PoisonDps = math.max(self.PoisonDps, dps)
        self.PoisonUntil = _UtilLogic.ElapsedSeconds + duration
        self.PoisonSource = source
        if self.PoisonTimer ~= 0 then return end
        self.PoisonTimer = _TimerService:SetTimerRepeat(function() self:PoisonTick() end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method void PoisonTick()
        local body = self:Body()
        if body == nil or body.IsDead or _UtilLogic.ElapsedSeconds > self.PoisonUntil then
            self:StopPoison()
            return
        end
        body:TakeDamage(self.PoisonDps * 0.5 * math.max(0, 1 - body:GetResist("poison") / 100), self.PoisonSource)
    end

    @ExecSpace("ServerOnly")
    method void StopPoison()
        if self.PoisonTimer ~= 0 then _TimerService:ClearTimer(self.PoisonTimer) end
        self.PoisonTimer = 0
        self.PoisonDps = 0
    end

    @ExecSpace("ServerOnly")
    method void ApplyChill(number seconds)
        -- 냉기 둔화 (냉기 면역이면 무시). 끝나는 시점에 속도를 다시 계산한다
        local body = self:Body()
        if body == nil or body:GetResist("cold") >= 100 then return end
        self.ChillUntil = _UtilLogic.ElapsedSeconds + seconds
        body:RefreshSpeed()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and _UtilLogic.ElapsedSeconds >= self.ChillUntil then body:RefreshSpeed() end
        end, seconds + 0.05)
    end

    -- ───────── 넉백·경직 ─────────

    method boolean IsStunned()
        local now = _UtilLogic.ElapsedSeconds
        return now < self.KnockUntil or now < self.StaggerUntil
    end

    @ExecSpace("ServerOnly")
    method boolean ReactToHit(Entity attacker, number damage)
        -- 작은 피격은 시각 반응만. 누적 충격/강타만 행동을 끊고, 회복 구간에는 재경직을 막는다.
        local body = self:Body()
        if body == nil or body.IsDead or damage <= 0 or body.Grade >= 3 then return false end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.InterruptReadyAt then return false end
        if now - self.PoiseHitAt > 1.4 then self.PoiseDamage = 0 end
        self.PoiseHitAt = now
        local playerHit = isvalid(attacker) and isvalid(attacker.PlayerComponent)
        local impact = math.min(0.65, damage / math.max(1, body.MaxHp))
        if not playerHit then impact = impact * 0.35 end
        self.PoiseDamage = self.PoiseDamage + impact
        local threshold = body.Grade == 2 and 0.75 or 0.5
        if self.PoiseDamage < threshold and not (playerHit and damage >= body.MaxHp * _GameData.heavyHitPct) then return false end
        self.PoiseDamage = 0
        self.InterruptReadyAt = now + (body.Grade == 2 and 1.5 or 1.0)
        self.InterruptCount = self.InterruptCount + 1
        self:Stagger()
        if playerHit then self:Knockback(_Util:Pos2(self.Entity) - _Util:Pos2(attacker), 0.55) end
        return true
    end

    @ExecSpace("ServerOnly")
    method void Knockback(Vector2 dir, number mult)
        -- 맞은 반대쪽으로 짧게 밀린다. 보스·최상위는 밀리지 않고 정예는 절반
        local body = self:Body()
        if body == nil or body.IsDead or mult <= 0 or dir:Magnitude() < 0.01 then return end
        if body.Grade >= 3 or body.Unique then return end
        if body.Grade == 2 then mult = mult * 0.5 end
        local movement = self.Entity.MovementComponent
        if not isvalid(movement) then return end
        self:Hold()
        self.KnockUntil = _UtilLogic.ElapsedSeconds + _GameData.knockbackSec
        movement.InputSpeed = _GameData.knockbackSpeed * mult
        movement:MoveToDirection(dir:Normalize(), 0)
    end

    @ExecSpace("ServerOnly")
    method void Stagger()
        -- 피격 경직 (D2 hit recovery): 피격 모션, 잠깐 이동·공격 멈춤. 보스는 경직 없음
        local body = self:Body()
        if body == nil or body.IsDead or body.Grade >= 3 then return end
        self:Hold()
        local attack = self.Entity:GetComponent("script.MonsterAttack")
        if attack ~= nil then attack:CancelPending() end
        self.StaggerUntil = math.max(self.StaggerUntil, _UtilLogic.ElapsedSeconds + _GameData.staggerSec)
        local sc = self.Entity.StateComponent
        if isvalid(sc) then sc:ChangeState("HIT") end
        if self.KnockUntil <= _UtilLogic.ElapsedSeconds then self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0) end
    end

    @ExecSpace("ServerOnly")
    method void Hold()
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.Enable = false end
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- 넉백이 끝나면 멈추고 속도 복구, 경직까지 끝나면 추적을 되돌린다
        if self.KnockUntil <= 0 and self.StaggerUntil <= 0 then return end
        local now = _UtilLogic.ElapsedSeconds
        local body = self:Body()
        if self.KnockUntil > 0 and now >= self.KnockUntil then
            self.KnockUntil = 0
            self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
            if body ~= nil then body:RefreshSpeed() end
        end
        if self.KnockUntil > 0 or now < self.StaggerUntil then return end
        self.StaggerUntil = 0
        self:Release()
    end

    @ExecSpace("ServerOnly")
    method void Release()
        -- 죽었거나 특수 행동(땅속·도망·원거리 유지)이 추적을 쥐고 있으면 그대로 둔다
        local body = self:Body()
        if body == nil or body.IsDead then return end
        local sc = self.Entity.StateComponent
        if isvalid(sc) and sc.CurrentStateName == "HIT" then sc:ChangeState("IDLE") end
        ---@type MonsterBehavior
        local behavior = self.Entity:GetComponent("script.MonsterBehavior")
        if behavior ~= nil and (behavior.Burrowed or behavior.RetreatUntil > 0 or behavior.Mode == "ranged") then return end
        local chase = self.Entity.AIChaseComponent
        if isvalid(chase) then chase.Enable = true end
    end

    @ExecSpace("ServerOnly")
    method void Reset()
        -- 리스폰 시 모두 해제
        self.AmpUntil = 0
        self.WeakenUntil = 0
        self.ChillUntil = 0
        self.AuraUntil = 0
        self.PoisonUntil = 0
        self.KnockUntil = 0
        self.StaggerUntil = 0
        self.PoiseDamage = 0
        self.PoiseHitAt = -99
        self.InterruptReadyAt = 0
        self.InterruptCount = 0
        self:StopPoison()
        self.CurseTag = ""
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        self:StopPoison()
    end

end
