-- 맵별 몬스터 배치 (맵 안의 빈 엔티티에 붙인다). 시작할 때 목록대로 영역 안에 D2처럼 무리(PackSize) 단위로 소환하고,
-- 레벨·정예·변종 여부를 정한다. 이후 리스폰은 각 몬스터(Monster)가 RespawnSec 뒤, 플레이어 눈에 안 띌 때 처음 위치에서 한다.
-- Entries 형식: "모델id:마리수:레벨;..."   예) "hellhound:6:1;graveworm:3:2".
-- 값은 실행 시 _GameData:GetMapSpawns(보통 맵 id)를 우선 쓴다 (maps.csv → 데이터 생성만으로 바뀜, 맵 파일 재빌드 불필요).
-- 데이터에 없는 맵이면 이 컴포넌트의 속성값을 쓴다
-- 끝방 우두머리·봉인 상자(named.csv)도 여기서 놓는다. RespawnSec < 0 인 맵(곁가지 던전)은 「정리」 맵: 다시 나오지 않고,
-- 남은 수를 동기화하며, 다 잡으면 「층 정리」 골드 묶음 + MapCleared. 정리됐거나 우두머리가 쓰러진 맵이 3초 넘게 비면,
-- 덜 정리된 맵은 5분 넘게 비면 처음 상태로 다시 채운다 (14장 §3.1·§4).
-- 10-11: 끝방 우두머리가 쓰러지면 bossRespawnSec(5분) 동안은 맵이 비어도 다시 채우지 않는다 (BossRespawn이 남은 시간을 미니맵에 표시).
-- 시간이 되면 빈 맵은 통째로, 사람이 있는 맵은 우두머리(+호위)만 끝방에 다시 나온다
-- 10-28 빈 맵 정리 (기획서 38 F7-4): 사람이 없는 맵은 mapSleepFieldSec·mapSleepSideSec 뒤 스포너 몬스터·상자·신전을 치우고 잠든다.
-- 다시 들어오면 새로 채운다(사냥터는 상자·신전·드문 최상위를 다시 굴리지 않아 포털 리셋 파밍이 안 된다). 진행 중인 정리 맵은
-- sideRefillSec 전까지 그대로(#21-A 「300초 미만 동결」). 맵 파일에 고정된 몬스터(의뢰 보스 등)는 치우지 않는다.
-- 채울 때는 입구 쪽 무리부터 spawnBatch마리씩 0.05초 간격으로 나눠 소환한다
-- 10-29 사용자 「생성 D 혼합」 (황무지 동시 82 → 30~45, 맵 전체 처치·경험치·템포는 같다):
--   ① 근처 구역만 깨우기 — 배치 설계(무리 중심·구성)는 SpawnAll에서 그대로 정하되, 어떤 플레이어든 spawnWakeRadius 안에 든 무리만 소환하고
--     나머지는 PendingPacks에 데이터로 둔다(spawnWakeEverySec마다 검사). 예외(바로 배치): 입구에서 가장 가까운 무리 1개 · 끝방 우두머리·호위 ·
--     맵 파일 고정 몬스터 · 둥지·상자·신전 이벤트 · 보스 맵(보스 등급이 있는 맵) · 사냥터·곁가지 밖의 맵. 정리 맵은 대기 무리도 남은 수에 넣는다.
--   ② 유입 — 사냥터(field)만 출현 항목마다 floor(n × inflowShare)를 배치하지 않고 InflowPool에 둔다. 플레이어마다 inflowEverySec마다
--     그 사람에게 들어온 산 유입 몬스터가 inflowAlivePerPlayer 미만이고 습격이 없으면 화면 밖 고리(inflowRadiusMin~Max)에서 1마리 (RaidDirector.RingSpots).
--     유입 몬스터는 일반 등급(m.Inflow) · 죽으면 RespawnSec 뒤 풀 +1 · 모든 플레이어에게서 inflowLeash 밖에 inflowLeashSec 넘게 있으면 치우고 풀 +1
--   10-29 길 위 사건(기획서 39 #7 A): 액트 3·4 설계서 자리의 상자 매복·의식 습격·둥지 졸개는 이 풀에서 빌린다(BorrowPool → TrackBorrowed, 죽으면 RespawnSec 뒤 풀)
-- 10-30 출현 구역 (I06 대표 4맵 · data/spawn_zones.csv → GameData MapSpawns.zones): 무리 수·크기·섞임·유입 몫은 그대로 정하고, 무리 중심만
--   그 무리 종류에 맞는 구역(모델 id | @원형 | *)에서 고른다 (구역마다 share만큼 · ZoneFor). 무리 안 자리도 그 구역 안 + ValidSpawn(입구 안전·벽).
--   구역에 안전한 자리가 없으면 예전처럼 맵 전체 출현 범위에서 고르고 fallback으로 센다 (구역 배치 성공으로 세지 않는다). 구역이 없는 맵은 예전과 같다
@Component
script MonsterSpawner extends Component

    property string Entries = ""
    property Vector2 AreaMin = Vector2(-6, -3)
    property Vector2 AreaMax = Vector2(6, 3)
    property number EliteChance = 0        -- 일반 몬스터가 정예로 나올 확률
    property number VariantChance = -1     -- 변종 우두머리 확률 (음수 = config variantChance)
    property integer PackSize = 1          -- 무리 크기 (1 = 흩어져 배치)
    property number RespawnSec = 10        -- 리스폰 대기 (음수 = 다시 나오지 않음)
    property boolean DebugLog = false
    property any PackCenters = nil         -- 이번 SpawnAll에서 고른 무리 중심들 (서로 packSpacing 이상 떨어뜨린다)

    property table SafeZones = {}
    property Entity Terrain = nil
    @Sync
    property boolean ClearMode = false     -- 정리 맵 (리스폰 없음 · 남은 수 표시)
    @Sync
    property integer Total = 0             -- 정리 맵: 이번에 채운 몬스터 수 (매복 등으로 늘면 같이 는다)
    @Sync
    property integer Remaining = 0         -- 정리 맵: 살아 있는 몬스터 수
    property boolean Cleared = false
    property number SpawnedAt = 0
    property number EmptySince = 0
    property table NamedAlive = {}         -- 이 맵의 끝방 이름 있는 적: { e = 엔티티, row = named.csv 행, down = 쓰러짐 }
    property integer PollTimer = 0
    property integer MapLevel = 1
    property boolean Dormant = false        -- 잠든 맵 (사람이 들어오면 SpawnAll로 깨어난다)
    property boolean EventsDone = false     -- 사냥터 이벤트(상자·신전·드문 최상위)를 이미 굴렸다 — 깨어날 때 다시 굴리지 않는다
    property any FixedIds = nil             -- 처음 채우기 전부터 맵에 있던 몬스터 Id (맵 파일 고정 · 잠들 때 치우지 않는다)
    property any SpawnQueue = nil           -- 나눠 소환할 몬스터 목록
    property integer SpawnQueueTimer = 0
    property integer SleepCount = 0
    property integer WakeCount = 0
    property any PendingPacks = nil         -- 깨우기 대기 무리: { center = Vector2, list = { 소환 작업 } } (생성 D ①)
    property any InflowPool = nil           -- 유입 풀: { { id, level, n } } (생성 D ②, 레벨은 난이도 구간 반영값)
    property table InflowAlive = {}         -- 유입으로 나온 몬스터: { e, owner(userId), id, level, farSince }
    property table InflowReturns = {}       -- 죽은 유입 몬스터가 풀로 돌아갈 시각: { at, id, level }
    property table Borrowed = {}            -- 길 위 사건(기획서 39 #7)이 유입 풀에서 빌려 쓴 몬스터: { e, id, level } — 죽으면 유입과 같이 RespawnSec 뒤 풀로
    property boolean InflowOn = false       -- 이번 채우기에서 유입을 쓰는 맵인가 (사냥터 · 보스 맵·심연 아님)
    property boolean BossMap = false        -- 보스 등급 몬스터가 있는 맵 (깨우기·유입 없이 처음처럼 다 놓는다)
    property number InflowAcc = 0
    property integer WakeTimer = 0
    property integer MapDiff = 0            -- 이번 채우기의 난이도 (유입 때 변종·정예 능력 굴림)
    property number VariantRate = 0         -- 이번 채우기의 변종 확률
    property integer ClearLogged = -1       -- 정리 맵 남은 수 로그 (바뀔 때만)
    property any Zones = nil                -- 출현 구역 (GameData MapSpawns.zones · 없으면 nil = 맵 전체)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 10-21 방 구조: 게임 방에는 맵이 수십 장 함께 실린다 → 사람이 처음 들어온 맵만 채운다 (Poll). 로비(정적 방)는 채우지 않는다
        if self.Entity.CurrentMap.Name == _GameConst.MapLobby then return end
        self.PollTimer = _TimerService:SetTimerRepeat(function() self:Poll() end, 1)
        self.WakeTimer = _TimerService:SetTimerRepeat(function() self:WakeTick() end, math.max(0.1, _GameData.spawnWakeEverySec))
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.PollTimer ~= 0 then _TimerService:ClearTimer(self.PollTimer) end
        self.PollTimer = 0
        if self.WakeTimer ~= 0 then _TimerService:ClearTimer(self.WakeTimer) end
        self.WakeTimer = 0
        self:StopQueue()
    end

    -- ───────── 생성 D 혼합: 깨우기 · 유입 ─────────

    method integer PendingCount()
        -- 아직 소환되지 않은 몬스터 수 (깨우기 대기 무리 + 나눠 소환 대기열)
        local n = 0
        for _, pack in ipairs(self.PendingPacks or {}) do n = n + #pack.list end
        return n + #(self.SpawnQueue or {})
    end

    method integer PoolCount()
        local n = 0
        for _, k in ipairs(self.InflowPool or {}) do n = n + k.n end
        return n
    end

    method integer InflowAliveCount()
        local n = 0
        for _, r in ipairs(self.InflowAlive) do
            if isvalid(r.e) then n = n + 1 end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method void WakeTick()
        -- spawnWakeEverySec마다: 다가간 무리 깨우기 · 유입(inflowEverySec마다)
        if self.SpawnedAt <= 0 or self.Dormant then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local players = _Util:PlayersInMap(map)
        if #players == 0 then return end
        if self.PendingPacks ~= nil and #self.PendingPacks > 0 then self:WakePacks(map, players, true) end
        if self.InflowOn then
            self.InflowAcc = self.InflowAcc + math.max(0.1, _GameData.spawnWakeEverySec)
            if self.InflowAcc >= _GameData.inflowEverySec then
                self.InflowAcc = 0
                self:InflowTick(map, players)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method integer WakePacks(Entity map, table players, boolean start)
        -- 어떤 플레이어든 무리 중심까지 spawnWakeRadius 안이면 그 무리를 나눠 소환 대기열로 넘긴다. 넘긴 몬스터 수
        local keep = {}
        local woke = 0
        for _, pack in ipairs(self.PendingPacks or {}) do
            local best = 999
            for _, p in ipairs(players) do best = math.min(best, (_Util:Pos2(p) - pack.center):Magnitude()) end
            if best <= _GameData.spawnWakeRadius then
                self:QueuePack(pack)
                woke = woke + #pack.list
                log(string.format("[VRF] spawner pack woke map=%s n=%d dist=%.1f", map.Name, #pack.list, best))
            else
                table.insert(keep, pack)
            end
        end
        self.PendingPacks = keep
        if woke > 0 and start then self:StartQueue() end
        return woke
    end

    @ExecSpace("ServerOnly")
    method void WakeAll(string why)
        -- 대기 무리를 모두 깨운다 (정리 맵에 산 몬스터가 하나도 없는데 대기 무리만 남았을 때 — 남은 수만 있고 찾을 적이 없게 되지 않게)
        local n = 0
        for _, pack in ipairs(self.PendingPacks or {}) do
            self:QueuePack(pack)
            n = n + #pack.list
        end
        self.PendingPacks = {}
        if n > 0 then
            self:StartQueue()
            log(string.format("[VRF] spawner wake all map=%s n=%d why=%s", self.Entity.CurrentMap.Name, n, why))
        end
    end

    @ExecSpace("ServerOnly")
    method void QueuePack(any pack)
        if self.SpawnQueue == nil then self.SpawnQueue = {} end
        for _, job in ipairs(pack.list) do table.insert(self.SpawnQueue, job) end
    end

    @ExecSpace("ServerOnly")
    method void StartQueue()
        -- 나눠 소환 타이머가 꺼져 있으면 켠다 (기존 RunQueue 그대로)
        if self.SpawnQueueTimer ~= 0 or self.SpawnQueue == nil or #self.SpawnQueue == 0 then return end
        self:RunQueue()
        if #self.SpawnQueue > 0 then self.SpawnQueueTimer = _TimerService:SetTimerRepeat(function() self:RunQueue() end, 0.05) end
    end

    @ExecSpace("ServerOnly")
    method void ReturnToPool(string id, integer level)
        for _, k in ipairs(self.InflowPool or {}) do
            if k.id == id and k.level == level then
                k.n = k.n + 1
                return
            end
        end
        if self.InflowPool == nil then self.InflowPool = {} end
        table.insert(self.InflowPool, { id = id, level = level, n = 1 })
    end

    @ExecSpace("ServerOnly")
    method table BorrowPool(integer n)
        -- 길 위 사건(39 #7 · 「이벤트 몹은 유입 풀에서 빼서 씀」): 유입 풀에서 n마리까지 꺼낸다 (풀에 남은 수만큼 가중 무작위).
        -- 꺼낸 { id, level } 목록 — 풀이 모자라면 그만큼 짧다 (모자란 몫은 부르는 쪽이 맵 종류로 새로 만든다)
        local out = {}
        for _ = 1, n do
            local total = self:PoolCount()
            if total <= 0 then break end
            local pick = _UtilLogic:RandomIntegerRange(1, total)
            for _, k in ipairs(self.InflowPool) do
                if k.n > 0 then
                    pick = pick - k.n
                    if pick <= 0 then
                        k.n = k.n - 1
                        table.insert(out, { id = k.id, level = k.level })
                        break
                    end
                end
            end
        end
        return out
    end

    @ExecSpace("ServerOnly")
    method void TrackBorrowed(Entity e, string id, integer level)
        -- 빌린 몬스터를 적어 둔다: 죽으면 InflowTick이 RespawnSec 뒤 풀로 되돌린다 (유입 몬스터와 같은 규칙 — 맵 전체 처치·경험치 그대로)
        table.insert(self.Borrowed, { e = e, id = id, level = level })
    end

    @ExecSpace("ServerOnly")
    method void GiveBack(Entity e)
        -- 의식을 거둘 때(맵이 빔): 빌린 몬스터를 치우고 바로 풀로 (죽지 않았으니 기다리지 않는다). 빌린 몬스터가 아니면 치우기만
        local keep = {}
        for _, r in ipairs(self.Borrowed) do
            if r.e == e then self:ReturnToPool(r.id, r.level) else table.insert(keep, r) end
        end
        self.Borrowed = keep
        if isvalid(e) then e:Destroy() end
    end

    @ExecSpace("ServerOnly")
    method void InflowTick(Entity map, table players)
        -- 유입: 죽은 몬스터의 풀 복귀 · 끈(멀어진 몬스터 회수) · 플레이어마다 1마리
        local now = _UtilLogic.ElapsedSeconds
        local respawn = math.max(0, self.RespawnSec)
        -- 산 유입 몬스터 점검 (죽음 → RespawnSec 뒤 풀 · 모두에게서 멀면 끈)
        local keep = {}
        local owned = {}
        for _, r in ipairs(self.InflowAlive) do
            ---@type Monster
            local m = isvalid(r.e) and r.e:GetComponent("script.Monster") or nil
            if m == nil or m.IsDead then
                table.insert(self.InflowReturns, { at = now + respawn, id = r.id, level = r.level })
            else
                local far = _Util:NearestPlayerDistance(map, _Util:Pos2(r.e)) > _GameData.inflowLeash
                if far and r.farSince <= 0 then r.farSince = now end
                if not far then r.farSince = 0 end
                if far and now - r.farSince >= _GameData.inflowLeashSec then
                    r.e:Destroy()
                    self:ReturnToPool(r.id, r.level)
                    log(string.format("[VRF] inflow leash recycled map=%s species=%s pool=%d", map.Name, r.id, self:PoolCount()))
                else
                    table.insert(keep, r)
                    owned[r.owner] = (owned[r.owner] or 0) + 1
                end
            end
        end
        self.InflowAlive = keep
        -- 길 위 사건이 빌린 몬스터: 죽으면 RespawnSec 뒤 풀로 (끈 회수는 없다 — 사건 자리를 지키는 몬스터)
        local lent = {}
        for _, r in ipairs(self.Borrowed) do
            ---@type Monster
            local m = isvalid(r.e) and r.e:GetComponent("script.Monster") or nil
            if m == nil or m.IsDead then table.insert(self.InflowReturns, { at = now + respawn, id = r.id, level = r.level })
            else table.insert(lent, r) end
        end
        self.Borrowed = lent
        local waiting = {}
        for _, ret in ipairs(self.InflowReturns) do
            if now >= ret.at then self:ReturnToPool(ret.id, ret.level) else table.insert(waiting, ret) end
        end
        self.InflowReturns = waiting
        -- 습격 중에는 들여보내지 않는다 (습격의 떼가 그 자리를 채운다)
        local raid = _RaidDirector:State(map)
        if raid ~= nil and raid.active ~= nil then return end
        for _, p in ipairs(players) do
            if self:PoolCount() <= 0 then return end
            local uid = p.PlayerComponent.UserId
            if (owned[uid] or 0) < _GameData.inflowAlivePerPlayer and _Util:IsAlive(p) then
                if self:SpawnInflow(map, p) then owned[uid] = (owned[uid] or 0) + 1 end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method boolean SpawnInflow(Entity map, Entity player)
        -- 그 사람 둘레 화면 밖 고리에서 풀의 한 마리 (자리 = RaidDirector.RingSpots: 벽 앞까지 당겨 시야 트인 방향만 · 입구 안전 반경 밖)
        local center = _Util:Pos2(player)
        if _RaidDirector:NearEntry(map, center) then return false end   -- 막 들어온 사람(입구 안전 반경)에게는 몰아 보내지 않는다
        local minReach = _GameData.inflowRadiusMin - 1.5                 -- PC 한 화면 반 폭 6.4 밖
        local spots = {}
        for _, q in ipairs(_RaidDirector:RingSpots(map, center, _GameData.inflowRadiusMin, _GameData.inflowRadiusMax, minReach)) do
            if _Util:NearestPlayerDistance(map, q) >= minReach then table.insert(spots, q) end   -- 다른 사람 화면에도 갑자기 솟지 않게
        end
        if #spots == 0 then return false end
        local q = spots[_UtilLogic:RandomIntegerRange(1, #spots)]
        -- 종류: 풀에 남은 수만큼 가중 무작위
        local total = self:PoolCount()
        local pick = _UtilLogic:RandomIntegerRange(1, total)
        local kind = nil
        for _, k in ipairs(self.InflowPool) do
            if k.n > 0 then
                pick = pick - k.n
                if pick <= 0 then kind = k break end
            end
        end
        if kind == nil then return false end
        local e = _SpawnService:SpawnByModelId(kind.id, kind.id, Vector3(q.x, q.y, 0), map)
        if not isvalid(e) then return false end
        kind.n = kind.n - 1
        local uid = player.PlayerComponent.UserId
        table.insert(self.InflowAlive, { e = e, owner = uid, id = kind.id, level = kind.level, farSince = 0 })
        -- 정예·변종은 배치분과 같은 규칙으로 지금 굴린다 (무리 우두머리 몫은 없음)
        local elite = _UtilLogic:RandomDouble() < self.EliteChance
        local variant, eliteVariant = "", ""
        if _UtilLogic:RandomDouble() < self.VariantRate then variant = _GameData:RollVariant(self.MapDiff)
        elseif elite then eliteVariant = _GameData:RollEliteVariant(self.MapDiff) end
        local level = kind.level
        _Util:AfterSpawn(e, "script.Monster", function(comp)
            ---@type Monster
            local m = comp
            m.Inflow = true
            m.RespawnDelay = -1   -- 자리 리스폰 대신 스포너가 RespawnSec 뒤 풀에 되돌린다
            m:ApplyLevel(level, elite)
            if variant ~= "" then m:MakeVariant(variant)
            elseif eliteVariant ~= "" then m:MakeEliteVariant(eliteVariant) end
            -- 화면 밖에서 곧장 온다 (습격의 떼와 같은 방법: 탐지 범위를 키워야 온다 — 10-28 메이커 실험)
            local chase = e.AIChaseComponent
            if isvalid(chase) then chase.DetectionRange = _GameData.raidHordeDetect end
        end, nil)
        log(string.format("[VRF] inflow spawn map=%s species=%s alive=%d pool=%d dist=%.1f", map.Name, kind.id, self:InflowAliveCount(), self:PoolCount(), (q - center):Magnitude()))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean DetectBossMap(Entity map, table list)
        -- 보스 등급 몬스터가 있는 맵: 맵 파일 고정 몬스터 중 보스 등급 또는 출현 목록에 보스 등급 종
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local m = c
            if isvalid(m.Entity) and self.FixedIds ~= nil and self.FixedIds[m.Entity.Id] and m.Grade >= 3 then return true end
        end
        for _, entry in ipairs(list) do
            local st = _GameData:GetMonsterStats(_GameData:SourceOfModel(entry.id))
            if st ~= nil and (st.grade or 1) >= 3 then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void Poll()
        -- 1초마다: 처음 사람이 들어오면 채우기, 정리 맵 남은 수·완료, 빈 맵 다시 채우기
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local now = _UtilLogic.ElapsedSeconds
        local players = _Util:PlayersInMap(map)
        if self.SpawnedAt <= 0 then
            if #players > 0 then self:SpawnAll() end
            return
        end
        self:TrackNamed(map, #players > 0)
        if self.ClearMode and now - self.SpawnedAt > 2 then
            local alive = 0
            for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
                ---@type Monster
                local m = c
                if isvalid(m.Entity) and not m.IsDead and not m.Horde then alive = alive + 1 end   -- 습격의 떼는 정리 집계에 넣지 않는다 (기획서 41 #8-A: 떼가 섞이면 의뢰가 안 끝난다)
            end
            -- 생성 D ①: 깨우기 대기 무리·소환 대기열도 남은 수에 넣는다 (「남은 수」가 처음부터 전체로 보이게).
            -- 산 몬스터가 하나도 없는데 대기 무리만 남았으면 모두 깨운다 (남은 수만 있고 찾을 적이 없게 되지 않게)
            if alive == 0 and #(self.SpawnQueue or {}) == 0 and self.PendingPacks ~= nil and #self.PendingPacks > 0 then self:WakeAll("clear-empty") end
            local pending = self:PendingCount()
            local liveCount = alive
            alive = alive + pending
            if self.ClearLogged ~= alive then
                self.ClearLogged = alive
                log(string.format("[VRF] clear remaining=%d (pending %d) live=%d total=%d map=%s", alive, pending, liveCount, math.max(self.Total, alive), map.Name))
            end
            self.Total = math.max(self.Total, alive)
            self.Remaining = alive
            local base = _GameConst:BaseMapName(map.Name)
            for _, p in ipairs(players) do
                ---@type PlayerQuest
                local q = p:GetComponent("script.PlayerQuest")
                if q ~= nil then q:ShowClearProgress(base, self.Total, alive) end
            end
            if alive == 0 and self.Total > 0 and not self.Cleared then
                self.Cleared = true
                local info = _GameData:GetMapInfo(base)
                local name = info ~= nil and string.gsub(info.name, "%s*%(Lv[^%)]*%)", "") or base
                -- 층 정리 보상: 맵 안의 사람마다 골드 묶음 (맵 레벨 기준)
                local gold = math.floor(self.MapLevel * _GameData.floorClearGoldPerLevel + _GameData.floorClearGoldBase)
                for _, p in ipairs(players) do
                    local userId = p.PlayerComponent.UserId
                    _LootSystem:Spawn(_Util:Pos2(p), userId, "gold", "", gold, 0)
                    _Util:Banner("층 정리 · " .. name, "골드 묶음이 발밑에 떨어졌습니다 · " .. tostring(gold) .. " 골드", userId)
                end
                log("[VRF] map cleared " .. map.Name .. " total=" .. tostring(self.Total))
                _GameEvents:Emit("MapCleared", { map = map, mapKey = base })
            elseif self.Cleared then
                -- 10-13 C1: 이미 정리된 맵에 정리 의뢰가 남은 사람이 들어오면 인정 (맵은 안에 아무도 없어야 다시 차서, 남이 있으면 끝없이 기다렸다)
                for _, p in ipairs(players) do
                    ---@type PlayerQuest
                    local q = p:GetComponent("script.PlayerQuest")
                    if q ~= nil then q:OnMapCleared(base, map) end
                end
            end
        end
        if #players > 0 then
            self.EmptySince = 0
        elseif self.EmptySince == 0 then
            self.EmptySince = now
        elseif now - self.EmptySince >= 3 and self:NeedsRefill(now - self.EmptySince) then
            -- 다시 채울 맵은 사람이 없으니 바로 채우지 않고 잠든다 → 다음에 들어오면 새로 채운다 (예전: 빈 맵에 곧바로 다시 소환)
            self:Sleep(true)
        elseif now - self.EmptySince >= self:SleepSec() and self:CanSleep() then
            self:Sleep(false)
        end
    end

    method number SleepSec()
        -- 잠들기까지 빈 시간: 사냥터 · 곁가지 던전
        return self.ClearMode and _GameData.mapSleepSideSec or _GameData.mapSleepFieldSec
    end

    @ExecSpace("ServerOnly")
    method boolean CanSleep()
        -- 우두머리 되살아남 대기 중이면 기다린다 (깨어나며 우두머리가 일찍 돌아오지 않게) · 진행 중인 정리는 NeedsRefill(sideRefillSec)이 맡는다
        if _BossRespawn:MapRemaining(self.Entity.CurrentMap.Name) > 0 then return false end
        if self.ClearMode and not self.Cleared and self.Remaining < self.Total then return false end
        return true
    end

    @ExecSpace("ServerOnly")
    method void Sleep(boolean reset)
        -- 빈 맵 정리: 스포너가 만든 몬스터(죽어 숨은 것 포함)·상자·신전을 치우고 SpawnedAt = 0 → 사람이 들어오면 SpawnAll.
        -- reset(정리 끝 · 오래 빈 정리 맵 · 우두머리 쓰러짐)이면 처음 상태처럼 이벤트도 다시 굴린다. 아니면(사냥터) 이벤트는 다시 굴리지 않는다
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        self:StopQueue()
        local fixed = self.FixedIds or {}
        local removed = 0
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            if isvalid(c.Entity) and not fixed[c.Entity.Id] then
                c.Entity:Destroy()
                removed = removed + 1
            end
        end
        for _, kind in ipairs({ "script.CursedChest", "script.MapShrine", "script.RoadAltar" }) do
            for _, c in ipairs(map:GetChildComponentsByTypeName(kind, true)) do
                if isvalid(c.Entity) then c.Entity:Destroy() end
            end
        end
        if reset or self.ClearMode then self.EventsDone = false end
        -- 생성 D: 대기 무리·유입 풀도 비운다 (다시 들어오면 SpawnAll이 새로 짠다)
        local pending = self:PendingCount()
        self.PendingPacks = nil
        self.SpawnQueue = nil
        self.InflowPool = nil
        self.InflowAlive = {}
        self.InflowReturns = {}
        self.Borrowed = {}
        self.InflowOn = false
        self.ClearLogged = -1
        self.NamedAlive = {}
        self.SpawnedAt = 0
        self.EmptySince = 0
        self.Dormant = true
        self.SleepCount = self.SleepCount + 1
        log(string.format("[VRF] map sleep %s removed=%d pending=%d reset=%s events=%s", map.Name, removed, pending, tostring(reset), self.EventsDone and "keep" or "reroll"))
    end

    @ExecSpace("ServerOnly")
    method boolean NeedsRefill(number emptyFor)
        -- 정리를 끝냈거나 이름 있는 적이 쓰러진 맵은 바로, 덜 정리된 맵은 5분 비어 있으면 (진행 중인 정리는 잠깐 나갔다 와도 그대로).
        -- 단 우두머리가 쓰러진 지 bossRespawnSec가 안 됐으면 기다린다 (포털로 드나들며 우두머리·봉인 상자 무한 파밍 방지)
        if _BossRespawn:MapRemaining(self.Entity.CurrentMap.Name) > 0 then return false end
        if self.ClearMode and self.Cleared then return true end
        if self.ClearMode and emptyFor >= _GameData.sideRefillSec and self.Remaining < self.Total then return true end
        for _, r in ipairs(self.NamedAlive) do
            if r.down or not self:NamedUp(r.e) then return true end
        end
        return false
    end

    method boolean NamedUp(Entity e)
        if not isvalid(e) then return false end
        ---@type Monster
        local m = e:GetComponent("script.Monster")
        return m ~= nil and not m.IsDead
    end

    @ExecSpace("ServerOnly")
    method void TrackNamed(Entity map, boolean occupied)
        -- 끝방 우두머리: 쓰러지면 5분 타이머, 시간이 됐는데 사람이 있으면 우두머리만 다시 (봉인 상자는 맵을 다시 채울 때만)
        for _, r in ipairs(self.NamedAlive) do
            if not r.down and not self:NamedUp(r.e) then
                r.down = true
                _BossRespawn:Start(map.Name, r.row.name)
                _Util:NotifyMap(map, _BossRespawn:DownText(r.row.name))
                log("[VRF] named down " .. r.row.id .. " " .. map.Name)
            elseif r.down and occupied and _BossRespawn:Remaining(map.Name, r.row.name) <= 0 then
                local pos = _NamedSystem:EndPoint(self)
                local e = pos ~= nil and _NamedSystem:SpawnNamed(r.row, map, pos, self.MapLevel) or nil
                if isvalid(e) then
                    r.e = e
                    r.down = false
                    _BossRespawn:Clear(map.Name, r.row.name)
                    _Util:NotifyMap(map, r.row.name .. "이(가) 다시 나타났다")
                    log("[VRF] named back " .. r.row.id .. " " .. map.Name)
                end
            end
        end
    end

    method boolean OpenPoint(Vector2 p, number margin)
        -- 벽·출구 안전 구역 밖이고 사방 margin까지 막히지 않은 지점 (플레이어 위치는 보지 않는다)
        for _, zone in ipairs(self.SafeZones) do
            if (p - zone.pos):Magnitude() < zone.radius then return false end
        end
        if not isvalid(self.Terrain) then return true end
        for _, offset in ipairs({ Vector2(0, 0), Vector2(-margin, 0), Vector2(margin, 0), Vector2(0, -margin), Vector2(0, margin) }) do
            if _Util:TileBlocked(self.Terrain, p + offset) then return false end
        end
        return true
    end

    @ExecSpace("ServerOnly")
    method void PlaceNamed(Entity map, integer level)
        -- named.csv의 이 맵 끝방 행: 이름 있는 적 + 호위, 봉인 상자
        self.NamedAlive = {}
        for _, row in ipairs(_NamedData:ForMap(_GameConst:BaseMapName(map.Name))) do
            if row.place == "end" then
                local pos = _NamedSystem:EndPoint(self)
                if pos ~= nil then
                    if row.id ~= "" then
                        local e = _NamedSystem:SpawnNamed(row, map, pos, level)
                        if isvalid(e) then table.insert(self.NamedAlive, { e = e, row = row, down = false }) end
                        _BossRespawn:Clear(map.Name, row.name)
                    end
                    if row.chest then
                        local chestPos = pos
                        if row.id ~= "" then
                            chestPos = pos + Vector2(1.6, 0)
                            if not self:OpenPoint(chestPos, 0.4) then chestPos = pos + Vector2(-1.6, 0) end
                            if not self:OpenPoint(chestPos, 0.4) then chestPos = pos + Vector2(0, -1.2) end
                        end
                        _NamedSystem:SpawnSealedChest(row, map, chestPos, level)
                    end
                end
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void SpawnAll()
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        if self.FixedIds == nil then
            -- 처음 채우기 전부터 있던 몬스터 = 맵 파일 고정 (의뢰 보스 등) → 잠들 때 치우지 않는다
            self.FixedIds = {}
            for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
                if isvalid(c.Entity) then self.FixedIds[c.Entity.Id] = true end
            end
        end
        local waking = self.Dormant
        if waking then self.WakeCount = self.WakeCount + 1 end
        self.Dormant = false
        self:StopQueue()
        self.SpawnQueue = {}
        self:LoadFromData(map.Name)
        self:BuildSafeZones()
        local total = 0
        -- 난이도 레벨은 보통 레벨을 그 난이도 구간에 옮긴 값 (GameConst.ScaleLevel, 10-20 구간 눌러 담기)
        local diff = 0
        ---@type MapAmbience
        local amb = map:GetComponent("script.MapAmbience")
        if amb ~= nil then diff = amb.Difficulty end
        local variantChance = self.VariantChance
        if variantChance < 0 then variantChance = _GameData.variantChance end
        local packSize = math.max(1, self.PackSize)
        local list = {}
        for modelId, count, level in string.gmatch(self.Entries, "([%w_]+):(%d+):(%d+)") do
            table.insert(list, { id = modelId, count = tonumber(count), level = tonumber(level) })
        end
        local stats = { packs = 0, leaders = 0, mixed = 0, hordes = 0 }
        local want = 0
        for _, entry in ipairs(list) do want = want + entry.count end
        self.PackCenters = {}
        -- 생성 D 혼합: 이 맵이 깨우기·유입을 쓰는가 (보스 맵·사냥터·곁가지 밖은 예전처럼 다 놓는다)
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        local mapKind = info ~= nil and info.kind or ""
        self.BossMap = self:DetectBossMap(map, list)
        local depth = map:GetComponent("script.DepthDirector") ~= nil
        local useWake = (mapKind == "field" or mapKind == "side") and not self.BossMap and not depth
        self.InflowOn = useWake and mapKind == "field" and self.RespawnSec >= 0
        self.MapDiff = diff
        self.VariantRate = variantChance
        self.InflowPool = {}
        self.InflowAlive = {}
        self.InflowReturns = {}
        self.Borrowed = {}
        self.InflowAcc = 0
        if self.InflowOn then
            -- 출현 항목마다 floor(n × inflowShare)를 배치에서 빼 유입 풀로 (종·레벨별)
            for _, entry in ipairs(list) do
                local k = math.floor(entry.count * _GameData.inflowShare)
                if k > 0 then
                    entry.count = entry.count - k
                    table.insert(self.InflowPool, { id = entry.id, level = _GameConst:ScaleLevel(entry.level, diff), n = k })
                end
            end
        end
        local packs = {}
        local zoneCredit = {}
        local zoneStats = { zoned = 0, fallback = 0, by = {} }
        for _, entry in ipairs(list) do
            local remaining = entry.count
            while remaining > 0 do
                -- 무리 하나: 가끔 두 배 크기(큰 무리), 가끔 정예 우두머리 + 호위, 가끔 같은 맵의 다른 종류가 섞인다
                local size = packSize
                if packSize > 1 and _UtilLogic:RandomDouble() < _GameData.hordeChance then
                    size = packSize * 2
                    stats.hordes = stats.hordes + 1
                end
                size = math.min(size, remaining)
                remaining = remaining - size
                stats.packs = stats.packs + 1
                local leader = size > 1 and _UtilLogic:RandomDouble() < _GameData.packLeaderChance
                local escort = nil
                if size > 2 and #list > 1 and _UtilLogic:RandomDouble() < _GameData.packMixChance then
                    escort = self:PickEscort(list, entry)
                    if escort ~= nil then stats.mixed = stats.mixed + 1 end
                end
                if leader then stats.leaders = stats.leaders + 1 end
                -- 출현 구역: 이 무리 종류의 구역 몫이 찼으면 그 구역 안에서 중심을 고른다 (자리가 없으면 맵 전체 · fallback)
                local zone = self:ZoneFor(entry.id, zoneCredit)
                local center = nil
                if zone ~= nil then
                    center = self:PickPackCenterIn(zone)
                    if center ~= nil then
                        zoneStats.zoned = zoneStats.zoned + 1
                        zoneStats.by[zone.name] = (zoneStats.by[zone.name] or 0) + size
                    else
                        zoneStats.fallback = zoneStats.fallback + 1
                        zone = nil
                    end
                end
                if center == nil then center = self:PickPackCenter() end
                local pack = { center = center, list = {} }
                if center ~= nil then table.insert(packs, pack) end
                for i = 1, size do
                    if center ~= nil then
                        local p = center
                        if size > 1 then
                            local a = _UtilLogic:RandomDouble() * math.pi * 2
                            local r = _UtilLogic:RandomDouble() * _GameData.packRadius * (size > packSize and 1.4 or 1)
                            p = self:ClampIn(center + Vector2(math.cos(a) * r, math.sin(a) * r), zone)
                        end
                        if not self:ValidSpawn(p) then p = center end
                        local kind = entry
                        if escort ~= nil and i > 1 and i % 3 == 0 then kind = escort end
                        local elite = (leader and i == 1) or _UtilLogic:RandomDouble() < self.EliteChance
                        local variant = ""
                        local eliteVariant = ""
                        if _UtilLogic:RandomDouble() < variantChance then variant = _GameData:RollVariant(diff)
                        elseif elite then eliteVariant = _GameData:RollEliteVariant(diff) end   -- 악몽부터 정예 능력 (10-24 C안)
                        table.insert(pack.list, { id = kind.id, p = p, level = _GameConst:ScaleLevel(kind.level, diff), elite = elite, variant = variant, eliteVariant = eliteVariant, d = self:EntryDistance(p) })
                        total = total + 1
                    end
                end
            end
        end
        log(string.format("[VRF] spawner %s 소환 %d · 무리 %d (우두머리 %d · 섞임 %d · 큰 무리 %d)%s", map.Name, total, stats.packs, stats.leaders, stats.mixed, stats.hordes, waking and " · 깨어남" or ""))
        if self.Zones ~= nil then
            -- 출현 구역 진단: 요청 = 배치 + 유입 풀 (구역은 자리만 바꾼다) · fallback = 구역에 자리가 없어 맵 전체로 간 무리
            local detail = ""
            for _, z in ipairs(self.Zones) do detail = detail .. string.format(" %s=%d", z.name, zoneStats.by[z.name] or 0) end
            log(string.format("[VRF] spawner zones map=%s want=%d placed=%d pool=%d same=%s zonedPacks=%d fallback=%d units:%s", map.Name, want, total, self:PoolCount(), tostring(total + self:PoolCount() == want), zoneStats.zoned, zoneStats.fallback, detail))
        end
        -- 생성 D ①: 입구에서 가장 가까운 무리 1개는 바로 (들어가자마자 적이 보이게), 나머지는 대기 → 사람 근처 무리만 바로 깨운다.
        -- 깨우기를 쓰지 않는 맵은 예전처럼 전부 바로
        self.PendingPacks = {}
        local firstIdx, firstD = 0, 1e9
        for i, pack in ipairs(packs) do
            local d = self:EntryDistance(pack.center)
            if d < firstD then firstIdx, firstD = i, d end
        end
        for i, pack in ipairs(packs) do
            if not useWake or i == firstIdx then self:QueuePack(pack) else table.insert(self.PendingPacks, pack) end
        end
        local players = _Util:PlayersInMap(map)
        if #players > 0 and #self.PendingPacks > 0 then self:WakePacks(map, players, false) end   -- 대기열 타이머는 아래에서 한 번만 켠다
        log(string.format("[VRF] spawner wake map=%s placed=%d pending=%d pool=%d wake=%s inflow=%s boss=%s", map.Name, #self.SpawnQueue, self:PendingCount() - #self.SpawnQueue, self:PoolCount(), tostring(useWake), tostring(self.InflowOn), tostring(self.BossMap)))
        -- 입구 쪽 무리부터 나눠 소환 (한 프레임에 백여 마리를 만들지 않는다)
        table.sort(self.SpawnQueue, function(a, b) return a.d < b.d end)
        self:RunQueue()
        if #self.SpawnQueue > 0 then self.SpawnQueueTimer = _TimerService:SetTimerRepeat(function() self:RunQueue() end, 0.05) end
        -- 맵 레벨 = 출현 목록 평균 + 난이도 가산 (MapEvents와 같은 기준) → 끝방 우두머리·봉인 상자
        local sum = 0
        for _, e in ipairs(list) do sum = sum + e.level end
        self.MapLevel = _GameConst:ScaleLevel(#list > 0 and math.floor(sum / #list + 0.5) or 1, diff)
        self:PlaceNamed(map, self.MapLevel)
        -- 맵 이벤트: 신전 · 저주받은 상자 · 뼈 둥지 · 드문 최상위 (사냥터·곁가지 던전만). 잠들었던 사냥터는 다시 굴리지 않는다 (리셋 파밍 차단)
        if not self.EventsDone then _MapEvents:Populate(self, list, diff) end
        self.EventsDone = true
        self.ClearMode = self.RespawnSec < 0
        self.Cleared = false
        self.Total = 0
        self.Remaining = 0
        self.EmptySince = 0
        self.SpawnedAt = _UtilLogic.ElapsedSeconds
    end

    @ExecSpace("ServerOnly")
    method void RunQueue()
        -- 나눠 소환: spawnBatch마리씩 (잠들거나 끝나면 타이머를 끈다)
        local map = self.Entity.CurrentMap
        if self.SpawnQueue == nil or not isvalid(map) then
            self:StopQueue()
            return
        end
        local n = 0
        while #self.SpawnQueue > 0 and n < math.max(1, math.floor(_GameData.spawnBatch)) do
            local job = table.remove(self.SpawnQueue, 1)
            local e = _SpawnService:SpawnByModelId(job.id, job.id, Vector3(job.p.x, job.p.y, 0), map)
            if isvalid(e) then self:Configure(e, job.level, job.elite, job.variant, job.eliteVariant) end
            n = n + 1
        end
        if #self.SpawnQueue == 0 then self:StopQueue() end
    end

    @ExecSpace("ServerOnly")
    method void StopQueue()
        if self.SpawnQueueTimer ~= 0 then _TimerService:ClearTimer(self.SpawnQueueTimer) end
        self.SpawnQueueTimer = 0
    end

    method number EntryDistance(Vector2 p)
        -- 가장 가까운 입구(포털·웨이포인트·심도 입구)까지 거리 — 입구 쪽 무리부터 소환한다
        local best = 999
        for _, zone in ipairs(self.SafeZones) do best = math.min(best, (p - zone.pos):Magnitude()) end
        return best
    end

    method any PickEscort(table list, any entry)
        -- 섞일 종류: 원거리가 있으면 우선(근접 무리 뒤에서 쏘는 궁수), 없으면 다른 종류 중 무작위
        local others = {}
        for _, e in ipairs(list) do
            if e.id ~= entry.id then
                local stats = _GameData:GetMonsterStats(_GameData:SourceOfModel(e.id))
                if stats ~= nil and stats.behavior == "ranged" then return e end
                table.insert(others, e)
            end
        end
        if #others == 0 then return nil end
        return others[_UtilLogic:RandomIntegerRange(1, #others)]
    end

    @ExecSpace("ServerOnly")
    method void LoadFromData(string mapName)
        local d = _GameData:GetMapSpawns(_GameConst:BaseMapName(mapName))
        if d == nil then return end
        -- 악몽·지옥은 그 난이도 전용 목록(다른 지역 몬스터가 섞인 조합). 비어 있으면 보통 목록
        local diff = _GameConst:DifficultyOfMap(mapName)
        self.Entries = d.entries
        if diff == 1 and d.entriesNm ~= "" then self.Entries = d.entriesNm end
        if diff == 2 and d.entriesHell ~= "" then self.Entries = d.entriesHell end
        self.PackSize = math.floor(d.pack)
        self.EliteChance = d.elite
        self.VariantChance = d.variant
        self.RespawnSec = d.respawn
        self.AreaMin = Vector2(d.minX, d.minY)
        self.AreaMax = Vector2(d.maxX, d.maxY)
        self.Zones = d.zones
    end

    method boolean ZoneMatches(string match, string modelId)
        -- 구역 대상: "모델id|@원형|*" ('@' = monsters.csv archetype — guard · ranged · assassin · swarm · brute · berserker · beast …)
        for token in string.gmatch(match, "[^|]+") do
            if token == "*" or token == modelId then return true end
            if string.sub(token, 1, 1) == "@" then
                local st = _GameData:GetMonsterStats(_GameData:SourceOfModel(modelId))
                if st ~= nil and st.arch == string.sub(token, 2) then return true end
            end
        end
        return false
    end

    method any ZoneFor(string modelId, table credit)
        -- 이 무리를 놓을 구역 (없으면 nil = 맵 전체). 구역마다 맞는 무리가 나올 때 share만큼 몫을 쌓고(처음 0.5 = 반올림), 1이 넘은 첫 구역에 놓는다
        if self.Zones == nil then return nil end
        local pick = nil
        for i, z in ipairs(self.Zones) do
            if self:ZoneMatches(z.match, modelId) then
                credit[i] = (credit[i] or 0.5) + z.share
                if pick == nil and credit[i] >= 1 then pick = i end
            end
        end
        if pick == nil then return nil end
        credit[pick] = credit[pick] - 1
        return self.Zones[pick]
    end

    method any PickPackCenterIn(any zone)
        -- 구역 안 무리 중심 (구역 ∩ 출현 범위 · ValidSpawn · 다른 무리와 packSpacing). 자리가 없으면 nil
        local minX = math.max(zone.minX, self.AreaMin.x)
        local maxX = math.min(zone.maxX, self.AreaMax.x)
        local minY = math.max(zone.minY, self.AreaMin.y)
        local maxY = math.min(zone.maxY, self.AreaMax.y)
        if minX > maxX or minY > maxY then return nil end
        local best, bestD = nil, -1
        for i = 1, 14 do
            local p = self:RandomPointIn(minX, maxX, minY, maxY)
            if p ~= nil then
                local d = 999
                for _, c in ipairs(self.PackCenters or {}) do d = math.min(d, (p - c):Magnitude()) end
                if d >= _GameData.packSpacing then best = p bestD = d break end
                if d > bestD then best, bestD = p, d end
            end
        end
        if best ~= nil then table.insert(self.PackCenters, best) end
        return best
    end

    method any RandomPointIn(number minX, number maxX, number minY, number maxY)
        -- 사각형 안 안전한 자리 (무작위 96번 → 칸 훑기). 없으면 nil
        for i = 1, 96 do
            local p = Vector2(minX + _UtilLogic:RandomDouble() * (maxX - minX), minY + _UtilLogic:RandomDouble() * (maxY - minY))
            if self:ValidSpawn(p) then return p end
        end
        for x = math.ceil(minX), math.floor(maxX) do
            for y = math.ceil(minY), math.floor(maxY) do
                local p = Vector2(x, y)
                if self:ValidSpawn(p) then return p end
            end
        end
        return nil
    end

    method Vector2 ClampIn(Vector2 p, any zone)
        -- 무리 안 자리: 구역이 있으면 구역 ∩ 출현 범위, 없으면 출현 범위
        if zone == nil then return self:Clamp(p) end
        local q = self:Clamp(p)
        return Vector2(math.max(zone.minX, math.min(zone.maxX, q.x)), math.max(zone.minY, math.min(zone.maxY, q.y)))
    end

    method void BuildSafeZones()
        self.SafeZones = {}
        local map = self.Entity.CurrentMap
        local tiles = map:GetFirstChildComponentByTypeName("RectTileMapComponent", true)
        self.Terrain = tiles ~= nil and tiles.Entity or nil
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        if info == nil then return end
        -- 들어오는 곳(포털·웨이포인트·심도 입구) 둘레는 처음 배치·되살아남 모두 비운다 (10-24 팀원: 들어가자마자 죽었다)
        local radius = _GameConst:EntrySafeRadius(map.Name)
        for _,f in ipairs(info.features) do
            if f.kind == "portal" or f.kind == "waypoint" or f.kind == "depth" then
                table.insert(self.SafeZones, { pos = Vector2(f.x, f.y), radius = radius })
            end
        end
    end

    method boolean ValidSpawn(Vector2 p)
        for _,zone in ipairs(self.SafeZones) do
            if (p-zone.pos):Magnitude() < zone.radius then return false end
        end
        if _Util:NearestPlayerDistance(self.Entity.CurrentMap, p) < 5 then return false end
        if isvalid(self.Terrain) then
            for _,offset in ipairs({ Vector2(0,0), Vector2(-0.25,0), Vector2(0.25,0), Vector2(0,-0.25), Vector2(0,0.25) }) do
                if _Util:TileBlocked(self.Terrain, p+offset) then return false end
            end
        end
        return true
    end

    method any PickPackCenter()
        -- 무리 중심: 이미 놓인 무리들과 packSpacing칸 이상 떨어진 자리 (10-13 사용자 지적: 무리 여러 개가 한곳에 겹쳐 20마리가 뭉쳐 있었다).
        -- 그런 자리가 없으면(좁은 맵) 후보 중 가장 먼 자리
        local best, bestD = nil, -1
        for i = 1, 14 do
            local p = self:RandomPoint()
            if p ~= nil then
                local d = 999
                for _, c in ipairs(self.PackCenters or {}) do d = math.min(d, (p - c):Magnitude()) end
                if d >= _GameData.packSpacing then best = p bestD = d break end
                if d > bestD then best, bestD = p, d end
            end
        end
        if best ~= nil then table.insert(self.PackCenters, best) end
        return best
    end

    method any RandomPoint()
        for i = 1, 96 do
            local x = self.AreaMin.x + _UtilLogic:RandomDouble() * (self.AreaMax.x - self.AreaMin.x)
            local y = self.AreaMin.y + _UtilLogic:RandomDouble() * (self.AreaMax.y - self.AreaMin.y)
            local p = Vector2(x,y)
            if self:ValidSpawn(p) then return p end
        end
        -- 좁은 던전에서도 안전한 지점을 찾아 무리가 벽·출구 위에 나오지 않게 한다.
        for x = math.ceil(self.AreaMin.x), math.floor(self.AreaMax.x) do
            for y = math.ceil(self.AreaMin.y), math.floor(self.AreaMax.y) do
                local p = Vector2(x,y)
                if self:ValidSpawn(p) then return p end
            end
        end
        return nil
    end

    method Vector2 Clamp(Vector2 p)
        return Vector2(math.max(self.AreaMin.x, math.min(self.AreaMax.x, p.x)), math.max(self.AreaMin.y, math.min(self.AreaMax.y, p.y)))
    end

    @ExecSpace("ServerOnly")
    method void Configure(Entity e, integer level, boolean elite, string variant, string eliteVariant)
        local respawn = self.RespawnSec
        _Util:AfterSpawn(e, "script.Monster", function(comp)
            ---@type Monster
            local m = comp
            m.RespawnDelay = respawn
            m:ApplyLevel(level, elite)
            if variant ~= "" then m:MakeVariant(variant)
            elseif eliteVariant ~= "" then m:MakeEliteVariant(eliteVariant) end
        end, nil)
    end

end
