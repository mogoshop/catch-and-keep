-- 액트 4 「배교한 대주교」 피의 의식 (docs/design/40 §2 — 10-28 사용자 A안). 내려찍기·기술·50% 분노는 같은 엔티티의 BossPattern.
--   ② 성역 (66% 이하): 대주교가 선 자리(설교대 앞) 반경 SanctumRadius — 그 안의 교단 졸개는 주는 피해 × SanctumMult
--   ③ 피의 의식 (33% 이하): RitualInterval초마다 붉게 물든 의식 사제 2를 부른다 — RitualSeconds초 안에 둘 다 못 잡으면
--      남은 사제가 피를 바치고 사라지며 대주교 생명 RitualHealPct% 회복 (소환수로 사제를 끊는 장면)
-- 죽거나 맵에 플레이어가 없으면 처음 상태로 돌아가고 성역 버프·사제를 치운다.
@Component
script ArchbishopRite extends Component

    property integer Phase = 1
    @Sync
    property boolean SanctumOn = false
    @Sync
    property Vector2 SanctumCenter = Vector2(0, 0)
    property number SanctumRadius = 3
    property number SanctumMult = 1.3
    property table Buffed = {}               -- 성역 버프를 받은 졸개 엔티티
    property number SanctumTick = 0
    property number RitualInterval = 22
    property number RitualSeconds = 10
    property number RitualHealPct = 10
    property number RitualTimer = 0
    property number RitualLeft = 0
    property string PriestModel = "hellpriest"
    property table Priests = {}
    property integer RitualCount = 0
    property integer SanctumFx = 0           -- 클라이언트: 성역 바닥 빛

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 시작 표시
        log("[VRF] ArchbishopRite ready")
    end

    method void OnUpdate(number delta)
        -- 서버: 단계 · 성역 버프 · 의식 타이머 / 클라이언트: 성역 빛
        if not self:IsServer() then
            self:SyncSanctumFx()
            return
        end
        ---@type Monster
        local monster = self.Entity:GetComponent("script.Monster")
        if monster == nil then return end
        if monster.IsDead or not self.Entity.Enable or #_Util:PlayersInMap(self.Entity.CurrentMap) == 0 then
            self:ResetRite()
            return
        end
        local ratio = monster.Hp / math.max(1, monster.MaxHp)
        if self.Phase == 1 and ratio <= 0.66 then self:EnterPhase(2, monster) end
        if self.Phase == 2 and ratio <= 0.33 then self:EnterPhase(3, monster) end
        if self.SanctumOn then
            self.SanctumTick = self.SanctumTick - delta
            if self.SanctumTick <= 0 then
                self.SanctumTick = 0.5
                self:ApplySanctum()
            end
        end
        if self.Phase >= 3 then
            if self.RitualLeft > 0 then
                self.RitualLeft = self.RitualLeft - delta
                if self:PriestsAlive() == 0 then
                    self.RitualLeft = 0
                    self:RiteBreakFx()
                    log("[VRF] archbishop ritual broken " .. tostring(self.RitualCount))
                elseif self.RitualLeft <= 0 then
                    self:CompleteRitual(monster)
                end
            end
            self.RitualTimer = self.RitualTimer - delta
            if self.RitualTimer <= 0 then
                self.RitualTimer = self.RitualInterval
                self:BeginRitual(monster)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void EnterPhase(integer phase, Monster monster)
        -- ② 성역을 펼친다 · ③ 의식을 시작한다
        self.Phase = phase
        if phase == 2 then
            self.SanctumCenter = monster.SpawnPosition
            self.SanctumOn = true
            self.SanctumTick = 0
            self:SanctumBeginFx()
        elseif phase == 3 then
            self.RitualTimer = 1
        end
        log("[VRF] archbishop phase " .. tostring(phase))
    end

    @ExecSpace("ServerOnly")
    method void ApplySanctum()
        -- 성역 안 졸개(대주교 제외)는 주는 피해 × SanctumMult, 나가면 원래대로
        local map = self.Entity.CurrentMap
        local inside, ids = {}, {}
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            ---@type Monster
            local m = c
            if isvalid(m.Entity) and m.Entity ~= self.Entity and not m.IsDead and (_Util:Pos2(m.Entity) - self.SanctumCenter):Magnitude() <= self.SanctumRadius then
                m.RiteDealtMult = self.SanctumMult
                table.insert(inside, m.Entity)
                ids[m.Entity.Id] = true
            end
        end
        for _, e in ipairs(self.Buffed) do
            if isvalid(e) and not ids[e.Id] then
                ---@type Monster
                local m = e:GetComponent("script.Monster")
                if m ~= nil then m.RiteDealtMult = 1 end
            end
        end
        self.Buffed = inside
    end

    @ExecSpace("ServerOnly")
    method void BeginRitual(Monster monster)
        -- 의식 사제 2 (성역 양 끝) — 붉게 물들고 RitualSeconds초 뒤 남아 있으면 의식 완성
        local map = self.Entity.CurrentMap
        local level = math.max(1, monster.Level - 2)
        self.Priests = {}
        self.RitualCount = self.RitualCount + 1
        for i = 1, 2 do
            local side = i == 1 and -1 or 1
            local at = _Util:ReachablePoint(map, self.SanctumCenter, self.SanctumCenter + Vector2(side * 2.6, 0.4), 0.4)
            local e = _SpawnService:SpawnByModelId(self.PriestModel, "RitualPriest", Vector3(at.x, at.y, 0), map)
            if isvalid(e) then
                table.insert(self.Priests, e)
                _Util:AfterSpawn(e, "script.Monster", function(comp)
                    ---@type Monster
                    local m = comp
                    m.RespawnDelay = -1
                    m:ApplyLevel(level, false)
                    ---@type MonsterTraits
                    local traits = e:GetComponent("script.MonsterTraits")
                    if traits ~= nil then
                        traits.Tint = "1,0.35,0.35"
                        traits.TintSync = traits.Tint
                    end
                end, nil)
            end
        end
        self.RitualLeft = self.RitualSeconds
        self:RitualFx()
        log("[VRF] archbishop ritual " .. tostring(self.RitualCount) .. " priests=" .. tostring(#self.Priests))
    end

    @ExecSpace("ServerOnly")
    method integer PriestsAlive()
        -- 살아 있는 의식 사제 수
        local n = 0
        for _, e in ipairs(self.Priests) do
            if isvalid(e) then
                ---@type Monster
                local m = e:GetComponent("script.Monster")
                if m ~= nil and not m.IsDead then n = n + 1 end
            end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method void CompleteRitual(Monster monster)
        -- 의식 완성: 남은 사제가 사라지고 대주교 생명 회복
        local left = self:PriestsAlive()
        for _, e in ipairs(self.Priests) do
            if isvalid(e) then e:Destroy() end
        end
        self.Priests = {}
        local heal = monster.MaxHp * self.RitualHealPct / 100
        monster:RestoreHp(heal, "rite")
        self:HealFx()
        log(string.format("[VRF] archbishop ritual complete %d left=%d heal=%d", self.RitualCount, left, math.floor(heal)))
    end

    @ExecSpace("Multicast")
    method void SanctumBeginFx()
        -- 성역이 펼쳐짐: 붉은 파동 + 화면 흔들림
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayRiteCue("archbishop", "phase", self.Entity)   -- 2단계 성역 (39 #9 ② · rite_phase)
        local c = self.SanctumCenter
        _ParticleService:PlayBasicParticle(BasicParticleType.Nova, self.Entity, Vector3(c.x, c.y, 0), 0, Vector3(self.SanctumRadius, self.SanctumRadius, 1), false, { Color = Color(0.9, 0.15, 0.2, 0.7) })
        local cam = _CameraService:GetCurrentCameraComponent()
        if isvalid(cam) then cam:ShakeCamera(0.2, 0.4) end
    end

    @ExecSpace("Multicast")
    method void RitualFx()
        -- 의식 시작: 대주교에게 붉은 기운이 모인다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayRiteCue("archbishop", "start", self.Entity)   -- 의식 시작음 (39 #9 ②)
        _ParticleService:PlayBasicParticleAttached(BasicParticleType.Charge, self.Entity, Vector3(0, 0.9, 0), 0, Vector3(1.4, 1.4, 1), false, { Color = Color(0.95, 0.15, 0.2, 1) })
    end

    @ExecSpace("Multicast")
    method void HealFx()
        -- 의식 완성: 대주교 몸에 피의 빛
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _SoundDirector:PlayRiteCue("archbishop", "done", self.Entity)
        _ParticleService:PlayBasicParticleAttached(BasicParticleType.Buff, self.Entity, Vector3(0, 0.2, 0), 0, Vector3(1.6, 1.6, 1), false, { Color = Color(1, 0.2, 0.25, 1) })
    end

    @ExecSpace("Multicast")
    method void RiteBreakFx()
        -- 사제를 모두 쓰러뜨려 의식을 끊었다: 깨지는 소리
        _SoundDirector:PlayRiteCue("archbishop", "break", self.Entity)
    end

    @ExecSpace("ClientOnly")
    method void SyncSanctumFx()
        -- 성역이 켜진 동안 바닥에 붉은 빛 (SanctumOn 동기화를 따라간다)
        local want = self.SanctumOn and self.Entity.Enable
        if want and self.SanctumFx == 0 then
            local c = self.SanctumCenter
            local r = self.SanctumRadius
            self.SanctumFx = _ParticleService:PlayBasicParticle(BasicParticleType.SpinField, self.Entity, Vector3(c.x, c.y, 0), 0, Vector3(r, r, 1), true, { Color = Color(0.85, 0.12, 0.18, 0.55) })
        elseif not want and self.SanctumFx ~= 0 then
            _ParticleService:RemoveParticle(self.SanctumFx)
            self.SanctumFx = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 성역 빛 정리
        if self.SanctumFx ~= 0 then _ParticleService:RemoveParticle(self.SanctumFx) end
        self.SanctumFx = 0
    end

    @ExecSpace("ServerOnly")
    method void ResetRite()
        -- 처음 상태로: 성역 버프를 풀고 사제를 치운다
        if self.Phase == 1 and not self.SanctumOn then return end
        self.Phase = 1
        self.SanctumOn = false
        for _, e in ipairs(self.Buffed) do
            if isvalid(e) then
                ---@type Monster
                local m = e:GetComponent("script.Monster")
                if m ~= nil then m.RiteDealtMult = 1 end
            end
        end
        self.Buffed = {}
        for _, e in ipairs(self.Priests) do
            if isvalid(e) then e:Destroy() end
        end
        self.Priests = {}
        self.RitualLeft = 0
        log("[VRF] ArchbishopRite reset")
    end

end
