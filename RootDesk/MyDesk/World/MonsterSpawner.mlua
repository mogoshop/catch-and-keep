-- 맵별 몬스터 배치 (맵 안의 빈 엔티티에 붙인다). 시작할 때 목록대로 영역 안 무작위 위치에 소환하고,
-- 레벨·정예 여부를 정한다. 이후 리스폰은 각 몬스터(ShadowMonster)가 처음 위치에서 스스로 한다.
-- Entries 형식: "모델id:마리수:레벨;..."   예) "hellhound:6:1;graveworm:3:2"
@Component
script MonsterSpawner extends Component

    property string Entries = ""
    property Vector2 AreaMin = Vector2(-6, -3)
    property Vector2 AreaMax = Vector2(6, 3)
    property number EliteChance = 0        -- 일반 몬스터가 정예로 나올 확률
    property boolean DebugLog = false

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 맵이 다 준비된 뒤 소환
        _TimerService:SetTimerOnce(function() self:SpawnAll() end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method void SpawnAll()
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local total = 0
        local bonus = 0
        ---@type MapAmbience
        local amb = map:GetComponent("script.MapAmbience")
        if amb ~= nil then bonus = amb.LevelBonus end
        for modelId, count, level in string.gmatch(self.Entries, "([%w_]+):(%d+):(%d+)") do
            for i = 1, tonumber(count) do
                local x = self.AreaMin.x + _UtilLogic:RandomDouble() * (self.AreaMax.x - self.AreaMin.x)
                local y = self.AreaMin.y + _UtilLogic:RandomDouble() * (self.AreaMax.y - self.AreaMin.y)
                local e = _SpawnService:SpawnByModelId(modelId, modelId, Vector3(x, y, 0), map)
                if isvalid(e) then
                    local elite = _UtilLogic:RandomDouble() < self.EliteChance
                    self:Setup(e, tonumber(level) + bonus, elite, 0)
                    total = total + 1
                end
            end
        end
        if self.DebugLog then log("[MonsterSpawner] " .. map.Name .. " 소환 " .. tostring(total)) end
    end

    @ExecSpace("ServerOnly")
    method void Setup(Entity e, integer level, boolean elite, integer attempt)
        -- 스폰 직후 컴포넌트 조회 실패 대비 재시도
        if not isvalid(e) then return end
        local ok, comp = pcall(function() return e:GetComponent("script.ShadowMonster") end)
        if ok and comp ~= nil then
            ---@type ShadowMonster
            local m = comp
            m:ApplyLevel(level, elite)
            return
        end
        if attempt >= 5 then return end
        _TimerService:SetTimerOnce(function() self:Setup(e, level, elite, attempt + 1) end, 0.1)
    end

end
