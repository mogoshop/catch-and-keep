-- 클라이언트: 서버가 움직이는 몬스터·소환수를 「보간」으로 부드럽게 그린다 (10-10 4차 QA: 실제 서버에서 소환수가 계속 끊긴다).
--   · 실제 서버에서는 위치가 고르게 오지 않는다 (통신 지연이 들쭉날쭉, 11마리 × 위치·그림·방향 동기화).
--     받은 위치를 그대로 쓰면 멈칫 → 한 번에 건너뜀이 반복된다.
--   · 새 서버 위치가 올 때마다 그 서버 시각과 함께 기록해 두고, 화면에는 「지금 − Delay」 시점의 위치를
--     앞뒤 기록 사이에서 이어 그린다. 다음 기록이 늦으면 마지막 기록 위치에서 기다릴 뿐 앞서 나가지 않는다
--     (예전 추측 항법은 앞서 나가 「걷지 않고 날아다니는」 것처럼 보였다 — 10-10 2차 QA).
--   · 그림만 옮긴다. 판정·이동은 서버 그대로이고, 서버 위치가 오면 엔진이 덮어쓴다 (그 차이로 새 기록을 알아챈다).
--   · 좌우 방향·서기/걷기 그림도 화면 위치에 맞춘다 (10-10 4차 QA): 위치만 늦추면 움직이기 전에 먼저 돌거나 걷는 그림이 나오고,
--     멈춘 뒤에도 서 있는 그림으로 미끄러졌다. 화면에서 실제로 움직이는 동안은 그 방향·걷기 그림, 멈추면 서버 값(대상 바라보기 등)으로.
--     공격 등 서기/걷기가 아닌 그림은 건드리지 않는다.
@Logic
script MotionSmoother extends Logic

    property boolean Enabled = true
    property number Range = 12               -- 플레이어에게서 이 거리 안의 개체만 (화면 밖은 그대로)
    property number Delay = 0.1              -- 그리는 시점을 이만큼 늦춘다 (기본값, 최근 가장 늦은 기록 간격에 맞춰 0.08~0.3으로 조절)
    property number SnapDistance = 2.5       -- 기록 사이가 이보다 멀면 순간이동(도약·재배치)으로 보고 바로 옮긴다
    property number ScanTimer = 0
    property any Map = nil
    property any Recs = nil                  -- 개체 Id → { e, buf = { {t, x, y} … }, wx, wy, gap, peak, v, rt }
    property number ClockOffset = 0          -- 서버 시각 − 클라이언트 시각 (평활)
    property boolean ClockReady = false
    property integer SampleCount = 0
    property integer DrawCount = 0
    property number MoveOn = 0.35            -- 화면 속도가 이보다 빠르면 「걷는 중」 (칸/초)
    property number MoveOff = 0.12           -- 이보다 느려지면 「멈춤」
    property integer StatMoving = 0          -- 점검용: 화면에서 걷는 중이던 프레임 수 (개체별 합)
    property integer StatHold = 0            -- 점검용: 그중 다음 기록이 늦어 제자리에서 기다리다 다시 움직인 프레임 수 (진짜 멈칫, 실제로 멈춘 것은 빼고)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 추적표 준비
        self.Recs = {}
        log("[VRF] MotionSmoother ready (interpolation)")
    end

    @ExecSpace("ClientOnly")
    method number ServerNow(number now, number delta)
        -- 서버 시각 추정: ServerElapsedSeconds는 통신 단위로만 바뀌므로, 클라이언트 시계와의 차이를 평활해 매 프레임 이어지는 서버 시각을 만든다
        local off = _UtilLogic.ServerElapsedSeconds - now
        if not self.ClockReady or math.abs(off - self.ClockOffset) > 1 then
            self.ClockOffset = off
            self.ClockReady = true
        elseif off > self.ClockOffset then
            -- 새 통신이 도착한 순간(차이가 커질 때)은 빠르게(0.08초) 따라가고, 통신 사이(차이가 줄어들 때)는 아주 천천히(1.5초).
            -- 시간 기준이라 프레임률과 상관없다 (예전: 프레임당 비율이라 60fps와 300fps에서 따라가는 빠르기가 5배 달랐다)
            self.ClockOffset = self.ClockOffset + (off - self.ClockOffset) * (1 - math.exp(-delta / 0.08))
        else
            self.ClockOffset = self.ClockOffset + (off - self.ClockOffset) * (1 - math.exp(-delta / 1.5))
        end
        return now + self.ClockOffset
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 매 프레임: 서버가 덮어쓴 새 위치를 기록하고, 「지금 − Delay」 시점의 위치를 기록 사이에서 이어 그린다
        if not self.Enabled then return end
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local map = me.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.Map then
            self.Map = map
            self.Recs = {}
            self.ScanTimer = 0
        end
        self.ScanTimer = self.ScanTimer - delta
        if self.ScanTimer <= 0 then
            self.ScanTimer = 0.5
            self:Scan(map, me)
        end
        local snow = self:ServerNow(_UtilLogic.ElapsedSeconds, delta)
        for id, r in pairs(self.Recs) do
            local e = r.e
            if not isvalid(e) or not e.Enable then
                self.Recs[id] = nil
            else
                self:Step(r, snow, delta)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Step(any r, number snow, number delta)
        -- 개체 하나: 새 기록 감지 → 그릴 시점의 위치 계산 → 위치 쓰기
        -- (10-10 5차 QA: 액트 1·2 모두 아직 끊긴다. 메이커에서는 서버·클라 스크립트 부하가 원인이 아님을 확인 →
        --  실제 서버의 들쭉날쭉한 도착에 맞춰 세 가지를 보강. 모의 실험(20Hz·흔들림 120ms·몰림 8%)에서 멈춘 프레임 2.3% → 1.5%, 속도 오차 0.33 → 0.21)
        --   · 기록 시각 다듬기: 걷는 중이면 「이동 거리 ÷ 평균 속도」로 간격을 추정해 도착 흔들림이 시각에 섞이지 않게 한다
        --   · 늦춤 = 최근 가장 늦었던 기록 간격 기준 (평균의 1.6배는 가끔 늦는 기록에서 멈칫했다). 서 있는 동안의 빈 간격은 세지 않는다
        --   · 그리는 시계를 따로 두고 목표 시점을 0.85~1.15배 빠르기로 따라간다 (늦춤이 바뀌어도 순간 멈춤·건너뜀이 없다)
        local t = r.e.TransformComponent
        local p = t.WorldPosition
        local buf = r.buf
        if #buf == 0 or math.abs(p.x - r.wx) > 0.0005 or math.abs(p.y - r.wy) > 0.0005 then
            -- 엔진이 서버 위치로 덮어썼다 = 새 기록 (서버 시각으로 찍는다)
            local last = buf[#buf]
            local st = _UtilLogic.ServerElapsedSeconds
            if last ~= nil and ((p.x - last.x) ^ 2 + (p.y - last.y) ^ 2 > self.SnapDistance * self.SnapDistance) then
                -- 순간이동: 기록을 비우고 그 자리에서 다시 시작
                buf = {}
                r.buf = buf
                last = nil
                r.rt = nil
            end
            if last ~= nil then
                if st <= last.t then st = last.t + 0.001 end
                local obs = st - last.t
                local dist = math.sqrt((p.x - last.x) ^ 2 + (p.y - last.y) ^ 2)
                if obs < 0.35 and dist > 0.0001 then
                    local v = dist / obs
                    if r.v <= 0 then r.v = v else r.v = r.v + (math.min(v, r.v * 3) - r.v) * 0.15 end
                    if r.v > 0.2 then
                        local g = math.max(obs * 0.4, math.min(obs * 2.5, 0.7 * (dist / r.v) + 0.3 * obs))
                        local t2 = last.t + g
                        t2 = t2 + (st - t2) * 0.15   -- 실제 서버 시각에서 멀어지지 않게
                        st = math.max(last.t + 0.001, t2)
                    end
                end
                local g = st - last.t
                if g < 0.35 then
                    r.gap = r.gap + (g - r.gap) * 0.1
                    if g > r.peak then r.peak = g end
                end
            end
            table.insert(buf, { t = st, x = p.x, y = p.y })
            while #buf > 12 do table.remove(buf, 1) end
            if r.hold ~= nil and r.hold > 0 then
                -- 기다리던 중 다음 기록이 왔다 = 멈칫 (0.3초 넘게 기다렸으면 실제로 멈췄다 다시 걷는 것)
                if last ~= nil and st - last.t < 0.3 then self.StatHold = self.StatHold + r.hold end
                r.hold = 0
            end
            r.wx, r.wy = p.x, p.y
            self.SampleCount = self.SampleCount + 1
        end
        -- 그릴 시점: 최근 가장 늦은 기록 간격 + 여유 (고르면 0.08초, 들쭉날쭉하면 최대 0.3초). 가장 늦은 간격은 초당 0.05초씩 잊는다
        r.peak = math.max(r.gap, r.peak - delta * 0.05)
        local delay = math.max(0.08, math.min(0.3, r.peak * 1.1 + 0.02))
        local target = snow - delay
        if r.rt == nil or math.abs(target - r.rt) > 0.25 then r.rt = target
        else r.rt = r.rt + delta * (1 + math.max(-0.15, math.min(0.15, (target - r.rt) * 3))) end
        local rt = r.rt
        local x, y
        if rt <= buf[1].t then
            x, y = buf[1].x, buf[1].y
        elseif rt >= buf[#buf].t then
            -- 다음 기록이 아직: 마지막 기록 위치에서 기다린다 (앞서 나가지 않는다)
            x, y = buf[#buf].x, buf[#buf].y
            if r.moving then r.hold = (r.hold or 0) + 1 end
        else
            for i = #buf - 1, 1, -1 do
                local a = buf[i]
                if a.t <= rt then
                    local b = buf[i + 1]
                    local k = (rt - a.t) / math.max(0.0001, b.t - a.t)
                    x, y = a.x + (b.x - a.x) * k, a.y + (b.y - a.y) * k
                    break
                end
            end
            if x == nil then x, y = buf[1].x, buf[1].y end
        end
        local now = _UtilLogic.ElapsedSeconds
        local dt = now - r.vt
        if dt > 0.0005 then
            -- 화면에 그리는 위치의 속도 (평활)
            local k = math.min(1, dt * 12)
            r.vx = r.vx + ((x - r.dx) / dt - r.vx) * k
            r.vy = r.vy + ((y - r.dy) / dt - r.vy) * k
            r.vt = now
            r.dx, r.dy = x, y
        end
        if math.abs(x - r.wx) > 0.0001 or math.abs(y - r.wy) > 0.0001 then
            t.WorldPosition = Vector3(x, y, p.z)
            r.wx, r.wy = x, y
            self.DrawCount = self.DrawCount + 1
        end
        if r.moving then self.StatMoving = self.StatMoving + 1 end
        local speed = math.sqrt(r.vx * r.vx + r.vy * r.vy)
        if r.moving and speed < self.MoveOff then r.moving = false
        elseif not r.moving and speed > self.MoveOn then r.moving = true end
        if r.unit ~= nil then self:LookUnit(r, t) elseif r.monster then self:LookMonster(r) end
    end

    @ExecSpace("ClientOnly")
    method void LookUnit(any r, TransformComponent t)
        -- 소환수: 좌우 = 크기 x 부호 (그림 기본은 왼쪽), 그림 = 서기/걷기 클립. 서버가 바꾼 값은 기억해 두고 멈추면 그 값으로
        ---@type ShadowUnit
        local unit = r.unit
        if not isvalid(unit) then return end
        local sc = t.Scale
        if r.myScaleX == nil or math.abs(sc.x - r.myScaleX) > 0.0001 then r.srvScaleX = sc.x end
        local wantX = r.srvScaleX
        if r.moving and math.abs(r.vx) > 0.2 then wantX = math.abs(sc.x) * (r.vx > 0 and -1 or 1) end
        if wantX ~= nil and math.abs(wantX - sc.x) > 0.0001 then
            t.Scale = Vector3(wantX, sc.y, sc.z)
            unit:UpdateHpBar()
        end
        r.myScaleX = wantX
        local sprite = unit.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local cur = sprite.SpriteRUID
        if r.myClip == nil or cur ~= r.myClip then r.srvClip = cur end
        local stand, move = unit.StandRUID, unit.MoveRUID
        local want = r.srvClip
        if stand ~= "" and move ~= "" and (r.srvClip == stand or r.srvClip == move) then
            want = r.moving and move or stand
        end
        if want ~= nil and want ~= "" and want ~= cur then sprite.SpriteRUID = want end
        r.myClip = want
    end

    @ExecSpace("ClientOnly")
    method void LookMonster(any r)
        -- 몬스터: 좌우 = FlipX (true면 오른쪽). 움직이는 동안만 화면 방향, 멈추면 서버 값(공격 대상 바라보기)
        local sprite = r.e.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local cur = sprite.FlipX
        if r.myFlip == nil or cur ~= r.myFlip then r.srvFlip = cur end
        local want = r.srvFlip
        if r.moving and math.abs(r.vx) > 0.2 then want = r.vx > 0 end
        if want ~= nil and want ~= cur then sprite.FlipX = want end
        r.myFlip = want
    end

    method integer VisualMoving(Entity e)
        -- 프레임 애니메이터용: 화면에서 걷는 중이면 1, 멈췄으면 0, 추적하지 않는 개체면 -1
        if self.Recs == nil or not isvalid(e) then return -1 end
        local r = self.Recs[e.Id]
        if r == nil or #r.buf == 0 then return -1 end
        return r.moving and 1 or 0
    end

    @ExecSpace("ClientOnly")
    method void Scan(Entity map, Entity me)
        -- 0.5초마다: 플레이어 근처의 몬스터·소환수를 추적표에 넣고, 멀어진 것은 마지막 서버 위치로 돌려놓고 뺀다
        local mp = me.TransformComponent.WorldPosition
        local seen = {}
        for _, typeName in ipairs({ "script.Monster", "script.ShadowUnit" }) do
            local isUnit = typeName == "script.ShadowUnit"
            for _, comp in ipairs(map:GetChildComponentsByTypeName(typeName, false)) do
                local e = comp.Entity
                if isvalid(e) and e.Enable then
                    local p = e.TransformComponent.WorldPosition
                    local dx, dy = p.x - mp.x, p.y - mp.y
                    if dx * dx + dy * dy <= self.Range * self.Range then
                        local id = e.Id
                        seen[id] = true
                        if self.Recs[id] == nil then
                            self.Recs[id] = { e = e, buf = {}, wx = p.x, wy = p.y, gap = 0.05, peak = 0.05, v = 0, rt = nil, vx = 0, vy = 0, vt = _UtilLogic.ElapsedSeconds, dx = p.x, dy = p.y, moving = false,
                                unit = isUnit and comp or nil, monster = not isUnit }
                        end
                    end
                end
            end
        end
        for id, r in pairs(self.Recs) do
            if not seen[id] then
                local last = r.buf[#r.buf]
                if isvalid(r.e) and last ~= nil then
                    local p = r.e.TransformComponent.WorldPosition
                    if math.abs(p.x - r.wx) < 0.0005 and math.abs(p.y - r.wy) < 0.0005 then
                        r.e.TransformComponent.WorldPosition = Vector3(last.x, last.y, p.z)
                    end
                end
                self.Recs[id] = nil
            end
        end
    end
end
