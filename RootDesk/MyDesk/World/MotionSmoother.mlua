-- 클라이언트: 서버가 움직이는 몬스터·소환수를 부드럽게 그린다 (10-10 QA: 플레이어는 부드러운데 몹·소환수만 끊겼다).
--   · 서버 위치는 바뀔 때만, 초당 약 10번 도착한다 (메이커 측정: 서버가 받는 플레이어 위치도 7초 동안 61번).
--     도착할 때마다 순간이동하듯 0.1~0.2칸씩 툭툭 움직였다.
--   · 새 서버 위치가 오면 직전 위치와의 차이로 속도를 잡고, 다음 위치가 올 때까지 그 속도로 이어서 그린다 (추측 항법).
--   · 다음 위치가 제때 오지 않으면 멈춘 것 → 마지막 서버 위치로 빠르게 되돌린다 (서버는 멈춘 위치를 다시 보내지 않는다).
--   · 그림만 옮긴다. 판정·이동은 서버 그대로이고, 서버 위치가 오면 엔진이 덮어쓴다.
@Logic
script MotionSmoother extends Logic

    property boolean Enabled = true
    property number Range = 12               -- 플레이어에게서 이 거리 안의 개체만 (화면 밖은 그대로)
    property number ScanTimer = 0
    property any Map = nil
    property any Recs = nil                  -- 개체 Id → { e, sx, sy, st, vx, vy, iv, wx, wy, has }
    property integer SampleCount = 0
    property integer DrawCount = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 추적표 준비
        self.Recs = {}
        log("[VRF] MotionSmoother ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 매 프레임: 새 서버 위치를 받았으면 속도를 갱신하고, 아니면 그 속도로 이어 그린다
        if not self.Enabled then return end
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local map = me.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.Map then
            self.Map = map
            self.Recs = {}
            self.ScanTimer = 0
        end
        self.ScanTimer = self.ScanTimer - delta
        if self.ScanTimer <= 0 then
            self.ScanTimer = 0.5
            self:Scan(map, me)
        end
        local now = _UtilLogic.ElapsedSeconds
        local ease = math.min(1, delta * 12)
        for id, r in pairs(self.Recs) do
            local e = r.e
            if not isvalid(e) or not e.Enable then
                self.Recs[id] = nil
            else
                local t = e.TransformComponent
                local p = t.WorldPosition
                local cx, cy = p.x, p.y
                if not r.has or math.abs(cx - r.wx) > 0.0005 or math.abs(cy - r.wy) > 0.0005 then
                    -- 엔진이 서버 위치로 덮어썼다 = 새 표본
                    local dt = now - r.st
                    local dx, dy = cx - r.sx, cy - r.sy
                    if r.has and dt > 0.005 and dt < 0.6 and dx * dx + dy * dy < 4 and dx * dx + dy * dy < 64 * dt * dt then
                        r.vx = r.vx + (dx / dt - r.vx) * 0.7
                        r.vy = r.vy + (dy / dt - r.vy) * 0.7
                        r.iv = r.iv + (dt - r.iv) * 0.3
                    else
                        -- 처음 보거나 순간이동(도약·넉백·재배치)
                        r.vx, r.vy = 0, 0
                    end
                    r.sx, r.sy, r.st, r.has = cx, cy, now, true
                    r.wx, r.wy = cx, cy
                    self.SampleCount = self.SampleCount + 1
                else
                    local age = now - r.st
                    local tx, ty = r.wx, r.wy
                    if age <= r.iv then
                        -- 다음 표본까지: 마지막 서버 위치 + 속도 × 경과 (한 간격까지만 앞서 나간다)
                        tx, ty = r.sx + r.vx * age, r.sy + r.vy * age
                    elseif age > math.max(0.35, r.iv * 4) then
                        -- 표본이 한참 안 온다 = 멈췄다 → 마지막 서버 위치로 (조금 늦는 표본에는 뒤로 물러나지 않고 그 자리에서 기다린다)
                        r.vx, r.vy = 0, 0
                        tx, ty = r.wx + (r.sx - r.wx) * ease, r.wy + (r.sy - r.wy) * ease
                    end
                    if math.abs(tx - r.wx) > 0.0001 or math.abs(ty - r.wy) > 0.0001 then
                        t.WorldPosition = Vector3(tx, ty, p.z)
                        r.wx, r.wy = tx, ty
                        self.DrawCount = self.DrawCount + 1
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Scan(Entity map, Entity me)
        -- 0.5초마다: 플레이어 근처의 몬스터·소환수를 추적표에 넣고, 멀어진 것은 뺀다
        local mp = me.TransformComponent.WorldPosition
        local seen = {}
        for _, typeName in ipairs({ "script.Monster", "script.ShadowUnit" }) do
            for _, comp in ipairs(map:GetChildComponentsByTypeName(typeName, false)) do
                local e = comp.Entity
                if isvalid(e) and e.Enable then
                    local p = e.TransformComponent.WorldPosition
                    local dx, dy = p.x - mp.x, p.y - mp.y
                    if dx * dx + dy * dy <= self.Range * self.Range then
                        local id = e.Id
                        seen[id] = true
                        if self.Recs[id] == nil then
                            self.Recs[id] = { e = e, sx = p.x, sy = p.y, st = _UtilLogic.ElapsedSeconds, vx = 0, vy = 0, iv = 0.1, wx = p.x, wy = p.y, has = false }
                        end
                    end
                end
            end
        end
        for id, r in pairs(self.Recs) do
            if not seen[id] then
                -- 멀어졌다: 이어 그린 위치를 마지막 서버 위치로 되돌리고 뺀다
                if isvalid(r.e) and r.has then
                    local p = r.e.TransformComponent.WorldPosition
                    if math.abs(p.x - r.wx) < 0.0005 and math.abs(p.y - r.wy) < 0.0005 then
                        r.e.TransformComponent.WorldPosition = Vector3(r.sx, r.sy, p.z)
                    end
                end
                self.Recs[id] = nil
            end
        end
    end
end
