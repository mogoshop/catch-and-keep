-- 클라이언트: 서버가 움직이는 몬스터·소환수를 「보간」으로 부드럽게 그린다 (10-10 4차 QA: 실제 서버에서 소환수가 계속 끊긴다).
--   · 실제 서버에서는 위치가 고르게 오지 않는다 (통신 지연이 들쭉날쭉, 11마리 × 위치·그림·방향 동기화).
--     받은 위치를 그대로 쓰면 멈칫 → 한 번에 건너뜀이 반복된다.
--   · 새 서버 위치가 올 때마다 그 서버 시각과 함께 기록해 두고, 화면에는 「지금 − Delay」 시점의 위치를
--     앞뒤 기록 사이에서 이어 그린다. 다음 기록이 늦으면 마지막 기록 위치에서 기다릴 뿐 앞서 나가지 않는다
--     (예전 추측 항법은 앞서 나가 「걷지 않고 날아다니는」 것처럼 보였다 — 10-10 2차 QA).
--   · 그림만 옮긴다. 판정·이동은 서버 그대로이고, 서버 위치가 오면 엔진이 덮어쓴다 (그 차이로 새 기록을 알아챈다).
--   · 좌우 방향·서기/걷기 그림도 화면 위치에 맞춘다 (10-10 4차 QA): 위치만 늦추면 움직이기 전에 먼저 돌거나 걷는 그림이 나오고,
--     멈춘 뒤에도 서 있는 그림으로 미끄러졌다. 화면에서 실제로 움직이는 동안은 그 방향·걷기 그림, 멈추면 서버 값(대상 바라보기 등)으로.
--     공격 등 서기/걷기가 아닌 그림은 건드리지 않는다.
--   · 내 소환수가 「따라가기·집결」 중이면 서버 위치 대신 내 클라이언트가 직접 움직인다 (10-10 5차 QA: 사냥은 자연스러운데
--     걸어 다닐 때만 끊긴다). 서버 위치를 아무리 잘 이어 그려도 통신으로 띄엄띄엄 오는 값이라, 매 프레임 내 손으로 움직이는
--     캐릭터만큼 부드러울 수 없다. 내 캐릭터의 화면 위치로 ShadowUnit과 같은 대형 자리를 매 프레임 계산해 따라 걷는다.
--     판정은 여전히 서버 위치: 둘이 FollowSlack보다 벌어지면 조금씩 당기고, 사냥을 시작하면 0.3초 이상(초당 2칸 이하로)에 걸쳐 보간 위치로 넘어간다.
--     파티원의 소환수는 지금처럼 보간만 한다.
-- ⚠ 고치기 전에 docs/motion-sync.md 「하지 말 것」을 본다 (npm test 「움직임 불변식」이 핵심 구현을 확인)
@Logic
script MotionSmoother extends Logic

    property boolean Enabled = true
    property number Range = 12               -- 플레이어에게서 이 거리 안의 개체만 (화면 밖은 그대로)
    property number Delay = 0.1              -- 그리는 시점을 이만큼 늦춘다 (기본값, 최근 가장 늦은 기록 간격에 맞춰 0.08~0.3으로 조절)
    property number SnapDistance = 2.5       -- 기록 사이가 이보다 멀면 순간이동(도약·재배치)으로 보고 바로 옮긴다
    property number AttackWindup = 0.18     -- 소환수 공격 타격 시점 (ShadowUnit.AttackWindup과 같게) — 공격 프레임의 타격 장을 이때 보인다
    property number OtherSummonAlpha = 0.55   -- 다른 플레이어 소환수의 불투명도 (내 것은 1 · 10-28 F5 B-4: 0.8 → 0.55)
    property number ScanTimer = 0
    property any Map = nil
    property any Recs = nil                  -- 개체 Id → { e, buf = { {t, x, y} … }, wx, wy, gap, peak, v, rt }
    property number ClockOffset = 0          -- 서버 시각 − 클라이언트 시각 (평활)
    property boolean ClockReady = false
    property integer SampleCount = 0
    property integer DrawCount = 0
    property number MoveOn = 0.35            -- 화면 속도가 이보다 빠르면 「걷는 중」 (칸/초)
    property number MoveOff = 0.12           -- 이보다 느려지면 「멈춤」
    property integer StatMoving = 0          -- 점검용: 화면에서 걷는 중이던 프레임 수 (개체별 합)
    property integer StatHold = 0            -- 점검용: 그중 다음 기록이 늦어 제자리에서 기다리다 다시 움직인 프레임 수 (진짜 멈칫, 실제로 멈춘 것은 빼고)
    property boolean LocalFollow = true      -- 내 소환수의 따라가기를 내 클라이언트가 직접 그린다
    property number FollowSlack = 0.8        -- 직접 그린 위치가 서버 위치에서 이보다 벌어지면 초당 3배 빠르기로 당긴다
    property number SpeedScale = 0.836       -- RectTile 맵에서 InputSpeed 1 = 초당 0.836칸 (메이커 실측, 플랫폼 규칙 ÷1.2)
    property any Me = nil
    property boolean OwnerReady = false
    property number OwnerPX = 0
    property number OwnerPY = 0
    property number OwnerVX = 0              -- 내 캐릭터 화면 속도 (평활)
    property number OwnerVY = 0
    property number OwnerSpeed = 0
    property number OwnerDX = 1              -- 마지막 걷는 방향
    property number OwnerDY = 0
    property any Owners = nil                -- 주인(플레이어) Id → 화면 위치·속도·걷는 방향 (내 캐릭터·파티원 모두, 프레임마다 한 번)
    property integer FrameNo = 0
    property integer StatLocal = 0           -- 점검용: 직접 그린 프레임 수
    property number StatMaxPull = 0          -- 점검용: 서버 위치와 가장 많이 벌어졌던 거리
    property number StatMaxSpeed = 0         -- 점검용: 화면에서 한 프레임에 움직인 가장 빠른 속도(칸/초) — 튐 확인 (보간 중)
    property number StatMaxSpeedLocal = 0    -- 점검용: 직접 그리는 중
    property number StatMaxSpeedBlend = 0    -- 점검용: 직접 그리기 → 보간으로 넘어가는 중
    property integer ShadowW = 28            -- 그림자 타원 픽셀 크기
    property integer ShadowH = 12
    property number PixelUnit = 0.01         -- 픽셀 그림 1칸 = 0.01칸 (100px = 1칸)
    property any ShadowCache = nil
    property any FrameIndex = nil            -- 프레임 몬스터의 첫 프레임 RUID → { set, act } (소환수 대역이 서기·걷기·공격 프레임을 넘긴다)
    property boolean UseProxy = true         -- 소환수는 몸 그림을 클라이언트 전용 자식(MSVis)으로 그린다 (아래 PlaceVis)
    property boolean MonsterProxy = true     -- 몬스터도 같은 대역으로 그린다 (10-11 QA: 몬스터도 끊긴다 — 루트에 쓴 위치는 서버 위치가 올 때마다 덮어써진다)
    property string AuraRingRUID = "ea61dc5ba8ce4ddd8287cba1d9566121"   -- 오오라 몬스터 발밑 원 (소환수 AllyRing과 같은 그림)
    property number AuraFxAlpha = 0.35       -- 발밑 원 위 오오라 입자 진하기
    property integer StatFlip = 0            -- 점검용: 소환수 좌우를 바꿔 쓴 횟수
    property number FaceMinVX = 0.08         -- 걷는 중 좌우를 걸음 방향으로 정하는 가로 걸음 최소 빠르기 (칸/초 · 10-30: 0.2에서 낮춤 — 느린 걸음도 걸음 방향)
    property integer StatSwitch = 0          -- 점검용: 직접 그리기 ↔ 보간 전환 횟수
    property integer StatReverse = 0         -- 점검용: 화면에서 움직이던 방향과 반대로 꺾인 프레임 수 (뒤로 갔다 앞으로)
    property integer StatSnap = 0            -- 점검용: 직접 그리다 서버 위치로 순간이동시킨 횟수
    property number StatPullSum = 0          -- 점검용: 직접 그리는 동안 서버 위치와의 거리 합 (평균 = 합 / StatLocal)
    -- 점검용 (10-30 좌우 진단): 「화면 이동 방향 ≠ 보이는 좌우」·「공격 중 대상 반대쪽」 프레임·횟수 (LookAudit · LookReport)
    property integer StatLookUnit = 0        -- 소환수 프레임
    property integer StatLookWalk = 0        -- 걷는 그림인데 화면 이동(|vx|>0.4)과 반대쪽을 본 프레임
    property integer StatLookWalkEp = 0      -- 그런 상태가 0.25초 넘게 이어진 횟수
    property integer StatLookWalkBase = 0    -- 걷는 그림 + 옆으로 걷는(|vx|>0.4) 프레임 (분모)
    property integer StatLookAtk = 0         -- 공격 중(CommandState attack)인데 서버 전투 방향(대상 쪽)과 반대를 본 프레임
    property integer StatLookAtkEp = 0       -- 그런 상태가 0.1초 넘게 이어진 횟수
    property integer StatLookAtkBase = 0     -- 공격 중 프레임 (분모)
    property integer StatLookMonWalk = 0     -- 몬스터: 걷는 중 화면 이동과 반대쪽 (넉백 제외)
    property integer StatLookMonWalkEp = 0
    property integer StatLookMonWalkBase = 0
    property integer StatLookMonAtk = 0      -- 몬스터: 공격 중 서버 방향과 반대
    property integer StatLookMonAtkEp = 0
    property integer StatLookMonAtkBase = 0
    property integer StatLookMonKnock = 0    -- 몬스터: 넉백 중 서버 방향(때린 쪽)과 반대 (밀려나며 등 돌림)
    property integer StatLookMonKnockBase = 0
    property integer StatLookAim = 0         -- 소환수 공격 중 화면에서 가장 가까운 몬스터(대역 위치)와 반대쪽을 본 프레임 (서버 값과 무관한 화면 기준 확인)
    property integer StatLookAimBase = 0
    property boolean LookAuditOn = false     -- 점검용: 좌우 진단 계수기를 켠다 (메이커 「후」 측정 때 execute_script로 true · 평소엔 꺼서 프레임마다 몬스터 목록을 훑지 않는다)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 추적표 준비
        self.Recs = {}
        log("[VRF] MotionSmoother ready (interpolation)")
    end

    @ExecSpace("ClientOnly")
    method number ServerNow(number now, number delta)
        -- 서버 시각 추정: ServerElapsedSeconds는 통신 단위로만 바뀌므로, 클라이언트 시계와의 차이를 평활해 매 프레임 이어지는 서버 시각을 만든다
        local off = _UtilLogic.ServerElapsedSeconds - now
        if not self.ClockReady or math.abs(off - self.ClockOffset) > 1 then
            self.ClockOffset = off
            self.ClockReady = true
        elseif off > self.ClockOffset then
            -- 새 통신이 도착한 순간(차이가 커질 때)은 빠르게(0.08초) 따라가고, 통신 사이(차이가 줄어들 때)는 아주 천천히(1.5초).
            -- 시간 기준이라 프레임률과 상관없다 (예전: 프레임당 비율이라 60fps와 300fps에서 따라가는 빠르기가 5배 달랐다)
            self.ClockOffset = self.ClockOffset + (off - self.ClockOffset) * (1 - math.exp(-delta / 0.08))
        else
            self.ClockOffset = self.ClockOffset + (off - self.ClockOffset) * (1 - math.exp(-delta / 1.5))
        end
        return now + self.ClockOffset
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 매 프레임: 서버가 덮어쓴 새 위치를 기록하고, 「지금 − Delay」 시점의 위치를 기록 사이에서 이어 그린다
        if not self.Enabled then return end
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local map = me.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.Map then
            if self.Recs ~= nil then
                for _, old in pairs(self.Recs) do self:DropVis(old) end
            end
            self.Map = map
            self.Recs = {}
            self.ScanTimer = 0
            self.OwnerReady = false
            self.Owners = {}
        end
        self.FrameNo = self.FrameNo + 1
        self.Me = me
        self:OwnerTick(me, delta)
        self.ScanTimer = self.ScanTimer - delta
        if self.ScanTimer <= 0 then
            self.ScanTimer = 0.5
            self:Scan(map, me)
        end
        local snow = self:ServerNow(_UtilLogic.ElapsedSeconds, delta)
        for id, r in pairs(self.Recs) do
            local e = r.e
            if not isvalid(e) or not e.Enable then
                self:DropVis(r)
                self.Recs[id] = nil
            else
                self:Step(r, snow, delta)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Step(any r, number snow, number delta)
        -- 개체 하나: 새 기록 감지 → 그릴 시점의 위치 계산 → 위치 쓰기
        -- (10-10 5차 QA: 액트 1·2 모두 아직 끊긴다. 메이커에서는 서버·클라 스크립트 부하가 원인이 아님을 확인 →
        --  실제 서버의 들쭉날쭉한 도착에 맞춰 세 가지를 보강. 모의 실험(20Hz·흔들림 120ms·몰림 8%)에서 멈춘 프레임 2.3% → 1.5%, 속도 오차 0.33 → 0.21)
        --   · 기록 시각 다듬기: 걷는 중이면 「이동 거리 ÷ 평균 속도」로 간격을 추정해 도착 흔들림이 시각에 섞이지 않게 한다
        --   · 늦춤 = 최근 가장 늦었던 기록 간격 기준 (평균의 1.6배는 가끔 늦는 기록에서 멈칫했다). 서 있는 동안의 빈 간격은 세지 않는다
        --   · 그리는 시계를 따로 두고 목표 시점을 0.85~1.15배 빠르기로 따라간다 (늦춤이 바뀌어도 순간 멈춤·건너뜀이 없다)
        local t = r.e.TransformComponent
        local p = t.WorldPosition
        local buf = r.buf
        if #buf == 0 or math.abs(p.x - r.wx) > 0.0005 or math.abs(p.y - r.wy) > 0.0005 then
            -- 엔진이 서버 위치로 덮어썼다 = 새 기록 (서버 시각으로 찍는다)
            local last = buf[#buf]
            local st = _UtilLogic.ServerElapsedSeconds
            if last ~= nil and ((p.x - last.x) ^ 2 + (p.y - last.y) ^ 2 > self.SnapDistance * self.SnapDistance) then
                -- 순간이동: 기록을 비우고 그 자리에서 다시 시작
                buf = {}
                r.buf = buf
                last = nil
                r.rt = nil
            end
            if last ~= nil then
                if st <= last.t then st = last.t + 0.001 end
                local obs = st - last.t
                local dist = math.sqrt((p.x - last.x) ^ 2 + (p.y - last.y) ^ 2)
                if obs < 0.35 and dist > 0.0001 then
                    local v = dist / obs
                    if r.v <= 0 then r.v = v else r.v = r.v + (math.min(v, r.v * 3) - r.v) * 0.15 end
                    if r.v > 0.2 then
                        local g = math.max(obs * 0.4, math.min(obs * 2.5, 0.7 * (dist / r.v) + 0.3 * obs))
                        local t2 = last.t + g
                        t2 = t2 + (st - t2) * 0.15   -- 실제 서버 시각에서 멀어지지 않게
                        st = math.max(last.t + 0.001, t2)
                    end
                end
                local g = st - last.t
                if g < 0.35 then
                    r.gap = r.gap + (g - r.gap) * 0.1
                    if g > r.peak then r.peak = g end
                end
            end
            table.insert(buf, { t = st, x = p.x, y = p.y })
            while #buf > 12 do table.remove(buf, 1) end
            if r.hold ~= nil and r.hold > 0 then
                -- 기다리던 중 다음 기록이 왔다 = 멈칫 (0.3초 넘게 기다렸으면 실제로 멈췄다 다시 걷는 것)
                if last ~= nil and st - last.t < 0.3 then self.StatHold = self.StatHold + r.hold end
                r.hold = 0
            end
            r.wx, r.wy = p.x, p.y
            self.SampleCount = self.SampleCount + 1
        end
        -- 그릴 시점: 최근 가장 늦은 기록 간격 + 여유 (고르면 0.08초, 들쭉날쭉하면 최대 0.3초). 가장 늦은 간격은 초당 0.05초씩 잊는다
        r.peak = math.max(r.gap, r.peak - delta * 0.05)
        local delay = math.max(0.08, math.min(0.3, r.peak * 1.1 + 0.02))
        local target = snow - delay
        if r.rt == nil or math.abs(target - r.rt) > 0.25 then r.rt = target
        else r.rt = r.rt + delta * (1 + math.max(-0.15, math.min(0.15, (target - r.rt) * 3))) end
        local rt = r.rt
        local x, y
        if rt <= buf[1].t then
            x, y = buf[1].x, buf[1].y
        elseif rt >= buf[#buf].t then
            -- 다음 기록이 아직: 마지막 기록 위치에서 기다린다 (앞서 나가지 않는다)
            x, y = buf[#buf].x, buf[#buf].y
            if r.moving then r.hold = (r.hold or 0) + 1 end
        else
            for i = #buf - 1, 1, -1 do
                local a = buf[i]
                if a.t <= rt then
                    local b = buf[i + 1]
                    local k = (rt - a.t) / math.max(0.0001, b.t - a.t)
                    x, y = a.x + (b.x - a.x) * k, a.y + (b.y - a.y) * k
                    break
                end
            end
            if x == nil then x, y = buf[1].x, buf[1].y end
        end
        local ix, iy = x, y
        if r.unit ~= nil and self.LocalFollow then
            self:FollowLocal(r, delta, x, y)
            x, y = r.outx, r.outy
        end
        local now = _UtilLogic.ElapsedSeconds
        local dt = now - r.vt
        if dt > 0.0005 then
            -- 화면에 그리는 위치의 속도 (평활)
            if r.unit ~= nil then
                local inst = math.sqrt((x - r.dx) ^ 2 + (y - r.dy) ^ 2) / math.max(0.001, delta)   -- 프레임 시간 기준 (ElapsedSeconds 차이는 흔들린다)
                if inst < 30 then
                    if r.lf then
                        if inst > self.StatMaxSpeedLocal then self.StatMaxSpeedLocal = inst end
                    elseif r.blend ~= nil and r.blend > 0 then
                        if inst > self.StatMaxSpeedBlend then self.StatMaxSpeedBlend = inst end
                    elseif inst > self.StatMaxSpeed then self.StatMaxSpeed = inst end
                end
            end
            local k = math.min(1, dt * 12)
            r.vx = r.vx + ((x - r.dx) / dt - r.vx) * k
            r.vy = r.vy + ((y - r.dy) / dt - r.vy) * k
            r.vt = now
            r.dx, r.dy = x, y
        end
        if r.unit ~= nil and r.pdx ~= nil then
            local sx, sy = x - r.pdx, y - r.pdy
            local a = math.sqrt(sx * sx + sy * sy)
            local b = math.sqrt(r.psx * r.psx + r.psy * r.psy)
            if a > 0.002 and b > 0.002 and sx * r.psx + sy * r.psy < -0.3 * a * b then self.StatReverse = self.StatReverse + 1 end
            if a > 0.002 then r.psx, r.psy = sx, sy end
        end
        if r.unit ~= nil then
            if r.psx == nil then r.psx, r.psy = 0, 0 end
            r.pdx, r.pdy = x, y
        end
        -- 좌우·그림을 먼저 정한다 (좌우를 바꾸는 프레임에 그림 자식 위치가 거울처럼 반대쪽으로 한 번 튀지 않게)
        if r.moving then self.StatMoving = self.StatMoving + 1 end
        local speed = math.sqrt(r.vx * r.vx + r.vy * r.vy)
        if r.moving and speed < self.MoveOff then r.moving = false
        elseif not r.moving and speed > self.MoveOn then r.moving = true end
        if r.unit ~= nil then self:WalkStep(r, delta, ix, iy) end
        r.lastDelta = delta
        if r.unit ~= nil then self:LookUnit(r, t, delta) elseif r.monster then self:LookMonster(r) end
        self:LookAudit(r, t, delta)
        if self.UseProxy and (r.unit ~= nil or (r.monster and self.MonsterProxy)) then
            -- 소환수·몬스터: 루트 위치는 서버 값 그대로 두고, 맵 아래 대역(MSVis)을 원하는 위치에 그린다
            if self:PlaceVis(r, x, y, p, t) then
                r.wx, r.wy = p.x, p.y
            elseif math.abs(x - r.wx) > 0.0001 or math.abs(y - r.wy) > 0.0001 then
                t.WorldPosition = Vector3(x, y, p.z)
                r.wx, r.wy = x, y
            end
        elseif math.abs(x - r.wx) > 0.0001 or math.abs(y - r.wy) > 0.0001 then
            t.WorldPosition = Vector3(x, y, p.z)
            r.wx, r.wy = x, y
            self.DrawCount = self.DrawCount + 1
        end
    end

    @ExecSpace("ClientOnly")
    method any OwnerState(Entity owner, number delta)
        -- 주인 한 명의 화면 위치·속도·걷는 방향 (프레임마다 한 번만 계산). 내 캐릭터는 내가 움직인 위치,
        -- 파티원은 내 화면에 그려지는 위치 — 둘 다 그 주인의 소환수를 화면에서 직접 따라가게 할 때 쓴다
        if self.Owners == nil then self.Owners = {} end
        local o = self.Owners[owner.Id]
        if o == nil then
            o = { ready = false, px = 0, py = 0, vx = 0, vy = 0, speed = 0, dx = 1, dy = 0, frame = -1 }
            self.Owners[owner.Id] = o
        end
        if o.frame == self.FrameNo then return o end
        o.frame = self.FrameNo
        local p = owner.TransformComponent.WorldPosition
        if not o.ready or delta <= 0 then
            o.px, o.py = p.x, p.y
            o.vx, o.vy, o.speed = 0, 0, 0
            o.ready = true
            return o
        end
        local vx, vy = (p.x - o.px) / delta, (p.y - o.py) / delta
        if vx * vx + vy * vy > 100 then vx, vy = 0, 0 end   -- 순간이동
        local k = 1 - math.exp(-delta * 15)
        o.vx = o.vx + (vx - o.vx) * k
        o.vy = o.vy + (vy - o.vy) * k
        o.px, o.py = p.x, p.y
        local sp = math.sqrt(o.vx * o.vx + o.vy * o.vy)
        o.speed = sp
        if sp > 0.3 then o.dx, o.dy = o.vx / sp, o.vy / sp end
        return o
    end

    @ExecSpace("ClientOnly")
    method void OwnerTick(Entity me, number delta)
        -- 내 캐릭터 상태 (점검용 Owner* 값으로도 남긴다)
        local o = self:OwnerState(me, delta)
        self.OwnerPX, self.OwnerPY = o.px, o.py
        self.OwnerVX, self.OwnerVY, self.OwnerSpeed = o.vx, o.vy, o.speed
        self.OwnerDX, self.OwnerDY = o.dx, o.dy
        self.OwnerReady = o.ready
    end

    @ExecSpace("ClientOnly")
    method void FollowLocal(any r, number delta, number ix, number iy)
        -- 소환수가 따라가기·집결 중이면 화면 위치를 직접 움직인다 (내 소환수·파티원 소환수 모두 — 9차 QA: 파티원 것도 같게).
        -- 주인의 내 화면 위치를 기준으로 서버와 같은 대형 규칙을 계산한다. 아니면 보간 위치 (넘어갈 때는 0.3초 이상에 걸쳐)
        r.outx, r.outy = ix, iy
        ---@type ShadowUnit
        local unit = r.unit
        if not isvalid(unit) then return end
        local owner = unit.OwnerPlayer
        if not isvalid(owner) or owner.CurrentMap ~= self.Map then return end
        r.ost = self:OwnerState(owner, delta)
        r.owner = owner
        local st = unit.CommandState
        local last = r.buf[#r.buf]
        if (st == "follow" or st == "rally") and last ~= nil and delta > 0 and delta < 0.25 then
            if not r.lf then
                -- 지금 화면 위치·속도에서 이어 간다 (r.wx는 이번 프레임에 서버 위치로 바뀌었을 수 있어 마지막으로 그린 r.dx를 쓴다)
                r.lf = true
                self.StatSwitch = self.StatSwitch + 1
                r.fx, r.fy = r.dx, r.dy
                r.fvx, r.fvy = r.vx, r.vy
                r.fmove = math.sqrt(r.vx * r.vx + r.vy * r.vy) > 0.3
                r.blend = 0
            end
            self:FollowMove(r, unit, delta)
            -- 판정은 서버 위치: 많이 벌어지면 조금씩 당기고, 순간이동(끈 거리)이면 바로 옮긴다
            local ex, ey = last.x - r.fx, last.y - r.fy
            local e = math.sqrt(ex * ex + ey * ey)
            if e > self.StatMaxPull then self.StatMaxPull = e end
            self.StatPullSum = self.StatPullSum + e
            if e > self.SnapDistance then
                self.StatSnap = self.StatSnap + 1
                r.fx, r.fy = last.x, last.y
                r.fvx, r.fvy = 0, 0
            elseif e > self.FollowSlack then
                local k = math.min(1, delta * 3) * (e - self.FollowSlack) / e
                r.fx, r.fy = r.fx + ex * k, r.fy + ey * k
            end
            r.outx, r.outy = r.fx, r.fy
            self.StatLocal = self.StatLocal + 1
            return
        end
        if r.lf then
            -- 사냥 시작 등: 직접 그리던 위치와 보간 위치의 차이를 줄인다 (0.3초, 차이가 크면 초당 2칸을 넘지 않게 더 길게)
            r.lf = false
            self.StatSwitch = self.StatSwitch + 1
            r.bx, r.by = r.fx - ix, r.fy - iy
            r.blend = 1
            r.bdur = math.max(0.3, math.sqrt(r.bx * r.bx + r.by * r.by) / 2)
        end
        if r.blend ~= nil and r.blend > 0 then
            r.blend = math.max(0, r.blend - delta / (r.bdur or 0.3))
            local w = r.blend * r.blend * (3 - 2 * r.blend)
            r.outx, r.outy = ix + r.bx * w, iy + r.by * w
        end
    end

    @ExecSpace("ClientOnly")
    method void FollowMove(any r, ShadowUnit unit, number delta)
        -- ShadowUnit 서버 따라가기와 같은 규칙을 내 캐릭터의 화면 위치로 매 프레임 계산한다
        if r.flag == nil then
            -- 소환수마다 반응·걸음이 조금씩 달라 줄맞춰 걷지 않는다 (서버 FollowLag·SpeedJitter와 같은 범위)
            r.flag = 4.5 + _UtilLogic:RandomDouble() * 6
            r.fjit = 0.93 + _UtilLogic:RandomDouble() * 0.14
        end
        local ost = r.ost
        local op = r.owner.TransformComponent.WorldPosition
        if r.osx == nil or (op.x - r.osx) ^ 2 + (op.y - r.osy) ^ 2 > 9 then
            r.osx, r.osy = op.x, op.y
        else
            local k = 1 - math.exp(-r.flag * delta)
            r.osx, r.osy = r.osx + (op.x - r.osx) * k, r.osy + (op.y - r.osy) * k
        end
        local ox, oy = r.osx, r.osy
        -- 대형 자리 (ShadowUnit.FormationSlot): 전사는 앞, 마법사는 뒤, 그림자는 고정 위치
        local sx, sy
        if unit.Kind == "shadow" then
            sx, sy = ox + unit.FormationOffset.x, oy + unit.FormationOffset.y
        else
            -- 대형 방향은 서버 값(ShadowUnit.OwnerFacing, 동기화)을 그대로 쓴다
            -- (8차 QA 점검: 클라이언트가 따로 추측하니 서버와 반대 방향이 되어 서버 위치로 당기는 힘과 맞서 주인 위에 뭉쳤다)
            local of = unit.OwnerFacing
            local fm = math.sqrt(of.x * of.x + of.y * of.y)
            local fx, fy = 1, 0
            if fm > 0.05 then fx, fy = of.x / fm, of.y / fm end
            local row = unit.FormationIndex // 3
            local lane = unit.FormationIndex % 3 - 1
            local depth = 0.95 + row * 0.42
            if unit.Kind == "mage" then depth = -1.2 - row * 0.45 end
            if unit.Kind == "revive" then depth = 0.35 + row * 0.6 end
            sx = ox + fx * depth - fy * (lane * 0.6)
            sy = oy + fy * depth + fx * (lane * 0.6)
        end
        local w = unit.Wander
        sx, sy = sx + w.x, sy + w.y
        -- 막힌 자리는 주인 쪽으로 당긴 빈 칸 (ShadowUnit.FreeSlot)
        local memo = _Util:TerrainMemo(self.Map)
        if memo ~= nil and _Util:CellBlocked(memo, Vector2(sx, sy)) then
            local ax, ay = ox + (sx - ox) * 0.7, oy + (sy - oy) * 0.7
            if _Util:CellBlocked(memo, Vector2(ax, ay)) then
                ax, ay = ox + (sx - ox) * 0.4, oy + (sy - oy) * 0.4
                if _Util:CellBlocked(memo, Vector2(ax, ay)) then ax, ay = ox, oy end
            end
            sx, sy = ax, ay
        end
        local px, py = r.fx, r.fy
        local tx, ty = sx - px, sy - py
        local dist = math.sqrt(tx * tx + ty * ty)
        local ownerMoving = ost.speed > 0.3
        -- 출발 0.6칸 · 멈춤 0.2칸, 주인이 걷는 동안은 멈추지 않는다 (ShadowUnit과 같다)
        local follow = (r.fmove and (dist > 0.2 or ownerMoving)) or (not r.fmove and dist > 0.6)
        r.fmove = follow
        local dvx, dvy = 0, 0
        if follow then
            local mult = math.max(0.75, math.min(1.3, 0.75 + 0.35 * dist)) * r.fjit
            local base = unit.BaseSpeed
            if base <= 0 and isvalid(unit.Entity.MovementComponent) then base = unit.Entity.MovementComponent.InputSpeed end
            local world = base * self.SpeedScale
            local ax, ay = tx, ty
            if ownerMoving then
                -- 주인 속도의 1.0~1.6배까지 내서 앞자리에 닿고, 주인 몸은 옆으로 비켜 돈다 (ShadowUnit 따라가기와 같다)
                if world > 0.05 then mult = math.max(mult, math.min(unit.PaceMax, ost.speed * math.min(1.6, 1 + 0.5 * dist) / world)) end
                local pass = unit:PassOwner(Vector2(px, py), Vector2(op.x, op.y), Vector2(sx, sy), Vector2(ost.dx, ost.dy))
                ax, ay = ax + ost.dx * 0.3 + pass.x, ay + ost.dy * 0.3 + pass.y
            end
            local am = math.sqrt(ax * ax + ay * ay)
            if am > 0.001 then
                local speed = world * mult
                -- 주인이 서 있으면 자리 앞에서 서서히 선다 (서버는 0.2칸에서 바로 서지만 화면은 부드럽게)
                if not ownerMoving then speed = speed * math.min(1, 0.35 + dist / 0.45) end
                dvx, dvy = ax / am * speed, ay / am * speed
            end
        end
        -- 방향·빠르기는 약 0.08초에 걸쳐 바꾼다 (꺾을 때 곡선, 출발·멈춤도 부드럽게)
        local k = 1 - math.exp(-delta * 12)
        r.fvx, r.fvy = r.fvx + (dvx - r.fvx) * k, r.fvy + (dvy - r.fvy) * k
        local nx, ny = px + r.fvx * delta, py + r.fvy * delta
        -- 벽: 막히면 한 축으로 미끄러지고, 그래도 막히면 그 자리
        if memo ~= nil and (nx ~= px or ny ~= py) and _Util:CellBlocked(memo, Vector2(nx, ny)) then
            if not _Util:CellBlocked(memo, Vector2(nx, py)) then ny = py r.fvy = 0
            elseif not _Util:CellBlocked(memo, Vector2(px, ny)) then nx = px r.fvx = 0
            else nx, ny = px, py r.fvx, r.fvy = 0, 0 end
        end
        r.fx, r.fy = nx, ny
    end

    @ExecSpace("ClientOnly")
    method string FrameClip(any r, string clip)
        -- 소환수의 서기·걷기·공격 그림이 프레임 몬스터(코덱스 그림, data/monster_frames.csv)의 첫 프레임이면 그 동작 프레임을 시간에 맞춰 넘긴다.
        -- (10-13 사용자 지적: 해골 전사 소환수가 걸을 때 걷는 프레임 없이 미끄러져 날아다니는 것처럼 보였다 — 서버는 첫 프레임 한 장만 준다)
        if self.FrameIndex == nil then
            self.FrameIndex = {}
            _GameData:GetMonsterFrames("")   -- 표가 아직 안 만들어졌으면 만든다 (Ensure)
            for key, set in pairs(_GameData.MonsterFrames or {}) do
                for _, act in ipairs({ "stand", "move", "attack" }) do
                    local f = set[act]
                    if f ~= nil and f.r ~= nil and #f.r > 1 and self.FrameIndex[f.r[1]] == nil then self.FrameIndex[f.r[1]] = { f = f, act = act } end
                end
                -- 공격: 서버는 타격 프레임 한 장(공격 클립)을 공격 시작에 넣는다 → 그 장을 보면 공격 프레임 전체를 처음부터 한 번 (10-24 사용자).
                -- 타격 프레임이 서버의 실제 피해 시점(ShadowUnit.AttackWindup)에 오도록 시간을 줄인다
                local a = set.attack
                if a ~= nil and a.r ~= nil and #a.r > 1 and a.s ~= nil and a.s > 1 and self.FrameIndex[a.r[a.s]] == nil then
                    local impact = 0
                    for i = 1, a.s - 1 do impact = impact + (a.d[i] or 0) end
                    self.FrameIndex[a.r[a.s]] = { f = a, act = "attack", scale = impact > 0 and (impact / self.AttackWindup) or 1 }
                end
                -- 거인 3종 한 번 동작 (10-30 갈래 E · ShadowUnit.GiantPlay가 첫 칸을 건다): 기술·피격·갈라짐을 그 칸부터 납품 시간 그대로 한 번
                if string.sub(tostring(key), 1, 6) == "giant_" then
                    for _, act in ipairs({ "skill", "hit", "split" }) do
                        local g = set[act]
                        if g ~= nil and g.r ~= nil and #g.r > 1 and self.FrameIndex[g.r[1]] == nil then self.FrameIndex[g.r[1]] = { f = g, act = act } end
                    end
                end
            end
        end
        local hit = self.FrameIndex[clip]
        if hit == nil then
            r.frameAct = nil
            return clip
        end
        local now = _UtilLogic.ElapsedSeconds
        if r.frameAct ~= clip then
            r.frameAct = clip
            r.frameAt = now
        end
        local f = hit.f
        local total = 0
        for _, d in ipairs(f.d) do total = total + d end
        if total <= 0 then return clip end
        local t = (now - r.frameAt) * (hit.scale or 1)
        if f.loop then t = t % total elseif t >= total then return f.r[#f.r] end
        for i, d in ipairs(f.d) do
            if t < d then return f.r[i] end
            t = t - d
        end
        return f.r[#f.r]
    end

    @ExecSpace("ClientOnly")
    method boolean PlaceVis(any r, number x, number y, Vector3 p, TransformComponent t)
        -- 10-10 6차 QA(움직이면서 뒤로 갔다 앞으로 갔다 껌뻑껌뻑): 서버 위치가 올 때마다 엔진이 루트 위치를 덮어쓰고, 그 프레임은
        -- 서버 위치(뒤)가 그대로 화면에 나왔다 (메이커는 매 프레임 덮어써 루트에 쓴 위치가 아예 안 보였다 — 띄워 그리기로 확인).
        -- 루트의 몸 그림·발밑 원·체력 막대는 내 화면에서만 끄고, 맵 아래 클라이언트 전용 대역(MSVis)이 그 자리를 대신 그린다.
        -- (7차 QA: 대역을 루트의 자식으로 두니 서버가 루트 위치·좌우·클립을 바꿀 때마다 대역도 한 프레임씩 끌려가 여전히 껌뻑였다
        --  → 대역은 맵에 따로 두고 위치·좌우·클립을 모두 클라이언트가 정한다. 서버 값은 색·재생 속도·공격 같은 다른 클립만 따른다)
        local e = r.e
        local src = e.SpriteRendererComponent
        if not isvalid(src) or not isvalid(self.Map) then return false end
        local vis = r.vis
        if vis == nil or not isvalid(vis) then
            -- artsprite 모델의 기본 그림은 모래 바닥(3b9c…)이라, 만들자마자 같은 프레임에 그림을 바꾼다
            -- (7차 QA: 체력 막대 대역의 그림을 ""로 비웠더니 기본 모래 바닥이 그대로 나와 소환수마다 모래 네모·불러오는 중 원이 따라다녔다)
            vis = _SpawnService:SpawnByModelId("artsprite", "MSVis", Vector3(x, y, p.z), self.Map)
            if isvalid(vis) then vis.SpriteRendererComponent.SpriteRUID = src.SpriteRUID end
            if not isvalid(vis) then
                self.UseProxy = false
                log_warning("[MotionSmoother] 그림 대역을 만들 수 없어 루트 위치로 그린다")
                return false
            end
            r.vis = vis
            -- 발밑 원: 모델 자식 AllyRing과 같은 그림을 대역 아래에
            local ring = e:GetChildByName("AllyRing")
            if isvalid(ring) then
                r.ring = ring
                local rc = _SpawnService:SpawnByModelId("artsprite", "MSVisRing", Vector3(x, y, p.z), vis)
                if isvalid(rc) then
                    rc.SpriteRendererComponent.SpriteRUID = ring.SpriteRendererComponent.SpriteRUID
                    r.visRing = rc
                    rc.TransformComponent.Position = ring.TransformComponent.Position
                end
            end
            -- 체력 막대: 대역 아래 픽셀 막대 (ShadowUnit.UpdateHpBar가 HpBarAlt에 그린다). 몬스터는 머리 위 막대가 없다
            local bar = r.unit ~= nil and _SpawnService:SpawnByModelId("artsprite", "MSVisBar", Vector3(x, y, p.z), vis) or nil
            if bar ~= nil and isvalid(bar) then
                -- 막대는 픽셀 그림만: 기본 그림(모래 바닥) 그리기를 아예 끈다
                bar.SpriteRendererComponent.Enable = false
                if not isvalid(bar.PixelRendererComponent) then bar:AddComponent("PixelRendererComponent") end
                if isvalid(bar.PixelRendererComponent) then
                    r.visBar = bar
                    local old = e:GetChildByName("HpBar")
                    if isvalid(old) then old:SetEnable(false, false, false) end
                    if isvalid(r.unit) then
                        r.unit.HpBarAlt = bar
                        r.unit.HpBarReady = false
                    end
                end
            end
            -- 발밑 그림자: 몸체(Kinematicbody)가 그리는 그림자는 서버 위치에 붙어 대역과 따로 놀았다 (8차 QA)
            -- → 내 화면에서는 끄고, 같은 색·크기의 타원을 대역 아래 픽셀로 그린다
            local body = e.KinematicbodyComponent
            if isvalid(body) and body.EnableShadow then
                local sh = _SpawnService:SpawnByModelId("artsprite", "MSVisShadow", Vector3(x, y, p.z), vis)
                if isvalid(sh) then
                    sh.SpriteRendererComponent.Enable = false
                    if not isvalid(sh.PixelRendererComponent) then sh:AddComponent("PixelRendererComponent") end
                    local pix = sh.PixelRendererComponent
                    if isvalid(pix) then
                        pix:ResetWithColors(self.ShadowW, self.ShadowH, self:ShadowPixels(body.ShadowColor))
                        r.visShadow = sh
                        r.shadowSize = body.ShadowSize
                        r.shadowOffset = body.ShadowOffset
                        body.EnableShadow = false
                    else
                        sh:Destroy()
                    end
                end
            end
            -- 이름표 (야영지 「내 소환수」 · 파티원 이름): 루트에 두면 서버 위치에 붙어 몸·체력 막대보다 늦게 따라왔다 (10-11 QA)
            -- → 대역에 같은 이름표를 달고 루트 이름표는 끈다. ShadowUnit.RefreshView가 TagAlt에 이름·색·켜기를 쓴다
            local tag = e.NameTagComponent
            if r.unit ~= nil and isvalid(tag) then
                if not isvalid(vis.NameTagComponent) then vis:AddComponent("NameTagComponent") end
                local vtag = vis.NameTagComponent
                if isvalid(vtag) then
                    vtag.NameTagRUID = tag.NameTagRUID
                    vtag.FontSize = tag.FontSize
                    vtag.OffsetY = tag.OffsetY
                    vtag.FontOffset = tag.FontOffset
                    vtag.Bold = tag.Bold
                    vtag.Name = tag.Name
                    vtag.FontColor = tag.FontColor
                    vtag.Enable = tag.Enable
                    tag.Enable = false
                    r.unit.TagAlt = vtag
                end
            end
            r.visSign = nil
        end
        if src.Enable then src.Enable = false end
        if vis.Visible ~= e.Visible then vis:SetVisible(e.Visible, false, false) end
        if r.ring ~= nil and isvalid(r.ring) and r.visRing ~= nil and r.ring.Enable then r.ring:SetEnable(false, false, false) end
        -- 그림: 클립(서기/걷기는 LookUnit이 정한 r.visClip)·색·재생 속도·정렬
        local dst = vis.SpriteRendererComponent
        local clip = self:FrameClip(r, r.visClip or src.SpriteRUID)
        if dst.SpriteRUID ~= clip then dst.SpriteRUID = clip end
        local c, d = src.Color, dst.Color
        -- 다른 플레이어의 소환수는 조금 투명하게 (10-24 팀원: 4명 파티에서 서로 소환수가 구분이 안 됐다)
        if r.unit ~= nil and isvalid(r.unit.OwnerPlayer) and r.unit.OwnerPlayer ~= _UserService.LocalPlayer then
            c = Color(c.r, c.g, c.b, c.a * self.OtherSummonAlpha)
        end
        -- 교전 중인 소환수는 톤을 낮춰 적과 내 캐릭터가 떠오르게 (클라이언트 신호만 — ShadowUnit.TrackCombat · 10-28 F5 B-1)
        if r.unit ~= nil and isvalid(r.unit) and r.unit.ViewCombat then c = Color(c.r * 0.72, c.g * 0.72, c.b * 0.72, c.a) end
        if c.r ~= d.r or c.g ~= d.g or c.b ~= d.b or c.a ~= d.a then dst.Color = c end
        if dst.PlayRate ~= src.PlayRate then dst.PlayRate = src.PlayRate end
        local flipX = src.FlipX
        if r.monster and r.visFlip ~= nil then flipX = r.visFlip end
        if dst.FlipX ~= flipX then dst.FlipX = flipX end
        if dst.SortingLayer ~= src.SortingLayer then dst.SortingLayer = src.SortingLayer end
        if dst.OrderInLayer ~= src.OrderInLayer then dst.OrderInLayer = src.OrderInLayer end
        -- 크기는 본체 그대로, 좌우는 LookUnit이 정한 방향
        local sc = t.Scale
        local sign = r.visSignWant or (sc.x < 0 and -1 or 1)
        local vt = vis.TransformComponent
        vt.Scale = Vector3(math.abs(sc.x) * sign, math.abs(sc.y), sc.z)
        vt.WorldPosition = Vector3(x, y, p.z)
        if r.monster then self:PlaceAura(r, vis, dst, sc) end
        if r.visRing ~= nil and isvalid(r.visRing) and isvalid(r.ring) then
            local a, b = r.ring.SpriteRendererComponent, r.visRing.SpriteRendererComponent
            if b.SpriteRUID ~= a.SpriteRUID then b.SpriteRUID = a.SpriteRUID end
            local rc1, rc2 = a.Color, b.Color
            if rc1.r ~= rc2.r or rc1.g ~= rc2.g or rc1.b ~= rc2.b or rc1.a ~= rc2.a then b.Color = rc1 end
            if b.SortingLayer ~= a.SortingLayer then b.SortingLayer = a.SortingLayer end
            if b.OrderInLayer ~= a.OrderInLayer then b.OrderInLayer = a.OrderInLayer end
            local rs = r.ring.TransformComponent.Scale
            r.visRing.TransformComponent.Scale = Vector3(math.abs(rs.x), math.abs(rs.y), rs.z)
        end
        if r.visShadow ~= nil and isvalid(r.visShadow) then
            -- 그림자 타원: 몸체 그림자와 같은 크기(ShadowSize × 개체 크기)
            local px, py = math.max(0.05, math.abs(sc.x)), math.max(0.05, math.abs(sc.y))
            local ss, so = r.shadowSize, r.shadowOffset
            local st = r.visShadow.TransformComponent
            -- 몸체 그림자는 개체 크기만큼 함께 줄어든다 (부모 크기를 되돌리지 않고 좌우만 되돌린다)
            st.Scale = Vector3(ss.x / (self.ShadowW * self.PixelUnit) * sign, ss.y / (self.ShadowH * self.PixelUnit), 1)
            st.Position = Vector3(so.x / px * sign, so.y / py, 0.001)
            local pr = r.visShadow.PixelRendererComponent
            if pr.SortingLayer ~= dst.SortingLayer then pr.SortingLayer = dst.SortingLayer end
            if pr.OrderInLayer ~= dst.OrderInLayer - 1 then pr.OrderInLayer = dst.OrderInLayer - 1 end
        end
        if r.visSign ~= sign then
            -- 좌우가 바뀌면 체력 막대도 다시 (부모의 좌우를 되돌린다)
            r.visSign = sign
            if isvalid(r.unit) then r.unit:UpdateHpBar() end
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method void PlaceAura(any r, Entity vis, SpriteRendererComponent dst, Vector3 sc)
        -- 오오라 변종(변종 우두머리·처형인·바르그)의 발밑 오오라: 대역 아래 원 + 은은한 오오라 입자 (10-12 사용자: 소환수 발밑 원처럼).
        -- 대역(MSVis)의 자식이라 몸과 함께 움직인다. 효과가 바뀌거나 쓰러지면 다시 만들거나 지운다
        if r.traits == nil then r.traits = r.e:GetComponent("script.MonsterTraits") or false end
        if r.mon == nil then r.mon = r.e:GetComponent("script.Monster") or false end
        local effect = r.traits and r.traits:RingKey() or ""
        if r.mon and r.mon.IsDead then effect = "" end
        if effect ~= (r.auraKey or "") then
            r.auraKey = effect
            self:DropAura(r)
            if effect ~= "" then
                local ring = _SpawnService:SpawnByModelId("artsprite", "MSVisAura", vis.TransformComponent.WorldPosition, vis)
                if isvalid(ring) then
                    -- artsprite 기본 그림(모래 바닥)이 보이지 않게 만들자마자 원 그림으로
                    ring.SpriteRendererComponent.SpriteRUID = self.AuraRingRUID
                    local c = r.traits:AuraColor(effect)
                    ring.SpriteRendererComponent.Color = c
                    r.visAura = ring
                    -- 오오라 입자는 오오라 변종만 (기술형 우두머리는 원만)
                    if effect ~= "champion" then r.auraFx = _ParticleService:PlayBasicParticleAttached(BasicParticleType.Aura, ring, Vector3(0, 0.05, 0), 0, Vector3(0.9, 0.9, 1), true, { Color = Color(c.r, c.g, c.b, self.AuraFxAlpha) }) end
                    -- 원 크기: 몸 키에 맞춰 0.95~1.8칸
                    local stats = r.mon and _GameData:GetMonsterStats(r.mon.SourceId) or nil
                    local bh = stats ~= nil and ((stats.bh ~= nil and stats.bh > 0) and stats.bh or stats.h) or 90
                    r.auraSize = math.max(0.95, math.min(1.8, bh / 100))
                end
            end
        end
        local ring = r.visAura
        if ring == nil or not isvalid(ring) then return end
        -- 몸 바로 뒤, 그림자 앞 (그림자는 z 0.001)
        local rs = ring.SpriteRendererComponent
        if rs.SortingLayer ~= dst.SortingLayer then rs.SortingLayer = dst.SortingLayer end
        if rs.OrderInLayer ~= dst.OrderInLayer - 1 then rs.OrderInLayer = dst.OrderInLayer - 1 end
        local px, py = math.max(0.05, math.abs(sc.x)), math.max(0.05, math.abs(sc.y))
        ring.TransformComponent.Scale = Vector3(r.auraSize / px, r.auraSize / py, 1)
        ring.TransformComponent.Position = Vector3(0, 0.03 / py, 0)
    end

    @ExecSpace("ClientOnly")
    method void DropAura(any r)
        if r.auraFx ~= nil and r.auraFx ~= 0 then _ParticleService:RemoveParticle(r.auraFx) end
        r.auraFx = nil
        if r.visAura ~= nil and isvalid(r.visAura) then r.visAura:Destroy() end
        r.visAura = nil
    end

    @ExecSpace("ClientOnly")
    method any ShadowPixels(Color c)
        -- 그림자 타원 픽셀 (가장자리는 옅게). 색마다 한 번만 만든다
        if self.ShadowCache == nil then self.ShadowCache = {} end
        local key = string.format("%.2f,%.2f,%.2f,%.2f", c.r, c.g, c.b, c.a)
        local px = self.ShadowCache[key]
        if px ~= nil then return px end
        px = {}
        local w, h = self.ShadowW, self.ShadowH
        for yy = 1, h do
            for xx = 1, w do
                local dx = (xx - 0.5 - w / 2) / (w / 2)
                local dy = (yy - 0.5 - h / 2) / (h / 2)
                local d = dx * dx + dy * dy
                local a = 0
                if d < 1 then a = c.a * math.min(1, (1 - d) * 2.5) end
                table.insert(px, Color(c.r, c.g, c.b, a))
            end
        end
        self.ShadowCache[key] = px
        return px
    end

    @ExecSpace("ClientOnly")
    method void DropVis(any r)
        -- 추적을 그만둘 때: 루트의 몸 그림·발밑 원·체력 막대를 다시 켜고 대역을 지운다
        if r.vis == nil then return end
        if isvalid(r.e) then
            if isvalid(r.e.SpriteRendererComponent) then r.e.SpriteRendererComponent.Enable = true end
            local old = r.e:GetChildByName("HpBar")
            if isvalid(old) then old:SetEnable(true, false, false) end
        end
        if r.ring ~= nil and isvalid(r.ring) then r.ring:SetEnable(true, false, false) end
        if r.visShadow ~= nil and isvalid(r.e) and isvalid(r.e.KinematicbodyComponent) then r.e.KinematicbodyComponent.EnableShadow = true end
        r.visShadow = nil
        self:DropAura(r)
        r.auraKey = nil
        if isvalid(r.vis) then r.vis:Destroy() end
        r.vis = nil
        r.visRing = nil
        r.visBar = nil
        if isvalid(r.unit) then
            r.unit.HpBarAlt = nil
            r.unit.HpBarReady = false
            r.unit:UpdateHpBar()
            -- 이름표를 루트로 되돌린다 (다음 RefreshView가 루트 이름표에 다시 쓴다)
            r.unit.TagAlt = nil
            r.unit.ViewState = ""
            r.unit:RefreshView()
        end
    end

    @ExecSpace("ClientOnly")
    method void WalkStep(any r, number delta, number ix, number iy)
        -- 소환수의 「실제 걸음」 속도 (10-30 좌우 수정): 서버 위치로 당기는 보정(FollowSlack 당기기·사냥 전환 섞기)은 뺀다.
        -- 직접 따라가기 중이면 FollowMove가 정한 걸음 속도(r.fvx), 아니면 보간 위치(서버 위치를 이어 그린 것)의 속도.
        -- 좌우·서기/걷기 그림은 이 값으로 정한다 (보정 이동을 따라 돌면 등지고 공격·뒤로 걷기가 된다)
        local wx, wy = 0, 0
        if r.lf then
            wx, wy = r.fvx or 0, r.fvy or 0
        elseif r.pix ~= nil and delta > 0 then
            wx, wy = (ix - r.pix) / delta, (iy - r.piy) / delta
            if wx * wx + wy * wy > 900 then wx, wy = r.wvx or 0, r.wvy or 0 end   -- 순간이동·기록 비움은 걸음이 아니다
        end
        r.pix, r.piy = ix, iy
        local k = 1 - math.exp(-math.max(0, delta) * 12)
        r.wvx = (r.wvx or 0) + (wx - (r.wvx or 0)) * k
        r.wvy = (r.wvy or 0) + (wy - (r.wvy or 0)) * k
        local ws = math.sqrt(r.wvx * r.wvx + r.wvy * r.wvy)
        if r.walking and ws < self.MoveOff then r.walking = false
        elseif not r.walking and ws > self.MoveOn then r.walking = true end
    end

    @ExecSpace("ClientOnly")
    method void LookUnit(any r, TransformComponent t, number delta)
        -- 소환수: 좌우 = 크기 x 부호 (그림 기본은 왼쪽), 그림 = 서기/걷기 클립. 화면에서 걷는 동안은 그 방향·걷기, 멈추면 서버 값.
        -- 그림 대역(PlaceVis)을 쓰면 루트는 건드리지 않고 대역에 쓸 값(r.visSignWant·r.visClip)만 정한다
        ---@type ShadowUnit
        local unit = r.unit
        if not isvalid(unit) then return end
        local sprite = unit.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local sc = t.Scale
        local stand, move = unit.StandRUID, unit.MoveRUID
        if self.UseProxy then
            -- 10-30 좌우 수정 (사용자 지적: 뒤를 보며 앞으로 걷기 · 등지고 공격):
            --   · 공격 중(동기화된 CommandState "attack")은 서버 전투 방향 그대로, 바로 — 서버는 공격 직전 StopMove(대상 x)로 대상 쪽을 본다
            --   · 실제로 걷는 중이면 걸음 방향(WalkStep · 보정 이동 제외), 느린 걸음도(FaceMinVX). 거의 세로로 걸으면 지금 방향 유지
            --   · 서 있으면 서버 값
            --   · 걸음·서기로 바꾸는 것은 0.15초 넘게 그 방향일 때만 (껌뻑임 방지). 예전엔 유지 시간을 같은 프레임에 0으로 되돌려
            --     프레임 하나가 0.15초를 넘을 때(멈칫)만 돌아 좌우가 사실상 고정이었다 (메이커 측정 flip=0 · 걷기 46%·공격 44% 반대)
            local srvSign = sc.x < 0 and -1 or 1
            local cur = r.visSignWant or srvSign
            local goal = srvSign
            local instant = false
            if unit.CommandState == "attack" then
                instant = true
            elseif r.walking then
                goal = cur
                local wx, wy = r.wvx or 0, r.wvy or 0
                if math.abs(wx) > self.FaceMinVX and math.abs(wx) >= 0.25 * math.abs(wy) then goal = wx > 0 and -1 or 1 end
            end
            local want = goal
            if goal == cur then
                r.flipT = 0
            elseif instant then
                r.flipT = 0
                self.StatFlip = self.StatFlip + 1
            else
                -- 좌우는 0.15초 넘게 그 방향일 때만 바꾼다 (10-10 6차 QA 껌뻑임)
                r.flipT = (r.flipT or 0) + delta
                if r.flipT < 0.15 then want = cur else r.flipT = 0 self.StatFlip = self.StatFlip + 1 end
            end
            r.visSignWant = want
            local srv = sprite.SpriteRUID
            local clip = srv
            if stand ~= "" and move ~= "" and (srv == stand or srv == move) then clip = r.walking and move or stand end
            r.visClip = clip
            return
        end
        if r.myScaleX == nil or math.abs(sc.x - r.myScaleX) > 0.0001 then r.srvScaleX = sc.x end
        local wantX = r.srvScaleX
        if r.moving and math.abs(r.vx) > 0.2 then wantX = math.abs(sc.x) * (r.vx > 0 and -1 or 1) end
        if wantX ~= nil and wantX * sc.x < 0 then
            r.flipT = (r.flipT or 0) + delta
            if r.flipT < 0.15 then wantX = sc.x end
        else
            r.flipT = 0
        end
        if wantX ~= nil and math.abs(wantX - sc.x) > 0.0001 then
            if wantX * sc.x < 0 then self.StatFlip = self.StatFlip + 1 end
            t.Scale = Vector3(wantX, sc.y, sc.z)
            unit:UpdateHpBar()
        end
        r.myScaleX = wantX
        local cur = sprite.SpriteRUID
        if r.myClip == nil or cur ~= r.myClip then r.srvClip = cur end
        local want = r.srvClip
        if stand ~= "" and move ~= "" and (r.srvClip == stand or r.srvClip == move) then
            want = r.moving and move or stand
        end
        local shown = want ~= nil and want ~= "" and self:FrameClip(r, want) or want
        if shown ~= nil and shown ~= "" and shown ~= cur then sprite.SpriteRUID = shown end
        r.myClip = shown
    end

    @ExecSpace("ClientOnly")
    method void LookMonster(any r)
        -- 몬스터: 좌우 = FlipX (true면 오른쪽). 움직이는 동안만 화면 방향, 멈추면 서버 값(공격 대상 바라보기)
        local sprite = r.e.SpriteRendererComponent
        if not isvalid(sprite) then return end
        if self.UseProxy and self.MonsterProxy then
            -- 대역: 루트는 건드리지 않고 대역 좌우(r.visFlip)만. 공격·넉백 중은 서버 값 바로(대상·때린 쪽을 본다),
            -- 걷는 동안은 화면 방향(느린 걸음도 · 0.15초 유지돼야 바뀜), 멈추면 서버 값.
            -- (10-30: 유지 시간을 같은 프레임에 0으로 되돌려 좌우가 거의 바뀌지 않던 것 — LookUnit과 같은 수정)
            self:MonsterActing(r)
            local srv = sprite.FlipX
            local cur = r.visFlip
            if cur == nil then cur = srv end
            local goal = srv
            local instant = r.mAtk or r.mKnock
            if not instant and r.moving then
                goal = cur
                if math.abs(r.vx) > self.FaceMinVX and math.abs(r.vx) >= 0.25 * math.abs(r.vy) then goal = r.vx > 0 end
            end
            local want = goal
            if goal == cur or instant then
                r.flipT = 0
            else
                r.flipT = (r.flipT or 0) + (r.lastDelta or 0)
                if r.flipT < 0.15 then want = cur else r.flipT = 0 end
            end
            r.visFlip = want
            return
        end
        local cur = sprite.FlipX
        if r.myFlip == nil or cur ~= r.myFlip then r.srvFlip = cur end
        local want = r.srvFlip
        if r.moving and math.abs(r.vx) > 0.2 then want = r.vx > 0 end
        if want ~= nil and want ~= cur then sprite.FlipX = want end
        r.myFlip = want
    end

    @ExecSpace("ClientOnly")
    method void LookAudit(any r, TransformComponent t, number delta)
        -- 점검용 (10-30 좌우 진단): 보이는 좌우가 화면 이동 방향·서버 전투 방향과 어긋난 프레임을 센다 (대역 그리기 중만 · 그리기에는 영향 없음)
        if not self.UseProxy or not self.LookAuditOn then return end
        local vx, vy = r.vx, r.vy
        local side = math.abs(vx) > 0.4 and math.abs(vx) > 0.5 * math.abs(vy)
        local walkBad, atkBad = false, false
        if r.unit ~= nil then
            ---@type ShadowUnit
            local unit = r.unit
            if not isvalid(unit) or r.visSignWant == nil then return end
            self.StatLookUnit = self.StatLookUnit + 1
            local shown = r.visSignWant
            local attacking = unit.CommandState == "attack"
            if attacking then
                self.StatLookAtkBase = self.StatLookAtkBase + 1
                local srv = t.Scale.x < 0 and -1 or 1
                if shown ~= srv then atkBad = true self.StatLookAtk = self.StatLookAtk + 1 end
                -- 화면 기준: 대역 위치에서 가장 가까운 몬스터 대역(2.5칸 안)이 옆으로 0.15칸 넘게 떨어져 있으면 그쪽을 봐야 한다
                local best, bdx = 6.25, nil
                for _, o in pairs(self.Recs) do
                    if o.monster and o.dx ~= nil then
                        local ddx, ddy = o.dx - r.dx, o.dy - r.dy
                        local d2 = ddx * ddx + ddy * ddy
                        if d2 < best then best, bdx = d2, ddx end
                    end
                end
                if bdx ~= nil and math.abs(bdx) > 0.15 then
                    self.StatLookAimBase = self.StatLookAimBase + 1
                    if shown ~= (bdx > 0 and -1 or 1) then self.StatLookAim = self.StatLookAim + 1 end
                end
            elseif side and unit.MoveRUID ~= "" and r.visClip == unit.MoveRUID then
                self.StatLookWalkBase = self.StatLookWalkBase + 1
                if shown ~= (vx > 0 and -1 or 1) then walkBad = true self.StatLookWalk = self.StatLookWalk + 1 end
            end
            r.auW = walkBad and (r.auW or 0) + delta or 0
            if walkBad and r.auW >= 0.25 and not r.auWE then r.auWE = true self.StatLookWalkEp = self.StatLookWalkEp + 1 end
            if not walkBad then r.auWE = false end
            r.auA = atkBad and (r.auA or 0) + delta or 0
            if atkBad and r.auA >= 0.1 and not r.auAE then r.auAE = true self.StatLookAtkEp = self.StatLookAtkEp + 1 end
            if not atkBad then r.auAE = false end
            return
        end
        if not r.monster or r.visFlip == nil then return end
        local sprite = r.e.SpriteRendererComponent
        if not isvalid(sprite) then return end
        self:MonsterActing(r)
        local attacking, knocked = r.mAtk, r.mKnock
        if knocked then
            self.StatLookMonKnockBase = self.StatLookMonKnockBase + 1
            if r.visFlip ~= sprite.FlipX then self.StatLookMonKnock = self.StatLookMonKnock + 1 end
        elseif attacking then
            self.StatLookMonAtkBase = self.StatLookMonAtkBase + 1
            if r.visFlip ~= sprite.FlipX then atkBad = true self.StatLookMonAtk = self.StatLookMonAtk + 1 end
        elseif side and r.moving then
            self.StatLookMonWalkBase = self.StatLookMonWalkBase + 1
            if r.visFlip ~= (vx > 0) then walkBad = true self.StatLookMonWalk = self.StatLookMonWalk + 1 end
        end
        r.auW = walkBad and (r.auW or 0) + delta or 0
        if walkBad and r.auW >= 0.25 and not r.auWE then r.auWE = true self.StatLookMonWalkEp = self.StatLookMonWalkEp + 1 end
        if not walkBad then r.auWE = false end
        r.auA = atkBad and (r.auA or 0) + delta or 0
        if atkBad and r.auA >= 0.1 and not r.auAE then r.auAE = true self.StatLookMonAtkEp = self.StatLookMonAtkEp + 1 end
        if not atkBad then r.auAE = false end
    end

    @ExecSpace("ClientOnly")
    method void MonsterActing(any r)
        -- 몬스터가 지금 공격 중인가(동기화된 AttackEpoch가 바뀐 뒤 AttackAnimationSeconds 동안) · 넉백 중인가(동기화된 KnockUntil) — 둘 다 서버 값 그대로
        if r.matk == nil then r.matk = r.e:GetComponent("script.MonsterAttack") or false end
        if r.mst == nil then r.mst = r.e:GetComponent("script.MonsterStatus") or false end
        local now = _UtilLogic.ElapsedSeconds
        local attacking = false
        if r.matk then
            local ep = r.matk.AttackEpoch
            if r.matkEp == nil then r.matkEp = ep
            elseif ep ~= r.matkEp then
                r.matkEp = ep
                r.matkUntil = now + math.max(0.3, r.matk.AttackAnimationSeconds) + 0.1
            end
            attacking = r.matkUntil ~= nil and now < r.matkUntil
        end
        r.mAtk = attacking
        -- 넉백은 그리는 시점(r.rt, 서버 시각 − 늦춤) 기준: 화면에서 밀려나는 동안 내내 때린 쪽을 본다
        r.mKnock = (r.mst and r.mst.KnockUntil > (r.rt or _UtilLogic.ServerElapsedSeconds)) and true or false
    end

    method void LookReport(string tag)
        -- 점검용: 좌우 진단 수치를 한 줄로 (메이커 execute_script에서 부른다)
        log(string.format("[VRF] look mismatch %s walk=%d attack=%d | unit walkEp=%d/%d frames atkEp=%d frames=%d/%d unitFrames=%d | mon walk=%d/%d ep=%d atk=%d/%d ep=%d knock=%d/%d | aim=%d/%d | flip=%d",
            tag, self.StatLookWalk, self.StatLookAtk, self.StatLookWalkEp, self.StatLookWalkBase, self.StatLookAtkEp, self.StatLookAtk, self.StatLookAtkBase, self.StatLookUnit,
            self.StatLookMonWalk, self.StatLookMonWalkBase, self.StatLookMonWalkEp, self.StatLookMonAtk, self.StatLookMonAtkBase, self.StatLookMonAtkEp, self.StatLookMonKnock, self.StatLookMonKnockBase, self.StatLookAim, self.StatLookAimBase, self.StatFlip))
    end

    method void LookReset()
        -- 점검용: 좌우 진단 수치를 0으로
        self.StatLookUnit = 0 self.StatLookWalk = 0 self.StatLookWalkEp = 0 self.StatLookWalkBase = 0
        self.StatLookAtk = 0 self.StatLookAtkEp = 0 self.StatLookAtkBase = 0
        self.StatLookMonWalk = 0 self.StatLookMonWalkEp = 0 self.StatLookMonWalkBase = 0
        self.StatLookMonAtk = 0 self.StatLookMonAtkEp = 0 self.StatLookMonAtkBase = 0
        self.StatLookMonKnock = 0 self.StatLookMonKnockBase = 0 self.StatLookAim = 0 self.StatLookAimBase = 0 self.StatFlip = 0
    end

    method Entity VisOf(Entity e)
        -- 화면에 실제로 그려지는 몸: 추적 중이면 그림 대역(MSVis), 아니면 루트 그대로 — 표식을 붙일 때 대역에 붙여야 끊기지 않는다 (44-3 고른 그림자·집중 대상)
        if self.Recs == nil or not isvalid(e) then return e end
        local r = self.Recs[e.Id]
        if r ~= nil and r.vis ~= nil and isvalid(r.vis) then return r.vis end
        return e
    end

    method integer VisualMoving(Entity e)
        -- 프레임 애니메이터용: 화면에서 걷는 중이면 1, 멈췄으면 0, 추적하지 않는 개체면 -1
        if self.Recs == nil or not isvalid(e) then return -1 end
        local r = self.Recs[e.Id]
        if r == nil or #r.buf == 0 then return -1 end
        return r.moving and 1 or 0
    end

    @ExecSpace("ClientOnly")
    method void Scan(Entity map, Entity me)
        -- 0.5초마다: 플레이어 근처의 몬스터·소환수를 추적표에 넣고, 멀어진 것은 마지막 서버 위치로 돌려놓고 뺀다
        local mp = me.TransformComponent.WorldPosition
        local seen = {}
        for _, typeName in ipairs({ "script.Monster", "script.ShadowUnit" }) do
            local isUnit = typeName == "script.ShadowUnit"
            for _, comp in ipairs(map:GetChildComponentsByTypeName(typeName, false)) do
                local e = comp.Entity
                if isvalid(e) and e.Enable then
                    local p = e.TransformComponent.WorldPosition
                    local dx, dy = p.x - mp.x, p.y - mp.y
                    if dx * dx + dy * dy <= self.Range * self.Range then
                        local id = e.Id
                        seen[id] = true
                        if self.Recs[id] == nil then
                            self.Recs[id] = { e = e, buf = {}, wx = p.x, wy = p.y, gap = 0.05, peak = 0.05, v = 0, rt = nil, vx = 0, vy = 0, vt = _UtilLogic.ElapsedSeconds, dx = p.x, dy = p.y, moving = false,
                                unit = isUnit and comp or nil, monster = not isUnit }
                        end
                    end
                end
            end
        end
        for id, r in pairs(self.Recs) do
            if not seen[id] then
                local last = r.buf[#r.buf]
                if isvalid(r.e) and last ~= nil then
                    local p = r.e.TransformComponent.WorldPosition
                    if math.abs(p.x - r.wx) < 0.0005 and math.abs(p.y - r.wy) < 0.0005 then
                        r.e.TransformComponent.WorldPosition = Vector3(last.x, last.y, p.z)
                    end
                end
                self:DropVis(r)
                self.Recs[id] = nil
            end
        end
    end
end
