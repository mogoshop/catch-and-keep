-- 맵 사이 포털. 반응 구역 안에서 Space(PC)·「들어가기」 단추(모바일)를 누르면 지정한 맵·위치로 보낸다 (11-05 사용자: 지나가다 이동하는 일이 많았다 → 밟기만으로는 이동하지 않는다).
--   클라이언트 NpcWindow가 구역 안 포털을 찾아 안내를 띄우고, 입력이 오면 PlayerTravel.RequestGate → 서버가 구역·권한을 다시 보고 TryEnter.
-- 귀환 포털(OwnerUserId 지정)은 주인과 파티원이 쓴다. 마을 쪽(OwnerCloses)은 주인이 지나가면 사냥터 짝과 함께 닫힌다 (PlayerTravel.ClosePortal).
@Component
script WarpGate extends Component

    @Sync
    property string TargetMap = "wasteland"
    property Vector2 TargetPos = Vector2(0, 0)
    @Sync
    property string Label = ""
    @Sync
    property number Radius = 0.6
    -- 사각 반응 구역 반폭·반높이(월드 칸). 0이면 예전처럼 원(Radius)만. 문 칸이 여러 칸인 출구만 맵 빌드가 넣는다 (11-01 마을 남문 3칸 — 설계서 gateBox)
    --   원(Radius) 안이거나 이 사각형 안이면 넘어간다 — 원 판정은 그대로라 가운데 칸은 예전과 같고, 옆 칸만 더해진다
    property Vector2 TriggerBox = Vector2(0, 0)
    property number Cooldown = 2
    @Sync
    property string OwnerUserId = ""
    @Sync
    property string OwnerName = ""            -- 귀환 포털 주인 캐릭터 이름 (마을 이름표 두 줄 「주인 / 가는 곳」 · 11-05)
    property boolean OwnerCloses = true       -- 주인이 지나가면 닫힌다 (귀환 짝 중 사냥터 쪽은 false — 주인이 마을로 갔다가 돌아올 길)
    property string SealGate = ""             -- 봉인 문: 이 문지기(몬스터 sourceId)를 쓰러뜨린 사람만 지난다 (PlayerQuest.GatePassed, gate 의뢰 · 10-23 옥좌의 문)
    property table SealWarned = {}

    property table LastWarp = {}
    property number Reach = 0.35              -- 안내·입력 구역: 이동 반경(Radius·TriggerBox) 둘레 이만큼 더 (밟는 자동 이동이 없어져 조금 넉넉하게)
    property number ServerSlack = 0.6         -- 서버 확인 여유 (플레이어 → 서버 위치 동기화 10Hz라 서버 위치가 늦다)
    @Sync
    property string Mist = ""                 -- 곁가지 입구·층 계단 포털 (10-28 사용자 A안): "r,g,b" — 구멍에서 피어오르는 안개 색. 비면 안개 없음
    property integer MistFx = 0               -- 클라이언트: 안개 입자

    method void OnBeginPlay()
        -- 서버: 자동 이동 검사 없음 (입력으로만 — TryEnter) / 클라이언트: 입구 안개
        if self:IsServer() then
            self.LastWarp = {}
            if self:HasBox() then
                local p = _Util:Pos2(self.Entity)
                log(string.format("[VRF] WarpGate box ready gate=%s map=%s at=(%.2f,%.2f) half=(%.2f,%.2f) radius=%.2f -> %s", self.Entity.Name, self.Entity.CurrentMap ~= nil and self.Entity.CurrentMap.Name or "?", p.x, p.y, self.TriggerBox.x, self.TriggerBox.y, self.Radius, self.TargetMap))
            end
            return
        end
        self:StartMist()
    end

    method void OnEndPlay()
        -- 안개 정리
        if self.MistFx ~= 0 then _ParticleService:RemoveParticle(self.MistFx) end
        self.MistFx = 0
    end

    @ExecSpace("ClientOnly")
    method void StartMist()
        -- 입구 그림의 어두운 구멍(이 포털 자리)에서 그 액트 색 안개가 피어오른다 — 흐린 소용돌이(포털 그림)와 함께 「들어가는 곳」을 알린다
        if self.Mist == "" or self.MistFx ~= 0 then return end
        local r, g, b = string.match(self.Mist, "([%d%.]+),([%d%.]+),([%d%.]+)")
        if r == nil then return end
        local p = self.Entity.TransformComponent.WorldPosition
        self.MistFx = _ParticleService:PlayBasicParticle(BasicParticleType.RisingSteam, self.Entity, Vector3(p.x, p.y - 0.35, 0), 0, Vector3(0.75, 0.75, 1), true,
            { Color = Color(tonumber(r), tonumber(g), tonumber(b), 0.8), SortingLayer = "MapLayer0", OrderInLayer = 31 })
    end

    method boolean InZone(Vector2 p, number slack)
        -- 반응 구역 안인가 (클라이언트 안내·서버 확인 공용): 원(Radius + Reach + slack) 또는 사각(TriggerBox + Reach + slack)
        local d = p - _Util:Pos2(self.Entity)
        local pad = self.Reach + slack
        if d:Magnitude() <= self.Radius + pad then return true end
        return self:HasBox() and math.abs(d.x) <= self.TriggerBox.x + pad and math.abs(d.y) <= self.TriggerBox.y + pad
    end

    @ExecSpace("ServerOnly")
    method boolean TryEnter(Entity player)
        -- 입력(Space·들어가기)으로 들어간다: 구역(서버 여유 포함) · 재사용 대기 · 권한(CanUse가 막히면 안내) 확인 뒤 Warp
        if not isvalid(player) or player.PlayerComponent == nil or player.CurrentMap ~= self.Entity.CurrentMap then return false end
        if not self:InZone(_Util:Pos2(player), self.ServerSlack) then
            log(string.format("[VRF] WarpGate enter rejected far gate=%s", self.Entity.Name))
            return false
        end
        local id = player.PlayerComponent.UserId
        local now = _UtilLogic.ElapsedSeconds
        if now - (self.LastWarp[id] or -100) <= self.Cooldown then return false end
        if not self:CanUse(player) then return false end
        self.LastWarp[id] = now
        log(string.format("[VRF] WarpGate enter by input gate=%s map=%s -> %s owner=%s", self.Entity.Name, self.Entity.CurrentMap.Name, self.TargetMap, self.OwnerName))
        self:Warp(player)
        return true
    end

    method boolean HasBox()
        -- 사각 반응 구역을 쓰는 출구인가 (반폭·반높이가 둘 다 양수)
        return self.TriggerBox.x > 0 and self.TriggerBox.y > 0
    end

    method boolean CanUse(Entity player)
        -- 귀환 포털은 주인과 같은 파티만 공유한다. 일반 지역 출구는 모두에게 열린다.
        if not isvalid(player) or player.PlayerComponent == nil then return false end
        if self.SealGate ~= "" then
            ---@type PlayerQuest
            local quest = player:GetComponent("script.PlayerQuest")
            if quest ~= nil and not quest:GatePassed(self.SealGate) then
                local id = player.PlayerComponent.UserId
                local now = _UtilLogic.ElapsedSeconds
                if now - (self.SealWarned[id] or -100) > 4 then
                    self.SealWarned[id] = now
                    _Util:Warn("옥좌로 가는 문이 봉인되어 있습니다 — " .. _GameData:GetMonsterName(self.SealGate) .. "를 쓰러뜨리면 열립니다", id)
                end
                return false
            end
        end
        if self.OwnerUserId == "" or player.PlayerComponent.UserId == self.OwnerUserId then return true end
        local owner = _UserService:GetUserEntityByUserId(self.OwnerUserId)
        if not isvalid(owner) then return false end
        local mine = player:GetComponent("script.PlayerSocial")
        local theirs = owner:GetComponent("script.PlayerSocial")
        if mine == nil or theirs == nil or mine.PartyId <= 0 or mine.PartyId ~= theirs.PartyId then
            self:WarnOnce(player, "다른 사람의 귀환 포털입니다 — 같은 파티여야 들어갈 수 있습니다")
            return false
        end
        -- 10-13: 파티원도 그 액트가 열려 있어야 (액트 1 캐릭터가 귀환 포털로 액트 3 보스 방에 따라 들어가 난이도를 여는 무임승차 방지)
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(self.TargetMap))
        ---@type PlayerTravel
        local travel = player:GetComponent("script.PlayerTravel")
        if info ~= nil and travel ~= nil and not travel:ActUnlockedIn(_GameConst:DifficultyOfMap(self.TargetMap), math.floor(info.act or 1)) then return false end
        return true
    end

    method void WarnOnce(Entity player, string text)
        -- Space를 연달아 눌러도 사람마다 4초에 한 번만 알린다 (서버에서만 — 미니맵·이름표의 CanUse 확인은 클라이언트)
        if not self:IsServer() then return end
        local id = player.PlayerComponent.UserId
        local now = _UtilLogic.ElapsedSeconds
        if now - (self.SealWarned[id] or -100) <= 4 then return end
        self.SealWarned[id] = now
        _Util:Warn(text, id)
    end

    @ExecSpace("ServerOnly")
    method void Warp(Entity player)
        -- 직접 호출되는 경우에도 이용 권한과 생존 상태를 다시 확인한다.
        if not self:CanUse(player) or not _Util:IsAlive(player) then return end
        ---@type PlayerTravel
        local travel = player:GetComponent("script.PlayerTravel")
        -- 마을로 가는 포털은 맵에 구워진 좌표 대신 설정의 마을 도착 위치를 쓴다 (출구 바로 위에 내려 안내가 겹치지 않게)
        local pos = self.TargetPos
        if _GameConst:IsTownName(self.TargetMap) then pos = _GameConst:GetTownArrival() end
        if travel ~= nil then travel:Go(self.TargetMap, pos) end
        if self.OwnerUserId ~= "" and self.OwnerCloses and player.PlayerComponent.UserId == self.OwnerUserId then
            if travel ~= nil then
                travel:ClosePortal(0.5)
            else
                _TimerService:SetTimerOnce(function() if isvalid(self.Entity) then self.Entity:Destroy() end end, 0.5)
            end
        end
    end

end
