-- 맵 이벤트 저주받은 상자 (MapEvents가 사냥터에 놓는다): 다가가면 열린다 → 둘레에 매복 무리(정예 우두머리 + chestAmbush)가 솟고,
-- 연 사람에게 최상위 몬스터급 보물을 떨어뜨린다 (개인 보상 — LootSystem.RollDrops). 한 번만 열린다.
-- Sealed = 곁가지 끝방 봉인 상자 (NamedSystem이 놓는다, 14장 §4): 매복 없이 플레이어마다 한 번씩 열린다.
--   그 난이도에서 처음 열면 희귀 장비 + 룬 보장, 이후엔 정예급 보물. NeedKey가 있으면 그 열쇠(의뢰 단계)가 있어야 열린다.
@Component
script CursedChest extends Component

    @Sync
    property boolean Opened = false
    property string Species = ""             -- 매복에 쓸 몬스터 id ("hellhound;fallenimp") — MapEvents가 맵 출현 목록으로 채운다
    property integer Level = 1               -- 매복·보물 레벨 (난이도 가산 포함)
    property number Radius = 1.0
    property integer TimerId = 0
    @Sync
    property string OpenRuid = "205ed4aa96294b0b8e348ef554c50da1"   -- 열린 상자 (코덱스 10-10 · 맵 액트 그림은 MapEvents.Dress가 바꾼다)
    property boolean Road = false            -- 길 위 사건 상자 (기획서 39 #7 A · 설계서 자리): 매복을 그 맵 유입 풀에서 빌린다
    property any Spawner = nil               -- 길 위 사건: 그 맵 MonsterSpawner (BorrowPool · TrackBorrowed)
    @Sync
    property boolean Sealed = false
    property string MapKey = ""              -- 봉인 상자가 놓인 보통 맵 id (첫 개봉 기록·의뢰 판정)
    @Sync
    property string NeedKey = ""             -- 열쇠를 주는 적 sourceId ("headsman" → 의뢰 「목 없는 처형인」 1단계)
    @Sync
    property string OpenedDigest = ";"        -- 이 상자를 연 플레이어 userId (";a;b;")
    property table NoticeAt = {}             -- userId → 다음 「잠김」 안내 시각
    @Sync
    property string RewardRank = ""          -- 심도 층 보상 상자 (DepthDirector): 드롭 표 등급. Sealed와 같이 파티원마다 한 번씩 열린다
    property integer RewardRolls = 1         -- 심도 보상: 그 표로 몇 번 굴리나

    method void OnBeginPlay()
        if self:IsServer() then
            self.TimerId = _TimerService:SetTimerRepeat(function() self:Tick() end, 0.25)
        else
            self.TimerId = _TimerService:SetTimerRepeat(function() self:RefreshView() end, 0.5)
        end
    end

    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    @ExecSpace("ServerOnly")
    method void Tick()
        if self.Sealed then
            for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, _Util:Pos2(self.Entity), self.Radius)) do
                if not string.find(self.OpenedDigest, ";" .. p.PlayerComponent.UserId .. ";", 1, true) then self:OpenSealed(p) end
            end
            return
        end
        if self.Opened then return end
        local p = _Util:PlayersNear(self.Entity.CurrentMap, _Util:Pos2(self.Entity), self.Radius)[1]
        if p ~= nil then self:Open(p) end
    end

    @ExecSpace("ServerOnly")
    method void Open(Entity player)
        self.Opened = true
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        local map = self.Entity.CurrentMap
        local center = _Util:Pos2(self.Entity)
        -- 매복: 상자 둘레에 우두머리 1 + 졸개 N
        local kinds = {}
        for id in string.gmatch(self.Species, "[^;]+") do table.insert(kinds, id) end
        if #kinds == 0 then table.insert(kinds, "skelwarrior") end
        local count = math.floor(_GameData.chestAmbush) + 1
        -- 길 위 사건 상자: 매복은 그 맵 유입 풀에서 빌린다 (모자란 몫만 맵 종류로 새로 — 기획서 39 #7 「이벤트 몹은 유입 풀에서 빼서 씀」)
        ---@type MonsterSpawner
        local spawner = self.Spawner
        local lent = {}
        if self.Road and spawner ~= nil and isvalid(spawner.Entity) then lent = spawner:BorrowPool(count) end
        local borrowed = 0
        for i = 1, count do
            local a = (i / count) * math.pi * 2
            local p = center + Vector2(math.cos(a) * 2.2, math.sin(a) * 1.6)
            local id = kinds[_UtilLogic:RandomIntegerRange(1, #kinds)]
            local level = self.Level
            local loan = lent[i]
            if loan ~= nil then
                id = loan.id
                level = loan.level
            end
            local e = _SpawnService:SpawnByModelId(id, id, Vector3(p.x, p.y, 0), map)
            if not isvalid(e) and loan ~= nil then spawner:ReturnToPool(loan.id, loan.level) end
            if isvalid(e) then
                local leader = i == 1
                if loan ~= nil then
                    spawner:TrackBorrowed(e, loan.id, loan.level)
                    borrowed = borrowed + 1
                end
                _Util:AfterSpawn(e, "script.Monster", function(comp)
                    ---@type Monster
                    local m = comp
                    m.RespawnDelay = -1
                    m:ApplyLevel(level, leader)
                    if leader then m:MakeVariant(_GameData:RollVariant(_GameConst:DifficultyOfMap(m.Entity.CurrentMap.Name))) end
                end, nil)
            end
        end
        -- 보물: 연 사람에게 최상위 몬스터 드롭 표로 (본인만 보이고 줍는다)
        _LootSystem:RollDrops(self.Entity, self.Level, "unique", player)
        _Util:Notify("저주받은 상자! 매복이 덮친다 — 보물을 지켜라", player.PlayerComponent.UserId)
        local q = self.Entity.TransformComponent.WorldPosition
        _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, Vector3(q.x, q.y + 0.4, 0), 0, Vector3(1, 1, 1), false, { Color = Color(0.7, 0.3, 1, 1) })
        log("[VRF] cursed chest opened by " .. player.Name .. " ambush=" .. tostring(count) .. " lv=" .. tostring(self.Level) .. " road=" .. tostring(self.Road) .. " borrowed=" .. tostring(borrowed))
    end

    @ExecSpace("ServerOnly")
    method boolean IsQuestChest()
        -- 이 봉인 상자가 의뢰(종류 chest)의 목표 상자인가 — 맵 id로 판정
        for i = 1, _QuestData:Count() do
            local q = _QuestData:Get(i)
            if q ~= nil and q.kind == "chest" and q.map == self.MapKey then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method void SpawnGoldPiles(Vector2 center, string userId, integer piles)
        -- 상자 골드 더미: 더미마다 상자 레벨 × sealedChestGoldMin~Max (여러 개로 흩어져 떨어진다)
        for i = 1, piles do
            local amount = _UtilLogic:RandomIntegerRange(math.floor(self.Level * _GameData.sealedChestGoldMin), math.floor(self.Level * _GameData.sealedChestGoldMax))
            local a = (i / math.max(1, piles)) * math.pi * 2
            _LootSystem:Spawn(center + Vector2(math.cos(a) * 0.6, math.sin(a) * 0.35), userId, "gold", "", amount, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void OpenSealed(Entity player)
        -- 봉인 상자: 열쇠 확인 → 이 플레이어에게만 보물 → 첫 개봉 기록 → SealedChestOpened (의뢰 chest 판정)
        local userId = player.PlayerComponent.UserId
        if self.RewardRank ~= "" then
            self:OpenReward(player)
            return
        end
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil or not _Util:IsAlive(player) then return end
        if self.NeedKey ~= "" and not quest:HasChestKey(self.MapKey) then
            local now = _UtilLogic.ElapsedSeconds
            if (self.NoticeAt[userId] or 0) <= now then
                self.NoticeAt[userId] = now + 6
                _Util:Warn("봉인되어 있습니다 — " .. _GameData:GetMonsterName(self.NeedKey) .. "의 열쇠가 필요합니다", userId)
            end
            return
        end
        self.OpenedDigest = self.OpenedDigest .. userId .. ";"
        local first = not quest:IsSealedOpened(self.MapKey)
        if first then quest:MarkSealedOpened(self.MapKey) end
        local center = _Util:Pos2(self.Entity) + Vector2(0, -0.6)
        -- 첫 개봉 보장은 의뢰 상자(의뢰 종류 chest가 가리키는 맵 — 장마다 하나)만 (10-23 사용자: 봉인 상자 20개 보장이 디아블로 2보다 후했다).
        -- 나머지 곁가지 끝방 상자는 처음에도 정예급 보물
        if first and self:IsQuestChest() then
            -- 그 난이도 첫 개봉: 희귀 이상 sealedChestRares개 보장 + 보스 표 sealedChestBossRolls번 + 골드 더미 + 룬은 sealedChestRuneChance 확률
            -- (10-24 사용자: 의뢰를 깨고 여는 상자인데 희귀 하나뿐이라 보상이 너무 낮았다)
            for _ = 1, math.max(1, math.floor(_GameData.sealedChestRares)) do
                local item = _ItemData:GenerateWithMinimum(self.Level + 2, "boss", 300, 2)
                _LootSystem:Spawn(center, userId, "item", item, 1, _ItemData:Parse(item).rarity)
            end
            for _ = 1, math.floor(_GameData.sealedChestBossRolls) do _LootSystem:RollDrops(self.Entity, self.Level, "boss", player) end
            self:SpawnGoldPiles(center, userId, math.floor(_GameData.sealedChestGoldPiles))
            local rune = _UtilLogic:RandomDouble() < _GameData.sealedChestRuneChance
            if rune then _LootSystem:Spawn(center, userId, "rune", _ItemData:MakeRune(self.Level + 4), 1, 0) end
            _Util:Banner("봉인 상자를 열었습니다", rune and "이 난이도 첫 개봉 · 희귀 장비와 룬" or "이 난이도 첫 개봉 · 희귀 장비", userId)
        else
            -- 다시 열거나 의뢰 밖 끝방 상자: 최상위 몬스터 표 + 골드 더미 (10-24: 정예 표 한 번은 일반 몬스터 무리보다 못했다)
            _LootSystem:RollDrops(self.Entity, self.Level, "unique", player)
            self:SpawnGoldPiles(center, userId, math.floor(_GameData.sealedChestRepeatGoldPiles))
            _Util:Notify("봉인 상자를 열었습니다", userId)
        end
        local q = self.Entity.TransformComponent.WorldPosition
        _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, Vector3(q.x, q.y + 0.4, 0), 0, Vector3(1, 1, 1), false, { Color = Color(1, 0.85, 0.4, 1) })
        _GameEvents:Emit("SealedChestOpened", { player = player, map = self.Entity.CurrentMap, mapKey = self.MapKey })
        log("[VRF] sealed chest " .. self.MapKey .. " opened by " .. player.Name .. " first=" .. tostring(first) .. " lv=" .. tostring(self.Level))
    end

    @ExecSpace("ServerOnly")
    method void OpenReward(Entity player)
        -- 심도 층 보상: 이 플레이어에게만 RewardRank 표로 RewardRolls번 (깊을수록·보스 층·저주 층일수록 많고 좋다)
        if not _Util:IsAlive(player) then return end
        local userId = player.PlayerComponent.UserId
        self.OpenedDigest = self.OpenedDigest .. userId .. ";"
        for _ = 1, math.max(1, self.RewardRolls) do _LootSystem:RollDrops(self.Entity, self.Level, self.RewardRank, player) end
        _Util:Notify("심도 보상 상자를 열었습니다 (" .. tostring(self.RewardRolls) .. "번)", userId)
        local q = self.Entity.TransformComponent.WorldPosition
        _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, Vector3(q.x, q.y + 0.4, 0), 0, Vector3(1, 1, 1), false, { Color = Color(0.75, 0.55, 1, 1) })
        log("[VRF] depth reward opened by " .. player.Name .. " rank=" .. self.RewardRank .. " rolls=" .. tostring(self.RewardRolls) .. " lv=" .. tostring(self.Level))
    end

    @ExecSpace("ClientOnly")
    method void RefreshView()
        if self.Sealed then
            self:RefreshSealedView()
            return
        end
        local tag = self.Entity.NameTagComponent
        if isvalid(tag) then
            local name = self.Opened and "열린 상자" or "저주받은 상자 · 다가가면 열림"
            if tag.Name ~= name then
                tag.Name = name
                tag.FontColor = self.Opened and Color(0.6, 0.6, 0.6, 1) or Color(0.85, 0.55, 1, 1)
            end
        end
        local sprite = self.Entity.SpriteRendererComponent
        if self.Opened and isvalid(sprite) and sprite.SpriteRUID ~= self.OpenRuid then
            sprite.SpriteRUID = self.OpenRuid
            sprite.Color = Color(0.7, 0.65, 0.75, 1)
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshSealedView()
        -- 봉인 상자는 플레이어마다 열린다: 내가 열었으면 열린 그림
        local me = _UserService.LocalPlayer
        if not isvalid(me) then return end
        local opened = string.find(self.OpenedDigest, ";" .. me.PlayerComponent.UserId .. ";", 1, true) ~= nil
        local tag = self.Entity.NameTagComponent
        if isvalid(tag) then
            local name = opened and "열린 봉인 상자" or (self.NeedKey ~= "" and "봉인 상자 · 열쇠 필요" or "봉인 상자 · 다가가면 열림")
            if self.RewardRank ~= "" then name = opened and "열린 보상 상자" or "심도 보상 상자 · 다가가면 열림" end
            if tag.Name ~= name then
                tag.Name = name
                tag.FontColor = opened and Color(0.6, 0.6, 0.6, 1) or Color(1, 0.85, 0.4, 1)
            end
        end
        local sprite = self.Entity.SpriteRendererComponent
        if opened and isvalid(sprite) and sprite.SpriteRUID ~= self.OpenRuid then
            sprite.SpriteRUID = self.OpenRuid
            sprite.Color = Color(0.75, 0.7, 0.6, 1)
        end
    end

end
