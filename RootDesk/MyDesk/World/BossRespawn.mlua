-- 보스 다시 나타나기까지: 고정 보스·곁가지 끝방 보스·피의 제단 의식.
-- 10-23 (사용자: 디아블로 2처럼): bossRespawnSec < 0 이면 「그 게임(방)에서 한 번」 — 쓰러지면 그 방에서는 다시 나오지 않고, 새 게임을 열면 다시 나온다.
--   (게임 방은 파티마다 따로 열리고 모두 나가면 사라진다 — docs/design/30). 단 그 보스 의뢰가 남은 사람이 맵에 오면 CoopRules가 bossQuestRespawnSec로 줄여 준다.
-- 예전(10-11): 쓰러진 뒤 5분이면 다시 — 채널을 함께 쓰던 때 다른 사람 몫을 남기려던 규칙.
-- 맵마다 남은 시간을 클라이언트에 알려 미니맵 머리글에 「처형인 4:32」처럼 보여 준다 (HudMap).
-- 예전에는 고정 보스 90~120초, 끝방 보스는 맵이 3초 비면 맵 전체와 함께, 제단은 맵이 5초 비면 다시 나와 포털로 끝없이 잡을 수 있었다.
@Logic
script BossRespawn extends Logic

    @Sync
    property string Digest = ""        -- "맵 이름|보스 이름|다시 나오는 서버 시각;..." (ServerElapsedSeconds)
    property table Timers = nil         -- 서버: "맵|이름" → { map, name, at }
    property number OnceSeconds = 100000000   -- 「한 게임에 한 번」일 때 대기 (방이 그 전에 사라진다)

    @ExecSpace("ServerOnly")
    method void Start(string mapName, string bossName)
        -- 보스가 쓰러졌다: 지금부터 bossRespawnSec 뒤에 다시 나올 수 있다
        if self.Timers == nil then self.Timers = {} end
        self.Timers[mapName .. "|" .. bossName] = { map = mapName, name = bossName, at = _UtilLogic.ServerElapsedSeconds + self:Delay() }
        self:Publish()
    end

    @ExecSpace("ServerOnly")
    method boolean Hurry(string mapName, number seconds)
        -- 그 맵의 쓰러진 보스들 남은 시간을 seconds 이하로 줄인다 (의뢰가 남은 사람이 왔을 때, CoopRules · 10-13 M1). 줄였으면 true
        if self.Timers == nil then return false end
        local cap = _UtilLogic.ServerElapsedSeconds + seconds
        local changed = false
        for _, t in pairs(self.Timers) do
            if t.map == mapName and t.at > cap then
                t.at = cap
                changed = true
            end
        end
        if changed then self:Publish() end
        return changed
    end

    @ExecSpace("ServerOnly")
    method void Clear(string mapName, string bossName)
        if self.Timers == nil or self.Timers[mapName .. "|" .. bossName] == nil then return end
        self.Timers[mapName .. "|" .. bossName] = nil
        self:Publish()
    end

    @ExecSpace("ServerOnly")
    method number Remaining(string mapName, string bossName)
        -- 남은 초 (없거나 지났으면 0)
        if self.Timers == nil then return 0 end
        local t = self.Timers[mapName .. "|" .. bossName]
        if t == nil then return 0 end
        return math.max(0, t.at - _UtilLogic.ServerElapsedSeconds)
    end

    @ExecSpace("ServerOnly")
    method number MapRemaining(string mapName)
        -- 그 맵에서 가장 늦게 돌아오는 보스까지 남은 초 (곁가지 던전 다시 채우기 판단)
        local best = 0
        if self.Timers == nil then return 0 end
        for _, t in pairs(self.Timers) do
            if t.map == mapName then best = math.max(best, t.at - _UtilLogic.ServerElapsedSeconds) end
        end
        return math.max(0, best)
    end

    method boolean OncePerGame()
        -- 쓰러진 보스가 그 게임(방)에서는 다시 나오지 않는 규칙인가
        return _GameData.bossRespawnSec < 0
    end

    method number Delay()
        -- 다시 나오기까지(초). 한 게임에 한 번이면 아주 큰 값 (방이 사라질 때까지)
        if self:OncePerGame() then return self.OnceSeconds end
        return _GameData.bossRespawnSec
    end

    method string DownText(string bossName)
        -- 보스가 쓰러졌을 때 맵 알림
        if self:OncePerGame() then return bossName .. " — 이 게임에서는 다시 나타나지 않습니다 (새 게임을 열면 다시 나옵니다)" end
        return bossName .. " — " .. self:WaitText() .. " 뒤 다시 나타납니다"
    end

    method string DownLine()
        -- 채널 A 「상단 띠」 둘째 줄: 이름 없이 다시 나오는 때만 (10-31 B-4 — 제목은 「○○ 처치!」)
        if self:OncePerGame() then return "이 게임에서는 다시 나타나지 않습니다" end
        return self:WaitText() .. " 뒤 다시 나타납니다"
    end

    method string WaitText()
        -- 알림용 대기 시간 「5분」 (1분이 안 되면 「20초」, 나머지 초가 있으면 「2분 30초」)
        local sec = math.floor(_GameData.bossRespawnSec)
        if sec < 60 then return tostring(sec) .. "초" end
        if sec % 60 == 0 then return tostring(sec // 60) .. "분" end
        return tostring(sec // 60) .. "분 " .. tostring(sec % 60) .. "초"
    end

    @ExecSpace("ServerOnly")
    method void Publish()
        local parts = {}
        for _, t in pairs(self.Timers) do
            table.insert(parts, t.map .. "|" .. t.name .. "|" .. tostring(math.floor(t.at)))
        end
        table.sort(parts)
        self.Digest = table.concat(parts, ";")
    end

    @ExecSpace("ClientOnly")
    method string LabelFor(string mapName)
        -- 클라이언트: 이 맵에서 가장 늦게 돌아오는 보스 「목 없는 처형인 4:32」, 더 있으면 「 외 1」. 다 됐으면 ""
        local now = _UtilLogic.ServerElapsedSeconds
        local bestName = ""
        local bestLeft = 0
        local count = 0
        for map, name, at in string.gmatch(self.Digest, "([^|;]+)|([^|;]+)|(%d+)") do
            local left = math.floor(tonumber(at) - now)
            if map == mapName and left > 0 and left > 86400 then
                -- 한 게임에 한 번: 남은 시간 대신 「처치」
                count = count + 1
                if bestLeft < 86400 * 2 then
                    bestLeft = left
                    bestName = name
                end
            elseif map == mapName and left > 0 then
                count = count + 1
                if left > bestLeft then
                    bestLeft = left
                    bestName = name
                end
            end
        end
        if count == 0 then return "" end
        local text = bestLeft > 86400 and (bestName .. " 처치") or (bestName .. " " .. string.format("%d:%02d", math.floor(bestLeft / 60), bestLeft % 60))
        if count > 1 then text = text .. " 외 " .. tostring(count - 1) end
        return text
    end

end
