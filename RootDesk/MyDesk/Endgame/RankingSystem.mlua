-- 랭킹 (11장: 보스 처치 시간 · 10-24 성장 순위 — 모든 사용자를 레벨 + 가장 멀리 간 난이도·액트로). SortableDataStorage에 기록하고, 이름은 GlobalDataStorage에 따로 둔다.
-- 심연 기록판(심도·이번 주)은 심연을 숨긴 동안(config depthEnabled 0) 창에서 감춘다.
-- 비용 규칙(datastorage.md): 기록이 좋아졌을 때만 쓴다. 조회는 창을 열 때만, 서버에서 60초 캐시.
-- 11-01 사용자 결정 1-B: 모든 판을 「캐릭터 단위」로 (한 계정의 여러 캐릭터가 따로 줄을 차지한다).
--   키 = 계정 ProfileCode .. "_" .. CharId("c<슬롯>_<만든 시각 ms>" — PlayerSave 슬롯 요약의 created. 만들 때 한 번 정해져 바뀌지 않고, 지우고 같은 칸에 새로 만들면 새 시각).
--   판 이름 끝에 BoardSuffix를 붙이고 이름은 새 저장소(NameStore)에 캐릭터 이름으로 둔다 — 예전 계정 키 판(접미 없음)·이름(rank_names)은 읽지도 지우지도 않는다(되돌리기용).
--   예전 기록은 옮기지 않는다: 성장 순위는 입장 때 다시 적혀 채워지고, 보스·심연은 새로 시작 (docs/evidence/2026-11-01-rank-per-character/README.md).
--   캐릭터를 지우면 이름 자리에 HiddenName을 적어 목록·내 순위 셈에서 뺀다 (기록 줄은 남긴다 — PlayerSave 슬롯 삭제가 저장 데이터를 남기는 것과 같은 방식).
-- 11-01 2차 (사용자 「캐릭터도 작게 · 20위까지」 · docs/evidence/2026-11-01-rank-window-2): 상위 10 → TopCount(20) · 다이제스트 "이름|값|외형".
--   외형(PlayerSave.Look "g-h-f-s-t" — 캐릭터 선택 카드와 같은 값)은 새 저장소 LookStore(캐릭터 키 → 외형)에 둔다 — 다른 사람의 오프라인 캐릭터도 창에서 그 모습으로.
--   이름 저장소(NameStore)는 형식 그대로 「캐릭터 이름」만 (이름 칸에 외형을 붙이면 되돌린 예전 코드·아직 예전 코드로 도는 인스턴스가 외형 글을 이름으로 보인다).
--   외형 쓰기 = 캐릭터마다 세션에 한 번(기록이 좋아질 때 이름과 함께) · 외형 읽기 = 목록을 새로 만들 때 보이는 줄만 묶음 1번(60초 캐시). 외형이 없는 옛 줄은 창이 그림자 모습으로 그리고,
--   그 캐릭터가 목록에 보이는 채로 창을 열면 한 번 채운다(FillLook). 요청자에게는 지금 캐릭터 「이름|외형」(MeText)을 함께 보내 「내 순위」 줄도 그림으로 그린다
@Logic
script RankingSystem extends Logic

    property string NameStore = "rank_names_c1"   -- 캐릭터 키 → 캐릭터 이름 (11-01 전 계정 키 → 계정 닉네임은 "rank_names"에 그대로 남아 있다)
    property string LookStore = "rank_looks_c1"   -- 캐릭터 키 → 외형 "g-h-f-s-t" (11-01 2차 · 목록 캐릭터 그림)
    property string BoardSuffix = "_c1"            -- 캐릭터 단위 판 이름 끝 (예전 계정 단위 판 rank_<kind>_<diff>와 섞이지 않게)
    property string HiddenName = "|hidden"         -- 지운 캐릭터 표시 (이름에는 | 가 들어갈 수 없다 — PlayerSave.CleanName · CharName)
    property integer TopCount = 20                 -- 창에 보이는 줄 (11-01 2차: 10 → 20 · 칸 4 × 5줄)
    property integer NameScanMax = 45              -- 상위 20을 채우려고 이름을 읽는 최대 줄 (첫 묶음 20줄 · 지운 캐릭터가 섞였을 때만 한 번 더 25줄 — 이름 묶음 조회 한 쪽 25)
    property integer SortMax = 2000000000          -- 정렬 조회 값 상한 (예전 999999는 심연 10층부터(값 = 층 × 100000 + …) 빠졌다)
    property table StoredLook = {}                 -- 이번 세션에 외형 저장소에서 읽었거나 쓴 값 (캐릭터 키 → 외형 · 읽었는데 없으면 "") — FillLook이 목록에 보인 줄을 알아본다
    property table LookWritten = {}                -- 캐릭터 키 → 이번 세션에 적은 외형 (같은 값을 다시 쓰지 않게)
    property table Hidden = {}                     -- 이번 세션에 확인한 지운 캐릭터 키 → true (내 순위 셈에서 위 줄 빼기)
    property table Cache = {}            -- board → { at, digest }
    property table Known = {}            -- board|캐릭터 키 → 이번 세션에 확인한 기록 (중복 조회 방지)
    property table NameWritten = {}      -- 캐릭터 키 → 이번 세션에 적은 이름 (기록판마다 같은 이름을 다시 쓰지 않게)
    -- 10-31 실플레이 피드백 「랭킹에 내가 안 보인다」 (A안 · 「내 순위」 줄): 상위 목록과 따로 요청자 본인의 순위·값을 보낸다 (60초 캐시를 쓰지 않는다)
    property integer MinePageMax = 100   -- 내 순위는 정렬 첫 쪽에서 이 줄까지만 센다 (그 밖은 「100위 밖」 · 다음 쪽은 읽지 않는다)
    property number MineGuardSec = 5     -- 같은 캐릭터·같은 판을 이 초 안에 다시 물으면 방금 답을 그대로 (탭 연타로 정렬 조회가 쌓이지 않게)
    property table Fresh = {}            -- board → 방금 GetTop이 읽은 정렬 첫 쪽 (같은 요청의 내 순위가 다시 읽지 않게 · MineDigest가 바로 비운다)
    property table MineAt = {}           -- board|캐릭터 키 → { at, mine } 연타 방지
    property table MineRecorded = {}     -- 내 순위를 물었는데 성장 기록이 없어 RecordProgress를 부른 캐릭터 키 (세션당 한 번)

    @ExecSpace("ServerOnly")
    method string BoardName(string kind, integer diff)
        -- 캐릭터 단위 판 "rank_<kind>_<diff>_c1" (11-01 전 계정 단위 판은 접미 없이 그대로 남아 있다)
        return "rank_" .. kind .. "_" .. tostring(diff) .. self.BoardSuffix
    end

    method string CharId(integer slot, any info)
        -- 캐릭터 id "c<슬롯>_<만든 시각 ms>" (PlayerSave 슬롯 요약 Account.slots[N].created — 만들기·예전 저장 옮기기 둘 다 적는다). 없으면 ""
        --   created는 JSON 정수로 저장돼 다시 불러도 같은 값(14자리 < 2^53) · 실수로 읽혀도 math.floor로 같은 글자
        if slot <= 0 or type(info) ~= "table" then return "" end
        local created = tonumber(info.created)
        if created == nil or created <= 0 then return "" end
        return string.format("c%d_%d", slot, math.floor(created))
    end

    method string RankKey(string profileCode, string id)
        -- 기록 키 = 계정 ProfileCode .. "_" .. 캐릭터 id (다른 계정의 같은 id와 겹치지 않게)
        return profileCode .. "_" .. id
    end

    @ExecSpace("ServerOnly")
    method string CharIdOf(Entity player)
        -- 지금 캐릭터의 id. 캐릭터를 아직 안 골랐으면(선택 창 · 슬롯 0) ""
        if not isvalid(player) then return "" end
        ---@type PlayerSave
        local save = player:GetComponent("script.PlayerSave")
        if save == nil or save.Slot <= 0 then return "" end
        return self:CharId(save.Slot, save:SlotInfo(save.Slot))
    end

    @ExecSpace("ServerOnly")
    method string CharName(Entity player)
        -- 목록에 보일 이름 = 이름표의 캐릭터 이름 (PlayerSave.CharName · 후원 칭호 줄은 빼고). 다이제스트 구분 문자(| ;)는 걸러 낸다
        ---@type PlayerSave
        local save = player:GetComponent("script.PlayerSave")
        local raw = save ~= nil and save:CharName() or player.PlayerComponent.Nickname
        local name, _ = string.gsub(raw or "", "[|;]", "")
        if name == "" then name = "망자" end
        return name
    end

    @ExecSpace("ServerOnly")
    method string CharLook(Entity player)
        -- 목록 캐릭터 그림용 외형 "g-h-f-s-t" (PlayerSave.Look — 캐릭터 선택 카드와 같은 값 · 외형이 없던 예전 캐릭터는 기본 "m-1-1"). 구분 문자는 걸러 낸다
        ---@type PlayerSave
        local save = player:GetComponent("script.PlayerSave")
        if save == nil then return "" end
        local look, _ = string.gsub(save:Look() or "", "[|;]", "")
        return look
    end

    @ExecSpace("ServerOnly")
    method void WriteLook(string key, string look)
        -- 외형 저장소 한 줄 (이번 세션에 같은 값을 썼거나 읽어 이미 같으면 요청하지 않는다 · 값 십여 바이트)
        if look == "" or self.LookWritten[key] == look or self.StoredLook[key] == look then return end
        self.LookWritten[key] = look
        self.StoredLook[key] = look
        _DataStorageService:GetGlobalDataStorage(self.LookStore):SetAsync(key, look, function(code, k)
            if code ~= 0 then log_warning("[RankingSystem] 외형 기록 실패 " .. tostring(code)) end
        end)
    end

    method string DepthKind(integer act)
        -- 심연 도전 기록판 종류 (10-20: 액트마다 레벨대·몬스터가 달라 따로 겨룬다 — 예전 액트 없는 「depthrun」판은 쓰지 않는다)
        return "depthrun_a" .. tostring(act)
    end

    @ExecSpace("ServerOnly")
    method void RecordDepth(Entity player, integer diff, integer act, integer floor)
        -- 최고 층 (높을수록 좋음, 액트별)
        self:Record(player, self:BoardName("depth_a" .. tostring(act), diff), floor, false)
    end

    @ExecSpace("ServerOnly")
    method void RecordDepthRun(Entity player, integer diff, integer act, integer floor, integer seconds)
        -- 심연 도전 (액트별): 높은 층이 위, 같은 층이면 1층부터 걸린 시간이 짧은 쪽이 위. 값 = 층 × 100000 + (99999 - 초)
        local value = floor * 100000 + (99999 - math.max(0, math.min(99999, seconds)))
        self:Record(player, self:BoardName(self:DepthKind(act), diff), value, false)
    end

    @ExecSpace("ServerOnly")
    method void RecordWeekRun(Entity player, integer diff, integer act, integer week, integer floor, integer seconds)
        -- 이번 주 심연 도전 (액트별 · 주마다 새 판, WeeklyRules.BoardKind). 값은 RecordDepthRun과 같다
        local value = floor * 100000 + (99999 - math.max(0, math.min(99999, seconds)))
        self:Record(player, self:BoardName(_WeeklyRules:BoardKind(act, week), diff), value, false)
    end

    @ExecSpace("ServerOnly")
    method void RecordBossTime(Entity player, integer diff, integer seconds)
        -- 짧을수록 좋음. 마지막 액트 보스(FinalBossSourceId)마다 따로 (예전 「queen」판은 여왕 → 대사제 기록이 섞였다)
        self:Record(player, self:BoardName("boss_" .. _GameConst.FinalBossSourceId, diff), seconds, true)
    end

    method void OnBeginPlay()
        -- 성장 순위: 레벨이 오르거나 의뢰를 마칠 때 다시 적는다 (좋아졌을 때만 쓴다 — Record)
        if not self:IsServer() then return end
        _GameEvents:Subscribe("LevelUp", "RankingSystem", function(e) self:RecordProgressLater(e.player) end)
        _GameEvents:Subscribe("QuestCompleted", "RankingSystem", function(e) self:RecordProgressLater(e.player) end)
    end

    @ExecSpace("ServerOnly")
    method void RecordProgressLater(Entity player)
        -- 이벤트를 보낸 쪽을 기다리게 하지 않게 (기록 조회는 GetAndWait) 잠깐 뒤에 적는다
        _TimerService:SetTimerOnce(function() if isvalid(player) then self:RecordProgress(player) end end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method integer ProgressValue(Entity player)
        -- 성장 값 = 레벨 × 100 + 난이도 × 10 + 액트 (그 난이도에서 지금 하는 액트 1~4, 다 깼으면 5). 높을수록 위
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if stats == nil or quest == nil then return 0 end
        local diff = stats.MaxDifficulty
        local index = 1
        if quest.Diff == diff then index = quest.Index
        else
            local saved = quest.ByDiff[tostring(diff)]
            if saved ~= nil and saved.i ~= nil then index = saved.i end
        end
        local act = _GameConst.ActCount + 1
        local q = _QuestData:Get(index)
        if q ~= nil then act = math.max(1, math.min(_GameConst.ActCount, q.act)) end
        return stats.Level * 100 + diff * 10 + act
    end

    @ExecSpace("ServerOnly")
    method void RecordProgress(Entity player)
        -- 모든 사용자의 성장 기록 (난이도 하나의 판 — 「progress」)
        local value = self:ProgressValue(player)
        if value > 0 then self:Record(player, self:BoardName("progress", 0), value, false) end
    end

    method string ProgressText(integer value)
        -- 「Lv44 · 노말 액트 4」 / 다 깼으면 「Lv60 · 악몽 완료」
        local level = value // 100
        local diff = (value % 100) // 10
        local act = value % 10
        if act > _GameConst.ActCount then return string.format("Lv%d · %s 완료", level, _GameConst:DifficultyName(diff)) end
        return string.format("Lv%d · %s 액트 %d", level, _GameConst:DifficultyName(diff), act)
    end

    @ExecSpace("ServerOnly")
    method void Record(Entity player, string board, integer value, boolean lowerIsBetter)
        -- 지금 캐릭터의 기록 (키 = 캐릭터 키 · 이름 = 캐릭터 이름). 캐릭터를 아직 안 골랐으면 적지 않는다
        if not isvalid(player) then return end
        local id = self:CharIdOf(player)
        if id == "" then
            log(string.format("[VRF] rank record skip board=%s reason=nochar", board))
            return
        end
        local key = self:RankKey(player.PlayerComponent.ProfileCode, id)
        local name = self:CharName(player)
        local cacheKey = board .. "|" .. key
        local best = self.Known[cacheKey]
        local ds = _DataStorageService:GetSortableDataStorage(board)
        if best == nil then
            local code, v = ds:GetAndWait(key)
            if code == 0 then best = v elseif code ~= 1000002 then return end
        end
        local better = best == nil or (lowerIsBetter and value < best) or (not lowerIsBetter and value > best)
        if not better then return end
        self.Known[cacheKey] = value
        ds:SetAsync(key, value, function(code, k)
            if code ~= 0 then log_warning("[RankingSystem] 기록 실패 " .. tostring(code)) end
        end)
        if self.NameWritten[key] ~= name then
            self.NameWritten[key] = name
            _DataStorageService:GetGlobalDataStorage(self.NameStore):SetAsync(key, name, nil)
        end
        local look = self:CharLook(player)
        self:WriteLook(key, look)
        self.Cache[board] = nil
        log(string.format("[VRF] rank record board=%s char=%s name=%s value=%d prev=%s look=%s", board, id, name, value, tostring(best), look))
    end

    @ExecSpace("ServerOnly")
    method void HideCharacter(string profileCode, integer slot, any info)
        -- 캐릭터 삭제 (PlayerSave.RequestDeleteSlot · 계정 저장 성공 뒤): 이름 자리에 HiddenName → 모든 판 목록과 내 순위 셈에서 빠진다.
        --   기록 줄은 지우지 않는다 (이름만 되돌리면 다시 보인다 · 판을 하나하나 지우면 판 수만큼 Delete 요청). 같은 칸 새 캐릭터는 새 id라 이어받지 않는다
        local id = self:CharId(slot, info)
        if id == "" then return end
        local key = self:RankKey(profileCode, id)
        self.Hidden[key] = true
        self.NameWritten[key] = self.HiddenName
        self.Cache = {}
        _DataStorageService:GetGlobalDataStorage(self.NameStore):SetAsync(key, self.HiddenName, function(code, k)
            if code ~= 0 then log_warning("[RankingSystem] 지운 캐릭터 표시 실패 " .. tostring(code)) end
        end)
        log(string.format("[VRF] rank hide char=%s", id))
    end

    @ExecSpace("ServerOnly")
    method table ReadSorted(string board, boolean ascending)
        -- 정렬 첫 쪽만 { key, value } 최대 MinePageMax줄 (다음 쪽은 읽지 않는다)
        local ds = _DataStorageService:GetSortableDataStorage(board)
        local dir = SortDirection.Descending
        if ascending then dir = SortDirection.Ascending end
        local code, pages = ds:GetSortedAndWait(dir, 1, self.SortMax)
        local rows = {}
        if code == 0 then
            local datas = pages:GetCurrentPageDatas()
            if datas ~= nil then
                for i = 1, math.min(self.MinePageMax, #datas) do table.insert(rows, { key = datas[i].KeyInfo.Key, value = datas[i].Value }) end
            end
        end
        return rows
    end

    @ExecSpace("ServerOnly")
    method table ReadNames(table rows, integer from, integer to)
        -- rows[from..to] 키의 이름 (한 번의 묶음 조회 · 25개 이하). 지운 캐릭터 표시(HiddenName)는 Hidden에도 남긴다
        local keys = {}
        for i = from, to do table.insert(keys, rows[i].key) end
        local names = {}
        if #keys == 0 then return names end
        local ncode, npages = _DataStorageService:GetGlobalDataStorage(self.NameStore):BatchGetAndWait(keys)
        if ncode == 0 then
            local nd = npages:GetCurrentPageDatas()
            if nd ~= nil then
                for i = 1, #nd do
                    local k = nd[i].KeyInfo.Key
                    names[k] = nd[i].Value
                    if nd[i].Value == self.HiddenName then self.Hidden[k] = true end
                end
            end
        end
        return names
    end

    @ExecSpace("ServerOnly")
    method table ReadLooks(table keys)
        -- 목록에 보이는 줄의 외형 (한 번의 묶음 조회 · TopCount ≤ 25). 읽은 키는 StoredLook에 (없으면 "" — 옛 줄 · FillLook이 알아본다)
        local looks = {}
        if #keys == 0 then return looks end
        local code, pages = _DataStorageService:GetGlobalDataStorage(self.LookStore):BatchGetAndWait(keys)
        if code ~= 0 then return looks end
        for _, k in ipairs(keys) do self.StoredLook[k] = "" end
        local datas = pages:GetCurrentPageDatas()
        if datas ~= nil then
            for i = 1, #datas do
                local look = datas[i].Value
                if string.match(look or "", "^[mf]%-[%d%-]+$") == nil then look = "" end
                looks[datas[i].KeyInfo.Key] = look
                self.StoredLook[datas[i].KeyInfo.Key] = look
            end
        end
        return looks
    end

    @ExecSpace("ServerOnly")
    method string GetTop(string board, boolean ascending)
        -- 상위 TopCount명 "이름|값|외형;..." (60초 캐시 · 외형 없는 옛 줄은 외형 칸이 빈다). 새로 읽었으면 정렬 첫 쪽을 Fresh에 잠깐 둔다 (같은 요청의 내 순위가 다시 읽지 않게)
        --   이름은 첫 TopCount줄만 읽고, 지운 캐릭터가 섞여 덜 차면 NameScanMax줄까지 한 번 더 읽어 채운다 (보통은 이름 조회 1번 그대로) · 외형은 보이는 줄만 묶음 1번
        local c = self.Cache[board]
        if c ~= nil and _UtilLogic.ElapsedSeconds - c.at < 60 then return c.digest end
        local sorted = self:ReadSorted(board, ascending)
        self.Fresh[board] = sorted
        local scanned = math.min(self.TopCount, #sorted)
        local names = self:ReadNames(sorted, 1, scanned)
        local shown = {}
        local hidden = 0
        local i = 1
        while #shown < self.TopCount and i <= #sorted do
            if i > scanned then
                if scanned >= self.NameScanMax then break end
                local upto = math.min(#sorted, self.NameScanMax)
                for k, v in pairs(self:ReadNames(sorted, scanned + 1, upto)) do names[k] = v end
                scanned = upto
            end
            local r = sorted[i]
            if self.Hidden[r.key] or names[r.key] == self.HiddenName then hidden = hidden + 1
            else table.insert(shown, r) end
            i = i + 1
        end
        local keys = {}
        for _, r in ipairs(shown) do table.insert(keys, r.key) end
        local looks = self:ReadLooks(keys)
        local parts = {}
        local known = 0
        for _, r in ipairs(shown) do
            local look = looks[r.key] or ""
            if look ~= "" then known = known + 1 end
            table.insert(parts, (names[r.key] or "?") .. "|" .. tostring(r.value) .. "|" .. look)
        end
        local digest = table.concat(parts, ";")
        self.Cache[board] = { at = _UtilLogic.ElapsedSeconds, digest = digest }
        log(string.format("[VRF] rank top board=%s rows=%d shown=%d hidden=%d names=%d looks=%d", board, #sorted, #parts, hidden, scanned, known))
        return digest
    end

    @ExecSpace("ServerOnly")
    method string FillLook(Entity player)
        -- 11-01 2차: 외형이 없는 옛 줄(2차 전 기록)이 상위 목록에 보이면, 그 캐릭터가 창을 열 때 한 번 외형을 채운다. 채웠으면 그 외형, 아니면 ""
        --   목록을 만들며 읽은 키(StoredLook)만 · 세션에 한 번(WriteLook) · 다른 줄은 기록이 좋아질 때 Record가 함께 쓴다
        if not isvalid(player) then return "" end
        local id = self:CharIdOf(player)
        if id == "" then return "" end
        local key = self:RankKey(player.PlayerComponent.ProfileCode, id)
        local stored = self.StoredLook[key]
        local look = self:CharLook(player)
        if stored == nil or stored == look or self.Hidden[key] then return "" end
        self:WriteLook(key, look)
        log(string.format("[VRF] rank look fill char=%s look=%s", id, look))
        return look
    end

    @ExecSpace("ServerOnly")
    method string PatchLook(string board, string digest, string mine, string look)
        -- 방금 채운 내 외형을 이번 목록(과 60초 캐시)에도 바로 넣는다 — 내 순위 자리 줄의 값이 내 값과 같을 때만 (저장소 요청 없음)
        local rank = tonumber(string.match(mine or "", "^(%d+)|") or "") or 0
        local value = string.match(mine or "", "^%d+|(%d+)$")
        if rank <= 0 or value == nil then return digest end
        local parts = {}
        for row in string.gmatch(digest .. ";", "([^;]*);") do table.insert(parts, row) end
        local row = parts[rank]
        if row == nil or string.match(row, "^[^|]*|(%d+)|") ~= value then return digest end
        parts[rank] = string.match(row, "^([^|]*|%d+|)") .. look
        local patched = table.concat(parts, ";")
        local c = self.Cache[board]
        if c ~= nil and c.digest == digest then c.digest = patched end
        return patched
    end

    @ExecSpace("ServerOnly")
    method string MeText(Entity player)
        -- 「내 순위」 줄 그림·이름: 요청자의 지금 캐릭터 "이름|외형" (캐릭터를 안 골랐으면 "|")
        if not isvalid(player) or self:CharIdOf(player) == "" then return "|" end
        return self:CharName(player) .. "|" .. self:CharLook(player)
    end

    @ExecSpace("ServerOnly")
    method string MineDigest(Entity player, string board, boolean ascending, boolean progress)
        -- 요청자의 지금 캐릭터 "순위|값" (정렬 첫 쪽 MinePageMax줄 안 자리 · 밖이면 순위 -1) · 기록이 없으면 "none".
        --   60초 캐시를 쓰지 않는다: GetTop이 방금 읽은 첫 쪽(Fresh)이 있으면 그것, 없으면 새로 읽는다. 값은 첫 쪽 → Known → GetAndWait 순
        --   11-01 1-B: 키 = 지금 캐릭터 키 (같은 계정 다른 캐릭터의 기록은 「내 순위」가 아니다) · 위에 있는 지운 캐릭터 줄(Hidden)은 순위에서 뺀다
        local fresh = self.Fresh[board]
        self.Fresh[board] = nil
        if not isvalid(player) then return "none" end
        local id = self:CharIdOf(player)
        if id == "" then
            log(string.format("[VRF] rank char board=%s char=none", board))
            return "none"
        end
        local key = self:RankKey(player.PlayerComponent.ProfileCode, id)
        local guardKey = board .. "|" .. key
        local now = _UtilLogic.ElapsedSeconds
        local last = self.MineAt[guardKey]
        if fresh == nil and last ~= nil and now - last.at < self.MineGuardSec then return last.mine end
        local rows = fresh
        if rows == nil then rows = self:ReadSorted(board, ascending) end
        local rank = -1
        local value = nil
        local above = 0
        for i, r in ipairs(rows) do
            if r.key == key then
                rank = i - above
                value = r.value
                break
            end
            if self.Hidden[r.key] then above = above + 1 end
        end
        local missing = false
        if value == nil then value = self.Known[guardKey] end
        if value == nil then
            local code, v = _DataStorageService:GetSortableDataStorage(board):GetAndWait(key)
            if code == 0 then
                value = v
                self.Known[guardKey] = v
            elseif code == 1000002 then missing = true end
        end
        local mine = "none"
        if value ~= nil then mine = tostring(rank) .. "|" .. tostring(value) end
        if value == nil and missing and progress and not self.MineRecorded[key] then
            -- 성장 기록이 아직 없다 (입장 0.5초 기록 전 · 저장 실패 등): 지금 한 번 적는다 — 이번 답은 「기록 없음」, 다음에 열면 보인다
            self.MineRecorded[key] = true
            self:RecordProgress(player)
        end
        self.MineAt[guardKey] = { at = now, mine = mine }
        log(string.format("[VRF] rank char board=%s char=%s name=%s hiddenAbove=%d", board, id, self:CharName(player), above))
        log(string.format("[VRF] rank mine board=%s rank=%d value=%d", board, value ~= nil and rank or 0, value ~= nil and math.floor(value) or 0))
        return mine
    end

    @ExecSpace("Server")
    method void RequestBoard(string kind, integer diff)
        -- 클라이언트 랭킹 창 → 결과(상위 20 + 내 순위 + 내 캐릭터 「이름|외형」)는 그 사람에게만
        if kind == "progress" then diff = 0 end   -- 성장 순위는 난이도 하나의 판
        local board = self:BoardName(kind, diff)
        local ascending = kind == "queen" or string.sub(kind, 1, 5) == "boss_"
        local digest = self:GetTop(board, ascending)
        local player = _UserService:GetUserEntityByUserId(senderUserId)
        local mine = self:MineDigest(player, board, ascending, kind == "progress")
        local filled = self:FillLook(player)
        if filled ~= "" then digest = self:PatchLook(board, digest, mine, filled) end
        self:ShowBoard(kind, diff, digest, mine, self:MeText(player), senderUserId)
    end

    @ExecSpace("Client")
    method void ShowBoard(string kind, integer diff, string digest, string mine, string me)
        _RankWindow:OnData(kind, diff, digest, mine, me)
    end

end
