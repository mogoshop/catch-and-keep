-- 이번 주 심연 규칙 (10-20 B안, docs/design/26-replayability-options.md): 매주 월요일 0시(한국)에 바뀌는 규칙 2개 (data/weekly.csv).
-- 주 번호는 시각으로 계산하므로 저장·예약 실행이 없다. 모든 채널·방이 같은 주 번호로 같은 규칙을 고른다.
-- 심연 한 번의 도전은 1층에 들어간 주의 규칙을 끝까지 쓴다 (DepthDirector.Week, 룸 키의 시작 시각).
-- 배율(elite·stat·speed·mobs·light·skel)은 곱하고, 가산(curse·rolls·extract)은 더한다.
@Logic
script WeeklyRules extends Logic

    -- DateTime.UtcNow.Elapsed는 0001-01-01부터의 밀리초 (메이커 실측 10-20: 주 번호 105700). 0001-01-01은 월요일이다.
    -- 한국 월요일 0시 = 일요일 15:00 UTC → 0001-01-07 15:00 = 6일 15시간 (초)
    property integer WeekOffset = 572400

    method integer WeekOf(integer seconds)
        -- UTC 초 → 주 번호
        return math.floor((seconds - self.WeekOffset) / 604800)
    end

    method integer CurrentWeek()
        return self:WeekOf(math.floor(DateTime.UtcNow.Elapsed / 1000))
    end

    method table RulesOf(integer week)
        -- 그 주의 규칙 id 2개 (서로 다르다). 가능한 두 개 조합을 서로소 간격으로 돌아 같은 조합이 연달아 나오지 않고,
        -- 조합 수(규칙 8개면 28)만큼의 주마다 모든 조합이 한 번씩 나온다
        _GameData:Ensure()
        local order = _GameData.WeeklyOrder
        local n = #order
        if n == 0 then return {} end
        if n == 1 then return { order[1] } end
        local pairs2 = {}
        for i = 1, n - 1 do
            for j = i + 1, n do table.insert(pairs2, { order[i], order[j] }) end
        end
        local stride = 11
        while #pairs2 > 1 and self:Gcd(stride, #pairs2) ~= 1 do stride = stride + 2 end
        local pick = pairs2[(week * stride) % #pairs2 + 1]
        return { pick[1], pick[2] }
    end

    method integer Gcd(integer a, integer b)
        while b ~= 0 do a, b = b, a % b end
        return a
    end

    method number Mul(integer week, string key)
        -- 배율 규칙의 곱 (해당 없으면 1)
        local v = 1
        for _, id in ipairs(self:RulesOf(week)) do
            local r = _GameData.Weeklies[id]
            if r ~= nil and r[key] ~= nil then v = v * r[key] end
        end
        return v
    end

    method number Add(integer week, string key)
        -- 가산 규칙의 합 (해당 없으면 0)
        local v = 0
        for _, id in ipairs(self:RulesOf(week)) do
            local r = _GameData.Weeklies[id]
            if r ~= nil and r[key] ~= nil then v = v + r[key] end
        end
        return v
    end

    method integer WeekOfMap(Entity map)
        -- 심연 방이면 그 도전의 주 번호, 아니면 -1 (규칙은 심연에서만)
        if map == nil or not isvalid(map) then return -1 end
        ---@type DepthDirector
        local dd = map:GetComponent("script.DepthDirector")
        if dd == nil or dd.Floor <= 0 or dd.Week <= 0 then return -1 end
        return dd.Week
    end

    method number MapMul(Entity map, string key)
        local week = self:WeekOfMap(map)
        if week < 0 then return 1 end
        return self:Mul(week, key)
    end

    method number MapAdd(Entity map, string key)
        local week = self:WeekOfMap(map)
        if week < 0 then return 0 end
        return self:Add(week, key)
    end

    method string Names(integer week)
        -- 「망자의 주 · 탐욕의 주」
        local names = {}
        for _, id in ipairs(self:RulesOf(week)) do
            local r = _GameData.Weeklies[id]
            if r ~= nil then table.insert(names, r.name) end
        end
        return table.concat(names, " · ")
    end

    method string Describe(integer week, string sep)
        -- 「망자의 주 — 정예 +50% · 그림자 추출 +5%p」 줄들
        local lines = {}
        for _, id in ipairs(self:RulesOf(week)) do
            local r = _GameData.Weeklies[id]
            if r ~= nil then table.insert(lines, r.name .. " — " .. r.desc) end
        end
        return table.concat(lines, sep)
    end

    method string BoardKind(integer act, integer week)
        -- 주간 심연 도전 기록판 (액트별 · 주마다 새 판)
        return "weekrun_a" .. tostring(act) .. "_w" .. tostring(week)
    end

    method string EndsIn()
        -- 「3일 14시간 뒤 바뀜」
        local now = math.floor(DateTime.UtcNow.Elapsed / 1000)
        local left = (self:CurrentWeek() + 1) * 604800 + self.WeekOffset - now
        local d = math.floor(left / 86400)
        local h = math.floor((left % 86400) / 3600)
        if d > 0 then return tostring(d) .. "일 " .. tostring(h) .. "시간 뒤 바뀜" end
        return tostring(h) .. "시간 " .. tostring(math.floor((left % 3600) / 60)) .. "분 뒤 바뀜"
    end

end
