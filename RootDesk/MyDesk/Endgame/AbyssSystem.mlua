-- 심연 열쇠 · 액트별 심도 해금 (10-20 사용자 결정, docs/design/23-depth-descent.md)
--   서버: 액트 마지막 의뢰를 마치면 그 액트 심도가 열리고 심연 열쇠 1개 확정 (캐릭터·난이도·액트마다 한 번).
--         이후 액트 최종 보스를 잡을 때마다 depthKeyChance(5%)로 열쇠 (최대 depthKeyCap개).
--   클라이언트: 마을의 붉은 심도 포탈은 그 액트를 해금한 사람에게만 보이고, 처음 다가가면 안내 창(열쇠·하강 규칙)을 띄운다.
@Logic
script AbyssSystem extends Logic

    property integer TimerId = 0
    property table GuideShown = {}           -- 클라이언트: 액트 → 이번 접속에 안내 창을 띄웠나
    property number GuideRange = 2.6

    method void OnBeginPlay()
        if self:IsServer() then
            _GameEvents:Subscribe("QuestCompleted", "AbyssSystem", function(e) self:OnQuestCompleted(e) end)
            _GameEvents:Subscribe("MonsterKilled", "AbyssSystem", function(e) self:OnMonsterKilled(e) end)
        else
            self.TimerId = _TimerService:SetTimerRepeat(function() self:ClientTick() end, 0.4)
        end
    end

    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
    end

    -- ───────── 서버: 해금 · 열쇠 ─────────

    method boolean IsUnlocked(Entity player, integer act)
        -- 지금 난이도에서 그 액트의 마지막 의뢰까지 마쳤는가 (양쪽에서 쓴다 — PlayerQuest.Index는 동기화된다)
        if not isvalid(player) then return false end
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        return quest ~= nil and quest:IsActDone(act)
    end

    @ExecSpace("ServerOnly")
    method string GrantKey(Entity player, integer act)
        -- 첫 열쇠 기록 키 (PlayerStats.FirstKills에 저장)
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        local diff = stats ~= nil and stats.Difficulty or 0
        return "abysskey:" .. tostring(act) .. "@" .. tostring(diff)
    end

    @ExecSpace("ServerOnly")
    method boolean EnsureFirstKey(Entity player, integer act)
        -- 해금했는데 아직 첫 열쇠를 못 받았으면 1개를 준다 (의뢰 완료 순간 · 예전 저장은 포탈에 다가갈 때). 줬으면 true
        if not isvalid(player) or not self:IsUnlocked(player, act) then return false end
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        if stats == nil then return false end
        local key = self:GrantKey(player, act)
        if stats:HasFirstKill(key) then return false end
        stats:MarkFirstKill(key)
        self:GiveKey(player, "심연 " .. _GameConst:ActRegionName(act) .. " 해금 — 첫 심연 열쇠를 얻었다 (마을의 붉은 포탈)")
        log("[VRF] abyss first key act=" .. tostring(act) .. " user=" .. player.PlayerComponent.UserId)
        return true
    end

    @ExecSpace("ServerOnly")
    method void GiveKey(Entity player, string message)
        ---@type PlayerInventory
        local inv = player:GetComponent("script.PlayerInventory")
        if inv == nil then return end
        local left = inv:AddStack("abyss_key", 1)
        if left > 0 then return end   -- 상한(3개) — AddStack이 안내한다
        local uid = player.PlayerComponent.UserId
        _Util:Notify(message, uid)
        self:KeyToast(message .. " · 보유 " .. tostring(inv:CountStack("abyss_key")) .. "/" .. tostring(math.floor(_GameData.depthKeyCap)), uid)
    end

    @ExecSpace("Client")
    method void KeyToast(string detail)
        -- 열쇠를 얻은 사람에게만: 알림 판 (열쇠 그림)
        _UXFeedback:Show("심연 열쇠 획득", detail, _GameData:GetUiIcon("abyss_key"))
    end

    @ExecSpace("ServerOnly")
    method void OnQuestCompleted(table e)
        -- 액트 마지막 의뢰를 마친 순간 (PlayerQuest가 Index를 올린 뒤에 확인)
        local player = e.player
        if not isvalid(player) then return end
        for act = 1, _GameConst.ActCount do
            if _QuestData:LastOfAct(act) == e.index and _QuestData:ActClosed(act) then
                _TimerService:SetTimerOnce(function() self:EnsureFirstKey(player, act) end, 0.5)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void OnMonsterKilled(table e)
        -- 액트 최종 보스: 심도를 해금한 기여자마다 depthKeyChance로 열쇠 (해금 전 처치는 의뢰 완료가 첫 열쇠를 준다)
        local act = _GameConst:ActOfBossSource(e.sourceId or "")
        if act <= 0 then return end
        for _, p in ipairs(e.players or { e.player }) do
            if isvalid(p) and self:IsUnlocked(p, act) and not self:EnsureFirstKey(p, act) and _UtilLogic:RandomDouble() < _GameData.depthKeyChance then
                self:GiveKey(p, _GameData:GetMonsterName(e.sourceId) .. "에게서 심연 열쇠를 얻었다")
                log("[VRF] abyss key drop act=" .. tostring(act))
            end
        end
    end

    -- ───────── 클라이언트: 붉은 포탈 표시 · 안내 창 ─────────

    @ExecSpace("ClientOnly")
    method void ClientTick()
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(me.CurrentMap) then return end
        for _, g in ipairs(me.CurrentMap:GetChildComponentsByTypeName("script.DepthGate", true)) do
            ---@type DepthGate
            local gate = g
            if gate.Action == "enter" then
                local open = self:IsUnlocked(me, gate.Act)
                -- 해금 전에는 보이지 않는다 (미니맵 표시물도 Entity.Enable을 따른다)
                if gate.Entity.Enable ~= open then gate.Entity.Enable = open end
                if open then
                    gate:Tint()
                    if not self.GuideShown[gate.Act] and (_Util:Pos2(me) - _Util:Pos2(gate.Entity)):Magnitude() <= self.GuideRange then
                        self.GuideShown[gate.Act] = true
                        self:ShowGuide(gate.Act)
                    end
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowGuide(integer act)
        -- 처음 다가가면 (접속마다 한 번) 심도 안내 — 첫 진입 안내 창과 같은 모양 (GuideWindow.ShowCard)
        local band = _GameConst:DepthBand(act, 0)
        ---@type PlayerInventory
        local inv = _UIKit:Comp("script.PlayerInventory")
        local keys = inv ~= nil and inv:CountStack("abyss_key") or 0
        local cap = math.floor(_GameData.depthKeyCap)
        local pct = math.floor(_GameData.depthKeyChance * 100 + 0.5)
        local lines = {
            "<color=#FF6B5A>붉은 포탈</color>은 액트의 끝에서 열리는 심연이다. 층을 내려갈수록 적이 강해지고 보상이 좋아진다.",
            "",
            "<color=#FFD27A>입장</color>  포탈 위에 2초 머무르면 <color=#FF6B5A>심연 열쇠</color> 1개를 쓰고 들어간다. 근처 파티원도 함께 (열쇠는 한 개만). 지금 보유 " .. tostring(keys) .. "/" .. tostring(cap),
            "<color=#FFD27A>열쇠</color>  액트의 마지막 의뢰를 마치면 1개 · 이후 액트 최종 보스를 잡을 때마다 " .. tostring(pct) .. "% · 최대 " .. tostring(cap) .. "개",
            "<color=#FFD27A>적</color>  " .. _GameConst:ActRegionName(act) .. "의 적 · Lv" .. tostring(band.min) .. "~" .. tostring(band.max) .. "에서 멈추고, 층마다 생명·공격 +" .. tostring(math.floor(_GameData.depthStatPerFloor * 100 + 0.5)) .. "% · 2층부터 저주 (10층부터 둘, 20층부터 셋)",
            "<color=#FFD27A>목숨 하나</color>  쓰러지면 그 도전이 끝나고 마을로 돌아온다 (사망 벌칙 없음, 주운 것은 남는다)",
            "<color=#FFD27A>철수</color>  5층마다 보스를 쓰러뜨리면 「더 깊이」와 「철수」를 고른다. 철수하면 큰 보상 상자를 받고 도전을 마친다 — 더 내려가면 상자가 커지지만, 다음 보스 층 전에 쓰러지면 못 받는다",
            "<color=#FFD27A>기록</color>  랭킹 심연 탭 (액트별): 최고 층 → 같은 층이면 빠른 순",
        }
        _GuideWindow:ShowCard("심연 — " .. _GameConst:ActRegionName(act), table.concat(lines, "\n"))
    end

end
