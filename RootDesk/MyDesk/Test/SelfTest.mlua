-- 런타임 자가 진단 (서버). 월드가 시작되면 한 번, 데이터 표·아이템 규칙·이벤트 버스·상수 규칙을 확인하고
-- "[SelfTest] 통과 n / 실패 m" 을 남긴다. 실패 항목은 log_error. 메이커 검증 때 logs 에서 이 줄을 본다.
-- 오프라인 검사(tools/test.cjs)가 못 보는 것 — 실제 엔진에서의 Lua 동작·생성 데이터 로드 — 을 맡는다.
@Logic
script SelfTest extends Logic

    property boolean RunOnStart = true
    property integer Passed = 0
    property integer Failed = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        if not self.RunOnStart then return end
        -- 출시 서버에서는 돌리지 않는다: 방(심연 층 포함)이 생길 때마다 무거운 계산이 한 프레임에 돌고, 일부러 내는 오류가 운영 오류 기록을 더럽혔다 (10-24 출시 점검)
        if Environment:IsPublishedPlay() then return end
        -- 다른 Logic의 OnBeginPlay가 끝난 뒤 돌도록 한 박자 늦춘다
        _TimerService:SetTimerOnce(function() self:RunAll() end, 1)
    end

    @ExecSpace("ServerOnly")
    method void Check(string name, boolean ok, string detail)
        if ok then
            self.Passed = self.Passed + 1
        else
            self.Failed = self.Failed + 1
            log_error("[SelfTest] 실패: " .. name .. " — " .. detail)
        end
    end

    @ExecSpace("ServerOnly")
    method void Run(string name, any fn)
        -- 한 묶음이 터져도 나머지는 계속
        local ok, err = pcall(fn)
        if not ok then self:Check(name, false, "예외 " .. tostring(err)) end
    end

    @ExecSpace("ServerOnly")
    method void RunAll()
        self.Passed = 0
        self.Failed = 0
        self:Run("data", function() self:TestData() end)
        self:Run("items", function() self:TestItems() end)
        self:Run("const", function() self:TestConst() end)
        self:Run("events", function() self:TestEvents() end)
        self:Run("rooms", function() self:TestRooms() end)
        local line = string.format("[SelfTest] 통과 %d / 실패 %d", self.Passed, self.Failed)
        if self.Failed > 0 then log_error(line) else log(line) end
    end

    -- ───────── 묶음 ─────────

    @ExecSpace("ServerOnly")
    method void TestData()
        _GameData:Ensure()
        self:Check("difficulties", _GameData:GetDifficulty(2) ~= nil and _GameData:GetDifficulty(2).suffix == "_hell", "난이도 2 = _hell")
        self:Check("sound town", string.len(_GameData:GetSound("town")) == 32, "sounds.csv town RUID")
        self:Check("resistCap", _GameData.resistCap > 0, "config resistCap")
        self:Check("depth pool", #_GameData:GetDepthPool(1) > 0 and #_GameData:GetDepthPool(2) > 0 and #_GameData:GetDepthPool(3) > 0, "monsters.csv depth=pool · 액트마다")
        self:Check("monster name", _GameData:GetMonsterName("grave_queen") ~= "grave_queen", "monsters.csv 이름")
        self:Check("rank boss", _GameData:GetRank("boss").extract > 0 and _GameData:GetRank("boss").extract < 1, "보스 추출은 확정이 아니다")
        self:Check("rank fallback", _GameData:GetRank("없는등급").extract == _GameData:GetRank("normal").extract, "모르는 등급 = normal")
        -- 그림자 개성: 같은 등급·레벨이라도 원본 몬스터마다 능력치가 다르다
        local crow = _ShadowConfig:GetProfile("corpse_crow", 1, 5, 1)
        local skel = _ShadowConfig:GetProfile("skel_warrior", 1, 5, 1)
        local hound = _ShadowConfig:GetProfile("hellhound", 1, 5, 1)
        self:Check("shadow profile", skel.hp > crow.hp and skel.atk > hound.atk, "해골 전사 > 시체 까마귀·잿불 들개")
        self:Check("shadow element", hound.element == "fire" and hound.ratio > 0, "잿불 들개 그림자는 화염")
        self:Check("shadow level", _ShadowConfig:GetProfile("hellhound", 1, 10, 1).atk > hound.atk, "레벨이 높으면 강하다")
        -- 레벨 차이 보정: Lv10이 Lv31(악몽)을 치면 약 30%, 1레벨 차이까지는 그대로, 그림자 힘은 주인 레벨까지
        local g = _GameConst
        self:Check("level gap dealt", math.abs(g:LevelGapDealt(10, 31) - 0.3) < 0.01 and g:LevelGapDealt(10, 11) == 1 and g:LevelGapDealt(10, 80) == g.LevelGapDmgFloor, "높은 몬스터에게 피해 감소·하한")
        self:Check("level gap taken", g:LevelGapTaken(31, 10) > 1.2 and g:LevelGapTaken(31, 10) <= 1 + g.LevelGapTakenCap and g:LevelGapTaken(10, 31) == 1, "높은 몬스터는 더 아프다")
        self:Check("level gap extract", g:LevelGapExtract(10, 31) < 1 and g:LevelGapExtract(10, 31) >= g.LevelGapExtractFloor and g:LevelGapExtract(31, 10) == 1, "높은 몬스터 혼은 덜 뽑힌다")
        -- 소환수 성장 = 몬스터 곡선 × summonGrowthMul: Lv10·해골 5·숙련 3이면 옛 공식(공격 16·생명 92)보다 세고, 주인 레벨에 따라 큰다
        local sk = _UndeadSystem:GetBaseStats("skeleton", 5, 3, 10)
        local mobHp = 135 * (1 + _GameData.monsterHpPerLevel * 9)
        self:Check("undead vs level", sk.hp > 92 and sk.atk > 16 and sk.hp >= mobHp * 0.3 and _UndeadSystem:GetBaseStats("skeleton", 5, 3, 1).hp < sk.hp, "해골이 옛 공식보다 세고 같은 레벨 몬스터 생명의 30% 이상")
        local sh10 = _ShadowConfig:GetProfile("skel_warrior", 1, 10, 1)
        self:Check("shadow vs level", sh10.hp >= mobHp * 0.4, "Lv10 그림자 생명 ≥ 같은 레벨 몬스터의 40%")
        self:Check("shadow power level", _ShadowConfig:EffectiveLevel(31, 10) == 10 and _ShadowConfig:EffectiveLevel(8, 10) == 8, "그림자 힘 = min(본래, 주인)")
        -- 언데드 수 (D2): 1·2·3·3·3·4 … 20레벨 8
        local u = _UndeadSystem
        self:Check("undead count", u:CountFor(1) == 1 and u:CountFor(3) == 3 and u:CountFor(4) == 3 and u:CountFor(6) == 4 and u:CountFor(20) == 8, "D2 해골 수 규칙")
        self:Check("rally skill", _SkillData:Get("rally") ~= nil and _SkillData:Get("rally").row == 18 and _SkillData:Get("rally").maxLv == 1, "집결은 배워야 쓰는 Lv18 스킬 (1랭크)")
        self:Check("shadow unlock", _SkillData:Get("shadow_summon").row == 5 and _SkillData:Get("raise_skeleton").row == 1, "해골 Lv1, 그림자 Lv5")
        -- 10-11 메인 스킬 + 강화 (docs/design/16): 강화는 메인 스킬에 붙고, 숙련 패시브는 강화로 흡수됐다
        local mastery = _SkillData:Get("skeleton_mastery")
        self:Check("skill nodes", mastery ~= nil and mastery.kind == "node" and mastery.parent == "raise_skeleton" and #_SkillData:NodesOf("shadow_summon") == 3, "단련된 뼈 = 해골 전사 강화, 그림자 소환 강화 3개")
        self:Check("deploy rank", _ShadowConfig:GetDeploySkillBonus(1) == 1 and _ShadowConfig:GetDeploySkillBonus(3) == 3, "그림자 증원 랭크 = 추가 그림자 수")
        -- 10-29 길 위 사건 (기획서 39 #7 A): 액트 3·4 사냥터 16장에 하나씩 · 종류마다 4 · 액트 그림 줄(a3·a4)이 비지 않음
        _GameData:Ensure()
        local roadKinds, roadMaps = {}, 0
        for id, info in pairs(_GameData.MapInfo) do
            if info.roads ~= nil and info.roads ~= "" then
                roadMaps = roadMaps + 1
                for kind in string.gmatch(info.roads, "(%a+)@") do roadKinds[kind] = (roadKinds[kind] or 0) + 1 end
            end
        end
        self:Check("road events", roadMaps == 16 and roadKinds.chest == 4 and roadKinds.shrine == 4 and roadKinds.nest == 4 and roadKinds.ritual == 4, "길 위 사건 맵 " .. tostring(roadMaps) .. " · 상자 " .. tostring(roadKinds.chest) .. " · 신전 " .. tostring(roadKinds.shrine) .. " · 둥지 " .. tostring(roadKinds.nest) .. " · 의식 " .. tostring(roadKinds.ritual))
        self:Check("road art", _GameConst:EventArt(_GameConst.SpriteEventShrine, 3) ~= "" and _GameConst:EventArt(_GameConst.SpriteEventChestOpen, 4) ~= "" and _GameConst:EventArt(_GameConst.SpriteEventAltar, 4) ~= "" and _GameConst:EventArt(_GameConst.SpriteEventShrine, 9) == "", "장치 그림 액트 줄 (a3·a4 · 없는 액트는 빈 값)")
        -- 변종 능력: 무작위는 weight > 0 만, 고유는 표에서
        local rolled = _GameData:RollVariant(0)
        self:Check("variant roll", rolled ~= "" and _GameData:GetVariant(rolled).weight > 0, "무작위 변종 " .. rolled)
        -- 10-24 C안: 오오라 수치·등급 코드, 악몽부터 오오라 + 기술 둘
        local parsed = _GameData:ParseVariant("aura_haste:23+skill_fire")
        self:Check("variant code", #parsed == 2 and parsed[1].value == 23 and parsed[1].tier == 3 and parsed[2].id == "skill_fire" and _GameData:GetVariantOf("aura_haste:23+skill_fire", "skill").id == "skill_fire", "aura_haste:23+skill_fire = 극한 질풍 23% + 화염 폭발")
        self:Check("variant legacy", _GameData:GetVariant("aura_haste").value == 20 and _GameData:GetVariantOf("skill_nova", "aura") == nil, "수치 없는 예전 코드 = 표 값")
        local nm = _GameData:RollVariant(1)
        local nmParts = _GameData:ParseVariant(nm)
        local auraValue = _GameData:RollAuraValue(2)
        self:Check("variant nightmare", #nmParts == 2 and nmParts[1].kind == "aura" and nmParts[2].kind ~= "aura" and auraValue >= 10 and auraValue <= 25, "악몽 우두머리 " .. nm .. " · 지옥 오오라 " .. tostring(auraValue))
        self:Check("variant innate", _GameData:GetMonsterStats("grave_queen").innate == "skill_slam", "여왕 고유 = 내려찍기")
        self:Check("josa ro", _GameConst:WithRo("오아시스 시장") == "오아시스 시장으로" and _GameConst:WithRo("잿불 야영지") == "잿불 야영지로" and _GameConst:WithRo("서울") == "서울로", "받침 → 으로 · 없음/ㄹ → 로")
        self:Check("quests", _QuestData:LastOfAct(1) == 6 and _QuestData:LastOfAct(2) == 12 and _QuestData:Count() >= 13 and _QuestData:Get(13).act == 3, "quests.csv 액트 1 6개 + 액트 2 6개 + 액트 3 (13번부터), 실제 " .. tostring(_QuestData:Count()))
        self:Check("act3 data", _GameData:GetMonsterStats("storm_caller").chain == 4 and _GameData:GetMonsterStats("spark_eel").chain == 2 and _GameConst:TownOfAct(3) == "harbor" and _GameConst:ActRegionName(3) == "폭풍 해안", "번개 연쇄 4·2 · 액트 3 마을 = 소금바람 항구")
        for _, id in ipairs(_SkillData:GetOrder()) do
            local def = _SkillData:Get(id)
            self:Check("skill " .. id, def ~= nil and (def.prereq == "" or _SkillData:Get(def.prereq) ~= nil), "선행 스킬")
        end
        for _, w in ipairs(_WaypointData:GetList()) do
            self:Check("waypoint " .. w.id, _WaypointData:Get(w.id) ~= nil, "Get(id)")
        end
    end

    @ExecSpace("ServerOnly")
    method void TestItems()
        -- 생성 → 문자열 → 해석 → 문자열이 같아야 저장·거래가 안전하다
        for i = 1, 30 do
            local ranks = { "normal", "elite", "boss", "gamble" }
            local s = _ItemData:Generate(1 + (i * 7) % 60, ranks[1 + i % 4], 50)
            local again = _ItemData:Serialize(_ItemData:Parse(s))
            self:Check("item roundtrip", again == s, s .. " → " .. again)
            self:Check("item describe", _ItemData:Describe(s) ~= "", s)
        end
        -- 잠금 (10-29 기획서 45 결정 6-A): 물건 문자열 9번째 칸 "L" — 잠그고 풀어도 물건은 그대로, 옵션 바꾸기·소켓 뚫기 뒤에도 잠긴 채, 겹치는 물건은 잠그지 않는다
        local plain = _ItemData:Generate(30, "gamble", 0)
        local locked = _ItemData:WithLock(plain, true)
        self:Check("lock flag", _ItemData:IsLocked(locked) and not _ItemData:IsLocked(plain), locked)
        self:Check("lock roundtrip", _ItemData:Serialize(_ItemData:Parse(locked)) == locked, locked)
        self:Check("lock undo", _ItemData:WithLock(locked, false) == plain, _ItemData:WithLock(locked, false) .. " / " .. plain)
        self:Check("lock same item", _ItemData:SameItem(plain, locked) and not _ItemData:SameItem(plain, _ItemData:WithLock(_ItemData:MakeRune(20), true)), locked)
        if _ItemData:CanReroll(locked) then self:Check("lock keeps reroll", _ItemData:IsLocked(_ItemData:RerollMods(locked)), locked) end
        if _ItemData:CanPunch(locked) then self:Check("lock keeps punch", _ItemData:IsLocked(_ItemData:PunchSockets(locked)), locked) end
        self:Check("lock rune", _ItemData:CanLock(_ItemData:MakeRune(20)), _ItemData:MakeRune(20))
        self:Check("lock stack", not _ItemData:CanLock(_ItemData:MakeStack("hp1", 3)) and not _ItemData:CanLock(_ItemData:MakeStack("essence", 3)), "hp1 · essence")
        local lockedRune = _ItemData:WithLock(_ItemData:MakeRune(20), true)
        self:Check("lock shadow rune", _ShadowConfig:FindUpgradeRune({ lockedRune }, 1) == 0 and _ShadowConfig:HasLockedUpgradeRune({ lockedRune }, 1), lockedRune)
        log("[VRF] selftest lock checks done")
        for lv = 1, 80, 13 do
            local r = _ItemData:MakeRune(lv)
            self:Check("rune drop", _ItemData:IsRune(_ItemData:Parse(r).base), r)
            self:Check("rune level", _ItemData:GetRune(_ItemData:Parse(r).base).minLevel <= lv, r .. " @Lv" .. tostring(lv))
        end
        local t = _ItemData:T()
        for key, rw in pairs(t.Runewords) do
            for id in string.gmatch(key, "[^,]+") do self:Check("runeword rune", t.Runes[id] ~= nil, rw.name .. " → " .. id) end
        end
        self:Check("stat names", _ItemData:StatName("fireRes") ~= "fireRes", "stats.csv")
        -- 계열 능력치 (docs/design/19): 이름표, 레벨형은 배율로 줄이지 않는다
        self:Check("tree stats", _ItemData:StatName("treeCommand") == "소환 스킬 레벨" and _ItemData:StatName("sk_bone_spear") == "뼈 창 레벨" and _ItemData:StatValueText("sk_raise_skeleton", 2) == "해골 전사 레벨 +2" and _ItemData:IsCountStat("treeSoul") and _ItemData:IsCountStat("sk_bone_spear") and not _ItemData:IsCountStat("spellDmg"), _ItemData:StatName("sk_bone_spear") .. " · " .. _ItemData:StatValueText("sk_raise_skeleton", 2))
        self:Check("tree scale", _ItemData:ScaleMods("treeCurse=2,sk_bone_spear=3") == "treeCurse=2,sk_bone_spear=3", _ItemData:ScaleMods("treeCurse=2,sk_bone_spear=3"))
        -- 베이스 3등급 · 옵션 난이도 구간 (docs/design/19 2단계)
        local slotsByGrade = { {}, {}, {} }
        for _, id in ipairs(t.BaseOrder) do
            local b = t.Bases[id]
            slotsByGrade[(b.grade or 0) + 1][b.slot] = true
        end
        local gradeOk = true
        for g = 1, 3 do
            for _, slot in ipairs({ "weapon", "offhand", "helm", "armor", "gloves", "boots", "belt", "amulet", "ring" }) do
                if not slotsByGrade[g][slot] then gradeOk = false end
            end
        end
        self:Check("base grades", gradeOk, "일반·강화·정예형마다 9부위 베이스가 있다")
        local hellBaseOk, lowAffixOk, highAffixOk = true, true, true
        for i = 1, 25 do
            local hb = t.Bases[_ItemData:PickBase(80)]
            if hb.reqLv < 40 then hellBaseOk = false end
            local hi = _ItemData:PickAffix(i % 2 == 0, "amulet", 75, {})
            if hi ~= nil and hi.tier < 1 then highAffixOk = false end
            local lo = _ItemData:PickAffix(i % 2 == 0, "amulet", 15, {})
            if lo ~= nil and lo.tier ~= 0 then lowAffixOk = false end
        end
        self:Check("hell bases", hellBaseOk, "아이템 레벨 80 베이스는 요구 레벨 40 이상")
        self:Check("affix tiers", lowAffixOk and highAffixOk, "보통은 보통 구간 옵션만, 지옥은 악몽·지옥 구간만")
        local tierRow = nil
        for _, a in ipairs(t.Affixes) do if a.id == "treeSoul_p2" then tierRow = a end end
        local skillRoll = tierRow ~= nil and _ItemData:RollAffix(tierRow, 90) or 0
        self:Check("tree affix roll", skillRoll >= 2 and skillRoll <= 3, "지옥 「명계 술사의」 영혼 스킬 +" .. tostring(skillRoll))
        -- 쏠림 막기 (docs/design/19 §2-4): 유니크는 계열 먼저, 세트는 세트 먼저 고른다
        local treeCount, treeKinds = {}, 0
        local setCount, setKinds = {}, 0
        for i = 1, 120 do
            local pu = _ItemData:PickUnique(85, "")
            if pu ~= nil then
                if treeCount[pu.tree] == nil then treeKinds = treeKinds + 1 end
                treeCount[pu.tree] = (treeCount[pu.tree] or 0) + 1
            end
            local ps = _ItemData:PickSetPiece(30)   -- 세트 조각은 일반·강화형 베이스부터 있다 (정예 세트는 3단계 초안)
            if ps ~= nil then
                if setCount[ps.set] == nil then setKinds = setKinds + 1 end
                setCount[ps.set] = (setCount[ps.set] or 0) + 1
            end
        end
        local tmin, tmax = 999, 0
        for _, c in pairs(treeCount) do tmin = math.min(tmin, c) tmax = math.max(tmax, c) end
        self:Check("unique tree spread", treeKinds <= 1 or tmax <= tmin * 3, "계열별 유니크 " .. tostring(tmin) .. "~" .. tostring(tmax) .. " (계열 " .. tostring(treeKinds) .. ")")
        self:Check("set spread", setKinds >= 1, "세트 " .. tostring(setKinds) .. "종이 나옴")
        -- 아이템 도감 (docs/design/19 §2-6): 유니크·세트 조각·룬워드가 모두 목록에 있고, 만든 아이템의 key를 찾는다
        local nRw = 0
        for _ in pairs(t.Runewords) do nRw = nRw + 1 end
        local grail = _ItemData:GrailList()
        self:Check("grail list", #grail == #t.UniqueList + #t.SetPieceOrder + nRw, tostring(#grail) .. "칸")
        local firstU = t.UniqueList[1]
        local uKey = _ItemData:GrailKeyOf(_ItemData:MakeUnique(firstU, 10))
        local firstPiece = t.SetPieces[t.SetPieceOrder[1]]
        local sKey = _ItemData:GrailKeyOf(firstPiece.base .. "|4|10|" .. firstPiece.name .. "||0|")
        self:Check("grail keys", uKey == "u:" .. firstU.id and sKey == "s:" .. firstPiece.base and _ItemData:GrailKeyOf("scythe1|0|1|단낫||0|") == "", uKey .. " · " .. sKey)
        self:Check("tree names", _SkillData:TreeName("command") == "소환" and _SkillData:TreeName("soul") == "주문" and _SkillData:TreeName("curse") == "저주", "소환·영혼·저주")
        self:Check("boss unique", _ItemData:PickUnique(12, "grave_queen") ~= nil, "여왕 전용 유니크")
        self:Check("act2 boss", _ItemData:PickUnique(21, "high_priest") ~= nil, "대사제 전용 유니크")
        self:Check("act3 boss", _ItemData:PickUnique(30, "admiral") ~= nil and _GameData.levelCap == 99 and _GameConst:ScaleLevel(1, 1) == 41 and _GameConst:ScaleLevel(40, 1) == 70 and _GameConst:ScaleLevel(1, 2) == 71 and _GameConst:ScaleLevel(40, 2) == 99, "바렌 전용 유니크 · 상한 99 · 레벨 구간 보통 1~40 → 악몽 41~70 · 지옥 71~99 (10-20)")
        self:Check("act4", _GameConst.FinalBossSourceId == "ash_king" and _ItemData:PickUnique(42, "ash_king") ~= nil and _GameConst.ActCount == 4 and _GameConst:TownOfAct(4) == "outpost" and _QuestData:ActClosed(4) and string.find(_GameConst.SoulThieves, ",hell_priest,", 1, true) ~= nil, "재의 왕 = 난이도 개방 · 전용 유니크 · 액트 4 마을 = 마지막 초소 · 의뢰 24로 액트 끝 · 혼 빼앗기 사제")
        self:Check("drop table", _ItemData:GetDropTable("normal").unique < _ItemData:GetDropTable("boss").unique, "보스가 유니크를 더 잘 준다")
        -- 잿빛 장막 유니크 5종: 가중치가 모든 유니크 중 가장 낮다 (가장 희귀)
        local ashenMax, otherMin, ashenN = 0, 1, 0
        for _, u in ipairs(t.UniqueList) do
            if string.sub(u.id, 1, 11) == "ashen_veil_" then
                ashenN = ashenN + 1
                ashenMax = math.max(ashenMax, u.weight or 1)
            else
                otherMin = math.min(otherMin, u.weight or 1)
            end
        end
        self:Check("ashen uniques rarest", ashenN == 5 and ashenMax < otherMin, "잿빛 장막 5종 가중치 < 다른 유니크")
        -- 귀환 두루마리는 물약처럼 가방에 겹치는 물건 (10-11)
        local tpStack = _ItemData:MakeStack("tp", 3)
        self:Check("town scroll stack", _ItemData:IsStack("tp") and _ItemData:Parse(tpStack).count == 3 and _ItemData:StackName("tp") == "귀환 두루마리", "귀환 두루마리 = 가방 물건 (겹침 3)")
        -- 세트: 그림자 상한은 정예형 세트 완성 효과만 (10-12 결정 · docs/design/19 §5)
        self:Check("set full", (_ItemData:GetSetBonusMods("ashen_legion", 4).shadowCap or 0) == 0 and (_ItemData:GetSetBonusMods("lich_host", 4).shadowCap or 0) == 1, "잿빛 군단 완성 = 상한 없음 · 망자 군주의 군기 완성 = 상한 +1")
        -- 보스 전용 유니크: 그 난이도에서 나올 수 있는 가장 높은 등급만 (지옥 처형인 Lv69 → 정예형)
        local hellBoss = _ItemData:PickUnique(69, "headsman")
        local hellBase = hellBoss ~= nil and t.Bases[hellBoss.base] or nil
        self:Check("boss unique grade", hellBase ~= nil and (hellBase.grade or 0) == 2, hellBoss ~= nil and hellBoss.name or "없음")
        self:Check("set partial", (_ItemData:GetSetBonusMods("ashen_legion", 2).shadowCap or 0) == 0, "2개는 상한 효과 없음")
        local piece = _ItemData:PickSetPiece(5)
        self:Check("set piece", piece ~= nil and _ItemData:GetSetPiece({ base = piece.base, rarity = 4 }) ~= nil, "Lv5 세트 조각")
    end

    @ExecSpace("ServerOnly")
    method void TestConst()
        self:Check("base map", _GameConst:BaseMapName("wasteland_nm") == "wasteland" and _GameConst:BaseMapName("town_hell") == "town" and _GameConst:BaseMapName("wasteland") == "wasteland", "난이도 접미사 떼기")
        self:Check("map spawns", _GameData:GetMapSpawns("wasteland") ~= nil and _GameData:GetMapSpawns("town") == nil, "maps.csv 출현 데이터")
        self:Check("MapFor", _GameConst:MapFor("wasteland", 1) == "wasteland_nm" and _GameConst:MapFor("wasteland", 0) == "wasteland", "난이도 맵 이름")
        local key = _GameConst:MakeDepthKey(7, 2, 3, "abc~12")
        local k = _GameConst:ParseDepthKey(key)
        self:Check("depth key", k.floor == 7 and k.difficulty == 2 and k.act == 3 and k.nonce == "abc~12", key)
        local band = _GameConst:DepthBand(1, 0)
        self:Check("depth band", band.min == 12 and band.max == 16 and _GameConst:DepthBand(2, 0).min == 21, "액트 1 Lv12~16 · 액트 2 Lv21~")
        self:Check("abyss key", _ItemData:IsStack("abyss_key") and _ItemData:IsSoulbound("abyss_key") and _ItemData:StackLimit("abyss_key") == 3 and _GameConst:ActOfBossSource("high_priest") == 2, "심연 열쇠 · 액트 보스")
        self:Check("resist penalty", _GameConst:ResistPenalty(0) == 0 and _GameConst:ResistPenalty(2) > _GameConst:ResistPenalty(1), "보통 0 < 악몽 < 지옥")
        self:Check("death exp", _GameConst:DeathExpLossPct(0) == 0 and _GameConst:DeathExpLossPct(2) == 10, "D2: 보통 0, 지옥 10%")
    end

    @ExecSpace("ServerOnly")
    method void TestEvents()
        -- 구독자 하나가 터져도 다른 구독자는 받는다 (Emit의 pcall 격리)
        local got = 0
        _GameEvents:Subscribe("SelfTestEvent", "boom(의도한 실패·무시)", function(p) error("의도한 오류") end)
        _GameEvents:Subscribe("SelfTestEvent", "count", function(p) got = got + p.n end)
        _GameEvents:Emit("SelfTestEvent", { n = 2 })
        self:Check("event isolation", got == 2, "got " .. tostring(got))
        _GameEvents:Unsubscribe("SelfTestEvent", "boom(의도한 실패·무시)")
        _GameEvents:Unsubscribe("SelfTestEvent", "count")
        _GameEvents:Emit("SelfTestEvent", { n = 5 })
        self:Check("event unsubscribe", got == 2, "got " .. tostring(got))
    end

    @ExecSpace("ServerOnly")
    method void TestRooms()
        -- 채널 고르기 (ChannelSystem.Fit · docs/design/30 §3)
        local list = { { id = "A", cur = 18, max = 20 }, { id = "B", cur = 12, max = 20 }, { id = "C", cur = 3, max = 20 } }
        local fit = _ChannelSystem:Fit(list, {}, { ["*"] = 4 })
        self:Check("fit pack", fit ~= nil and fit.id == "B", "4명 → 자리 있는 곳 중 가장 붐비는 B")
        fit = _ChannelSystem:Fit(list, { B = 6 }, { ["*"] = 4 })
        self:Check("fit pending", fit ~= nil and fit.id == "C", "B는 곧 올 6자리 → C")
        fit = _ChannelSystem:Fit(list, {}, { A = 1, B = 4, C = 4 })
        self:Check("fit already there", fit ~= nil and fit.id == "A", "A에 이미 3명 → 1명만 더: 18+1 ≤ 20, 가장 붐비는 A")
        self:Check("fit none", _ChannelSystem:Fit({ { id = "A", cur = 20, max = 20 } }, {}, { ["*"] = 1 }) == nil, "가득 → 없음")
        -- 곧 올 자리: 출발 1초 뒤 파티 3명 중 1명 도착 + 기다리는 친구 1명
        local now = DateTime.UtcNow.Elapsed
        local pend = _RoomSystem:PendingByChannel({ r1 = { ch = "B", s = "go", g = now - 1000, a = 1, w = { a = {}, b = {}, c = {} }, q = { z = now } }, r2 = { ch = "B", s = "wait", w = { d = {} } } })
        self:Check("pending seats", pend.B == 3, "2 + 1, 모집 중 방은 세지 않는다 (" .. tostring(pend.B) .. ")")
        -- 사용자 시나리오 (10-22): 30명이 차례로 · 솔로 5 · 4인 친구 1팀 · 3인 친구 2팀 · 나머지 공개. 친구는 흩어져 도착해 모인 뒤 출발
        for _, cap in ipairs({ 20, 6 }) do
            local r = self:SimRooms(cap)
            self:Check("sim kicks " .. tostring(cap), r.kicks == 0, "가득 찬 채널로 옮기기 " .. tostring(r.kicks))
            self:Check("sim together " .. tostring(cap), r.split == 0, "출발한 팀이 갈라짐 " .. tostring(r.split))
            if cap == 20 then self:Check("sim all started", r.started == 3 and r.channels == 2, "팀 3개 출발 · 채널 " .. tostring(r.channels)) end
            log(string.format("[VRF] room sim cap=%d channels=%d started=%d waiting=%d moves=%d", cap, r.channels, r.started, r.waiting, r.moves))
        end
    end

    method table SimRooms(integer cap)
        -- 엔진 흉내: 새로 온 사람은 빈자리 채널 중 가장 붐비는 곳, 없으면 새 채널. 팀은 마지막 사람이 오면 Fit으로 고른 채널에 함께 모인다
        local list = {}
        local where = {}   -- 사람 → 채널 표
        local function engine()
            local best = nil
            for _, w in ipairs(list) do if w.cur < w.max and (best == nil or w.cur > best.cur) then best = w end end
            if best == nil then
                best = { id = "ch" .. tostring(#list + 1), cur = 0, max = cap }
                table.insert(list, best)
            end
            best.cur = best.cur + 1
            return best
        end
        local order = { "s", "p", "T4", "p", "s", "T3a", "p", "T4", "p", "T3b", "s", "p", "T3a", "p", "T4", "p", "T3b", "p", "s", "T3a", "p", "T4", "p", "T3b", "p", "s", "p", "p", "p", "p" }
        local size = { T4 = 4, T3a = 3, T3b = 3 }
        local members = { T4 = {}, T3a = {}, T3b = {} }
        local out = { kicks = 0, split = 0, started = 0, waiting = 0, moves = 0, channels = 0 }
        for i, who in ipairs(order) do
            local w = engine()
            where[i] = w
            if members[who] ~= nil then
                table.insert(members[who], i)
                if #members[who] == size[who] then
                    local need = {}
                    for _, c in ipairs(list) do
                        local there = 0
                        for _, m in ipairs(members[who]) do if where[m] == c then there = there + 1 end end
                        need[c.id] = size[who] - there
                    end
                    local target = _ChannelSystem:Fit(list, {}, need)
                    if target == nil then
                        out.waiting = out.waiting + 1
                    else
                        for _, m in ipairs(members[who]) do
                            if where[m] ~= target then
                                if target.cur >= target.max then out.kicks = out.kicks + 1 end
                                where[m].cur = where[m].cur - 1
                                target.cur = target.cur + 1
                                where[m] = target
                                out.moves = out.moves + 1
                            end
                        end
                        for _, m in ipairs(members[who]) do if where[m] ~= target then out.split = out.split + 1 end end
                        out.started = out.started + 1
                    end
                end
            end
        end
        out.channels = #list
        return out
    end

end
