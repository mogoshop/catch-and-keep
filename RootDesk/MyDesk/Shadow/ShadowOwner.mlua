-- 플레이어별 그림자 보관함. ShadowSystem이 입장한 플레이어에게 붙인다.
-- 보관함의 그림자는 엔티티가 아니라 데이터 행이다. 소환할 때만 엔티티가 된다.
-- Phase 0은 저장 없이 세션 단위로 동작한다. (설계 6장 "저장")
@Component
script ShadowOwner extends Component

    -- id → { id, sourceId, grade, level, deployed, respawnReadyAt }
    property table Storage = {}
    property integer NextSerial = 1

    -- HUD 표시용
    @Sync
    property integer Essence = 0
    @Sync
    property integer StorageCount = 0
    @Sync
    property integer DeployedCount = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 인스턴스마다 새 테이블을 쓴다 (기본값 테이블 공유 방지)
        self.Storage = {}
        log("[ShadowOwner] 준비 완료: " .. self.Entity.Name)
    end

    @ExecSpace("ServerOnly")
    method string AddShadow(string sourceId, integer grade)
        -- 추출 성공 시 호출된다. 생성된 그림자 id를 반환
        local id = self.Entity.Id .. "_" .. tostring(self.NextSerial)
        self.NextSerial = self.NextSerial + 1
        self.Storage[id] = {
            id = id,
            sourceId = sourceId,
            grade = grade,
            level = 1,
            deployed = false,
            respawnReadyAt = 0,
        }
        self.StorageCount = self.StorageCount + 1
        log("[ShadowOwner] 추출 " .. sourceId .. " 등급" .. tostring(grade) .. " → 보관 " .. tostring(self.StorageCount))
        return id
    end

    @ExecSpace("ServerOnly")
    method boolean Disassemble(string id)
        -- 보관 중(소환 중 아님)인 그림자를 정수로 바꾼다
        local shadow = self.Storage[id]
        if shadow == nil or shadow.deployed then return false end
        local yield = _ShadowConfig:GetDisassembleYield(shadow.grade)
        if yield <= 0 then return false end
        self.Storage[id] = nil
        self.StorageCount = self.StorageCount - 1
        self.Essence = self.Essence + yield
        log("[ShadowOwner] 분해 " .. id .. " +" .. tostring(yield) .. " → 정수 " .. tostring(self.Essence))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean Upgrade(string id)
        -- 정수를 써서 레벨 +1 (Phase 0 임시 소비처)
        local shadow = self.Storage[id]
        if shadow == nil then return false end
        local cost = _ShadowConfig:GetUpgradeCost(shadow.level)
        if self.Essence < cost then return false end
        self.Essence = self.Essence - cost
        shadow.level = shadow.level + 1
        log("[ShadowOwner] 강화 " .. id .. " Lv" .. tostring(shadow.level) .. " → 정수 " .. tostring(self.Essence))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean CanDeploy(string id)
        -- 소환 가능 여부만 판단한다. 실제 소환(엔티티 생성)은 0-4에서 붙인다
        local shadow = self.Storage[id]
        if shadow == nil or shadow.deployed then return false end
        if self.DeployedCount >= _ShadowConfig:GetDeployLimit(0) then return false end
        return _UtilLogic.ServerElapsedSeconds >= shadow.respawnReadyAt
    end

end
