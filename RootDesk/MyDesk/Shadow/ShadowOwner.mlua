-- 그림자 보관함 (플레이어별 데이터). 보관함의 그림자는 엔티티가 아니라 데이터 행이고, 소환은 ShadowCommander가 맡는다.
-- 책임: 행 추가·분해·강화, UI용 요약 문자열, 저장/불러오기.
-- 행: id → { id, sourceId, grade, level, variant, deployed, slot, respawnReadyAt, standRuid, moveRuid }
@Component
script ShadowOwner extends Component

    property table Storage = {}
    property integer NextSerial = 1

    @Sync
    property integer Essence = 0
    @Sync
    property integer StorageCount = 0
    @Sync
    property string StorageDigest = ""       -- "id|sourceId|grade|level|deployed|readyAt|variant;..."

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 인스턴스마다 새 표 (기본값 표 공유 방지)
        self.Storage = {}
    end

    method ShadowCommander Commander()
        ---@type ShadowCommander
        local c = self.Entity:GetComponent("script.ShadowCommander")
        return c
    end

    @ExecSpace("ServerOnly")
    method any GetShadow(string id)
        return self.Storage[id]
    end

    -- ───────── 보관함 조작 (서버) ─────────

    @ExecSpace("ServerOnly")
    method string AddShadow(string sourceId, integer grade, integer level, string variant, string standRuid, string moveRuid)
        -- 추출 성공 시 호출. 시작 레벨 = 처치한 몬스터 레벨 (뒤 지역 그림자가 자연히 강하다). 생성된 id 반환
        local id = self.Entity.Id .. "_" .. tostring(self.NextSerial)
        self.NextSerial = self.NextSerial + 1
        self.Storage[id] = { id = id, sourceId = sourceId, grade = grade, level = math.max(1, level), variant = variant, deployed = false, slot = 0, respawnReadyAt = 0, standRuid = standRuid, moveRuid = moveRuid }
        self.StorageCount = self.StorageCount + 1
        self:RefreshDigest()
        return id
    end

    @ExecSpace("ServerOnly")
    method boolean Disassemble(string id)
        -- 소환 중이 아닌 그림자 → 정수
        local shadow = self.Storage[id]
        if shadow == nil or shadow.deployed then return false end
        local yield = _ShadowConfig:GetDisassembleYield(shadow.grade)
        if yield <= 0 then return false end
        self.Storage[id] = nil
        self.StorageCount = self.StorageCount - 1
        self.Essence = self.Essence + yield
        self:RefreshDigest()
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean Upgrade(string id)
        -- 정수로 레벨 +1. 소환 중이면 능력치도 즉시 반영
        local shadow = self.Storage[id]
        if shadow == nil then return false end
        -- 그림자 레벨은 주인 레벨을 넘을 수 없다
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil and shadow.level >= stats.Level then
            _Util:Notify("그림자 레벨은 주인 레벨(" .. tostring(stats.Level) .. ")을 넘을 수 없다", self.Entity.PlayerComponent.UserId)
            return false
        end
        local cost = _ShadowConfig:GetUpgradeCost(shadow.level)
        if self.Essence < cost then return false end
        self.Essence = self.Essence - cost
        shadow.level = shadow.level + 1
        local commander = self:Commander()
        if commander ~= nil then commander:RefreshUnitStats(id) end
        self:RefreshDigest()
        return true
    end

    @ExecSpace("ServerOnly")
    method void RefreshDigest()
        -- 클라이언트 UI용 (table은 동기화할 수 없다). 마지막 칸은 재소환 가능 시각(서버 경과 초)
        local rows = {}
        for id, s in pairs(self.Storage) do
            table.insert(rows, string.format("%s|%s|%d|%d|%d|%.1f|%s", id, s.sourceId, s.grade, s.level, s.deployed and 1 or 0, s.respawnReadyAt, s.variant or ""))
        end
        table.sort(rows)
        self.StorageDigest = table.concat(rows, ";")
    end

    -- ───────── 클라이언트 요청 ─────────

    @ExecSpace("Server")
    method void RequestDisassemble(string id)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        self:Disassemble(id)
    end

    @ExecSpace("Server")
    method void RequestUpgrade(string id)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        self:Upgrade(id)
    end

    -- ───────── 저장 (PlayerSave) ─────────

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        -- d = 소환·이동 대기, h = 남은 체력 비율, p = 시전 당시 승격 배율. 기존 저장에는 h/p가 없어도 된다.
        local wanted = {}
        local commander = self:Commander()
        if commander ~= nil then for _, id in ipairs(commander.Wanted) do wanted[id] = true end end
        local list = {}
        for id, s in pairs(self.Storage) do
            local entry = { src = s.sourceId, g = s.grade, lv = s.level, va = s.variant or "", st = s.standRuid, mv = s.moveRuid }
            if s.deployed or wanted[id] then
                local state = commander ~= nil and commander:GetTravelState(id) or nil
                if state == nil or state.health > 0 then
                    entry.d = true
                    if state ~= nil then entry.h = state.health entry.p = state.promotion end
                end
            end
            table.insert(list, entry)
        end
        local saved = { essence = self.Essence, shadowCount = #list }
        if #list > 0 then saved.shadows = list end
        return saved
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table data)
        -- 새 id로 다시 만든다 (id에는 세션마다 바뀌는 엔티티 id가 들어간다)
        if data == nil then return end
        local commander = self:Commander()
        if commander ~= nil then commander:RecallAll() end
        self.Storage = {}
        self.StorageCount = 0
        self.Essence = data.essence or 0
        local redeploy = {}
        if data.shadows ~= nil then
            for _, s in ipairs(data.shadows) do
                local id = self:AddShadow(s.src or "", s.g or 1, s.lv or 1, s.va or "", s.st or "", s.mv or "")
                if s.d then
                    -- 구 저장은 체력·승격 필드가 없으므로 이전처럼 일반 개체로 복원한다.
                    local health = tonumber(s.h) or 1
                    local promotion = tonumber(s.p) or 1
                    if health ~= health then health = 1 end
                    if promotion ~= promotion then promotion = 1 end
                    local maxPromotion = _GameData.elitePromoteBaseMul + _GameData.elitePromotePerLvMul * (_SkillData:Get("elite_promote").maxLv - 1)
                    if health > 0 then
                        table.insert(redeploy, id)
                        if commander ~= nil then
                            commander.TravelStates[id] = { health = math.min(1, health), promotion = math.max(1, math.min(maxPromotion, promotion)) }
                        end
                    end
                end
            end
        end
        self:RefreshDigest()
        if commander ~= nil and #redeploy > 0 then
            commander.Wanted = redeploy
            commander:ScheduleRedeploy(2)
        end
    end

end
