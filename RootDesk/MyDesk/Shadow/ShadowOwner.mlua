-- 플레이어별 그림자 보관함. DefaultPlayer 모델에 붙어 있다 (없으면 ShadowSystem이 런타임에 붙인다).
-- 보관함의 그림자는 엔티티가 아니라 데이터 행이다. 소환할 때만 엔티티가 된다.
-- Phase 0은 저장 없이 세션 단위로 동작한다. (설계 6장 "저장")
@Component
script ShadowOwner extends Component

    property string UnitModelId = "shadowunit"
    property number RallySeconds = 2.5

    -- id → { id, sourceId, grade, level, deployed, respawnReadyAt, standRuid, moveRuid }
    property table Storage = {}
    -- id → 소환된 그림자 엔티티
    property table Units = {}
    property integer NextSerial = 1

    -- HUD 표시용 (서버 → 클라이언트)
    @Sync
    property integer Essence = 0
    @Sync
    property integer StorageCount = 0
    @Sync
    property integer DeployedCount = 0
    -- 보관함 목록을 UI에 보내기 위한 직렬화 문자열 (id|sourceId|grade|level|deployed;...)
    @Sync
    property string StorageDigest = ""

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 인스턴스마다 새 테이블을 쓴다 (기본값 테이블 공유 방지)
        self.Storage = {}
        self.Units = {}
        log("[ShadowOwner] 준비 완료: " .. self.Entity.Name)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- 주인이 나가면 소환된 그림자를 모두 정리
        for id, unit in pairs(self.Units) do
            if isvalid(unit) then unit:Destroy() end
        end
        self.Units = {}
    end

    -- ───────── 보관함 데이터 (서버) ─────────

    @ExecSpace("ServerOnly")
    method string AddShadow(string sourceId, integer grade, string standRuid, string moveRuid)
        -- 추출 성공 시 호출된다. 생성된 그림자 id를 반환
        local id = self.Entity.Id .. "_" .. tostring(self.NextSerial)
        self.NextSerial = self.NextSerial + 1
        self.Storage[id] = {
            id = id,
            sourceId = sourceId,
            grade = grade,
            level = 1,
            deployed = false,
            respawnReadyAt = 0,
            standRuid = standRuid,
            moveRuid = moveRuid,
        }
        self.StorageCount = self.StorageCount + 1
        self:RefreshDigest()
        log("[ShadowOwner] 추출 " .. sourceId .. " 등급" .. tostring(grade) .. " → 보관 " .. tostring(self.StorageCount))
        return id
    end

    @ExecSpace("ServerOnly")
    method boolean Disassemble(string id)
        -- 보관 중(소환 중 아님)인 그림자를 정수로 바꾼다
        local shadow = self.Storage[id]
        if shadow == nil or shadow.deployed then return false end
        local yield = _ShadowConfig:GetDisassembleYield(shadow.grade)
        if yield <= 0 then return false end
        self.Storage[id] = nil
        self.StorageCount = self.StorageCount - 1
        self.Essence = self.Essence + yield
        self:RefreshDigest()
        log("[ShadowOwner] 분해 " .. id .. " +" .. tostring(yield) .. " → 정수 " .. tostring(self.Essence))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean Upgrade(string id)
        -- 정수를 써서 레벨 +1 (Phase 0 임시 소비처). 소환 중이면 공격력도 즉시 반영
        local shadow = self.Storage[id]
        if shadow == nil then return false end
        local cost = _ShadowConfig:GetUpgradeCost(shadow.level)
        if self.Essence < cost then return false end
        self.Essence = self.Essence - cost
        shadow.level = shadow.level + 1
        local unit = self.Units[id]
        if isvalid(unit) then
            ---@type ShadowUnit
            local comp = unit:GetComponent("script.ShadowUnit")
            if comp ~= nil then comp.Atk = _ShadowConfig:GetShadowAtk(shadow.grade, shadow.level) end
        end
        self:RefreshDigest()
        log("[ShadowOwner] 강화 " .. id .. " Lv" .. tostring(shadow.level) .. " → 정수 " .. tostring(self.Essence))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean CanDeploy(string id)
        -- 소환 가능 여부
        local shadow = self.Storage[id]
        if shadow == nil or shadow.deployed then return false end
        if self.DeployedCount >= _ShadowConfig:GetDeployLimit(0) then return false end
        return _UtilLogic.ServerElapsedSeconds >= shadow.respawnReadyAt
    end

    -- ───────── 소환 / 회수 / 집결 (서버) ─────────

    @ExecSpace("ServerOnly")
    method boolean Deploy(string id)
        -- 보관함의 그림자를 엔티티로 만들어 주인 곁에 소환한다
        if not self:CanDeploy(id) then return false end
        local shadow = self.Storage[id]
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return false end
        local p = self.Entity.TransformComponent.WorldPosition
        local offsetX = (self.DeployedCount % 2 == 0) and -0.6 or 0.6
        local unit = _SpawnService:SpawnByModelId(self.UnitModelId, "Shadow_" .. shadow.sourceId, Vector3(p.x + offsetX, p.y + 0.3, p.z), map)
        if unit == nil then
            log_error("[ShadowOwner] 그림자 모델 스폰 실패: " .. self.UnitModelId)
            return false
        end
        ---@type ShadowUnit
        local comp = unit:GetComponent("script.ShadowUnit")
        if comp == nil then
            log_error("[ShadowOwner] ShadowUnit 컴포넌트 없음")
            unit:Destroy()
            return false
        end
        comp:Setup(self.Entity, id, _ShadowConfig:GetShadowAtk(shadow.grade, shadow.level), shadow.standRuid, shadow.moveRuid)
        shadow.deployed = true
        self.Units[id] = unit
        self.DeployedCount = self.DeployedCount + 1
        self:RefreshDigest()
        log("[ShadowOwner] 소환 " .. shadow.sourceId .. " → 소환 중 " .. tostring(self.DeployedCount))
        return true
    end

    @ExecSpace("ServerOnly")
    method boolean Recall(string id)
        -- 소환 중인 그림자를 보관함으로 되돌린다 (즉시)
        local shadow = self.Storage[id]
        if shadow == nil or not shadow.deployed then return false end
        local unit = self.Units[id]
        if isvalid(unit) then unit:Destroy() end
        self.Units[id] = nil
        shadow.deployed = false
        self.DeployedCount = math.max(0, self.DeployedCount - 1)
        self:RefreshDigest()
        log("[ShadowOwner] 회수 " .. shadow.sourceId .. " → 소환 중 " .. tostring(self.DeployedCount))
        return true
    end

    @ExecSpace("ServerOnly")
    method integer DeployNext()
        -- 소환 가능한 그림자 중 레벨·등급이 높은 것부터 하나 소환. 소환한 수(0/1) 반환
        local best = nil
        for id, s in pairs(self.Storage) do
            if self:CanDeploy(id) then
                if best == nil or s.grade * 100 + s.level > best.grade * 100 + best.level then best = s end
            end
        end
        if best == nil then return 0 end
        return self:Deploy(best.id) and 1 or 0
    end

    @ExecSpace("ServerOnly")
    method void RecallAll()
        for id, s in pairs(self.Storage) do
            if s.deployed then self:Recall(id) end
        end
    end

    @ExecSpace("ServerOnly")
    method void RallyAll()
        -- 집결: 모든 소환수가 잠시 적을 무시하고 주인 곁으로
        for id, unit in pairs(self.Units) do
            if isvalid(unit) then
                ---@type ShadowUnit
                local comp = unit:GetComponent("script.ShadowUnit")
                if comp ~= nil then comp:Rally(self.RallySeconds) end
            end
        end
        log("[ShadowOwner] 집결")
    end

    @ExecSpace("ServerOnly")
    method void RefreshDigest()
        -- 클라이언트 UI용 목록 문자열 갱신 (보관함은 table이라 직접 동기화할 수 없다)
        local rows = {}
        for id, s in pairs(self.Storage) do
            table.insert(rows, string.format("%s|%s|%d|%d|%d", id, s.sourceId, s.grade, s.level, s.deployed and 1 or 0))
        end
        table.sort(rows)
        self.StorageDigest = table.concat(rows, ";")
    end

    -- ───────── 클라이언트 → 서버 요청 ─────────

    @ExecSpace("Server")
    method void RequestDeploy(string id)
        if not self:IsSenderOwner(senderUserId) then return end
        if id == "" then self:DeployNext() else self:Deploy(id) end
    end

    @ExecSpace("Server")
    method void RequestRecall(string id)
        if not self:IsSenderOwner(senderUserId) then return end
        if id == "" then self:RecallAll() else self:Recall(id) end
    end

    @ExecSpace("Server")
    method void RequestRally()
        if not self:IsSenderOwner(senderUserId) then return end
        self:RallyAll()
    end

    @ExecSpace("Server")
    method void RequestDisassemble(string id)
        if not self:IsSenderOwner(senderUserId) then return end
        self:Disassemble(id)
    end

    @ExecSpace("Server")
    method void RequestUpgrade(string id)
        if not self:IsSenderOwner(senderUserId) then return end
        self:Upgrade(id)
    end

    @ExecSpace("ServerOnly")
    method boolean IsSenderOwner(string fromUserId)
        -- 요청자가 이 보관함의 주인인지 확인 (다른 유저의 조작 차단)
        local pc = self.Entity.PlayerComponent
        return isvalid(pc) and pc.UserId == fromUserId
    end

    -- ───────── 클라이언트 ─────────

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 단축키: Z 소환, X 전체 회수, C 집결 (내 캐릭터의 보관함만 반응)
        if self.Entity ~= _UserService.LocalPlayer then return end
        local key = event.key
        if key == KeyboardKey.Z then
            self:RequestDeploy("")
        elseif key == KeyboardKey.X then
            self:RequestRecall("")
        elseif key == KeyboardKey.C then
            self:RequestRally()
        end
    end

    @ExecSpace("Client")
    method void NotifyExtract(string sourceId, integer grade, Vector3 pos)
        -- 추출 성공 연출 (해당 플레이어 클라이언트에서만). 서버가 마지막 인자로 userId를 붙여 호출한다
        local gradeName = "일반"
        if grade == 2 then gradeName = "정예" elseif grade >= 3 then gradeName = "보스" end
        _ScreenMessageLogic:PrivateMsg("그림자 추출 성공! [" .. gradeName .. "] " .. sourceId)
        _ParticleService:PlayBasicParticle(BasicParticleType.Charge, self.Entity, pos, 0, Vector3(1, 1, 1), false, nil)
        log("[ShadowOwner] 클라이언트 추출 연출: " .. sourceId)
    end

end
