-- 그림자 시스템: 몬스터가 쓰러지면 그 자리에 혼(SoulOrb)을 남긴다. 처치자(또는 그림자의 주인)만 추출할 수 있다.
-- 원본 몬스터의 대기·이동 스프라이트가 혼과 그림자의 외형이 된다. (MonsterKilled 구독)
@Logic
script ShadowSystem extends Logic

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        _GameEvents:Subscribe("MonsterKilled", "ShadowSystem", function(e) self:OnMonsterKilled(e) end)
    end

    @ExecSpace("ServerOnly")
    method void OnMonsterKilled(table e)
        if e.player == nil or not isvalid(e.monster) then return end
        local monster = e.monster
        local standRuid = ""
        local moveRuid = ""
        local anim = monster.StateAnimationComponent
        if isvalid(anim) then
            standRuid = anim.ActionSheet["stand"] or ""
            moveRuid = anim.ActionSheet["move"] or standRuid
        end
        local pos = monster.TransformComponent.WorldPosition
        local soul = _SpawnService:SpawnByModelId(_GameConst.ModelSoulOrb, "Soul_" .. e.sourceId, Vector3(pos.x, pos.y, pos.z), e.map)
        if not isvalid(soul) then return end
        local userId = e.player.PlayerComponent.UserId
        _Util:AfterSpawn(soul, "script.SoulOrb", function(comp)
            ---@type SoulOrb
            local orb = comp
            orb:Setup(userId, e.sourceId, e.grade, e.rank, e.level, standRuid, moveRuid)
            if standRuid ~= "" then soul.SpriteRendererComponent.SpriteRUID = standRuid end
        end, function() soul:Destroy() end)
    end

end
