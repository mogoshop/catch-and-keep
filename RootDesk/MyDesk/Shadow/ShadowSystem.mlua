-- 그림자 시스템: 몬스터가 쓰러지면 그 자리에 혼(SoulOrb)을 남긴다. 개인 보상 — 피해를 준 사람·근처 파티원 각자에게
-- 자기 혼이 하나씩 생긴다 (본인만 보이고 본인만 추출·해골·되살림에 쓴다).
-- 원본 몬스터의 대기·이동 스프라이트가 혼과 그림자의 외형이 된다. (MonsterKilled 구독)
@Logic
script ShadowSystem extends Logic

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        _GameEvents:Subscribe("MonsterKilled", "ShadowSystem", function(e) self:OnMonsterKilled(e) end)
    end

    @ExecSpace("ServerOnly")
    method void OnMonsterKilled(table e)
        if e.player == nil or not isvalid(e.monster) then return end
        -- 뼈 둥지(MonsterNest)는 생물이 아니라 혼을 남기지 않는다
        if e.nest then return end
        local monster = e.monster
        local standRuid = ""
        local moveRuid = ""
        local anim = monster.StateAnimationComponent
        if isvalid(anim) then
            standRuid = anim.ActionSheet["stand"] or ""
            moveRuid = anim.ActionSheet["move"] or standRuid
        else
            -- 프레임 애니메이션 몬스터: 혼·그림자 외형은 대기·이동 첫 프레임
            local frames = _GameData:GetMonsterFrames(e.sourceId)
            if frames ~= nil and frames.stand ~= nil then
                standRuid = frames.stand.r[1]
                moveRuid = frames.move ~= nil and frames.move.r[1] or standRuid
            end
        end
        local pos = monster.TransformComponent.WorldPosition
        for _, p in ipairs(e.players or { e.player }) do
            self:SpawnSoul(Vector3(pos.x, pos.y, pos.z), e, p.PlayerComponent.UserId, standRuid, moveRuid)
        end
    end

    @ExecSpace("ServerOnly")
    method void SpawnSoul(Vector3 pos, table e, string userId, string standRuid, string moveRuid)
        local soul = _SpawnService:SpawnByModelId(_GameConst.ModelSoulOrb, "Soul_" .. e.sourceId, pos, e.map)
        if not isvalid(soul) then return end
        _Util:AfterSpawn(soul, "script.SoulOrb", function(comp)
            ---@type SoulOrb
            local orb = comp
            orb:Setup(userId, e.sourceId, e.grade, e.rank, e.level, e.variant or "", standRuid, moveRuid)
            if standRuid ~= "" then soul.SpriteRendererComponent.SpriteRUID = standRuid end
        end, function() soul:Destroy() end)
    end

end
