-- 그림자 시스템: 몬스터가 쓰러지면 그 자리에 혼(SoulOrb)을 남긴다. 개인 보상 — 피해를 준 사람·근처 파티원 각자에게
-- 자기 혼이 하나씩 생긴다 (본인만 보이고 본인만 추출·해골·되살림에 쓴다).
-- 원본 몬스터의 대기·이동 스프라이트가 혼과 그림자의 외형이 된다. (MonsterKilled 구독)
@Logic
script ShadowSystem extends Logic

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        _GameEvents:Subscribe("MonsterKilled", "ShadowSystem", function(e) self:OnMonsterKilled(e) end)
    end

    @ExecSpace("ServerOnly")
    method void OnMonsterKilled(table e)
        if e.player == nil or not isvalid(e.monster) then return end
        -- 뼈 둥지(MonsterNest)는 생물이 아니라 혼을 남기지 않는다
        if e.nest then return end
        if _GameConst:NoSoul(e.sourceId or "") then return end   -- 오렌 · 그림자 인형 (docs/design/31)
        local monster = e.monster
        local standRuid = ""
        local moveRuid = ""
        -- 코덱스 그림(프레임)이 먼저. 몬스터에 옛 애니메이션 시트가 남아 있어도 쓰지 않는다 (10-13: 맵에 놓인 액트 1 보스)
        local look = _ShadowConfig:FrameLook(e.sourceId)
        local anim = monster.StateAnimationComponent
        if look ~= nil then
            standRuid = look.stand
            moveRuid = look.move
        elseif isvalid(anim) then
            standRuid = anim.ActionSheet["stand"] or ""
            moveRuid = anim.ActionSheet["move"] or standRuid
        end
        local pos = monster.TransformComponent.WorldPosition
        for _, p in ipairs(e.players or { e.player }) do
            self:SpawnSoul(Vector3(pos.x, pos.y, pos.z), e, p.PlayerComponent.UserId, standRuid, moveRuid)
        end
        self:TryFirstTaste(e, standRuid, moveRuid, Vector2(pos.x, pos.y))
    end

    @ExecSpace("ServerOnly")
    method void TryFirstTaste(table e, string standRuid, string moveRuid, Vector2 pos)
        -- 첫 처치 맛보기 그림자 (기획서 39 결정 #3A, 10-29): 그림자 소환(Lv5)을 배우기 전 캐릭터가 일반 몬스터를 처음 쓰러뜨리면
        -- 그 자리에서 firstTasteSec(60)초짜리 임시 그림자로 일어나 따라다니며 싸운다. 캐릭터마다 1회 (PlayerStats.FirstKills 「taste_shadow」 — 저장됨).
        -- 막타 친 사람 본인만 (파티원 X) · 정식 그림자 규칙(해금·상한 10·추출)은 그대로 — 임시 그림자는 UndeadSystem 「되살림」 칸으로 보관함·상한 밖
        local player = e.player
        if player == nil or not isvalid(player) or not isvalid(player.PlayerComponent) or not _Util:IsAlive(player) then return end
        if (e.grade or 1) ~= 1 or e.boss or (e.named or "") ~= "" or standRuid == "" then return end
        if player.CurrentMap ~= e.map then return end
        ---@type PlayerStats
        local stats = player:GetComponent("script.PlayerStats")
        if stats == nil or stats:HasFirstKill("taste_shadow") then return end
        if stats.Level >= _SkillData:Get("shadow_summon").row then return end   -- 이미 정식 그림자를 쓸 수 있는 캐릭터(기존 캐릭터 포함)는 건너뛴다
        stats:MarkFirstKill("taste_shadow")
        local sourceId, level, variant = e.sourceId or "", e.level or 1, e.variant or ""
        -- 쓰러지는 연출(HideDelay 0.8초)이 끝날 즈음 일어선다
        _TimerService:SetTimerOnce(function()
            if not isvalid(player) or not _Util:IsAlive(player) or player.CurrentMap ~= e.map then
                log("[VRF] first-kill shadow skipped (owner left or died)")
                return
            end
            _UndeadSystem:SpawnTaste(player, sourceId, level, variant, standRuid, moveRuid, pos)
        end, 0.7)
    end

    @ExecSpace("ServerOnly")
    method void SpawnSoul(Vector3 pos, table e, string userId, string standRuid, string moveRuid)
        local soul = _SpawnService:SpawnByModelId(_GameConst.ModelSoulOrb, "Soul_" .. e.sourceId, pos, e.map)
        if not isvalid(soul) then return end
        _Util:AfterSpawn(soul, "script.SoulOrb", function(comp)
            ---@type SoulOrb
            local orb = comp
            orb:Setup(userId, e.sourceId, e.grade, e.rank, e.level, e.variant or "", standRuid, moveRuid)
            if standRuid ~= "" then soul.SpriteRendererComponent.SpriteRUID = standRuid end
        end, function() soul:Destroy() end)
    end

end
