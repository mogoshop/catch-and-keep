-- 쓰러진 몬스터가 남기는 혼. 처치자(또는 그림자의 주인)만 일정 시간 안에 추출을 시도할 수 있다.
-- 추출 판정은 ShadowOwner.RequestExtract가 서버에서 한다. 이 컴포넌트는 데이터·수명·연출만 맡는다.
@Component
script SoulOrb extends Component

    @Sync
    property string OwnerUserId = ""
    @Sync
    property integer Grade = 1
    @Sync
    property string SourceId = ""
    @Sync
    property string Rank = "normal"         -- monster_ranks.csv 등급 (추출 확률 — 클라이언트도 혼 위에 확률을 표시한다)
    property integer Level = 1              -- 처치된 몬스터 레벨 (그림자 시작 레벨)
    @Sync
    property string Variant = ""            -- 변종 능력 (추출·되살림하면 그대로 쓴다)
    property string StandRUID = ""
    property string MoveRUID = ""
    property number LifeSeconds = 30       -- 첫 소환 안내를 읽고 접근할 여유. 수가 쌓이지 않도록 유한 수명 유지
    @Sync
    property boolean Reserved = false
    property boolean Consumed = false
    property boolean LossReported = false   -- 수명·도둑 소멸 관측만 중복 방지 (게임 소모 상태와 별개)

    property number PulseTime = 0
    property integer ThiefTimer = 0
    @Sync
    property Entity StealBy = nil           -- 혼 빼앗기: 끌어가는 몬스터 (액트 4 지옥불 사제)
    property number StealAt = 0             -- 이 시각에 먹힌다 (그 전에 추출하면 지킨다)
    property number ConsumeFrameSec = 0.12  -- 혼이 먹히는 순간(B17 · SpriteSoulConsume 4장) 장 간격 (10-31 갈래 E · 0.08 → 0.12 = 0.48초 · 예전 첫 장 건너뜀으로 0.24초)

    @ExecSpace("ServerOnly")
    method void Setup(string ownerUserId, string sourceId, integer grade, string rank, integer level, string variant, string standRuid, string moveRuid)
        -- ShadowSystem이 스폰 직후 호출. 값만 저장한다 (스폰 직후 다른 메서드 호출 금지 — LEA-2011)
        self.OwnerUserId = ownerUserId
        self.SourceId = sourceId
        self.Grade = grade
        self.Rank = rank
        self.Level = level
        self.Variant = variant
        self.StandRUID = standRuid
        self.MoveRUID = moveRuid
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 수명이 다하면 사라진다
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and not self.Consumed then
                self:NoteLost("expired")
                self.Entity:Destroy()
            end
        end, self.LifeSeconds)
        self.ThiefTimer = _TimerService:SetTimerRepeat(function() self:CheckThief() end, 0.25)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.ThiefTimer ~= 0 then _TimerService:ClearTimer(self.ThiefTimer) end
        self.ThiefTimer = 0
    end

    @ExecSpace("ServerOnly")
    method void CheckThief()
        -- 혼 빼앗기 (액트 4, docs/design/27): 곁의 지옥불 사제가 혼을 soulStealSec초 동안 끌어당겨 먹는다.
        -- 그 사이 추출(예약)하면 지킨다. 먹히면 사제와 곁의 악마가 혼 포식 한 겹(주는 피해 +soulFeedPct%)
        if self.Consumed or not isvalid(self.Entity) then return end
        local map = self.Entity.CurrentMap
        local here = _Util:Pos2(self.Entity)
        local now = _UtilLogic.ElapsedSeconds
        if self.StealBy ~= nil then
            ---@type Monster
            local thief = isvalid(self.StealBy) and self.StealBy:GetComponent("script.Monster") or nil
            if self.Reserved or thief == nil or thief.IsDead or not self.StealBy.Enable then
                self.StealBy = nil
                return
            end
            -- 사제 쪽으로 천천히 끌려간다
            local to = _Util:Pos2(self.StealBy)
            local dest = here + (to - here) * 0.12
            self.Entity.TransformComponent.WorldPosition = Vector3(dest.x, dest.y, 0)
            if now < self.StealAt then return end
            local fed = 0
            for _, m in ipairs(_Util:MonstersNear(map, to, _GameData.soulFeedRadius)) do
                local status = m:Status()
                if status ~= nil then
                    status:FeedSoul()
                    fed = fed + 1
                end
            end
            self:FeedFx(Vector3(to.x, to.y, 0))
            log(string.format("[VRF] soul stolen by %s fed=%d", thief.SourceId, fed))
            self:NoteLost("stolen")
            self:Consume()
            return
        end
        if self.Reserved then return end
        for _, m in ipairs(_Util:MonstersNear(map, here, _GameData.soulStealRange)) do
            if string.find(_GameConst.SoulThieves, "," .. m.SourceId .. ",", 1, true) ~= nil then
                self.StealBy = m.Entity
                self.StealAt = now + _GameData.soulStealSec
                self:StealFx(m.Entity, _GameData.soulStealSec)
                return
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void ForceSteal(Entity thief)
        -- 재의 왕 「혼 포식」: 거리와 상관없이 이 혼을 끌어당긴다 (이미 끌려가는 중이면 그대로)
        if self.Consumed or self.Reserved or self.StealBy ~= nil or not isvalid(thief) then return end
        self.StealBy = thief
        self.StealAt = _UtilLogic.ElapsedSeconds + _GameData.soulStealSec
        self:StealFx(thief, _GameData.soulStealSec)
    end

    @ExecSpace("Multicast")
    method void StealFx(Entity thief, number seconds)
        -- 혼과 사제를 잇는 붉은 실 (코덱스 붉은 실 4장을 돌려 가며, 끌려가는 동안 따라 늘인다) + 혼이 붉게 물든다
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        ---@type FrameAnimator
        local anim = isvalid(thief) and thief:GetComponent("script.FrameAnimator") or nil
        if anim ~= nil then anim:Flash("steal", seconds) end
        local chains = _Util:Frames(_GameConst.SpriteSoulThreads)
        if #chains == 0 then return end
        local serial = 0
        local t = 0
        local timer = 0
        timer = _TimerService:SetTimerRepeat(function()
            t = t + 0.1
            if serial ~= 0 then _EffectService:RemoveEffect(serial) serial = 0 end
            if t >= seconds or not isvalid(self.Entity) or self.Consumed or not isvalid(thief) or self.StealBy == nil then
                _TimerService:ClearTimer(timer)
                return
            end
            local a = _Util:Pos2(self.Entity)
            local b = _Util:Pos2(thief) + Vector2(0, 0.6)
            local d = b - a
            local len = d:Magnitude()
            if len < 0.05 then return end
            local frame = chains[math.floor(t / 0.1) % #chains + 1]
            serial = _EffectService:PlayEffect(frame, self.Entity, Vector3((a.x + b.x) * 0.5, (a.y + b.y) * 0.5, 0), math.deg(math.atan(d.y, d.x)), Vector3(len / 2.56, 1, 1), true,
                { SortingLayer = "MapLayer0", OrderInLayer = 19, Color = Color(1, 1, 1, 0.95) })
        end, 0.1)
    end

    @ExecSpace("Multicast")
    method void FeedFx(Vector3 pos)
        -- 먹힌 자리: 혼이 삼켜지는 붉은 불꽃 (코덱스 4장, 한 번)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _Util:PlayFrames(_GameConst.SpriteSoulConsume, me.CurrentMap, pos + Vector3(0, 0.6, 0), 0, Vector3(1.2, 1.2, 1), self.ConsumeFrameSec, Color(1, 1, 1, 1), 20)
    end

    @ExecSpace("ServerOnly")
    method void NoteLost(string reason)
        -- 일반 추출·일으키기의 Consume은 따로 세지 않는다. 실제 기타 소멸 경로에서만 호출한다.
        if self.LossReported then return end
        self.LossReported = true
        local player = _UserService:GetUserEntityByUserId(self.OwnerUserId)
        if isvalid(player) then _GameEvents:Emit("SoulLost", { player = player, reason = reason }) end
    end

    @ExecSpace("ServerOnly")
    method void Consume()
        -- 혼은 한 번만 쓴다: 추출 시도(성공·실패) / 망자 폭쇄 / 되살림 중 하나
        if self.Consumed then return end
        self.Consumed = true
        self.Entity:Destroy()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 은은하게 깜빡이는 연출. 정예 이상은 더 밝게
        self.PulseTime = self.PulseTime + delta
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        -- 개인 보상: 내 혼만 보인다 (남의 혼은 숨김)
        local me = _UserService.LocalPlayer
        local mine = isvalid(me) and me.PlayerComponent.UserId == self.OwnerUserId
        if sprite.Enable ~= mine then sprite.Enable = mine end
        if not mine then return end
        local a = 0.45 + 0.35 * math.abs(math.sin(self.PulseTime * 3))
        if self.StealBy ~= nil then
            sprite.Color = Color(1.0, 0.2, 0.15, 0.6 + 0.4 * math.abs(math.sin(self.PulseTime * 12)))   -- 빼앗기는 중: 붉게 빠르게 깜빡임
        elseif self.Variant ~= "" then
            sprite.Color = Color(1.0, 0.35, 0.9, a)     -- 변종 능력이 든 혼은 자홍색
        elseif self.Grade >= 2 then
            sprite.Color = Color(1.0, 0.75, 0.3, a)
        else
            sprite.Color = Color(0.6, 0.45, 1.0, a)
        end
    end

end
