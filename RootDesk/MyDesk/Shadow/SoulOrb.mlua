-- 쓰러진 몬스터가 남기는 혼. 처치자(또는 그림자의 주인)만 일정 시간 안에 추출을 시도할 수 있다.
-- 추출 판정은 ShadowOwner.RequestExtract가 서버에서 한다. 이 컴포넌트는 데이터·수명·연출만 맡는다.
@Component
script SoulOrb extends Component

    @Sync
    property string OwnerUserId = ""
    @Sync
    property integer Grade = 1
    @Sync
    property string SourceId = ""
    @Sync
    property string Rank = "normal"         -- monster_ranks.csv 등급 (추출 확률 — 클라이언트도 혼 위에 확률을 표시한다)
    property integer Level = 1              -- 처치된 몬스터 레벨 (그림자 시작 레벨)
    @Sync
    property string Variant = ""            -- 변종 능력 (추출·되살림하면 그대로 쓴다)
    property string StandRUID = ""
    property string MoveRUID = ""
    property number LifeSeconds = 30       -- 첫 소환 안내를 읽고 접근할 여유. 수가 쌓이지 않도록 유한 수명 유지
    @Sync
    property boolean Reserved = false
    property boolean Consumed = false

    property number PulseTime = 0

    @ExecSpace("ServerOnly")
    method void Setup(string ownerUserId, string sourceId, integer grade, string rank, integer level, string variant, string standRuid, string moveRuid)
        -- ShadowSystem이 스폰 직후 호출. 값만 저장한다 (스폰 직후 다른 메서드 호출 금지 — LEA-2011)
        self.OwnerUserId = ownerUserId
        self.SourceId = sourceId
        self.Grade = grade
        self.Rank = rank
        self.Level = level
        self.Variant = variant
        self.StandRUID = standRuid
        self.MoveRUID = moveRuid
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 수명이 다하면 사라진다
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and not self.Consumed then self.Entity:Destroy() end
        end, self.LifeSeconds)
    end

    @ExecSpace("ServerOnly")
    method void Consume()
        -- 혼은 한 번만 쓴다: 추출 시도(성공·실패) / 망자 폭쇄 / 되살림 중 하나
        if self.Consumed then return end
        self.Consumed = true
        self.Entity:Destroy()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 은은하게 깜빡이는 연출. 정예 이상은 더 밝게
        self.PulseTime = self.PulseTime + delta
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local a = 0.45 + 0.35 * math.abs(math.sin(self.PulseTime * 3))
        if self.Variant ~= "" then
            sprite.Color = Color(1.0, 0.35, 0.9, a)     -- 변종 능력이 든 혼은 자홍색
        elseif self.Grade >= 2 then
            sprite.Color = Color(1.0, 0.75, 0.3, a)
        else
            sprite.Color = Color(0.6, 0.45, 1.0, a)
        end
    end

end
