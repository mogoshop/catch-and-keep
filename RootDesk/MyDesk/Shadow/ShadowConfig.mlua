-- 그림자 규칙 (수치는 data/config.csv → _GameData). 배치 하드 상한은 hardCap 하나로만 정한다 (docs/project-rules.md).
@Logic
script ShadowConfig extends Logic

    method any C()
        return _GameData
    end

    method number GetExtractReach()
        return self:C().extractReach
    end

    method number GetRespawnDelay()
        return self:C().respawnDelaySec
    end

    method integer GetHardCap()
        return math.floor(self:C().hardCap)
    end

    method number GetExtractChance(string rank)
        -- 등급별 기본 추출 확률 (monster_ranks.csv 단일 기준)
        return _GameData:GetRank(rank).extract
    end

    method integer GetDisassembleYield(integer grade, integer level)
        -- 0이면 분해 불가 (보스 그림자). 높은 사냥터(그림자 레벨)일수록 정수가 늘어난다:
        -- 등급 기본값 × (1 + essenceLevelStep × (레벨 − 1)) — 1레벨 일반 1개 · 20레벨 3개 · 40레벨 5개 (10-10 QA)
        local base = 0
        if grade == 1 then base = self:C().disassembleYield_g1 elseif grade == 2 then base = self:C().disassembleYield_g2 end
        if base <= 0 then return 0 end
        local mult = 1 + _GameData.essenceLevelStep * math.max(0, (level or 1) - 1)
        return math.max(1, math.floor(base * mult + 0.5))
    end

    method integer GetUpgradeCost(integer plus, integer grade)
        -- 강화 +n → +n+1 정수 비용: (5, 9, 13, …) × 등급 배율 (정예 ×1.5 · 보스 ×3)
        local mul = 1
        if grade == 2 then mul = _GameData.shadowPlusCostEliteMul elseif grade >= 3 then mul = _GameData.shadowPlusCostBossMul end
        return math.floor((_GameData.shadowPlusCostBase + _GameData.shadowPlusCostStep * plus) * mul + 0.5)
    end

    -- ───────── 사망 한도 · 룬 강화 (10-20 사용자 결정) ─────────

    method integer GetDeathLimit(integer grade)
        -- 정예·보스 그림자는 이만큼 쓰러지면 마을에 들를 때까지 소환할 수 없다 (0 = 한도 없음, 일반 그림자)
        if grade >= 3 then return math.floor(_GameData.shadowDeathLimitBoss) end
        if grade == 2 then return math.floor(_GameData.shadowDeathLimitElite) end
        return 0
    end

    method integer GetRuneTier(string runeId)
        -- 룬 등급: 1 하급(Lv1) · 2 중급(Lv12) · 3 상급(Lv23) · 4 최상급(Lv35) — runes.csv minLevel
        local r = _ItemData:GetRune(runeId)
        if r == nil then return 0 end
        if r.minLevel >= 35 then return 4 end
        if r.minLevel >= 23 then return 3 end
        if r.minLevel >= 12 then return 2 end
        return 1
    end

    method string TierName(integer tier)
        local names = { "하급", "중급", "상급", "최상급" }
        return names[math.max(1, math.min(4, tier))]
    end

    method integer UpgradeRuneTier(integer plus, integer grade)
        -- +plus → +plus+1에 드는 룬 등급 하한 (0 = 룬 없이 정수만). 정예 +1 · 보스 +2 등급 (최대 4)
        local nextP = plus + 1
        if nextP < _GameData.shadowRuneFromPlus then return 0 end
        local base = _GameData.shadowRuneTier10
        if nextP <= 6 then base = _GameData.shadowRuneTier6
        elseif nextP == 7 then base = _GameData.shadowRuneTier7
        elseif nextP == 8 then base = _GameData.shadowRuneTier8
        elseif nextP == 9 then base = _GameData.shadowRuneTier9 end
        if grade == 2 then base = base + 1 elseif grade >= 3 then base = base + 2 end
        return math.max(1, math.min(4, math.floor(base)))
    end

    method number UpgradeChance(integer plus)
        -- +plus → +plus+1 성공 확률 (룬이 드는 단계부터. 그 전은 1)
        local nextP = plus + 1
        if nextP < _GameData.shadowRuneFromPlus then return 1 end
        if nextP <= 6 then return _GameData.shadowPlusChance6 end
        if nextP == 7 then return _GameData.shadowPlusChance7 end
        if nextP == 8 then return _GameData.shadowPlusChance8 end
        if nextP == 9 then return _GameData.shadowPlusChance9 end
        return _GameData.shadowPlusChance10
    end

    method integer FindUpgradeRune(table bag, integer tier)
        -- 가방(아이템 문자열 목록)에서 강화에 쓸 룬 칸 번호 (없으면 0): 등급 하한 이상 중 가장 낮은 등급 → 그중 가장 흔한 룬 (귀한 룬을 아낀다)
        local best, bestTier, bestWeight = 0, 99, -1
        for i, s in ipairs(bag) do
            if _ItemData:IsRune(s) then
                local id = _ItemData:Parse(s).base
                local t = self:GetRuneTier(id)
                local r = _ItemData:GetRune(id)
                local w = r ~= nil and r.weight or 0
                if t >= tier and (t < bestTier or (t == bestTier and w > bestWeight)) then best, bestTier, bestWeight = i, t, w end
            end
        end
        return best
    end

    method integer GetPlusMax()
        return math.floor(_GameData.shadowPlusMax)
    end

    method integer GetPlusCap(integer ownerLevel)
        -- 주인 레벨에 따른 강화 상한 (Lv12 → +4). 레벨 낮은 주인이 강화로 레벨 제한을 넘지 못하게
        return math.max(0, math.min(self:GetPlusMax(), math.floor(math.max(1, ownerLevel) / _GameData.shadowPlusLevelDiv)))
    end

    method integer EffectivePlus(integer plus, integer ownerLevel)
        -- 실제로 힘에 들어가는 강화 (상한을 넘는 강화는 주인이 크면 그때 적용된다)
        if ownerLevel <= 0 then return math.max(0, plus) end
        return math.max(0, math.min(plus, self:GetPlusCap(ownerLevel)))
    end

    method integer NextCapLevel(integer plus)
        -- 이 강화(+plus)가 모두 적용되는 주인 레벨
        return math.max(1, plus * math.floor(_GameData.shadowPlusLevelDiv))
    end

    method number GetPlusPct(integer grade)
        if grade >= 3 then return _GameData.shadowPlusPctBoss end
        return _GameData.shadowPlusPct
    end

    method number GetPlusMult(integer plus, integer grade)
        -- 강화 배율: +1당 공격·생명 shadowPlusPct% (보스 그림자는 shadowPlusPctBoss%)
        return 1 + self:GetPlusPct(grade) / 100 * math.max(0, plus)
    end

    method integer GetPlusRefund(integer plus)
        -- 강화한 그림자를 분해하면 예전 비용표(3, 5, 7, …)로 계산한 정수의 절반을 돌려준다 (비용 인상 전후 모두 같은 규칙)
        local spent = 0
        for i = 0, plus - 1 do spent = spent + math.floor(_GameData.shadowRefundBase + _GameData.shadowRefundStep * i) end
        return math.floor(spent / 2)
    end

    method number ExpToNext(integer level)
        -- 그림자 레벨 n → n+1 경험치 (데리고 다니며 처치 경험치를 나눠 받는다)
        return math.floor(_GameData.shadowExpBase * (math.max(1, level) ^ _GameData.shadowExpExp))
    end

    method integer GetDeployLimit(integer bonus, integer capBonus)
        -- 기본 + 보너스(스킬·장비·세트), 어떤 경우에도 hardCap + 세트 상한 보너스 이하
        return math.min(math.floor(self:C().deployBase) + bonus + capBonus, self:GetHardCap() + capBonus)
    end

    method integer GetDeploySkillBonus(integer level)
        -- 실제 소환 한도와 스킬 투자 미리보기가 같은 단계 규칙을 사용한다.
        -- 10-11: 그림자 소환 강화 「배치 확장」 랭크 = 추가 기수 (예전 1·8·16레벨 단계)
        return math.max(0, math.min(3, level))
    end

    method integer EffectiveLevel(integer level, integer ownerLevel)
        -- 그림자는 본래 레벨을 지니지만 힘은 주인 레벨까지만 낸다 (주인이 크면 본래 레벨까지 따라 큰다)
        if ownerLevel <= 0 then return level end
        return math.max(1, math.min(level, ownerLevel))
    end

    method number GetAtkScale(integer level)
        -- 그림자 공격 성장 = 몬스터 공격 곡선 × summonGrowthMul
        return self:C().shadowStatMul * (1 + self:C().monsterDmgPerLevel * self:C().summonGrowthMul * (math.max(1, level) - 1))
    end

    method number GetHpScale(integer level)
        -- 그림자 생명 성장 = 몬스터 생명 곡선 × summonGrowthMul
        return self:C().shadowHpMul * (1 + self:C().monsterHpPerLevel * self:C().summonGrowthMul * (math.max(1, level) - 1))
    end

    method number GetSourceAtk(integer grade)
        if grade == 1 then return self:C().shadowSourceAtk_g1 end
        if grade == 2 then return self:C().shadowSourceAtk_g2 end
        return self:C().shadowSourceAtk_g3
    end

    method number GetSourceHp(integer grade)
        if grade == 1 then return self:C().shadowSourceHp_g1 end
        if grade == 2 then return self:C().shadowSourceHp_g2 end
        return self:C().shadowSourceHp_g3
    end

    method table GetProfile(string sourceId, integer grade, integer level, number statMul)
        -- 그림자 능력치 = 등급 기본값 × 원본 몬스터 배율(개성) × 레벨 성장 × statMul(소환수 보너스 등)
        -- 원본 배율: 원본 생명·공격을 몬스터 레벨 1·일반 등급 기준으로 되돌린 뒤 일반 몬스터 평균(shadowRef*)과 비교.
        -- 최상위·보스는 표의 수치에 등급 배율이 이미 들어 있으므로 그 배율로 나눈다. 등급 차이는 등급 기본값이 맡는다
        local c = self:C()
        local m = _GameData:GetMonsterStats(sourceId)
        local hpRatio, dmgRatio = 1, 1
        local p = { cooldown = 1.0, range = 0.8, speed = 1.2, element = "", ratio = 0, resists = {}, behavior = "" }
        if m ~= nil then
            local lv = math.max(1, m.level)
            local rank = _GameData:GetRank(m.rank)
            local normHp = m.hp / (1 + c.monsterHpPerLevel * (lv - 1)) / rank.hpMul
            local normDmg = m.dmg / (1 + c.monsterDmgPerLevel * (lv - 1)) / rank.dmgMul
            local low = c.shadowRatioMin
            if grade >= 3 then low = 1 end   -- 보스 그림자는 원본이 약해도 등급 기본값 아래로 내려가지 않는다
            hpRatio = math.max(low, math.min(c.shadowRatioMax, normHp / c.shadowRefHp))
            dmgRatio = math.max(low, math.min(c.shadowRatioMax, normDmg / c.shadowRefDmg))
            p.cooldown = m.interval * c.shadowCooldownMul
            p.range = m.range
            p.speed = math.max(c.shadowSpeedMin, math.min(c.shadowSpeedMax, m.speed))
            p.element = m.element
            if m.element ~= "" then p.ratio = m.ratio end
            p.resists = self:ParseResists(m.resists)
            p.behavior = m.behavior
        end
        p.atk = math.max(1, math.floor(self:GetSourceAtk(grade) * dmgRatio * self:GetAtkScale(level) * statMul))
        p.hp = math.max(1, math.floor(self:GetSourceHp(grade) * hpRatio * self:GetHpScale(level) * statMul))
        p.hpRatio = hpRatio
        p.dmgRatio = dmgRatio
        return p
    end

    method table ParseResists(string text)
        -- "fire=50,poison=75" → { fire = 50, poison = 75 }
        local t = {}
        for k, v in string.gmatch(text, "(%a+)=(%-?%d+)") do t[k] = tonumber(v) end
        return t
    end

    method string ElementName(string element)
        local names = { fire = "화염", cold = "냉기", light = "번개", poison = "독", magic = "마법" }
        return names[element] or ""
    end

    method string GetMonsterName(string sourceId)
        return _GameData:GetMonsterName(sourceId)
    end

    method table FrameLook(string sourceId)
        -- 혼·그림자 외형: 코덱스 그림(프레임 몬스터, data/monster_frames.csv)이 있으면 그 대기·이동 첫 프레임. 없으면 nil
        -- (10-13 사용자 지적: 묘지기 여왕의 혼·그림자가 옛 메이플 그림 — 맵에 놓인 보스의 옛 애니메이션 시트를 먼저 읽었고, 저장된 그림자는 그 값을 계속 썼다)
        local frames = _GameData:GetMonsterFrames(sourceId)
        if frames == nil or frames.stand == nil then return nil end
        local stand = frames.stand.r[1]
        return { stand = stand, move = frames.move ~= nil and frames.move.r[1] or stand }
    end

end
