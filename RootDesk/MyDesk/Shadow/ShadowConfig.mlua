-- 그림자 규칙 (수치는 data/config.csv → _GameData). 배치 하드 상한은 hardCap 하나로만 정한다 (docs/project-rules.md).
@Logic
script ShadowConfig extends Logic

    method any C()
        return _GameData
    end

    method number GetExtractReach()
        return self:C().extractReach
    end

    method number GetRespawnDelay()
        return self:C().respawnDelaySec
    end

    method integer GetHardCap()
        return math.floor(self:C().hardCap)
    end

    method number GetExtractChance(string rank)
        -- 등급별 기본 추출 확률 (monster_ranks.csv 단일 기준)
        return _GameData:GetRank(rank).extract
    end

    method integer GetDisassembleYield(integer grade)
        -- 0이면 분해 불가 (보스 그림자)
        if grade == 1 then return math.floor(self:C().disassembleYield_g1) end
        if grade == 2 then return math.floor(self:C().disassembleYield_g2) end
        return 0
    end

    method integer GetUpgradeCost(integer level)
        -- 레벨 n → n+1 정수 비용
        return level
    end

    method integer GetDeployLimit(integer bonus)
        -- 기본 + 보너스, 어떤 경우에도 hardCap 이하
        return math.min(math.floor(self:C().deployBase) + bonus, self:GetHardCap())
    end

    method number GetStatScale(integer level)
        return self:C().shadowStatMul * (1 + self:C().shadowLevelGrowth * (level - 1))
    end

    method number GetSourceAtk(integer grade)
        if grade == 1 then return self:C().shadowSourceAtk_g1 end
        if grade == 2 then return self:C().shadowSourceAtk_g2 end
        return self:C().shadowSourceAtk_g3
    end

    method number GetSourceHp(integer grade)
        if grade == 1 then return self:C().shadowSourceHp_g1 end
        if grade == 2 then return self:C().shadowSourceHp_g2 end
        return self:C().shadowSourceHp_g3
    end

    method integer GetShadowMaxHp(integer grade, integer level)
        return math.max(1, math.floor(self:GetSourceHp(grade) * self:GetStatScale(level)))
    end

    method integer GetShadowAtk(integer grade, integer level)
        return math.max(1, math.floor(self:GetSourceAtk(grade) * self:GetStatScale(level)))
    end

    method string GetMonsterName(string sourceId)
        return _GameData:GetMonsterName(sourceId)
    end

end
