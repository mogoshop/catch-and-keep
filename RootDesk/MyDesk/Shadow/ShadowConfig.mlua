-- Phase 0 그림자 수치 테이블. 로직 없음.
-- 근거: docs/phase0-core-loop-design.md 4장, docs/data/config.csv
-- 하드 상한(HardCap)은 이 파일에서만 정의한다. (docs/project-rules.md)
@Logic
script ShadowConfig extends Logic

    property integer DeployBase = 5
    property integer HardCap = 8
    property number StatMultiplier = 0.6
    property number LevelGrowth = 0.08
    property number RespawnDelaySec = 10
    property number ExtractReach = 1.2      -- 혼 추출 가능 거리

    method number GetExtractChance(integer grade)
        -- 등급별 추출 확률. 1 일반, 2 정예. 보스(3)는 별도 처리
        -- 능동 추출로 바꾸며 상향 (처치마다 자동 판정 15%/8% → 직접 시도 35%/20%) [가정]
        if grade == 1 then return 0.35 end
        if grade == 2 then return 0.20 end
        return 0
    end

    method integer GetDisassembleYield(integer grade)
        -- 등급별 분해 수익. 0이면 분해 불가
        if grade == 1 then return 1 end
        if grade == 2 then return 4 end
        return 0
    end

    method integer GetUpgradeCost(integer level)
        -- 레벨 n에서 n+1로 올리는 정수 비용
        return level
    end

    method integer GetDeployLimit(integer bonus)
        -- 기본 슬롯 + 보너스. 어떤 경우에도 HardCap을 넘지 않는다
        return math.min(self.DeployBase + bonus, self.HardCap)
    end

    method number GetStatScale(integer level)
        -- 원본 스탯 대비 그림자 스탯 배율
        return self.StatMultiplier * (1 + self.LevelGrowth * (level - 1))
    end

    method integer GetSourceAtk(integer grade)
        -- 원본 몬스터 공격력 [가정]. 몬스터별 수치표가 생기면 docs/data/monsters.csv로 옮긴다
        if grade == 1 then return 25 end
        if grade == 2 then return 50 end
        return 100
    end

    method integer GetSourceHp(integer grade)
        -- 원본 몬스터 체력 [가정]. 몬스터 모델의 ShadowMonster.MaxHp와 맞춘다
        if grade == 1 then return 60 end
        if grade == 2 then return 150 end
        return 600
    end

    method integer GetShadowMaxHp(integer grade, integer level)
        -- 그림자 체력 = 원본 × 0.6 × 레벨 보정 (최소 1)
        return math.max(1, math.floor(self:GetSourceHp(grade) * self:GetStatScale(level)))
    end

    method integer GetShadowAtk(integer grade, integer level)
        -- 그림자 공격력 = 원본 × 0.6 × 레벨 보정 (최소 1)
        return math.max(1, math.floor(self:GetSourceAtk(grade) * self:GetStatScale(level)))
    end

    method string GetMonsterName(string sourceId)
        -- 표시 이름 (원본 몬스터 종류 → 오리지널 이름)
        if sourceId == "mob-568" then return "잿빛 들쥐" end
        if sourceId == "mob-1955" then return "이끼 망령" end
        if sourceId == "mob-1209" then return "무덤 파수꾼" end
        if sourceId == "mob-6130101" then return "부패한 버섯왕" end
        return sourceId
    end

end
