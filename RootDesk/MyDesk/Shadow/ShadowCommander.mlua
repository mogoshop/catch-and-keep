-- 그림자 지휘: 보관함(ShadowOwner)의 그림자를 엔티티로 소환·회수·집결하고 대형을 관리한다.
-- 단축키: Z 소환, X 전체 회수, C 집결.
@Component
script ShadowCommander extends Component

    property number RallySeconds = 2.5
    property table Units = {}                -- shadow id → 소환된 엔티티
    property table Wanted = {}               -- 맵 이동 뒤 다시 부를 그림자 id (이동 전에 소환 중이던 것)
    property table TravelStates = {}          -- 재소환 대기 중인 개체의 체력 비율·시전 당시 승격 배율
    property integer RedeployTimer = 0
    property integer RedeployGeneration = 0
    @Sync
    property integer DeployedCount = 0
    @Sync
    property string UndeadSummary = ""       -- UndeadSystem이 채우는 "해골 3/4 · 마법사 1/1"
    @Sync
    property string MinionCounts = "0,0,0"   -- 해골·마법사·되살림 수 (HUD 소환수 배지)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 플레이어마다 독립적인 소환·이동 대기 상태를 만든다.
        self.Units = {}
        self.Wanted = {}
        self.TravelStates = {}
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- 주인이 나가면 소환된 그림자 정리
        self:CancelRedeployTimer()
        for _, unit in pairs(self.Units) do
            if isvalid(unit) then unit:Destroy() end
        end
        self.Units = {}
        self.Wanted = {}
        self.TravelStates = {}
    end

    @ExecSpace("ServerOnly")
    method void Prune()
        -- 엔티티가 사라진 소환(다른 맵·방으로 옮겨져 스스로 사라짐 등)을 보관함 상태와 맞춘다
        local owner = self:Owner()
        local changed = false
        for id, unit in pairs(self.Units) do
            if not isvalid(unit) then
                self.Units[id] = nil
                local shadow = owner ~= nil and owner:GetShadow(id) or nil
                if shadow ~= nil and shadow.deployed then shadow.deployed = false end
                self.DeployedCount = math.max(0, self.DeployedCount - 1)
                changed = true
            end
        end
        if changed and owner ~= nil then owner:RefreshDigest() end
    end

    @ExecSpace("ServerOnly")
    method void StashForTravel()
        -- 재소환 전에 다시 이동해도 대기 목록과 개체 상태를 잃지 않는다.
        self:Prune()
        local wanted = {}
        local states = {}
        local seen = {}
        local ids = {}
        for _, id in ipairs(self.Wanted) do table.insert(ids, id) end
        for id, _ in pairs(self.Units) do table.insert(ids, id) end
        for _, id in ipairs(ids) do
            if not seen[id] and self:Owner():GetShadow(id) ~= nil then
                seen[id] = true
                local state = self:GetTravelState(id)
                if state == nil or state.health > 0 then
                    table.insert(wanted, id)
                    states[id] = state
                end
            end
        end
        self:RecallAll()
        self.Wanted = wanted
        self.TravelStates = states
    end

    @ExecSpace("ServerOnly")
    method any GetTravelState(string id)
        -- 초기화가 끝난 살아 있는 개체를 우선하며, 스폰 대기 중에는 이전 이동 상태를 쓴다.
        local entity = self.Units[id]
        if isvalid(entity) then
            ---@type ShadowUnit
            local unit = entity:GetComponent("script.ShadowUnit")
            if unit ~= nil and unit.ShadowId == id and unit.MaxHp > 0 then
                local health = unit.Dead and 0 or math.max(0, math.min(1, unit.Hp / unit.MaxHp))
                return { health = health, promotion = unit.Promoted and unit.PromotionMultiplier or 1 }
            end
        end
        return self.TravelStates[id]
    end

    @ExecSpace("ServerOnly")
    method void CancelRedeployTimer()
        -- 이미 예약된 콜백도 세대 번호가 달라지면 새 이동에 끼어들 수 없다.
        self.RedeployGeneration = self.RedeployGeneration + 1
        if self.RedeployTimer ~= 0 then _TimerService:ClearTimer(self.RedeployTimer) end
        self.RedeployTimer = 0
    end

    @ExecSpace("ServerOnly")
    method void ScheduleRedeploy(number delay)
        -- 현재 맵에 도착한 뒤 한 번만 복원한다. 떠나거나 회수하면 예약을 취소한다.
        self:CancelRedeployTimer()
        if #self.Wanted == 0 or not isvalid(self.Entity) then return end
        local map = self.Entity.CurrentMap
        local generation = self.RedeployGeneration
        self.RedeployTimer = _TimerService:SetTimer(self, function()
            if not isvalid(self.Entity) or self.RedeployGeneration ~= generation then return end
            self.RedeployTimer = 0
            if self.Entity.CurrentMap == map then self:TryRedeploy() end
        end, delay, false, delay)
    end

    @ExecSpace("ServerOnly")
    method void OnMapEnter(Entity enteredMap)
        -- 같은 방 안의 맵 이동: 도착 1초 뒤 기억한 그림자를 다시 부른다
        self:ScheduleRedeploy(1)
    end

    @ExecSpace("ServerOnly")
    method void OnMapLeave(Entity leftMap)
        -- 이전 맵에서 예약한 재소환은 새 맵 입장 예약으로 대체한다.
        self:CancelRedeployTimer()
    end

    @ExecSpace("ServerOnly")
    method void TryRedeploy()
        -- 기억한 그림자 중 지금 부를 수 있는 것을 다시 소환 (소환 한도·재소환 대기는 평소 규칙대로)
        if #self.Wanted == 0 or not isvalid(self.Entity) or not _Util:IsAlive(self.Entity) then return end
        local wanted = self.Wanted
        self.Wanted = {}
        local n = 0
        for _, id in ipairs(wanted) do
            if self:Deploy(id) then
                n = n + 1
            elseif self:Owner():GetShadow(id) ~= nil and not isvalid(self.Units[id]) then
                table.insert(self.Wanted, id)
            end
        end
        log("[VRF] shadows redeployed " .. tostring(n) .. "/" .. tostring(#wanted))
    end

    method ShadowOwner Owner()
        ---@type ShadowOwner
        local o = self.Entity:GetComponent("script.ShadowOwner")
        return o
    end

    method integer GetSkillLevel(string id)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 0 end
        return book:GetLevel(id)
    end

    method integer GetDeployBonus()
        -- 배치 확장 스킬(1·8·16레벨에 +1, 최대 +3) + 장비(룬워드, 최대 +2). 절대 상한은 hardCap
        local lv = self:GetSkillLevel("deploy_expand")
        local bonus = _ShadowConfig:GetDeploySkillBonus(lv)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then bonus = bonus + stats.BonusDeploy end
        return bonus
    end

    method integer GetCapBonus()
        -- 세트 완성 효과로 늘어난 그림자 절대 상한
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return 0 end
        return stats.BonusShadowCap
    end

    method integer GetDeployLimit()
        -- Lv15(shadowFullLevel) 전에는 맛보기로 1기만 (잡으면 내편: Lv5부터 첫 그림자)
        local limit = _ShadowConfig:GetDeployLimit(self:GetDeployBonus(), self:GetCapBonus())
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil and stats.Level < _GameData.shadowFullLevel then limit = math.min(limit, math.floor(_GameData.shadowEarlyDeployLimit)) end
        -- 의뢰 영구 보상(가라앉은 지하실의 수장, 난이도마다 +1)은 초반 한도·절대 상한 위에 더한다 — 받은 순간부터 체감되게
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        if quest ~= nil then limit = limit + quest.DeployBonus end
        return limit
    end

    @ExecSpace("ServerOnly")
    method number GetUnitMultiplier()
        -- 그림자 소환 추가 레벨 + 군령 숙련 + 장비 소환수 보너스를 더한다.
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local equip = 0
        if stats ~= nil then equip = stats.BonusMinionPct end
        local summon = _GameData.shadowSummonPerLvPct * math.max(0, self:GetSkillLevel("shadow_summon") - 1)
        return 1 + (summon + _GameData.commandMasteryPct * self:GetSkillLevel("command_mastery") + equip + self:CommandAura().atk) / 100
    end

    method table CommandAura()
        -- 호령 오라 (소환수 공격·생명 / 이동 / 저항)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return { atk = 0, speed = 0, resist = 0 } end
        return book:GetCommandAura()
    end

    @ExecSpace("ServerOnly")
    method boolean CanDeploy(string id)
        local owner = self:Owner()
        local shadow = owner ~= nil and owner:GetShadow(id) or nil
        if shadow == nil or shadow.deployed then return false end
        if self:GetSkillLevel("shadow_summon") <= 0 then return false end
        if self.DeployedCount >= self:GetDeployLimit() then return false end
        if shadow.grade >= 3 and self:DeployedBossCount() >= math.floor(_GameData.bossShadowDeployLimit) then return false end
        return _UtilLogic.ServerElapsedSeconds >= shadow.respawnReadyAt
    end

    @ExecSpace("ServerOnly")
    method integer DeployedBossCount()
        -- 보스 그림자는 한 번에 bossShadowDeployLimit(1)기만
        local n = 0
        local owner = self:Owner()
        for id, _ in pairs(self.Units) do
            local s = owner:GetShadow(id)
            if s ~= nil and s.grade >= 3 then n = n + 1 end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method boolean Deploy(string id)
        self:Prune()
        if not self:CanDeploy(id) then return false end
        local owner = self:Owner()
        local shadow = owner:GetShadow(id)
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return false end
        local p = self.Entity.TransformComponent.WorldPosition
        local slotIndex = self:FindFreeSlot()
        local offset = self:GetFormationOffset(slotIndex)
        local unit = _SpawnService:SpawnByModelId(_GameConst.ModelShadowUnit, "Shadow_" .. shadow.sourceId, Vector3(p.x + offset.x, p.y + offset.y, p.z), map)
        if not isvalid(unit) then return false end
        shadow.slot = slotIndex
        shadow.deployed = true
        self.Units[id] = unit
        for i = #self.Wanted, 1, -1 do if self.Wanted[i] == id then table.remove(self.Wanted, i) end end
        self.DeployedCount = self.DeployedCount + 1
        owner:RefreshDigest()
        _Util:AfterSpawn(unit, "script.ShadowUnit", function(comp)
            if not isvalid(self.Entity) or self.Units[id] ~= unit then return end
            if self.Entity.CurrentMap ~= map or not _Util:IsAlive(self.Entity) then self:Recall(id) return end
            ---@type ShadowUnit
            local u = comp
            local prof = _ShadowConfig:GetProfile(shadow.sourceId, shadow.grade, _ShadowConfig:EffectiveLevel(shadow.level, _GameConst:LevelOf(self.Entity)), self:GetUnitMultiplier() * _ShadowConfig:GetPlusMult(_ShadowConfig:EffectivePlus(shadow.plus or 0, _GameConst:LevelOf(self.Entity)), shadow.grade))
            u:Setup(self.Entity, id, prof.atk, prof.hp, shadow.standRuid, shadow.moveRuid, offset)
            local source = _GameData:GetMonsterStats(shadow.sourceId)
            u.AttackRUID = source ~= nil and source.attack or ""
            u.Variant = shadow.variant or ""
            self:ApplyTraits(u, prof)
            local state = self.TravelStates[id]
            if state ~= nil then
                if state.promotion > 1 then u:Promote(state.promotion) end
                u.Hp = u.MaxHp * math.max(0, math.min(1, state.health))
                self.TravelStates[id] = nil
            end
        end, function()
            if self.Units[id] ~= unit then return end
            log_error("[ShadowCommander] ShadowUnit 연결 실패, 회수: " .. id)
            self:Recall(id)
        end)
        return true
    end

    @ExecSpace("ServerOnly")
    method void RefreshAllUnitStats()
        -- 주인 레벨업: 소환 중인 그림자 모두 힘(EffectiveLevel)을 다시 계산
        for id, _ in pairs(self.Units) do self:RefreshUnitStats(id) end
    end

    @ExecSpace("ServerOnly")
    method void RefreshUnitStats(string id)
        -- 강화·레벨 업 직후 소환 중인 그림자 능력치 반영
        local unit = self.Units[id]
        local shadow = self:Owner():GetShadow(id)
        if not isvalid(unit) or shadow == nil then return end
        ---@type ShadowUnit
        local comp = unit:GetComponent("script.ShadowUnit")
        if comp == nil then return end
        local prof = _ShadowConfig:GetProfile(shadow.sourceId, shadow.grade, _ShadowConfig:EffectiveLevel(shadow.level, _GameConst:LevelOf(self.Entity)), self:GetUnitMultiplier() * _ShadowConfig:GetPlusMult(_ShadowConfig:EffectivePlus(shadow.plus or 0, _GameConst:LevelOf(self.Entity)), shadow.grade))
        if comp.Promoted then
            prof.atk = math.floor(prof.atk * comp.PromotionMultiplier)
            prof.hp = prof.hp * comp.PromotionMultiplier
        end
        comp.Atk = prof.atk
        comp.Hp = comp.Hp + (prof.hp - comp.MaxHp)
        comp.MaxHp = prof.hp
    end

    @ExecSpace("ServerOnly")
    method void ApplyTraits(ShadowUnit u, table prof)
        -- 원본 몬스터 개성: 공격 간격·사거리·이동 속도·속성 공격·저항
        u.AttackCooldown = prof.cooldown
        u.AttackRange = prof.range
        u.Element = prof.element
        u.ElementRatio = prof.ratio
        u.Resists = prof.resists
        local aura = self:CommandAura()
        u.BonusResist = aura.resist
        local mv = u.Entity.MovementComponent
        if isvalid(mv) then mv.InputSpeed = prof.speed * (1 + aura.speed / 100) end
    end

    @ExecSpace("ServerOnly")
    method integer FindFreeSlot()
        -- 소환 중인 그림자가 쓰지 않는 가장 앞 대형 번호 (0부터)
        local used = {}
        for id, unit in pairs(self.Units) do
            local s = self:Owner():GetShadow(id)
            if s ~= nil then used[s.slot] = true end
        end
        for i = 0, _ShadowConfig:GetHardCap() + self:GetCapBonus() - 1 do
            if not used[i] then return i end
        end
        return 0
    end

    @ExecSpace("ServerOnly")
    method Vector2 GetFormationOffset(integer slot)
        -- 탑다운 대형: 주인 뒤쪽 반원부터 (최대 10칸: 상한 8 + 세트 +2)
        local offsets = {
            Vector2(-0.7, -0.5), Vector2(0.7, -0.5), Vector2(0, -0.9), Vector2(-1.3, 0),
            Vector2(1.3, 0), Vector2(-1.1, -1.0), Vector2(1.1, -1.0), Vector2(0, 0.8),
            Vector2(-1.8, -0.6), Vector2(1.8, -0.6),
        }
        return offsets[(slot % #offsets) + 1]
    end

    @ExecSpace("ServerOnly")
    method boolean Recall(string id)
        -- 명시적 회수는 아직 도착하지 않은 소환도 취소한다. 이동 회수는 호출자가 상태를 따로 보관한다.
        self.TravelStates[id] = nil
        for i = #self.Wanted, 1, -1 do if self.Wanted[i] == id then table.remove(self.Wanted, i) end end
        local owner = self:Owner()
        local shadow = owner:GetShadow(id)
        if shadow == nil or not shadow.deployed then return false end
        local unit = self.Units[id]
        if isvalid(unit) then unit:Destroy() end
        self.Units[id] = nil
        shadow.deployed = false
        self.DeployedCount = math.max(0, self.DeployedCount - 1)
        owner:RefreshDigest()
        return true
    end

    @ExecSpace("ServerOnly")
    method void OnUnitDied(string id)
        -- 그림자 사망: 보관함으로 돌아가되 respawnDelaySec 동안 재소환 불가
        self.TravelStates[id] = nil
        for i = #self.Wanted, 1, -1 do if self.Wanted[i] == id then table.remove(self.Wanted, i) end end
        local owner = self:Owner()
        local shadow = owner:GetShadow(id)
        if shadow == nil then return end
        local unit = self.Units[id]
        if isvalid(unit) then unit:Destroy() end
        self.Units[id] = nil
        if shadow.deployed then
            shadow.deployed = false
            self.DeployedCount = math.max(0, self.DeployedCount - 1)
        end
        shadow.respawnReadyAt = _UtilLogic.ServerElapsedSeconds + _ShadowConfig:GetRespawnDelay()
        owner:RefreshDigest()
        -- 사망 안내는 ShadowUnit의 소유자 전용 아이콘 알림으로 한 번만 전달한다.
    end

    @ExecSpace("ServerOnly")
    method integer DeployNext()
        -- 소환 지정이 있으면 지정 순서대로 다음 하나, 지정이 없으면 등급·레벨이 높은 것 하나. 소환한 수(0/1)
        self:Prune()
        local owner = self:Owner()
        local assigned = owner:AssignedList()
        if #assigned > 0 then
            for _, id in ipairs(assigned) do
                if self:CanDeploy(id) then return self:Deploy(id) and 1 or 0 end
            end
            return 0
        end
        local best = nil
        for id, s in pairs(self:Owner().Storage) do
            if self:CanDeploy(id) and (best == nil or s.grade * 100 + s.level > best.grade * 100 + best.level) then best = s end
        end
        if best == nil then return 0 end
        return self:Deploy(best.id) and 1 or 0
    end

    @ExecSpace("ServerOnly")
    method void RecallAll()
        -- 사망·직접 회수 시 이동 예약까지 지워 뒤늦게 소환되지 않게 한다.
        self:CancelRedeployTimer()
        self.Wanted = {}
        self.TravelStates = {}
        for id, _ in pairs(self.Units) do self:Recall(id) end
    end

    @ExecSpace("ServerOnly")
    method integer RallyAll()
        -- 집결: 잠시 적을 무시하고 주인 곁으로 (언데드 포함). 따라온 소환수 수
        local n = _UndeadSystem:RallyAll(self.Entity, self.RallySeconds)
        for _, unit in pairs(self.Units) do
            if isvalid(unit) then
                ---@type ShadowUnit
                local comp = unit:GetComponent("script.ShadowUnit")
                if comp ~= nil then
                    comp:Rally(self.RallySeconds)
                    n = n + 1
                end
            end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method string DeployBlockReason()
        -- 그림자 소환이 안 될 때 이유 (DeployNext가 0일 때)
        local owner = self:Owner()
        local stored = 0
        local waiting = 0
        local now = _UtilLogic.ServerElapsedSeconds
        if owner ~= nil then
            for _, s in pairs(owner.Storage) do
                if not s.deployed then
                    stored = stored + 1
                    if now < s.respawnReadyAt then waiting = waiting + 1 end
                end
            end
        end
        if self.DeployedCount >= self:GetDeployLimit() then return "그림자 소환 한도 " .. tostring(self:GetDeployLimit()) .. "기에 도달했다" end
        -- 소환 지정이 있으면 지정한 그림자만 부른다
        if owner ~= nil and #owner:AssignedList() > 0 then
            local recovering = 0
            local idle = 0
            for _, id in ipairs(owner:AssignedList()) do
                local s = owner:GetShadow(id)
                if s ~= nil and not s.deployed then
                    if now < s.respawnReadyAt then recovering = recovering + 1 else idle = idle + 1 end
                end
            end
            if recovering > 0 and idle == 0 then return "지정한 그림자가 아직 회복 중이다" end
            if idle == 0 then return "지정한 그림자가 모두 소환 중이다 — 보관함(H)에서 소환 지정을 바꿀 수 있다" end
        end
        if stored == 0 then return "부를 그림자가 없다 — 혼을 추출해 그림자를 모으세요" end
        if waiting == stored then return "그림자가 아직 회복 중이다" end
        return "지금은 그림자를 부를 수 없다"
    end

    @ExecSpace("ServerOnly")
    method table GetUnits()
        -- 소환 중인 그림자 컴포넌트 목록 (정예 승격·혼 흡수 등 스킬용)
        local list = {}
        for _, unit in pairs(self.Units) do
            if isvalid(unit) then
                ---@type ShadowUnit
                local comp = unit:GetComponent("script.ShadowUnit")
                if comp ~= nil then table.insert(list, comp) end
            end
        end
        return list
    end

    -- ───────── 클라이언트 요청 ─────────

    @ExecSpace("Server")
    method void RequestDeploy(string id)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:GetSkillLevel("shadow_summon") <= 0 then
            _Util:Notify("그림자 소환은 스킬 「그림자 소환」(Lv" .. tostring(_SkillData:Get("shadow_summon").row) .. ")을 배워야 한다", senderUserId)
            return
        end
        if id == "" then self:DeployNext() else self:Deploy(id) end
    end

    @ExecSpace("Server")
    method void RequestRecall(string id)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if id == "" then self:RecallAll() else self:Recall(id) end
    end

    @ExecSpace("Server")
    method void RequestRally()
        -- 집결은 스킬 「집결」을 배워야 쓴다 (C 키·모바일 버튼). 마나·쿨다운은 스킬 시전 규칙을 따른다
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:GetSkillLevel("rally") <= 0 then
            _Util:Notify("집결은 스킬 「집결」(Lv" .. tostring(_SkillData:Get("rally").row) .. ")을 배워야 한다", senderUserId)
            return
        end
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then book:Cast("rally", _Util:Pos2(self.Entity)) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        if event.key == KeyboardKey.Z then self:RequestDeploy("")
        elseif event.key == KeyboardKey.X then self:RequestRecall("")
        elseif event.key == KeyboardKey.C then self:RequestRally() end
    end

end
