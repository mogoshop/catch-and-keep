-- 그림자 지휘: 보관함(ShadowOwner)의 그림자를 엔티티로 소환·회수·집결하고 대형을 관리한다.
-- 단축키: Z 소환, X 전체 회수, C 집결 (짧게 = 집결 · 길게 = 고른 적에게 모두 집중 — 44-3 D).
-- 44-3 B: 정예 승격·그림자 희생이 쓸 그림자를 플레이어가 고른다 (PC 클릭 · 소환수 띠 카드 · 모바일 터치) — PickedShadow.
@Component
script ShadowCommander extends Component

    property number RallySeconds = 2.5
    property number FocusSeconds = 3          -- 「저 적을」: 모든 소환수가 고른 적을 먼저 치는 시간 (ShadowUnit.Focus)
    property number FocusHoldSeconds = 0.45   -- C를 이만큼 누르고 있으면 집결 대신 집중
    property number PickSeconds = 15          -- 고른 그림자를 기억하는 시간 (그 사이 승격·희생을 안 쓰면 잊는다 — 실수로 고른 귀한 그림자 보호)
    property Entity PickedUnit = nil          -- 서버: 고른 그림자 엔티티
    property number PickedUntil = 0           -- 서버: 이 시각까지 유효
    property Entity PickedLocal = nil         -- 클라이언트: 내가 고른 그림자 (소환수 띠 카드 강조 · 표식)
    property number PickedLocalUntil = 0
    property integer PickMarker = 0           -- 클라이언트: 고른 그림자 발밑 표식 입자
    property integer FocusMarker = 0          -- 클라이언트: 집중 대상 머리 위 표식 입자
    property number FocusMarkW = 0.6           -- 집중 대상 표시(M25) 가로 (10-31 갈래 E · 예전 0.45)
    property number FocusMarkH = 0.25          -- 집중 대상 표시 세로 (예전 0.16 — 납작해 안 보였다)
    property number RallyKeyAt = -1           -- 클라이언트: C를 누르기 시작한 시각 (-1 = 안 누름)
    property integer RallyKeyTimer = 0        -- 클라이언트: 길게 누름 문턱 타이머
    property table Units = {}                -- shadow id → 소환된 엔티티
    property table Wanted = {}               -- 맵 이동 뒤 다시 부를 그림자 id (이동 전에 소환 중이던 것)
    property table TravelStates = {}          -- 재소환 대기 중인 개체의 체력 비율·시전 당시 승격 배율
    property integer RedeployTimer = 0
    property integer RedeployGeneration = 0
    @Sync
    property integer DeployedCount = 0
    @Sync
    property string UndeadSummary = ""       -- UndeadSystem이 채우는 "해골 3/4 · 마법사 1/1"
    @Sync
    property string MinionCounts = "0,0,0"   -- 해골·마법사·되살림 수 (HUD 소환수 배지)
    @TargetUserSync
    property string UndeadRoster = "|0"      -- 해골 전사·마법사 변이 목록 (오래된 순) + 거인 예약 수 — 스킬 창 편성 미리보기 (UndeadSystem.EncodeRoster · I03)
    @TargetUserSync
    property string GiantKind = ""           -- 서 있는 뼈 의식 거인 종류 (basic·shield·greatsword·twin·mage · "" = 없음) — 클라이언트 의식 단계 예측(SkillBook.GiantStanding)·HUD (46-1 · UndeadSystem.RefreshSummary)

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 플레이어마다 독립적인 소환·이동 대기 상태를 만든다.
        self.Units = {}
        self.Wanted = {}
        self.TravelStates = {}
    end

    method void OnEndPlay()
        -- 주인이 나가면 소환된 그림자 정리 (클라이언트: C 길게 누름 타이머·고른 그림자·집중 표식)
        if not self:IsServer() then
            if self.RallyKeyTimer ~= 0 then _TimerService:ClearTimer(self.RallyKeyTimer) self.RallyKeyTimer = 0 end
            if self.PickMarker ~= 0 then _ParticleService:RemoveParticle(self.PickMarker) self.PickMarker = 0 end
            if self.FocusMarker ~= 0 then _ParticleService:RemoveParticle(self.FocusMarker) self.FocusMarker = 0 end
            self.PickedLocal = nil
            return
        end
        self:CancelRedeployTimer()
        for _, unit in pairs(self.Units) do
            if isvalid(unit) then unit:Destroy() end
        end
        self.Units = {}
        self.Wanted = {}
        self.TravelStates = {}
    end

    @ExecSpace("ServerOnly")
    method void Prune()
        -- 엔티티가 사라진 소환(다른 맵·방으로 옮겨져 스스로 사라짐 등)을 보관함 상태와 맞춘다
        local owner = self:Owner()
        local changed = false
        for id, unit in pairs(self.Units) do
            if not isvalid(unit) then
                self.Units[id] = nil
                local shadow = owner ~= nil and owner:GetShadow(id) or nil
                if shadow ~= nil and shadow.deployed then shadow.deployed = false end
                self.DeployedCount = math.max(0, self.DeployedCount - 1)
                changed = true
            end
        end
        if changed and owner ~= nil then owner:RefreshDigest() end
    end

    @ExecSpace("ServerOnly")
    method void StashForTravel()
        -- 재소환 전에 다시 이동해도 대기 목록과 개체 상태를 잃지 않는다.
        self:Prune()
        local wanted = {}
        local states = {}
        local seen = {}
        local ids = {}
        for _, id in ipairs(self.Wanted) do table.insert(ids, id) end
        for id, _ in pairs(self.Units) do table.insert(ids, id) end
        for _, id in ipairs(ids) do
            if not seen[id] and self:Owner():GetShadow(id) ~= nil then
                seen[id] = true
                local state = self:GetTravelState(id)
                if state == nil or state.health > 0 then
                    table.insert(wanted, id)
                    states[id] = state
                end
            end
        end
        self:RecallAll()
        self.Wanted = wanted
        self.TravelStates = states
    end

    @ExecSpace("ServerOnly")
    method any GetTravelState(string id)
        -- 초기화가 끝난 살아 있는 개체를 우선하며, 스폰 대기 중에는 이전 이동 상태를 쓴다.
        local entity = self.Units[id]
        if isvalid(entity) then
            ---@type ShadowUnit
            local unit = entity:GetComponent("script.ShadowUnit")
            if unit ~= nil and unit.ShadowId == id and unit.MaxHp > 0 then
                local health = unit.Dead and 0 or math.max(0, math.min(1, unit.Hp / unit.MaxHp))
                return { health = health, promotion = unit.Promoted and unit.PromotionMultiplier or 1 }
            end
        end
        return self.TravelStates[id]
    end

    @ExecSpace("ServerOnly")
    method void CancelRedeployTimer()
        -- 이미 예약된 콜백도 세대 번호가 달라지면 새 이동에 끼어들 수 없다.
        self.RedeployGeneration = self.RedeployGeneration + 1
        if self.RedeployTimer ~= 0 then _TimerService:ClearTimer(self.RedeployTimer) end
        self.RedeployTimer = 0
    end

    @ExecSpace("ServerOnly")
    method void ScheduleRedeploy(number delay)
        -- 현재 맵에 도착한 뒤 한 번만 복원한다. 떠나거나 회수하면 예약을 취소한다.
        self:CancelRedeployTimer()
        if #self.Wanted == 0 or not isvalid(self.Entity) then return end
        local map = self.Entity.CurrentMap
        local generation = self.RedeployGeneration
        self.RedeployTimer = _TimerService:SetTimer(self, function()
            if not isvalid(self.Entity) or self.RedeployGeneration ~= generation then return end
            self.RedeployTimer = 0
            if self.Entity.CurrentMap == map then self:TryRedeploy() end
        end, delay, false, delay)
    end

    @ExecSpace("ServerOnly")
    method void OnMapEnter(Entity enteredMap)
        -- 같은 방 안의 맵 이동: 도착 1초 뒤 기억한 그림자를 다시 부른다. 마을이면 지친 그림자가 쉰다 (사망 한도 초기화)
        if _GameConst:IsTown(enteredMap) then
            local owner = self:Owner()
            if owner ~= nil then owner:RestAll() end
        end
        self:ScheduleRedeploy(1)
    end

    @ExecSpace("ServerOnly")
    method void OnMapLeave(Entity leftMap)
        -- 이전 맵에서 예약한 재소환은 새 맵 입장 예약으로 대체한다.
        self:CancelRedeployTimer()
    end

    @ExecSpace("ServerOnly")
    method void TryRedeploy()
        -- 기억한 그림자 중 지금 부를 수 있는 것을 다시 소환 (소환 한도·재소환 대기는 평소 규칙대로)
        if #self.Wanted == 0 or not isvalid(self.Entity) or not _Util:IsAlive(self.Entity) then return end
        local wanted = self.Wanted
        self.Wanted = {}
        local n = 0
        for _, id in ipairs(wanted) do
            if self:Deploy(id) then
                n = n + 1
            elseif self:Owner():GetShadow(id) ~= nil and not isvalid(self.Units[id]) then
                table.insert(self.Wanted, id)
            end
        end
        log("[VRF] shadows redeployed " .. tostring(n) .. "/" .. tostring(#wanted))
    end

    method ShadowOwner Owner()
        ---@type ShadowOwner
        local o = self.Entity:GetComponent("script.ShadowOwner")
        return o
    end

    method integer GetSkillLevel(string id)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 0 end
        return book:GetPowerLevel(id)
    end

    method integer GetDeployBonus()
        -- 배치 확장 랭크(최대 +3) + 장비. 절대 상한은 hardCap
        -- 랭크 N은 캐릭터 Lv deployExpandFromLv + step×(N-1)부터 효과 (예전에 미리 찍어 둔 저장도 같은 규칙 — 10-24)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        ---@type PlayerStats
        local ps = self.Entity:GetComponent("script.PlayerStats")
        local lv = self:GetSkillLevel("deploy_expand")
        if book ~= nil and ps ~= nil then lv = book:NodeUsable("deploy_expand", lv, ps.Level) end
        local bonus = _ShadowConfig:GetDeploySkillBonus(lv)
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then bonus = bonus + stats.BonusDeploy end
        return bonus
    end

    method integer GetCapBonus()
        -- 세트 완성 효과로 늘어난 그림자 절대 상한
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return 0 end
        return stats.BonusShadowCap
    end

    method integer GetDeployLimit()
        -- Lv15(shadowFullLevel) 전에는 맛보기로 1기만 (잡으면 내편: Lv5부터 첫 그림자)
        local limit = _ShadowConfig:GetDeployLimit(self:GetDeployBonus(), self:GetCapBonus())
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil and stats.Level < _GameData.shadowFullLevel then limit = math.min(limit, math.floor(_GameData.shadowEarlyDeployLimit)) end
        -- 의뢰 영구 보상(가라앉은 지하실의 수장, 난이도마다 +1)은 초반 한도 위에 더한다 — 받은 순간부터 체감되게.
        -- 다만 모든 보너스를 합쳐도 hardCap + 장비 상한 최대(8 + 2 = 10기)를 넘지 않는다 (10-24 사용자 B안 · 예전엔 의뢰가 상한 밖이라 12기)
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        if quest ~= nil then limit = limit + quest.DeployBonus end
        return math.min(limit, _ShadowConfig:GetHardCap() + math.floor(_GameData.shadowCapBonusMax))
    end

    @ExecSpace("ServerOnly")
    method number GetUnitMultiplier()
        -- 그림자 소환 추가 레벨 + 군령 숙련 + 장비 소환수 보너스를 더한다.
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local equip = 0
        if stats ~= nil then equip = stats:GetMinionPct() end   -- 장비 + 통솔
        local summon = _GameData.shadowSummonPerLvPct * math.max(0, self:GetSkillLevel("shadow_summon") - 1)
        -- 군령: 그림자 소환 commandMasteryStep 랭크마다 한 랭크만 효과 (예전에 미리 찍어 둔 저장도 같은 규칙 · 10-24 C안)
        local command = math.min(self:GetSkillLevel("command_mastery"), self:GetSkillLevel("shadow_summon") // math.max(1, math.floor(_GameData.commandMasteryStep)))
        return 1 + (summon + _GameData.commandMasteryPct * command + equip + self:CommandAura().atk) / 100
    end

    method table CommandAura()
        -- 호령 오라 (소환수 공격·생명 / 이동 / 저항)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return { atk = 0, speed = 0, resist = 0 } end
        return book:GetCommandAura()
    end

    @ExecSpace("ServerOnly")
    method boolean CanDeploy(string id)
        local owner = self:Owner()
        local shadow = owner ~= nil and owner:GetShadow(id) or nil
        if shadow == nil or shadow.deployed then return false end
        if self:GetSkillLevel("shadow_summon") <= 0 then return false end
        if self.DeployedCount >= self:GetDeployLimit() then return false end
        if shadow.grade >= 3 and self:DeployedBossCount() >= math.floor(_GameData.bossShadowDeployLimit) then return false end
        if self:IsExhausted(shadow) then return false end
        return _UtilLogic.ServerElapsedSeconds >= shadow.respawnReadyAt
    end

    method boolean IsExhausted(any shadow)
        -- 사망 한도를 채운 정예·보스 그림자 (마을에 들르면 풀린다)
        local limit = _ShadowConfig:GetDeathLimit(shadow.grade)
        return limit > 0 and (shadow.deaths or 0) >= limit
    end

    @ExecSpace("ServerOnly")
    method integer DeployedBossCount()
        -- 보스 그림자는 한 번에 bossShadowDeployLimit(1)기만
        local n = 0
        local owner = self:Owner()
        for id, _ in pairs(self.Units) do
            local s = owner:GetShadow(id)
            if s ~= nil and s.grade >= 3 then n = n + 1 end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method boolean Deploy(string id)
        self:Prune()
        if not self:CanDeploy(id) then return false end
        local owner = self:Owner()
        local shadow = owner:GetShadow(id)
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return false end
        local p = self.Entity.TransformComponent.WorldPosition
        local slotIndex = self:FindFreeSlot()
        local offset = self:GetFormationOffset(slotIndex)
        local unit = _SpawnService:SpawnByModelId(_GameConst.ModelShadowUnit, "Shadow_" .. shadow.sourceId, Vector3(p.x + offset.x, p.y + offset.y, p.z), map)
        if not isvalid(unit) then return false end
        shadow.slot = slotIndex
        shadow.deployed = true
        self.Units[id] = unit
        for i = #self.Wanted, 1, -1 do if self.Wanted[i] == id then table.remove(self.Wanted, i) end end
        self.DeployedCount = self.DeployedCount + 1
        owner:RefreshDigest()
        -- 44-1 C 코덱스 H-7 그림자 솟아오름(GameConst.FxSkillShadowRise · 피벗 0.5/0.1 발밑)이 오면 소환 자리에서 한 번 (비어 있으면 지금처럼 아무것도 안 한다)
        if _GameConst.FxSkillShadowRise ~= "" then
            ---@type SkillEffects
            local fx = self.Entity:GetComponent("script.SkillEffects")
            if fx ~= nil then fx:FramesFx(_GameConst.FxSkillShadowRise, Vector3(p.x + offset.x, p.y + offset.y, 0), 1.25, fx.RiseFrameSec, fx.RiseFrameSec + fx.RiseHoldSec, fx.RiseFadeSec) end   -- 10-31 갈래 E: 6장 0.48초 + 잡기 0.15 + 옅어짐 0.15
        end
        _Util:AfterSpawn(unit, "script.ShadowUnit", function(comp)
            if not isvalid(self.Entity) or self.Units[id] ~= unit then return end
            if self.Entity.CurrentMap ~= map or not _Util:IsAlive(self.Entity) then self:Recall(id) return end
            ---@type ShadowUnit
            local u = comp
            local prof = _ShadowConfig:GetProfile(shadow.sourceId, shadow.grade, _ShadowConfig:EffectiveLevel(shadow.level, _GameConst:LevelOf(self.Entity)), self:GetUnitMultiplier() * _ShadowConfig:GetPlusMult(_ShadowConfig:EffectivePlus(shadow.plus or 0, _GameConst:LevelOf(self.Entity)), shadow.grade))
            u:Setup(self.Entity, id, prof.atk, prof.hp, shadow.standRuid, shadow.moveRuid, offset)
            local source = _GameData:GetMonsterStats(shadow.sourceId)
            -- 소환수 크기 맞춤 (보스도 다른 소환수와 비슷하게 — GameData summonScale)
            local sc = source ~= nil and source.summonScale or 1
            unit.TransformComponent.Scale = Vector3(sc, sc, 1)
            u.AttackRUID = source ~= nil and source.attack or ""
            u.Variant = shadow.variant or ""
            self:ApplyTraits(u, prof)
            local state = self.TravelStates[id]
            if state ~= nil then
                if state.promotion > 1 then u:Promote(state.promotion) end
                u.Hp = u.MaxHp * math.max(0, math.min(1, state.health))
                self.TravelStates[id] = nil
            end
            self:ChoiceElite(u)
        end, function()
            if self.Units[id] ~= unit then return end
            log_error("[ShadowCommander] ShadowUnit 연결 실패, 회수: " .. id)
            self:Recall(id)
        end)
        return true
    end

    @ExecSpace("ServerOnly")
    method void RefreshAllUnitStats()
        -- 주인 레벨업: 소환 중인 그림자 모두 힘(EffectiveLevel)을 다시 계산
        for id, _ in pairs(self.Units) do self:RefreshUnitStats(id) end
    end

    @ExecSpace("ServerOnly")
    method void RefreshUnitStats(string id)
        -- 강화·레벨 업 직후 소환 중인 그림자 능력치 반영
        local unit = self.Units[id]
        local shadow = self:Owner():GetShadow(id)
        if not isvalid(unit) or shadow == nil then return end
        ---@type ShadowUnit
        local comp = unit:GetComponent("script.ShadowUnit")
        if comp == nil then return end
        local prof = _ShadowConfig:GetProfile(shadow.sourceId, shadow.grade, _ShadowConfig:EffectiveLevel(shadow.level, _GameConst:LevelOf(self.Entity)), self:GetUnitMultiplier() * _ShadowConfig:GetPlusMult(_ShadowConfig:EffectivePlus(shadow.plus or 0, _GameConst:LevelOf(self.Entity)), shadow.grade))
        if comp.Promoted then
            prof.atk = math.floor(prof.atk * comp.PromotionMultiplier)
            prof.hp = prof.hp * comp.PromotionMultiplier
        end
        comp.Atk = prof.atk
        comp.Hp = comp.Hp + (prof.hp - comp.MaxHp)
        comp.MaxHp = prof.hp
    end

    @ExecSpace("ServerOnly")
    method void ApplyTraits(ShadowUnit u, table prof)
        -- 원본 몬스터 개성: 공격 간격·사거리·이동 속도·속성 공격·저항
        u.AttackCooldown = prof.cooldown
        u.AttackRange = prof.range
        u.Element = prof.element
        u.ElementRatio = prof.ratio
        u.Resists = prof.resists
        local aura = self:CommandAura()
        u.BonusResist = aura.resist
        u:SetBaseSpeed(prof.speed * (1 + aura.speed / 100))
    end

    @ExecSpace("ServerOnly")
    method integer FindFreeSlot()
        -- 소환 중인 그림자가 쓰지 않는 가장 앞 대형 번호 (0부터)
        local used = {}
        for id, unit in pairs(self.Units) do
            local s = self:Owner():GetShadow(id)
            if s ~= nil then used[s.slot] = true end
        end
        for i = 0, _ShadowConfig:GetHardCap() + self:GetCapBonus() - 1 do
            if not used[i] then return i end
        end
        return 0
    end

    @ExecSpace("ServerOnly")
    method Vector2 GetFormationOffset(integer slot)
        -- 탑다운 대형: 주인 뒤쪽 반원부터 (최대 10칸: 상한 8 + 세트 +2)
        local offsets = {
            Vector2(-0.7, -0.5), Vector2(0.7, -0.5), Vector2(0, -0.9), Vector2(-1.3, 0),
            Vector2(1.3, 0), Vector2(-1.1, -1.0), Vector2(1.1, -1.0), Vector2(0, 0.8),
            Vector2(-1.8, -0.6), Vector2(1.8, -0.6),
        }
        return offsets[(slot % #offsets) + 1]
    end

    @ExecSpace("ServerOnly")
    method boolean Recall(string id)
        -- 명시적 회수는 아직 도착하지 않은 소환도 취소한다. 이동 회수는 호출자가 상태를 따로 보관한다.
        self.TravelStates[id] = nil
        for i = #self.Wanted, 1, -1 do if self.Wanted[i] == id then table.remove(self.Wanted, i) end end
        local owner = self:Owner()
        local shadow = owner:GetShadow(id)
        if shadow == nil or not shadow.deployed then return false end
        local unit = self.Units[id]
        if isvalid(unit) then unit:Destroy() end
        self.Units[id] = nil
        shadow.deployed = false
        self.DeployedCount = math.max(0, self.DeployedCount - 1)
        owner:RefreshDigest()
        return true
    end

    @ExecSpace("ServerOnly")
    method void OnUnitDied(string id)
        -- 그림자 사망: 보관함으로 돌아가되 respawnDelaySec 동안 재소환 불가
        self.TravelStates[id] = nil
        for i = #self.Wanted, 1, -1 do if self.Wanted[i] == id then table.remove(self.Wanted, i) end end
        local owner = self:Owner()
        local shadow = owner:GetShadow(id)
        if shadow == nil then return end
        local unit = self.Units[id]
        if isvalid(unit) then unit:Destroy() end
        self.Units[id] = nil
        if shadow.deployed then
            shadow.deployed = false
            self.DeployedCount = math.max(0, self.DeployedCount - 1)
        end
        shadow.respawnReadyAt = _UtilLogic.ServerElapsedSeconds + _ShadowConfig:GetRespawnDelay()
        -- 정예·보스 사망 한도 (10-20 사용자 결정): 한도만큼 쓰러지면 마을에 들를 때까지 소환할 수 없다
        local limit = _ShadowConfig:GetDeathLimit(shadow.grade)
        if limit > 0 then
            shadow.deaths = (shadow.deaths or 0) + 1
            local uid = self.Entity.PlayerComponent.UserId
            local name = _GameData:GetMonsterName(shadow.sourceId)
            if shadow.deaths >= limit then
                _Util:Notify(name .. " 그림자가 지쳤습니다 — 마을에 들를 때까지 소환할 수 없습니다 (" .. tostring(limit) .. "번 쓰러짐)", uid)
            else
                _Util:Notify(string.format("%s 그림자 쓰러짐 %d/%d — 한도가 차면 마을에 들를 때까지 부를 수 없습니다", name, shadow.deaths, limit), uid)
            end
        end
        owner:RefreshDigest()
        -- 사망 안내는 ShadowUnit의 소유자 전용 아이콘 알림으로 한 번만 전달한다.
    end

    @ExecSpace("ServerOnly")
    method void ChoiceElite(ShadowUnit u)
        -- 선택 보상 2차 군단 「정예로 서는 그림자」: 정예가 하나도 없으면 막 선 그림자를 정예로 (×1.25 · 1.35 · 1.45)
        ---@type PlayerQuest
        local quest = self.Entity:GetComponent("script.PlayerQuest")
        local tier = quest ~= nil and quest:ChoiceTier(2, "command") or 0
        if tier <= 0 or u.Promoted then return end
        for _, other in ipairs(self:GetUnits()) do if other.Promoted and not other.Dead then return end end
        u:Promote(1.15 + 0.1 * tier)
        log(string.format("[VRF] choice elite shadow ×%.2f", 1.15 + 0.1 * tier))
    end

    @ExecSpace("ServerOnly")
    method integer DeployNext()
        -- 소환 지정이 있으면 지정 순서대로 다음 하나, 지정이 없으면 등급·레벨이 높은 것 하나. 소환한 수(0/1)
        self:Prune()
        local owner = self:Owner()
        local assigned = owner:AssignedList()
        if #assigned > 0 then
            for _, id in ipairs(assigned) do
                if self:CanDeploy(id) then return self:Deploy(id) and 1 or 0 end
            end
            return 0
        end
        local best = nil
        for id, s in pairs(self:Owner().Storage) do
            if self:CanDeploy(id) and (best == nil or s.grade * 100 + s.level > best.grade * 100 + best.level) then best = s end
        end
        if best == nil then return 0 end
        return self:Deploy(best.id) and 1 or 0
    end

    @ExecSpace("ServerOnly")
    method void RecallAll()
        -- 사망·직접 회수 시 이동 예약까지 지워 뒤늦게 소환되지 않게 한다.
        self:CancelRedeployTimer()
        self.Wanted = {}
        self.TravelStates = {}
        for id, _ in pairs(self.Units) do self:Recall(id) end
    end

    @ExecSpace("ServerOnly")
    method integer RallyAll()
        -- 집결: 잠시 적을 무시하고 주인 곁으로 (언데드 포함). 따라온 소환수 수
        local n = _UndeadSystem:RallyAll(self.Entity, self.RallySeconds)
        for _, unit in pairs(self.Units) do
            if isvalid(unit) then
                ---@type ShadowUnit
                local comp = unit:GetComponent("script.ShadowUnit")
                if comp ~= nil then
                    comp:Rally(self.RallySeconds)
                    n = n + 1
                end
            end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method integer FocusAll(Entity target, number seconds)
        -- 「저 적을」 (44-3 D): 내 그림자·언데드가 seconds 동안 target을 먼저 친다 (집결 중이면 집결을 끊는다). 따른 소환수 수
        --   숨은 규칙(주인이 고른 적을 먼저 · ShadowUnit.FindNearestMonster)을 누를 때만 강하게 — 진형을 저절로 바꾸지 않는다 (41 #5 C)
        local n = 0
        for _, c in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            ---@type ShadowUnit
            local u = c
            if isvalid(u.Entity) and u.OwnerPlayer == self.Entity and not u.Dead and u.Hp > 0 and not u.Bombing then
                u:Focus(target, seconds)
                n = n + 1
            end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method ShadowUnit PickedShadow()
        -- 고른 그림자 (44-3 B): 아직 살아 소환 중이고 시간 안이면 그 컴포넌트, 아니면 nil (정예 승격·그림자 희생이 먼저 쓴다)
        if not isvalid(self.PickedUnit) or _UtilLogic.ElapsedSeconds >= self.PickedUntil then return nil end
        ---@type ShadowUnit
        local u = self.PickedUnit:GetComponent("script.ShadowUnit")
        if u == nil or u.Dead or u.Hp <= 0 or u.OwnerPlayer ~= self.Entity or u.Kind ~= "shadow" then return nil end
        if self.Units[u.ShadowId] ~= self.PickedUnit then return nil end
        return u
    end

    @ExecSpace("ServerOnly")
    method void ClearPick()
        -- 고른 그림자를 썼거나(승격·희생) 잊는다 → 내 화면 표식도 거둔다
        if self.PickedUnit == nil then return end
        self.PickedUnit = nil
        self.PickedUntil = 0
        self:ShowPick(nil, 0, self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("Server")
    method void RequestPickShadow(Entity unit)
        -- 내 그림자 고르기 (PC 클릭 · 소환수 띠 카드 · 모바일 터치). 같은 그림자를 다시 고르면 풀린다
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if not isvalid(unit) then self:ClearPick() return end
        ---@type ShadowUnit
        local u = unit:GetComponent("script.ShadowUnit")
        if u == nil or u.OwnerPlayer ~= self.Entity or u.Kind ~= "shadow" or u.Dead or u.Hp <= 0 then return end
        if self.PickedUnit == unit and _UtilLogic.ElapsedSeconds < self.PickedUntil then
            self:ClearPick()
            log("[VRF] shadow pick cleared " .. u.ShadowId)
            return
        end
        self.PickedUnit = unit
        self.PickedUntil = _UtilLogic.ElapsedSeconds + self.PickSeconds
        self:ShowPick(unit, self.PickSeconds, senderUserId)
        log(string.format("[VRF] shadow picked %s for %.0fs", u.ShadowId, self.PickSeconds))
    end

    @ExecSpace("Client")
    method void ShowPick(Entity unit, number seconds)
        -- 고른 그림자 표시 (내 화면): 발밑에 금빛 도는 입자 + 이름 위 「선택」 + 소환수 띠 카드 강조(CompanionHUD가 PickedLocal을 본다)
        if self.Entity ~= _UserService.LocalPlayer then return end
        if self.PickMarker ~= 0 then _ParticleService:RemoveParticle(self.PickMarker) self.PickMarker = 0 end
        self.PickedLocal = unit
        self.PickedLocalUntil = isvalid(unit) and (_UtilLogic.ElapsedSeconds + seconds) or 0
        if not isvalid(unit) then return end
        local anchor = _MotionSmoother:VisOf(unit)
        self.PickMarker = _ParticleService:PlayBasicParticleAttached(BasicParticleType.SpinField, anchor, Vector3(0, 0.05, 0), 0, Vector3(0.55, 0.2, 1), true, { Color = Color(1, 0.85, 0.4, 0.85), ParticleCount = 10 })
        local serial = self.PickMarker
        _TimerService:SetTimerOnce(function()
            if self.PickMarker == serial and serial ~= 0 then
                _ParticleService:RemoveParticle(serial)
                self.PickMarker = 0
                self.PickedLocal = nil
            end
        end, seconds)
        _HudMain:ExtractPop(_Util:Pos2(unit) + Vector2(0, 0.9), "선택", Color(1, 0.86, 0.45, 1))
    end

    @ExecSpace("Server")
    method void RequestFocus(Entity target)
        -- 「저 적을」 (C 길게 · 모바일 명령판 「집중」): 집결과 같은 스킬 「집결」 — 같은 마나·재사용을 쓴다. 고른 적이 없거나 멀면 이유만 알린다
        local uid = self.Entity.PlayerComponent.UserId
        if senderUserId ~= uid then return end
        if self:GetSkillLevel("rally") <= 0 then
            -- 새 글귀(승인 전 · 44-3 D): 10-29 말투 규칙(-습니다). 짧게 누른 집결의 옛 안내(RequestRally)는 「-다」 63줄 정리 때 함께
            _Util:Warn("집중은 스킬 「집결」(Lv" .. tostring(_SkillData:Get("rally").row) .. ")을 배워야 쓸 수 있습니다", uid)
            return
        end
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if book == nil or stats == nil or not _Util:IsAlive(self.Entity) or _GameConst:IsTown(self.Entity.CurrentMap) then return end
        if _UtilLogic.ElapsedSeconds < (book.ReadyAt["rally"] or 0) then return end
        local lv = book:GetPowerLevel("rally")
        local cost = book:GetManaCost("rally", lv)
        if stats.Mana < cost then
            _Util:Warn("마나 부족", uid)
            return
        end
        local ok = isvalid(target) and target.CurrentMap == self.Entity.CurrentMap and _Util:Distance(self.Entity, target) <= 9
        ---@type Monster
        local m = ok and target:GetComponent("script.Monster") or nil
        if m == nil or m.IsDead or m.Hp <= 0 then
            _Util:Warn("집중할 적을 먼저 골라주세요", uid)
            return
        end
        local n = self:FocusAll(target, self.FocusSeconds)
        if n <= 0 then
            _Util:Warn("따를 소환수가 없습니다", uid)
            return
        end
        stats:SpendMana(cost)
        book:SetCooldown("rally", book:SkillCooldown("rally", lv) * stats:GetCastCooldownMult())
        self:ShowFocus(target, self.FocusSeconds, uid)
        log(string.format("[VRF] focus target=%s units=%d sec=%.1f", target.Name, n, self.FocusSeconds))
    end

    @ExecSpace("Client")
    method void ShowFocus(Entity target, number seconds)
        -- 집중 대상 표시 (내 화면): 머리 위 붉은 도는 입자 seconds 동안 + 「집중」 글자
        if self.Entity ~= _UserService.LocalPlayer or not isvalid(target) then return end
        if self.FocusMarker ~= 0 then _ParticleService:RemoveParticle(self.FocusMarker) self.FocusMarker = 0 end
        local anchor = _MotionSmoother:VisOf(target)
        self.FocusMarker = _ParticleService:PlayBasicParticleAttached(BasicParticleType.SpinField, anchor, Vector3(0, 1.1, 0), 0, Vector3(self.FocusMarkW, self.FocusMarkH, 1), true, { Color = Color(1, 0.35, 0.3, 0.9), ParticleCount = 8 })
        local serial = self.FocusMarker
        _TimerService:SetTimerOnce(function()
            if self.FocusMarker == serial and serial ~= 0 then
                _ParticleService:RemoveParticle(serial)
                self.FocusMarker = 0
            end
        end, seconds)
        _HudMain:ExtractPop(_Util:Pos2(target) + Vector2(0, 1.2), "집중", Color(1, 0.55, 0.45, 1))
        _SoundDirector:PlaySkillCue("rally")
    end

    @ExecSpace("ClientOnly")
    method Entity FocusCandidate()
        -- 「저 적을」 대상 (내 클라이언트 · 수동 조준): 고른 적 → PC 마우스 모드는 커서 근처(1.5칸) 적 → 모바일·키보드는 스킬 조준점(SkillBook.GetAimPoint) 근처 적
        ---@type PlayerAttack
        local attack = self.Entity:GetComponent("script.PlayerAttack")
        ---@type ClickControl
        local click = self.Entity:GetComponent("script.ClickControl")
        if attack ~= nil and click ~= nil and attack:IsLiveMonster(click.AttackTarget) then return click.AttackTarget end
        if attack ~= nil and attack:IsLiveMonster(attack.SelectedTarget) then return attack.SelectedTarget end
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return nil end
        local m = _Util:NearestMonster(self.Entity.CurrentMap, book:GetAimPoint("rally"), 1.5)
        return m ~= nil and m.Entity or nil
    end

    @ExecSpace("ClientOnly")
    method void TryFocus()
        -- 「저 적을」 요청 (C 길게 누름 문턱 · 모바일 「집중」 단추)
        if not _UIKit:CanUseGameplayInput() then return end
        local target = self:FocusCandidate()
        if target == nil then
            _HudMain:ShowWarn("집중할 적을 먼저 골라주세요")
            return
        end
        self:RequestFocus(target)
        if not Environment:IsPublishedPlay() then log("[VRF] focus request " .. target.Name) end
    end

    @ExecSpace("ServerOnly")
    method string DeployBlockReason()
        -- 그림자 소환이 안 될 때 이유 (DeployNext가 0일 때)
        local owner = self:Owner()
        local stored = 0
        local waiting = 0
        local now = _UtilLogic.ServerElapsedSeconds
        if owner ~= nil then
            for _, s in pairs(owner.Storage) do
                if not s.deployed then
                    stored = stored + 1
                    if now < s.respawnReadyAt or self:IsExhausted(s) then waiting = waiting + 1 end
                end
            end
        end
        if self.DeployedCount >= self:GetDeployLimit() then return "그림자 소환 한도 " .. tostring(self:GetDeployLimit()) .. "기에 도달했습니다" end
        -- 소환 지정이 있으면 지정한 그림자만 부른다
        if owner ~= nil and #owner:AssignedList() > 0 then
            local recovering = 0
            local idle = 0
            for _, id in ipairs(owner:AssignedList()) do
                local s = owner:GetShadow(id)
                if s ~= nil and not s.deployed then
                    if now < s.respawnReadyAt or self:IsExhausted(s) then recovering = recovering + 1 else idle = idle + 1 end
                end
            end
            if recovering > 0 and idle == 0 then return "지정한 그림자가 아직 회복 중입니다 (지친 정예·보스는 마을에 들러야 합니다)" end
            if idle == 0 then return "지정한 그림자가 모두 소환 중입니다 — 보관함(H)에서 소환 지정을 바꿀 수 있습니다" end
        end
        if stored == 0 then return "부를 그림자가 없습니다 — 혼을 추출해 그림자를 모으세요" end
        if waiting == stored then return "그림자가 아직 회복 중입니다" end
        return "지금은 그림자를 부를 수 없습니다"
    end

    @ExecSpace("ServerOnly")
    method table GetUnits()
        -- 소환 중인 그림자 컴포넌트 목록 (정예 승격·혼 흡수 등 스킬용)
        local list = {}
        for _, unit in pairs(self.Units) do
            if isvalid(unit) then
                ---@type ShadowUnit
                local comp = unit:GetComponent("script.ShadowUnit")
                if comp ~= nil then table.insert(list, comp) end
            end
        end
        return list
    end

    -- ───────── 클라이언트 요청 ─────────

    @ExecSpace("Server")
    method void RequestDeploy(string id)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:GetSkillLevel("shadow_summon") <= 0 then
            _Util:Warn("그림자 소환은 스킬 「그림자 소환」(Lv" .. tostring(_SkillData:Get("shadow_summon").row) .. ")을 배워야 합니다", senderUserId)
            return
        end
        -- 명령 버튼·보관함에서 부르는 것도 스킬 시전과 같은 마나를 쓴다 (10-13 사용자 결정: 그림자 소환 한 마리 10 — 예전엔 0)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local cost = book ~= nil and book:GetManaCost("shadow_summon", self:GetSkillLevel("shadow_summon")) or 0
        if stats ~= nil and stats.Mana < cost then
            _Util:Warn("마나 부족", senderUserId)
            return
        end
        local ok = false
        if id == "" then ok = self:DeployNext() > 0 else ok = self:Deploy(id) end
        if ok and stats ~= nil and cost > 0 then stats:SpendMana(cost) end
    end

    @ExecSpace("Server")
    method void RequestRecall(string id)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if id == "" then self:RecallAll() else self:Recall(id) end
    end

    @ExecSpace("Server")
    method void RequestRally()
        -- 집결은 스킬 「집결」을 배워야 쓴다 (C 키·모바일 버튼). 마나·쿨다운은 스킬 시전 규칙을 따른다
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        if self:GetSkillLevel("rally") <= 0 then
            _Util:Warn("집결은 스킬 「집결」(Lv" .. tostring(_SkillData:Get("rally").row) .. ")을 배워야 합니다", senderUserId)
            return
        end
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book ~= nil then book:Cast("rally", _Util:Pos2(self.Entity)) end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        if event.key == KeyboardKey.Z then self:RequestDeploy("")
        elseif event.key == KeyboardKey.X then self:RequestRecall("")
        elseif event.key == KeyboardKey.C then self:BeginRallyKey() end
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyUpEvent(KeyUpEvent event)
        -- C를 문턱(FocusHoldSeconds) 전에 떼면 집결 (예전과 같다). 문턱을 넘겨 이미 「집중」을 보냈으면 아무것도 안 한다
        if self.Entity ~= _UserService.LocalPlayer or event.key ~= KeyboardKey.C or self.RallyKeyAt < 0 then return end
        self.RallyKeyAt = -1
        if self.RallyKeyTimer ~= 0 then
            _TimerService:ClearTimer(self.RallyKeyTimer)
            self.RallyKeyTimer = 0
            if _UIKit:CanUseGameplayInput() then self:RequestRally() end
        end
    end

    @ExecSpace("ClientOnly")
    method void BeginRallyKey()
        -- C 누름 (44-3 D): 짧게 = 집결 · FocusHoldSeconds 넘게 = 고른 적에게 모두 집중 (문턱에 닿는 순간 보낸다 — 손을 떼기 전에 반응)
        if self.RallyKeyAt >= 0 then return end   -- 키 반복 입력은 무시
        self.RallyKeyAt = _UtilLogic.ElapsedSeconds
        if self.RallyKeyTimer ~= 0 then _TimerService:ClearTimer(self.RallyKeyTimer) end
        self.RallyKeyTimer = _TimerService:SetTimerOnce(function()
            self.RallyKeyTimer = 0
            if self.RallyKeyAt < 0 then return end
            self:TryFocus()
        end, self.FocusHoldSeconds)
    end

end
