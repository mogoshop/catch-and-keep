-- 소환된 그림자 한 마리. 탑다운(RectTile) 맵에서 8방향으로 움직인다.
-- 가까운 몬스터를 추적·공격하고, 적이 없으면 주인 주변의 자기 자리(대형)로 돌아간다.
-- 원본 몬스터 스프라이트를 어둡게 칠해서 쓴다. AIChase 없이 스크립트로 직접 움직인다.
-- ⚠ 따라가기·대형·동기화 값을 바꾸기 전에 docs/motion-sync.md 「하지 말 것」을 본다 (npm test 「움직임 불변식」이 확인)
@Component
script ShadowUnit extends AttackComponent

    property boolean HaltSent = false      -- 멈춤(MoveToDirection 0)을 이미 보냈다
    @Sync
    property Entity OwnerPlayer = nil
    @Sync
    property string Kind = "shadow"          -- shadow(보관함 그림자) / skeleton / mage / revive (UndeadSystem)
    property string ShadowId = ""
    property integer Atk = 10
    @Sync
    property string StandRUID = ""
    @Sync
    property string MoveRUID = ""            -- 클라이언트 MotionSmoother가 화면 움직임에 맞춰 서기/걷기 그림을 고를 때 쓴다
    property string AttackRUID = ""
    property number AttackAnimationUntil = 0
    property number AttackWindup = 0.18
    property number AttackAnimationSeconds = 0.45
    property Entity OnlyTarget = nil
    property integer ShotCount = 0
    property Vector2 LastMovePos = Vector2(0, 0)
    property boolean Moving = false
    property number StuckSeconds = 0
    property number SidestepUntil = 0
    property integer SidestepSide = 1
    @Sync
    property Vector2 FormationOffset = Vector2(0, -0.8)   -- 동기화: 내 클라이언트가 따라가기를 직접 그릴 때 같은 자리를 계산한다 (MotionSmoother)
    @Sync
    property integer FormationIndex = 0
    property Vector2 OwnerLastPos = Vector2(0, 0)
    @Sync
    property Vector2 OwnerFacing = Vector2(1, 0)   -- 동기화: 클라이언트 따라가기 그리기가 같은 대형 방향을 쓴다 (8° 넘게 바뀔 때만 쓴다)
    property integer AttackEpoch = 0
    property integer StrikeTimer = 0
    property integer StrikeCount = 0
    property number BackpedalUntil = 0
    property number NextBackpedalAt = 0

    property number AttackRange = 0.8
    property number AttackRadius = 0.6
    property number AttackCooldown = 1.0
    property number DetectRange = 5
    property number OwnerGuardRange = 5.5  -- 자동 교전은 주인 근처에서만 시작한다 (10-10 3차 QA: 디아2처럼 근처 적을 각자 잡으러 가게 3.5 → 5.5)
    property number OwnerCombatRange = 7   -- 선택한 적·현재 교전에는 여유를 두되 다음 무리까지 쫓지 않는다 (4.5 → 7)
    property number ArriveDistance = 0.25
    property number FollowStart = 0.6         -- 대형 자리에서 이만큼 벗어나면 출발 (10-10 QA: 0.25에서 섰다 갔다를 반복해 끊겨 보였다)
    property number FollowStop = 0.2          -- 따라가는 중에는 이만큼 붙어야 멈춘다
    @Sync
    property number BaseSpeed = 0             -- 원본 이동 속도 (ShadowCommander/UndeadSystem이 정한다). 클라이언트 따라가기 그리기도 쓴다
    property number SpeedMult = 1             -- 따라잡기 배율 (바뀔 때만 InputSpeed를 쓴다)
    property Vector2 OwnerVelPos = Vector2(0, 0)
    property number OwnerVelAt = 0
    property number OwnerVel = 0              -- 주인의 실제 이동 속도(칸/초). 서버의 주인 InputSpeed는 클라이언트 배율이 빠진 값이라 재서 쓴다
    property Vector2 OwnerVelDir = Vector2(0, 0) -- 주인의 마지막 이동 방향
    property Vector2 Heading = Vector2(0, 0)  -- 지금 걷는 방향 (서서히 튼다)
    property number TurnRate = 7              -- 초당 최대 회전(라디안, 약 400°). 90° 꺾기 ≈ 0.22초
    property number LastDelta = 0.02
    property number TickAcc = 0               -- 판단 주기 누적 시간
    property number TickInterval = 0.0667     -- 판단은 초당 15번 (이동은 그 사이에도 MovementComponent가 이어 간다). 10-13: 20 → 15 (3인 파티 서버 부담)
    property number RegenAcc = 0              -- 체력 재생 누적 시간 (1초마다 적용)
    property number LastHurtAt = 0            -- 마지막으로 맞은 시각 (쉬는 중 빠른 재생 판단)
    property Vector2 OwnerVelVec = Vector2(0, 0) -- 주인 속도 벡터 (평활)
    property Vector2 OwnerSmooth = Vector2(0, 0) -- 이 소환수가 따라가는 주인 위치: 서버가 보는 주인 위치(초당 약 10번 바뀜)를 예측·평활한 값
    property boolean OwnerSmoothReady = false
    property number FollowLag = 8             -- 주인 위치를 따라잡는 빠르기(1/초). 소환수마다 달라 같은 박자로 움직이지 않는다
    property number SpeedJitter = 1           -- 소환수마다 걸음 빠르기를 조금씩 다르게
    property number WorldPerInput = 0.836     -- RectTile 맵에서 InputSpeed 1 = 초당 0.836칸 (메이커 실측)
    property number PaceMax = 2.2             -- 주인을 따라 앞자리로 나갈 때 걸음 배율 상한
    @Sync
    property Vector2 Wander = Vector2(0, 0)   -- 대형 자리의 개인 흔들림 (디아2 하수인처럼 칼같이 줄 서지 않게). 2.5~4.5초마다 바뀌어 동기화 부담이 작다
    property number WanderAt = 0
    property boolean Personal = false         -- 개인 성향(반응·걸음·흔들림)을 정했는지
    property number LeashDistance = 9
    property number RetargetInterval = 0.4  -- 매 프레임 탐색하지 않는다 (설계 7장)
    property Color ShadowTint = Color(0.35, 0.2, 0.55, 0.85)

    property string Element = ""             -- 원본 몬스터의 공격 속성 (ElementRatio만큼이 그 속성)
    property number ElementRatio = 0
    property table Resists = {}              -- 원본 몬스터의 저항 { fire = 50 }
    property number BonusResist = 0          -- 호령 오라로 모든 저항 +
    @Sync
    property string Variant = ""             -- 원본 변종 능력 코드 (오오라 수치·기술 — GameData.ParseVariant) — 클라이언트가 소환수 띠·버프 줄에 오오라를 표시한다
    property string Arch = ""                -- 원본 몬스터 유형 (archetypes.csv shadow 칸의 특기). 보관함 그림자만
    property boolean ArchReady = false
    property integer CritCount = 0           -- 암살자 치명타 · 무리 회피 · 거구 경직 횟수 (검증용)
    property integer DodgeCount = 0
    property number AuraRingAt = 0          -- 클라이언트: 광기 마법사 오오라 범위 고리를 다시 그릴 시각 (44 §4-1 B)
    property number TraitPopAt = 0          -- 서버: 유형 특기 발동 글자를 다시 띄울 수 있는 시각 (1초에 한 번)
    property number TraitShownAt = 0        -- 클라이언트: 지금 띄운 특기 글자의 시각 (늦게 끝난 타이머가 새 글자를 지우지 않게)
    property integer StunCount = 0
    property number AbilityTimer = 2
    property number AuraTimer = 0            -- 오오라 다음 전파까지 (기술 AbilityTimer와 따로)
    property number RadiusMult = 1           -- 해골 변이 대검: 근접 범위 배율
    property number BasicMult = 1            -- 해골 변이 대검: 평타 피해 배율
    property number GuardPct = 0             -- 해골 변이 방패: 받는 피해 -%
    property boolean Taunt = false           -- 해골 변이 방패: 4초마다 주변 적 도발
    property integer BoltCount = 1           -- 해골 마법사 변이 쌍발: 화살 수
    property number BoltMult = 1             -- 마법사 화살 피해 배율 (쌍발 ×0.65~0.85 · 관통 ×0.85)
    property number BoneArrowScale = 0.392   -- 원거리 그림자·되살림의 중립 뼈 화살(GameConst.FxSkillBoneArrow) 배율 — 11-01 통일 공정 골편 3종 256×128 판 · 보이는 몸 알파>16 최대 235px: 보이는 길이 = 예전 128×64 판 94px × 0.7 = 0.658칸의 1.4배 = 0.921칸 → 92.1/235 (옛 0.7 · 비면 몬스터 화살 SpriteArrow 1.2)
    property integer BoltPierce = 0          -- 관통: 화살이 꿰뚫는 적 수 (0 = 첫 적에서 멈춤)
    property number HexPct = 0               -- 저주: 맞은 적 4초 받는 피해 +%
    property number BlastMult = 0            -- 마법사 거인 평타: 맞은 자리 반경 BlastRadius 다른 적에게 × 이 값 (rite_giants.csv blastMul · 48부터 일반 마법사 폭발 변이는 없다)
    property string MageSchool = ""          -- 해골 마법사 속성 (48 §2-2: fire 저주 불꽃 · cold 서리 혼 · bone 뼈 창 · soul 영혼 격류 · curse 저주 — MageBolts) · "" = 옛 기록이면 Element로 읽는다
    property integer MageRank = 0            -- 일으킬 때의 해골 마법사 랭크 (속성 특성 구간 §2-3 · 0 = 1로 본다)
    property number ShotMul = 1              -- 지금 맞히는 마법사 투사체 한 발 배율 (HitBolt가 AttackFast 동안만 둔다 · CalcDamage)
    property Entity BlastSkip = nil          -- 폭발이 처음 맞은 적은 다시 때리지 않는다
    property number TauntTimer = 1
    property string LastInfo = ""
    property table AuraVals = {}             -- 받은 오오라 효과 → 효과량 (아군 소환수의 변종 오오라 · 파티원의 호령, 주인 상관없이 섞인다 · 같은 효과는 가장 센 것 · corrode는 적 몬스터가 거는 약화)
    property number AuraUntil = 0
    property number AuraRegenAt = 0

    @Sync
    property number MaxHp = 30
    @Sync
    property number Hp = 30
    property boolean Dead = false
    @Sync
    property boolean Promoted = false
    property number PromotionMultiplier = 1

    @ExecSpace("ServerOnly")
    method void Promote(number multiplier)
        -- 같은 개체에 중복 적용하지 않고 시전 당시 스킬 배율을 보관한다.
        if self.Promoted or self.Dead or self.Hp <= 0 then return end
        self.PromotionMultiplier = math.max(1, multiplier)
        self.Promoted = true
        self.Atk = math.floor(self.Atk * self.PromotionMultiplier)
        self.MaxHp = self.MaxHp * self.PromotionMultiplier
        self.Hp = self.Hp * self.PromotionMultiplier
        local t = self.Entity.TransformComponent
        t.Scale = Vector3(t.Scale.x * 1.25, t.Scale.y * 1.25, 1)
        self.ShadowTint = Color(0.9, 0.7, 0.3, 0.9)
        self.Entity.SpriteRendererComponent.Color = self.ShadowTint
        self.RingPainted = false
        log("[ShadowUnit] 정예 승격 " .. self.ShadowId .. " ATK " .. tostring(self.Atk))
    end

    -- 해골 폭탄 (10-20): 붉게 깜빡이며 돌진해 터진다
    property boolean Bombing = false
    property Entity BombTarget = nil
    property Vector2 BombPoint = Vector2(0, 0)
    property number BombDamage = 0
    property number BombRadius = 1.6
    property number BombUntil = 0
    property integer FlashTimer = 0           -- 클라이언트: 붉은 깜빡임
    -- 뼈 의식 5기 「뼈 거인」 (10-29 기획서 43): 해골 다섯이 합쳐진 몸 (UndeadSystem.StartGiant · EndGiant)
    property boolean Giant = false
    property table GiantBase = {}             -- 거인이 되기 전 값 (능력치는 갈라질 때, 외형 기준은 그림 복구까지 보존)
    property table GiantLook = {}             -- 거인 3종 그림 (UndeadSystem.GiantLook · 동작 → 첫 칸/타격 칸 RUID와 길이). 비면 지금 그림(변이 그림 × riteGiantScale) — 10-30 갈래 E
    property number GiantClipUntil = 0        -- 거인 한 번 동작(기술·피격·갈라짐) 그림이 끝나는 시각: 그동안 서기·걷기·공격 그림으로 덮지 않는다 (그림만 · 판정·시간 무관)
    property integer GiantLookToken = 0       -- 갈라짐 그림 뒤 원래 그림으로 돌리는 타이머의 차례 (그 사이 다시 거인이 되면 옛 타이머는 무시)
    @Sync
    property string GiantKind = ""            -- 46-3 거인 종류 (basic·shield·greatsword·twin·mage · "" = 거인 아님) — rite_giants.csv 줄 · RiteGiantMoves 스킬
    property number TauntEvery = 4            -- 도발 간격(초) · 방패 해골 4 · 거인은 rite_giants.csv tauntSec (46-3)
    property number TauntRadius = 2.5         -- 도발 반경(칸) · 방패 해골 2.5 · 거인은 tauntRadius
    property number BlastRadius = 1.3         -- 폭발 마법사 자리 반경 1.3 · 마법사 거인은 rite_giants.csv radius(1.0)
    property number GiantGuardUntil = 0       -- 46-4 쌍칼 거인 「돌진」: 이 시각까지 받는 피해 0 (RiteGiantMoves · opts iframe 0.3초)
    property number GiantCastUntil = 0        -- 48 거인 영창·꽂기: 이 시각까지 제자리 (기도 메테오 영창 1초 · 노바 0.3초 · 땅 가르기 0.3초+솟음 — RiteGiantMoves.Hold)
    property number GiantSlowUntil = 0        -- 48 대검 거인 회전 베기: 이 시각까지 따라가는 이동 ×0.6
    property number GiantHitAt = -99          -- 48-6 ② 거인 맞음 그림을 마지막으로 건 때 (0.5초에 한 번까지)
    property string GiantClipState = ""       -- s48v2-A 지금 도는 거인 한 번 동작 이름 (GiantPlay · 함성 몸이 맞음 그림만 덮고 기술·갈라짐은 덮지 않게)
    @Sync
    property number GiantHoldUntil = 0        -- 48-6 ③ 거인 기술 동작을 이 서버 시각(ServerElapsedSeconds)까지 반복 — 클라이언트 MotionSmoother.FrameClip이 되돌려 감 (0 = 한 번)
    -- 뼈 성찬 (10-20): 받는 피해 -20% · 「피의 고양」 공격 속도
    property number OfferUntil = 0
    property number FrenzyUntil = 0
    property number FrenzyPct = 0
    property number RushCheckAt = 0           -- 주인의 질주 강화 「군단 질주」 확인 시각 (1초마다)
    property boolean RushLeash = false        -- 군단 질주: 6칸 넘게 떨어지면 곁으로 순간이동
    property number BoundUntil = 0            -- 간수장 「가두기」(docs/design/40): 이 시각까지 제자리에 묶인다 (공격·이동 안 함)
    property number LeapUntil = 0             -- 군단 질주: 주인이 막 질주했다 — 이 시각까지는 3칸만 떨어져도 곁으로 도약 (SkillEffects.WraithDash)

    property Entity Target = nil
    property Entity FocusTarget = nil         -- 「저 적을」 대상 (주인이 C 길게 · 모바일 「집중」 — 44-3 D)
    property number FocusUntil = 0            -- 이 시각까지 FocusTarget을 먼저 친다
    property number FocusExtraRange = 2       -- 집중 대상은 주인 교전 범위(7)보다 이만큼 더 멀리까지 쫓는다 (끈 거리 LeashDistance 9 안)
    property boolean RingPainted = false
    property number PartyAuraTimer = 0
    property number PartyAuraRange = 6        -- 다른 플레이어의 호령이 닿는 거리
    property integer ViewTimer = 0            -- 클라이언트: 내 것/남의 것 표시 갱신
    property integer HpBarTimer = 0           -- 클라이언트: 발밑 체력 막대 갱신
    property boolean HpBarReady = false
    property integer HpBarFill = -1
    property number HpBarScale = 2.7          -- 논리 픽셀 22×4 (테두리 포함) → 약 0.75×0.14칸
    property number HpBarHeadY = 0            -- 머리 위 높이 (원본 그림 높이, 배율 전 칸)
    property any HpBarAlt = nil               -- 클라이언트: MotionSmoother의 그림 대역에 붙은 체력 막대 (있으면 모델 자식 HpBar 대신 여기에 그린다)
    property any TagAlt = nil                  -- 클라이언트: 그림 대역(MSVis)의 이름표. 있으면 루트 이름표 대신 여기에 쓴다
    property string ViewState = ""
    property number RetargetTimer = 0
    property number OwnerCheckTimer = 0
    property number OwnerCheckInterval = 0.2  -- 주인 교전 범위·시야 재확인 간격
    property number AttackTimer = 0
    property number RallyTimer = 0
    property string CurrentClip = ""
    property boolean ViewCombat = false        -- 클라이언트 전용: 교전 중(맞았거나 공격·추격 중) — 발밑 원을 숨기고 몸 톤을 낮춘다 (MotionSmoother.PlaceVis · 10-28 F5 B-1)
    property number ViewHitAt = -99             -- 클라이언트 전용: 마지막으로 생명이 줄어든 때
    property number ViewFightAt = -99           -- 클라이언트 전용: 마지막으로 공격·추격 상태를 본 때
    property number ViewLastHp = -1
    property number MageBurstFrameSec = 0.09    -- 불꽃 마법사 폭발(S07 · fx-hex-burst 6장) 장 간격 (10-31 갈래 E · 캐릭터 저주 불꽃 폭발과 같은 0.54초)
    property number MageBurstHoldSec = 0.2      -- 폭발 마지막 장 추가 유지
    property number MageBurstFadeSec = 0.2
    property number BlastPopScale = 0.9         -- 폭발 마법사 파열(S08) 크기 (예전 0.7)
    @Sync
    property string CommandState = "follow"

    @ExecSpace("ServerOnly")
    method void PaintRing()
        -- 발밑 아군 표시(모델 자식 AllyRing): 그림자 보라 · 언데드 청록 · 정예 금빛. 필드 몬스터와 한눈에 구분
        self.RingPainted = true
        local ring = self.Entity:GetChildByName("AllyRing")
        if not isvalid(ring) then return end
        ring.SpriteRendererComponent.Color = self:RingColor()
        -- 몸 크기(작은 해골 0.55 등)와 상관없이 발밑 원은 같은 크기로 보이게 (10-28 F5 #11-A: 1.05 → 0.7칸 · 반투명 — 아군 표시가 적보다 많아 붉은색을 적 식별에 못 썼다)
        local ps = math.max(0.3, math.abs(self.Entity.TransformComponent.Scale.y))
        ring.TransformComponent.Scale = Vector3(0.7 / ps, 0.7 / ps, 1)
    end

    method Color RingColor()
        -- 발밑 원 색: 언데드 청록 · 그림자 보라 · 정예 금빛 (알파 0.6)
        local color = Color(0.3, 1, 0.8, 0.6)
        if self.Kind == "shadow" then color = Color(0.75, 0.5, 1, 0.6) end
        if self.Promoted then color = Color(1, 0.8, 0.3, 0.6) end
        return color
    end

    @ExecSpace("ClientOnly")
    method void StartView()
        -- 클라이언트: 주인이 동기화되면 내 소환수는 그대로(야영지에서만 「내 소환수」), 팀원 소환수는 흐린 회색 고리 + 작은 주인 이름
        self.ViewTimer = _TimerService:SetTimerRepeat(function()
            self:RefreshView()
            self:AuraRangeTick()
        end, 0.5)
        self.HpBarTimer = _TimerService:SetTimerRepeat(function() self:UpdateHpBar() end, 0.15)
    end

    @ExecSpace("ClientOnly")
    method void UpdateHpBar()
        -- 머리 위 체력 막대 (모델 자식 HpBar의 PixelRenderer 22×4: 어두운 테두리 + HUD 체력 구슬과 같은 짙은 빨강 한 가지, 빈 칸은 검붉게).
        -- 발밑에 두니 이름표(야영지 「내 소환수」 · 파티원 이름)와 겹쳤다 (10-10 2차 QA). 몸 크기·좌우 반전과 상관없이 같은 크기로 그린다
        if not isvalid(self.Entity) then return end
        local bar = self:BarEntity()
        if not isvalid(bar) then return end
        local pixel = bar.PixelRendererComponent
        if not isvalid(pixel) then return end
        if not self.HpBarReady then
            pixel:ResetWithColor(22, 4, Color(0.04, 0.03, 0.05, 0.9))
            pixel.SortingLayer = "MapLayer0"
            pixel.OrderInLayer = 6
            self.HpBarReady = true
            self.HpBarFill = -1
            -- 원본 그림 높이(px)로 머리 위치를 잡는다 (그림자 = 원본 몬스터, 해골·마법사는 기본 0.95칸)
            local src = string.match(self.Entity.Name, "^Shadow_(.+)$")
            local stats = src ~= nil and _GameData:GetMonsterStats(src) or nil
            -- 몸 키(bh)가 있으면 그것으로 (메이플식 프레임은 캔버스가 몸보다 크다)
            local headPx = stats ~= nil and ((stats.bh ~= nil and stats.bh > 0) and stats.bh or stats.h) or nil
            self.HpBarHeadY = (headPx ~= nil and headPx > 0) and headPx / 100 or 0.95
        end
        -- 부모(본체 또는 그림 대역)의 크기·좌우를 되돌려 늘 같은 크기·방향으로
        local parent = bar.Parent
        local ps = isvalid(parent) and parent.TransformComponent.Scale or self.Entity.TransformComponent.Scale
        local sx, sy = math.max(0.05, math.abs(ps.x)), math.max(0.05, math.abs(ps.y))
        local flip = ps.x < 0 and -1 or 1
        bar.TransformComponent.Scale = Vector3(self.HpBarScale / sx * flip, self.HpBarScale / sy, 1)
        bar.TransformComponent.Position = Vector3(0, self.HpBarHeadY + 0.12 / sy, 0)
        local ratio = self.MaxHp > 0 and math.max(0, math.min(1, self.Hp / self.MaxHp)) or 0
        -- 10-28 F5 #11-A·B-3: 내 소환수 막대만, 생명 70% 이상이면 숨기고 맞으면 2초 보인다 (남의 소환수는 막대·원 없음)
        local now = _UtilLogic.ElapsedSeconds
        self:TrackCombat(now)
        local me = _UserService.LocalPlayer
        local mine = isvalid(self.OwnerPlayer) and self.OwnerPlayer == me
        local show = mine and self.Hp > 0 and (ratio < 0.7 or now - self.ViewHitAt < 2)
        if pixel.Enable ~= show then pixel.Enable = show end
        local fill = math.max(self.Hp > 0 and 1 or 0, math.floor(ratio * 20 + 0.5))
        if fill == self.HpBarFill then return end
        self.HpBarFill = fill
        -- 10-10 3차 QA는 2단·녹색을 거부해 HUD와 같은 빨강 한 가지였다 → 10-28 #11-A: 붉은색은 적 식별에 쓰도록 소환수 막대는 청록 한 가지
        local hp = Color(0.18, 0.78, 0.72, 1)
        local empty = Color(0.03, 0.13, 0.13, 0.9)
        -- 안쪽 20×2 (x 2~21, y 2~3)
        for x = 2, 21 do
            local c = x - 1 <= fill and hp or empty
            pixel:SetPixel(x, 2, c)
            pixel:SetPixel(x, 3, c)
        end
    end

    @ExecSpace("ClientOnly")
    method void TrackCombat(number now)
        -- 클라이언트가 아는 신호(생명 감소 · 공격 그림)로 교전 여부를 정한다 — 네트워크 0 (10-28 F5 B-1)
        if self.ViewLastHp >= 0 and self.Hp < self.ViewLastHp then self.ViewHitAt = now end
        self.ViewLastHp = self.Hp
        -- AttackRUID는 동기화되지 않아 클라이언트에선 늘 비어 있다 → 서버가 동기화하는 행동 상태(공격·추격)를 쓴다 (10-28 메이커: 싸우는 중에도 원이 남았다)
        if self.CommandState == "attack" or self.CommandState == "combat" then self.ViewFightAt = now end
        self.ViewCombat = now - math.max(self.ViewHitAt, self.ViewFightAt) < 3
        -- 발밑 원: 내 소환수가 교전 중이 아닐 때만 (MotionSmoother 대역 원은 이 색을 따라간다)
        local ring = self.Entity:GetChildByName("AllyRing")
        if isvalid(ring) then
            local me = _UserService.LocalPlayer
            local mine = isvalid(self.OwnerPlayer) and self.OwnerPlayer == me
            local want = self:RingColor()
            if not mine or self.ViewCombat then want = Color(want.r, want.g, want.b, 0) end
            local cur = ring.SpriteRendererComponent.Color
            if cur.r ~= want.r or cur.g ~= want.g or cur.b ~= want.b or cur.a ~= want.a then ring.SpriteRendererComponent.Color = want end
        end
    end

    @ExecSpace("ClientOnly")
    method Entity BarEntity()
        -- 체력 막대를 그릴 곳: 그림 대역의 막대가 있으면 그것, 아니면 모델 자식 HpBar
        if self.HpBarAlt ~= nil and isvalid(self.HpBarAlt) then return self.HpBarAlt end
        return self.Entity:GetChildByName("HpBar")
    end

    @ExecSpace("ClientOnly")
    method void RefreshView()
        local owner = self.OwnerPlayer
        if not isvalid(owner) or not isvalid(owner.PlayerComponent) then return end
        local me = _UserService.LocalPlayer
        local mine = isvalid(me) and owner == me
        -- 야영지(마을)에서는 내 소환수에도 「내 소환수」 이름표 — 따라온 해골을 적으로 착각하지 않게
        local town = false
        if mine and isvalid(self.Entity.CurrentMap) then
            local info = _GameData:GetMapInfo(_GameConst:BaseMapName(self.Entity.CurrentMap.Name))
            town = info ~= nil and info.kind == "town"
        end
        local state = mine and (town and "mine:town" or "mine") or ("other:" .. owner.PlayerComponent.Nickname)
        if state == self.ViewState then return end
        self.ViewState = state
        local tag = self.Entity.NameTagComponent
        if self.TagAlt ~= nil and isvalid(self.TagAlt) then
            -- 이름표는 그림 대역에 (루트 이름표는 서버 위치에 붙어 몸보다 늦게 따라온다 — MotionSmoother.PlaceVis)
            if isvalid(tag) and tag.Enable then tag.Enable = false end
            tag = self.TagAlt
        end
        if isvalid(tag) then
            tag.Name = mine and (town and "내 소환수" or "") or owner.PlayerComponent.Nickname
            tag.FontColor = mine and Color(0.55, 1, 0.85, 1) or Color(0.75, 0.75, 0.78, 1)
            tag.Enable = not mine or town
        end
    end

    @ExecSpace("ClientOnly")
    method void AuraRangeTick()
        -- 광기 마법사 오오라 범위 (44 §4-1 B: 반경 3이 안 보였다): 내 해골 마법사의 오오라 반경을 3초마다 바닥 고리로 한 번 (오오라 색)
        if self.Kind ~= "mage" or self.Variant == "" or self.Hp <= 0 or not isvalid(self.Entity) then return end
        local me = _UserService.LocalPlayer
        if not isvalid(me) or self.OwnerPlayer ~= me or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.AuraRingAt then return end
        local aura = _GameData:GetVariantOf(self.Variant, "aura")
        if aura == nil then return end
        if self.AuraRingAt == 0 then log(string.format("[VRF] mage aura ring r=%.1f %s", aura.radius, self.Entity.Name)) end
        self.AuraRingAt = now + 3
        local p = self.Entity.TransformComponent.WorldPosition
        local c = _GameConst:AuraColor(aura.effect)
        _ParticleService:PlayBasicParticle(BasicParticleType.Aura, self.Entity, p, 0, Vector3(aura.radius, aura.radius, 1), false, { Color = Color(c.r, c.g, c.b, 0.55) })
    end

    @ExecSpace("ServerOnly")
    method void TraitPopLimited(string kind)
        -- 유형 특기 발동 글자는 그림자마다 1초에 한 번만 (연타·떼 싸움에서 머리 위가 깜빡이지 않게)
        local now = _UtilLogic.ElapsedSeconds
        if now < self.TraitPopAt then return end
        self.TraitPopAt = now + 1
        log("[VRF] trait pop " .. kind .. " " .. self.Entity.Name)
        self:TraitPop(kind)
    end

    @ExecSpace("Multicast")
    method void TraitPop(string kind)
        -- 그림자 유형 특기 발동 (44 §4-1 B: 암살자 치명 · 무리 회피 · 거구 경직이 보이지 않았다): 주인 화면에만 머리 위 작은 글자 0.8초
        --   (내 소환수는 평소 이름표를 숨기므로 그 자리를 잠깐 빌리고, 끝나면 RefreshView가 원래대로 되돌린다)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or self.OwnerPlayer ~= me or not isvalid(self.Entity) then return end
        local tag = self.Entity.NameTagComponent
        if self.TagAlt ~= nil and isvalid(self.TagAlt) then tag = self.TagAlt end
        if not isvalid(tag) then return end
        local texts = { crit = "치명", dodge = "회피", stun = "경직" }
        local colors = { crit = Color(1, 0.55, 0.3, 1), dodge = Color(0.7, 0.9, 1, 1), stun = Color(1, 0.88, 0.45, 1) }
        tag.Name = texts[kind] or kind
        tag.FontColor = colors[kind] or Color(1, 1, 1, 1)
        tag.Enable = true
        local shownAt = _UtilLogic.ElapsedSeconds
        self.TraitShownAt = shownAt
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or self.TraitShownAt ~= shownAt then return end
            self.ViewState = ""
            self:RefreshView()
        end, 0.8)
    end

    @ExecSpace("ServerOnly")
    method void PartyAuraTick(number delta)
        -- 버프는 섞인다: 근처 다른 플레이어의 호령(소환수 공격 %·이동 속도)이 내 주인과 상관없이 이 소환수에도 닿는다
        self.PartyAuraTimer = self.PartyAuraTimer - delta
        if self.PartyAuraTimer > 0 then return end
        self.PartyAuraTimer = _GameData.auraTickSec
        local me = _Util:Pos2(self.Entity)
        for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, me, self.PartyAuraRange)) do
            if p ~= self.OwnerPlayer then
                ---@type SkillBook
                local book = p:GetComponent("script.SkillBook")
                if book ~= nil then
                    local aura = book:GetCommandAura()
                    if aura.atk > 0 then self:ReceiveAura("dmg", aura.atk) end
                    if aura.speed > 0 then self:ReceiveAura("move", aura.speed) end   -- 호령 이동 % = 기동
                end
            end
        end
    end

    method void OnBeginPlay()
        -- 클라이언트는 내 것/남의 것 표시만, 서버는 아래 설정
        if self:IsClient() then
            self:StartView()
            return
        end
        -- 소환수 피해는 작고 빠르게 표시해 내 타격과 적의 행동을 가리지 않는다.
        local skin = self.Entity.DamageSkinSettingComponent
        if not isvalid(skin) then skin = self.Entity:AddComponent("DamageSkinSettingComponent") end
        if isvalid(skin) then
            skin.DamageSkinScale = Vector2(0.52, 0.52)
            skin.PlayRate = 1.9
            -- 10-28 F5 #13-A: 자동 숫자는 투명하게 — 몬스터가 0.4초 모아 숫자 하나로 띄운다 (Monster.QueueSummonDamage).
            -- 메이커 확인: GetDisplayHitCount 0으로는 자동 숫자가 꺼지지 않아 「76 76」 두 개가 겹쳐 보였다
            skin.Alpha = 0
            skin.DelayPerAttack = 0.025
            skin.TweenType = DamageSkinTweenType.Volcano
        end
        -- 그림자 색으로 칠한다
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.Color = self.ShadowTint end
    end

    @ExecSpace("ServerOnly")
    method void Setup(Entity ownerPlayer, string shadowId, integer atk, integer maxHp, string standRuid, string moveRuid, Vector2 formationOffset)
        -- ShadowCommander가 스폰 직후 호출한다. 스폰 직후에는 같은 컴포넌트의 다른 메서드를 부르면
        -- nil(LEA-2011)이 날 수 있어 값만 저장하고, 스프라이트는 첫 OnUpdate에서 지정한다
        self.OwnerPlayer = ownerPlayer
        self.OwnerLastPos = _Util:Pos2(ownerPlayer)
        self.OwnerFacing = Vector2(ownerPlayer.PlayerControllerComponent.LookDirectionX >= 0 and 1 or -1, 0)
        self.ShadowId = shadowId
        self.Atk = atk
        self.MaxHp = maxHp
        self.Hp = maxHp
        self.StandRUID = standRuid
        self.MoveRUID = moveRuid
        self.FormationOffset = formationOffset
        if not Environment:IsPublishedPlay() then log("[ShadowUnit] 소환 " .. shadowId .. " ATK " .. tostring(atk)) end   -- 시전·추출·소환마다 찍히므로 출시 서버에서는 끈다
    end

    @ExecSpace("ServerOnly")
    method void TauntTick(number delta)
        -- 방패 해골: 4초마다 주변 2.5칸 적(보스 제외)이 4초 동안 이 해골을 노린다 · 거인은 종류별 간격·반경 (46-3 · 방패 거인 「도발 함성」 3초·3칸 — 보스 제외 그대로)
        if not self.Taunt or self.Dead then return end
        if self.Giant and self.GiantKind ~= "shield" then return end   -- 48: 거인 도발은 방패 「도발 함성」만 (기본 거인 도발 제거 · 평타만 — 표에 옛 tauntSec이 남아 있어도)
        self.TauntTimer = self.TauntTimer - delta
        if self.TauntTimer > 0 then return end
        self.TauntTimer = self.TauntEvery
        local me = _Util:Pos2(self.Entity)
        local pulled = 0
        for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, me, self.TauntRadius)) do
            if m.Grade < 3 then
                ---@type MonsterAttack
                local atk = m.Entity:GetComponent("script.MonsterAttack")
                if atk ~= nil then
                    atk:TauntBy(self.Entity, 4)
                    pulled = pulled + 1
                end
            end
        end
        if pulled > 0 and self.Giant then
            -- 방패 거인 「도발 함성」: 몸 동작 없음 — 기술 그림으로 평타를 덮지 않는다 (48 §6 ① · 예전 GiantPlay("skill")이 평타를 끊었다) · 머리 위 강철 고리만
            _RiteGiantMoves:Roar(self, pulled, self.TauntRadius)
        elseif pulled > 0 then
            self:SwingFx(Vector3(me.x, me.y + 0.3, 0), Vector2(1, 0), 1)
        end
    end

    @ExecSpace("ServerOnly")
    method void RegenTick(number delta)
        -- 체력 재생 (10-13 사용자 지적: 소환수는 재생이 아예 없었다). 싸우는 중 summonRegenPct, summonRestDelay초 안 맞으면 summonRestRegenPct (초당 최대 생명 비율)
        self.RegenAcc = self.RegenAcc + delta
        if self.RegenAcc < 1 then return end
        local elapsed = self.RegenAcc
        self.RegenAcc = 0
        if self.Hp >= self.MaxHp then return end
        local resting = _UtilLogic.ElapsedSeconds - self.LastHurtAt >= _GameData.summonRestDelay
        local rate = resting and _GameData.summonRestRegenPct or _GameData.summonRegenPct
        self.Hp = math.min(self.MaxHp, self.Hp + self.MaxHp * rate * elapsed)
    end

    @ExecSpace("ServerOnly")
    method void HealFull()
        -- 회복 신전(샘) 등: 생명을 가득
        if self.Dead then return end
        if self.Hp < self.MaxHp then self.Hp = self.MaxHp end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- 몬스터에게 맞으면 HP 감소, 0이면 주인에게 사망을 알린다 (재소환 대기는 주인이 관리)
        if self.Dead or self.ShadowId == "" then return end
        -- 무리 그림자: 25% 회피
        if self:GetArch() == "swarm" and _UtilLogic:RandomDouble() < 0.25 then
            self.DodgeCount = self.DodgeCount + 1
            self:TraitPopLimited("dodge")
            return
        end
        if self.Giant and _UtilLogic.ElapsedSeconds < self.GiantGuardUntil then return end   -- 46-4 쌍칼 거인 돌진 중 받는 피해 0
        self.LastHurtAt = _UtilLogic.ElapsedSeconds
        local offered = _UtilLogic.ElapsedSeconds < self.OfferUntil and 0.8 or 1   -- 뼈 성찬: 3초간 받는 피해 -20%
        self:Hurt(event.TotalDamage * self:AuraMult("guard") * offered * math.max(0.1, 1 - self.GuardPct / 100))   -- 방패 해골
        if self.Giant and not self.Dead then self:GiantPlay("hit", 0) end   -- 거인 피격 그림 (그림만 · 공격·기술 동작 중 생략 · 0.5초에 한 번 — GiantPlay)
    end

    @ExecSpace("ServerOnly")
    method void Hurt(number amount)
        -- 생명을 깎고 0이면 쓰러진다 (피격 · 가시 오오라 반사 공통)
        if self.Dead or self.ShadowId == "" then return end
        self.Hp = self.Hp - amount
        if self.Hp > 0 then return end
        if self.Bombing then self:BombExplode() return end   -- 돌진 중 쓰러지면 그 자리에서 터진다
        self.Dead = true
        -- 실제 피격 사망만 알린다. 이동·회수·수명 종료의 Destroy에는 이 경로가 없다.
        if _Util:IsAlive(self.OwnerPlayer) and isvalid(self.Entity.CurrentMap) then
            _CompanionHUD:NotifyLoss(self.OwnerPlayer, self.Kind, self.Entity.CurrentMap.Id, self.OwnerPlayer.PlayerComponent.UserId)
        end
        if self.Kind ~= "shadow" then
            -- 언데드는 무너지면 끝 (재소환 대기 없음). 해골 전사는 강화 「뼈 파편」이 있으면 무너지며 주변에 피해
            if self.Kind == "skeleton" and not self.Giant then _UndeadSystem:SkeletonBurst(self) end   -- 뼈 거인은 「뼈 파편」을 터뜨리지 않는다 (다섯 몫 공격력이라 너무 크다)
            if self.Giant then _RiteGiantMoves:Clear(self) end   -- 46-4 기다리던 「저 적을」 명령 버림
            _UndeadSystem:OnUnitDied(self.OwnerPlayer, self.ShadowId)
            if isvalid(self.Entity) then self.Entity:Destroy() end
            return
        end
        if isvalid(self.OwnerPlayer) then
            ---@type ShadowCommander
            local commander = self.OwnerPlayer:GetComponent("script.ShadowCommander")
            if commander ~= nil then
                commander:OnUnitDied(self.ShadowId)
                return
            end
        end
        self.Entity:Destroy()
    end

    method string GetArch()
        -- 원본 몬스터 유형 (그림자 이름 Shadow_<sourceId>). 언데드(해골·마법사)는 ""
        if not self.ArchReady then
            self.ArchReady = true
            local src = self.Kind == "shadow" and string.match(self.Entity.Name, "^Shadow_(.+)$") or nil
            self.Arch = src ~= nil and _GameData:ArchetypeOf(src) or ""
        end
        return self.Arch
    end

    method number ArchTakenMult()
        -- 방패 그림자: 받는 피해 -25% (MonsterAttack.CalcDamage가 곱한다)
        return self:GetArch() == "guard" and 0.75 or 1
    end

    method number ArchHaste()
        -- 짐승: 공격 속도 +15% · 광전사: 자기 생명 절반 아래면 +40%
        local arch = self:GetArch()
        if arch == "beast" then return 1.15 end
        if arch == "berserker" and self.Hp < self.MaxHp * 0.5 then return 1.4 end
        return 1
    end

    @ExecSpace("ServerOnly")
    method void Rally(number seconds)
        -- 집결: 일정 시간 적을 무시하고 주인에게 모인다
        self.RallyTimer = seconds
        self.CommandState = "rally"
        self.Target = nil
        self.FocusUntil = 0
        self:CancelPendingAttack()
        self:ClearProjectiles()
    end

    @ExecSpace("ServerOnly")
    method void Focus(Entity target, number seconds)
        -- 「저 적을」 (44-3 D · ShadowCommander.FocusAll): seconds 동안 target을 먼저 친다 — 집결을 끊고 바로 그 적으로.
        --   주인 교전 범위보다 FocusExtraRange만큼 멀리까지 쫓는다 (피해·속도 보너스 없음 — 고르는 것만 바뀐다)
        self.RallyTimer = 0
        self.FocusTarget = target
        self.FocusUntil = _UtilLogic.ElapsedSeconds + seconds
        if self.Target ~= target then
            self.Target = target
            self:CancelPendingAttack()
        end
        self.RetargetTimer = 0
        if self.Giant then _RiteGiantMoves:OnFocus(self, target) end   -- 46-4 거인 스킬 2 (명령한 대상이 유효할 때만 · 명령 한 번에 한 번)
    end

    method boolean IsFocused(Entity e)
        -- 지금 「저 적을」로 고른 적인가 (시간 안 · 살아 있음)
        return e ~= nil and e == self.FocusTarget and _UtilLogic.ElapsedSeconds < self.FocusUntil and self:IsLiveTarget(e)
    end

    method number EngageRange(Entity e)
        -- 주인 곁 교전 범위: 집중 대상이면 FocusExtraRange만큼 더 (그 밖은 OwnerCombatRange 그대로)
        if self:IsFocused(e) then return self.OwnerCombatRange + self.FocusExtraRange end
        return self.OwnerCombatRange
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- 10-10 4차 QA(실제 서버 끊김): 판단 로직이 서버 매 프레임(메이커 초당 약 340번) 통째로 돌며 표·벡터를 계속 만들어,
        -- 소환수가 있을 때만 30~74ms 서버 멈춤이 8초에 3~6번 생겼다 (끄면 0~1번). 판단은 초당 20번으로 묶는다
        self.TickAcc = self.TickAcc + delta
        if self.TickAcc < self.TickInterval then return end
        delta = math.min(0.25, self.TickAcc)
        self.TickAcc = 0
        self.LastDelta = delta
        -- 상태 판단: 설정 대기 → 주인 확인 → 끈 거리 → (적 추적·공격 | 대형 자리로 복귀)
        if self.ShadowId == "" or self.Dead then return end  -- 설정 대기 중이거나 사망 처리 중
        if self.Bombing then self:BombTick() return end
        if _UtilLogic.ElapsedSeconds < self.BoundUntil then
            self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
            return
        end
        if not self.RingPainted then self:PaintRing() end
        self:RegenTick(delta)
        self:TauntTick(delta)
        if not _Util:IsAlive(self.OwnerPlayer) or self.OwnerPlayer.CurrentMap ~= self.Entity.CurrentMap then
            self.Entity:Destroy()
            return
        end
        if self.Giant then _RiteGiantMoves:Tick(self, delta) end   -- 46-4 거인 기술 (스킬 1 저절로 · 스킬 2 기다리는 명령)
        if self.Giant and _UtilLogic.ElapsedSeconds < self.GiantCastUntil then
            -- 48 거인 영창·꽂기 중: 제자리 (기도 메테오 영창 1초 · 노바 0.3초 · 땅 가르기 — 이동 0 · 평타도 쉰다)
            self:StopMove(0)
            self:UpdateCommandState()
            return
        end
        self.AttackTimer = self.AttackTimer - delta
        self.RallyTimer = self.RallyTimer - delta
        -- 주인이 물러나면 준비 중인 타격도 끊고 따라간다. 공격 모션이 끝날 때까지 기다리지 않는다.
        -- 시야 판정은 비싸서 매 프레임이 아니라 OwnerCheckInterval마다 (대상이 죽으면 바로 놓는다).
        self.OwnerCheckTimer = self.OwnerCheckTimer - delta
        local checkOwner = self.OwnerCheckTimer <= 0 or not self:IsLiveTarget(self.Target)
        if checkOwner then self.OwnerCheckTimer = self.OwnerCheckInterval end
        if self.Target ~= nil and checkOwner and not self:IsOwnerCombatTarget(self.Target, self:EngageRange(self.Target)) then
            self.Target = nil
            self.RetargetTimer = 0
            self:CancelPendingAttack()
        end
        self:UpdateCommandState()
        if _UtilLogic.ElapsedSeconds < self.AttackAnimationUntil then return end
        self:AbilityTick(delta)
        self:PartyAuraTick(delta)

        local p = self.Entity.TransformComponent.WorldPosition
        local myPos = Vector2(p.x, p.y)
        if self.Moving and (myPos - self.LastMovePos):Magnitude() < 0.02 then self.StuckSeconds = self.StuckSeconds + delta else self.StuckSeconds = 0 end
        self.LastMovePos = myPos
        local o = self.OwnerPlayer.TransformComponent.WorldPosition
        self:TrackOwnerSpeed(Vector2(o.x, o.y))
        local follow0 = self:SmoothOwner(Vector2(o.x, o.y), delta)
        local slot = self:FreeSlot(follow0, self:FormationSlot(follow0) + self.Wander)
        local toSlot = slot - myPos
        -- 군단 질주(주인 질주 강화): 6칸 넘게 떨어지면 바로 곁으로, 주인이 막 질주했으면 3칸만 떨어져도 따라 도약. 1초마다 주인 스킬을 확인
        if _UtilLogic.ElapsedSeconds >= self.RushCheckAt then
            self.RushCheckAt = _UtilLogic.ElapsedSeconds + 1
            ---@type SkillBook
            local book = self.OwnerPlayer:GetComponent("script.SkillBook")
            self.RushLeash = book ~= nil and book:Node("dash_legion") > 0
        end
        local leash = self.RushLeash and 6 or self.LeashDistance
        if _UtilLogic.ElapsedSeconds < self.LeapUntil then leash = 3 end
        if toSlot:Magnitude() > leash then
            -- 너무 멀어지면 자기 자리로 순간이동 (끼임 방지)
            self.Target = nil
            self:CancelPendingAttack()
            self:StopMove(o.x - myPos.x)
            self.Entity.MovementComponent:SetWorldPosition(slot)
            self:UpdateCommandState()
            return
        end

        if self.RallyTimer <= 0 then
            self.RetargetTimer = self.RetargetTimer - delta
            if self.RetargetTimer <= 0 or not self:IsLiveTarget(self.Target) then
                self.RetargetTimer = self.RetargetInterval
                self.Target = self:FindNearestMonster(myPos)
            end
        end

        self:UpdateCommandState()
        if self.RallyTimer <= 0 and self:IsLiveTarget(self.Target) then
            local t = self.Target.TransformComponent.WorldPosition
            local toTarget = Vector2(t.x, t.y) - myPos
            if toTarget:Magnitude() > self.AttackRange or not _Util:HasLineOfSight(self.Entity.CurrentMap, myPos, Vector2(t.x, t.y)) then
                self:SetSpeedMult((self.Giant and _UtilLogic.ElapsedSeconds < self.GiantSlowUntil) and 0.6 or self:TwinHuntSpeedMult())   -- 48 대검 거인 회전 중 ×0.6으로 따라감 · 쌍칼 후열 사냥 대상 추격 ×twinHuntSpeed (48 통합)
                self:MoveToward(toTarget)
            else
                -- 마법사는 닿는 적에게서 물러나 전사의 뒤에서 쏜다. 벽 앞에서는 공격을 포기하지 않는다.
                local safeRange = math.min(2.2, self.AttackRange * 0.55)
                local retreat = toTarget * -1
                -- 48-6 ④ 거인은 물러서지 않는다 (마법사 거인 사거리 4.5 × 0.55 = 2.2칸 안 적이면 1.2초마다 뒷걸음질 → 평타 사이 계속 걸었다) — 사거리 안·시야면 멈춰 쏜다
                if self.Kind == "mage" and not self.Giant and toTarget:Magnitude() < safeRange and retreat:Magnitude() > 0.05
                    and (_Util:Pos2(self.OwnerPlayer) - myPos):Magnitude() < 6
                    and _Util:HasLineOfSight(self.Entity.CurrentMap, myPos, myPos + retreat:Normalize() * 0.6) then
                    local now = _UtilLogic.ElapsedSeconds
                    if now >= self.NextBackpedalAt then
                        self.BackpedalUntil = now + 0.35
                        self.NextBackpedalAt = now + 1.2
                    end
                    if now < self.BackpedalUntil then self:MoveToward(retreat) return end
                end
                self:StopMove(toTarget.x)
                if self.AttackTimer <= 0 then
                    local frenzy = _UtilLogic.ElapsedSeconds < self.FrenzyUntil and (1 + self.FrenzyPct / 100) or 1   -- 뼈 성찬 「피의 고양」
                    self.AttackTimer = self.AttackCooldown / (self:AuraMult("haste") * (1 + self:OwnerBonus("ias") / 100) * frenzy * self:ArchHaste())
                    self:DoAttack(myPos, toTarget)
                end
            end
            return
        end

        -- 따라가기: 멈춤·출발 사이에 간격을 두고, 멀수록 빨라진다 (주인보다 느린 원본도 대형에 붙는다)
        local dist = toSlot:Magnitude()
        -- 10-10 3차 QA(11마리 끌고 다닐 때 뚝뚝): 주인이 걷는 중에도 자리에 닿으면 멈췄다가 0.6칸 벌어지면 다시 출발했다
        -- (메이커 측정: 마법사·그림자가 걷는 3초 동안 2번 출발·5~9프레임 정지). 주인이 걷는 동안은 멈추지 않고 주인 속도에 맞춰 함께 걷는다
        local ownerMoving = self.OwnerVel > 0.3
        local follow = (self.Moving and (dist > self.FollowStop or ownerMoving)) or (not self.Moving and dist > self.FollowStart)
        -- 주인이 서 있는데 동료·주인 몸에 막혀 자리에 못 가면(0.8초) 그 자리에 선다 (계속 비비며 움직이지 않게)
        if follow and not ownerMoving and self.StuckSeconds > 0.8 and dist < 1.6 then follow = false end
        if follow then
            -- 많이 뒤처졌을 때(1.2칸+)만 살짝 서두른다. 최대 1.25배 · 걷기 동작도 같은 배율로 빨라져 발이 미끄러지지 않는다
            -- (10-10 2차 QA: 1.8배까지 올리니 걷지 않고 날아다니는 것처럼 보였다)
            -- 걸음 빠르기는 자리까지 거리에 따라 부드럽게 (가까우면 0.75배 · 1.6칸 이상이면 1.3배). 거리가 평활된 주인 위치에서
            -- 나오므로 계단식으로 튀지 않는다. 소환수마다 SpeedJitter로 조금씩 달라 줄맞춰 걷지 않는다
            local mult = math.max(0.75, math.min(1.3, 0.75 + 0.35 * dist)) * self.SpeedJitter
            if ownerMoving then
                -- 10-10 6차 QA: 걷는 동안 전사가 앞이 아니라 늘 뒤에서 뭉쳐 따라왔다 (최대 1.3배라 주인보다 느렸다).
                -- 주인 속도의 1.0~1.6배(자리까지 남은 거리에 따라)까지 낸다. 걷기 동작도 같은 배율로 빨라진다
                local world = self:Base() * self.WorldPerInput
                if world > 0.05 then
                    mult = math.max(mult, math.min(self.PaceMax, self.OwnerVel * math.min(1.6, 1 + 0.5 * dist) / world))
                end
            end
            self:SetSpeedMult(mult)
            -- 주인이 걷는 중이면 자리보다 조금 앞을 겨눠 자리에 「도착」해서 서지 않게 하고,
            -- 뒤에서 앞자리로 갈 때는 주인 몸을 옆으로 비켜 돈다 (MotionSmoother.FollowMove와 같은 계산)
            local aim = toSlot
            if ownerMoving then aim = toSlot + self.OwnerVelDir * 0.3 + self:PassOwner(myPos, Vector2(o.x, o.y), slot, self.OwnerVelDir) end
            self:MoveToward(aim)
        else
            self:SetSpeedMult(1)
            self:StopMove(o.x - myPos.x)
        end
    end

    method Vector2 PassOwner(Vector2 myPos, Vector2 ownerPos, Vector2 slot, Vector2 forward)
        -- 주인 뒤(또는 옆)에서 앞자리로 가는 길이 주인 몸을 지나면, 옆으로 비켜 가게 겨냥을 옮긴다
        local side = Vector2(-forward.y, forward.x)
        local rel = myPos - ownerPos
        local along = rel:Dot(forward)
        local lat = rel:Dot(side)
        local slotAlong = (slot - ownerPos):Dot(forward)
        if along < 0.4 and along > -1.8 and slotAlong > along + 0.3 and math.abs(lat) < 0.55 then
            local s = 1
            if lat < 0 then s = -1 end
            return side * (s * (0.55 - math.abs(lat)) * 1.8)
        end
        return Vector2(0, 0)
    end

    @ExecSpace("ServerOnly")
    method Vector2 SmoothOwner(Vector2 ownerPos, number delta)
        -- 서버에 보이는 주인 위치는 초당 약 10번 계단식으로 바뀐다. 그대로 쓰면 모든 소환수가 같은 순간에 방향·속도를
        -- 바꿔 한 부대가 같은 박자로 딱딱 움직였다 (10-10 3차 QA). 마지막 속도로 앞을 예측하고, 소환수마다 다른 빠르기로 따라간다
        if not self.Personal then
            self.Personal = true
            self.TickAcc = _UtilLogic:RandomDouble() * self.TickInterval  -- 소환수마다 판단 시점을 어긋나게
            self.FollowLag = 4.5 + _UtilLogic:RandomDouble() * 6
            self.SpeedJitter = 0.93 + _UtilLogic:RandomDouble() * 0.14
            self.RetargetTimer = _UtilLogic:RandomDouble() * self.RetargetInterval
            self.AttackTimer = _UtilLogic:RandomDouble() * 0.4
            self.WanderAt = _UtilLogic.ElapsedSeconds + _UtilLogic:RandomDouble() * 2
        end
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.WanderAt then
            -- 2.5~4.5초마다 대형 자리를 반경 0.35 안에서 조금 옮긴다
            local a = _UtilLogic:RandomDouble() * math.pi * 2
            local r = _UtilLogic:RandomDouble() * 0.35
            self.Wander = Vector2(math.cos(a) * r, math.sin(a) * r)
            self.WanderAt = now + 2.5 + _UtilLogic:RandomDouble() * 2
        end
        local predicted = ownerPos
        if self.OwnerVel > 0.3 then predicted = ownerPos + self.OwnerVelVec * math.min(0.12, now - self.OwnerVelAt) end
        if not self.OwnerSmoothReady or (predicted - self.OwnerSmooth):Magnitude() > 3 then
            self.OwnerSmooth = predicted
            self.OwnerSmoothReady = true
        else
            local k = 1 - math.exp(-self.FollowLag * math.max(0, delta))
            self.OwnerSmooth = self.OwnerSmooth + (predicted - self.OwnerSmooth) * k
        end
        return self.OwnerSmooth
    end

    @ExecSpace("ServerOnly")
    method Vector2 FreeSlot(Vector2 ownerPos, Vector2 slot)
        -- 대형 자리가 벽·막힌 칸이면 주인 쪽으로 당겨 처음 비어 있는 곳을 쓴다
        -- (10-10 3차 QA: 벽 앞에 서면 앞줄 해골의 자리가 벽 속이라 닿지 못하고 계속 움직였다)
        local memo = _Util:TerrainMemo(self.Entity.CurrentMap)
        if memo == nil then return slot end
        -- (매 판단마다 표를 새로 만들지 않게 세 번 직접 확인한다)
        if not _Util:CellBlocked(memo, slot) then return slot end
        local p = ownerPos + (slot - ownerPos) * 0.7
        if not _Util:CellBlocked(memo, p) then return p end
        p = ownerPos + (slot - ownerPos) * 0.4
        if not _Util:CellBlocked(memo, p) then return p end
        return ownerPos
    end

    @ExecSpace("ServerOnly")
    method void TrackOwnerSpeed(Vector2 ownerPos)
        -- 서버에 보이는 주인 위치는 초당 약 10번 바뀐다: 바뀔 때마다 이동 거리 / 경과로 속도를 잡는다
        local now = _UtilLogic.ElapsedSeconds
        local moved = (ownerPos - self.OwnerVelPos):Magnitude()
        if moved > 0.001 then
            local dt = now - self.OwnerVelAt
            if dt > 0.02 and dt < 0.5 and moved < 2 then
                self.OwnerVel = self.OwnerVel + (moved / dt - self.OwnerVel) * 0.5
                self.OwnerVelDir = (ownerPos - self.OwnerVelPos) / moved
                self.OwnerVelVec = self.OwnerVelVec + ((ownerPos - self.OwnerVelPos) / dt - self.OwnerVelVec) * 0.5
            end
            self.OwnerVelPos = ownerPos
            self.OwnerVelAt = now
        elseif now - self.OwnerVelAt > 0.4 then
            self.OwnerVel = 0
            self.OwnerVelVec = Vector2(0, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method number Base()
        -- 원본 이동 속도 (처음이면 지금 속도를 원본으로 잡는다)
        if self.BaseSpeed <= 0 then
            local mv = self.Entity.MovementComponent
            if isvalid(mv) then self.BaseSpeed = mv.InputSpeed / math.max(0.1, self.SpeedMult) end
        end
        return self.BaseSpeed
    end

    @ExecSpace("ServerOnly")
    method void SetSpeedMult(number mult)
        -- 배율이 충분히 바뀔 때만 이동 속도·걷기 속도를 쓴다 (매 프레임 동기화 값을 쓰지 않는다). 기동 오오라를 곱한다
        mult = mult * self:AuraMult("move")
        -- 10-10 4차 QA: 실제 서버에서는 11마리의 동기화 값이 위치와 함께 몰려 끊김을 키운다 → 0.15 이상 바뀔 때만, 0.15 단위로
        if math.abs(mult - self.SpeedMult) < 0.15 then return end
        local q = math.floor(mult / 0.15 + 0.5) * 0.15
        if q == self.SpeedMult then return end
        local base = self:Base()
        local mv = self.Entity.MovementComponent
        if base <= 0 or not isvalid(mv) then return end
        self.SpeedMult = q
        mv.InputSpeed = base * q
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.PlayRate = q end
    end

    @ExecSpace("ServerOnly")
    method void SetBaseSpeed(number speed)
        -- 원본 속도가 바뀌었다 (배치·능력치 갱신): 배율을 다시 1로
        self.BaseSpeed = speed
        self.SpeedMult = 1
        local sprite = self.Entity.SpriteRendererComponent
        if isvalid(sprite) then sprite.PlayRate = 1 end
        local mv = self.Entity.MovementComponent
        if isvalid(mv) then mv.InputSpeed = speed end
    end

    -- ───────── 해골 폭탄 (10-20) ─────────

    @ExecSpace("ServerOnly")
    method void StartBomb(Entity foe, Vector2 point, number damage, number radius)
        -- UndeadSystem.SkeletonBomb이 부른다 (이미 목록에서 빠졌다). 최대 2초 돌진 → 적에 닿거나 시간이 끝나면 폭발
        self.Bombing = true
        self.BombTarget = foe
        self.BombPoint = point
        self.BombDamage = damage
        self.BombRadius = radius
        self.BombUntil = _UtilLogic.ElapsedSeconds + 2
        self.Target = nil
        self.RallyTimer = 0
        self:CancelPendingAttack()
        self:ClearProjectiles()
        self.CommandState = "bomb"
        self:BombFlash(2.2)
        self:SetSpeedMult(2.25)
    end

    @ExecSpace("ServerOnly")
    method void BombTick()
        -- 돌진: 살아 있는 적이면 그 적, 아니면 조준점으로. 0.7칸 안에 닿거나 2초가 지나면 터진다
        if not _Util:IsAlive(self.OwnerPlayer) or self.OwnerPlayer.CurrentMap ~= self.Entity.CurrentMap then
            self.Dead = true
            self.Entity:Destroy()
            return
        end
        local goal = self.BombPoint
        if self:IsLiveTarget(self.BombTarget) then goal = _Util:Pos2(self.BombTarget) end
        local me = _Util:Pos2(self.Entity)
        local to = goal - me
        if to:Magnitude() <= 0.7 or _UtilLogic.ElapsedSeconds >= self.BombUntil then
            self:BombExplode()
            return
        end
        self:SetSpeedMult(2.25)
        self:MoveToward(to)
    end

    @ExecSpace("ServerOnly")
    method void BombExplode()
        -- 주인의 타격 판정으로 반경 BombRadius 피해 + 검붉은 폭발. 해골은 사라진다
        if self.Dead then return end
        self.Dead = true
        local p = _Util:Pos2(self.Entity)
        local owner = self.OwnerPlayer
        if _Util:IsAlive(owner) then
            ---@type PlayerAttack
            local atk = owner:GetComponent("script.PlayerAttack")
            if atk ~= nil then atk:SkillAttack(Vector2(p.x, p.y + 0.2), Vector2(self.BombRadius, 0), -1, "skill.bone_rite", self.BombDamage) end   -- 뼈 의식 1기 (10-29 해골 폭탄 병합)
            ---@type SkillEffects
            local fx = owner:GetComponent("script.SkillEffects")
            if fx ~= nil then
                fx:BlastFx(Vector3(p.x, p.y + 0.2, 0), self.BombRadius, self.Entity.CurrentMap.Id)
                fx:C7Clip("blast", Vector3(p.x, p.y, 0), 0.5, 0.75 * self.BombRadius / 1.6, 1.2)   -- 10-31 C 7종 뼈 폭발 4장 (비면 예전 메이플 피 폭발)
            end
        end
        log(string.format("[VRF] skeleton bomb exploded dmg=%.0f r=%.2f", self.BombDamage, self.BombRadius))
        self.Entity:Destroy()
    end

    -- ───────── 뼈 의식 5기 「뼈 거인」 (10-29) ─────────

    @ExecSpace("ServerOnly")
    method void StartGiant(string kind, integer atk, number maxHp, number hp, table look)
        -- UndeadSystem.StartGiant가 부른다 (46-3 · rite_giants.csv 종류 줄 — 수치는 46 결정 4 초안): 다섯 몫 공격·생명(종류 배율은 UndeadSystem이 곱했다),
        -- 받는 피해 guardPct · 기본 공격 간격·반경(근접) 또는 사거리·자리 폭발(마법사 = 화살 길 ShootBolt · BlastMult) · 이동 speedMul · 도발 tauntSec·tauntRadius(보스 제외 그대로).
        -- 크기: 거인 그림(form_giant_<종류>)이 있으면 GiantArtScale, 없으면 그 종류 변이 그림 × riteGiantScale · 칠하지 않는다 (§5-2 · 변이 그림은 이미 색이 있다).
        -- 피해 랭크 배율은 지금대로 넣지 않는다 (랭크당 +3%는 수치 제안 §10-4)
        if self.Dead or self.Giant then return end
        local spec = _GameData:GetGiant(kind)
        -- 갈라짐 그림 복구 대기 중 재진입: 원래 외형을 먼저 복구해 다음 기준에 거인 그림·배율이 섞이지 않게 한다 (능력치는 이미 EndGiant에서 복구됨).
        if self.GiantBase.sx ~= nil then self:RestoreLook(self.GiantBase) end
        local t = self.Entity.TransformComponent
        -- 10-30 갈래 E: 그림 되돌리기용으로 서기·걷기·공격 그림도 담는다 (능력치·시간 규칙은 그대로)
        self.GiantLookToken = self.GiantLookToken + 1
        self.GiantBase = { atk = self.Atk, maxHp = self.MaxHp, radius = self.RadiusMult, basic = self.BasicMult, cd = self.AttackCooldown, range = self.AttackRange,
            taunt = self.Taunt, guard = self.GuardPct, sx = math.abs(t.Scale.x), sy = t.Scale.y, tint = self.ShadowTint,
            stand = self.StandRUID, move = self.MoveRUID, attack = self.AttackRUID,
            bolts = self.BoltCount, boltMul = self.BoltMult, pierce = self.BoltPierce, hex = self.HexPct, blast = self.BlastMult, blastR = self.BlastRadius,
            tauntEvery = self.TauntEvery, tauntR = self.TauntRadius, speed = self.BaseSpeed }
        self.Giant = true
        self.GiantKind = spec ~= nil and spec.kind or "basic"
        self.Atk = math.max(1, atk)
        self.MaxHp = math.max(1, maxHp)
        self.Hp = math.max(1, math.min(self.MaxHp, hp))
        local radius = spec ~= nil and spec.radius or _GameData.riteGiantRadius
        self.AttackCooldown = spec ~= nil and spec.interval or _GameData.riteGiantInterval
        self.AttackRange = spec ~= nil and spec.range or 1.2
        self.BasicMult = 1
        if self.AttackRange >= 2 then
            -- 마법사 거인: 원소 구슬 한 발(BoltMult 1 = 공격 × 1 — atk에 atkMul이 이미 들었다) · 맞은 자리 반경 radius에 × blastMul · 원소 = 몸이 된 마법사 원소 그대로
            self.RadiusMult = 1
            self.BoltCount = 1
            self.BoltMult = 1
            self.BoltPierce = 0
            self.HexPct = 0
            self.BlastMult = spec ~= nil and spec.blastMul or 0
            self.BlastRadius = radius
        else
            self.RadiusMult = radius / math.max(0.1, self.AttackRadius)
        end
        self.Taunt = spec == nil or spec.tauntSec > 0
        self.TauntEvery = (spec ~= nil and spec.tauntSec > 0) and spec.tauntSec or 4
        self.TauntRadius = (spec ~= nil and spec.tauntRadius > 0) and spec.tauntRadius or 2.5
        self.TauntTimer = 0
        self.GuardPct = spec ~= nil and spec.guardPct or 0
        if self.GiantKind == "shield" and isvalid(self.OwnerPlayer) then
            -- 46-5 강화 「뼈 성벽」: 도발 반경 +0.3칸 · 받는 피해 -3%p / 랭크 (최대 -39% · 보스 제외 그대로)
            local wall = _RiteGiantMoves:NodeOf(self, "giant_shield_wall")   -- 48 거인 각인 경로 (RiteGiantMoves.GiantImprint · 지금 기본 true라 값은 같다)
            self.TauntRadius = self.TauntRadius + 0.3 * wall
            self.GuardPct = self.GuardPct + 3 * wall
        end
        if spec ~= nil and self.BaseSpeed > 0 then self:SetBaseSpeed(self.BaseSpeed * spec.speedMul) end
        -- 그림 (10-30 갈래 E · 시각만): 거인 3종 그림(look)이 등록돼 있으면 서기·걷기·공격 그림을 거인 그림으로 바꾸고, 그림이 이미 크므로 배율은 GiantArtScale ·
        --   칠하지 않는다. 없으면(look = nil · 미등록) 지금처럼 변이 그림 × riteGiantScale · 뼈 색 칠 — 빈 그림(SpriteRUID "")은 절대 넣지 않는다
        local giantArt = look ~= nil and (look.stand or "") ~= "" and (look.move or "") ~= "" and (look.attack or "") ~= ""
        local mul = giantArt and _UndeadSystem.GiantArtScale or _GameData.riteGiantScale
        local sign = t.Scale.x < 0 and -1 or 1
        t.Scale = Vector3(self.GiantBase.sx * mul * sign, self.GiantBase.sy * mul, t.Scale.z)
        self.GiantClipUntil = 0
        if giantArt then
            self.GiantLook = look
            self.StandRUID = look.stand
            self.MoveRUID = look.move
            self.AttackRUID = look.attack
            self.ShadowTint = Color(1, 1, 1, 1)
            self.CurrentClip = ""
            self:SetClip(self.Moving and self.MoveRUID or self.StandRUID)
        else
            -- 그림 미등록 임시 (46-3 · §5-2): 그 종류 변이 그림(몸이 이긴 종류라 몸 그림 그대로) × riteGiantScale · 칠하지 않는다 (예전 뼈 색 칠은 변이 그림을 탁하게 했다)
            self.GiantLook = {}
        end
        self.Entity.SpriteRendererComponent.Color = self.ShadowTint
        self.RingPainted = false
        log(string.format("[VRF] rite giant start type=%s atk=%d hp=%.0f/%.0f guard=%d radius=%.2f range=%.1f cd=%.2f speed=%.2f taunt=%s look=%s scale=%.2f", self.GiantKind, self.Atk, self.Hp, self.MaxHp, math.floor(self.GuardPct),
            self.AttackRange >= 2 and self.BlastRadius or self.AttackRadius * self.RadiusMult, self.AttackRange, self.AttackCooldown, self.BaseSpeed, self.Taunt and string.format("%.0fs/%.1f", self.TauntEvery, self.TauntRadius) or "none", giantArt and look.form or "fallback", mul))
    end

    @ExecSpace("ServerOnly")
    method number EndGiant()
        -- 갈라질 때: 원래 값으로 되돌리고 남은 생명 비율(0~1)을 돌려준다 (이 해골도 같은 비율로 남는다)
        if not self.Giant then return 0 end
        _RiteGiantMoves:Clear(self)   -- 46-4 기다리던 명령·기술 상태 버림
        local ratio = math.max(0, math.min(1, self.Hp / math.max(1, self.MaxHp)))
        local b = self.GiantBase
        self.Giant = false
        self.Atk = b.atk
        self.MaxHp = b.maxHp
        self.Hp = math.max(1, b.maxHp * ratio)
        self.RadiusMult = b.radius
        self.BasicMult = b.basic
        self.AttackCooldown = b.cd
        self.AttackRange = b.range
        self.Taunt = b.taunt
        self.GuardPct = b.guard
        self.GiantKind = ""
        self.GiantCastUntil = 0
        self.GiantSlowUntil = 0
        self.GiantHoldUntil = 0
        if b.bolts ~= nil then
            self.BoltCount = b.bolts
            self.BoltMult = b.boltMul
            self.BoltPierce = b.pierce
            self.HexPct = b.hex
            self.BlastMult = b.blast
            self.BlastRadius = b.blastR
            self.TauntEvery = b.tauntEvery
            self.TauntRadius = b.tauntR
        end
        if (b.speed or 0) > 0 then self:SetBaseSpeed(b.speed) end
        -- GiantBase 외형 기준은 RestoreLook까지 보존한다 (갈라짐 도중 재진입에서도 원본을 사용).
        -- 그림 (10-30 갈래 E): 거인 그림이면 갈라짐 동작을 그 길이만큼 보인 뒤 원래 그림으로 (능력치는 지금 바로 · 시간 규칙 그대로). 미등록이면 지금처럼 바로
        local look = self.GiantLook
        if (look.split or "") ~= "" then
            self:GiantPlay("split", 0)
            local token = self.GiantLookToken
            _TimerService:SetTimerOnce(function()
                if isvalid(self.Entity) and not self.Giant and token == self.GiantLookToken then self:RestoreLook(b) end
            end, math.max(0.05, look.splitSec or 0))
        else
            self:RestoreLook(b)
        end
        return ratio
    end

    @ExecSpace("ServerOnly")
    method void RestoreLook(table b)
        -- 거인이 되기 전 그림·크기·색으로 (EndGiant · 갈라짐 그림 뒤). 비어 있던 값은 지금 값을 둔다 (빈 그림을 넣지 않는다)
        self.GiantBase = {}
        self.GiantLook = {}
        self.GiantClipUntil = 0
        if (b.stand or "") ~= "" then self.StandRUID = b.stand end
        if (b.move or "") ~= "" then self.MoveRUID = b.move end
        if b.attack ~= nil then self.AttackRUID = b.attack end
        local t = self.Entity.TransformComponent
        local sign = t.Scale.x < 0 and -1 or 1
        t.Scale = Vector3(b.sx * sign, b.sy, t.Scale.z)
        self.ShadowTint = b.tint
        self.Entity.SpriteRendererComponent.Color = self.ShadowTint
        self.RingPainted = false
        self.CurrentClip = ""
        self:SetClip(self.Moving and self.MoveRUID or self.StandRUID)
    end

    @ExecSpace("ServerOnly")
    method void GiantPlay(string state, number holdSec)
        -- 거인 동작 그림(skill1 · skill2 · hit · split · 48-6): GiantMotionKey로 고른 그림 첫 칸을 걸고(클라이언트 MotionSmoother.FrameClip이 칸을 넘긴다)
        --   max(그림 길이, holdSec) 동안 서기·걷기·공격 그림으로 덮지 않는다. holdSec가 그림보다 길면 그동안 반복(③ 회전 1.6초 · 영창 1초 · 연속 베기 0.9초 — GiantHoldUntil).
        --   ② 맞음은 공격·기술 동작 중엔 생략 · 0.5초에 한 번까지. 그림만 — 판정·도발·갈라짐 시간은 바꾸지 않는다. 미등록이면 아무 일 없음 (빈 그림을 넣지 않는다)
        local key = self:GiantMotionKey(state)
        if key == "" then return end
        local ruid = self.GiantLook[key]
        local now = _UtilLogic.ElapsedSeconds
        if state == "hit" then
            if now < self.GiantClipUntil or now < self.AttackAnimationUntil or now < self.GiantHitAt + 0.5 then return end
            self.GiantHitAt = now
        end
        local one = math.max(0.05, self.GiantLook[key .. "Sec"] or 0)
        local hold = math.max(one, holdSec)
        self.GiantClipUntil = now + hold
        self.GiantClipState = state
        self.GiantHoldUntil = hold > one + 0.01 and (_UtilLogic.ServerElapsedSeconds + hold) or 0
        -- SetClip은 기술 동작 중 일반 그림(서기·걷기·공격)을 막으므로 직접 건다 (연속 베기는 평타 그림을 기술로 반복)
        self.CurrentClip = ruid
        self.Entity.SpriteRendererComponent.SpriteRUID = ruid
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] giant look play state=%s key=%s form=%s sec=%.2f loop=%s", state, key, self.GiantLook.form or "", hold, tostring(self.GiantHoldUntil > 0))) end
    end

    @ExecSpace("ServerOnly")
    method number GiantRoarBody(any onStart)
        -- s48v2-A 방패 함성 몸 (A-ROAR-01 코덱스 확정 · 그림만 — 도발 대상·적용 시점·반경·보스 제외·피해는 TauntTick 그대로):
        --   그림 키 = skill1 (C 등록 검증표 shield skill1 = 함성 몸 8~12장 · 없으면 몸 동작 없음 — 일반 skill 그림으로 대신하지 않는다)
        --   기술·소멸 동작 중이면 생략(맞음 그림은 덮는다) · 평타 동작 중이면 평타를 끊지 않고 끝난 뒤(0.6초 안일 때만) 건다
        --   돌려주는 값: 0 = 지금 몸 시작 · 0보다 크면 그 초 뒤 몸 시작(예약) · -1 = 몸을 걸 수 없음 → 부른 쪽(RiteGiantMoves.Roar)이 함성 FX를 바로 보인다
        --   onStart(bodyStarted): 몸이 실제로 시작하는 그 순간 부른다 → 함성 FX를 몸 시작에 맞춰 연다. 예약 뒤 그 사이 기술·소멸이 시작돼 몸을 못 걸면 onStart(false) (FX만 그때 · 몸 없음)
        if (self.GiantLook.skill1 or "") == "" then return -1 end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.GiantClipUntil and self.GiantClipState ~= "hit" then return -1 end
        local wait = self.AttackAnimationUntil - now
        if wait > 0.6 then return -1 end
        if wait <= 0 then
            self:GiantPlay("skill1", 0)
            if onStart ~= nil then onStart(true) end
            return 0
        end
        local token = self.GiantLookToken
        _TimerService:SetTimerOnce(function()
            if not isvalid(self.Entity) or not self.Giant or self.Dead or token ~= self.GiantLookToken then return end
            local ok = not (_UtilLogic.ElapsedSeconds < self.GiantClipUntil and self.GiantClipState ~= "hit")
            if ok then self:GiantPlay("skill1", 0) end
            if onStart ~= nil then onStart(ok) end
        end, wait)
        return wait
    end

    method string GiantMotionKey(string state)
        -- 동작 → 그림 키 (48 §7-2 · 리뷰 가드 재사용): 그 키 그림이 있으면 그대로 · skill1/skill2가 없으면 쌍칼 연속 베기 = 평타 그림(attackFirst) ·
        --   그 밖 = 지금 skill 그림(K-4 그림 오기 전 임시) · 그것도 없으면 "" (아무 일 없음). 방패 도발 함성 몸(shield skill1)은 RiteGiantMoves.Roar → GiantRoarBody만 건다 (s48v2-A · 그림이 없으면 skill로 대체하지 않음)
        local look = self.GiantLook
        if (look[state] or "") ~= "" then return state end
        if state == "skill1" or state == "skill2" then
            if state == "skill1" and self.GiantKind == "twin" and (look.attackFirst or "") ~= "" then return "attackFirst" end
            if (look.skill or "") ~= "" then return "skill" end
        end
        return ""
    end

    @ExecSpace("Multicast")
    method void BombFlash(number seconds)
        -- 붉은 깜빡임 (정예 파란 덧칠처럼 몸 색을 바꾼다 · 그림 대역 MotionSmoother가 본체 색을 그대로 옮긴다)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) then return end
        local base = sprite.Color
        local red = Color(1, 0.18, 0.12, 1)
        local untilAt = _UtilLogic.ElapsedSeconds + seconds
        local n = 0
        if self.FlashTimer ~= 0 then _TimerService:ClearTimer(self.FlashTimer) end
        self.FlashTimer = _TimerService:SetTimerRepeat(function()
            if not isvalid(self.Entity) or _UtilLogic.ElapsedSeconds >= untilAt then
                if self.FlashTimer ~= 0 then _TimerService:ClearTimer(self.FlashTimer) end
                self.FlashTimer = 0
                return
            end
            n = n + 1
            local s2 = self.Entity.SpriteRendererComponent
            if isvalid(s2) then s2.Color = n % 3 ~= 0 and red or base end   -- 빨강 2 : 원래 색 1 (한눈에 붉게 보이게)
        end, 0.08)
    end

    @ExecSpace("ServerOnly")
    method void UpdateCommandState()
        -- 실제 행동을 동기화해 HUD가 추종·집결·추격·공격을 구분한다.
        if self.Bombing then return end
        local state = "follow"
        if self.RallyTimer > 0 then state = "rally"
        elseif _UtilLogic.ElapsedSeconds < self.AttackAnimationUntil then state = "attack"
        elseif self:IsLiveTarget(self.Target) then state = "combat" end
        if self.CommandState ~= state then self.CommandState = state end
    end

    @ExecSpace("ServerOnly")
    method Vector2 FormationSlot(Vector2 ownerPos)
        -- 전사는 진행 방향 앞, 마법사는 뒤로 선다. 이동/공격 방향을 따라 대형도 회전한다.
        if self.Kind == "shadow" then return ownerPos + self.FormationOffset end
        self.OwnerLastPos = ownerPos
        local attack = self.OwnerPlayer:GetComponent("script.PlayerAttack")
        -- 방향은 주인이 실제로 걷는 동안의 이동 방향으로만 (10-10 5차 QA 점검: 평활·예측한 주인 위치는 멈출 때 예측만큼 되돌아가
        -- 「반대로 걸었다」고 보여, 멈출 때마다 대형이 180° 돌아 전사·마법사가 앞뒤를 바꿨다)
        local face = nil
        if self.OwnerVel > 0.3 and self.OwnerVelDir:Magnitude() > 0.5 then face = self.OwnerVelDir
        elseif attack ~= nil and _UtilLogic.ElapsedSeconds - attack.LastAttackAt < 1 then face = attack.CombatDirection end
        -- 동기화 값이라 8°(cos 0.99) 넘게 바뀔 때만 쓴다
        if face ~= nil and face:Magnitude() > 0.05 then
            face = face:Normalize()
            if face:Dot(self.OwnerFacing) < 0.99 then self.OwnerFacing = face end
        end
        local forward = self.OwnerFacing
        if forward:Magnitude() < 0.05 then forward = Vector2(1, 0) else forward = forward:Normalize() end
        local side = Vector2(-forward.y, forward.x)
        local row = math.floor(self.FormationIndex / 3)
        local lane = self.FormationIndex % 3 - 1
        local depth = 0.95 + row * 0.42
        if self.Kind == "mage" then depth = -1.2 - row * 0.45 end
        if self.Kind == "revive" then depth = 0.35 + row * 0.6 end
        return ownerPos + forward * depth + side * (lane * 0.6)
    end

    @ExecSpace("ServerOnly")
    method void CancelPendingAttack()
        -- 집결/회수/수명 종료 시 이전 준비 동작이 뒤늦게 피해를 주지 않는다.
        self.AttackEpoch = self.AttackEpoch + 1
        if self.StrikeTimer ~= 0 then _TimerService:ClearTimer(self.StrikeTimer) self.StrikeTimer = 0 end
        self.AttackAnimationUntil = 0
    end

    method void OnEndPlay()
        -- 클라이언트: 표시 타이머 정리 / 서버: 예약 타격과 소환수 투사체를 함께 정리한다.
        if self:IsClient() then
            if self.ViewTimer ~= 0 then _TimerService:ClearTimer(self.ViewTimer) end
            self.ViewTimer = 0
            if self.FlashTimer ~= 0 then _TimerService:ClearTimer(self.FlashTimer) end
            self.FlashTimer = 0
            if self.HpBarTimer ~= 0 then _TimerService:ClearTimer(self.HpBarTimer) end
            self.HpBarTimer = 0
            return
        end
        self:CancelPendingAttack()
        if isvalid(self.Entity.CurrentMap) then self:ClearProjectiles() end
    end

    @ExecSpace("ServerOnly")
    method boolean IsLiveTarget(Entity e)
        -- 살아 있는 몬스터, 또는 주인의 결투 상대(플레이어·그 소환수)인지
        if not isvalid(e) or not e.Enable or e.CurrentMap ~= self.Entity.CurrentMap then return false end
        ---@type Monster
        local monster = e:GetComponent("script.Monster")
        if monster ~= nil then return not monster.IsDead and monster.Hp > 0 end
        if not _Util:IsDuelFoe(self.Entity, e) then return false end
        if isvalid(e.PlayerComponent) then return e.PlayerComponent.Hp > 0 end
        ---@type ShadowUnit
        local unit = e:GetComponent("script.ShadowUnit")
        return unit ~= nil and not unit.Dead and unit.Hp > 0
    end

    @ExecSpace("ServerOnly")
    method boolean IsOwnerCombatTarget(Entity target, number range)
        -- 살아 있는 적이라도 주인의 교전 범위 밖이거나 벽 뒤에 있으면 쫓지 않는다.
        if not self:IsLiveTarget(target) or not _Util:IsAlive(self.OwnerPlayer) then return false end
        local ownerPos = _Util:Pos2(self.OwnerPlayer)
        local targetPos = _Util:Pos2(target)
        return (targetPos - ownerPos):Magnitude() <= range
            and _Util:HasLineOfSight(self.Entity.CurrentMap, ownerPos, targetPos)
    end

    @ExecSpace("ServerOnly")
    method Entity FindNearestMonster(Vector2 myPos)
        -- 주인의 선택을 먼저 돕고, 선택이 없으면 현재 교전을 유지한다. 자동 탐색은 주인 주변만.
        -- 44-3 D 「저 적을」: 집중 시간 안에는 그 적이 맨 먼저 (자기 감지 거리와 상관없이 쫓아간다 · 주인 시야·교전 범위+FocusExtraRange 안)
        -- 48 §1-4 순서: ① 저 적을 ② 주인이 고른 적 ③ 쌍칼 후열 사냥(TwinHuntPick) ④ 지금 교전 ⑤ 가까운 적 — 수동 조준이 늘 먼저
        if self:IsFocused(self.FocusTarget) and self:IsOwnerCombatTarget(self.FocusTarget, self:EngageRange(self.FocusTarget)) then
            self:TwinHuntYield()
            return self.FocusTarget
        end
        local attack = self.OwnerPlayer:GetComponent("script.PlayerAttack")
        if attack ~= nil then
            local preferred = attack.SelectedTarget
            if preferred == nil and _UtilLogic.ElapsedSeconds - attack.LastAttackAt < 1.2 then preferred = attack.AutoTarget end
            if self:IsOwnerCombatTarget(preferred, self.OwnerCombatRange)
                and (_Util:Pos2(preferred) - myPos):Magnitude() <= self.DetectRange
                and _Util:HasLineOfSight(self.Entity.CurrentMap, myPos, _Util:Pos2(preferred)) then
                self:TwinHuntYield()
                return preferred
            end
        end
        local hunt = self:TwinHuntPick(myPos)
        if hunt ~= nil then return hunt end
        local currentTarget = self.Target
        if self:IsOwnerCombatTarget(currentTarget, self.OwnerCombatRange)
            and (_Util:Pos2(currentTarget) - myPos):Magnitude() <= self.DetectRange then return currentTarget end
        -- 이미 동료 여럿이 붙은 적은 덜 고른다 (한 마리에 몰려 줄서지 않고 각자 근처 적에게 흩어진다)
        local engaged = {}
        for _, c in ipairs(_Util:ListOf(self.Entity.CurrentMap, "script.ShadowUnit")) do
            ---@type ShadowUnit
            local u = c
            if isvalid(c) and u ~= self and u.OwnerPlayer == self.OwnerPlayer and isvalid(u.Target) then engaged[u.Target.Id] = (engaged[u.Target.Id] or 0) + 1 end
        end
        local best = nil
        local bestScore = self.DetectRange
        -- 결투 중이면 상대 플레이어·그 소환수도 후보 (10-23 결투 군단전)
        local candidates = {}
        for _, monster in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, _Util:Pos2(self.OwnerPlayer), self.OwnerGuardRange)) do table.insert(candidates, monster.Entity) end
        for _, foe in ipairs(_Util:DuelFoesNear(self.Entity, self.Entity.CurrentMap, _Util:Pos2(self.OwnerPlayer), self.OwnerGuardRange, false)) do table.insert(candidates, foe) end
        for _, target in ipairs(candidates) do
            local d = (_Util:Pos2(target) - myPos):Magnitude()
            local score = d + 0.9 * (engaged[target.Id] or 0)
            if d <= self.DetectRange and score <= bestScore and self:IsOwnerCombatTarget(target, self.OwnerGuardRange)
                and _Util:HasLineOfSight(self.Entity.CurrentMap, myPos, _Util:Pos2(target)) then
                best = target
                bestScore = score
            end
        end
        return best
    end

    @ExecSpace("ServerOnly")
    method Entity TwinHuntPick(Vector2 myPos)
        -- 48 §1-4 쌍칼 = 후열 사냥꾼: 주인 경계 반경(OwnerGuardRange 5.5) 안 원거리 몬스터(Arch ranged · 보스 제외 · 시야)에게 먼저 파고든다 — 같은 대상에 쌍칼 twinHuntCap(2)기까지 · 가장 가까운 것.
        --   대상이 쓰러짐 · 주인 교전 범위(OwnerCombatRange 7) 밖 · twinHuntStuck(4)초 동안 닿지 못함 → 돌아온다(그 대상은 twinHuntBan초 동안 후보에서 뺀다).
        --   판단 규칙은 UndeadSystem.TwinHuntDecide(순수 · 오프라인 검사) · 여기는 엔진 값만 모은다. 쌍칼이 아니면 nil (평소 대상 고르기)
        if self.Kind ~= "skeleton" or self.Giant or self.Bombing or not _Util:IsAlive(self.OwnerPlayer) then return nil end
        local owner = self.OwnerPlayer
        if not _UndeadSystem:IsTwinHunter(owner, self.ShadowId) then return nil end
        local st = _UndeadSystem:TwinHuntState(owner, self.ShadowId)
        local map = self.Entity.CurrentMap
        local cur = nil
        if st.targetId ~= "" then
            local e = st.target
            local alive = self:IsLiveTarget(e)
            local reach = false
            if alive then
                local tp = _Util:Pos2(e)
                reach = (tp - myPos):Magnitude() <= self.AttackRange + 0.2 and _Util:HasLineOfSight(map, myPos, tp)
            end
            cur = { alive = alive, inCombat = alive and self:IsOwnerCombatTarget(e, self.OwnerCombatRange), reach = reach }
        end
        local cands = {}
        for _, m in ipairs(_Util:MonstersNear(map, _Util:Pos2(owner), self.OwnerGuardRange)) do
            if m.Arch == "ranged" and m.Grade < 3 and isvalid(m.Entity) and self:IsOwnerCombatTarget(m.Entity, self.OwnerGuardRange) then
                local tp = _Util:Pos2(m.Entity)
                if _Util:HasLineOfSight(map, myPos, tp) then
                    table.insert(cands, { id = m.Entity.Id, entity = m.Entity, dist = (tp - myPos):Magnitude(), load = _UndeadSystem:TwinHuntLoad(owner, m.Entity.Id, self.ShadowId) })
                end
            end
        end
        local had = st.targetId
        local res = _UndeadSystem:TwinHuntDecide(st, cur, cands, _UtilLogic.ElapsedSeconds)
        if not Environment:IsPublishedPlay() then
            if res.drop ~= "" then log(string.format("[VRF] twin hunt return reason=%s id=%s unit=%s", res.drop, had, self.ShadowId)) end
            if res.pick ~= nil then log(string.format("[VRF] twin hunt target=%s arch=ranged n=%d cands=%d unit=%s", res.pick.entity.Name, res.pick.load + 1, #cands, self.ShadowId)) end
        end
        if st.targetId ~= "" and self:IsLiveTarget(st.target) then return st.target end
        return nil
    end

    @ExecSpace("ServerOnly")
    method void TwinHuntYield()
        -- 수동 조준(저 적을 · 주인이 고른 적)이 먼저 — 사냥 중이던 대상을 놓는다 (금지 시간 없음)
        if self.Kind ~= "skeleton" or not isvalid(self.OwnerPlayer) then return end
        _UndeadSystem:TwinHuntClear(self.OwnerPlayer, self.ShadowId, "manual")
    end

    @ExecSpace("ServerOnly")
    method number TwinHuntSpeedMult()
        -- 사냥 대상을 쫓는 동안 이동 배율 twinHuntSpeed(1.15 · 무리 사이를 돌아 들어가는 시간을 줄인다) · 그 밖 1.
        --   OnUpdate 추격 줄에서 읽는다 (48 통합 — 대검 거인 회전 감속 0.6이 먼저)
        if self.Kind ~= "skeleton" or self.Target == nil or not isvalid(self.OwnerPlayer) then return 1 end
        if _UndeadSystem:TwinHuntTargetOf(self.OwnerPlayer, self.ShadowId) == self.Target then return _GameData.twinHuntSpeed end
        return 1
    end

    @ExecSpace("ServerOnly")
    method void MoveToward(Vector2 dir)
        -- 8방향 이동 + 좌우 바라보기 (스프라이트 기본은 왼쪽을 본다)
        local wasMoving = self.Moving
        self.Moving = true
        local go = dir:Normalize()
        if self.StuckSeconds > 0.35 then
            self.StuckSeconds = 0
            self.SidestepSide = -self.SidestepSide
            self.SidestepUntil = _UtilLogic.ElapsedSeconds + 0.4
        end
        if _UtilLogic.ElapsedSeconds < self.SidestepUntil then go = (Vector2(-go.y, go.x) * self.SidestepSide + go * 0.25):Normalize() end
        -- 10-10 4차 QA: 방향을 그 자리에서 꺾으면 화면(보간)에서도 각지게 꺾였다 → 걷던 방향에서 초당 TurnRate만큼만 튼다
        -- (서 있다가 출발하거나 거의 반대로 돌 때는 바로 그 방향으로)
        local h = self.Heading
        if not wasMoving or h:Magnitude() < 0.5 or h:Dot(go) < -0.5 then
            h = go
        else
            local cur = math.atan(h.y, h.x)
            local goal = math.atan(go.y, go.x)
            local diff = (goal - cur + math.pi) % (2 * math.pi) - math.pi
            local maxStep = self.TurnRate * math.max(0.005, math.min(0.1, self.LastDelta))
            local a = cur + math.max(-maxStep, math.min(maxStep, diff))
            h = Vector2(math.cos(a), math.sin(a))
        end
        self.Heading = h
        self.Entity.MovementComponent:MoveToDirection(h, 0)
        self.HaltSent = false
        if math.abs(dir.x) > 0.05 then self:Face(dir.x >= 0 and 1 or -1) end
        self:SetClip(self.MoveRUID)
    end

    @ExecSpace("ServerOnly")
    method void StopMove(number faceDx)
        -- 멈추고 대상 쪽을 본다
        self.Moving = false
        self.StuckSeconds = 0
        -- 멈춤은 한 번만 보낸다 (10-13: 서 있는 소환수마다 초당 20번 멈춤을 다시 보냈다)
        if not self.HaltSent then
            self.Entity.MovementComponent:MoveToDirection(Vector2(0, 0), 0)
            self.HaltSent = true
        end
        if math.abs(faceDx) > 0.05 then self:Face(faceDx >= 0 and 1 or -1) end
        self:SetClip(self.StandRUID)
    end

    @ExecSpace("ServerOnly")
    method void Face(integer dir)
        -- 방향이 바뀔 때만 쓴다 (매 프레임 같은 배율을 다시 써서 동기화가 밀리던 것 — 10-10 QA 소환수 끊김)
        local t = self.Entity.TransformComponent
        local s = t.Scale
        local want = math.abs(s.x) * -dir
        if dir == 0 or s.x == want then return end
        t.Scale = Vector3(want, s.y, s.z)
    end

    @ExecSpace("ServerOnly")
    method void SetClip(string ruid)
        -- 같은 클립을 반복 대입하지 않는다
        if ruid == "" or ruid == self.CurrentClip then return end
        -- 거인 한 번 동작(기술·피격·갈라짐) 그림이 도는 동안 일반 그림 대입만 막는다. DoAttack의 타격 예약·판정·피해는 그대로 진행한다.
        if self.GiantClipUntil > 0 and _UtilLogic.ElapsedSeconds < self.GiantClipUntil and (ruid == self.StandRUID or ruid == self.MoveRUID or ruid == self.AttackRUID) then return end
        self.CurrentClip = ruid
        self.Entity.SpriteRendererComponent.SpriteRUID = ruid
    end

    @ExecSpace("ServerOnly")
    method void DoAttack(Vector2 myPos, Vector2 toTarget)
        -- 모션을 시작하고, 실제 접촉 시점에 궤적/소리/피해를 함께 낸다.
        local target = self.Target
        if not self:IsLiveTarget(target) then return end
        self:CancelPendingAttack()
        local epoch = self.AttackEpoch
        local map = self.Entity.CurrentMap
        self.AttackAnimationUntil = _UtilLogic.ElapsedSeconds + self.AttackAnimationSeconds
        self.CommandState = "attack"
        if self.AttackRUID ~= "" then self:SetClip(self.AttackRUID) end
        self.StrikeTimer = _TimerService:SetTimerOnce(function()
            self.StrikeTimer = 0
            if not isvalid(self.Entity) or epoch ~= self.AttackEpoch or self.Dead or self.RallyTimer > 0 or not self:IsLiveTarget(target) then return end
            if self.Entity.CurrentMap ~= map or target.CurrentMap ~= map or not _Util:IsAlive(self.OwnerPlayer) or self.OwnerPlayer.CurrentMap ~= map then return end
            if not self:IsOwnerCombatTarget(target, self:EngageRange(target)) then return end
            local at = _Util:Pos2(self.Entity)
            local delta = _Util:Pos2(target) - at
            if delta:Magnitude() > self.AttackRange + 0.3 then return end
            if not _Util:HasLineOfSight(self.Entity.CurrentMap, at, _Util:Pos2(target)) then return end
            self.StrikeCount = self.StrikeCount + 1
            if self.AttackRange >= 2 then
                self:ShootBolt(_Util:Pos2(target))
            else
                local dir = delta:Magnitude() > 0.05 and delta:Normalize() or Vector2(1, 0)
                local center = at + dir * 0.4 + Vector2(0, 0.2)
                self:SwingFx(Vector3(center.x, center.y, 0), dir, math.min(2.2, self.RadiusMult))   -- 대검 해골 베기 궤적 ×1.8 (44 §4-1 B: 범위만 넓고 궤적 크기는 그대로였다)
                -- 거구 그림자: 타격 범위 +40%
                local radius = (self:GetArch() == "brute" and self.AttackRadius * 1.4 or self.AttackRadius) * self.RadiusMult
                self:AttackFast(CircleShape(center, radius), "shadow.basic", nil)
            end
        end, self.AttackWindup)
    end

    @ExecSpace("ServerOnly")
    method void ShootBolt(Vector2 aim)
        -- 원거리 한 번 (48 §2-6): 해골 마법사 = 속성 투사체(MageBolts · 캐릭터 스킬 투사체 재사용) — 영혼 격류만 n발 부채꼴 60°, 나머지 1발.
        --   마법사 거인 = 몸 속성과 무관하게 화염 구슬 1발(크게 · 자리 폭발은 BlastMult). 원거리 그림자·되살림 = 화살 1발
        local me = _Util:Pos2(self.Entity)
        local dir = aim - me
        if dir:Magnitude() < 0.05 then return end
        local school = self:BoltSchool()
        local rank = self:MageRankNow()
        local n = 1
        if school ~= "" and not self.Giant then n = math.max(1, _MageBolts:Count(school, rank)) end
        for i = 1, n do
            local spread = n > 1 and math.rad(((i - 1) / (n - 1) - 0.5) * _MageBolts.TorrentSpreadDeg) or 0
            local c, s = math.cos(spread), math.sin(spread)
            self:ShootOneBolt(Vector2(dir.x * c - dir.y * s, dir.x * s + dir.y * c))
        end
        if school ~= "" and (self.ShotCount <= n or self.ShotCount % 25 == 0) and not Environment:IsPublishedPlay() then
            log(string.format("[VRF] mage bolt school=%s element=%s rank=%d n=%d trait=%.2f giant=%s %s", school, _MageBolts:ElementOf(school), rank, n,
                self.Giant and 0 or _MageBolts:Trait(school, rank), tostring(self.Giant), self.Entity.Name))
        end
    end

    method string BoltSchool()
        -- 투사체 속성: 마법사 거인 = fire(화염 구슬) · 해골 마법사 = MageSchool(옛 기록은 Element로) · 그 밖 "" (화살)
        if self.Kind ~= "mage" then return "" end
        if self.Giant then return "fire" end
        if self.MageSchool ~= "" then return self.MageSchool end
        return _MageBolts:SchoolOfElement(self.Element)
    end

    method integer MageRankNow()
        -- 속성 특성 구간에 쓰는 마법사 랭크 (일으킬 때 확정 · 없으면 1)
        return math.max(1, self.MageRank)
    end

    @ExecSpace("ServerOnly")
    method void ShootOneBolt(Vector2 dir)
        local me = _Util:Pos2(self.Entity)
        local map = self.Entity.CurrentMap
        self.ShotCount = self.ShotCount + 1
        local shot = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "MinionBolt_" .. tostring(self.ShotCount), Vector3(me.x, me.y + 0.3, 0), map)
        if not isvalid(shot) then return end
        _Util:AfterSpawn(shot, "script.Projectile", function(proj)
            if not isvalid(self.Entity) or self.Dead or self.RallyTimer > 0 or self.Entity.CurrentMap ~= map or not _Util:IsAlive(self.OwnerPlayer) then shot:Destroy() return end
            -- 그림·색은 동기화 값으로 (서버에서 SpriteRUID를 바꾸면 클라이언트에 안 보인다)
            local school = self:BoltSchool()
            local speed = 7
            local pierce = false
            if school == "" then
                if _GameConst.FxSkillBoneArrow ~= "" then
                    -- 10-31 골편 20장: 중립 뼈 화살 4장(무채색 · 오른쪽 기준) — 속성 색은 그대로 Tint · 비행 중 FxSkillBoneArrowMs(11-01 70ms)로 장을 넘기고 왼쪽은 FlipY (Projectile.MirrorSkin)
                    proj:Skin(_GameConst.FxSkillBoneArrow, self.BoneArrowScale)
                    proj.HitKind = "bone"   -- 10-31 9계열: 명중 = 뼈 명중 2장(GameConst.FxSkillHitBone · 화살 색 Tint)
                    if not Environment:IsPublishedPlay() and (self.ShotCount <= 1 or self.ShotCount % 25 == 0) then log(string.format("[VRF] bone arrow skin n=%d scale=%.2f %s", #_Util:Frames(_GameConst.FxSkillBoneArrow), self.BoneArrowScale, self.Entity.Name)) end
                else
                    proj:Skin(_GameConst.SpriteArrow, 1.2)
                end
                proj.AngleOffset = 0
                proj:Tint(self:BoltColor())
            else
                -- 48 §2-2: 그 속성 캐릭터 스킬과 같은 그림·속도 (MageBolts.Configure 공용) · 세기는 마법사 랭크 (MageTraits)
                speed = _MageBolts:Configure(proj, school)
                if self.Giant then
                    -- 마법사 거인 화염 구슬: 저주 불꽃 그림을 크게 (48 §4-1) · 10-31 C 7종 불꽃탄 4장이 있으면 그 그림(예전 0.8배와 같은 보이는 폭)
                    if _GameConst.FxSkillFlameShot ~= "" then proj:Skin(_GameConst.FxSkillFlameShot, _MageBolts.GiantFlameArtScale)
                    else proj:Skin(_MageBolts.FxFlameShot, 0.8) end
                else
                    _MageBolts:MageTraits(proj, school, self:MageRankNow())
                    pierce = _MageBolts:Pierces(school)
                end
            end
            proj.Team = "minion"
            proj.Radius = 0.3
            proj:Launch(self.Entity, dir, speed, self.AttackRange + 0.8, self.Atk, "shadow.ranged", pierce)
        end, function() if isvalid(shot) then shot:Destroy() end end)
    end

    method Color BoltColor()
        if self.Element == "fire" then return Color(1, 0.45, 0.2, 1) end
        if self.Element == "cold" then return Color(0.45, 0.75, 1, 1) end
        if self.Element == "light" then return Color(1, 0.85, 0.4, 1) end
        if self.Element == "poison" then return Color(0.45, 0.8, 0.3, 1) end
        return Color(0.8, 0.65, 1, 1)
    end

    @ExecSpace("ServerOnly")
    method void HitOne(Entity target)
        -- 화살·구슬 한 발 적중 (배율 1 · 폭발 없음) — 옛 호출처 호환
        self:HitBolt(target, 1, 0)
    end

    @ExecSpace("ServerOnly")
    method void HitBolt(Entity target, number mul, number burst)
        -- 원거리 투사체 한 발 적중 (Projectile 소환수 갈래): 피해 = 공격 × mul (속성 한 발 배율 · 뼈 창 가시 포함).
        -- burst > 0 = 불꽃 마법사 폭발(48 §2-3 · Q9 늘 터짐): 맞은 자리 반경 burst 안 다른 적에게 한 발 피해 × MageBolts.BurstMul(0.3).
        -- 마법사 거인 평타 자리 폭발은 지금처럼 BlastMult · BlastRadius (rite_giants.csv)
        if not self:IsLiveTarget(target) then return end
        self.OnlyTarget = target
        local q = _Util:Pos2(target) + Vector2(0, 0.3)
        self.ShotMul = mul
        self.LastInfo = "shadow.ranged"   -- OnAttack이 투사체 적중을 안다 (저주 낙인 · 서리 둔화)
        self:AttackFast(CircleShape(q, 0.5), "shadow.ranged", nil)
        self.LastInfo = ""
        self.OnlyTarget = nil
        if burst > 0 and self.Kind == "mage" and not self.Giant then
            self.ShotMul = mul * _MageBolts.BurstMul
            self.BlastSkip = target
            self:AttackFast(CircleShape(q, burst), "shadow.mageburst", nil)
            self.BlastSkip = nil
            self:MageBurstFx(Vector3(q.x, q.y, 0), burst)
            if not Environment:IsPublishedPlay() then log(string.format("[VRF] mage bolt burst r=%.1f mul=%.2f %s", burst, self.ShotMul, self.Entity.Name)) end
        elseif self.BlastMult > 0 and self.Kind == "mage" then
            -- 마법사 거인: 맞은 자리 반경 BlastRadius 안 다른 적에게 × BlastMult
            self.BlastSkip = target
            self:AttackFast(CircleShape(q, self.BlastRadius), "shadow.blast", nil)
            self.BlastSkip = nil
            self:BlastPopFx(Vector3(q.x, q.y, 0), self:BoltColor())   -- 44 §3-2: 예전엔 서버에서만 불러 보이는지 알 수 없었다
        end
        self.ShotMul = 1
    end

    @ExecSpace("ServerOnly")
    method void MageSplit(Vector2 from, table hitIds, integer count)
        -- 서리 마법사 「갈라짐」(48 §2-3): 처음 맞은 자리에서 서리 파편 count개 — 4칸 안 아직 안 맞은 가까운 적부터 하나씩(캐릭터 FrostSplit과 같은 규칙 · 같은 그림),
        --   피해는 마법사 공격 × ShardMul(0.45) · 파편은 다시 갈라지지 않는다 · 맞은 적은 둔화(OnAttack)
        local map = self.Entity.CurrentMap
        local foes = {}
        for _, m in ipairs(_Util:MonstersNear(map, from, 4)) do
            if not hitIds[m.Entity.Id] and not m.IsDead then table.insert(foes, { m = m, d = (_Util:Pos2(m.Entity) - from):Magnitude() }) end
        end
        table.sort(foes, function(a, b) return a.d < b.d end)
        local seed = (self.ShotCount % 7) * 0.4
        for i = 1, count do
            local f = foes[i]
            local dir = f ~= nil and (_Util:Pos2(f.m.Entity) - from) or Vector2(math.cos(seed + i * 2 * math.pi / count), math.sin(seed + i * 2 * math.pi / count))
            if dir:Magnitude() < 0.01 then dir = Vector2(1, 0) end
            dir = dir:Normalize()
            self:ShootShard(from + dir * 0.3, dir, f ~= nil and f.m.Entity or nil, hitIds)
        end
        if not Environment:IsPublishedPlay() then log(string.format("[VRF] mage bolt split %d (targets %d) %s", count, math.min(count, #foes), self.Entity.Name)) end
    end

    @ExecSpace("ServerOnly")
    method void ShootShard(Vector2 start, Vector2 dir, Entity lock, table hitIds)
        -- 서리 파편 한 개 (MageSplit): 캐릭터 서리 파편과 같은 그림·속도(MageBolts.Configure "cold_shard") · 사거리 4.2 · 한 적에 맞고 끝
        local map = self.Entity.CurrentMap
        self.ShotCount = self.ShotCount + 1
        local shard = _SpawnService:SpawnByModelId(_GameConst.ModelProjectile, "MinionShard_" .. tostring(self.ShotCount), Vector3(start.x, start.y + 0.3, 0), map)
        if not isvalid(shard) then return end
        _Util:AfterSpawn(shard, "script.Projectile", function(comp)
            ---@type Projectile
            local proj = comp
            if not isvalid(self.Entity) or self.Dead or self.Entity.CurrentMap ~= map then shard:Destroy() return end
            local speed = _MageBolts:Configure(proj, "cold_shard")
            if isvalid(lock) then proj.Lock = lock end
            proj.MaxHits = 1
            proj.MinionMul = _MageBolts.ShardMul
            proj.Team = "minion"
            proj.Radius = 0.3
            proj:Launch(self.Entity, dir, speed, 4.2, self.Atk, "shadow.ranged", true)
            -- Launch 초기화 뒤 이전 대상 이력을 물려받아 같은 적에 다시 맞지 않게
            for id, v in pairs(hitIds) do proj.HitIds[id] = v end
        end, function() if isvalid(shard) then shard:Destroy() end end)
    end

    @ExecSpace("Multicast")
    method void MageBurstFx(Vector3 pos, number radius)
        -- 불꽃 마법사 폭발: 캐릭터 저주 불꽃 폭발과 같은 그림(GameConst.FxSkillHexBurst · 128px = 1.28칸 지름)을 반경에 맞춰 · 없으면 화염 색 파열
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        if _GameConst.FxSkillHexBurst ~= "" then
            _Util:PlayFramesHold(_GameConst.FxSkillHexBurst, me.CurrentMap, pos, 0, Vector3(2 * radius / 1.28, 2 * radius / 1.28, 1), self.MageBurstFrameSec, self.MageBurstFrameSec + self.MageBurstHoldSec, self.MageBurstFadeSec, Color(1, 1, 1, 1), 6)
        else
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos, 0, Vector3(0.55 * radius, 0.55 * radius, 1), false, { Color = Color(1, 0.5, 0.2, 1) })
        end
    end

    @ExecSpace("Multicast")
    method void BlastPopFx(Vector3 pos, Color color)
        -- 폭발 마법사: 화살이 맞은 자리 원소 색 파열 (모든 클라이언트)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or not isvalid(self.Entity) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        _ParticleService:PlayBasicParticle(BasicParticleType.SparkRadialExplosion, self.Entity, pos, 0, Vector3(self.BlastPopScale, self.BlastPopScale, 1), false, { Color = color })
    end

    @ExecSpace("ServerOnly")
    method void ClearProjectiles()
        for _, c in ipairs(self.Entity.CurrentMap:GetChildComponentsByTypeName("script.Projectile", true)) do
            if c.Owner == self.Entity and isvalid(c.Entity) then c:Finish() end
        end
    end

    @ExecSpace("Multicast")
    method void SwingFx(Vector3 pos, Vector2 dir, number scale)
        -- 소환수의 작은 궤적은 실제 접촉 방향으로 회전하며 전투 음량 한도를 공유한다. scale = 근접 범위 배율 (대검 해골 1.8 · 뼈 거인)
        local me = _UserService.LocalPlayer
        if not isvalid(me) or me.CurrentMap ~= self.Entity.CurrentMap then return end
        local right = dir.x >= 0
        local angle = math.deg(math.atan(dir.y, dir.x))
        if not right then angle = angle - 180 end
        local s = 0.25 * math.max(1, scale)
        -- 10-31 C 7종 중립 베기 4장 (Util.SkillSlashFx · 비면 예전 메이플 FxSlash)
        if not _Util:SkillSlashFx(self.Entity.CurrentMap, pos, angle, s, right, Color(0.75, 0.7, 0.8, 0.65), "summon") then
            _EffectService:PlayEffect(_GameConst.FxSlash, self.Entity, pos, angle, Vector3(s, s, 1), false, { FlipX = right, PlayRate = 1.8, Color = Color(0.75, 0.7, 0.8, 0.65) })
        end
        _SoundDirector:PlayCombat(_GameConst.SfxSwing, pos, 0.12, 0)
    end

    @ExecSpace("Multicast")
    method void BoltFx(Vector3 from, Vector3 to, string element)
        local color = Color(0.8, 0.7, 1, 1)
        if element == "fire" then color = Color(1, 0.5, 0.2, 1)
        elseif element == "cold" then color = Color(0.5, 0.8, 1, 1)
        elseif element == "light" then color = Color(1, 1, 0.5, 1)
        elseif element == "poison" then color = Color(0.5, 1, 0.4, 1) end
        for i = 1, 3 do
            local t = i / 3
            local p = Vector3(from.x + (to.x - from.x) * t, from.y + (to.y - from.y) * t, 0)
            _ParticleService:PlayBasicParticle(BasicParticleType.SparkExplosion, self.Entity, p, 0, Vector3(0.25, 0.25, 1), false, { Color = color })
        end
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- 속성 몫은 대상의 그 속성 저항만큼 줄어든다 (화염 잿불 들개 그림자는 화염 저항 몬스터에게 약하다)
        local dmg = self.Atk * self:AuraMult("dmg")
        if attackInfo == "shadow.basic" then dmg = dmg * self.BasicMult end   -- 대검 해골 범위 베기
        if attackInfo == "shadow.ranged" then dmg = dmg * self.BoltMult * self.ShotMul end   -- 마법사 속성 한 발 배율 · 뼈 창 가시 · 서리 파편 (HitBolt)
        if attackInfo == "shadow.mageburst" then dmg = dmg * self.BoltMult * self.ShotMul end   -- 불꽃 마법사 폭발 (한 발 × 0.3 · HitBolt)
        if attackInfo == "shadow.blast" then dmg = dmg * self.BoltMult * self.BlastMult end   -- 마법사 거인 자리 폭발
        -- 암살자 그림자: 25% 치명타 ×1.8 (판정은 서버 값이 쓰인다)
        if self:GetArch() == "assassin" and attackInfo == "shadow.basic" and _UtilLogic:RandomDouble() < 0.25 then
            dmg = dmg * 1.8
            if self:IsServer() then
                self.CritCount = self.CritCount + 1
                self:TraitPopLimited("crit")
            end
        elseif self:AuraAmount("crit") > 0 and _UtilLogic:RandomDouble() < self:AuraAmount("crit") / 100 then
            dmg = dmg * 1.5   -- 냉혹 오오라
        end
        -- 레벨 차이: 주인보다 높은 몬스터에게는 덜 들어간다
        ---@type Monster
        local foe = defender:GetComponent("script.Monster")
        -- 방패 몬스터는 앞에서 오는 공격을 막는다 (그림자는 옆·뒤로 돌아 치기 쉽다)
        if foe ~= nil then dmg = dmg * foe:GuardMult(self.Entity) end
        -- 대상이 받는 피해 배율 (약화의 낙인 등 저주 · 바위 집게 껍질 · 모래 망령 반투명 · 재의 왕 심장 노출·그림자 인형 보호).
        -- 10-23: 플레이어 공격(PlayerAttack.CalcDamage)만 이 배율을 썼다 — 낙인이 소환수 피해를 못 올리고, 재의 왕 인형 보호(×0.15)를 소환수가 그대로 뚫었다
        if foe ~= nil then dmg = dmg * foe:GetDamageTakenMultiplier() end
        if foe ~= nil and isvalid(self.OwnerPlayer) then
            local lv = _GameConst:LevelOf(self.OwnerPlayer)
            if lv > 0 then dmg = dmg * _GameConst:LevelGapDealt(lv, foe.Level) end
        end
        -- 군세의 신전: 주인이 축복을 받으면 소환수 피해 +30%
        if isvalid(self.OwnerPlayer) then
            ---@type PlayerStats
            local ost = self.OwnerPlayer:GetComponent("script.PlayerStats")
            if ost ~= nil then dmg = dmg * (1 + 0.3 * ost:ShrineBonus("legion")) end
        end
        if attackInfo == "shadow.skill" then
            -- 원본 변종 기술: 배율, 기술 속성이 있으면 전부 그 속성
            local v = _GameData:GetVariantOf(self.Variant, "skill")
            if v ~= nil then
                dmg = dmg * v.mult
                if v.element ~= "" then
                    ---@type Monster
                    local target = defender:GetComponent("script.Monster")
                    if target == nil then return math.max(1, math.floor(self:DuelDamage(defender, dmg, self:AttackElement(attackInfo), self:AttackElementRatio(attackInfo)) + 0.5)) end
                    dmg = dmg * math.max(0, 1 - target:GetResist(v.element) / 100)
                    local final = math.max(1, math.floor(dmg + 0.5))
                    if self:IsServer() then target:DpsTag(self.Entity, attackInfo, final) end
                    return final
                end
            end
        end
        local element = self:AttackElement(attackInfo)
        local ratio = self:AttackElementRatio(attackInfo)
        if element ~= "" and ratio > 0 then
            ---@type Monster
            local monster = defender:GetComponent("script.Monster")
            if monster ~= nil then
                local elem = dmg * ratio
                dmg = dmg - elem + elem * math.max(0, 1 - monster:GetResist(element) / 100)
            end
        end
        if foe == nil then dmg = self:DuelDamage(defender, dmg, element, ratio) end
        local final = math.max(1, math.floor(dmg + 0.5))
        if foe == nil and isvalid(defender.PlayerComponent) and self:IsServer() then
            -- 결투: 상대의 뼈 갑옷이 먼저 받는다
            ---@type PlayerStats
            local armorSt = defender:GetComponent("script.PlayerStats")
            if armorSt ~= nil then final = armorSt:AbsorbBoneArmor(final) end
        end
        -- 가시 오오라를 받은 몬스터를 평타로 때리면 그 일부가 돌아온다 (서버 · 판정이 끝난 뒤)
        if foe ~= nil and attackInfo == "shadow.basic" and self:IsServer() then
            local status = foe:Status()
            local pct = status ~= nil and status:AuraAmount("thorns") or 0
            if pct > 0 then
                local back = final * pct / 100
                _TimerService:SetTimerOnce(function() if isvalid(self.Entity) and not self.Dead then self:Hurt(back) end end, 0.05)
            end
        end
        if self:IsServer() and foe ~= nil then foe:DpsTag(self.Entity, attackInfo, final) end
        return final
    end

    method string AttackElement(string attackInfo)
        -- 이 공격의 피해 속성 (48 §4-1 · 검토 FIRE-02): 마법사 거인의 화염 구슬(shadow.ranged)·자리 폭발(shadow.blast)은 몸이 된 마법사 속성과 무관하게 fire.
        --   스냅샷(Element)은 바꾸지 않아 갈라진 뒤 원래 속성 그대로 · 그 밖의 공격은 원래 속성
        if self.Giant and self.GiantKind == "mage" and (attackInfo == "shadow.ranged" or attackInfo == "shadow.blast") then return "fire" end
        return self.Element
    end

    method number AttackElementRatio(string attackInfo)
        -- AttackElement의 속성 몫 (마법사 거인 구슬·폭발 = 전부 화염 · 그 밖 = ElementRatio)
        if self.Giant and self.GiantKind == "mage" and (attackInfo == "shadow.ranged" or attackInfo == "shadow.blast") then return 1 end
        if self.Element == "" then return 0 end
        return self.ElementRatio
    end

    method number DuelDamage(Entity defender, number dmg, string element, number ratio)
        -- 결투 상대에게: 플레이어는 물리 몫을 방어로·속성 몫을 저항으로 줄이고 PvP 배율·낙인을 곱한다. 소환수는 방패 유형·저항만 (속성·몫 = AttackElement)
        if element == "" then ratio = 0 end
        local phys = dmg * (1 - ratio)
        local elem = dmg * ratio
        if isvalid(defender.PlayerComponent) then
            ---@type PlayerStats
            local ds = defender:GetComponent("script.PlayerStats")
            if ds ~= nil then
                phys = phys * 100 / (100 + ds:GetDefense())
                if ratio > 0 then elem = elem * math.max(0, 1 - ds:GetResist(element) / 100) end
                return (phys + elem) * _GameData.pvpDamageMult * ds:PvpTakenMult()
            end
            return (phys + elem) * _GameData.pvpDamageMult
        end
        ---@type ShadowUnit
        local unit = defender:GetComponent("script.ShadowUnit")
        if unit == nil then return dmg end
        if ratio > 0 then elem = elem * math.max(0, 1 - unit:GetResist(element) / 100) end
        return (phys + elem) * unit:ArchTakenMult()
    end

    method number GetResist(string element)
        -- 장비 「소환수 모든 저항」은 합계가 저항 상한(resistCap)을 넘지 않게만 더한다 (원래 면역인 그림자는 그대로)
        local r = (self.Resists[element] or 0) + self.BonusResist + self:AuraAmount("resist") - self:AuraAmount("corrode")   -- 저항 오오라 · 적의 부식 오오라
        local gear = self:OwnerBonus("res")
        if gear <= 0 then return r end
        return math.max(r, math.min(_GameData.resistCap, r + gear))
    end

    method number OwnerBonus(string kind)
        -- 주인 장비의 소환수 공격 속도 %(ias) · 소환수 모든 저항 %(res) (docs/design/19)
        if not isvalid(self.OwnerPlayer) then return 0 end
        ---@type PlayerStats
        local stats = self.OwnerPlayer:GetComponent("script.PlayerStats")
        if stats == nil then return 0 end
        if kind == "ias" then return stats.BonusMinionIas end
        return stats.BonusMinionRes
    end

    -- ───────── 변종 능력 (원본 몬스터에게서 이어받음) ─────────

    @ExecSpace("ServerOnly")
    method void AbilityTick(number delta)
        -- 오오라: auraTickSec마다 주변 소환수(그림자·언데드)에게 / 기술: 대상이 범위 안이면 interval마다. 둘 다 이어받았으면 따로 돈다 (10-24 C안)
        if self.Variant == "" then return end
        local p = self.Entity.TransformComponent.WorldPosition
        local myPos = Vector2(p.x, p.y)
        local aura = _GameData:GetVariantOf(self.Variant, "aura")
        if aura ~= nil then
            self.AuraTimer = self.AuraTimer - delta
            if self.AuraTimer <= 0 then
                self.AuraTimer = _GameData.auraTickSec
                if aura.effect == "corrode" then
                    -- 부식(약화 오오라): 주변 몬스터의 모든 저항을 깎는다
                    for _, m in ipairs(_Util:MonstersNear(self.Entity.CurrentMap, myPos, aura.radius)) do m:ReceiveAura("corrode", aura.amount) end
                else
                    -- 플레이어도 받는다 (10-24 사용자 — 주인·파티원 등 반경 안 모든 플레이어)
                    for _, p in ipairs(_Util:PlayersNear(self.Entity.CurrentMap, myPos, aura.radius)) do
                        ---@type PlayerStats
                        local ps = p:GetComponent("script.PlayerStats")
                        if ps ~= nil then ps:ReceiveAura(aura.effect, aura.amount) end
                    end
                    for _, c in ipairs(_Util:ListOf(self.Entity.CurrentMap, "script.ShadowUnit")) do
                        -- 버프는 섞인다: 파티원·다른 플레이어의 소환수에게도 닿는다
                        ---@type ShadowUnit
                        local ally = c
                        if isvalid(c) and not ally.Dead then
                            local q = c.Entity.TransformComponent.WorldPosition
                            if (Vector2(q.x, q.y) - myPos):Magnitude() <= aura.radius then ally:ReceiveAura(aura.effect, aura.amount) end
                        end
                    end
                end
            end
        end
        local v = _GameData:GetVariantOf(self.Variant, "skill")
        if v == nil then return end
        self.AbilityTimer = self.AbilityTimer - delta
        if self.AbilityTimer > 0 then return end
        if not self:IsLiveTarget(self.Target) then
            self.AbilityTimer = 0.5
            return
        end
        local t = self.Target.TransformComponent.WorldPosition
        if (Vector2(t.x, t.y) - myPos):Magnitude() > v.radius then
            self.AbilityTimer = 0.3
            return
        end
        self.AbilityTimer = v.interval
        self.LastInfo = "shadow.skill"
        self:AttackFast(CircleShape(myPos + Vector2(0, 0.2), v.radius), "shadow.skill", nil)
        self.LastInfo = ""
        self:NovaFx(Vector3(myPos.x, myPos.y, 0), v.radius, v.element)
    end

    @ExecSpace("ServerOnly")
    method void ReceiveAura(string effect, number value)
        -- value = 효과량 (ParseVariant amount). 재생은 auraTickSec마다 한 번만 회복
        local now = _UtilLogic.ElapsedSeconds
        if now >= self.AuraUntil then self.AuraVals = {} end
        self.AuraVals[effect] = math.max(self.AuraVals[effect] or 0, value)
        self.AuraUntil = now + _GameData.auraHoldSec
        if effect == "regen" and not self.Dead and now - self.AuraRegenAt >= _GameData.auraTickSec * 0.9 then
            self.AuraRegenAt = now
            if self.Hp < self.MaxHp then self.Hp = math.min(self.MaxHp, self.Hp + self.MaxHp * value / 100 * _GameData.auraTickSec) end
        end
    end

    method number AuraAmount(string effect)
        if _UtilLogic.ElapsedSeconds >= self.AuraUntil then return 0 end
        return self.AuraVals[effect] or 0
    end

    method number AuraMult(string kind)
        -- dmg 주는 피해 / haste 공격 속도 / move 이동 속도 / guard 받는 피해
        if kind == "guard" then return math.max(0.1, 1 - self:AuraAmount("guard") / 100) end
        return 1 + self:AuraAmount(kind) / 100
    end

    @ExecSpace("Multicast")
    method void NovaFx(Vector3 pos, number radius, string element)
        local color = Color(0.75, 0.5, 1, 1)
        if element == "cold" then color = Color(0.5, 0.8, 1, 1)
        elseif element == "fire" then color = Color(1, 0.55, 0.2, 1)
        elseif element == "light" then color = Color(1, 0.95, 0.4, 1)
        elseif element == "poison" then color = Color(0.45, 0.95, 0.35, 1) end
        _Util:ElementBurst(self.Entity, pos, radius, element == "" and "shadow" or element, color)   -- 10-22: 그림자 기술은 속성 색(없으면 보라)으로 터진다
    end

    method void OnAttack(Entity defender)
        -- 주인 장비의 「소환수 독」(룬워드 「무덤의 속삭임」): 맞은 몬스터에 3초 독
        if not self:IsServer() or not isvalid(self.OwnerPlayer) then return end
        -- 거구 그림자: 맞은 적 35% 확률로 경직 (보스는 MonsterStatus.Stagger가 거른다)
        if self:GetArch() == "brute" and _UtilLogic:RandomDouble() < 0.35 then
            ---@type Monster
            local struck = defender:GetComponent("script.Monster")
            local st = struck ~= nil and not struck.IsDead and struck:Status() or nil
            -- 경직 회복 시간(InterruptReadyAt)을 같이 써서 여러 마리가 묶어 두지 못하게
            if st ~= nil and _UtilLogic.ElapsedSeconds >= st.InterruptReadyAt then
                st.InterruptReadyAt = _UtilLogic.ElapsedSeconds + 1.5
                st:Stagger()
                self.StunCount = self.StunCount + 1
                self:TraitPopLimited("stun")
            end
        end
        if self.LastInfo == "shadow.ranged" and self.Kind == "mage" and not self.Giant then
            -- 해골 마법사 속성 부가 효과 (48 §2-2): 저주 = 맞은 한 마리 4초 받는 피해 +p%(낙인과 큰 값만 · IsCursed에 안 셈 · Q10) · 서리 = 1.5초 둔화
            local school = self:BoltSchool()
            ---@type Monster
            local struckMon = defender:GetComponent("script.Monster")
            if struckMon ~= nil and not struckMon.IsDead then
                local hex = self.HexPct
                if school == "curse" then hex = math.max(hex, _MageBolts:Trait("curse", self:MageRankNow())) end
                local cst = struckMon:Status()
                if hex > 0 and cst ~= nil then cst:ApplyHex(hex, _MageBolts.CurseSeconds) end
                if school == "cold" then struckMon:ApplyChill(_MageBolts.ChillSec) end
            end
        end
        if self.LastInfo == "shadow.skill" then
            local v = _GameData:GetVariantOf(self.Variant, "skill")
            ---@type Monster
            local hit = defender:GetComponent("script.Monster")
            if v ~= nil and v.element == "cold" and hit ~= nil and not hit.IsDead then hit:ApplyChill(1.5) end
            -- 독안개 그림자: 맞은 몬스터에 4초 독 (공격력 × mult를 나눠서)
            if v ~= nil and v.kind == "cloud" and hit ~= nil and not hit.IsDead then hit:ApplyPoison(self.Atk * v.mult / 4, 4, self.OwnerPlayer) end
        end
        ---@type PlayerStats
        local stats = self.OwnerPlayer:GetComponent("script.PlayerStats")
        if stats == nil or stats.BonusMinionPoison <= 0 then return end
        ---@type Monster
        local monster = defender:GetComponent("script.Monster")
        if monster ~= nil and not monster.IsDead then monster:ApplyPoison(stats.BonusMinionPoison, 3, self.OwnerPlayer) end
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- 살아 있는 몬스터만 때린다. 결투 중이면 상대 플레이어(무적이 아닐 때)·상대 소환수도
        ---@type Monster
        local monster = defender:GetComponent("script.Monster")
        if monster == nil then
            if not _Util:IsDuelFoe(self.Entity, defender) then return false end
            if isvalid(defender.PlayerComponent) then
                ---@type PlayerVitals
                local vitals = defender:GetComponent("script.PlayerVitals")
                if vitals ~= nil and not vitals:CanBeHit() then return false end
            else
                ---@type ShadowUnit
                local unit = defender:GetComponent("script.ShadowUnit")
                if unit == nil or unit.Dead then return false end
            end
        elseif monster.IsDead then return false end
        if self.OnlyTarget ~= nil and defender ~= self.OnlyTarget then return false end
        if self.BlastSkip ~= nil and defender == self.BlastSkip then return false end
        if attackInfo == "shadow.basic" and not _Util:HasLineOfSight(self.Entity.CurrentMap, _Util:Pos2(self.Entity), _Util:Pos2(defender)) then return false end
        return __base:IsAttackTarget(defender, attackInfo)
    end

end
