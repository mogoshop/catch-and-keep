-- 혼 추출: 쓰러진 몬스터의 혼(SoulOrb)에 다가가 E 키 / 클릭 / 모바일 버튼으로 추출을 시도한다.
-- 서버가 주인·거리·확률을 판정하고, 성공하면 보관함에 넣고 ShadowExtracted 이벤트를 낸다.
@Component
script SoulExtractor extends Component

    property number NoticeAt = 0             -- 「그림자 소환을 배워야 한다」 안내를 다시 띄울 수 있는 시각 (서버)

    @ExecSpace("Server")
    method void RequestExtract(Entity soul)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or not isvalid(soul) then return end
        ---@type SoulOrb
        local orb = soul:GetComponent("script.SoulOrb")
        if orb == nil or orb.Consumed or orb.OwnerUserId ~= senderUserId then return end
        if _Util:Distance(self.Entity, soul) > _ShadowConfig:GetExtractReach() then return end
        if not self:CanExtract() then
            -- 추출은 그림자 소환을 배운 뒤부터 (그 전에는 혼을 해골·폭쇄에 쓴다). 안내는 30초에 한 번만
            if _UtilLogic.ElapsedSeconds >= self.NoticeAt then
                self.NoticeAt = _UtilLogic.ElapsedSeconds + 30
                _Util:Notify("혼 추출은 스킬 「그림자 소환」(Lv" .. tostring(_SkillData:Get("shadow_summon").row) .. ")을 배워야 한다", senderUserId)
            end
            return
        end
        local grade = orb.Grade
        local chance = self:ChanceFor(orb)
        local success = _UtilLogic:RandomDouble() < chance
        log(string.format("[VRF] extract try %s chance=%.2f success=%s", orb.SourceId, chance, tostring(success)))
        local pos = soul.TransformComponent.WorldPosition
        if success then
            ---@type ShadowOwner
            local owner = self.Entity:GetComponent("script.ShadowOwner")
            -- 레벨 = 처치한 몬스터의 본래 레벨 그대로 (Lv31 악마는 Lv31). 힘은 주인 레벨까지만 낸다 (ShadowConfig.EffectiveLevel)
            local level = orb.Level
            if owner ~= nil then owner:AddShadow(orb.SourceId, grade, level, orb.Variant, orb.StandRUID, orb.MoveRUID) end
            _GameEvents:Emit("ShadowExtracted", { player = self.Entity, sourceId = orb.SourceId, grade = grade })
            local name = _ShadowConfig:GetMonsterName(orb.SourceId)
            local v = _GameData:GetVariant(orb.Variant)
            if v ~= nil then name = name .. " · " .. v.name end
            self:PlayExtractFx(name, grade, pos, orb.StandRUID, math.floor(chance * 100 + 0.5), senderUserId)
        else
            self:PlayExtractFail(pos, math.floor(chance * 100 + 0.5), senderUserId)
        end
        orb:Consume()
    end

    method number ChanceFor(SoulOrb orb)
        -- 확률: 등급 기본(monster_ranks.csv) + 추출 숙련 + 장비, 상한 extractChanceCap. 보스도 확정이 아니다 (클라이언트 표시도 같은 식)
        -- 나보다 높은 몬스터의 혼은 레벨 차이만큼 덜 뽑힌다 (_GameConst.LevelGapExtract)
        local chance = _ShadowConfig:GetExtractChance(orb.Rank) + _GameData.extractMasteryPerLv * self:SkillLevel("extract_mastery") + self:ExtractBonus() / 100
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then chance = chance * _GameConst:LevelGapExtract(stats.Level, orb.Level) + 0.15 * stats:ShrineBonus("soul") end
        return math.min(_GameData.extractChanceCap, chance)
    end

    method boolean CanExtract()
        -- 그림자 소환을 배웠는지 (클라이언트는 SkillBook 동기화 문자열로 판단)
        return self:SkillLevel("shadow_summon") > 0
    end

    method integer SkillLevel(string id)
        ---@type SkillBook
        local book = self.Entity:GetComponent("script.SkillBook")
        if book == nil then return 0 end
        return book:GetLevel(id)
    end

    method number ExtractBonus()
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil then return 0 end
        return stats.BonusExtractPct
    end

    @ExecSpace("ClientOnly")
    method Entity FindNearestSoul(Vector2 point, number radius)
        -- 내 혼 중 point에 가장 가까운 것 (대상 고르기)
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return nil end
        local myId = self.Entity.PlayerComponent.UserId
        local best = nil
        local bestDist = radius
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.SoulOrb", true)) do
            ---@type SoulOrb
            local orb = c
            if orb.OwnerUserId == myId then
                local q = c.Entity.TransformComponent.WorldPosition
                local d = (Vector2(q.x, q.y) - point):Magnitude()
                if d < bestDist then
                    bestDist = d
                    best = c.Entity
                end
            end
        end
        return best
    end

    @ExecSpace("ClientOnly")
    method void TryExtractNearby()
        -- 손 닿는 거리의 가장 가까운 내 혼. 창이 열렸거나 사망했으면 추출하지 않는다.
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        if not self:CanExtract() then
            -- 배우기 전: 서버에 보내지 않고 화면 안내만 (서버 쪽 안내와 겹치지 않게 같은 30초 간격)
            if _UtilLogic.ElapsedSeconds >= self.NoticeAt then
                self.NoticeAt = _UtilLogic.ElapsedSeconds + 30
                _ScreenMessageLogic:PrivateMsg("혼 추출은 스킬 「그림자 소환」(Lv" .. tostring(_SkillData:Get("shadow_summon").row) .. ")을 배운 뒤에 할 수 있다")
            end
            return
        end
        local soul = self:FindNearestSoul(_Util:Pos2(self.Entity), _ShadowConfig:GetExtractReach())
        if soul == nil then
            _ScreenMessageLogic:PrivateMsg("가까운 혼이 없다")
            return
        end
        self:RequestExtract(soul)
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        if self.Entity ~= _UserService.LocalPlayer then return end
        if event.key == KeyboardKey.E then self:TryExtractNearby() end
    end

    @ExecSpace("Client")
    method void PlayExtractFx(string name, integer grade, Vector3 pos, string standRuid, integer chancePct)
        -- 성공: 혼 자리에서 「그림자 획득!」이 떠오르고, 새 그림자 초상 카드가 뜬다 (보관함 안내)
        if self.Entity ~= _UserService.LocalPlayer then return end
        _SoundDirector:PlayEffect(_GameConst.SfxSoul, 0.4)
        local gradeName = "일반"
        if grade == 2 then gradeName = "정예" elseif grade >= 3 then gradeName = "보스" end
        _HudMain:ExtractPop(Vector2(pos.x, pos.y), "그림자 획득!\n" .. name, Color(0.85, 0.72, 1, 1))
        ---@type ShadowOwner
        local owner = self.Entity:GetComponent("script.ShadowOwner")
        local count = owner ~= nil and owner.StorageCount or 0
        local icon = standRuid ~= "" and ("thumbnail://" .. standRuid) or _GameData:GetUiIcon("icon_shadow")
        local open = Environment:IsMobilePlatform() and "메뉴 → 그림자" or "H"
        _UXFeedback:Show("그림자 획득 · [" .. gradeName .. "] " .. name, "확률 " .. tostring(chancePct) .. "%에 성공 · 보관함 " .. tostring(count) .. "마리\n" .. open .. "에서 소환·강화", icon)
        _ParticleService:PlayBasicParticle(BasicParticleType.Charge, self.Entity, pos, 0, Vector3(1, 1, 1), false, nil)
    end

    @ExecSpace("Client")
    method void PlayExtractFail(Vector3 pos, integer chancePct)
        -- 실패: 혼 자리에서 회색 「추출 실패」와 확률. 혼이 흩어지는 연기
        if self.Entity ~= _UserService.LocalPlayer then return end
        _HudMain:ExtractPop(Vector2(pos.x, pos.y), "추출 실패\n확률 " .. tostring(chancePct) .. "% — 혼이 흩어졌다", Color(0.72, 0.7, 0.68, 1))
        _ParticleService:PlayBasicParticle(BasicParticleType.DustExplosion, self.Entity, pos, 0, Vector3(0.5, 0.5, 1), false, { Color = Color(0.6, 0.55, 0.7, 0.7) })
    end

end
