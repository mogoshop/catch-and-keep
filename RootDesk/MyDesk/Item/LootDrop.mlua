-- 땅에 떨어진 전리품 (골드·포션·장비·룬). 개인 전리품(D3·이모탈): 주인만 보이고 주인만 줍는다, 90초 후 사라진다.
-- 주인 없는 것(버린 물건)은 누구나 보고 잠금 시간 뒤 줍는다.
-- 줍기는 PlayerInventory가 서버에서 거리로 판정한다. 이 컴포넌트는 데이터·수명·연출만 맡는다.
@Component
script LootDrop extends Component

    @Sync
    property string OwnerUserId = ""
    @Sync
    property string Kind = ""          -- gold / hp / mp / item / rune
    @Sync
    property integer Rarity = 0
    property string ItemString = ""
    @Sync
    property string IconRUID = ""      -- 서버가 정한 바닥 아이콘 (ItemString은 클라이언트로 동기화되지 않는다)
    property integer Amount = 0
    property number DropTime = 0
    property number PublicAfter = 30
    property number LifeSeconds = 90
    property boolean Taken = false

    property number PulseTime = 0
    property boolean Dressed = false
    property number IconScale = 0.85      -- 메이플 아이콘(28~40px) 배율
    property number IconWorldSize = 0.32  -- 직접 그린 큰 아이콘의 바닥 크기 (월드 단위)
    @Sync
    property number LockedUntil = 0       -- 서버 경과 초. 이 시각까지는 아무도 못 줍는다 (버린 물건, 깜빡임)
    property number DiscardLockSeconds = 10
    property number ThumbScale = 0.4      -- 장비 외형 썸네일
    @Sync
    property number SpawnServerAt = 0     -- 떨어진 서버 시각 (드롭음은 막 떨어진 것만 — 맵에 다시 들어올 때 울리지 않게)
    @Sync
    property string Label = ""             -- 바닥 이름표 글 (10-28 F2 #15-A: PC는 Alt 누르는 동안 · 모바일은 희귀 이상만)
    property any LabelTag = nil           -- 이름표 (클라이언트 전용 자식의 NameTagComponent)
    property any Beam = nil               -- 유니크·세트 빛기둥 (클라이언트 전용 자식)
    property any Glow = nil               -- 유니크·세트 바닥 빛
    property number BeamHeight = 4.2      -- 빛기둥 높이 (월드 단위 · 화면 위까지 닿게)

    @ExecSpace("ServerOnly")
    method void Setup(string ownerUserId, string kind, string itemString, integer amount, integer rarity)
        -- LootSystem이 스폰 직후 호출 (값만 저장)
        self.OwnerUserId = ownerUserId
        self.Kind = kind
        self.ItemString = itemString
        self.Amount = amount
        self.Rarity = rarity
        self.DropTime = _UtilLogic.ElapsedSeconds
        self.SpawnServerAt = _UtilLogic.ServerElapsedSeconds
        if kind == "item" then self.IconRUID = _ItemData:IconFor(itemString)
        elseif kind == "rune" then self.IconRUID = _ItemData:IconFor(itemString) end   -- 룬마다 코덱스 그림 (없으면 공용 룬)
        if kind == "item" or kind == "rune" then self.Label = _ItemData:DisplayName(itemString)
        elseif kind == "gold" then self.Label = "골드 " .. tostring(amount) end
    end

    @ExecSpace("ClientOnly")
    method void RenderLabel(boolean mine)
        -- 바닥 이름표 (10-28 F2 #15-A): PC는 Alt를 누르는 동안 전부, 모바일은 희귀 이상 장비·룬만 늘
        local want = false
        if mine and self.Label ~= "" then
            if Environment:IsMobilePlatform() then want = self.Kind == "rune" or (self.Kind == "item" and self.Rarity >= 2)
            else want = _InputService:IsKeyPressed(KeyboardKey.LeftAlt) or _InputService:IsKeyPressed(KeyboardKey.RightAlt) end
        end
        if not want then
            if self.LabelTag ~= nil and isvalid(self.LabelTag) and self.LabelTag.Enable then self.LabelTag.Enable = false end
            return
        end
        if self.LabelTag == nil or not isvalid(self.LabelTag) then
            local e = _SpawnService:SpawnByModelId("artsprite", "LootLabel", self.Entity.TransformComponent.WorldPosition, self.Entity)
            if not isvalid(e) then return end
            e.SpriteRendererComponent.Enable = false
            if not isvalid(e.NameTagComponent) then e:AddComponent("NameTagComponent") end
            local tag = e.NameTagComponent
            if not isvalid(tag) then return end
            -- 이름표 판: 코덱스 feel-fx-v2 9조각(테두리 12) — 없으면 내 이름표 판
            local plate = _GameData:GetUiIcon("ui_loot_label")
            local me = _UserService.LocalPlayer
            if plate ~= "" then tag.NameTagRUID = plate
            elseif isvalid(me) and isvalid(me.NameTagComponent) then tag.NameTagRUID = me.NameTagComponent.NameTagRUID end
            tag.FontSize = 1
            tag.OffsetY = 0.35
            tag.Name = self.Label
            local c = Color(0.92, 0.92, 0.92, 1)
            if self.Kind == "rune" then c = Color(1, 0.65, 0.25, 1)
            elseif self.Kind == "gold" then c = Color(0.95, 0.85, 0.45, 1)
            elseif self.Rarity == 1 then c = Color(0.55, 0.65, 1, 1)
            elseif self.Rarity == 2 then c = Color(1, 0.92, 0.4, 1)
            elseif self.Rarity == 3 then c = Color(0.9, 0.7, 0.35, 1)
            elseif self.Rarity == 4 then c = Color(0.4, 0.95, 0.4, 1) end
            tag.FontColor = c
            self.LabelTag = tag
        end
        if not self.LabelTag.Enable then self.LabelTag.Enable = true end
        -- 바닥 아이콘은 그림 크기에 맞춰 아주 작게 줄인다(0.03배 등) → 자식 이름표가 같이 줄지 않게 되돌린다
        local ps = self.Entity.TransformComponent.Scale
        local t = self.LabelTag.Entity.TransformComponent
        local want = Vector3(1 / math.max(0.01, math.abs(ps.x)), 1 / math.max(0.01, math.abs(ps.y)), 1)
        if math.abs(t.Scale.x - want.x) > 0.001 or math.abs(t.Scale.y - want.y) > 0.001 then t.Scale = want end
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        _TimerService:SetTimerOnce(function()
            if isvalid(self.Entity) and not self.Taken then self.Entity:Destroy() end
        end, self.LifeSeconds)
    end

    @ExecSpace("ServerOnly")
    method void LockFor(number seconds)
        -- 버린 물건: seconds 동안 줍기 금지 (버린 사람이 바로 다시 줍지 않게, 그 뒤 파티원 누구나)
        self.LockedUntil = _UtilLogic.ServerElapsedSeconds + seconds
    end

    @ExecSpace("ServerOnly")
    method boolean CanTake(string userId)
        if self.Taken or self.Kind == "" then return false end
        if _UtilLogic.ServerElapsedSeconds < self.LockedUntil then return false end
        return self.OwnerUserId == "" or self.OwnerUserId == userId
    end

    @ExecSpace("ServerOnly")
    method void Take()
        self.Taken = true
        self.Entity:Destroy()
    end

    method Color BeamColor()
        -- 유니크 금빛 · 세트 초록 (바닥 깜빡임과 같은 계열, 조금 더 밝게)
        if self.Rarity == 4 then return Color(0.35, 1, 0.4, 1) end
        return Color(1, 0.72, 0.25, 1)
    end

    @ExecSpace("ClientOnly")
    method void MakeBeam(number parentScale)
        -- 유니크·세트가 떨어지면 하늘로 솟는 빛기둥 + 바닥 빛 (10-24 사용자: 좋은 템이 떨어져도 티가 덜 났다).
        -- 바닥 물건의 자식으로 만들어 주우면·사라지면 같이 없어진다. 부모가 작게 줄어 있어 배율을 되돌린다
        local k = 1 / math.max(0.01, parentScale)
        local beam = _SpawnService:SpawnByModelId("artsprite", "LootBeam", self.Entity.TransformComponent.WorldPosition, self.Entity)
        if isvalid(beam) then
            local sr = beam.SpriteRendererComponent
            sr.SpriteRUID = _GameData:GetUiIcon("fx_loot_beam")
            local own = self.Entity.SpriteRendererComponent
            if isvalid(own) then
                sr.SortingLayer = own.SortingLayer
                sr.OrderInLayer = own.OrderInLayer - 1
            end
            beam.TransformComponent.Position = Vector3(0, 0, 0)
            beam.TransformComponent.Scale = Vector3(0.6 * k, self.BeamHeight / 6.4 * k, 1)
            self.Beam = beam
        end
        local glow = _SpawnService:SpawnByModelId("artsprite", "LootGlow", self.Entity.TransformComponent.WorldPosition, self.Entity)
        if isvalid(glow) then
            local sr = glow.SpriteRendererComponent
            sr.SpriteRUID = _GameData:GetUiIcon("fx_loot_glow")
            local own = self.Entity.SpriteRendererComponent
            if isvalid(own) then
                sr.SortingLayer = own.SortingLayer
                sr.OrderInLayer = own.OrderInLayer - 1
            end
            glow.TransformComponent.Position = Vector3(0, 0, 0)
            glow.TransformComponent.Scale = Vector3(0.9 * k, 0.9 * k, 1)
            self.Glow = glow
        end
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- 종류별 아이콘, 장비는 등급 색으로 깜빡임 (희귀 이상은 더 크게)
        local sprite = self.Entity.SpriteRendererComponent
        if not isvalid(sprite) or self.Kind == "" then return end
        -- 남의 개인 전리품은 보이지 않는다
        local me = _UserService.LocalPlayer
        local mine = self.OwnerUserId == "" or (isvalid(me) and me.PlayerComponent.UserId == self.OwnerUserId)
        if sprite.Enable ~= mine then sprite.Enable = mine end
        self:RenderLabel(mine)
        if not mine then return end
        if not self.Dressed then
            -- 장비·룬 아이콘은 서버 값이 동기화된 뒤에 입힌다
            if (self.Kind == "item" or self.Kind == "rune") and self.IconRUID == "" then return end
            self.Dressed = true
            local ruid = _GameConst.IconItem
            local goldSize = 0
            if self.Kind == "gold" then
                -- 바닥 골드 3단 (10-28 코덱스 feel-fx-v2): 내 레벨의 평소 한 덩이(레벨×5.5+3.5, LootSystem 골드 양 가운데)와 견줘 작은·중간·큰 더미
                local amount = tonumber(string.match(self.Label, "%d+")) or 0
                local lv = 1
                ---@type PlayerStats
                local st = isvalid(me) and me:GetComponent("script.PlayerStats") or nil
                if st ~= nil then lv = st.Level end
                local ratio = amount / (lv * 5.5 + 3.5)
                local key, size = "icon_gold_pile_large", 0.56
                if ratio < 0.8 then key, size = "icon_gold_pile_small", 0.38 elseif ratio < 1.8 then key, size = "icon_gold_pile_mid", 0.46 end
                ruid = _GameData:GetUiIcon(key)
                if ruid == "" then ruid = _GameConst.IconGold else goldSize = size end
            -- 물약은 가방·벨트와 같은 코덱스 그림 (10-11 그림 감사: 바닥만 메이플 물약이었다)
            elseif self.Kind == "hp" then ruid = _GameData:GetUiIcon("potion_hp")
            elseif self.Kind == "mp" then ruid = _GameData:GetUiIcon("potion_mp")
            elseif self.Kind == "tp" then ruid = _GameData:GetUiIcon("icon_scroll")
            elseif self.Kind == "rune" or self.Kind == "item" then ruid = self.IconRUID end
            sprite.SpriteRUID = ruid
            -- 장비 외형 썸네일(thumbnail://)은 메이플 아이템 아이콘보다 몇 배 커서 바닥에서 몬스터만큼 보였다. 작게 줄인다
            -- 직접 그린 아이콘(끈 허리띠 1254px 등)은 같은 배율이면 맵을 덮었다:
            -- 원본 px을 아는 그림은 바닥 크기(IconWorldSize, 월드 단위)에 맞춰 줄인다 (100px = 1월드 단위)
            local scale = self.IconScale
            local px = _ItemData:IconPixels(ruid)
            -- 원본 크기를 아는 그림(iconPx)은 썸네일이어도 그 크기로 맞춘다 (직접 만든 후드 썸네일은 0.4배로도 몬스터만 했다)
            if px > 0 then scale = self.IconWorldSize / (px / 100)
            elseif string.sub(ruid, 1, 12) == "thumbnail://" then scale = self.ThumbScale end
            if goldSize > 0 then scale = goldSize / 0.64 end   -- 골드 더미 64px → 바닥 크기 goldSize칸
            self.Entity.TransformComponent.Scale = Vector3(scale, scale, 1)
            if self.Kind == "item" and self.Rarity >= 3 then self:MakeBeam(scale) end
            -- 드롭음 3단 (10-28 F2 A-1): 막 떨어진 것만 · 같은 순간 여러 개면 가장 높은 등급 하나 (LootSystem.PlayDropSound)
            if self.SpawnServerAt > 0 and _UtilLogic.ServerElapsedSeconds - self.SpawnServerAt < 1.5 then
                local tier = 0
                if self.Kind == "gold" then tier = 1
                elseif self.Kind == "rune" or (self.Kind == "item" and self.Rarity >= 3) then tier = 4
                elseif self.Kind == "item" and self.Rarity == 2 then tier = 3
                elseif self.Kind == "item" and self.Rarity == 1 then tier = 2 end
                if tier > 0 then _LootSystem:PlayDropSound(tier) end
            end
        end
        if self.Kind ~= "item" and self.Kind ~= "rune" then return end
        self.PulseTime = self.PulseTime + delta
        -- 버린 물건은 잠긴 동안 빠르게 깜빡인다 (아직 못 줍는다는 표시)
        if _UtilLogic.ServerElapsedSeconds < self.LockedUntil then
            local blink = math.floor(self.PulseTime * 6) % 2 == 0
            sprite.Color = Color(1, 1, 1, blink and 0.9 or 0.25)
            return
        end
        local a = 0.75 + 0.25 * math.abs(math.sin(self.PulseTime * 4))
        if self.Beam ~= nil and isvalid(self.Beam) then
            local c = self:BeamColor()
            local b = 0.55 + 0.25 * math.abs(math.sin(self.PulseTime * 2.2))
            self.Beam.SpriteRendererComponent.Color = Color(c.r, c.g, c.b, b)
            if self.Glow ~= nil and isvalid(self.Glow) then self.Glow.SpriteRendererComponent.Color = Color(c.r, c.g, c.b, b * 0.8) end
        end
        if self.Kind == "rune" then sprite.Color = Color(1, 0.6, 0.2, a)
        elseif self.Rarity == 1 then sprite.Color = Color(0.5, 0.6, 1, a)
        elseif self.Rarity == 2 then sprite.Color = Color(1, 0.9, 0.35, a)
        elseif self.Rarity == 3 then sprite.Color = Color(0.85, 0.65, 0.3, a)
        elseif self.Rarity == 4 then sprite.Color = Color(0.3, 0.9, 0.3, a)
        else sprite.Color = Color(1, 1, 1, 1) end
    end

end
