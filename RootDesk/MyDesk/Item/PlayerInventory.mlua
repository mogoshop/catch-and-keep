-- 소지품: 가방(60칸, 슬롯 방식) · 장비 10부위 · 전리품 줍기 · 장착 효과 반영. 서버 권위.
-- 아이템은 ItemData 문자열로 보관하고 클라이언트에는 요약(@Sync)으로 보낸다.
-- 물약·정수는 가방의 겹치는 물건(ItemData.IsStack). 벨트(PlayerBelt)는 가방의 물약을 높은 등급부터 마신다. 상점은 PlayerShop, 사망 시체는 PlayerCorpses.
@Component
script PlayerInventory extends Component

    property integer BagSize = 60            -- 가방 칸 (10열 × 6줄, 창에서는 3줄씩 스크롤)
    property number PickupRadius = 0.8
    property boolean ManualPickup = false    -- PC: 장비·룬은 클릭(또는 G 키)해야 줍는다
    property boolean ManualPickupLow = false -- 모바일: 일반·마법 장비만 손으로(공격 단추가 「줍기」로 바뀔 때) — 희귀 이상·룬·골드·물약은 밟으면 자동 (10-28 사용자) · 골드·물약은 그대로 자동 (10-28 F2 #15 사용자 지시)
    property Entity PendingPick = nil        -- 클릭한 전리품 (걸어가 닿으면 줍는다)
    property number PendingPickUntil = 0
    property number PickNearbyUntil = 0      -- 줍기 단추: 이 시각까지 주변(PickNearbyRadius) 장비·룬을 줍는다
    property number PickNearbyRadius = 2.2   -- 10-28: HUD 줍기 단추가 보이는 거리(2.0)보다 조금 넓게 (위치 동기화 늦음)
    property string SlotOrder = "weapon,offhand,helm,armor,gloves,boots,belt,amulet,ring1,ring2"
    property boolean AshenHoodGranted = false -- 등록한 후드: 캐릭터당 한 번 지급, 저장 데이터에 보존
    property string StarterWeapon = "scythe1|0|1|단낫||0|"

    property integer StashSize = 100         -- 창고 탭 하나의 칸 (마을 창고 곁에서만)
    property integer StashTabCount = 4       -- 창고 탭 수 (4 × 100 = 400칸 · docs/design/19 §5)
    property table Bag = {}           -- 아이템 문자열 목록
    property table StashPages = {}    -- 창고 탭별 아이템 목록 (계정 공용 — PlayerSave가 Stash 키로 따로 저장)
    property table Stash = {}         -- 지금 보고 있는 탭 (StashPages[StashTab]과 같은 표)
    @Sync
    property integer StashTab = 1
    @Sync
    property string StashDigest = ""  -- 지금 탭의 아이템만 (400칸을 한 줄로 보내지 않게)
    @Sync
    property string StashCounts = ""  -- 탭별 개수 "37,0,12,0"
    @Sync
    property integer SocketTokens = 0 -- 의뢰 보상 소켓권 (대장장이가 무료로 소켓을 뚫어 준다)
    property table Equip = {}         -- 부위 → 아이템 문자열
    @Sync
    property string BagDigest = ""
    @Sync
    property string EquipDigest = ""  -- "부위>아이템;..."
    property integer PickupTimer = 0
    property number BagWarningAt = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 새 캐릭터 기본 장비 (저장 데이터가 있으면 PlayerSave가 덮어쓴다)
        -- 새 캐릭터: 하급 생명 물약 3 · 하급 마나 물약 2 · 귀환 두루마리 2
        self.Bag = { _ItemData:MakeStack("hp1", 3), _ItemData:MakeStack("mp1", 2), _ItemData:MakeStack("tp", 2) }
        self.Equip = {}
        self:ResetStashPages()
        self.Equip["weapon"] = self.StarterWeapon
        self:EnsureAshenHoodGrant()
        self:RefreshDigest()
        _TimerService:SetTimerOnce(function() self:ApplyEquipment() end, 0.3)
        self.PickupTimer = _TimerService:SetTimerRepeat(function() self:TryPickup() end, 0.25)
    end

    @ExecSpace("ServerOnly")
    method void EnsureAshenHoodGrant()
        if self.AshenHoodGranted then return end
        -- 기존 후드를 가지고 있으면 추가 지급하지 않는다. 장착한 투구는 교체하지 않는다.
        for _, s in ipairs(self.Bag) do
            if _ItemData:Parse(s).base == "ashen_hood" then self.AshenHoodGranted = true return end
        end
        for _, page in ipairs(self.StashPages) do
            for _, s in ipairs(page) do
                if _ItemData:Parse(s).base == "ashen_hood" then self.AshenHoodGranted = true return end
            end
        end
        for _, s in pairs(self.Equip) do
            if _ItemData:Parse(s).base == "ashen_hood" then self.AshenHoodGranted = true return end
        end
        local hood = "ashen_hood|0|1|잿빛 장막 후드||0|"
        local room = nil
        for _, page in ipairs(self.StashPages) do
            if room == nil and #page < self.StashSize then room = page end
        end
        if #self.Bag < self.BagSize then
            table.insert(self.Bag, hood)
        elseif room ~= nil then
            table.insert(room, hood)
        else
            -- 두 곳 모두 가득 차면 기존 아이템을 보존하고 다음 접속에서 다시 확인한다.
            return
        end
        self.AshenHoodGranted = true
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.PickupTimer ~= 0 then _TimerService:ClearTimer(self.PickupTimer) end
    end

    method PlayerStats Stats()
        ---@type PlayerStats
        local c = self.Entity:GetComponent("script.PlayerStats")
        return c
    end

    method boolean IsOwnerRequest(string fromUserId)
        return fromUserId == self.Entity.PlayerComponent.UserId
    end

    @ExecSpace("ServerOnly")
    method void RefreshDigest()
        self.BagDigest = table.concat(self.Bag, ";")
        -- 가방의 물약 수·정수 수를 벨트·그림자 보관함 표시와 맞춘다
        ---@type PlayerBelt
        local belt = self.Entity:GetComponent("script.PlayerBelt")
        if belt ~= nil then belt:SyncCounts() end
        ---@type ShadowOwner
        local owner = self.Entity:GetComponent("script.ShadowOwner")
        if owner ~= nil then owner.Essence = self:CountStack("essence") end
        local parts = {}
        for slot in string.gmatch(self.SlotOrder, "[^,]+") do
            local s = self.Equip[slot]
            if s ~= nil then table.insert(parts, slot .. ">" .. s) end
        end
        self.EquipDigest = table.concat(parts, ";")
        self.StashDigest = table.concat(self.Stash, ";")
        local counts = {}
        for i, page in ipairs(self.StashPages) do counts[i] = tostring(#page) end
        self.StashCounts = table.concat(counts, ",")
        -- 아이템 도감: 가방·장비에 처음 들어온 유니크·세트 조각·룬워드 (불러오는 중에는 알리지 않는다)
        ---@type PlayerJournal
        local journal = self.Entity:GetComponent("script.PlayerJournal")
        if journal ~= nil then
            local held = {}
            for _, x in ipairs(self.Bag) do table.insert(held, x) end
            for _, x in pairs(self.Equip) do table.insert(held, x) end
            ---@type PlayerSave
            local save = self.Entity:GetComponent("script.PlayerSave")
            journal:NoteItems(held, save ~= nil and save.IsLoadSuccess)
        end
    end

    @ExecSpace("ServerOnly")
    method boolean AddItem(string s)
        -- 겹치는 물건은 같은 종류 칸에 먼저 쌓는다 (칸이 모자라 다 못 넣으면 false, 넣은 만큼은 남는다)
        local item = _ItemData:Parse(s)
        if _ItemData:IsStack(item.base) then return self:AddStack(item.base, item.count) == 0 end
        if #self.Bag >= self.BagSize then return false end
        table.insert(self.Bag, s)
        self:RefreshDigest()
        return true
    end

    -- ───────── 물약 소지 상한 (10-13 사용자 결정: 종류별 소지 상한, D2처럼 무제한으로 쌓이지 않게) ─────────
    --   생명(hp1~3 합)·마나(mp1~3 합)·회복(rv) 각각 potionCapBase개, 벨트를 차면 +potionCapBelt개. 귀환 두루마리는 제한 없음

    method string PotionKind(string base)
        if base == "rv" then return "rv" end
        local k = string.match(base, "^(hp)%d$") or string.match(base, "^(mp)%d$")
        return k or ""
    end

    method integer PotionCap()
        local cap = math.floor(_GameData.potionCapBase)
        if self.Equip ~= nil and self.Equip["belt"] ~= nil then cap = cap + math.floor(_GameData.potionCapBelt) end
        return cap
    end

    method integer PotionCount(string kind)
        if kind == "rv" then return self:CountStack("rv") end
        return self:CountStack(kind .. "1") + self:CountStack(kind .. "2") + self:CountStack(kind .. "3")
    end

    method integer PotionRoom(string kind)
        if kind == "" then return 999999 end
        return math.max(0, self:PotionCap() - self:PotionCount(kind))
    end

    method string PotionKindName(string kind)
        if kind == "hp" then return "생명 물약" end
        if kind == "mp" then return "마나 물약" end
        return "회복 물약"
    end

    @ExecSpace("ServerOnly")
    method void NotifyPotionCap(string kind)
        -- 상한에 막혔을 때 안내 (4초에 한 번)
        if _UtilLogic.ElapsedSeconds < self.BagWarningAt then return end
        self.BagWarningAt = _UtilLogic.ElapsedSeconds + 4
        local belt = (self.Equip ~= nil and self.Equip["belt"] ~= nil) and "" or (" · 벨트를 차면 +" .. tostring(math.floor(_GameData.potionCapBelt)))
        _Util:Notify(self:PotionKindName(kind) .. "은 " .. tostring(self:PotionCap()) .. "개까지 들 수 있습니다" .. belt, self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("ServerOnly")
    method integer AddStack(string base, integer count)
        -- base 물건 count개를 넣고 못 넣은 개수를 돌려준다. 물약은 소지 상한을 넘으면 하나도 넣지 않는다 (줍기·구매가 일부만 들어가 복제되지 않게)
        local pk = self:PotionKind(base)
        if pk ~= "" and count > self:PotionRoom(pk) then
            self:NotifyPotionCap(pk)
            return count
        end
        -- 심연 열쇠: 최대 depthKeyCap개 (넘치는 만큼은 받지 않는다)
        if base == "abyss_key" then
            local room = math.max(0, math.floor(_GameData.depthKeyCap) - self:CountStack(base))
            if count > room then
                _Util:Warn("심연 열쇠는 " .. tostring(math.floor(_GameData.depthKeyCap)) .. "개까지만 가질 수 있습니다", self.Entity.PlayerComponent.UserId)
                if room <= 0 then return count end
                return (count - room) + self:AddStack(base, room)
            end
        end
        local left = count
        local limit = _ItemData:StackLimit(base)
        for i, s in ipairs(self.Bag) do
            if left <= 0 then break end
            local item = _ItemData:Parse(s)
            if item.base == base and item.count < limit then
                local add = math.min(left, limit - item.count)
                item.count = item.count + add
                left = left - add
                self.Bag[i] = _ItemData:Serialize(item)
            end
        end
        while left > 0 and #self.Bag < self.BagSize do
            local add = math.min(left, limit)
            table.insert(self.Bag, _ItemData:MakeStack(base, add))
            left = left - add
        end
        self:RefreshDigest()
        return left
    end

    method integer CountStack(string base)
        local n = 0
        for _, s in ipairs(self.Bag) do
            if string.sub(s, 1, string.len(base) + 1) == base .. "|" then n = n + _ItemData:Parse(s).count end
        end
        return n
    end

    @ExecSpace("ServerOnly")
    method boolean TakeStack(string base, integer count)
        -- base 물건 count개를 꺼낸다 (모자라면 아무것도 꺼내지 않고 false)
        if count <= 0 then return true end
        if self:CountStack(base) < count then return false end
        local left = count
        for i = #self.Bag, 1, -1 do
            if left <= 0 then break end
            local item = _ItemData:Parse(self.Bag[i])
            if item.base == base then
                local take = math.min(left, item.count)
                item.count = item.count - take
                left = left - take
                if item.count <= 0 then table.remove(self.Bag, i) else self.Bag[i] = _ItemData:Serialize(item) end
            end
        end
        self:RefreshDigest()
        return true
    end

    @ExecSpace("Server")
    method void RequestUseItem(integer index, string expectedItem)
        -- 가방의 물약을 직접 마신다 (선택 → 「사용」)
        if not self:IsOwnerRequest(senderUserId) then return end
        if self.Bag[index] == nil or self.Bag[index] ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        local item = _ItemData:Parse(expectedItem)
        local c = _ItemData:Consumable(item.base)
        if c == nil then return end
        if c.kind == "tp" then
            ---@type PlayerTravel
            local travel = self.Entity:GetComponent("script.PlayerTravel")
            if travel ~= nil then travel:UseTownScroll() end
            return
        end
        ---@type PlayerBelt
        local belt = self.Entity:GetComponent("script.PlayerBelt")
        if belt ~= nil then belt:DrinkBase(item.base) end
    end

    @ExecSpace("ServerOnly")
    method string TakeBagItem(integer index)
        -- 가방에서 꺼낸다 (거래·판매). 없으면 ""
        local s = self.Bag[index]
        if s == nil then return "" end
        table.remove(self.Bag, index)
        self:RefreshDigest()
        return s
    end

    method string PotionOverflow(table items)
        -- 들어올 물건 중 물약이 소지 상한을 넘기면 그 종류 이름 ("" = 괜찮음). 거래 완료 전에 확인
        local add = {}
        for _, s in ipairs(items) do
            local item = _ItemData:Parse(s)
            local pk = _ItemData:IsStack(item.base) and self:PotionKind(item.base) or ""
            if pk ~= "" then add[pk] = (add[pk] or 0) + item.count end
        end
        for kind, n in pairs(add) do
            if n > self:PotionRoom(kind) then return self:PotionKindName(kind) end
        end
        return ""
    end

    @ExecSpace("ServerOnly")
    method void PutBagItems(table items)
        -- 공간과 관계없이 넣는다 (돌려받기·교환: 호출하는 쪽이 공간을 미리 확인)
        for _, s in ipairs(items) do table.insert(self.Bag, s) end
        self:RefreshDigest()
    end

    @ExecSpace("ServerOnly")
    method integer ReturnItems(table items)
        -- 거래 회수·취소로 돌아오는 물건: 가방에 자리가 있으면 가방, 넘치면 창고 빈 탭, 그래도 없으면 가방에 (잃지 않게). 창고로 간 개수를 돌려준다
        -- (10-23: 올린 사이 가방을 다시 채우면 회수 때 가방이 60칸을 넘어 61번째부터 창에 보이지 않았다)
        local stashed = 0
        for _, s in ipairs(items) do
            local room = nil
            if #self.Bag >= self.BagSize then
                for _, page in ipairs(self.StashPages) do
                    if room == nil and #page < self.StashSize then room = page end
                end
            end
            if room ~= nil then
                table.insert(room, s)
                stashed = stashed + 1
            else
                table.insert(self.Bag, s)
            end
        end
        self:RefreshDigest()
        return stashed
    end

    -- ───────── 줍기 ─────────

    @ExecSpace("ServerOnly")
    method void TryPickup()
        local pc = self.Entity.PlayerComponent
        if pc.Hp <= 0 then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local me = _Util:Pos2(self.Entity)
        local now = _UtilLogic.ElapsedSeconds
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.LootDrop", true)) do
            ---@type LootDrop
            local drop = c
            if drop:CanTake(pc.UserId) then
                local d = (_Util:Pos2(c.Entity) - me):Magnitude()
                local manual = (self.ManualPickup and (drop.Kind == "item" or drop.Kind == "rune")) or (self.ManualPickupLow and drop.Kind == "item" and drop.Rarity < 2)
                if not manual then
                    if d <= self.PickupRadius then self:Pickup(drop) end
                elseif (now < self.PickNearbyUntil and d <= self.PickNearbyRadius)
                    or (now < self.PendingPickUntil and self.PendingPick == c.Entity and d <= self.PickupRadius + 0.2) then
                    self:Pickup(drop)
                end
            end
        end
    end

    @ExecSpace("Server")
    method void RequestPickupMode(boolean manual)
        -- 클라이언트가 처음에 알린다: PC면 장비·룬은 클릭해서 줍기, 모바일이면 일반·마법 장비만 손으로 (줍기로 바뀐 공격 단추)
        if not self:IsOwnerRequest(senderUserId) then return end
        self.ManualPickup = manual
        self.ManualPickupLow = not manual
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- PC G 키: 주변 장비·룬을 한 번에 줍는다 (10-28 사용자 — HUD 「줍기」 단추 대신)
        if event.key ~= KeyboardKey.G or self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        if not Environment:IsPCPlatform() then return end
        self:RequestPickNearby()
        log("[VRF] pickup key G")
    end

    @ExecSpace("Server")
    method void RequestPick(Entity drop)
        -- 바닥 전리품 클릭: 걸어가서 닿으면 줍는다 (5초 안)
        if not self:IsOwnerRequest(senderUserId) or not isvalid(drop) then return end
        self.PendingPick = drop
        self.PendingPickUntil = _UtilLogic.ElapsedSeconds + 5
        self:TryPickup()
    end

    @ExecSpace("Server")
    method void RequestPickNearby()
        -- G 키(PC) · 줍기로 바뀐 공격 단추(모바일): 주변 PickNearbyRadius 안의 장비·룬을 한 번에
        if not self:IsOwnerRequest(senderUserId) then return end
        self.PickNearbyUntil = _UtilLogic.ElapsedSeconds + 0.6
        self:TryPickup()
    end

    @ExecSpace("ServerOnly")
    method void Pickup(LootDrop drop)
        local msg = ""
        if drop.Kind == "gold" then
            local stats = self:Stats()
            if stats ~= nil then stats:AddGold(drop.Amount) end
            msg = "골드 +" .. tostring(drop.Amount)
        elseif drop.Kind == "tp" then
            -- 귀환 두루마리는 가방 물건 (물약과 같이 겹친다)
            if self:AddStack("tp", math.max(1, drop.Amount)) > 0 then return end
            msg = "귀환 두루마리 +" .. tostring(math.max(1, drop.Amount))
        elseif drop.Kind == "hp" or drop.Kind == "mp" then
            -- 예전 방식의 물약 드롭(이미 바닥에 있던 것): 하급 물약으로 가방에
            local base = _ItemData:PotionFor(drop.Kind, 1)
            if self:AddStack(base, drop.Amount) > 0 then return end
            msg = _ItemData:StackName(base) .. " +" .. tostring(drop.Amount)
        else
            if not self:AddItem(drop.ItemString) then
                if _UtilLogic.ElapsedSeconds >= self.BagWarningAt then
                    self.BagWarningAt = _UtilLogic.ElapsedSeconds + 4
                    _Util:Notify("가방이 가득 찼습니다 — 전리품은 바닥에 남습니다", self.Entity.PlayerComponent.UserId)
                end
                return
            end
            msg = _ItemData:DisplayName(drop.ItemString)
        end
        if drop.Kind == "rune" or (drop.Kind == "item" and drop.Rarity >= 2) then
            self:NotifyTreasure(drop.ItemString, self.Entity.PlayerComponent.UserId)
        end
        _GameEvents:Emit("ItemLooted", { player = self.Entity, kind = drop.Kind, rarity = drop.Rarity, item = drop.ItemString })   -- Telemetry
        drop:Take()
        _Util:Notify(msg, self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("Client")
    method void NotifyTreasure(string item)
        -- 희귀 장비·룬이 실제 가방에 들어간 뒤 소유자에게만 알린다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        _SoundDirector:PlayEffect(_GameConst.SfxTreasure, 0.42)
        _UXFeedback:Show("전리품 획득", _ItemData:DisplayName(item) .. "\n메뉴의 인벤토리에서 장비를 확인하세요", _ItemData:IconFor(item))
    end

    -- ───────── 장착 ─────────

    @ExecSpace("Server")
    method void RequestEquip(integer index, string expectedItem)
        -- 선택한 물건이 아직 같은 칸에 있을 때만 장착한다. 네트워크 지연 중 바뀐 칸은 거부한다.
        if not self:IsOwnerRequest(senderUserId) then return end
        local s = self.Bag[index]
        if s == nil or s ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        if self:RejectPending(s, senderUserId) then return end
        local base = _ItemData:GetBase(_ItemData:Parse(s).base)
        local userId = self.Entity.PlayerComponent.UserId
        if base == nil then
            _Util:Warn("장착할 수 없는 물건", userId)
            return
        end
        local stats = self:Stats()
        if stats == nil then return end
        if stats.Level < base.reqLv then
            _Util:Warn("요구 레벨 " .. tostring(base.reqLv), userId)
            return
        end
        local slot = base.slot
        if slot == "ring" then
            slot = "ring1"
            if self.Equip["ring1"] ~= nil and self.Equip["ring2"] == nil then slot = "ring2" end
        end
        table.remove(self.Bag, index)
        local old = self.Equip[slot]
        self.Equip[slot] = s
        if old ~= nil then table.insert(self.Bag, old) end
        self:RefreshDigest()
        self:ApplyEquipment()
        self:NotifyEquipped(slot, old or "", s, userId)
    end

    @ExecSpace("Client")
    method void NotifyEquipped(string slot, string before, string after)
        -- 실제 서버 장착이 끝난 소유자에게만 이미지와 결과를 알린다.
        if self.Entity ~= _UserService.LocalPlayer then return end
        local detail = _ItemData:DisplayName(after)
        if (_ItemData:GetTotalMods(after).minion or 0) ~= 0 then
            detail = detail .. "\n소환수 강화는 다음 소환부터 적용됩니다."
        end
        _UXFeedback:ShowNow("장비 장착", detail, _ItemData:IconFor(after))
        _InventoryWindow:OnEquipped(slot, before, after)
    end

    @ExecSpace("Server")
    method void RequestUnequip(string slot, string expectedItem)
        -- 착용품과 생존 상태를 서버에서 다시 확인한 뒤 해제한다.
        if not self:IsOwnerRequest(senderUserId) then return end
        local s = self.Equip[slot]
        if s == nil or s ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        if #self.Bag >= self.BagSize then
            _Util:Warn("가방이 가득 찼습니다", senderUserId)
            return
        end
        self.Equip[slot] = nil
        table.insert(self.Bag, s)
        self:RefreshDigest()
        self:ApplyEquipment()
    end

    @ExecSpace("Server")
    method void RequestSell(integer index, string expectedItem)
        -- 판매 요청 도착 전에 거래 등으로 바뀐 물건을 판매하지 않는다.
        if not self:IsOwnerRequest(senderUserId) then return end
        if self.Bag[index] == nil or self.Bag[index] ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        if self:RejectPending(expectedItem, senderUserId) then return end
        local stats = self:Stats()
        if stats == nil then return end
        if _ItemData:IsSoulbound(_ItemData:Parse(expectedItem).base) then
            _Util:Warn("귀속 물건은 팔 수 없습니다", senderUserId)
            return
        end
        -- 잠긴 물건은 팔지 않는다 (10-29 기획서 45 결정 6-A · 글귀 승인 전)
        if _ItemData:IsLocked(expectedItem) then
            _Util:Notify("잠긴 물건은 팔 수 없습니다. 잠금을 풀어주세요", senderUserId)
            log("[VRF] lock refuse sell " .. _ItemData:Parse(expectedItem).base)
            return
        end
        -- 판매는 상인 곁에서만 (소지품 어디서나 팔리던 것을 막는다)
        if not _Util:NearNpc(self.Entity, "shop") then
            _Util:Warn("판매는 마을 상인 곁에서만 할 수 있습니다", senderUserId)
            return
        end
        local s = self:TakeBagItem(index)
        if s == "" then return end
        local value = _ItemData:SellValue(s)
        stats:AddGold(value)
        _Util:Notify("판매 +" .. tostring(value) .. " 골드", senderUserId)
    end

    @ExecSpace("Server")
    method void RequestDiscard(integer index, string expectedItem)
        -- 버리기: 확인 창을 거친 뒤 가방에서 영구 삭제. 요청 사이에 바뀐 물건은 버리지 않는다
        if not self:IsOwnerRequest(senderUserId) then return end
        if self.Bag[index] == nil or self.Bag[index] ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        if self:RejectPending(expectedItem, senderUserId) then return end
        -- 잠긴 물건은 버리지 않는다 (10-29 기획서 45 결정 6-A · 글귀 승인 전)
        if _ItemData:IsLocked(expectedItem) then
            _Util:Notify("잠긴 물건은 버릴 수 없습니다. 잠금을 풀어주세요", senderUserId)
            log("[VRF] lock refuse discard " .. _ItemData:Parse(expectedItem).base)
            return
        end
        local s = self:TakeBagItem(index)
        if s == "" then return end
        -- 귀속 물건(정수)은 떨어뜨리지 않고 파괴한다 (확인 창에서 미리 알린다)
        if _ItemData:IsSoulbound(_ItemData:Parse(s).base) then
            _Util:Notify("파괴: " .. _ItemData:DisplayName(s), senderUserId)
            return
        end
        -- 땅에 떨어뜨린다 (10초 뒤부터 누구나 주울 수 있다 — 파티원과 나누기)
        _LootSystem:DropDiscarded(self.Entity, s)
        _Util:Notify("버림: " .. _ItemData:Parse(s).name .. " (10초 뒤 누구나 주울 수 있습니다)", senderUserId)
    end

    @ExecSpace("Server")
    method void RequestSocket(integer runeIndex, string slot, string expectedRune, string expectedGear)
        -- 선택한 룬과 장비가 서버에도 그대로 있을 때만 소모한다 (되돌릴 수 없음).
        if not self:IsOwnerRequest(senderUserId) then return end
        if self.Bag[runeIndex] == nil or self.Equip[slot] == nil or self.Bag[runeIndex] ~= expectedRune or self.Equip[slot] ~= expectedGear or not _Util:IsAlive(self.Entity) then return end
        self:SocketRune(runeIndex, slot)
    end

    @ExecSpace("ServerOnly")
    method boolean SocketRune(integer runeIndex, string slot)
        -- 룬 데이터와 빈 소켓을 검증한 뒤 두 물건을 한 번의 서버 작업으로 바꾼다.
        local userId = self.Entity.PlayerComponent.UserId
        local r = self.Bag[runeIndex]
        local s = self.Equip[slot]
        if r == nil or s == nil or not _ItemData:IsRune(r) or _ItemData:GetRune(_ItemData:Parse(r).base) == nil then return false end
        local item = _ItemData:Parse(s)
        if #item.runes >= item.sockets then
            _Util:Warn("빈 소켓이 없습니다", userId)
            return false
        end
        table.insert(item.runes, _ItemData:Parse(r).base)
        self.Equip[slot] = _ItemData:Serialize(item)
        table.remove(self.Bag, runeIndex)
        self:RefreshDigest()
        self:ApplyEquipment()
        _Util:Notify(_ItemData:DisplayName(self.Equip[slot]), userId)
        return true
    end

    @ExecSpace("ServerOnly")
    method table StripEquipment()
        -- 사망: 착용 장비를 모두 벗겨 { {slot, s}, ... } 로 돌려준다
        local items = {}
        for slot, s in pairs(self.Equip) do table.insert(items, { slot = slot, s = s }) end
        self.Equip = {}
        self:RefreshDigest()
        self:ApplyEquipment()
        return items
    end

    @ExecSpace("ServerOnly")
    method void RestoreEquipment(table items)
        -- 시체 회수: 빈 부위는 다시 장착, 이미 다른 장비가 있으면 가방으로
        for _, it in ipairs(items) do
            if self.Equip[it.slot] == nil then self.Equip[it.slot] = it.s else table.insert(self.Bag, it.s) end
        end
        self:RefreshDigest()
        self:ApplyEquipment()
    end

    @ExecSpace("ServerOnly")
    method void ApplyEquipment()
        -- 장비 옵션 합계 → PlayerStats (생명·마나·이동 속도·저항까지 다시 계산)
        local stats = self:Stats()
        if stats == nil then return end
        local t = {}
        local setCounts = {}
        for _, s in pairs(self.Equip) do
            for k, v in pairs(_ItemData:GetTotalMods(s)) do t[k] = (t[k] or 0) + v end
            local piece = _ItemData:GetSetPiece(_ItemData:Parse(s))
            if piece ~= nil then setCounts[piece.set] = (setCounts[piece.set] or 0) + 1 end
        end
        -- 세트 효과 (2개·3개·전체). 세트의 그림자 상한은 겹치지 않는다 — 가장 높은 하나만 (docs/design/19 §5)
        local setCap = 0
        for setId, count in pairs(setCounts) do
            for k, v in pairs(_ItemData:GetSetBonusMods(setId, count)) do
                if k == "shadowCap" then setCap = math.max(setCap, v) else t[k] = (t[k] or 0) + v end
            end
        end
        if setCap > 0 then t["shadowCap"] = (t["shadowCap"] or 0) + setCap end
        stats:ApplyEquipmentMods(t)
        self:ApplyAppearance()
    end

    @ExecSpace("ServerOnly")
    method string EquippedAvatar(string slot)
        local item = self.Equip[slot]
        if item == nil then return "" end
        local base = _ItemData:GetBase(_ItemData:Parse(item).base)
        if base == nil then return "" end
        return base.avatar or ""
    end

    @ExecSpace("ServerOnly")
    method void ApplyAppearance()
        local costume = self.Entity.CostumeManagerComponent
        if not isvalid(costume) then return end
        -- 월드 기본 외형을 서버에서 지정해 재접속·장비 변경 후에도 유지한다.
        costume:SetEquip(MapleAvatarItemCategory.Body, _GameData:GetPlayerAppearance("body"))
        -- 머리·얼굴은 캐릭터마다 고른 외형 (캐릭터 만들기 · PlayerSave 슬롯 look, 예전 캐릭터는 기본 = 남·검은 머리·보라 눈)
        ---@type PlayerSave
        local save = self.Entity:GetComponent("script.PlayerSave")
        local look = _GameData:ParseLook(save ~= nil and save:Look() or "")
        costume:SetEquip(MapleAvatarItemCategory.Hair, look.hair)
        costume:SetEquip(MapleAvatarItemCategory.Face, look.face)
        costume:SetEquip(MapleAvatarItemCategory.Ear, _GameData:GetPlayerAppearance("ear"))
        costume.UseCustomEquipOnly = true
        -- 로브 없이도 기본 복장은 유지한다. 미장착 무기는 계정 무기로 되돌리지 않는다.
        local parts = _ItemData:AppearanceParts(self.Equip, "")
        costume:SetEquip(MapleAvatarItemCategory.Coat, "")
        costume:SetEquip(MapleAvatarItemCategory.Pants, "")
        costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
        costume:SetEquip(MapleAvatarItemCategory.SubWeapon, "")
        costume:SetEquip(MapleAvatarItemCategory.Cape, "")
        costume:SetEquip(MapleAvatarItemCategory.FaceAccessory, "")
        costume:SetEquip(MapleAvatarItemCategory.EyeAccessory, "")
        costume:SetEquip(MapleAvatarItemCategory.EarAccessory, "")
        costume:SetEquip(MapleAvatarItemCategory.Longcoat, parts.armor)
        costume:SetEquip(MapleAvatarItemCategory.Cap, parts.helm)
        costume:SetEquip(MapleAvatarItemCategory.Glove, parts.gloves)
        costume:SetEquip(MapleAvatarItemCategory.Shoes, parts.boots)
        costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, parts.weapon)
    end

    -- ───────── 클라이언트 표시용 ─────────

    method table GetBagList()
        local list = {}
        if self.BagDigest == "" then return list end
        for s in string.gmatch(self.BagDigest .. ";", "([^;]*);") do table.insert(list, s) end
        return list
    end

    method table GetEquipMap()
        local map = {}
        for slot, s in string.gmatch(self.EquipDigest, "([%w]+)>([^;]*)") do map[slot] = s end
        return map
    end

    -- ───────── 정렬 · 여러 개 판매 ─────────

    @ExecSpace("Server")
    method void RequestSortBag()
        -- 등급순 정렬: 유니크 · 세트 · 레어 · 마법 · 일반 · 룬 · 물약 · 귀속 재료 (같은 등급은 이름순)
        if not self:IsOwnerRequest(senderUserId) then return end
        table.sort(self.Bag, function(a, b)
            local ra, rb = _ItemData:SortRank(a), _ItemData:SortRank(b)
            if ra ~= rb then return ra < rb end
            local na, nb = _ItemData:Parse(a).name, _ItemData:Parse(b).name
            if na ~= nb then return na < nb end
            return a < b
        end)
        self:RefreshDigest()
    end

    method table ParsePicks(string list)
        -- "칸번호\t아이템\n..." → { {index, item}, ... } (큰 칸부터 — 앞에서 빼도 뒤 칸 번호가 흔들리지 않게)
        local out = {}
        for line in string.gmatch(list, "[^\n]+") do
            local idx, item = string.match(line, "^(%d+)\t(.+)$")
            if idx ~= nil then table.insert(out, { index = tonumber(idx), item = item }) end
        end
        table.sort(out, function(a, b) return a.index > b.index end)
        return out
    end

    @ExecSpace("Server")
    method void RequestSellMany(string list)
        -- 상인 곁에서 고른 여러 개를 한꺼번에 판다 (요청 사이에 바뀐 칸·귀속 물건은 건너뛴다)
        if not self:IsOwnerRequest(senderUserId) or not _Util:IsAlive(self.Entity) then return end
        local stats = self:Stats()
        if stats == nil then return end
        if not _Util:NearNpc(self.Entity, "shop") then
            _Util:Warn("판매는 마을 상인 곁에서만 할 수 있습니다", senderUserId)
            return
        end
        local total, n, locked = 0, 0, 0
        for _, p in ipairs(self:ParsePicks(list)) do
            local cur = self.Bag[p.index]
            if cur ~= nil and cur == p.item and (_ItemData:IsLocked(cur) or _ItemData:HasPendingReroll(cur)) then locked = locked + 1
            elseif cur ~= nil and cur == p.item and not _ItemData:IsSoulbound(_ItemData:Parse(cur).base) then
                total = total + _ItemData:SellValue(cur)
                table.remove(self.Bag, p.index)
                n = n + 1
            end
        end
        -- 잠긴 물건은 건너뛴다 (10-29 기획서 45 결정 6-A · 글귀 승인 전)
        if locked > 0 then _Util:Notify("잠긴 물건·옵션을 고르는 중인 물건 " .. tostring(locked) .. "개는 팔지 않았습니다", senderUserId) end
        if n == 0 then return end
        self:RefreshDigest()
        stats:AddGold(total)
        _Util:Notify("판매 " .. tostring(n) .. "개 · +" .. tostring(total) .. " 골드", senderUserId)
    end

    @ExecSpace("Server")
    method void RequestDiscardMany(string list)
        -- 상인이 없는 곳에서 여러 개 버리기 (땅에 떨어뜨림, 귀속 물건은 건너뛴다)
        if not self:IsOwnerRequest(senderUserId) or not _Util:IsAlive(self.Entity) then return end
        local n, locked = 0, 0
        for _, p in ipairs(self:ParsePicks(list)) do
            local cur = self.Bag[p.index]
            if cur ~= nil and cur == p.item and (_ItemData:IsLocked(cur) or _ItemData:HasPendingReroll(cur)) then locked = locked + 1
            elseif cur ~= nil and cur == p.item and not _ItemData:IsSoulbound(_ItemData:Parse(cur).base) then
                table.remove(self.Bag, p.index)
                _LootSystem:DropDiscarded(self.Entity, cur)
                n = n + 1
            end
        end
        -- 잠긴 물건은 건너뛴다 (10-29 기획서 45 결정 6-A · 글귀 승인 전)
        if locked > 0 then _Util:Notify("잠긴 물건·옵션을 고르는 중인 물건 " .. tostring(locked) .. "개는 버리지 않았습니다", senderUserId) end
        if n == 0 then return end
        self:RefreshDigest()
        _Util:Notify("버림 " .. tostring(n) .. "개 (10초 뒤 누구나 주울 수 있습니다)", senderUserId)
    end

    -- ───────── 잠금 (10-29 기획서 45 결정 6-A · 즐겨찾기) ─────────
    -- 잠긴 물건은 팔기·버리기·거래에서 빠진다. 잠금은 물건 문자열에 붙어(ItemData 9번째 칸) 창고·장착·정렬을 따라다닌다

    @ExecSpace("Server")
    method void RequestLockBag(integer index, string expectedItem, boolean locked)
        -- 가방 칸의 물건을 잠그거나 푼다 (누를 때 보이던 물건이 그대로 있을 때만)
        if not self:IsOwnerRequest(senderUserId) then return end
        local cur = self.Bag[index]
        if cur == nil or cur ~= expectedItem or not _ItemData:CanLock(cur) then return end
        if _ItemData:IsLocked(cur) == locked then return end
        if self:RejectPending(cur, senderUserId) then return end
        self.Bag[index] = _ItemData:WithLock(cur, locked)
        self:RefreshDigest()
        _Util:Notify((locked and "잠금: " or "잠금 해제: ") .. _ItemData:DisplayName(cur), senderUserId)
        log("[VRF] lock bag index=" .. tostring(index) .. " locked=" .. tostring(locked))
    end

    @ExecSpace("Server")
    method void RequestLockEquip(string slot, string expectedItem, boolean locked)
        -- 착용 중인 물건을 잠그거나 푼다 (벗으면 가방에서도 잠긴 채)
        if not self:IsOwnerRequest(senderUserId) then return end
        local cur = self.Equip[slot]
        if cur == nil or cur ~= expectedItem or not _ItemData:CanLock(cur) then return end
        if _ItemData:IsLocked(cur) == locked then return end
        self.Equip[slot] = _ItemData:WithLock(cur, locked)
        self:RefreshDigest()
        _Util:Notify((locked and "잠금: " or "잠금 해제: ") .. _ItemData:DisplayName(cur), senderUserId)
        log("[VRF] lock equip slot=" .. slot .. " locked=" .. tostring(locked))
    end

    -- ───────── 창고 (마을 창고 곁) ─────────

    @ExecSpace("Server")
    method void RequestDeposit(integer index, string expectedItem)
        if not self:IsOwnerRequest(senderUserId) or not _Util:NearNpc(self.Entity, "stash") then return end
        local cur = self.Bag[index]
        if cur == nil or cur ~= expectedItem then return end
        if self:RejectPending(cur, senderUserId) then return end
        if #self.Stash >= self.StashSize then
            _Util:Warn("창고 " .. tostring(self.StashTab) .. "탭이 가득 찼습니다 — 다른 탭을 고르세요", senderUserId)
            return
        end
        table.remove(self.Bag, index)
        table.insert(self.Stash, cur)
        self:RefreshDigest()
    end

    @ExecSpace("Server")
    method void RequestWithdraw(integer index, string expectedItem)
        if not self:IsOwnerRequest(senderUserId) or not _Util:NearNpc(self.Entity, "stash") then return end
        local cur = self.Stash[index]
        if cur == nil or cur ~= expectedItem then return end
        local item = _ItemData:Parse(cur)
        local pk = _ItemData:IsStack(item.base) and self:PotionKind(item.base) or ""
        if pk ~= "" then
            -- 물약은 소지 상한까지만 꺼내고 나머지는 창고에 남긴다
            local take = math.min(item.count, self:PotionRoom(pk))
            if take <= 0 then
                self:NotifyPotionCap(pk)
                return
            end
            if self:AddStack(item.base, take) > 0 then
                _Util:Warn("가방이 가득 찼습니다", senderUserId)
                return
            end
            if take >= item.count then table.remove(self.Stash, index) else
                item.count = item.count - take
                self.Stash[index] = _ItemData:Serialize(item)
            end
            self:RefreshDigest()
            return
        end
        if #self.Bag >= self.BagSize then
            _Util:Warn("가방이 가득 찼습니다", senderUserId)
            return
        end
        table.remove(self.Stash, index)
        table.insert(self.Bag, cur)
        self:RefreshDigest()
    end

    method boolean MatchesKind(string s, string kind)
        -- 창고 「한꺼번에 넣기」 분류: normal 일반 · magic 마법 · rare 레어 · unique 유니크·세트 · rune 룬
        local item = _ItemData:Parse(s)
        if kind == "rune" then return _ItemData:IsRune(item.base) end
        if _ItemData:IsRune(item.base) or _ItemData:IsStack(item.base) or _ItemData:GetBase(item.base) == nil then return false end
        if kind == "normal" then return item.rarity == 0 end
        if kind == "magic" then return item.rarity == 1 end
        if kind == "rare" then return item.rarity == 2 end
        if kind == "unique" then return item.rarity == 3 or item.rarity == 4 end
        return false
    end

    @ExecSpace("Server")
    method void RequestDepositKind(string kind)
        -- 가방의 그 등급 물건을 창고에 한꺼번에 (창고가 차면 거기서 멈춘다)
        if not self:IsOwnerRequest(senderUserId) or not _Util:NearNpc(self.Entity, "stash") then return end
        local n = 0
        local i = 1
        while i <= #self.Bag do
            if #self.Stash >= self.StashSize then break end
            if self:MatchesKind(self.Bag[i], kind) and not _ItemData:HasPendingReroll(self.Bag[i]) then
                table.insert(self.Stash, table.remove(self.Bag, i))
                n = n + 1
            else
                i = i + 1
            end
        end
        self:RefreshDigest()
        local names = { normal = "일반", magic = "마법", rare = "레어", unique = "유니크·세트", rune = "룬" }
        if n == 0 then _Util:Warn("가방에 넣을 " .. (names[kind] or "") .. " 물건이 없습니다", senderUserId)
        else _Util:Notify("창고 " .. tostring(self.StashTab) .. "탭에 " .. (names[kind] or "") .. " " .. tostring(n) .. "개를 넣었습니다" .. (#self.Stash >= self.StashSize and " (이 탭 가득)" or ""), senderUserId) end
    end

    -- ───────── 대장장이 (마을 대장장이 곁) ─────────

    @ExecSpace("Server")
    method void RequestReroll(integer index, string expectedItem)
        -- 마법·레어 장비의 옵션을 골드로 새로 굴린다
        if not self:IsOwnerRequest(senderUserId) or not _Util:NearNpc(self.Entity, "smith") then return end
        local cur = self.Bag[index]
        local stats = self:Stats()
        if cur == nil or cur ~= expectedItem or stats == nil or not _ItemData:CanReroll(cur) then return end
        local cost = _ItemData:RerollCost(cur)
        if stats.Gold < cost then
            _Util:Warn("골드가 부족합니다 (" .. tostring(cost) .. " 필요)", senderUserId)
            return
        end
        stats:AddGold(-cost)
        local after = _ItemData:RerollMods(cur)
        self.Bag[index] = after
        self:RefreshDigest()
        self:NotifySmith("옵션을 새로 새겼습니다", _ItemData:DescribeDetailed(after), _ItemData:IconFor(after), senderUserId)
    end

    @ExecSpace("Server")
    method void RequestPunch(integer index, string expectedItem, boolean useToken)
        -- 소켓 뚫기: 의뢰 소켓권이면 확실히, 골드면 50% (실패해도 골드는 사라진다)
        if not self:IsOwnerRequest(senderUserId) or not _Util:NearNpc(self.Entity, "smith") then return end
        local cur = self.Bag[index]
        local stats = self:Stats()
        if cur == nil or cur ~= expectedItem or stats == nil or not _ItemData:CanPunch(cur) then return end
        if useToken then
            if self.SocketTokens <= 0 then return end
            self.SocketTokens = self.SocketTokens - 1
        else
            local cost = _ItemData:PunchCost(cur)
            if stats.Gold < cost then
                _Util:Warn("골드가 부족합니다 (" .. tostring(cost) .. " 필요)", senderUserId)
                return
            end
            stats:AddGold(-cost)
            if _UtilLogic:RandomDouble() >= _GameData.punchChance then
                self:NotifySmith("소켓 뚫기 실패", "망치질이 빗나갔습니다. 장비는 그대로입니다 (골드 " .. tostring(cost) .. " 소모)", _ItemData:IconFor(cur), senderUserId)
                return
            end
        end
        local after = _ItemData:PunchSockets(cur)
        self.Bag[index] = after
        self:RefreshDigest()
        self:NotifySmith("소켓 " .. tostring(_ItemData:Parse(after).sockets) .. "개를 뚫었습니다", _ItemData:DisplayName(after) .. "\n이제 룬을 끼울 수 있습니다 (룬워드 조합은 메뉴 「룬워드」)", _ItemData:IconFor(after), senderUserId)
    end

    -- ───────── 한 줄 바꾸기 · 부분 재련 (10-30 I01 · goal-items-execution-0030 I01_single_affix_reroll) ─────────
    -- 요청은 소유자 + 가방 칸 + 그 칸의 아이템 문자열 전체(출처 칸 rev 포함)에 묶는다: 같은 요청이 두 번 와도 첫 요청 뒤 rev가 바뀌어 두 번째는 무시된다.
    -- 시도 값은 후보를 만든 뒤 한 번에 받는다 (후보가 없으면 받지 않는다). 결과(기존/새)는 물건 문자열에 대기로 남아 닫기·저장·재접속을 견딘다.

    method boolean RejectPending(string s, string forUserId)
        -- 부분 재련 결과를 아직 고르지 않은 물건이면 다른 작업을 막고 알린다
        if not _ItemData:HasPendingReroll(s) then return false end
        _Util:Warn("새 옵션 채택·기존 유지를 먼저 골라 주세요", forUserId)
        log("[VRF] partial pending blocks other op")
        return true
    end

    @ExecSpace("Server")
    method void RequestPartialReroll(integer index, string expectedItem, integer line)
        -- 대장장이 곁에서 마법·레어 장비의 옵션 한 줄만 다시 새긴다 (첫 시도에 그 줄이 고정된다)
        if not self:IsOwnerRequest(senderUserId) or not _Util:NearNpc(self.Entity, "smith") or not _Util:IsAlive(self.Entity) then return end
        local cur = self.Bag[index]
        local stats = self:Stats()
        if cur == nil or cur ~= expectedItem or stats == nil then
            log("[VRF] partial reject stale index=" .. tostring(index))
            return
        end
        if _ItemData:HasPendingReroll(cur) then return end
        local cost = _ItemData:PartialRerollCost(cur)
        if stats.Gold < cost then
            _Util:Warn("골드가 부족합니다 (" .. tostring(cost) .. " 필요)", senderUserId)
            return
        end
        local after = _ItemData:RollPartial(cur, line)
        if after == "" then
            _Util:Warn("이 줄은 바꿀 수 있는 옵션이 없습니다. 골드는 쓰지 않았습니다", senderUserId)
            log("[VRF] partial reject no-candidate line=" .. tostring(line))
            return
        end
        stats:AddGold(-cost)
        self.Bag[index] = after
        self:RefreshDigest()
        self:NotifySmith("새 옵션 후보가 나왔습니다", "새 옵션 채택 또는 기존 유지를 골라 주세요", _ItemData:IconFor(after), senderUserId)
        log("[VRF] partial roll line=" .. tostring(line) .. " cost=" .. tostring(cost) .. " meta=" .. _ItemData:Parse(after).meta)
    end

    @ExecSpace("Server")
    method void RequestResolvePartial(integer index, string expectedItem, boolean accept)
        -- 대기 중 후보를 채택하거나 기존 옵션을 남긴다 (골드를 더 받지 않는다 · 어디서나 · 고정 줄은 그대로)
        if not self:IsOwnerRequest(senderUserId) or not _Util:IsAlive(self.Entity) then return end
        local cur = self.Bag[index]
        if cur == nil or cur ~= expectedItem then
            log("[VRF] partial resolve reject stale index=" .. tostring(index))
            return
        end
        local after = _ItemData:ResolvePartial(cur, accept)
        if after == "" then return end
        self.Bag[index] = after
        self:RefreshDigest()
        local title = "기존 옵션을 남겼습니다"
        if accept then title = "새 옵션을 새겼습니다" end
        self:NotifySmith(title, _ItemData:DescribeDetailed(after), _ItemData:IconFor(after), senderUserId)
        log("[VRF] partial resolve accept=" .. tostring(accept) .. " meta=" .. _ItemData:Parse(after).meta)
    end

    @ExecSpace("Client")
    method void NotifySmith(string title, string detail, string icon)
        if self.Entity ~= _UserService.LocalPlayer then return end
        _UXFeedback:ShowNow(title, detail, icon)
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method void ResetStashPages()
        self.StashPages = {}
        for i = 1, self.StashTabCount do self.StashPages[i] = {} end
        self.StashTab = 1
        self.Stash = self.StashPages[1]
    end

    @ExecSpace("ServerOnly")
    method table GetStashData()
        -- 계정 공용 창고 (PlayerSave가 Stash 키로 저장 — 캐릭터를 바꿔도 같은 창고). 탭 1~4를 이어 붙인 목록, 탭별 개수는 GetStashCounts
        local list = {}
        for _, page in ipairs(self.StashPages) do
            for _, x in ipairs(page) do table.insert(list, x) end
        end
        return list
    end

    @ExecSpace("ServerOnly")
    method table GetStashCounts()
        local counts = {}
        for i, page in ipairs(self.StashPages) do counts[i] = #page end
        return counts
    end

    @ExecSpace("ServerOnly")
    method void LoadStash(table items, table counts)
        -- counts(탭별 개수)가 목록과 맞으면 그대로 나누고, 예전 저장(한 줄 100칸)이면 앞 탭부터 100개씩 채운다
        self:ResetStashPages()
        local kept = {}
        for _, s in ipairs(items or {}) do if not self:IsRetiredItem(s) then table.insert(kept, s) end end
        if #kept ~= #(items or {}) then counts = nil end
        items = kept
        local total = 0
        for _, c in ipairs(counts or {}) do total = total + (tonumber(c) or 0) end
        local index = 1
        if counts ~= nil and #counts > 0 and total == #items then
            for tab = 1, self.StashTabCount do
                for _ = 1, tonumber(counts[tab]) or 0 do
                    table.insert(self.StashPages[tab], items[index])
                    index = index + 1
                end
            end
        end
        -- 남은 것(예전 저장 · 개수가 안 맞는 저장)은 빈 칸이 있는 탭에 차례로. 넘치면 마지막 탭에 둬서 잃지 않는다
        local tab = 1
        while index <= #items do
            while tab < self.StashTabCount and #self.StashPages[tab] >= self.StashSize do tab = tab + 1 end
            table.insert(self.StashPages[tab], items[index])
            index = index + 1
        end
        self:RefreshDigest()
        -- 창고에 있는 유니크·세트·룬워드도 도감에 (조용히)
        ---@type PlayerJournal
        local journal = self.Entity:GetComponent("script.PlayerJournal")
        if journal ~= nil then journal:NoteItems(items, false) end
    end

    @ExecSpace("Server")
    method void RequestStashTab(integer tab)
        -- 창고 탭 바꾸기 (보기만 바뀐다. 넣기·꺼내기·한꺼번에 넣기는 지금 탭에)
        if not self:IsOwnerRequest(senderUserId) then return end
        if tab < 1 or tab > self.StashTabCount then return end
        self.StashTab = tab
        self.Stash = self.StashPages[tab]
        self:RefreshDigest()
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        local bag = {}
        for i, s in ipairs(self.Bag) do bag[i] = s end
        -- 거래창에 올려 둔 물건도 가방에 있는 것으로 저장 (접속 종료 순서와 관계없이 잃지 않게)
        ---@type PlayerTrade
        local trade = self.Entity:GetComponent("script.PlayerTrade")
        if trade ~= nil then for _, s in ipairs(trade.Escrow) do table.insert(bag, s) end end
        local equip = {}
        for slot, s in pairs(self.Equip) do equip[slot] = s end
        -- 빈 Lua 표는 JSON 타입이 불명확하므로 개수만 저장한다. 기존 배열 저장도 계속 읽는다.
        local saved = { bagCount = #bag, equipCount = 0 }
        for _ in pairs(equip) do saved.equipCount = saved.equipCount + 1 end
        if #bag > 0 then saved.bag = bag end
        if saved.equipCount > 0 then saved.equip = equip end
        -- 창고는 계정 공용 — 캐릭터 저장이 아니라 PlayerSave의 Stash 키 (GetStashData)
        saved.ashenHoodGranted = self.AshenHoodGranted
        saved.socketTokens = self.SocketTokens
        return saved
    end

    method boolean IsRetiredItem(string s)
        -- 없앤 물건: 예전 결투 승리 「귀」(10-13 제거). 불러올 때 버린다
        return type(s) == "string" and string.sub(s, 1, 4) == "ear|"
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table data)
        if data == nil then return end
        self.Bag = {}
        self.Equip = {}
        if data.bag ~= nil then for _, s in ipairs(data.bag) do if not self:IsRetiredItem(s) then table.insert(self.Bag, s) end end end
        if data.equip ~= nil then for slot, s in pairs(data.equip) do self.Equip[slot] = s end end
        self.SocketTokens = tonumber(data.socketTokens) or 0
        self.AshenHoodGranted = data.ashenHoodGranted == true
        self:EnsureAshenHoodGrant()
        self:RefreshDigest()
        self:ApplyEquipment()
    end

end
