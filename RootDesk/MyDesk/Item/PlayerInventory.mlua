-- 소지품: 가방(30칸, 슬롯 방식) · 장비 10부위 · 전리품 줍기 · 장착 효과 반영. 서버 권위.
-- 아이템은 ItemData 문자열로 보관하고 클라이언트에는 요약(@Sync)으로 보낸다.
-- 물약은 PlayerBelt, 상점은 PlayerShop, 사망 시체는 PlayerCorpses.
@Component
script PlayerInventory extends Component

    property integer BagSize = 30
    property number PickupRadius = 0.8
    property string SlotOrder = "weapon,offhand,helm,armor,gloves,boots,belt,amulet,ring1,ring2"
    property string StarterWeapon = "scythe1|0|1|단낫||0|"

    property table Bag = {}           -- 아이템 문자열 목록
    property table Equip = {}         -- 부위 → 아이템 문자열
    @Sync
    property string BagDigest = ""
    @Sync
    property string EquipDigest = ""  -- "부위>아이템;..."
    property integer PickupTimer = 0
    property number BagWarningAt = 0
    property boolean AppearanceReady = false
    property integer AppearanceTries = 0

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 새 캐릭터 기본 장비 (저장 데이터가 있으면 PlayerSave가 덮어쓴다)
        self.Bag = {}
        self.Equip = {}
        self.Equip["weapon"] = self.StarterWeapon
        self:RefreshDigest()
        _TimerService:SetTimerOnce(function() self:ApplyEquipment() end, 0.3)
        _TimerService:SetTimerOnce(function() self:CaptureAppearance(self.Entity.PlayerComponent.UserId) end, 0.8)
        self.PickupTimer = _TimerService:SetTimerRepeat(function() self:TryPickup() end, 0.25)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        if self.PickupTimer ~= 0 then _TimerService:ClearTimer(self.PickupTimer) end
    end

    method PlayerStats Stats()
        ---@type PlayerStats
        local c = self.Entity:GetComponent("script.PlayerStats")
        return c
    end

    method boolean IsOwnerRequest(string fromUserId)
        return fromUserId == self.Entity.PlayerComponent.UserId
    end

    @ExecSpace("ServerOnly")
    method void RefreshDigest()
        self.BagDigest = table.concat(self.Bag, ";")
        local parts = {}
        for slot in string.gmatch(self.SlotOrder, "[^,]+") do
            local s = self.Equip[slot]
            if s ~= nil then table.insert(parts, slot .. ">" .. s) end
        end
        self.EquipDigest = table.concat(parts, ";")
    end

    @ExecSpace("ServerOnly")
    method boolean AddItem(string s)
        if #self.Bag >= self.BagSize then return false end
        table.insert(self.Bag, s)
        self:RefreshDigest()
        return true
    end

    @ExecSpace("ServerOnly")
    method string TakeBagItem(integer index)
        -- 가방에서 꺼낸다 (거래·판매). 없으면 ""
        local s = self.Bag[index]
        if s == nil then return "" end
        table.remove(self.Bag, index)
        self:RefreshDigest()
        return s
    end

    @ExecSpace("ServerOnly")
    method void PutBagItems(table items)
        -- 공간과 관계없이 넣는다 (돌려받기·교환: 호출하는 쪽이 공간을 미리 확인)
        for _, s in ipairs(items) do table.insert(self.Bag, s) end
        self:RefreshDigest()
    end

    -- ───────── 줍기 ─────────

    @ExecSpace("ServerOnly")
    method void TryPickup()
        local pc = self.Entity.PlayerComponent
        if pc.Hp <= 0 then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return end
        local me = _Util:Pos2(self.Entity)
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.LootDrop", true)) do
            ---@type LootDrop
            local drop = c
            if drop:CanTake(pc.UserId) and (_Util:Pos2(c.Entity) - me):Magnitude() <= self.PickupRadius then self:Pickup(drop) end
        end
    end

    @ExecSpace("ServerOnly")
    method void Pickup(LootDrop drop)
        local msg = ""
        if drop.Kind == "gold" then
            local stats = self:Stats()
            if stats ~= nil then stats:AddGold(drop.Amount) end
            msg = "골드 +" .. tostring(drop.Amount)
        elseif drop.Kind == "hp" or drop.Kind == "mp" then
            ---@type PlayerBelt
            local belt = self.Entity:GetComponent("script.PlayerBelt")
            if belt == nil then return end
            belt:AddPotion(drop.Kind, drop.Amount)
            msg = (drop.Kind == "hp" and "생명" or "마나") .. " 물약 +" .. tostring(drop.Amount)
        else
            if not self:AddItem(drop.ItemString) then
                if _UtilLogic.ElapsedSeconds >= self.BagWarningAt then
                    self.BagWarningAt = _UtilLogic.ElapsedSeconds + 4
                    _Util:Notify("가방이 가득 찼습니다 — 전리품은 바닥에 남습니다", self.Entity.PlayerComponent.UserId)
                end
                return
            end
            msg = _ItemData:DisplayName(drop.ItemString)
        end
        if drop.Kind == "rune" or (drop.Kind == "item" and drop.Rarity >= 2) then
            self:NotifyTreasure(drop.ItemString, self.Entity.PlayerComponent.UserId)
        end
        drop:Take()
        _Util:Notify(msg, self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("Client")
    method void NotifyTreasure(string item)
        _UXFeedback:Show("전리품 획득", _ItemData:DisplayName(item) .. "\n메뉴의 인벤토리에서 장비를 확인하세요", _ItemData:IconFor(item))
    end

    -- ───────── 장착 ─────────

    @ExecSpace("Server")
    method void RequestEquip(integer index, string expectedItem)
        -- 선택한 물건이 아직 같은 칸에 있을 때만 장착한다. 네트워크 지연 중 바뀐 칸은 거부한다.
        if not self:IsOwnerRequest(senderUserId) then return end
        local s = self.Bag[index]
        if s == nil or s ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        local base = _ItemData:GetBase(_ItemData:Parse(s).base)
        local userId = self.Entity.PlayerComponent.UserId
        if base == nil then
            _Util:Notify("장착할 수 없는 물건", userId)
            return
        end
        local stats = self:Stats()
        if stats == nil then return end
        if stats.Level < base.reqLv then
            _Util:Notify("요구 레벨 " .. tostring(base.reqLv), userId)
            return
        end
        local slot = base.slot
        if slot == "ring" then
            slot = "ring1"
            if self.Equip["ring1"] ~= nil and self.Equip["ring2"] == nil then slot = "ring2" end
        end
        table.remove(self.Bag, index)
        local old = self.Equip[slot]
        self.Equip[slot] = s
        if old ~= nil then table.insert(self.Bag, old) end
        self:RefreshDigest()
        self:ApplyEquipment()
    end

    @ExecSpace("Server")
    method void RequestUnequip(string slot, string expectedItem)
        -- 착용품과 생존 상태를 서버에서 다시 확인한 뒤 해제한다.
        if not self:IsOwnerRequest(senderUserId) then return end
        local s = self.Equip[slot]
        if s == nil or s ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        if #self.Bag >= self.BagSize then
            _Util:Notify("가방이 가득 찼다", senderUserId)
            return
        end
        self.Equip[slot] = nil
        table.insert(self.Bag, s)
        self:RefreshDigest()
        self:ApplyEquipment()
    end

    @ExecSpace("Server")
    method void RequestSell(integer index, string expectedItem)
        -- 판매 요청 도착 전에 거래 등으로 바뀐 물건을 판매하지 않는다.
        if not self:IsOwnerRequest(senderUserId) then return end
        if self.Bag[index] == nil or self.Bag[index] ~= expectedItem or not _Util:IsAlive(self.Entity) then return end
        local stats = self:Stats()
        if stats == nil then return end
        local s = self:TakeBagItem(index)
        if s == "" then return end
        local value = _ItemData:SellValue(s)
        stats:AddGold(value)
        _Util:Notify("판매 +" .. tostring(value) .. " 골드", senderUserId)
    end

    @ExecSpace("Server")
    method void RequestSocket(integer runeIndex, string slot, string expectedRune, string expectedGear)
        -- 선택한 룬과 장비가 서버에도 그대로 있을 때만 소모한다 (되돌릴 수 없음).
        if not self:IsOwnerRequest(senderUserId) then return end
        if self.Bag[runeIndex] == nil or self.Equip[slot] == nil or self.Bag[runeIndex] ~= expectedRune or self.Equip[slot] ~= expectedGear or not _Util:IsAlive(self.Entity) then return end
        self:SocketRune(runeIndex, slot)
    end

    @ExecSpace("ServerOnly")
    method boolean SocketRune(integer runeIndex, string slot)
        -- 룬 데이터와 빈 소켓을 검증한 뒤 두 물건을 한 번의 서버 작업으로 바꾼다.
        local userId = self.Entity.PlayerComponent.UserId
        local r = self.Bag[runeIndex]
        local s = self.Equip[slot]
        if r == nil or s == nil or not _ItemData:IsRune(r) or _ItemData:GetRune(_ItemData:Parse(r).base) == nil then return false end
        local item = _ItemData:Parse(s)
        if #item.runes >= item.sockets then
            _Util:Notify("빈 소켓이 없다", userId)
            return false
        end
        table.insert(item.runes, _ItemData:Parse(r).base)
        self.Equip[slot] = _ItemData:Serialize(item)
        table.remove(self.Bag, runeIndex)
        self:RefreshDigest()
        self:ApplyEquipment()
        _Util:Notify(_ItemData:DisplayName(self.Equip[slot]), userId)
        return true
    end

    @ExecSpace("ServerOnly")
    method table StripEquipment()
        -- 사망: 착용 장비를 모두 벗겨 { {slot, s}, ... } 로 돌려준다
        local items = {}
        for slot, s in pairs(self.Equip) do table.insert(items, { slot = slot, s = s }) end
        self.Equip = {}
        self:RefreshDigest()
        self:ApplyEquipment()
        return items
    end

    @ExecSpace("ServerOnly")
    method void RestoreEquipment(table items)
        -- 시체 회수: 빈 부위는 다시 장착, 이미 다른 장비가 있으면 가방으로
        for _, it in ipairs(items) do
            if self.Equip[it.slot] == nil then self.Equip[it.slot] = it.s else table.insert(self.Bag, it.s) end
        end
        self:RefreshDigest()
        self:ApplyEquipment()
    end

    @ExecSpace("ServerOnly")
    method void ApplyEquipment()
        -- 장비 옵션 합계 → PlayerStats (생명·마나·이동 속도·저항까지 다시 계산)
        local stats = self:Stats()
        if stats == nil then return end
        local t = {}
        local setCounts = {}
        for _, s in pairs(self.Equip) do
            for k, v in pairs(_ItemData:GetTotalMods(s)) do t[k] = (t[k] or 0) + v end
            local piece = _ItemData:GetSetPiece(_ItemData:Parse(s))
            if piece ~= nil then setCounts[piece.set] = (setCounts[piece.set] or 0) + 1 end
        end
        -- 세트 효과 (2개·3개·전체)
        for setId, count in pairs(setCounts) do
            for k, v in pairs(_ItemData:GetSetBonusMods(setId, count)) do t[k] = (t[k] or 0) + v end
        end
        stats:ApplyEquipmentMods(t)
        self:ApplyAppearance()
    end

    -- 계정의 피부·얼굴·머리·귀는 보존하고, 전투 장비 외형은 모든 클라이언트에 동기화한다.
    @ExecSpace("Client")
    method void CaptureAppearance()
        if self.Entity ~= _UserService.LocalPlayer then return end
        local costume = self.Entity.CostumeManagerComponent
        if not isvalid(costume) then return end
        local body = costume:GetEquip(MapleAvatarItemCategory.Body)
        if body == "" then
            self.AppearanceTries = self.AppearanceTries + 1
            if self.AppearanceTries < 5 then
                _TimerService:SetTimerOnce(function() self:CaptureAppearance() end, 1)
            else
                log_warning("[Appearance] 아바타 로딩이 늦어 기본 외형을 유지합니다")
            end
            return
        end
        self:RequestAppearance(body, costume:GetEquip(MapleAvatarItemCategory.Hair), costume:GetEquip(MapleAvatarItemCategory.Face), costume:GetEquip(MapleAvatarItemCategory.Ear))
    end

    @ExecSpace("Server")
    method void RequestAppearance(string body, string hair, string face, string ear)
        if not self:IsOwnerRequest(senderUserId) or self.AppearanceReady then return end
        for _, ruid in ipairs({ body, hair, face, ear }) do
            if ruid ~= "" and (#ruid ~= 32 or string.match(ruid, "^%x+$") == nil) then return end
        end
        if body == "" then return end
        local costume = self.Entity.CostumeManagerComponent
        if not isvalid(costume) then return end
        costume:SetEquip(MapleAvatarItemCategory.Body, body)
        costume:SetEquip(MapleAvatarItemCategory.Hair, hair)
        costume:SetEquip(MapleAvatarItemCategory.Face, face)
        costume:SetEquip(MapleAvatarItemCategory.Ear, ear)
        costume.UseCustomEquipOnly = true
        self.AppearanceReady = true
        self:ApplyAppearance()
    end

    @ExecSpace("ServerOnly")
    method string EquippedAvatar(string slot)
        local item = self.Equip[slot]
        if item == nil then return "" end
        local base = _ItemData:GetBase(_ItemData:Parse(item).base)
        if base == nil then return "" end
        return base.avatar or ""
    end

    @ExecSpace("ServerOnly")
    method void ApplyAppearance()
        if not self.AppearanceReady then return end
        local costume = self.Entity.CostumeManagerComponent
        if not isvalid(costume) then return end
        -- 로브 없이도 기본 복장은 유지한다. 미장착 무기는 계정 무기로 되돌리지 않는다.
        local robe = self:EquippedAvatar("armor")
        if robe == "" then robe = _ItemData:GetBase("armor1").avatar end
        costume:SetEquip(MapleAvatarItemCategory.Coat, "")
        costume:SetEquip(MapleAvatarItemCategory.Pants, "")
        costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
        costume:SetEquip(MapleAvatarItemCategory.SubWeapon, "")
        costume:SetEquip(MapleAvatarItemCategory.Cape, "")
        costume:SetEquip(MapleAvatarItemCategory.FaceAccessory, "")
        costume:SetEquip(MapleAvatarItemCategory.EyeAccessory, "")
        costume:SetEquip(MapleAvatarItemCategory.EarAccessory, "")
        costume:SetEquip(MapleAvatarItemCategory.Longcoat, robe)
        costume:SetEquip(MapleAvatarItemCategory.Cap, self:EquippedAvatar("helm"))
        costume:SetEquip(MapleAvatarItemCategory.Glove, self:EquippedAvatar("gloves"))
        costume:SetEquip(MapleAvatarItemCategory.Shoes, self:EquippedAvatar("boots"))
        costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, self:EquippedAvatar("weapon"))
    end

    -- ───────── 클라이언트 표시용 ─────────

    method table GetBagList()
        local list = {}
        if self.BagDigest == "" then return list end
        for s in string.gmatch(self.BagDigest .. ";", "([^;]*);") do table.insert(list, s) end
        return list
    end

    method table GetEquipMap()
        local map = {}
        for slot, s in string.gmatch(self.EquipDigest, "([%w]+)>([^;]*)") do map[slot] = s end
        return map
    end

    -- ───────── 저장 ─────────

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        local bag = {}
        for i, s in ipairs(self.Bag) do bag[i] = s end
        -- 거래창에 올려 둔 물건도 가방에 있는 것으로 저장 (접속 종료 순서와 관계없이 잃지 않게)
        ---@type PlayerTrade
        local trade = self.Entity:GetComponent("script.PlayerTrade")
        if trade ~= nil then for _, s in ipairs(trade.Escrow) do table.insert(bag, s) end end
        local equip = {}
        for slot, s in pairs(self.Equip) do equip[slot] = s end
        -- 빈 Lua 표는 JSON 타입이 불명확하므로 개수만 저장한다. 기존 배열 저장도 계속 읽는다.
        local saved = { bagCount = #bag, equipCount = 0 }
        for _ in pairs(equip) do saved.equipCount = saved.equipCount + 1 end
        if #bag > 0 then saved.bag = bag end
        if saved.equipCount > 0 then saved.equip = equip end
        return saved
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table data)
        if data == nil then return end
        self.Bag = {}
        self.Equip = {}
        if data.bag ~= nil then for _, s in ipairs(data.bag) do table.insert(self.Bag, s) end end
        if data.equip ~= nil then for slot, s in pairs(data.equip) do self.Equip[slot] = s end end
        self:RefreshDigest()
        self:ApplyEquipment()
    end

end
