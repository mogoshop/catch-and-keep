-- 벨트 (D2 벨트): 4칸에 무엇을 넣을지 플레이어가 고른다 — hp 생명 물약 · mp 마나 물약 · tp 귀환 두루마리 · "" 빈 칸 (회복 물약 rv는 10-20에 없앴다).
-- 칸 사용: PC 숫자 1~4·칸 클릭, 모바일 물약 칸. 칸 지정: PC 칸 우클릭(빈 칸은 클릭), 모바일 「스킬 편집」 중 물약 칸 → SkillPicker 벨트 모드.
-- 물약은 가방의 겹치는 물건(하급·중급·고급, shop.csv hp1~3·mp1~3). 벨트 칸 = 종류만 정하고, 마실 때 가방에서 낮은 등급부터 쓴다.
-- 칸에는 다음에 마실 등급의 그림과 그 등급 개수가 보인다 (하급을 다 쓰면 중급이 보인다 — 10-20 사용자 요청).
-- 마시면 디아2처럼 몇 초에 걸쳐 차오른다 (potionHealSeconds, 디아2보다 빠르게).
-- HpPot·MpPot·TpPot = 가방 속 개수 합 (표시용, PlayerInventory.RefreshDigest가 맞춘다). 귀환 두루마리도 가방 물건 (10-11).
@Component
script PlayerBelt extends Component

    property number PotionCooldown = 0.8
    @Sync
    property integer HpPot = 0
    @Sync
    property integer MpPot = 0
    @Sync
    property integer TpPot = 0
    @Sync
    property string Layout = "hp,mp,tp,"   -- 칸 1~4의 물건 (","로 연결, 빈 칸은 빈 문자열)
    property number ReadyAt = 0
    property table Regens = {}              -- 서버: 차오르는 중인 물약 { hp, mp, left } (남은 양·남은 초)
    property integer RegenTimer = 0
    property number HpCarry = 0

    method string SlotKind(integer index)
        -- index번 칸의 물건 종류 ("" = 빈 칸)
        local i = 0
        for part in string.gmatch(self.Layout .. ",", "([^,]*),") do
            i = i + 1
            if i == index then return part end
        end
        return ""
    end

    method boolean ValidKind(string kind)
        return kind == "" or kind == "hp" or kind == "mp" or kind == "tp"
    end

    method integer CountOf(string kind)
        -- 그 물건의 남은 개수 (귀환 두루마리는 PlayerTravel)
        if kind == "hp" then return self.HpPot end
        if kind == "mp" then return self.MpPot end
        if kind == "tp" then
            -- 가방 속 두루마리 + 예전 저장에서 가방이 가득 차 아직 못 옮긴 개수
            ---@type PlayerTravel
            local travel = self.Entity:GetComponent("script.PlayerTravel")
            return self.TpPot + (travel ~= nil and travel.TownScroll or 0)
        end
        return 0
    end

    method PlayerInventory Inv()
        ---@type PlayerInventory
        local c = self.Entity:GetComponent("script.PlayerInventory")
        return c
    end

    @ExecSpace("ServerOnly")
    method void SyncCounts()
        -- 가방 속 물약 수 (모든 등급 합)
        local inv = self:Inv()
        if inv == nil then return end
        self.HpPot = inv:CountStack("hp1") + inv:CountStack("hp2") + inv:CountStack("hp3")
        self.MpPot = inv:CountStack("mp1") + inv:CountStack("mp2") + inv:CountStack("mp3")
        self.TpPot = inv:CountStack("tp")
    end

    @ExecSpace("ServerOnly")
    method void AddPotion(string kind, integer count)
        -- 레벨에 맞는 등급의 물약을 가방에 넣는다 (가방이 차면 넣은 만큼만)
        local inv = self:Inv()
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if inv == nil then return end
        inv:AddStack(_ItemData:PotionFor(kind, stats ~= nil and stats.Level or 1), count)
    end

    method table TierCounts(string kind)
        -- 그 종류 물약의 등급별 개수 { 하급, 중급, 고급 } (서버는 가방 표, 클라이언트는 동기화 문자열)
        local counts = { 0, 0, 0 }
        local inv = self:Inv()
        if inv == nil or (kind ~= "hp" and kind ~= "mp") then return counts end
        local list = self:IsServer() and inv.Bag or inv:GetBagList()
        for _, s in ipairs(list) do
            local item = _ItemData:Parse(s)
            local tier = tonumber(string.match(item.base, "^" .. kind .. "(%d)$"))
            if tier ~= nil and tier >= 1 and tier <= 3 then counts[tier] = counts[tier] + item.count end
        end
        return counts
    end

    method string NextPotion(string kind)
        -- 다음에 마실 물약: 가방의 그 종류 중 가장 낮은 등급 ("" = 없음). 칸에도 이 등급이 보인다
        local counts = self:TierCounts(kind)
        for tier = 1, 3 do
            if counts[tier] > 0 then return kind .. tostring(tier) end
        end
        return ""
    end

    method any SlotView(integer index)
        -- 벨트 칸 표시: { icon, count } — 물약은 다음에 마실 등급의 그림·그 등급 개수, 없으면 하급 그림을 흐리게
        local kind = self:SlotKind(index)
        if kind == "" then return { icon = "", count = -1 } end
        if kind == "hp" or kind == "mp" then
            local base = self:NextPotion(kind)
            if base == "" then
                local c1 = _ItemData:Consumable(kind .. "1")
                return { icon = c1 ~= nil and c1.icon or "", count = 0 }
            end
            local counts = self:TierCounts(kind)
            local c = _ItemData:Consumable(base)
            return { icon = c ~= nil and c.icon or "", count = counts[tonumber(string.sub(base, 3, 3))] }
        end
        return { icon = _GameData:GetUiIcon(_GameConst:BeltIcon(kind)), count = self:CountOf(kind) }
    end

    @ExecSpace("Server")
    method void RequestSetBelt(integer index, string kind)
        -- 칸 지정 (서버 검증). 같은 물건이 다른 칸에 있으면 그 칸은 비운다
        if senderUserId ~= self.Entity.PlayerComponent.UserId or index < 1 or index > 4 or not self:ValidKind(kind) then return end
        local parts = {}
        for i = 1, 4 do
            local current = self:SlotKind(i)
            if i == index then current = kind elseif kind ~= "" and current == kind then current = "" end
            parts[i] = current
        end
        self.Layout = table.concat(parts, ",")
    end

    @ExecSpace("Server")
    method void RequestUseSlot(integer index)
        if senderUserId ~= self.Entity.PlayerComponent.UserId or index < 1 or index > 4 then return end
        local kind = self:SlotKind(index)
        if kind == "" then return end
        if kind == "tp" then
            ---@type PlayerTravel
            local travel = self.Entity:GetComponent("script.PlayerTravel")
            if travel ~= nil then travel:UseTownScroll() end
            return
        end
        self:UsePotion(kind)
    end

    @ExecSpace("Server")
    method void RequestUsePotion(string kind)
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        self:UsePotion(kind)
    end

    @ExecSpace("ServerOnly")
    method boolean UsePotion(string kind)
        -- 벨트·숫자키: 가방에서 그 종류의 가장 낮은 등급 물약을 마신다 (칸에 보이는 그 등급)
        local base = self:NextPotion(kind)
        if base == "" then
            local names = { hp = "생명 물약", mp = "마나 물약" }
            _Util:Warn((names[kind] or "물약") .. "이 없다 (가방)", self.Entity.PlayerComponent.UserId)
            return false
        end
        return self:DrinkBase(base)
    end

    @ExecSpace("ServerOnly")
    method boolean DrinkBase(string base)
        -- 회복량: shop.csv hpFlat·manaFlat(고정) + hpPct·manaPct(최대치 %)
        local pc = self.Entity.PlayerComponent
        if pc.Hp <= 0 then return false end
        local now = _UtilLogic.ElapsedSeconds
        if now < self.ReadyAt then return false end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        local c = _ItemData:Consumable(base)
        local inv = self:Inv()
        if stats == nil or c == nil or inv == nil then return false end
        if not inv:TakeStack(base, 1) then return false end
        _GameEvents:Emit("PotionUsed", { player = self.Entity, base = base })   -- Telemetry
        local mult = stats:PotionMult()
        -- 디아2처럼 몇 초에 걸쳐 차오른다 (potionHealSeconds). 여러 병은 각자 따로 찬다
        table.insert(self.Regens, { hp = (c.hpFlat + pc.MaxHp * c.hpPct / 100) * mult, mp = (c.manaFlat + stats.MaxMana * c.manaPct / 100) * mult, left = _GameData.potionHealSeconds })
        if self.RegenTimer == 0 then self.RegenTimer = _TimerService:SetTimerRepeat(function() self:RegenTick(0.1) end, 0.1) end
        self.ReadyAt = now + self.PotionCooldown
        return true
    end

    @ExecSpace("ServerOnly")
    method void RegenTick(number dt)
        -- 차오르는 물약: 남은 양 × (dt / 남은 초)씩. 죽으면 모두 끊는다
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats == nil or not _Util:IsAlive(self.Entity) then
            self:StopRegen()
            return
        end
        local hp, mp = 0, 0
        local keep = {}
        for _, r in ipairs(self.Regens) do
            local share = math.min(1, dt / math.max(dt, r.left))
            local h, m = r.hp * share, r.mp * share
            r.hp = r.hp - h
            r.mp = r.mp - m
            r.left = r.left - dt
            hp = hp + h
            mp = mp + m
            if r.left > 0.001 and (r.hp > 0.01 or r.mp > 0.01) then table.insert(keep, r) end
        end
        self.Regens = keep
        -- 생명은 정수로만 깎이고 차서, 소수점은 다음 틱으로 넘긴다
        self.HpCarry = self.HpCarry + hp
        local whole = math.floor(self.HpCarry)
        self.HpCarry = self.HpCarry - whole
        stats:Heal(whole, mp)
        if #self.Regens == 0 then self:StopRegen() end
    end

    @ExecSpace("ServerOnly")
    method void StopRegen()
        if self.RegenTimer ~= 0 then _TimerService:ClearTimer(self.RegenTimer) end
        self.RegenTimer = 0
        self.Regens = {}
        self.HpCarry = 0
    end

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- 인스턴스마다 새 표 (기본값 표 공유 방지)
        self.Regens = {}
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        self:StopRegen()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleKeyDownEvent(KeyDownEvent event)
        -- 숫자 1~4 = 벨트 칸 1~4 (무엇이 들었는지는 플레이어가 정한다)
        if self.Entity ~= _UserService.LocalPlayer or not _UIKit:CanUseGameplayInput() then return end
        if event.key == KeyboardKey.Alpha1 then self:RequestUseSlot(1)
        elseif event.key == KeyboardKey.Alpha2 then self:RequestUseSlot(2)
        elseif event.key == KeyboardKey.Alpha3 then self:RequestUseSlot(3)
        elseif event.key == KeyboardKey.Alpha4 then self:RequestUseSlot(4) end
    end

    @ExecSpace("ServerOnly")
    method table GetSaveData()
        -- v2: 물약은 가방에 저장된다 (개수는 저장하지 않는다)
        return { lay = self.Layout, v = 2 }
    end

    @ExecSpace("ServerOnly")
    method void LoadSaveData(table d)
        if d == nil then return end
        -- 예전 저장(벨트 개수): 하급 물약으로 가방에 옮긴다 (가방이 소지품 다음에 불러와진다)
        if d.v ~= 2 then
            local inv = self:Inv()
            if inv ~= nil then
                inv:AddStack("hp1", math.floor(tonumber(d.hp) or 0))
                inv:AddStack("mp1", math.floor(tonumber(d.mp) or 0))
            end
        end
        -- 회복 물약(rv)은 10-20에 없앴다: 가방에 남은 것은 같은 수의 생명 물약(레벨 등급)으로 바꾼다
        local inv = self:Inv()
        if inv ~= nil then
            local rv = inv:CountStack("rv")
            if rv > 0 and inv:TakeStack("rv", rv) then self:AddPotion("hp", rv) end
        end
        self:SyncCounts()
        -- 예전 저장(칸 고정)은 생명·마나·귀환 + 빈 4번 칸으로 시작한다. 회복 물약 칸은 귀환 두루마리로
        local lay = type(d.lay) == "string" and d.lay or "hp,mp,tp,"
        local parts = {}
        for i = 1, 4 do
            local kind = ""
            local n = 0
            for part in string.gmatch(lay .. ",", "([^,]*),") do
                n = n + 1
                if n == i then kind = part end
            end
            if kind == "rv" then kind = string.find("," .. lay .. ",", ",tp,", 1, true) ~= nil and "" or "tp" end
            parts[i] = kind
        end
        self.Layout = table.concat(parts, ",")
    end

end
