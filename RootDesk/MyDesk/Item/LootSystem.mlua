-- 몬스터 드롭 판정 (골드·포션·장비·룬). ShadowSystem.GrantKillRewards가 호출한다.
-- 장비 생성 규칙은 ItemData, 땅에 떨어진 물건은 LootDrop 엔티티가 맡는다.
@Logic
script LootSystem extends Logic

    property boolean DebugLog = false

    @ExecSpace("ServerOnly")
    method void RollDrops(Entity monster, integer monLevel, string rank, Entity killer)
        -- 등급(drop_tables.csv)별 추첨 횟수만큼 "없음/골드/포션/장비/룬" 가중치 롤 (05장 7.1)
        if not isvalid(monster) or not isvalid(killer) then return end
        ---@type PlayerStats
        local stats = killer:GetComponent("script.PlayerStats")
        local mf, gf = 0, 0
        if stats ~= nil then
            mf = stats.BonusMF
            gf = stats.BonusGF
        end
        local d = _ItemData:GetDropTable(rank)
        local picks = math.floor(d.picks)
        local wNone, wGold, wPot, wItem, wRune = d.none, d.gold, d.potion, d.item, d.rune
        local goldMult = 1
        if rank == "elite" or rank == "champion" then goldMult = 2 elseif rank == "unique" or rank == "boss" then goldMult = 3 end
        local userId = killer.PlayerComponent.UserId
        local p = monster.TransformComponent.WorldPosition
        local center = Vector2(p.x, p.y)
        local sourceId = ""
        ---@type Monster
        local body = monster:GetComponent("script.Monster")
        if body ~= nil then sourceId = body.SourceId end
        local special = rank == "boss" or rank == "unique"
        if special then self:FirstKillReward(center, userId, stats, sourceId, monLevel) end
        -- 몬스터 밀도를 40% 늘린 만큼 일반·정예의 추첨마다 densityRewardMult 확률로만 굴린다 (보스·고유는 그대로)
        local keep = special and 1 or _GameData.densityRewardMult
        for i = 1, picks do
            local r = _UtilLogic:RandomDouble() * (wNone + wGold + wPot + wItem + wRune)
            if _UtilLogic:RandomDouble() >= keep then r = 0 end
            if r < wNone then
                -- 없음
            elseif r < wNone + wGold then
                local amount = math.floor(_UtilLogic:RandomIntegerRange(monLevel * 3 + 2, monLevel * 8 + 5) * goldMult * (1 + gf / 100))
                self:Spawn(center, userId, "gold", "", amount, 0)
            elseif r < wNone + wGold + wPot then
                local kind = "hp"
                if _UtilLogic:RandomDouble() < 0.4 then kind = "mp" end
                self:Spawn(center, userId, kind, "", 1, 0)
            elseif r < wNone + wGold + wPot + wItem then
                local s = _ItemData:Generate(monLevel, rank, mf)
                local item = _ItemData:Parse(s)
                if special and item.rarity == 3 and _UtilLogic:RandomDouble() < _GameData.bossExclusiveShare then
                    -- 보스·최상위의 유니크는 절반 확률로 그 몬스터 전용 유니크
                    local u = _ItemData:PickUnique(monLevel, sourceId)
                    if u ~= nil then
                        s = _ItemData:MakeUnique(u, monLevel)
                        item = _ItemData:Parse(s)
                    end
                end
                self:Spawn(center, userId, "item", s, 1, item.rarity)
            else
                self:Spawn(center, userId, "rune", _ItemData:MakeRune(monLevel), 1, 0)
            end
        end
        -- 보스는 룬 1개 확정 (06장)
        if rank == "boss" then self:Spawn(center, userId, "rune", _ItemData:MakeRune(monLevel + 5), 1, 0) end
    end

    @ExecSpace("ServerOnly")
    method void FirstKillReward(Vector2 center, string userId, PlayerStats stats, string sourceId, integer monLevel)
        -- 보스·최상위 첫 처치 (캐릭터·난이도마다 1회, D2 퀘스트 드롭): 전용 유니크 → 없으면 일반 유니크 → 세트 하나 확정
        if stats == nil or sourceId == "" then return end
        local key = sourceId .. "@" .. tostring(stats.Difficulty)
        if stats:HasFirstKill(key) then return end
        stats:MarkFirstKill(key)
        local s = ""
        local u = _ItemData:PickUnique(monLevel, sourceId)
        if u == nil then u = _ItemData:PickUnique(monLevel, "") end
        if u ~= nil then
            s = _ItemData:MakeUnique(u, monLevel)
        else
            local piece = _ItemData:PickSetPiece(monLevel)
            if piece == nil then return end
            local item = { base = piece.base, rarity = 4, ilvl = monLevel, name = piece.name, mods = {}, sockets = 0, runes = {} }
            _ItemData:AddMods(item.mods, piece.mods)
            s = _ItemData:Serialize(item)
        end
        self:Spawn(center, userId, "item", s, 1, _ItemData:Parse(s).rarity)
        _Util:Notify("첫 처치 보상: " .. _ItemData:Parse(s).name, userId)
    end

    @ExecSpace("ServerOnly")
    method void Spawn(Vector2 center, string userId, string kind, string itemString, integer amount, integer rarity)
        -- 처치 위치 주변에 흩뿌린다
        local map = nil
        local player = _UserService:GetUserEntityByUserId(userId)
        if isvalid(player) then map = player.CurrentMap end
        if map == nil then return end
        local ang = _UtilLogic:RandomDouble() * math.pi * 2
        local dist = 0.2 + _UtilLogic:RandomDouble() * 0.5
        local pos = Vector3(center.x + math.cos(ang) * dist, center.y + math.sin(ang) * dist * 0.6, 0)
        local e = _SpawnService:SpawnByModelId(_GameConst.ModelLootDrop, "Loot", pos, map)
        if not isvalid(e) then return end
        _Util:AfterSpawn(e, "script.LootDrop", function(comp)
            ---@type LootDrop
            local drop = comp
            drop:Setup(userId, kind, itemString, amount, rarity)
        end, function() e:Destroy() end)
        if self.DebugLog then log("[LootSystem] 드롭 " .. kind .. " " .. itemString .. " x" .. tostring(amount)) end
    end

end
