-- 몬스터 드롭 판정 (골드·포션·장비·룬). ShadowSystem.GrantKillRewards가 호출한다.
-- 장비 생성 규칙은 ItemData, 땅에 떨어진 물건은 LootDrop 엔티티가 맡는다.
@Logic
script LootSystem extends Logic

    property boolean DebugLog = false

    @ExecSpace("ServerOnly")
    method void RollDrops(Entity monster, integer monLevel, string rank, Entity killer)
        -- 등급(drop_tables.csv)별 추첨 횟수만큼 "없음/골드/포션/장비/룬" 가중치 롤 (05장 7.1)
        if not isvalid(monster) or not isvalid(killer) then return end
        ---@type PlayerStats
        local stats = killer:GetComponent("script.PlayerStats")
        local mf, gf = 0, 0
        if stats ~= nil then
            mf = stats.BonusMF
            gf = stats.BonusGF
        end
        local d = _ItemData:GetDropTable(rank)
        -- 악몽·지옥: 없음 줄이고 골드·룬·장비 품질을 올린다 (difficulty.csv drop*Mul — 10-23 사용자: 디아2처럼 난이도가 오를수록 드롭이 좋아야)
        local diffIndex = self:DifficultyAt(monster.CurrentMap)
        local diff = _GameData:GetDifficulty(diffIndex)
        -- 같은 맵 인원 보정: 추첨 횟수 + 비율 (소수 부분은 확률로, CoopRules · 10-13 X2)
        local pickF = d.picks * (1 + _CoopRules:DropBonus(monster.CurrentMap))
        local picks = math.floor(pickF)
        if _UtilLogic:RandomDouble() < pickF - picks then picks = picks + 1 end
        local wNone, wGold, wPot, wItem, wRune = d.none, d.gold, d.potion, d.item, d.rune
        if diff ~= nil then
            local others = wNone + wGold + wPot + wRune
            wNone = wNone * (diff.dropNoneMul or 1)
            wGold = wGold * (diff.dropGoldMul or 1)
            wRune = wRune * (diff.dropRuneMul or 1)
            -- 골드·룬 가중치가 커진 만큼 장비 몫이 줄지 않게 장비 가중치도 같은 비율로 (보스는 「없음」이 작아 지옥 장비가 보통보다 적었다 · 10-24 출시 점검)
            local othersNow = wNone + wGold + wPot + wRune
            if others > 0 and othersNow > others then wItem = wItem * othersNow / others end
        end
        _ItemData.DropDiff = diffIndex
        local goldMult = 1
        if rank == "elite" or rank == "champion" then goldMult = 2 elseif rank == "unique" or rank == "boss" then goldMult = 3 end
        local userId = killer.PlayerComponent.UserId
        local p = monster.TransformComponent.WorldPosition
        local center = Vector2(p.x, p.y)
        local sourceId = ""
        ---@type Monster
        local body = monster:GetComponent("script.Monster")
        if body ~= nil then sourceId = body.SourceId end
        local special = rank == "boss" or rank == "unique"
        -- 첫 처치 확정 보상은 없다 (10-13 사용자 결정: 보스 유니크도 평소 드롭과 같은 처치당 약 8% — drop_tables boss · bossExclusiveShare)
        -- 몬스터 밀도를 40% 늘린 만큼 일반·정예의 추첨마다 densityRewardMult 확률로만 굴린다 (보스·고유는 그대로)
        local keep = special and 1 or _GameData.densityRewardMult
        for i = 1, picks do
            local r = _UtilLogic:RandomDouble() * (wNone + wGold + wPot + wItem + wRune)
            if _UtilLogic:RandomDouble() >= keep then r = 0 end
            if r < wNone then
                -- 없음
            elseif r < wNone + wGold then
                -- 난이도 골드 양 배율 (difficulty.csv goldAmountMul — 10-24 사용자 G-C: 악몽 0.8 · 지옥 0.6, 고난이도 인플레이션)
                local amount = math.floor(_UtilLogic:RandomIntegerRange(monLevel * 3 + 2, monLevel * 8 + 5) * goldMult * (1 + gf / 100) * (diff ~= nil and diff.goldAmountMul or 1))
                self:Spawn(center, userId, "gold", "", amount, 0)
            elseif r < wNone + wGold + wPot then
                -- 물약: 몬스터 레벨에 맞는 등급 (하급 Lv1~9 · 중급 10~29 · 고급 30+). 회복 물약은 10-20에 없앴다
                local kind = "hp"
                local r2 = _UtilLogic:RandomDouble()
                if r2 < _GameData.tpScrollShare then
                    -- 귀환 두루마리 (D2처럼 물약 자리에서 흔히 나온다 — 10-10 QA)
                    self:Spawn(center, userId, "tp", "", 1, 0)
                else
                    if r2 < _GameData.tpScrollShare + 0.36 then kind = "mp" end
                    self:Spawn(center, userId, "item", _ItemData:MakeStack(_ItemData:PotionFor(kind, monLevel), 1), 1, 0)
                end
            elseif r < wNone + wGold + wPot + wItem then
                local s = _ItemData:Generate(monLevel, rank, mf)
                local item = _ItemData:Parse(s)
                if special and item.rarity == 3 and _UtilLogic:RandomDouble() < _GameData.bossExclusiveShare then
                    -- 보스·최상위의 유니크는 절반 확률로 그 몬스터 전용 유니크
                    local u = _ItemData:PickUnique(monLevel, sourceId)
                    if u ~= nil then
                        s = _ItemData:MakeUnique(u, monLevel)
                        item = _ItemData:Parse(s)
                    end
                end
                self:Spawn(center, userId, "item", s, 1, item.rarity)
            else
                self:Spawn(center, userId, "rune", _ItemData:MakeRune(monLevel), 1, 0)
            end
        end
        _ItemData.DropDiff = 0
        -- 룬은 D2처럼 희귀한 엔드 재료: 보스 확정 룬은 없앴다 (10-09). 의뢰 룬은 마지막 의뢰(묘지기 여왕)에서만
    end

    method integer DifficultyAt(Entity map)
        -- 드롭이 나온 맵의 난이도 (심연은 그 층의 난이도)
        if not isvalid(map) then return 0 end
        ---@type DepthDirector
        local depth = map:GetComponent("script.DepthDirector")
        if depth ~= nil then return depth.Difficulty end
        return _GameConst:DifficultyOfMap(map.Name)
    end

    @ExecSpace("ServerOnly")
    method void DropDiscarded(Entity player, string itemString)
        -- 버리기: 발밑 조금 앞에 떨어뜨린다. 주인 없음(누구나 주울 수 있음) + LockSeconds 동안은 아무도 못 줍고 깜빡인다
        if not isvalid(player) or not isvalid(player.CurrentMap) then return end
        local item = _ItemData:Parse(itemString)
        local kind = _ItemData:IsRune(item.base) and "rune" or "item"
        local p = _Util:Pos2(player)
        local ang = _UtilLogic:RandomDouble() * math.pi * 2
        local pos = Vector3(p.x + math.cos(ang) * 0.9, p.y + math.sin(ang) * 0.6, 0)
        local e = _SpawnService:SpawnByModelId(_GameConst.ModelLootDrop, "Loot", pos, player.CurrentMap)
        if not isvalid(e) then return end
        _Util:AfterSpawn(e, "script.LootDrop", function(comp)
            ---@type LootDrop
            local drop = comp
            drop:Setup("", kind, itemString, 1, item.rarity)
            drop:LockFor(drop.DiscardLockSeconds)
        end, function() e:Destroy() end)
    end

    @ExecSpace("ServerOnly")
    method void Spawn(Vector2 center, string userId, string kind, string itemString, integer amount, integer rarity)
        -- 처치 위치 주변에 흩뿌린다
        local map = nil
        local player = _UserService:GetUserEntityByUserId(userId)
        if isvalid(player) then map = player.CurrentMap end
        if map == nil then return end
        local ang = _UtilLogic:RandomDouble() * math.pi * 2
        local dist = 0.2 + _UtilLogic:RandomDouble() * 0.5
        local pos = Vector3(center.x + math.cos(ang) * dist, center.y + math.sin(ang) * dist * 0.6, 0)
        local e = _SpawnService:SpawnByModelId(_GameConst.ModelLootDrop, "Loot", pos, map)
        if not isvalid(e) then return end
        _Util:AfterSpawn(e, "script.LootDrop", function(comp)
            ---@type LootDrop
            local drop = comp
            drop:Setup(userId, kind, itemString, amount, rarity)
        end, function() e:Destroy() end)
        if self.DebugLog then log("[LootSystem] 드롭 " .. kind .. " " .. itemString .. " x" .. tostring(amount)) end
    end

end
