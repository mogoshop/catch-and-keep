-- 아이템 규칙: 문자열 ↔ 표, 능력치 합산, 드롭 생성, 표시. 데이터 표는 _ItemTables (data/*.csv에서 생성).
-- 아이템 한 개 = 문자열 "base|rarity|ilvl|name|k=v,k=v|sockets|runes[|count[|L[|meta]]]" (저장·동기화·거래가 같은 형식)
-- 10번째 칸 meta (10-30 I01 부분 재련): "A1:uid:rev:line:id*val+id*val:id*val" — 서버가 새로 만든(또는 사용자가 고른 전체 재련) 마법·레어 장비의 출처.
--   uid 아이템 id · rev 고칠 때마다 +1 (요청 묶기) · line 부분 재련으로 고정한 줄(0 = 아직) · 접사 id*값(뽑힌 순서) · 대기 중 새 후보 id*값.
--   「;」「>」「|」를 쓰지 않는다 (가방·장비 요약 구분자). 이 칸이 없는 예전 물건은 그대로 두고 부분 재련만 안 된다 (합산 옵션을 쪼개 추정하지 않는다)
-- 겹치는 물건(물약·정수)은 base = shop.csv 키(hp1~3·mp1~3·rv) 또는 "essence", count = 개수. 정수는 귀속(버리면 파괴·거래 불가)
-- rarity: 0 일반(흰) 1 마법(파랑) 2 희귀(노랑) 3 유니크(금) 4 룬워드(표시 전용)
@Logic
script ItemData extends Logic

    property table GrailCache = {}            -- 아이템 도감 목록 (처음 부를 때 만든다)
    property integer DropDiff = 0             -- 지금 굴리는 몬스터 드롭의 난이도 (LootSystem.RollDrops 동안만 · RollRarity 배율)
    property table UniqueKeyCache = {}        -- "이름|베이스" → 유니크 id
    property integer UidSeq = 0               -- 출처 id 순번 (같은 초에 만든 물건끼리 겹치지 않게)
    property table AffixById = {}             -- 접사 id → 행 (부분 재련 출처 확인 · 처음 부를 때 만든다)
    property string RewardSlotOrder = "weapon,offhand,helm,armor,gloves,boots,belt,amulet,ring"   -- 부위 고르기 보상의 부위 순서 (I01)

    method any T()
        _ItemTables:Ensure()
        return _ItemTables
    end

    method any GetBase(string id)
        return self:T().Bases[id]
    end

    method any GetRune(string id)
        return self:T().Runes[id]
    end

    method any GetRuneword(table item)
        -- 소켓을 정해진 순서로 정확히 채웠으면 그 룬워드 (부위 확인 포함)
        if item.sockets <= 0 or #item.runes ~= item.sockets then return nil end
        local rw = self:T().Runewords[table.concat(item.runes, ",")]
        if rw == nil then return nil end
        local base = self:GetBase(item.base)
        if base == nil or string.find("," .. rw.slots .. ",", "," .. base.slot .. ",", 1, true) == nil then return nil end
        return rw
    end

    -- ───────── 아이템 도감 (docs/design/19 §2-6 · 디아블로 2 「성배 모으기」) ─────────

    method table GrailList()
        -- 도감 순서: 유니크(표 순서) → 세트 조각(세트 표 순서) → 룬워드(이름순). key = "u:id" · "s:베이스" · "r:이름"
        if #self.GrailCache > 0 then return self.GrailCache end
        local t = self:T()
        local list = {}
        for _, u in ipairs(t.UniqueList) do
            local b = t.Bases[u.base]
            table.insert(list, { key = "u:" .. u.id, kind = "u", name = u.name, tree = u.tree or "any", grade = b ~= nil and (b.grade or 0) or 0, base = b ~= nil and b.name or "", source = u.source or "" })
        end
        for _, baseId in ipairs(t.SetPieceOrder) do
            local piece = t.SetPieces[baseId]
            local set = t.Sets[piece.set]
            local b = t.Bases[baseId]
            table.insert(list, { key = "s:" .. baseId, kind = "s", name = piece.name, tree = set ~= nil and (set.tree or "any") or "any", grade = b ~= nil and (b.grade or 0) or 0, base = b ~= nil and b.name or "", set = set ~= nil and set.name or "" })
        end
        local words = {}
        for runes, rw in pairs(t.Runewords) do table.insert(words, { key = "r:" .. rw.name, kind = "r", name = rw.name, tree = rw.tree or "any", grade = 0, base = rw.slots, runes = runes }) end
        table.sort(words, function(x, y) return x.name < y.name end)
        for _, w in ipairs(words) do table.insert(list, w) end
        self.GrailCache = list
        return list
    end

    method string GrailKeyOf(string s)
        -- 도감에 오르는 물건이면 그 key, 아니면 "" (유니크 · 세트 조각 · 완성된 룬워드)
        if s == nil or s == "" then return "" end
        local item = self:Parse(s)
        if item.rarity == 3 then
            if next(self.UniqueKeyCache) == nil then
                for _, u in ipairs(self:T().UniqueList) do self.UniqueKeyCache[u.name .. "|" .. u.base] = u.id end
            end
            local id = self.UniqueKeyCache[item.name .. "|" .. item.base]
            return id ~= nil and ("u:" .. id) or ""
        end
        if item.rarity == 4 then
            if self:GetSetPiece(item) ~= nil then return "s:" .. item.base end
            return ""
        end
        local rw = self:GetRuneword(item)
        if rw ~= nil then return "r:" .. rw.name end
        return ""
    end

    -- ───────── 문자열 ↔ 표 ─────────

    method table Parse(string s)
        -- 룬 아이템은 base가 r_* 이다. 9번째 칸 "L" = 잠금 (10-29 기획서 45 결정 6-A — 물건에 붙어 가방·창고·장착·거래를 따라다닌다)
        local f = {}
        for part in string.gmatch(s .. "|", "([^|]*)|") do table.insert(f, part) end
        -- 10번째 칸 = 출처 메타데이터 (I01 부분 재련 · DecodeMeta). 없으면 "" — 예전 문자열은 그대로 읽고 그대로 쓴다
        local item = { base = f[1] or "", rarity = tonumber(f[2]) or 0, ilvl = tonumber(f[3]) or 1, name = f[4] or "", mods = {}, sockets = tonumber(f[6]) or 0, runes = {}, count = tonumber(f[8]) or 1, locked = f[9] == "L", meta = f[10] or "" }
        for k, v in string.gmatch(f[5] or "", "([%w_]+)=([%-%d%.]+)") do item.mods[k] = tonumber(v) end
        for r in string.gmatch(f[7] or "", "[^,]+") do table.insert(item.runes, r) end
        return item
    end

    method string Serialize(table item)
        local keys = {}
        for k, _ in pairs(item.mods) do table.insert(keys, k) end
        table.sort(keys)
        local mods = {}
        for _, k in ipairs(keys) do table.insert(mods, k .. "=" .. tostring(item.mods[k])) end
        local text = item.base .. "|" .. tostring(item.rarity) .. "|" .. tostring(item.ilvl) .. "|" .. item.name .. "|" .. table.concat(mods, ",") .. "|" .. tostring(item.sockets) .. "|" .. table.concat(item.runes, ",")
        local meta = item.meta or ""
        if meta ~= "" then
            -- 출처 칸은 잠금 칸 뒤라 개수·잠금 칸을 늘 쓴다 (안 잠김 = 빈 칸)
            text = text .. "|" .. tostring(item.count or 1) .. "|" .. (item.locked == true and "L" or "") .. "|" .. meta
        elseif item.locked == true then
            -- 잠금 칸은 개수 칸 뒤라 개수를 늘 쓴다 (잠금은 겹치지 않는 물건만 — CanLock)
            text = text .. "|" .. tostring(item.count or 1) .. "|L"
        elseif item.count ~= nil and item.count ~= 1 then
            text = text .. "|" .. tostring(item.count)
        end
        return text
    end

    -- ───────── 잠금 (10-29 기획서 45 결정 6-A · 즐겨찾기) ─────────
    -- 잠긴 물건은 팔기·버리기(한 개·여러 개 선택 모두)에서 빠진다. 장비·룬만 (겹치는 물건·귀속 재료는 잠그지 않는다)

    method boolean IsLocked(any s)
        if s == nil or s == "" then return false end
        return self:Parse(s).locked == true
    end

    method boolean CanLock(any s)
        if s == nil or s == "" then return false end
        local base = self:Parse(s).base
        return not self:IsStack(base) and not self:IsSoulbound(base)
    end

    method string WithLock(string s, boolean locked)
        local item = self:Parse(s)
        item.locked = locked
        return self:Serialize(item)
    end

    method boolean SameItem(any a, any b)
        -- 잠금만 다른 같은 물건인가 (창에서 고른 칸을 잠금·해제한 뒤에도 고른 채로 둔다)
        if a == nil or b == nil then return a == b end
        if a == b then return true end
        if self:WithLock(a, false) == self:WithLock(b, false) then return true end
        -- 같은 출처 id(uid)면 같은 물건: 부분·전체 재련으로 옵션·rev만 바뀌어도 창에서 고른 칸을 잃지 않는다 (10-30 I01 · 서버는 늘 문자열 전체로 다시 본다)
        local ma = self:DecodeMeta(self:Parse(a).meta)
        local mb = self:DecodeMeta(self:Parse(b).meta)
        return ma ~= nil and mb ~= nil and ma.uid == mb.uid
    end

    -- ───────── 겹치는 물건 (물약·정수) ─────────

    method any Consumable(string base)
        -- 가방에 겹쳐 넣는 소모품 (shop.csv hp1~3·mp1~3·rv·tp). 아니면 nil
        -- 10-11: 귀환 두루마리(tp)도 물약처럼 가방 물건 (예전에는 PlayerTravel.TownScroll 숫자만 있어 소지품에 안 보였다)
        local c = _GameData:GetShopItem(base)
        if c == nil then return nil end
        if c.kind == "tp" then return c end
        if c.tier <= 0 then return nil end
        if c.kind ~= "hp" and c.kind ~= "mp" and c.kind ~= "rv" then return nil end
        return c
    end

    method boolean IsStack(string base)
        return base == "essence" or base == "abyss_key" or self:Consumable(base) ~= nil
    end

    method boolean IsSoulbound(string base)
        -- 귀속 재료(정수·심연 열쇠): 버리면 파괴되고 거래·판매할 수 없다
        return base == "essence" or base == "abyss_key"
    end

    method integer StackLimit(string base)
        if base == "essence" then return 9999 end
        if base == "abyss_key" then return math.floor(_GameData.depthKeyCap) end
        return 20
    end

    method string StackName(string base)
        if base == "essence" then return "그림자 정수" end
        if base == "abyss_key" then return "심연 열쇠" end
        local c = self:Consumable(base)
        if c ~= nil then return c.name end
        return base
    end

    method string MakeStack(string base, integer count)
        local item = { base = base, rarity = 0, ilvl = 1, name = self:StackName(base), mods = {}, sockets = 0, runes = {}, count = math.max(1, count) }
        return self:Serialize(item)
    end

    method string PotionFor(string kind, integer level)
        -- 몬스터·플레이어 레벨에 맞는 물약 등급: Lv1~9 하급 · 10~29 중급 · 30+ 고급 (회복 물약은 한 등급)
        if kind == "rv" then return "rv" end
        local tier = 1
        if level >= 30 then tier = 3 elseif level >= 10 then tier = 2 end
        return kind .. tostring(tier)
    end

    method string DescribeStack(string s)
        -- 물약·정수 설명
        local item = self:Parse(s)
        if item.base == "essence" then
            return "<color=#D9B8FF>그림자 정수</color>  ×" .. tostring(item.count) .. "\n그림자를 분해하면 얻고, 그림자 강화에 씁니다.\n<color=#FF9A5A>귀속 — 거래·판매할 수 없고 버리면 파괴됩니다</color>"
        end
        if item.base == "abyss_key" then
            -- 10-20 사용자 요청: 열쇠를 누르면 어디에 쓰고 어떻게 얻는지 안내
            return "<color=#FF6B5A>심연 열쇠</color>  ×" .. tostring(item.count) .. " / " .. tostring(math.floor(_GameData.depthKeyCap))
                .. "\n마을의 <color=#FF6B5A>붉은 심도 포탈</color>을 밟으면 하나를 쓰고 심도에 들어갑니다 (근처 파티원도 함께, 열쇠는 한 개만)."
                .. "\n얻는 법: 액트의 마지막 퀘스트를 마치면 1개 · 이후 액트 최종 보스 처치마다 " .. tostring(math.floor(_GameData.depthKeyChance * 100 + 0.5)) .. "%"
                .. "\n최대 " .. tostring(math.floor(_GameData.depthKeyCap)) .. "개까지만 가질 수 있습니다"
                .. "\n<color=#FF9A5A>귀속 — 거래·판매할 수 없고 버리면 파괴됩니다</color>"
        end
        local c = self:Consumable(item.base)
        if c == nil then return item.name end
        if c.kind == "tp" then
            return c.name .. "  ×" .. tostring(item.count) .. "\n마을로 가는 포털을 열고, 포털로 원래 자리에 돌아옵니다\n「사용」하거나 벨트 칸에 넣어 숫자키(모바일은 물약 칸)로 씁니다"
        end
        local effect = {}
        if c.hpFlat > 0 then table.insert(effect, "생명 +" .. tostring(c.hpFlat)) end
        if c.manaFlat > 0 then table.insert(effect, "마나 +" .. tostring(c.manaFlat)) end
        if c.hpPct > 0 then table.insert(effect, "생명 " .. tostring(c.hpPct) .. "%") end
        if c.manaPct > 0 then table.insert(effect, "마나 " .. tostring(c.manaPct) .. "%") end
        return c.name .. "  ×" .. tostring(item.count) .. "\n" .. string.format("%g", _GameData.potionHealSeconds) .. "초에 걸쳐 " .. table.concat(effect, " · ") .. " 회복\n벨트 칸에 넣으면 숫자키(모바일은 물약 칸)로 마십니다 — 가방에서 낮은 등급부터 씁니다 (칸에 그 등급이 보입니다)"
    end

    method string MakeRuneString(string runeId, integer ilvl)
        local r = self:GetRune(runeId)
        local name = runeId
        if r ~= nil then name = r.name end
        return runeId .. "|0|" .. tostring(ilvl) .. "|" .. name .. " 룬||0|"
    end

    method integer IconPixels(string ruid)
        -- 직접 그린 아이콘의 원본 크기(px). 메이플 아이콘처럼 표에 없으면 0 (바닥 아이콘 크기 맞춤용)
        if ruid == "" then return 0 end
        -- 장비 외형 썸네일은 "thumbnail://" + 원래 RUID — 앞부분을 떼고 찾는다
        if string.sub(ruid, 1, 12) == "thumbnail://" then ruid = string.sub(ruid, 13) end
        for _, b in pairs(self:T().Bases) do
            if b.icon == ruid and (b.iconPx or 0) > 0 then return b.iconPx end
        end
        for _, r in pairs(self:T().Runes) do
            if r.icon == ruid and (r.iconPx or 0) > 0 then return r.iconPx end
        end
        _GameData:Ensure()
        for _, c in pairs(_GameData.Shop) do
            if c.icon == ruid and (c.iconPx or 0) > 0 then return c.iconPx end
        end
        return 0
    end

    method boolean IsRune(string s)
        return string.sub(s, 1, 2) == "r_"
    end

    method string IconFor(string s)
        local item = self:Parse(s)
        if item.base == "essence" then return _GameData:GetUiIcon("essence") end
        if item.base == "abyss_key" then return _GameData:GetUiIcon("abyss_key") end
        local c = self:Consumable(item.base)
        if c ~= nil then return c.icon end
        if self:IsRune(item.base) then
            -- 룬마다 그림이 있으면 그 그림 (runes.csv icon), 없으면 공용 룬 그림
            local rune = self:GetRune(item.base)
            if rune ~= nil and (rune.icon or "") ~= "" then return rune.icon end
            return _GameData:GetUiIcon("rune")
        end
        local base = self:GetBase(item.base)
        if base ~= nil and base.icon ~= "" then
            -- 아이콘이 외형 RUID 자체면 썸네일로, 따로 그린 아이콘 그림(잿빛 장막 5종 등)이면 그대로
            if base.avatar ~= nil and base.avatar ~= "" and base.icon == base.avatar then return "thumbnail://" .. base.icon end
            return base.icon
        end
        return _GameConst.IconItem
    end

    method table AppearanceParts(table eq, string candidate)
        -- 착용 외형과 미리보기가 같은 부위 규칙을 쓴다. 가방과 장비 표는 바꾸지 않는다.
        local parts = { armor = "", helm = "", gloves = "", boots = "", weapon = "" }
        for slot, _ in pairs(parts) do
            local item = eq[slot]
            local base = item ~= nil and self:GetBase(self:Parse(item).base) or nil
            if base ~= nil then parts[slot] = base.avatar or "" end
        end
        if candidate ~= "" then
            local base = self:GetBase(self:Parse(candidate).base)
            if base ~= nil and parts[base.slot] ~= nil and base.avatar ~= nil and base.avatar ~= "" then parts[base.slot] = base.avatar end
        end
        if parts.armor == "" then
            local robe = self:GetBase("armor1")
            parts.armor = robe ~= nil and robe.avatar or ""
        end
        return parts
    end

    method boolean HasAppearance(string item)
        -- 장비 그림이 없는 액세서리·등불·룬은 외형이 바뀌는 것처럼 안내하지 않는다.
        if item == "" then return false end
        local base = self:GetBase(self:Parse(item).base)
        if base == nil or base.avatar == nil or base.avatar == "" then return false end
        return base.slot == "armor" or base.slot == "helm" or base.slot == "gloves" or base.slot == "boots" or base.slot == "weapon"
    end

    method boolean IsBound(string s)
        -- 거래 불가: 귀속 재료(정수)만. 완성된 룬워드 장비는 10-12부터 거래할 수 있다 (D2처럼 · docs/design/19 §5)
        local item = self:Parse(s)
        return self:IsSoulbound(item.base)
    end

    method string GetSlot(string s)
        -- 장착 부위 ("" = 장착 불가: 룬·전리품)
        local base = self:GetBase(self:Parse(s).base)
        if base == nil then return "" end
        return base.slot
    end

    method void AddMods(table total, string mods)
        for k, v in string.gmatch(mods, "([%w_]+)=([%-%d%.]+)") do total[k] = (total[k] or 0) + tonumber(v) end
    end

    method table GetTotalMods(string s)
        -- 아이템이 주는 최종 능력치 (베이스 피해·방어 + 옵션 + 룬 + 룬워드)
        local item = self:Parse(s)
        local base = self:GetBase(item.base)
        local total = {}
        if base == nil then return total end
        if base.dmg > 0 then total["dmgFlat"] = base.dmg end
        if base.def > 0 then total["def"] = base.def end
        -- 베이스 고유 옵션 (신발 이동 속도 등, item_bases.csv mods)
        if (base.implicit or "") ~= "" then self:AddMods(total, base.implicit) end
        for k, v in pairs(item.mods) do total[k] = (total[k] or 0) + v end
        for _, rid in ipairs(item.runes) do
            local rune = self:GetRune(rid)
            if rune ~= nil then
                local src = rune.armor
                if base.slot == "weapon" then src = rune.weapon elseif base.slot == "offhand" then src = rune.lamp end
                self:AddMods(total, src)
            end
        end
        local rw = self:GetRuneword(item)
        if rw ~= nil then self:AddMods(total, rw.mods) end
        return total
    end

    -- ───────── 생성 ─────────

    method any GetDropTable(string rank)
        -- 등급별 드롭 표 (drop_tables.csv). 모르는 등급은 normal
        local t = self:T()
        return t.Drops[rank] or t.Drops["normal"]
    end

    method integer RollRarity(string rank, number mf)
        -- 0 일반 / 1 마법 / 2 레어 / 3 유니크 / 4 세트 (룬워드는 등급과 관계없이 부위·소켓 수가 맞는 장비에 룬을 순서대로 끼워 만든다 — GetRuneword · I02 A안)
        -- D2처럼 유니크 → 세트 → 레어 → 마법 순서. 확률(%)은 drop_tables.csv, 아이템 발견은 체감 적용 (최대 ×2.5)
        -- 악몽·지옥 몬스터 드롭은 difficulty.csv dropQualityMul(유니크·세트·레어) · dropMagicMul (DropDiff — LootSystem.RollDrops가 그동안만 켠다, 10-23)
        local d = self:GetDropTable(rank)
        local m = 1 + math.min(1.5, mf / (mf + 100) * 2.5)
        local diff = _GameData:GetDifficulty(self.DropDiff)
        local q = m * ((diff ~= nil and diff.dropQualityMul) or 1)
        local mg = m * ((diff ~= nil and diff.dropMagicMul) or 1)
        local r = _UtilLogic:RandomDouble() * 100
        if r < d.unique * q then return 3 end
        if r < (d.unique + d.set) * q then return 4 end
        if r < (d.unique + d.set + d.rare) * q then return 2 end
        if r < (d.unique + d.set + d.rare) * q + d.magic * mg then return 1 end
        return 0
    end

    method number OldWeight(integer itemLevel, integer ilvl, integer gap)
        -- D2식: 아이템 레벨보다 gap 넘게 낮은 베이스·옵션·유니크는 덜 나온다 (0.3배). 그보다 가까우면 1
        if itemLevel >= ilvl - gap then return 1 end
        return 0.3
    end

    method any WeightedPick(table list, table weights)
        local total = 0
        for _, w in ipairs(weights) do total = total + w end
        if #list == 0 or total <= 0 then return nil end
        local r = _UtilLogic:RandomDouble() * total
        for i, w in ipairs(weights) do
            r = r - w
            if r <= 0 then return list[i] end
        end
        return list[#list]
    end

    method string PickBase(integer ilvl, integer maxReqLevel, string slot)
        -- 아이템 레벨에 맞는 베이스 (요구 레벨 ilvl+3 이하, 40 이상 낮은 단계 제외, 15 넘게 낮으면 덜 나옴)
        -- slot: 빈 글이면 모든 부위 (드롭·일반 보상 — 예전과 같은 후보·추첨), 부위 이름이면 그 부위만 (I01 부위 고르기 보상)
        local t = self:T()
        local list = {}
        local weights = {}
        for _, id in ipairs(t.BaseOrder) do
            local b = t.Bases[id]
            if b.reqLv <= ilvl + 3 and b.reqLv >= ilvl - 40 and (maxReqLevel <= 0 or b.reqLv <= maxReqLevel) and (slot == "" or b.slot == slot) then
                table.insert(list, id)
                table.insert(weights, self:OldWeight(b.reqLv, ilvl, 15))
            end
        end
        if #list == 0 then return t.BaseOrder[1] end
        return self:WeightedPick(list, weights)
    end

    method string Generate(integer ilvl, string rank, number mf)
        -- 드롭 장비 1개 → 문자열. rank = drop_tables.csv 등급 (normal / elite / champion / unique / boss / gamble / quest)
        return self:GenerateWithMinimum(ilvl, rank, mf, 0)
    end

    method string GenerateWithMinimum(integer ilvl, string rank, number mf, integer minimumRarity)
        -- 의뢰가 약속한 일반·마법·희귀 하한(0~2)을 생성 전에 적용한다. 상위 등급은 보존하고 재추첨하지 않는다.
        return self:GenerateEquipment(ilvl, rank, mf, minimumRarity, 0)
    end

    method string GenerateQuestReward(integer playerLevel, string rank, number mf, integer minimumRarity)
        -- 의뢰 보상만 지금 착용 가능한 베이스로 제한한다. 생성 레벨(접사 품질)은 playerLevel + 2를 유지한다.
        return self:GenerateEquipment(playerLevel + 2, rank, mf, minimumRarity, playerLevel)
    end

    method string GenerateEquipment(integer ilvl, string rank, number mf, integer minimumRarity, integer maxReqLevel)
        -- 공통 생성 경로. maxReqLevel 0은 일반 드롭, 양수는 보상 착용 상한이다.
        local t = self:T()
        local baseId = self:PickBase(ilvl, maxReqLevel, "")
        local base = t.Bases[baseId]
        local rarity = self:RollRarity(rank, mf)
        rarity = math.max(rarity, math.max(0, math.min(2, minimumRarity)))
        if rarity == 4 then
            -- 세트: 아이템 레벨에 맞는 세트 조각 하나 (없으면 레어)
            local piece = self:PickSetPiece(ilvl, maxReqLevel, "")
            if piece ~= nil then
                local item = { base = piece.base, rarity = 4, ilvl = ilvl, name = piece.name, mods = {}, sockets = 0, runes = {} }
                self:AddModsRolled(item.mods, piece.mods, 1)
                return self:Serialize(item)
            end
            rarity = 2
        end
        local item = { base = baseId, rarity = rarity, ilvl = ilvl, name = base.name, mods = {}, sockets = 0, runes = {} }
        if rarity == 3 then
            -- 유니크: 아이템 레벨에 맞는 일반 유니크 하나 (보스 전용은 LootSystem이 따로). 없으면 레어
            local u = self:PickUnique(ilvl, "", maxReqLevel, "")
            if u ~= nil then return self:MakeUnique(u, ilvl) end
            item.rarity = 2
            rarity = 2
        end
        -- D2처럼 기본 수치(공격·방어)가 없는 반지·목걸이는 일반 등급이 없다: 최소 마법 (옵션 없는 장신구 방지)
        if rarity == 0 and base.dmg <= 0 and base.def <= 0 then
            rarity = 1
            item.rarity = 1
        end
        if rarity == 0 then
            -- 일반 장비는 소켓이 붙을 수 있다 (룬워드 재료)
            if base.sockets > 0 and _UtilLogic:RandomDouble() < 0.5 then item.sockets = _UtilLogic:RandomIntegerRange(1, base.sockets) end
            return self:Serialize(item)
        end
        self:FillAffixes(item, base, ilvl, rarity)
        return self:Serialize(item)
    end

    -- ───────── 부위 고르기 보상 (10-30 I01 · 기존 gen:3 중요 스토리 보상 5개의 장비 1개) ─────────
    -- 등급은 먼저 한 번 굴려 고정(QuestGearRarity)하고, 그 등급으로 지금 착용 가능한 물건이 있는 부위만 제시한다.
    -- 고른 부위로 같은 규칙(ilvl = 레벨 + 2 · 요구 레벨 ≤ 레벨 · 같은 접사/유니크/세트 표)의 물건 하나 — 추가 지급·능력치 상향 없음.

    method integer QuestGearRarity()
        -- gen:3 보상 등급: GenerateQuestReward(lv, boss, 300, 2)와 같은 굴림 (레어 하한 · 유니크·세트는 그대로)
        return math.max(2, self:RollRarity("boss", 300))
    end

    method boolean HasRewardPool(integer playerLevel, integer rarity, string slot)
        -- 그 등급·부위로 지금 착용 가능한 후보가 있는가 (추첨 없이 표만 본다)
        local t = self:T()
        local ilvl = playerLevel + 2
        if rarity == 3 then
            for _, u in ipairs(t.UniqueList) do
                local b = t.Bases[u.base]
                if u.source == "" and b ~= nil and b.slot == slot and b.reqLv <= ilvl + 3 and b.reqLv <= playerLevel then return true end
            end
            return false
        end
        if rarity == 4 then
            for _, baseId in ipairs(t.SetPieceOrder) do
                local b = t.Bases[baseId]
                if b ~= nil and b.slot == slot and b.reqLv <= ilvl + 3 and b.reqLv >= ilvl - 40 and b.reqLv <= playerLevel then return true end
            end
            return false
        end
        for _, id in ipairs(t.BaseOrder) do
            local b = t.Bases[id]
            if b.slot == slot and b.reqLv <= ilvl + 3 and b.reqLv >= ilvl - 40 and b.reqLv <= playerLevel then return true end
        end
        return false
    end

    method table RewardSlotsFor(integer playerLevel, integer rarity)
        -- 그 등급으로 후보가 있는 부위 (RewardSlotOrder 순서)
        local out = {}
        for slot in string.gmatch(self.RewardSlotOrder, "[^,]+") do
            if self:HasRewardPool(playerLevel, rarity, slot) then table.insert(out, slot) end
        end
        return out
    end

    method string GenerateQuestSlotReward(integer playerLevel, string slot, integer rarity)
        -- 고른 부위·고정 등급으로 보상 장비 하나. 그 부위에 그 등급 후보가 없으면 빈 글 (등급을 몰래 낮추지 않는다 — 제시할 때 후보 있는 부위만 고르게 한다)
        local t = self:T()
        local ilvl = playerLevel + 2
        if not self:HasRewardPool(playerLevel, rarity, slot) then return "" end
        if rarity == 4 then
            local piece = self:PickSetPiece(ilvl, playerLevel, slot)
            if piece == nil then return "" end
            local made = { base = piece.base, rarity = 4, ilvl = ilvl, name = piece.name, mods = {}, sockets = 0, runes = {} }
            self:AddModsRolled(made.mods, piece.mods, 1)
            return self:Serialize(made)
        end
        if rarity == 3 then
            local u = self:PickUnique(ilvl, "", playerLevel, slot)
            if u == nil then return "" end
            return self:MakeUnique(u, ilvl)
        end
        if rarity ~= 2 then return "" end
        local baseId = self:PickBase(ilvl, playerLevel, slot)
        local base = t.Bases[baseId]
        if base == nil or base.slot ~= slot then return "" end
        local item = { base = baseId, rarity = 2, ilvl = ilvl, name = base.name, mods = {}, sockets = 0, runes = {} }
        self:FillAffixes(item, base, ilvl, 2)
        return self:Serialize(item)
    end

    method string SlotLabel(string slot)
        -- 부위 이름 (카드·안내)
        local names = { weapon = "무기", offhand = "등불", helm = "투구", armor = "갑옷", gloves = "장갑", boots = "신발", belt = "허리띠", amulet = "목걸이", ring = "반지" }
        return names[slot] or slot
    end

    method void FillAffixes(table item, any base, integer ilvl, integer rarity)
        -- 마법(접두·접미 1~2개)·레어(3~5개) 옵션과 이름을 새로 굴린다. 드롭 생성과 대장장이 「옵션 바꾸기」가 같이 쓴다
        local prefixes, suffixes = 1, 1
        if rarity == 1 then
            if _UtilLogic:RandomDouble() < 0.4 then
                if _UtilLogic:RandomDouble() < 0.5 then prefixes = 0 else suffixes = 0 end
            end
        else
            -- 레어 3~5개 (10-10 QA: 유니크와의 차이를 위해 4~6에서 줄임)
            local count = _UtilLogic:RandomIntegerRange(3, 5)
            prefixes = _UtilLogic:RandomIntegerRange(math.max(1, count - 3), math.min(3, count - 1))
            suffixes = count - prefixes
        end
        local used = {}
        local pName, sName = "", ""
        -- 출처 기록 (I01 부분 재련): 뽑힌 접사 id·값을 순서대로. 기록만 할 뿐 추첨 횟수·순서는 그대로 (F01 보존)
        local prov = {}
        local traced = true
        for pass = 1, 2 do
            local want = prefixes
            if pass == 2 then want = suffixes end
            for i = 1, want do
                local a = self:PickAffix(pass == 1, base.slot, ilvl, used)
                -- 레어: 한쪽 후보가 고갈되면 남은 쪽으로 재배분한다. 새 옵션·중복 옵션은 만들지 않는다.
                -- 고갈 때만 접두/접미 각각 3개 제한을 풀어 최초 추첨한 총 3~5개를 채운다.
                if a == nil and rarity == 2 then a = self:PickAffix(pass ~= 1, base.slot, ilvl, used) end
                if a ~= nil then
                    used[a.stat .. tostring(a.prefix)] = true
                    local roll = self:RollAffix(a, ilvl)
                    item.mods[a.stat] = (item.mods[a.stat] or 0) + roll
                    table.insert(prov, { id = a.id, val = roll })
                    if a.prefix and pName == "" then pName = a.name end
                    if not a.prefix and sName == "" then sName = a.name end
                end
            end
        end
        -- 옵션 추첨이 비었으면(부위에 맞는 접사가 없을 때) 접두·접미를 번갈아 다시 고른다. 그래도 없으면 작은 기본 옵션
        local tries = 0
        while next(item.mods) == nil and tries < 6 do
            tries = tries + 1
            local a = self:PickAffix(tries % 2 == 1, base.slot, ilvl, used)
            if a == nil then a = self:PickAffix(tries % 2 == 1, "any", ilvl, used) end
            if a ~= nil then
                local roll = self:RollAffix(a, ilvl)
                item.mods[a.stat] = roll
                table.insert(prov, { id = a.id, val = roll })
                if a.prefix and pName == "" then pName = a.name elseif not a.prefix and sName == "" then sName = a.name end
            end
        end
        if next(item.mods) == nil then
            item.mods["life"] = _UtilLogic:RandomIntegerRange(3, 6 + math.floor(ilvl / 3))
            traced = false   -- 접사 표에 없는 기본 옵션: 출처를 꾸며 적지 않는다
        end
        if rarity == 1 then
            local n = base.name
            if pName ~= "" then n = pName .. " " .. n end
            if sName ~= "" then n = sName .. " " .. n end
            item.name = n
        else
            item.name = self:RareName() .. " " .. base.name
        end
        item.meta = self:ProvenanceMeta(item, prov, traced)
    end

    -- ───────── 대장장이 (옵션 바꾸기 · 소켓 뚫기) ─────────

    method boolean CanReroll(string s)
        -- 마법·레어 장비만 (일반은 옵션이 없고, 유니크·세트·룬워드는 고정 옵션)
        if s == "" then return false end
        local item = self:Parse(s)
        if self:GetBase(item.base) == nil then return false end
        if item.rarity ~= 1 and item.rarity ~= 2 then return false end
        -- 부분 재련 결과(기존/새)를 고르기 전에는 다른 작업을 받지 않는다 (I01)
        if self:HasPendingReroll(s) then return false end
        return self:GetRuneword(item) == nil
    end

    method integer RerollCost(string s)
        local item = self:Parse(s)
        local cost = 40 + item.ilvl * 12
        if item.rarity == 2 then cost = cost * 3 end
        return cost
    end

    method string RerollMods(string s)
        -- 같은 베이스·등급·아이템 레벨·소켓·룬·잠금은 그대로, 옵션과 이름만 새로.
        --   출처 칸: 같은 uid · rev+1 · 고정 줄 초기화 (모든 옵션이 새로 바뀌어 예전 옵션을 남기는 길이 없다). 예전 물건도 이때부터 출처가 생긴다
        local item = self:Parse(s)
        local base = self:GetBase(item.base)
        item.mods = {}
        self:FillAffixes(item, base, item.ilvl, item.rarity)
        return self:Serialize(item)
    end

    method boolean CanPunch(string s)
        -- 소켓이 없는 장비 중 소켓을 가질 수 있는 베이스(무기·등불·투구·갑옷)
        if s == "" then return false end
        local item = self:Parse(s)
        local base = self:GetBase(item.base)
        if self:HasPendingReroll(s) then return false end
        return base ~= nil and base.sockets > 0 and item.sockets == 0 and #item.runes == 0
    end

    method integer PunchCost(string s)
        return 150 + self:Parse(s).ilvl * 25
    end

    method string PunchSockets(string s)
        -- D2 대장장이처럼: 일반은 2~최대, 마법은 1~2, 레어·유니크·세트는 1
        local item = self:Parse(s)
        local base = self:GetBase(item.base)
        local n = 1
        if item.rarity == 0 then n = _UtilLogic:RandomIntegerRange(math.min(2, base.sockets), base.sockets)
        elseif item.rarity == 1 then n = _UtilLogic:RandomIntegerRange(1, math.min(2, base.sockets)) end
        item.sockets = n
        return self:Serialize(item)
    end

    -- ───────── 출처 메타데이터 · 부분 재련 (10-30 I01 · goal-items-execution-0030) ─────────
    -- 마법·레어 장비의 옵션 한 줄만 같은 종류(접두/접미)·부위·아이템 레벨·난이도 단계 후보로 다시 새긴다.
    -- 다른 줄·베이스·등급·ilvl·이름(레어)·소켓·룬·잠금은 그대로. 첫 유료 시도에 그 줄이 고정되고, 결과는 기존 유지/새 옵션 채택 중 고른다.
    -- 출처 칸(10번째)이 있는 물건만 (새로 만든 것 · 사용자가 고른 전체 재련 뒤). 예전 물건의 합산 옵션을 접사로 쪼개 추정하지 않는다.

    method string Base36(integer n)
        -- 0 이상 정수 → 36진 글자 (출처 id용)
        local digits = "0123456789abcdefghijklmnopqrstuvwxyz"
        local v = math.max(0, math.floor(n))
        if v == 0 then return "0" end
        local out = ""
        while v > 0 do
            local d = v % 36
            out = string.sub(digits, d + 1, d + 1) .. out
            v = math.floor((v - d) / 36)
        end
        return out
    end

    method string NewItemUid()
        -- 서버가 새로 만든 장비의 id: 시각(초) 36진 + 순번. 무작위 추첨을 쓰지 않는다 (드롭·재련 추첨 순서 보존)
        self.UidSeq = self.UidSeq + 1
        local now = math.floor(DateTime.UtcNow.Elapsed / 1000) % 2176782336
        local seq = self:Base36(self.UidSeq % 1296)
        if string.len(seq) < 2 then seq = "0" .. seq end
        return self:Base36(now) .. seq
    end

    method any AffixRow(string id)
        -- 접사 id → item_affixes.csv 행 (없으면 nil)
        if next(self.AffixById) == nil then
            for _, a in ipairs(self:T().Affixes) do if a.id ~= nil then self.AffixById[a.id] = a end end
        end
        return self.AffixById[id]
    end

    method any DecodeMeta(string m)
        -- 10번째 칸 → { uid, rev, line, affixes = { {id, val} … }, pending = {id, val} 또는 nil }. 모르는 형식·버전이면 nil (건드리지 않는다)
        if m == nil or m == "" then return nil end
        local f = {}
        for part in string.gmatch(m .. ":", "([^:]*):") do table.insert(f, part) end
        if f[1] ~= "A1" or #f ~= 6 or f[2] == "" then return nil end
        local meta = { uid = f[2], rev = math.floor(tonumber(f[3]) or 0), line = math.floor(tonumber(f[4]) or 0), affixes = {}, pending = nil }
        for id, v in string.gmatch(f[5], "([%w_]+)%*(%-?%d+)") do table.insert(meta.affixes, { id = id, val = math.floor(tonumber(v)) }) end
        local pid, pv = string.match(f[6], "^([%w_]+)%*(%-?%d+)$")
        if pid ~= nil then meta.pending = { id = pid, val = math.floor(tonumber(pv)) } end
        if #meta.affixes == 0 or meta.line < 0 or meta.line > #meta.affixes then return nil end
        if meta.pending ~= nil and meta.line == 0 then return nil end
        return meta
    end

    method string EncodeMeta(table meta)
        -- DecodeMeta의 반대. 글자: 영문·숫자·_ : * + - 만 (가방·장비 요약의 구분자 세미콜론·꺾쇠·세로줄을 쓰지 않는다)
        local parts = {}
        for _, a in ipairs(meta.affixes) do table.insert(parts, a.id .. "*" .. tostring(math.floor(a.val))) end
        local pend = ""
        if meta.pending ~= nil then pend = meta.pending.id .. "*" .. tostring(math.floor(meta.pending.val)) end
        return "A1:" .. meta.uid .. ":" .. tostring(math.floor(meta.rev)) .. ":" .. tostring(math.floor(meta.line)) .. ":" .. table.concat(parts, "+") .. ":" .. pend
    end

    method string ProvenanceMeta(table item, table prov, boolean traced)
        -- FillAffixes가 뽑은 접사 기록 → 출처 칸. 기록과 합산 옵션이 정확히 맞을 때만 (같은 능력치를 두 접사가 나눠 가지면 "" — 한 줄로 볼 수 없다)
        --   이미 출처가 있던 물건(전체 재련)은 같은 uid · rev+1 · 고정 줄 초기화
        if not traced or #prov == 0 then return "" end
        local seen = {}
        for _, p in ipairs(prov) do
            local row = nil
            if p.id ~= nil then row = self:AffixRow(p.id) end
            if row == nil or seen[row.stat] then return "" end
            seen[row.stat] = true
            if item.mods[row.stat] ~= p.val then return "" end
        end
        for k, _ in pairs(item.mods) do if not seen[k] then return "" end end
        local old = self:DecodeMeta(item.meta or "")
        local meta = { uid = "", rev = 0, line = 0, affixes = prov, pending = nil }
        if old ~= nil then
            meta.uid = old.uid
            meta.rev = old.rev + 1
        else
            meta.uid = self:NewItemUid()
        end
        return self:EncodeMeta(meta)
    end

    method boolean MetaMatches(table item, table meta)
        -- 출처 기록이 지금 옵션과 정확히 맞는가 (줄마다 다른 능력치 · 값 같음 · 기록 밖 옵션 없음)
        local seen = {}
        for _, a in ipairs(meta.affixes) do
            local row = self:AffixRow(a.id)
            if row == nil or seen[row.stat] or item.mods[row.stat] ~= a.val then return false end
            seen[row.stat] = true
        end
        for k, _ in pairs(item.mods) do if not seen[k] then return false end end
        if meta.pending ~= nil and self:AffixRow(meta.pending.id) == nil then return false end
        return true
    end

    method table PartialState(string s)
        -- 부분 재련 판정 → { ok, reason, item, meta }. reason: base(장비 아님) · grade(마법·레어만) · runeword(완성 룬워드) · legacy(출처 없음) · mismatch(기록과 옵션이 다름)
        local out = { ok = false, reason = "base", item = nil, meta = nil }
        if s == nil or s == "" then return out end
        local item = self:Parse(s)
        out.item = item
        if self:GetBase(item.base) == nil then return out end
        if item.rarity ~= 1 and item.rarity ~= 2 then
            out.reason = "grade"
            return out
        end
        if self:GetRuneword(item) ~= nil then
            out.reason = "runeword"
            return out
        end
        local meta = self:DecodeMeta(item.meta)
        if meta == nil then
            out.reason = "legacy"
            return out
        end
        out.meta = meta
        if not self:MetaMatches(item, meta) then
            out.reason = "mismatch"
            return out
        end
        out.ok = true
        out.reason = ""
        return out
    end

    method boolean HasPendingReroll(any s)
        -- 부분 재련 결과를 아직 고르지 않은 물건 (옮기기·창고·장착·소켓·잠금·판매·다른 재련을 막는다)
        if s == nil or s == "" then return false end
        local meta = self:DecodeMeta(self:Parse(s).meta)
        return meta ~= nil and meta.pending ~= nil
    end

    method integer PartialRerollCost(string s)
        -- 한 줄 바꾸기 1회 시도 값 = 지금 전체 재련 값 × partialRerollMul (config.csv · 10-30 권장 1.0). 기존 결과를 남겨도 돌려주지 않는다
        return math.max(1, math.floor(self:RerollCost(s) * _GameData.partialRerollMul + 0.5))
    end

    method table PartialPool(table item, table meta, integer line)
        -- 그 줄을 대신할 합법 후보: 같은 종류(접두/접미) · 지금 부위 · 아이템 레벨 · 난이도 단계 · 가중치 모두 드롭과 같은 규칙(AffixPool).
        --   다른 줄이 가진 능력치는 접두·접미 모두 뺀다 (합쳐지거나 줄이 사라지지 않게). 그 줄 자신의 능력치는 다시 나올 수 있다 (값 다시 굴리기)
        local empty = { list = {}, weights = {} }
        if line < 1 or line > #meta.affixes then return empty end
        local row = self:AffixRow(meta.affixes[line].id)
        local base = self:GetBase(item.base)
        if row == nil or base == nil then return empty end
        local used = {}
        for i, a in ipairs(meta.affixes) do
            local r = self:AffixRow(a.id)
            if i ~= line and r ~= nil then
                used[r.stat .. "true"] = true
                used[r.stat .. "false"] = true
            end
        end
        return self:AffixPool(row.prefix, base.slot, item.ilvl, used)
    end

    method integer PartialPoolSize(string s, integer line)
        -- 그 줄의 합법 후보 수 (0이면 시도할 수 없다 — 골드를 받지 않는다)
        local st = self:PartialState(s)
        if not st.ok then return 0 end
        return #self:PartialPool(st.item, st.meta, line).list
    end

    method string RollPartial(string s, integer line)
        -- 고른 줄의 새 후보를 굴려 대기(pending)로 적는다 · 줄 고정 · rev+1. 조건이 안 맞거나 후보가 없으면 빈 글 (서버는 빈 글이면 골드를 받지 않는다)
        local st = self:PartialState(s)
        if not st.ok or st.meta.pending ~= nil then return "" end
        local meta = st.meta
        if line < 1 or line > #meta.affixes or (meta.line > 0 and meta.line ~= line) then return "" end
        local pool = self:PartialPool(st.item, meta, line)
        if #pool.list == 0 then return "" end
        local a = self:WeightedPick(pool.list, pool.weights)
        if a == nil then return "" end
        meta.pending = { id = a.id, val = self:RollAffix(a, st.item.ilvl) }
        meta.line = line
        meta.rev = meta.rev + 1
        st.item.meta = self:EncodeMeta(meta)
        return self:Serialize(st.item)
    end

    method string MagicName(table meta, string baseName)
        -- 마법 장비 이름: 첫 접두 이름 + 첫 접미 이름 + 베이스 (FillAffixes와 같은 규칙)
        local pName, sName = "", ""
        for _, a in ipairs(meta.affixes) do
            local row = self:AffixRow(a.id)
            if row ~= nil then
                if row.prefix and pName == "" then pName = row.name end
                if not row.prefix and sName == "" then sName = row.name end
            end
        end
        local n = baseName
        if pName ~= "" then n = pName .. " " .. n end
        if sName ~= "" then n = sName .. " " .. n end
        return n
    end

    method string ResolvePartial(string s, boolean accept)
        -- 대기 중 후보를 채택(accept)하거나 버린다(기존 유지). 골드는 더 받지 않는다 · 줄 고정은 그대로 · rev+1. 대기가 없으면 빈 글
        local st = self:PartialState(s)
        if not st.ok or st.meta.pending == nil then return "" end
        local meta = st.meta
        local item = st.item
        if accept then
            local old = self:AffixRow(meta.affixes[meta.line].id)
            local fresh = self:AffixRow(meta.pending.id)
            if old == nil or fresh == nil then return "" end
            item.mods[old.stat] = nil
            item.mods[fresh.stat] = meta.pending.val
            meta.affixes[meta.line] = { id = meta.pending.id, val = meta.pending.val }
            if item.rarity == 1 then
                local base = self:GetBase(item.base)
                if base ~= nil then item.name = self:MagicName(meta, base.name) end
            end
        end
        meta.pending = nil
        meta.rev = meta.rev + 1
        item.meta = self:EncodeMeta(meta)
        return self:Serialize(item)
    end

    method string AffixLineText(string id, integer val)
        -- 한 줄 표시 「접두 · 피해 +25%」
        local row = self:AffixRow(id)
        if row == nil then return id end
        local side = "접미"
        if row.prefix then side = "접두" end
        return side .. " · " .. self:StatValueText(row.stat, val)
    end

    method string PartialText(string s, integer pick)
        -- 대장간 설명 칸: 줄 목록(고른 줄 ▶ · 고정 줄 표시) · 대기 중이면 기존 → 새 후보. 출처가 없으면 이유 한 줄
        local st = self:PartialState(s)
        local head = "<color=#FFD27A>한 줄 바꾸기</color>  "
        if not st.ok then
            local why = "마법·레어 장비만 할 수 있습니다."
            if st.reason == "legacy" then why = "출처 기록이 없는 장비입니다. 「옵션 바꾸기」를 한 뒤부터 할 수 있습니다." end
            if st.reason == "runeword" then why = "완성된 룬워드는 옵션을 바꿀 수 없습니다." end
            if st.reason == "mismatch" then why = "기록과 옵션이 달라 한 줄만 바꿀 수 없습니다." end
            return head .. "<color=#A8A090>" .. why .. "</color>"
        end
        local meta = st.meta
        local lines = {}
        local marks = { "①", "②", "③", "④", "⑤", "⑥" }
        for i, a in ipairs(meta.affixes) do
            local text = (marks[i] or tostring(i)) .. " " .. self:AffixLineText(a.id, a.val)
            if meta.line == i then
                text = "<color=#FFD27A>▶ " .. text .. "  (고정된 줄)</color>"
            elseif meta.line == 0 and pick == i then
                text = "<color=#FFD27A>▶ " .. text .. "</color>"
            else
                text = "    " .. text
            end
            table.insert(lines, text)
        end
        if meta.pending ~= nil then
            local cur = meta.affixes[meta.line]
            table.insert(lines, "<color=#E0B87A>기존: " .. self:AffixLineText(cur.id, cur.val) .. "</color>")
            table.insert(lines, "<color=#5AE65A>새 후보: " .. self:AffixLineText(meta.pending.id, meta.pending.val) .. "</color>")
            return head .. "<color=#A8A090>새 옵션 채택 또는 기존 유지를 골라 주세요. 골드는 더 들지 않습니다.</color>\n" .. table.concat(lines, "\n")
        end
        local note = "첫 시도에 고른 줄이 이 장비의 고정 줄이 됩니다"
        if meta.line > 0 then note = "고정된 줄만 다시 새깁니다" end
        return head .. "<color=#A8A090>" .. note .. " · 시도마다 " .. tostring(self:PartialRerollCost(s)) .. " 골드</color>\n" .. table.concat(lines, "\n")
    end

    method integer SortRank(string s)
        -- 가방 정렬 순서: 유니크 · 세트 · 레어 · 마법 · 일반 장비 · 룬 · 물약 · 귀속 재료
        local item = self:Parse(s)
        if self:IsSoulbound(item.base) then return 8 end
        if self:Consumable(item.base) ~= nil then return 7 end
        if self:IsRune(item.base) then return 6 end
        local order = { [3] = 1, [4] = 2, [2] = 3, [1] = 4, [0] = 5 }
        return order[item.rarity] or 5
    end

    method any PickUnique(integer ilvl, string source, integer maxReqLevel, string slot)
        -- source = "" 이면 어디서나 나오는 유니크, 몬스터 sourceId면 그 몬스터 전용 · slot 빈 글 = 모든 부위 (I01 부위 고르기 보상만 부위를 준다)
        -- 쏠림 막기 (docs/design/19 §2-4): 먼저 계열(소환·영혼·저주·범용)을 1:1:1:1로 고르고, 그 계열 안에서 가중치로 고른다
        local t = self:T()
        local byTree = {}
        local trees = {}
        for _, u in ipairs(t.UniqueList) do
            local b = t.Bases[u.base]
            if u.source == source and b ~= nil and b.reqLv <= ilvl + 3 and (maxReqLevel <= 0 or b.reqLv <= maxReqLevel) and (slot == "" or b.slot == slot) then
                local tree = u.tree or "any"
                if byTree[tree] == nil then
                    byTree[tree] = { list = {}, weights = {} }
                    table.insert(trees, tree)
                end
                table.insert(byTree[tree].list, u)
                -- weight(item_uniques.csv)가 1보다 작으면 다른 유니크보다 그만큼 덜 나온다 (잿빛 장막 5종 0.15 = 가장 희귀)
                table.insert(byTree[tree].weights, self:OldWeight(b.reqLv, ilvl, 25) * (u.weight or 1))
            end
        end
        if #trees == 0 then return nil end
        if source ~= "" then
            -- 보스 전용: 계열 대신 그 난이도에서 나올 수 있는 가장 높은 등급만 (지옥 보스가 일반형 전용 유니크를 주지 않게)
            local top = -1
            for _, tree in ipairs(trees) do
                for _, u in ipairs(byTree[tree].list) do top = math.max(top, t.Bases[u.base].grade or 0) end
            end
            local list, weights = {}, {}
            for _, tree in ipairs(trees) do
                for i, u in ipairs(byTree[tree].list) do
                    if (t.Bases[u.base].grade or 0) == top then
                        table.insert(list, u)
                        table.insert(weights, byTree[tree].weights[i])
                    end
                end
            end
            return self:WeightedPick(list, weights)
        end
        local pool = byTree[trees[_UtilLogic:RandomIntegerRange(1, #trees)]]
        return self:WeightedPick(pool.list, pool.weights)
    end

    method string MakeUnique(table u, integer ilvl)
        -- 유니크 수치는 표기 × gearMult의 uniqueRollMin~100% 사이에서 무작위 (같은 유니크도 좋고 나쁜 것이 있다)
        local item = { base = u.base, rarity = 3, ilvl = ilvl, name = u.name, mods = {}, sockets = 0, runes = {} }
        -- 유니크는 같은 부위 레어보다 확실히 세게 (uniqueStatMul) + 유니크만의 고유 효과(special: 모든 스킬·배치 한도·소환수 독…)
        self:AddModsRolled(item.mods, u.mods, _GameData.uniqueStatMul)
        for k, v in string.gmatch(u.special or "", "([%w_]+)=([%-%d%.]+)") do item.mods[k] = (item.mods[k] or 0) + (tonumber(v) or 0) end
        return self:Serialize(item)
    end

    method string GradeName(integer grade)
        -- 베이스 등급 이름: 0 일반형 · 1 강화형 · 2 정예형 (D2의 일반·익셉셔널·엘리트)
        if grade == 2 then return "<color=#E0B0FF>정예형</color>" end
        if grade == 1 then return "<color=#9FD3FF>강화형</color>" end
        return "일반형"
    end

    method integer TierOfLevel(integer ilvl)
        -- 아이템 레벨이 속한 난이도 구간 (difficulty.csv levelFrom — 10-20: 보통 1~40 · 악몽 41~70 · 지옥 71~)
        if ilvl >= _GameData:GetDifficulty(2).levelFrom then return 2 end
        if ilvl >= _GameData:GetDifficulty(1).levelFrom then return 1 end
        return 0
    end

    method number GearTier(integer ilvl)
        -- D2처럼 난이도(아이템 레벨)마다 무작위 옵션 최대치가 다르다
        local tier = self:TierOfLevel(ilvl)
        if tier == 0 then return _GameData.gearTierNormal end
        if tier == 1 then return _GameData.gearTierNightmare end
        return 1
    end

    method boolean IsCountStat(string key)
        -- 개수형 보너스(그림자 상한·배치 한도)는 줄이지 않는다
        return key == "shadowCap" or key == "deploy" or key == "allSkills" or string.sub(key, 1, 4) == "tree" or string.sub(key, 1, 3) == "sk_"
    end

    method number LevelProgress(integer ilvl)
        -- 같은 난이도 안에서 아이템 레벨이 어디쯤인지 0~1 (difficulty.csv levelFrom~levelTo)
        local d = _GameData:GetDifficulty(self:TierOfLevel(ilvl))
        return math.max(0, math.min(1, (ilvl - d.levelFrom) / math.max(1, d.levelTo - d.levelFrom)))
    end

    method integer RollAffix(any a, integer ilvl)
        -- 접사 값: [min, max] × gearMult × gearTierNormal. 난이도마다 따로 수치 구간을 가진 행(tier 0 보통 · 1 악몽 · 2 지옥)이 있다 (docs/design/19)
        --   같은 난이도에서도 레벨이 높을수록 범위의 위쪽에서 굴린다 (난이도 첫 레벨 = 아래 40% 안, 끝 레벨 = 위 40% 안)
        local scale = _GameData.gearMult * _GameData.gearTierNormal
        -- 이동 속도·레벨형(스킬 +N)은 고정 수치형 옵션 — 배율을 곱하지 않는다
        if a.stat == "ms" or self:IsCountStat(a.stat) then scale = 1 end
        local lo = math.max(1, math.floor(a.min * scale))
        local hi = math.max(lo, math.floor(a.max * scale + 0.5))
        local t = self:LevelProgress(ilvl)
        local fromK, toK = 0.6 * t, 0.4 + 0.6 * t
        local from = math.floor(lo + (hi - lo) * fromK)
        local to = math.max(from, math.floor(lo + (hi - lo) * toK + 0.5))
        return _UtilLogic:RandomIntegerRange(from, to)
    end

    method void AddModsRolled(table total, string mods, number mult)
        -- 유니크·세트 조각: 표기 × gearMult × mult × (uniqueRollMin~1) 무작위, 개수형은 그대로
        local extra = mult or 1
        if extra <= 0 then extra = 1 end
        for k, v in string.gmatch(mods, "([%w_]+)=([%-%d%.]+)") do
            local value = tonumber(v)
            if value < 0 then
                -- 단점 옵션 (쓸모없는 유니크의 「독 저항 -10」 등): 굴리지 않고 그대로 깎는다 (예전엔 1로 올라가 +1이 됐다)
                value = -math.max(1, math.floor(-value * _GameData.gearMult * extra + 0.5))
            elseif not self:IsCountStat(k) then
                local roll = _GameData.uniqueRollMin + (1 - _GameData.uniqueRollMin) * _UtilLogic:RandomDouble()
                value = math.max(1, math.floor(value * _GameData.gearMult * extra * roll + 0.5))
            end
            total[k] = (total[k] or 0) + value
        end
    end

    method string ScaleMods(string mods)
        -- 세트 효과 표기를 gearMult로 줄인 문자열 (실제 적용과 설명이 같은 값을 쓴다)
        local parts = {}
        for k, v in string.gmatch(mods, "([%w_]+)=([%-%d%.]+)") do
            local value = tonumber(v)
            if value < 0 then value = -math.max(1, math.floor(-value * _GameData.gearMult + 0.5))
            elseif not self:IsCountStat(k) then value = math.max(1, math.floor(value * _GameData.gearMult + 0.5)) end
            table.insert(parts, k .. "=" .. tostring(math.floor(value)))
        end
        return table.concat(parts, ",")
    end

    method any PickSetPiece(integer ilvl, integer maxReqLevel, string slot)
        -- 쏠림 막기 (docs/design/19 §2-4): 먼저 세트를 고르고(조각이 하나라도 나올 수 있는 세트끼리 같은 확률), 그다음 그 세트의 조각을 고른다
        local t = self:T()
        local bySet = {}
        local sets = {}
        for _, baseId in ipairs(t.SetPieceOrder) do
            local b = t.Bases[baseId]
            local piece = t.SetPieces[baseId]
            if b ~= nil and b.reqLv <= ilvl + 3 and b.reqLv >= ilvl - 40 and (maxReqLevel <= 0 or b.reqLv <= maxReqLevel) and (slot == "" or b.slot == slot) then
                if bySet[piece.set] == nil then
                    bySet[piece.set] = { list = {}, weights = {} }
                    table.insert(sets, piece.set)
                end
                table.insert(bySet[piece.set].list, piece)
                table.insert(bySet[piece.set].weights, self:OldWeight(b.reqLv, ilvl, 25))
            end
        end
        if #sets == 0 then return nil end
        local pool = bySet[sets[_UtilLogic:RandomIntegerRange(1, #sets)]]
        return self:WeightedPick(pool.list, pool.weights)
    end

    method any GetSetPiece(table item)
        -- 세트 조각이면 { set, base, name, mods }
        if item.rarity ~= 4 then return nil end
        return self:T().SetPieces[item.base]
    end

    method table GetSetBonusMods(string setId, integer count)
        -- 착용한 조각 수에 따른 세트 효과 합계 (2개 / 3개 / 전체)
        local total = {}
        local set = self:T().Sets[setId]
        if set == nil then return total end
        if count >= 2 then self:AddMods(total, self:ScaleMods(set.bonus2)) end
        if count >= 3 then self:AddMods(total, self:ScaleMods(set.bonus3)) end
        if count >= set.pieces then self:AddMods(total, self:ScaleMods(set.full)) end
        return total
    end

    method any PickAffix(boolean prefix, string slot, integer ilvl, table used)
        -- 후보 표(AffixPool)에서 가중치로 하나. 후보가 없으면 nil
        local pool = self:AffixPool(prefix, slot, ilvl, used)
        if #pool.list == 0 then return nil end
        return self:WeightedPick(pool.list, pool.weights)
    end

    method table AffixPool(boolean prefix, string slot, integer ilvl, table used)
        -- 아이템 레벨보다 15 넘게 낮은 옵션은 덜 나온다 (상위 옵션이 묽어지지 않게)
        -- 난이도 구간(tier): 아이템 레벨의 난이도 행이 기본, 한 단계 아래 행은 1/4 확률, 그보다 아래는 안 나온다 (docs/design/19)
        -- 드롭·전체 재련(PickAffix)과 부분 재련(PartialPool)이 같은 후보 규칙을 쓴다. 표만 만들고 추첨하지 않는다
        local pool = {}
        local weights = {}
        local tier = self:TierOfLevel(ilvl)
        for _, a in ipairs(self:T().Affixes) do
            if a.prefix == prefix and a.ilvl <= ilvl and not used[a.stat .. tostring(a.prefix)] and a.tier >= tier - 1 and a.tier <= tier
                and (a.slots == "any" or string.find("," .. a.slots .. ",", "," .. slot .. ",", 1, true) ~= nil) then
                table.insert(pool, a)
                local w = self:OldWeight(a.ilvl, ilvl, 15)
                if a.tier < tier then w = w * 0.25 end
                -- 신발의 이동 속도 옵션은 더 자주 (bootsMoveMult)
                if a.stat == "ms" and slot == "boots" then w = w * _GameData.bootsMoveMult end
                table.insert(weights, w)
            end
        end
        return { list = pool, weights = weights }
    end

    method string RareName()
        local a = { "철혼", "잿더미", "망령", "흑요", "피안", "흉조", "서리", "황혼", "해골", "적막" }
        local b = { "의 송곳", "의 장막", "의 굴레", "의 손톱", "의 맹세", "의 눈", "의 비명", "의 그늘" }
        return a[_UtilLogic:RandomIntegerRange(1, #a)] .. b[_UtilLogic:RandomIntegerRange(1, #b)]
    end

    method string MakeRune(integer monLevel)
        -- 몬스터 레벨(난이도 가산 포함)로 열린 룬 중 하나. 가중치는 data/runes.csv dropWeight (상위 등급일수록 드묾)
        local t = self:T()
        local total = 0
        local list = {}
        for _, id in ipairs(t.RuneOrder) do
            local r = t.Runes[id]
            if r.minLevel <= monLevel then
                local w = r.weight
                total = total + w
                table.insert(list, { id = id, w = w })
            end
        end
        local pick = t.RuneOrder[1]
        local roll = _UtilLogic:RandomDouble() * total
        for _, e in ipairs(list) do
            roll = roll - e.w
            if roll <= 0 then
                pick = e.id
                break
            end
        end
        return self:MakeRuneString(pick, monLevel)
    end

    method integer SellValue(string s)
        -- 팔 때 받는 골드. 장비는 기준 값 × sellValueMult (10-24 사용자 G-B: 0.7 — 소모품·룬은 그대로)
        local item = self:Parse(s)
        if self:IsSoulbound(item.base) then return 0 end
        local c = self:Consumable(item.base)
        if c ~= nil then return math.max(1, math.floor(c.price / 4)) * item.count end
        if self:IsRune(item.base) then return 20 + item.ilvl * 2 end
        return math.max(1, math.floor(self:BaseValue(s) * _GameData.sellValueMult))
    end

    method integer BaseValue(string s)
        -- 장비 기준 값 (판매가 배율 적용 전) — 떠돌이 상인 가격의 바탕 (PlayerShop.StockPrice)
        local item = self:Parse(s)
        return math.floor((10 + item.ilvl * 3) * (1 + item.rarity * 2))
    end

    -- ───────── 표시 ─────────

    method string RarityColor(integer rarity)
        if rarity == 1 then return "#6E8CFF" end
        if rarity == 2 then return "#FFE15A" end
        if rarity == 3 then return "#C8A050" end         -- 유니크
        if rarity == 4 then return "#3CDC3C" end         -- 세트
        if rarity == 5 then return "#D8B868" end         -- 룬워드 (표시 전용)
        return "#FFFFFF"
    end

    method string StatName(string k)
        -- 이름표는 data/stats.csv → _ItemTables.StatNames. 단일 스킬 「sk_<스킬>」은 「<스킬 이름> 레벨」 (docs/design/19)
        local id = string.match(k, "^sk_([%w_]+)$")
        if id ~= nil then
            local def = _SkillData:Get(id)
            if def ~= nil then return def.name .. " 레벨" end
        end
        return self:T().StatNames[k] or k
    end

    method string DisplayName(string s)
        -- 색 태그 붙은 이름 (룬워드면 룬워드 이름, 겹치는 물건은 ×개수)
        local item = self:Parse(s)
        if self:IsStack(item.base) then return item.name .. " ×" .. tostring(item.count) end
        local name = item.name
        local rarity = item.rarity
        local rw = self:GetRuneword(item)
        if rw ~= nil then
            name = "「" .. rw.name .. "」 " .. name
            rarity = 5
        end
        if item.sockets > 0 then name = name .. " [" .. tostring(#item.runes) .. "/" .. tostring(item.sockets) .. "]" end
        return "<color=" .. self:RarityColor(rarity) .. ">" .. name .. "</color>"
    end

    method string ModsText(string mods)
        local parts = {}
        for k, v in string.gmatch(mods, "([%w_]+)=([%-%d%.]+)") do table.insert(parts, self:StatValueText(k, tonumber(v) or 0)) end
        return table.concat(parts, " ")
    end

    method string StatValueText(string key, number value)
        -- 퍼센트는 값 뒤에 두고 소수 능력치를 버리지 않는다.
        local label = self:StatName(key)
        if key == "minion" then label = "소환수 공격·생명 %" end
        local percent = string.find(label, "%", 1, true) ~= nil
        label = string.gsub(label, "%s*%%", "")
        local amount = string.format("%.2f", math.abs(value))
        amount = string.gsub(amount, "0+$", "")
        amount = string.gsub(amount, "%.$", "")
        return label .. " " .. (value < 0 and "-" or "+") .. amount .. (percent and "%" or "")
    end

    method string CompareText(string newS, string oldS)
        -- 변화한 능력치를 한 줄씩 표시한다. 작은 재생 옵션도 비교에서 누락하지 않는다.
        local a = self:GetTotalMods(newS)
        local b = {}
        if oldS ~= "" then b = self:GetTotalMods(oldS) end
        local keys = {}
        local seen = {}
        for k, _ in pairs(a) do if not seen[k] then seen[k] = true table.insert(keys, k) end end
        for k, _ in pairs(b) do if not seen[k] then seen[k] = true table.insert(keys, k) end end
        table.sort(keys)
        -- 10-27 (docs/design/37 §4): 줄마다 ▲ 얻음(초록) · ▼ 잃음(빨강), 착용품에만 있던 옵션은 「잃음」. 얻는 줄을 먼저
        local ups, downs = {}, {}
        for _, k in ipairs(keys) do
            local d = (a[k] or 0) - (b[k] or 0)
            if math.abs(d) >= 0.005 then
                if d > 0 then
                    table.insert(ups, "<color=#5AE65A>▲ " .. self:StatValueText(k, d) .. "</color>")
                else
                    table.insert(downs, "<color=#FF6464>▼ " .. self:StatValueText(k, d) .. (a[k] == nil and "  (잃음)" or "") .. "</color>")
                end
            end
        end
        local head = oldS == "" and "빈 칸에 착용하면:" or "착용 중인 것과 비교:"
        if #ups + #downs == 0 then return head .. " 변화 없음" end
        head = head .. "  " .. (#ups > 0 and ("<color=#5AE65A>▲" .. tostring(#ups) .. "</color> ") or "") .. (#downs > 0 and ("<color=#FF6464>▼" .. tostring(#downs) .. "</color>") or "")
        for _, line in ipairs(downs) do table.insert(ups, line) end
        return head .. "\n" .. table.concat(ups, "\n")
    end

    method string DescribeDetailed(string s)
        -- 인벤토리의 넓은 설명 영역은 이름·옵션·소켓을 구분해 읽게 한다.
        local item = self:Parse(s)
        if self:IsStack(item.base) then return self:DescribeStack(s) end
        local name = self:DisplayName(s)
        if self:IsRune(item.base) then
            local rune = self:GetRune(item.base)
            if rune == nil then return name end
            return name .. "\n무기에 삽입: " .. self:ModsText(rune.weapon)
                .. "\n방어구에 삽입: " .. self:ModsText(rune.armor)
                .. "\n등불에 삽입: " .. self:ModsText(rune.lamp)
        end
        -- 10-27 카드 순서 (docs/design/37 §4 · 디아4 툴팁): 이름(룬워드면 금빛 룬워드 이름 + 회색 바탕 이름) → 부위 · 등급 · 요구 레벨 → 구분선
        --   → 옵션 → ★ 고유 효과 → 소켓 줄(◆ 박힌 룬 · ○ 빈 칸) (판매가는 부르는 창이 붙인다)
        local base = self:GetBase(item.base)
        local rw = self:GetRuneword(item)
        if rw ~= nil then name = "<color=" .. self:RarityColor(5) .. ">" .. rw.name .. "</color>\n<color=#A8A090>" .. item.name .. "</color>"
        else name = "<color=" .. self:RarityColor(item.rarity) .. ">" .. item.name .. "</color>" end
        local info = {}
        local slotNames = { weapon = "무기", offhand = "등불", helm = "투구", armor = "갑옷", gloves = "장갑", boots = "신발", belt = "허리띠", amulet = "목걸이", ring = "반지" }
        if base ~= nil and slotNames[base.slot] ~= nil then table.insert(info, slotNames[base.slot]) end
        if base ~= nil and (base.grade or 0) > 0 then table.insert(info, self:GradeName(base.grade)) end   -- 베이스 등급 (docs/design/19)
        if base ~= nil and base.reqLv > 1 then table.insert(info, "요구 레벨 " .. tostring(base.reqLv)) end
        if #info > 0 then name = name .. "\n<color=#A8A090>" .. table.concat(info, " · ") .. "</color>" end
        name = name .. "\n<color=#4A4552>────────────────</color>"
        local total = self:GetTotalMods(s)
        local keys = {}
        for key, _ in pairs(total) do table.insert(keys, key) end
        table.sort(keys)
        local lines = { name }
        -- 유니크 고유 효과는 따로 금빛 줄로 (일반 옵션과 구분 — 10-10 QA)
        local special = {}
        if item.rarity == 3 then
            for _, u in ipairs(self:T().UniqueList) do
                if u.name == item.name and u.base == item.base then
                    for k in string.gmatch(u.special or "", "([%w_]+)=") do special[k] = true end
                    break
                end
            end
        end
        for _, key in ipairs(keys) do
            if not special[key] then table.insert(lines, self:StatValueText(key, total[key])) end
        end
        for _, key in ipairs(keys) do
            if special[key] then table.insert(lines, "<color=#F5C451>★ 고유 효과 · " .. self:StatValueText(key, total[key]) .. "</color>") end
        end
        if item.sockets > 0 then table.insert(lines, self:SocketRow(item)) end
        return table.concat(lines, "\n")
    end

    method string SocketRow(table item)
        -- 소켓 줄: 「소켓  ◆케일 ◆루크 ○ ○」 (박힌 룬은 금빛, 빈 칸은 회색 동그라미)
        local parts = {}
        for i = 1, item.sockets do
            local id = item.runes[i]
            if id ~= nil then
                local rune = self:GetRune(id)
                table.insert(parts, "<color=#F4E2B0>◆" .. (rune ~= nil and rune.name or id) .. "</color>")
            else
                table.insert(parts, "<color=#8A8478>○</color>")
            end
        end
        return "<color=#A8A090>소켓</color>  " .. table.concat(parts, "  ")
    end

    method string SocketDots(string s)
        -- 장비 칸 아래 작은 소켓 점: ● 찬 칸 · ○ 빈 칸 (소켓 없으면 "")
        local item = self:Parse(s)
        if item.sockets <= 0 then return "" end
        return string.rep("●", #item.runes) .. string.rep("○", item.sockets - #item.runes)
    end

    method string DescribeSet(string s, table equip)
        -- D2 세트 설명: 세트의 모든 부위(착용한 것은 초록, 없는 것은 회색)와 부위 수별 효과(활성 초록, 비활성 회색)
        local item = self:Parse(s)
        local piece = self:GetSetPiece(item)
        if piece == nil then return "" end
        local t = self:T()
        local set = t.Sets[piece.set]
        if set == nil then return "" end
        local worn = {}
        local count = 0
        for _, e in pairs(equip or {}) do
            local p = self:GetSetPiece(self:Parse(e))
            if p ~= nil and p.set == piece.set and not worn[p.base] then
                worn[p.base] = true
                count = count + 1
            end
        end
        local on, off = "#3CDC3C", "#6E6A66"
        local lines = { "<color=#3CDC3C>세트 「" .. set.name .. "」  " .. tostring(count) .. " / " .. tostring(set.pieces) .. " 착용</color>" }
        for _, baseId in ipairs(t.SetPieceOrder) do
            local p = t.SetPieces[baseId]
            if p ~= nil and p.set == piece.set then
                local mark = worn[baseId] and "● " or "○ "
                table.insert(lines, "<color=" .. (worn[baseId] and on or off) .. ">" .. mark .. p.name .. "</color>")
            end
        end
        table.insert(lines, "<color=" .. (count >= 1 and on or off) .. ">1부위: 각 장비 자체 옵션</color>")
        if set.bonus2 ~= "" then table.insert(lines, "<color=" .. (count >= 2 and on or off) .. ">2부위: " .. self:ModsText(self:ScaleMods(set.bonus2)) .. "</color>") end
        if set.bonus3 ~= "" and set.pieces > 3 then table.insert(lines, "<color=" .. (count >= 3 and on or off) .. ">3부위: " .. self:ModsText(self:ScaleMods(set.bonus3)) .. "</color>") end
        table.insert(lines, "<color=" .. (count >= set.pieces and on or off) .. ">" .. tostring(set.pieces) .. "부위(완성): " .. self:ModsText(self:ScaleMods(set.full)) .. "</color>")
        return table.concat(lines, "\n")
    end

    method string Describe(string s)
        -- 이름 · 요구 레벨 · 옵션 요약
        local item = self:Parse(s)
        if self:IsRune(item.base) then
            local r = self:GetRune(item.base)
            if r == nil then return self:DisplayName(s) end
            return self:DisplayName(s) .. "\n무기 " .. self:ModsText(r.weapon) .. " / 방어구 " .. self:ModsText(r.armor) .. " / 등불 " .. self:ModsText(r.lamp)
        end
        local base = self:GetBase(item.base)
        local parts = {}
        local total = self:GetTotalMods(s)
        local keys = {}
        for k, _ in pairs(total) do table.insert(keys, k) end
        table.sort(keys)
        -- 단점 옵션(음수)은 「-10」으로 (예전엔 「+-10」)
        for _, k in ipairs(keys) do
            local v = math.floor(total[k])
            table.insert(parts, self:StatName(k) .. (v < 0 and "" or "+") .. tostring(v))
        end
        local req = ""
        if base ~= nil and base.reqLv > 1 then req = " (Lv" .. tostring(base.reqLv) .. ")" end
        local text = self:DisplayName(s) .. req .. "  " .. table.concat(parts, " ")
        local piece = self:GetSetPiece(item)
        if piece ~= nil then
            local set = self:T().Sets[piece.set]
            if set ~= nil then
                text = text .. "\n<color=#3CDC3C>세트 「" .. set.name .. "」 " .. tostring(set.pieces) .. "부위</color>"
                if set.bonus2 ~= "" then text = text .. "  2: " .. self:ModsText(self:ScaleMods(set.bonus2)) end
                if set.bonus3 ~= "" then text = text .. "  3: " .. self:ModsText(self:ScaleMods(set.bonus3)) end
                text = text .. "  전체: " .. self:ModsText(self:ScaleMods(set.full))
            end
        end
        return text
    end

end
