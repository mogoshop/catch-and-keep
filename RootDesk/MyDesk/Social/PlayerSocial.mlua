-- 플레이어 사이의 요청 창구: 파티 초대 / 결투 신청 / 거래 요청 → 상대가 수락하면 시작.
-- 요청은 20초 뒤 만료. 결투는 같은 지역 · 마을 밖 · 레벨 차 duelMaxLevelGap 이하. 상대에게는 @TargetUserSync로 받은 요청만 보인다 (GameHUD가 수락 창을 띄움).
@Component
script PlayerSocial extends Component

    @Sync
    property integer PartyId = 0
    @Sync
    property string PartyDigest = ""          -- "userId|이름|레벨|위치;..." (PartySystem.Refresh가 2초마다)
    @TargetUserSync
    property string PendingKind = ""          -- party / duel / trade
    @TargetUserSync
    property string PendingFrom = ""          -- 요청한 사람 userId
    @TargetUserSync
    property string PendingFromName = ""
    property number PendingUntil = 0

    @ExecSpace("Server")
    method void RequestAction(string kind, string toUserId)
        -- 내가 상대에게 요청을 보낸다
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or toUserId == pc.UserId then return end
        local target = _UserService:GetUserEntityByUserId(toUserId)
        if not isvalid(target) then return end
        ---@type PlayerSocial
        local other = target:GetComponent("script.PlayerSocial")
        if other == nil then return end
        if (kind == "duel" or kind == "trade") and target.CurrentMap ~= self.Entity.CurrentMap then
            _Util:Warn("같은 지역에 있어야 한다", pc.UserId)
            return
        end
        if kind == "duel" and _GameConst:IsTown(self.Entity.CurrentMap) then
            _Util:Warn("마을에서는 결투할 수 없다", pc.UserId)
            return
        end
        if kind == "duel" and not self:DuelLevelOk(self:LevelOf(self.Entity), self:LevelOf(target)) then
            _Util:Warn("레벨 차가 " .. tostring(math.floor(_GameData.duelMaxLevelGap)) .. "보다 크면 결투할 수 없다", pc.UserId)
            return
        end
        if other.PendingKind ~= "" and _UtilLogic.ElapsedSeconds < other.PendingUntil then
            _Util:Notify("상대가 다른 요청을 처리 중이다", pc.UserId)
            return
        end
        other.PendingKind = kind
        other.PendingFrom = pc.UserId
        other.PendingFromName = _PartySystem:NameOf(self.Entity)
        other.PendingUntil = _UtilLogic.ElapsedSeconds + 20
        local names = { party = "파티 초대", duel = "결투 신청", trade = "거래 요청" }
        _Util:Notify((names[kind] or kind) .. "를 보냈다: " .. _PartySystem:NameOf(target), pc.UserId)
    end

    @ExecSpace("Server")
    method void RespondRequest(boolean accept)
        -- 받은 요청에 답한다
        local pc = self.Entity.PlayerComponent
        if senderUserId ~= pc.UserId or self.PendingKind == "" then return end
        local kind = self.PendingKind
        local fromId = self.PendingFrom
        self.PendingKind = ""
        self.PendingFrom = ""
        self.PendingFromName = ""
        if _UtilLogic.ElapsedSeconds > self.PendingUntil then return end
        local from = _UserService:GetUserEntityByUserId(fromId)
        if not isvalid(from) then return end
        if not accept then
            _Util:Notify(_PartySystem:NameOf(self.Entity) .. "님이 거절했다", fromId)
            return
        end
        if kind == "party" then
            _PartySystem:Join(fromId, pc.UserId)
        elseif kind == "duel" then
            ---@type PlayerDuel
            local da = from:GetComponent("script.PlayerDuel")
            ---@type PlayerDuel
            local db = self.Entity:GetComponent("script.PlayerDuel")
            -- 이미 결투 중인 사람은 새 결투를 받지 않는다 (10-13: 상대가 덮어써져 한쪽만 때릴 수 있는 결투가 생겼다)
            if da ~= nil and db ~= nil and (da.Opponent ~= "" or db.Opponent ~= "") then
                _Util:Notify("이미 결투 중이다", fromId)
                _Util:Notify("이미 결투 중이다", pc.UserId)
            elseif not self:DuelLevelOk(self:LevelOf(from), self:LevelOf(self.Entity)) then
                -- 신청 뒤 20초 사이에 레벨이 올라 차이가 벌어진 경우
                _Util:Warn("레벨 차가 커서 결투할 수 없다", fromId)
                _Util:Warn("레벨 차가 커서 결투할 수 없다", pc.UserId)
            elseif da ~= nil and db ~= nil and from.CurrentMap == self.Entity.CurrentMap and not _GameConst:IsTown(self.Entity.CurrentMap) then
                da:Start(pc.UserId)
                db:Start(fromId)
            end
        elseif kind == "trade" then
            ---@type PlayerTrade
            local a = from:GetComponent("script.PlayerTrade")
            ---@type PlayerTrade
            local b = self.Entity:GetComponent("script.PlayerTrade")
            if a ~= nil and b ~= nil and a.Partner == "" and b.Partner == "" then
                a:Start(pc.UserId)
                b:Start(fromId)
            end
        end
    end

    method integer LevelOf(Entity player)
        ---@type PlayerStats
        local st = isvalid(player) and player:GetComponent("script.PlayerStats") or nil
        if st == nil then return 1 end
        return st.Level
    end

    method boolean DuelLevelOk(integer a, integer b)
        -- 결투 레벨 차 제한 (서버 신청·수락 + 플레이어 창 단추가 같은 규칙)
        return math.abs(a - b) <= math.floor(_GameData.duelMaxLevelGap)
    end

    @ExecSpace("Server")
    method void RequestInspect(string targetId)
        -- 살펴보기 (10-24): 같은 채널 플레이어의 능력치·스킬·장비 요약을 요청한 사람에게만
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        local target = _UserService:GetUserEntityByUserId(targetId)
        if not isvalid(target) then
            self:ShowInspect("이 채널에 없다", "", "", senderUserId)
            return
        end
        ---@type PlayerStats
        local st = target:GetComponent("script.PlayerStats")
        ---@type PlayerInventory
        local inv = target:GetComponent("script.PlayerInventory")
        ---@type SkillBook
        local book = target:GetComponent("script.SkillBook")
        ---@type ShadowCommander
        local cmd = target:GetComponent("script.ShadowCommander")
        if st == nil then return end
        local pc = target.PlayerComponent
        local title = _PartySystem:NameOf(target) .. "  Lv" .. tostring(st.Level) .. "  " .. _GameConst:DifficultyName(st.Difficulty)
        local function stat(name, base, bonus) return string.format("%s %d", name, base + bonus) .. (bonus ~= 0 and string.format(" (+%d)", bonus) or "") end
        local lines = {
            stat("통솔", st.Str, st.BonusStr) .. "  ·  " .. stat("활력", st.Vit, st.BonusVit),
            stat("민첩", st.Dex, st.BonusDex) .. "  ·  " .. stat("정신", st.Ene, st.BonusEne),
            string.format("생명 %d  ·  마나 %d  ·  방어 %d", math.floor(pc.MaxHp), math.floor(st.MaxMana), math.floor(st:GetDefense())),
            string.format("저항  화염 %d · 냉기 %d · 번개 %d · 독 %d", st.ResFire, st.ResCold, st.ResLight, st.ResPoison),
            string.format("소환수 공격·생명 +%d%%  ·  스킬 피해 +%d%%", math.floor(st:GetMinionPct()), math.floor(st:GetSpellPowerPct())),
            string.format("공격 속도 +%d%%  ·  시전 속도 +%d%%", math.floor(st:GetIas()), math.floor(st:GetFcr())),
        }
        if cmd ~= nil then table.insert(lines, string.format("함께 다닐 수 있는 그림자 %d기", cmd:GetDeployLimit())) end
        -- 스킬: 투자한 메인 스킬을 랭크 높은 순으로
        if book ~= nil then
            local skills = {}
            for _, id in ipairs(_SkillData:Mains()) do
                local lv = book.Levels[id] or 0
                if lv > 0 then table.insert(skills, { name = _SkillData:Get(id).name, lv = lv }) end
            end
            table.sort(skills, function(a, b) return a.lv > b.lv end)
            local parts = {}
            for i, sk in ipairs(skills) do if i <= 10 then table.insert(parts, sk.name .. " " .. tostring(sk.lv)) end end
            table.insert(lines, "")
            table.insert(lines, "스킬  " .. (#parts > 0 and table.concat(parts, " · ") or "없음"))
        end
        local equip = {}
        if inv ~= nil then
            for slot in string.gmatch(inv.SlotOrder, "[^,]+") do
                local item = inv.Equip[slot]
                if item ~= nil and item ~= "" then table.insert(equip, slot .. ">" .. item) end
            end
        end
        self:ShowInspect(title, table.concat(lines, "\n"), table.concat(equip, ";"), senderUserId)
    end

    @ExecSpace("Client")
    method void ShowInspect(string title, string stats, string equipDigest)
        _SocialWindow:OnInspect(title, stats, equipDigest)
    end

    @ExecSpace("Server")
    method void RequestLeaveParty()
        if senderUserId ~= self.Entity.PlayerComponent.UserId then return end
        _PartySystem.OptOut[senderUserId] = true   -- 게임 방 자동 파티에서도 빠진 채로 둔다
        _PartySystem:Leave(senderUserId)
    end


end
