-- 채널 (10-11): MSW 월드 인스턴스 = 채널. 출시 설정의 「최대 인원」을 넘으면 엔진이 새 인스턴스를 연다.
-- 10-22 (docs/design/30 §3): 게임 방끼리는 서버에서 따로 돈다(메이커 실측) → 채널 상한 20명 (config channelMaxPlayers).
--   엔진은 새로 온 사람을 「빈자리 있는 채널 중 가장 붐비는 곳」에 넣고, 가득 찬 채널로 워프하면 월드 밖으로 튕긴다.
--   그래서 파티가 함께 들어갈 채널은 Fit으로 고르고(RoomSystem 출발), 곧 도착할 파티원·기다리는 친구 자리(RoomSystem.PendingByChannel)를
--   새로 온 사람이 차지하면 자리가 있는 다른 채널로 돌린다 (CheckOverflow).
-- 목록·워프 API는 출시 환경 전용이라 메이커에서는 「지금 채널 하나」만 보인다.
@Logic
script ChannelSystem extends Logic

    property table LastAsk = nil   -- 서버: userId → 마지막 목록 요청 시각 (연타 방지)
    property any CacheList = nil   -- 서버: 마지막 채널 목록 (InstancesCached)
    property number CacheAt = -100

    @ExecSpace("Server")
    method void RequestList()
        -- 채널 창 → 목록 (그 사람에게만). 줄 = "번호|인원|최대|id|지금"
        local uid = senderUserId
        local now = _UtilLogic.ElapsedSeconds
        if self.LastAsk == nil then self.LastAsk = {} end
        if self.LastAsk[uid] ~= nil and now - self.LastAsk[uid] < 1.5 then return end
        self.LastAsk[uid] = now
        self:RequestListFor(uid)
    end

    @ExecSpace("ServerOnly")
    method any Instances()
        -- 모든 채널 (Id 순 — 채널 번호가 자주 바뀌지 않게). 메이커·실패 = nil
        if not Environment:IsPublishedPlay() then return nil end
        local ok, success, pages = pcall(function() return _WorldInstanceService:GetWorldInstanceInfoPagesAndWait() end)
        if not ok or not success or pages == nil then return nil end
        local list = {}
        while true do
            for _, info in ipairs(pages:GetCurrentPageDatas()) do
                local cap = math.floor(_GameData.channelMaxPlayers)
                local max = info.MaxUserCount
                if cap > 0 and (max <= 0 or max > cap) then max = cap end
                table.insert(list, { id = info.Id, cur = info.CurrentUserCount, max = max })
            end
            if pages.IsLastPage or not pages:MoveToNextPageAndWait() then break end
        end
        table.sort(list, function(a, b) return a.id < b.id end)
        return list
    end

    @ExecSpace("ServerOnly")
    method any InstancesCached(number maxAge)
        -- 방 목록·대기열이 자주 묻는다: maxAge초 안에 읽은 목록이면 다시 쓴다
        local now = _UtilLogic.ElapsedSeconds
        if self.CacheList ~= nil and now - self.CacheAt <= maxAge then return self.CacheList end
        self.CacheList = self:Instances()
        self.CacheAt = now
        return self.CacheList
    end

    method any Find(any list, string id)
        if list == nil then return nil end
        for _, w in ipairs(list) do if w.id == id then return w end end
        return nil
    end

    method any Fit(any list, table pending, table need)
        -- 자리 고르기 (순수 함수 · SelfTest): need[채널 id] 또는 need["*"] 명이 더 들어갈 수 있는 채널 중 가장 붐비는 곳 (채널 수를 늘리지 않게 채워 넣는다).
        --   들어갈 수 있다 = 지금 인원 + 곧 올 자리(pending) + need ≤ 최대. 같은 붐빔이면 더 옮길 사람이 적은 곳. 없으면 nil
        if list == nil then return nil end
        local best, bestLoad, bestNeed = nil, -1, 0
        for _, w in ipairs(list) do
            local n = need[w.id]
            if n == nil then n = need["*"] end
            if n ~= nil and n >= 0 then
                local load = w.cur + (pending[w.id] or 0)
                if w.max > 0 and load + n <= w.max and (load > bestLoad or (load == bestLoad and n < bestNeed)) then
                    best, bestLoad, bestNeed = w, load, n
                end
            end
        end
        return best
    end

    @ExecSpace("Client")
    method void ShowList(string digest, boolean makerOnly)
        _ChannelWindow:OnList(digest, makerOnly)
    end

    @ExecSpace("Server")
    method void RequestMove(string instanceId)
        -- 고른 채널로: 저장 후 워프 (PlayerSave.WarpToChannel). 심도·선택 방·쓰러진 상태·꽉 찬 채널은 막는다
        local uid = senderUserId
        local player = _UserService:GetUserEntityByUserId(uid)
        if not isvalid(player) then return end
        if instanceId == "" or instanceId == _WorldInstanceService.WorldInstanceId then
            _Util:Notify("이미 이 채널에 있습니다", uid)
            return
        end
        if _RoomService:IsInstanceRoom() then
            _Util:Notify("심도·캐릭터 선택 중에는 채널을 옮길 수 없습니다 — 야영지나 사냥터에서 옮기세요", uid)
            return
        end
        local list = self:Instances()
        local target = nil
        if list ~= nil then
            for _, w in ipairs(list) do
                if w.id == instanceId then target = w end
            end
        end
        if target == nil then
            _Util:Notify("그 채널은 이제 없습니다 — 목록을 새로 불러오세요", uid)
            self:RequestListFor(uid)
            return
        end
        if target.max > 0 and target.cur >= target.max then
            _Util:Notify("그 채널은 가득 찼습니다", uid)
            return
        end
        ---@type PlayerSave
        local save = player:GetComponent("script.PlayerSave")
        if save ~= nil then save:WarpToChannel(instanceId, "") end
    end

    @ExecSpace("ServerOnly")
    method void CheckOverflow(Entity player)
        -- 접속 직후 (로비): 이 채널의 곧 올 자리(출발한 파티원 · 자리를 기다리는 친구)까지 넘쳤으면 자리가 있는 다른 채널로 돌린다 (출시 환경 전용)
        if not isvalid(player) or _RoomService:IsInstanceRoom() or not Environment:IsPublishedPlay() then return end
        local list = self:InstancesCached(2)
        if list == nil then return end
        local current = _WorldInstanceService.WorldInstanceId
        local mine = self:Find(list, current)
        local pending = _RoomSystem:PendingByChannel(_RoomSystem:ReadRooms(2).rooms)
        if mine == nil or mine.max <= 0 or mine.cur + (pending[current] or 0) <= mine.max then return end
        local need = { ["*"] = 1 }
        need[current] = -1
        local best = self:Fit(list, pending, need)
        local uid = player.PlayerComponent.UserId
        if best == nil then
            log("[VRF] channel: 자리 예약 초과 " .. tostring(mine.cur) .. "+" .. tostring(pending[current]) .. "/" .. tostring(mine.max) .. " — 옮길 채널 없음")
            return
        end
        _Util:Notify("이 채널은 곧 들어올 파티의 자리라 자리가 있는 채널로 옮깁니다", uid)
        log("[VRF] channel: 자리 예약 초과 " .. tostring(mine.cur) .. "+" .. tostring(pending[current]) .. "/" .. tostring(mine.max) .. " → " .. best.id)
        ---@type PlayerSave
        local save = player:GetComponent("script.PlayerSave")
        if save ~= nil then save:WarpToChannel(best.id, "") end
    end

    @ExecSpace("ServerOnly")
    method void RequestListFor(string uid)
        -- 서버 안에서 목록을 다시 보낼 때 (RequestList는 senderUserId를 쓴다)
        local list = self:Instances()
        if list == nil then
            self:ShowList("", true, uid)
            return
        end
        local current = _WorldInstanceService.WorldInstanceId
        local rows = {}
        for i, w in ipairs(list) do
            table.insert(rows, string.format("%d|%d|%d|%s|%s", i, w.cur, w.max, w.id, w.id == current and "1" or "0"))
        end
        self:ShowList(table.concat(rows, ";"), false, uid)
    end

end
