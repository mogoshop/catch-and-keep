-- 결투 (D2의 적대 선언을 "요청·수락"으로). 결투 중인 두 사람만 서로 공격할 수 있다 (피해 1/4). 시작 3초는 서로 맞지 않는다.
-- 진 쪽 (10-23): 일반 사망처럼 시체(장비)를 남기고 마을에서 부활, 경험치는 잃지 않고 골드 duelGoldDropPct%를 떨군다 (이긴 사람 몫 — PlayerVitals.DropDuelGold).
-- 승리 전리품 「귀」는 10-13에 없앴다. 맵이 달라지거나 마을로 가면 결투 종료.
@Component
script PlayerDuel extends Component

    @Sync
    property string Opponent = ""            -- 상대 userId
    property integer TimerId = 0
    property number StartedAt = 0             -- 서버 시각 (시작 GraceSeconds 동안은 서로 맞지 않는다)
    property number GraceSeconds = 3
    property integer TagTimer = 0             -- 클라이언트: 상대 이름표를 붉게 칠하는 주기
    property string TaggedId = ""             -- 클라이언트: 지금 붉게 칠한 상대 userId
    property Color TagRestore = Color(1, 1, 1, 1)

    method boolean IsOpponent(Entity e)
        -- 공격 판정 (서버 PlayerAttack.IsAttackTarget): 결투 상대이고 시작 유예가 지났다
        if self.Opponent == "" or not isvalid(e) or not isvalid(e.PlayerComponent) or e.PlayerComponent.UserId ~= self.Opponent then return false end
        return _UtilLogic.ElapsedSeconds >= self.StartedAt + self.GraceSeconds
    end

    method void OnBeginPlay()
        -- 클라이언트(내 캐릭터만): 결투 상대의 이름표를 붉게
        if self:IsClient() then self.TagTimer = _TimerService:SetTimerRepeat(function() self:TagTick() end, 0.5) end
    end

    method void OnEndPlay()
        -- 나가면 반복 타이머를 정리한다
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        if self.TagTimer ~= 0 then _TimerService:ClearTimer(self.TagTimer) end
        self.TagTimer = 0
    end

    @ExecSpace("ClientOnly")
    method void TagTick()
        -- 내 결투 상대 이름표 = 붉은색, 결투가 끝나면 원래 색 (10-23: 누구와 싸우는지 화면에서 알 수 없었다)
        if self.Entity ~= _UserService.LocalPlayer then return end
        if self.TaggedId ~= "" and self.TaggedId ~= self.Opponent then
            local old = _UserService:GetUserEntityByUserId(self.TaggedId)
            if isvalid(old) and isvalid(old.NameTagComponent) then old.NameTagComponent.FontColor = self.TagRestore end
            self.TaggedId = ""
        end
        if self.Opponent == "" then return end
        local foe = _UserService:GetUserEntityByUserId(self.Opponent)
        if not isvalid(foe) or not isvalid(foe.NameTagComponent) then return end
        if self.TaggedId == "" then
            self.TagRestore = foe.NameTagComponent.FontColor
            self.TaggedId = self.Opponent
        end
        foe.NameTagComponent.FontColor = Color(1, 0.35, 0.3, 1)
    end

    @ExecSpace("Server")
    method void RequestForfeit()
        -- 결투 포기 (플레이어 창 「포기」): 벌칙 없이 양쪽 결투를 끝낸다. 상대에게는 승리 알림
        if senderUserId ~= self.Entity.PlayerComponent.UserId or self.Opponent == "" then return end
        local o = _UserService:GetUserEntityByUserId(self.Opponent)
        local myName = _PartySystem:NameOf(self.Entity)
        if isvalid(o) then
            ---@type PlayerDuel
            local od = o:GetComponent("script.PlayerDuel")
            if od ~= nil and od.Opponent == self.Entity.PlayerComponent.UserId then od:End(myName .. "이(가) 결투를 포기했다 — 승리") end
        end
        self:End("결투를 포기했다")
    end

    @ExecSpace("ServerOnly")
    method void Start(string opponentUserId)
        self.Opponent = opponentUserId
        self.StartedAt = _UtilLogic.ElapsedSeconds
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Check() end, 1)
        local o = _UserService:GetUserEntityByUserId(opponentUserId)
        local name = "?"
        if isvalid(o) then name = _PartySystem:NameOf(o) end
        _Util:Banner("결투 시작: " .. name, "3초 뒤부터 서로 공격할 수 있다 · 지면 시체를 남기고 골드 " .. tostring(math.floor(_GameData.duelGoldDropPct)) .. "%를 떨군다 · 포기는 플레이어 창(P)", self.Entity.PlayerComponent.UserId)
    end

    @ExecSpace("ServerOnly")
    method void Check()
        -- 상대가 사라지거나 다른 맵이거나 마을이면 끝
        local o = _UserService:GetUserEntityByUserId(self.Opponent)
        if not isvalid(o) or o.CurrentMap ~= self.Entity.CurrentMap or _GameConst:IsTown(self.Entity.CurrentMap) then self:End("결투가 끝났다") end
    end

    @ExecSpace("ServerOnly")
    method void End(string message)
        if self.Opponent == "" then return end
        self.Opponent = ""
        if self.TimerId ~= 0 then
            _TimerService:ClearTimer(self.TimerId)
            self.TimerId = 0
        end
        if message ~= "" then _Util:Notify(message, self.Entity.PlayerComponent.UserId) end
        ---@type PlayerStats
        local stats = self.Entity:GetComponent("script.PlayerStats")
        if stats ~= nil then stats:ClearPvpEffects() end
    end

    @ExecSpace("ServerOnly")
    method void Abort(string message)
        -- 결투 상대가 아닌 원인으로 쓰러졌다: 양쪽 결투를 승패 없이 끝낸다
        local o = _UserService:GetUserEntityByUserId(self.Opponent)
        if isvalid(o) then
            ---@type PlayerDuel
            local od = o:GetComponent("script.PlayerDuel")
            if od ~= nil and od.Opponent == self.Entity.PlayerComponent.UserId then od:End(message) end
        end
        self:End(message)
    end

    @ExecSpace("ServerOnly")
    method boolean OnOwnerDied()
        -- PlayerVitals.Die가 부른다. 결투 중이었으면 결투 패배로 처리하고 true
        if self.Opponent == "" then return false end
        local winner = _UserService:GetUserEntityByUserId(self.Opponent)
        local myName = _PartySystem:NameOf(self.Entity)
        if isvalid(winner) then
            -- 승리 보상 물건은 없다 (10-13: 「귀」 드롭 제거 — 특정 게임 고유 요소라 저작권 위험)
            ---@type PlayerDuel
            local wd = winner:GetComponent("script.PlayerDuel")
            if wd ~= nil then wd:End("결투 승리! " .. myName .. "을(를) 쓰러뜨렸다") end
        end
        self:End("")
        return true
    end

end
