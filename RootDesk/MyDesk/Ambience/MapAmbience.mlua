-- 맵의 어둠 설정 (맵 루트 엔티티에 붙인다). DarkVision이 읽어 전체 조명(Global)을 정한다.
-- Ambient 0 = 완전한 어둠, 1 = 원래 밝기. 없으면 어둠 연출을 끈다.
@Component
script MapAmbience extends Component

    property string DisplayName = ""
    property number Ambient = 0.12
    property Color AmbientColor = Color(0.55, 0.6, 0.85, 1)   -- 푸르스름한 밤빛
    property number PlayerLightRadius = 3.6                    -- 플레이어 주변 밝은 범위 (월드 단위)
    property string Bgm = ""                                   -- 배경음 RUID (SoundDirector)
    property boolean Wind = true                               -- 바람 환경음
    property boolean Crows = false                             -- 가끔 까마귀 울음
    property integer Difficulty = 0                            -- 0 보통 / 1 악몽 / 2 지옥 (저항 페널티·경험치 손실)
    property number Storm = 0                                  -- 모래폭풍: 플레이어 시야 반경 감소율 (0.35 = 35% 좁아짐)
    property string Weather = ""                               -- 날씨 입자 (DarkVision): "rain" 폭풍 해안 비 + 옅은 바다 안개 · "mist" 동굴·실내 옅은 안개 · "" 없음 (10-28 액트 3 「젖은 느낌」)
    property integer LevelBonus = 0                            -- 이 맵 몬스터 레벨 가산 (difficulty.csv — 악몽 +20, 지옥 +40)
    property number StatMul = 1                                -- 이 맵 몬스터 생명·공격 배율 (maps.csv statMul — 10-12 액트 1 3번 맵부터 1.3)

end
