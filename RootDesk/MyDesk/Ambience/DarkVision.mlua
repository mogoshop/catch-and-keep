-- 디아블로식 시야: 맵 전체는 어둡게(Global 조명), 플레이어·파티원·소환수·횃불 주변만 밝힌다 (클라이언트 전용).
-- 가까운 보스는 작은 보조 조명으로 몸체와 공격 예고를 읽을 수 있게 한다. 맵 전체 밝기는 유지한다.
@Logic
script DarkVision extends Logic

    property number ScanInterval = 0.3
    property integer TimerId = 0
    property Entity CurrentMap = nil
    property integer GlobalSerial = 0
    property table Lights = {}          -- entity id → { entity, serial }
    property boolean Active = false
    property number BaseRadius = 0          -- 이 맵의 내 시야 반경 (폭풍 전)
    property number MapStorm = 0            -- 맵 모래폭풍 (MapAmbience.Storm)
    property number BossStorm = 0           -- 보스 모래폭풍 (HighPriestRite 3단계)
    property number CurseDark = 0           -- 심도 저주 「칠흑」: 시야를 이만큼 줄인다 (DepthDirector.Curse)
    property integer DustSerial = 0         -- 폭풍 모래 입자
    property number WallShade = 0.5         -- 지나갈 수 없는 벽·테두리 그림 밝기 배율 (10-10 3차 QA: 바닥·기둥·동굴 벽이 구분되지 않았다)
    property any WallBase = nil             -- 벽 그림 엔티티 id → 원래 색 (다시 들어와도 배율이 겹치지 않게)
    property any ArtZ = nil                 -- 맵 그림 엔티티 id → 원래 z (다시 들어와도 뒤로 미는 값이 겹치지 않게)
    property number ArtBack = 0.05          -- 맵 그림을 이만큼 뒤로 (z가 클수록 뒤)
    property boolean Cleared = false        -- 이 맵 액트의 최종 보스를 지금 난이도에서 쓰러뜨렸다 → 어둠이 걷힌 밝기 (docs/design/31 §7)
    property number DarkAmbient = 0         -- 이 맵의 원래 밝기
    property Color DarkColor = Color(1, 1, 1, 1)
    property number FadeFrom = 0            -- 밝아지는 중: 시작 밝기 (0이면 멈춤)
    property number FadeAt = 0              -- 밝아지기 시작한 시각
    property number FadeSeconds = 3.5
    property boolean Awake = false          -- 재의 왕이 깨어난 4장 (AshAwakening): 하늘이 더 붉고, 심장 박동처럼 밝기가 뛴다
    property number BeatPeriod = 2.6        -- 박동 한 번(초)
    -- 10-23 2차 (사용자: 빨간 하늘이 잘 안 보인다): 전체 조명은 더 짙은 핏빛 + 조금 밝게, 내 주변 빛도 붉게 물든다 (어두운 맵이라 화면 대부분이 내 주변 빛)
    property Color AwakeColor = Color(1, 0.14, 0.08, 1)
    property number AwakeAmbientAdd = 0.06  -- 깨어난 하늘 밝기 가산 (붉은빛이 보이게)
    property Color AwakePlayerLight = Color(1, 0.58, 0.46, 1)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 새 플레이 세션은 이전 맵과 조명 식별자를 재사용하지 않는다.
        self.Lights = {}
        self.CurrentMap = nil
        self.Active = false
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Tick() end, self.ScanInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 세션 종료 시 타이머와 모든 보조 조명을 함께 해제한다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        self:ClearAll()
        self.CurrentMap = nil
        self.Active = false
        _OverlayLightService:SetOverlayLightEnabled(false)
    end

    @ExecSpace("ClientOnly")
    method void ClearAll()
        -- 플레이어·횃불·보스 조명 모두 동일한 소유 목록에서 정리한다.
        for _, l in pairs(self.Lights) do _OverlayLightService:DestroyOverlayLight(l.serial) end
        self.Lights = {}
        if self.GlobalSerial ~= 0 then _OverlayLightService:DestroyOverlayLight(self.GlobalSerial) end
        self.GlobalSerial = 0
        if self.DustSerial ~= 0 then _ParticleService:RemoveParticle(self.DustSerial) end
        self.DustSerial = 0
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        -- 현재 맵의 유효한 광원만 유지한다. 보스의 사망·이탈도 다음 스캔에서 반영한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.CurrentMap then self:EnterMap(player, map) end
        if not self.Active then return end
        self:TickCleared(player, map)
        self:TickHeartbeat(map)
        -- 사라진 대상의 조명 정리
        for id, l in pairs(self.Lights) do
            if not isvalid(l.entity) or not l.entity.Enable or l.entity.CurrentMap ~= map
                or (l.boss and not self:IsNearbyBoss(l.entity, player, map, 6)) then
                _OverlayLightService:DestroyOverlayLight(l.serial)
                self.Lights[id] = nil
            end
        end
        -- 다른 플레이어(파티원): 조금 작은 빛
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users ~= nil then
            for _, u in ipairs(users) do
                if isvalid(u) and u ~= player then self:Attach(u, Color(0.95, 0.9, 0.8, 1), 0.8, 0.9, 2.8) end
            end
        end
        -- 소환수: 희미한 보랏빛
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            self:Attach(c.Entity, Color(0.6, 0.45, 1, 1), 0.55, 0.2, 1.3)
        end
        -- 횃불·화로
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.TorchLight", true)) do
            ---@type TorchLight
            local t = c
            self:Attach(c.Entity, t.LightColor, t.Intensity, t.Radius * 0.3, t.Radius)
        end
        -- 혼(추출 대상)은 은은하게 빛난다
        local myId = isvalid(player) and player.PlayerComponent.UserId or ""
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.SoulOrb", true)) do
            ---@type SoulOrb
            local orb = c
            if orb.OwnerUserId == myId then self:Attach(c.Entity, Color(0.7, 0.55, 1, 1), 0.5, 0.1, 0.9) end
        end
        -- 먼 곳의 보스를 먼저 드러내지 않는다. 제거 거리에는 여유를 둬 경계에서 깜빡이지 않게 한다.
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            if self:IsNearbyBoss(c.Entity, player, map, 5.5) then self:AttachBoss(c.Entity) end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsNearbyBoss(Entity e, Entity player, Entity map, number range)
        -- 살아 있는 같은 맵의 보스만 읽기 보조 대상이다. 일반 몬스터의 어둠 연출은 유지한다.
        if not isvalid(e) or not e.Enable or e.CurrentMap ~= map then return false end
        local monster = e:GetComponent("script.Monster")
        -- 최상위 보스와 고유 이름 보스(근위대장·처형인 등) 모두 몸체·예고를 읽을 수 있게 한다.
        return monster ~= nil and (monster.Grade >= 3 or monster.Unique) and not monster.IsDead and monster.Hp > 0
            and (_Util:Pos2(e) - _Util:Pos2(player)):Magnitude() <= range
    end

    @ExecSpace("ClientOnly")
    method void AttachBoss(Entity e)
        -- 머리와 몸통을 약한 회보라 조명으로 받친다. 전체 조명·스프라이트·피격 색상은 건드리지 않는다.
        if self.Lights[e.Id] ~= nil then return end
        local info = AttachedSpotTypeOverlayLightInfo(e, 0, Vector3(0, 1.8, 0), 0,
            Color(0.85, 0.76, 0.9, 1), 0.42, OverlayLightOverlapOperation.Additive, 0, 1.4, 3.2, 360, 360, 0.65)
        local serial = _OverlayLightService:SpawnSpotTypeOverlayLightAttached(info)
        if serial ~= 0 then self.Lights[e.Id] = { entity = e, serial = serial, boss = true } end
    end

    @ExecSpace("ClientOnly")
    method void EnterMap(Entity player, Entity map)
        -- 맵의 어둠 설정을 읽어 전체 조명 + 내 주변 빛을 만든다
        self:ClearAll()
        self.CurrentMap = map
        self:ShadeWalls(map)
        ---@type MapAmbience
        local amb = map:GetComponent("script.MapAmbience")
        if amb == nil then
            self.Active = false
            _OverlayLightService:SetOverlayLightEnabled(false)
            return
        end
        self.Active = true
        _OverlayLightService:SetOverlayLightEnabled(true)
        -- 어둠 속에서도 길·적의 윤곽은 남긴다. 먼 곳은 어둡게 두고 내 주변의 읽을 수 있는 범위를 넓힌다.
        -- 밝기는 maps.csv가 기준 (맵을 다시 빌드하지 않아도 표 값이 바로 반영된다). 표에 없으면 맵에 저장된 값
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        local base = (info ~= nil and info.ambient ~= nil and info.ambient > 0) and info.ambient or amb.Ambient
        local ambient = math.max(base, _GameData.darkMinAmbient)
        local color = amb.AmbientColor
        -- 심도는 전용 조명: 일반 맵 하한보다 어둡고 보랏빛이다 (횃불·내 주변 빛으로 길을 읽는다)
        local depth = map:GetComponent("script.DepthDirector")
        -- 이 맵 액트의 최종 보스를 쓰러뜨렸는지 먼저 본다 (붉은 하늘 여부 AwakeHere가 이 값을 쓴다)
        self.Cleared = depth == nil and self:ActCleared(player, map)
        if _GameConst:ActOfMap(map.Name) == 4 then color = Color(0.9, 0.5, 0.4, 1) end   -- 액트 4 심연의 문: 붉은 불빛 (용암·불꽃으로 길을 읽는다)
        if self:AwakeHere(map) then color = self.AwakeColor end                          -- 재의 왕이 깨어난 뒤: 핏빛 하늘 (AshAwakening)
        if depth ~= nil then
            ambient = _GameData.depthAmbient
            color = Color(0.62, 0.48, 0.9, 1)
        end
        self.DarkAmbient = ambient
        self.DarkColor = color
        self.FadeFrom = 0
        if self.Cleared then
            local lit = self:ClearedLight(1)
            ambient = lit.ambient
            color = lit.color
        end
        self.GlobalSerial = _OverlayLightService:SpawnGlobalTypeOverlayLight(GlobalTypeOverlayLightInfo(map, 0, color, ambient))
        -- 카메라를 뺀 만큼(cameraZoom) 시야도 넓혀 화면 대비 밝은 범위를 유지한다
        local r = math.max(amb.PlayerLightRadius, _GameData.darkMinLightRadius) * _GameData.visionZoomMul
        self.BaseRadius = r
        self.MapStorm = amb.Storm
        self.BossStorm = 0
        self:ApplyPlayerLight(player)
        -- 심도 방은 DepthDirector가 「심도 N층 · 저주」 안내를 따로 띄운다
        if amb.DisplayName ~= "" and depth == nil then _ScreenMessageLogic:PrivateMsg(amb.DisplayName) end
        self:RefreshDepthCurse()
        log(string.format("[VRF] DarkVision %s 밝기 %.2f 시야 %.1f 폭풍 %.2f", map.Name, ambient, r, amb.Storm))
    end

    @ExecSpace("ClientOnly")
    method void ShadeWalls(Entity map)
        -- 충돌 칸에 그린 벽(ArtWall*) · 열린 맵 바위 테두리(ArtBorder*)만 어둡게 칠해 걷는 바닥과 구분한다.
        -- 맵 그림은 서버가 바꾸지 않는 정적 엔티티라 클라이언트에서 색만 바꾼다. 원래 색을 기억해 늘 원래 색 × WallShade로 쓴다
        if self.WallBase == nil then self.WallBase = {} end
        if self.ArtZ == nil then self.ArtZ = {} end
        local n, art = 0, 0
        for _, r in ipairs(map:GetChildComponentsByTypeName("SpriteRendererComponent", true)) do
            local name = r.Entity.Name
            if string.sub(name, 1, 3) == "Art" then
                -- 10-10 QA: 액트 2 보스를 잡은 혼 구슬이 가운데 길 그림에 가려졌다. 맵 그림(바닥·길·벽·장식)은 순서 1에 길은 z −0.01로
                -- 앞쪽이라, 실행 중 생기는 혼 구슬·떨어진 물건·시체·상자(순서 0~1, z 0)가 그 밑에 깔렸다.
                -- 맵 그림 전체를 순서 0으로 내리고 z를 ArtBack만큼 뒤로 민다 (그림끼리의 앞뒤는 그대로) → 그 위의 모든 것이 맵 그림 앞에 그려진다
                local t = r.Entity.TransformComponent
                local z0 = self.ArtZ[r.Entity.Id]
                if z0 == nil then
                    z0 = t.Position.z
                    self.ArtZ[r.Entity.Id] = z0
                end
                local q = t.Position
                t.Position = Vector3(q.x, q.y, z0 + self.ArtBack)
                if r.OrderInLayer ~= 0 then r.OrderInLayer = 0 end
                art = art + 1
            end
            -- wasteland(옛 map01 · 손으로 꾸민 맵)는 바닥 전체가 길이고 막힌 곳은 다리 아래 낭떠러지뿐이라 그 장식(DecorAbyss*·DecorCliffRim*)을 어둡게 한다
            if string.sub(name, 1, 7) == "ArtWall" or string.sub(name, 1, 9) == "ArtBorder"
                or string.sub(name, 1, 10) == "DecorAbyss" or string.sub(name, 1, 14) == "DecorCliffRim" then
                local base = self.WallBase[r.Entity.Id]
                if base == nil then
                    base = r.Color
                    self.WallBase[r.Entity.Id] = base
                end
                r.Color = Color(base.r * self.WallShade, base.g * self.WallShade, base.b * self.WallShade, base.a)
                n = n + 1
            end
        end
        log(string.format("[VRF] DarkVision 벽 그림 %d개 어둡게 (%.2f) · 맵 그림 %d개 뒤로", n, self.WallShade, art))
    end

    @ExecSpace("ClientOnly")
    method void RefreshDepthCurse()
        -- 심도 저주 「칠흑」이면 내 주변 빛을 45% 줄인다. 저주가 바뀔 때만 다시 그린다
        local dark = 0
        if isvalid(self.CurrentMap) then
            local depth = self.CurrentMap:GetComponent("script.DepthDirector")
            ---@type DepthDirector
            local dd = depth
            if dd ~= nil and dd:HasCurse("dark") then dark = 0.45 end   -- 저주는 여럿일 수 있다 (10-20 중첩)
            -- 이번 주 규칙 「짙은 어둠」: 남은 빛에 한 번 더 곱한다
            dark = 1 - (1 - dark) * _WeeklyRules:MapMul(self.CurrentMap, "light")
        end
        if dark == self.CurseDark then return end
        self.CurseDark = dark
        if self.Active then self:ApplyPlayerLight(_UserService.LocalPlayer) end
    end

    @ExecSpace("ClientOnly")
    method boolean ActCleared(Entity player, Entity map)
        -- 이 맵 액트의 최종 보스를 지금 난이도에서 쓰러뜨렸다 (마을·심도 제외)
        ---@type PlayerQuest
        local quest = player:GetComponent("script.PlayerQuest")
        if quest == nil or map:GetComponent("script.DepthDirector") ~= nil then return false end
        local info = _GameData:GetMapInfo(_GameConst:BaseMapName(map.Name))
        if info == nil or info.kind == "town" then return false end
        return quest:ActBossDown(_GameConst:ActOfMap(map.Name))
    end

    @ExecSpace("ClientOnly")
    method table ClearedLight(number t)
        -- 해방된 밝기·색 (t = 0 원래 → 1 해방). 어둠이 걷혀도 밤의 기운은 조금 남긴다
        local target = math.max(self.DarkAmbient, _GameData.clearedAmbient)
        local c0 = self.DarkColor
        local c1 = Color(1, 0.97, 0.92, 1)
        local k = math.max(0, math.min(1, t))
        return { ambient = self.DarkAmbient + (target - self.DarkAmbient) * k,
            color = Color(c0.r + (c1.r - c0.r) * k, c0.g + (c1.g - c0.g) * k, c0.b + (c1.b - c0.b) * k, 1) }
    end

    @ExecSpace("ClientOnly")
    method void TickCleared(Entity player, Entity map)
        -- 이 맵에서 보스를 쓰러뜨리면(의뢰 목표 달성이 동기화되면) FadeSeconds 동안 천천히 밝아진다
        if not self.Cleared and self:ActCleared(player, map) then
            self.Cleared = true
            self.FadeFrom = 1
            self.FadeAt = _UtilLogic.ElapsedSeconds
            log("[VRF] DarkVision 어둠이 걷힌다 " .. map.Name)
        end
        if self.FadeFrom <= 0 then return end
        local t = (_UtilLogic.ElapsedSeconds - self.FadeAt) / self.FadeSeconds
        if t >= 1 then self.FadeFrom = 0 end
        local lit = self:ClearedLight(t)
        if self.GlobalSerial ~= 0 then _OverlayLightService:DestroyOverlayLight(self.GlobalSerial) end
        self.GlobalSerial = _OverlayLightService:SpawnGlobalTypeOverlayLight(GlobalTypeOverlayLightInfo(map, 0, lit.color, lit.ambient))
    end

    method boolean AwakeHere(Entity map)
        -- 붉은 하늘을 이 맵에 쓸까: 깨어남 · 4장 · 심도 아님 · 아직 재의 왕을 쓰러뜨리지 않음
        return self.Awake and isvalid(map) and _GameConst:ActOfMap(map.Name) == 4 and map:GetComponent("script.DepthDirector") == nil and not self.Cleared
    end

    @ExecSpace("ClientOnly")
    method void SetAwake(boolean on)
        -- AshAwakening이 바꾼다. 지금 맵의 전체 조명을 바로 다시 만든다 (다음 맵은 EnterMap이 Awake를 보고 고른다)
        if self.Awake == on then return end
        self.Awake = on
        local map = self.CurrentMap
        if not self.Active or not isvalid(map) or map:GetComponent("script.DepthDirector") ~= nil then return end
        local color = self.DarkColor
        if self:AwakeHere(map) then color = self.AwakeColor
        elseif _GameConst:ActOfMap(map.Name) == 4 then color = Color(0.9, 0.5, 0.4, 1) end
        self.DarkColor = color
        -- 내 주변 빛 색도 바꾼다 (재의 왕을 쓰러뜨려 밝아지는 중이어도 붉은 빛은 걷힌다)
        self:ApplyPlayerLight(_UserService.LocalPlayer)
        if self.Cleared then return end
        if self.GlobalSerial ~= 0 then _OverlayLightService:DestroyOverlayLight(self.GlobalSerial) end
        local ambient = self.DarkAmbient + (self:AwakeHere(map) and self.AwakeAmbientAdd or 0)
        self.GlobalSerial = _OverlayLightService:SpawnGlobalTypeOverlayLight(GlobalTypeOverlayLightInfo(map, 0, color, ambient))
    end

    @ExecSpace("ClientOnly")
    method void TickHeartbeat(Entity map)
        -- 깨어난 4장: 맵 전체가 심장 박동처럼 두 번씩 붉게 밝아졌다 어두워진다 (스캔 주기마다 전체 조명을 다시 만든다)
        if not self:AwakeHere(map) or self.FadeFrom > 0 then return end
        local t = (_UtilLogic.ElapsedSeconds % self.BeatPeriod) / self.BeatPeriod
        local beat = math.max(0, 1 - math.abs(t - 0.14) / 0.16) + 0.6 * math.max(0, 1 - math.abs(t - 0.42) / 0.16)
        local ambient = self.DarkAmbient + self.AwakeAmbientAdd * 0.6 + 0.13 * beat
        local c = self.AwakeColor
        local color = Color(1, math.max(0, c.g - 0.08 * beat), math.max(0, c.b - 0.06 * beat), 1)
        if self.GlobalSerial ~= 0 then _OverlayLightService:DestroyOverlayLight(self.GlobalSerial) end
        self.GlobalSerial = _OverlayLightService:SpawnGlobalTypeOverlayLight(GlobalTypeOverlayLightInfo(map, 0, color, ambient))
    end

    @ExecSpace("ClientOnly")
    method void ApplyPlayerLight(Entity player)
        -- 내 주변 빛 = 맵 시야 × (1 - 모래폭풍). 폭풍이면 모래 입자를 함께 두른다 (하한 시야 뒤에 줄인다)
        if not isvalid(player) then return end
        local old = self.Lights[player.Id]
        if old ~= nil then
            _OverlayLightService:DestroyOverlayLight(old.serial)
            self.Lights[player.Id] = nil
        end
        local storm = math.max(self.MapStorm, self.BossStorm)
        local r = self.BaseRadius * (1 - storm) * (1 - self.CurseDark)
        local tint = self:AwakeHere(self.CurrentMap) and self.AwakePlayerLight or Color(1, 0.92, 0.8, 1)
        self:Attach(player, tint, 1, r * 0.6, r)
        if storm > 0 and self.DustSerial == 0 then
            self.DustSerial = _ParticleService:PlayBasicParticleAttached(BasicParticleType.DustStorm, player, Vector3(0, 0.6, 0), 0, Vector3(4, 3, 1), true, { Color = Color(0.95, 0.8, 0.55, 0.35) })
        elseif storm <= 0 and self.DustSerial ~= 0 then
            _ParticleService:RemoveParticle(self.DustSerial)
            self.DustSerial = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void SetBossStorm(number storm)
        -- 대사제 3단계 모래폭풍: 내 시야를 좁힌다 (0 = 해제)
        if self.BossStorm == storm then return end
        self.BossStorm = storm
        local player = _UserService.LocalPlayer
        if self.Active and isvalid(player) then self:ApplyPlayerLight(player) end
        log(string.format("[VRF] DarkVision boss storm %.2f 시야 %.1f", storm, self.BaseRadius * (1 - math.max(self.MapStorm, storm))))
    end

    @ExecSpace("ClientOnly")
    method void Attach(Entity e, Color color, number intensity, number inner, number outer)
        -- 엔티티에 Spot 조명을 한 번만 붙인다
        if not isvalid(e) or not e.Enable then return end
        local id = e.Id
        if self.Lights[id] ~= nil then return end
        local info = AttachedSpotTypeOverlayLightInfo(e, 0, Vector3(0, 0.4, 0), 0, color, intensity, OverlayLightOverlapOperation.Additive, 0, inner, outer, 360, 360, 0.6)
        local serial = _OverlayLightService:SpawnSpotTypeOverlayLightAttached(info)
        if serial ~= 0 then self.Lights[id] = { entity = e, serial = serial } end
    end

end
