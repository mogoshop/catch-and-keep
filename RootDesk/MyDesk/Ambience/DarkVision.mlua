-- 디아블로식 시야: 맵 전체는 어둡게(Global 조명), 플레이어·파티원·소환수·횃불 주변만 밝힌다 (클라이언트 전용).
-- 가까운 보스는 작은 보조 조명으로 몸체와 공격 예고를 읽을 수 있게 한다. 맵 전체 밝기는 유지한다.
@Logic
script DarkVision extends Logic

    property number ScanInterval = 0.3
    property integer TimerId = 0
    property Entity CurrentMap = nil
    property integer GlobalSerial = 0
    property table Lights = {}          -- entity id → { entity, serial }
    property boolean Active = false

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- 새 플레이 세션은 이전 맵과 조명 식별자를 재사용하지 않는다.
        self.Lights = {}
        self.CurrentMap = nil
        self.Active = false
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Tick() end, self.ScanInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- 세션 종료 시 타이머와 모든 보조 조명을 함께 해제한다.
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self.TimerId = 0
        self:ClearAll()
        self.CurrentMap = nil
        self.Active = false
        _OverlayLightService:SetOverlayLightEnabled(false)
    end

    @ExecSpace("ClientOnly")
    method void ClearAll()
        -- 플레이어·횃불·보스 조명 모두 동일한 소유 목록에서 정리한다.
        for _, l in pairs(self.Lights) do _OverlayLightService:DestroyOverlayLight(l.serial) end
        self.Lights = {}
        if self.GlobalSerial ~= 0 then _OverlayLightService:DestroyOverlayLight(self.GlobalSerial) end
        self.GlobalSerial = 0
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        -- 현재 맵의 유효한 광원만 유지한다. 보스의 사망·이탈도 다음 스캔에서 반영한다.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.CurrentMap then self:EnterMap(player, map) end
        if not self.Active then return end
        -- 사라진 대상의 조명 정리
        for id, l in pairs(self.Lights) do
            if not isvalid(l.entity) or not l.entity.Enable or l.entity.CurrentMap ~= map
                or (l.boss and not self:IsNearbyBoss(l.entity, player, map, 6)) then
                _OverlayLightService:DestroyOverlayLight(l.serial)
                self.Lights[id] = nil
            end
        end
        -- 다른 플레이어(파티원): 조금 작은 빛
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users ~= nil then
            for _, u in ipairs(users) do
                if isvalid(u) and u ~= player then self:Attach(u, Color(0.95, 0.9, 0.8, 1), 0.8, 0.9, 2.8) end
            end
        end
        -- 소환수: 희미한 보랏빛
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            self:Attach(c.Entity, Color(0.6, 0.45, 1, 1), 0.55, 0.2, 1.3)
        end
        -- 횃불·화로
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.TorchLight", true)) do
            ---@type TorchLight
            local t = c
            self:Attach(c.Entity, t.LightColor, t.Intensity, t.Radius * 0.3, t.Radius)
        end
        -- 혼(추출 대상)은 은은하게 빛난다
        local myId = isvalid(player) and player.PlayerComponent.UserId or ""
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.SoulOrb", true)) do
            ---@type SoulOrb
            local orb = c
            if orb.OwnerUserId == myId then self:Attach(c.Entity, Color(0.7, 0.55, 1, 1), 0.5, 0.1, 0.9) end
        end
        -- 먼 곳의 보스를 먼저 드러내지 않는다. 제거 거리에는 여유를 둬 경계에서 깜빡이지 않게 한다.
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.Monster", true)) do
            if self:IsNearbyBoss(c.Entity, player, map, 5.5) then self:AttachBoss(c.Entity) end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean IsNearbyBoss(Entity e, Entity player, Entity map, number range)
        -- 살아 있는 같은 맵의 보스만 읽기 보조 대상이다. 일반 몬스터의 어둠 연출은 유지한다.
        if not isvalid(e) or not e.Enable or e.CurrentMap ~= map then return false end
        local monster = e:GetComponent("script.Monster")
        -- 최상위 보스와 고유 이름 보스(해골 지휘관·처형인 등) 모두 몸체·예고를 읽을 수 있게 한다.
        return monster ~= nil and (monster.Grade >= 3 or monster.Unique) and not monster.IsDead and monster.Hp > 0
            and (_Util:Pos2(e) - _Util:Pos2(player)):Magnitude() <= range
    end

    @ExecSpace("ClientOnly")
    method void AttachBoss(Entity e)
        -- 머리와 몸통을 약한 회보라 조명으로 받친다. 전체 조명·스프라이트·피격 색상은 건드리지 않는다.
        if self.Lights[e.Id] ~= nil then return end
        local info = AttachedSpotTypeOverlayLightInfo(e, 0, Vector3(0, 1.8, 0), 0,
            Color(0.85, 0.76, 0.9, 1), 0.42, OverlayLightOverlapOperation.Additive, 0, 1.4, 3.2, 360, 360, 0.65)
        local serial = _OverlayLightService:SpawnSpotTypeOverlayLightAttached(info)
        if serial ~= 0 then self.Lights[e.Id] = { entity = e, serial = serial, boss = true } end
    end

    @ExecSpace("ClientOnly")
    method void EnterMap(Entity player, Entity map)
        -- 맵의 어둠 설정을 읽어 전체 조명 + 내 주변 빛을 만든다
        self:ClearAll()
        self.CurrentMap = map
        ---@type MapAmbience
        local amb = map:GetComponent("script.MapAmbience")
        if amb == nil then
            self.Active = false
            _OverlayLightService:SetOverlayLightEnabled(false)
            return
        end
        self.Active = true
        _OverlayLightService:SetOverlayLightEnabled(true)
        -- 어둠 속에서도 길·적의 윤곽은 남긴다. 먼 곳은 어둡게 두고 내 주변의 읽을 수 있는 범위를 넓힌다.
        local ambient = math.max(amb.Ambient, _GameData.darkMinAmbient)
        self.GlobalSerial = _OverlayLightService:SpawnGlobalTypeOverlayLight(GlobalTypeOverlayLightInfo(map, 0, amb.AmbientColor, ambient))
        local r = math.max(amb.PlayerLightRadius, _GameData.darkMinLightRadius)
        self:Attach(player, Color(1, 0.92, 0.8, 1), 1, r * 0.6, r)
        if amb.DisplayName ~= "" then _ScreenMessageLogic:PrivateMsg(amb.DisplayName) end
        log(string.format("[VRF] DarkVision %s 밝기 %.2f 시야 %.1f", map.Name, ambient, r))
    end

    @ExecSpace("ClientOnly")
    method void Attach(Entity e, Color color, number intensity, number inner, number outer)
        -- 엔티티에 Spot 조명을 한 번만 붙인다
        if not isvalid(e) or not e.Enable then return end
        local id = e.Id
        if self.Lights[id] ~= nil then return end
        local info = AttachedSpotTypeOverlayLightInfo(e, 0, Vector3(0, 0.4, 0), 0, color, intensity, OverlayLightOverlapOperation.Additive, 0, inner, outer, 360, 360, 0.6)
        local serial = _OverlayLightService:SpawnSpotTypeOverlayLightAttached(info)
        if serial ~= 0 then self.Lights[id] = { entity = e, serial = serial } end
    end

end
