-- 맵별 배경음·환경음과 공용 효과음 RUID (클라이언트). 맵이 바뀌면 MapAmbience의 Bgm으로 바꾸고 이동 효과음을 낸다.
-- 바람은 반복 재생, 까마귀는 15~35초마다 한 번. 맵의 Bgm은 data/sounds.csv 키(town/field/…) 또는 RUID. 효과음 RUID는 _GameConst.
@Logic
script SoundDirector extends Logic

    property number BgmVolume = 0.55
    property number EffectsVolume = 1
    property number AmbienceVolume = 1
    property number CombatWindowAt = -99
    property integer CombatVoices = 0
    property table LastCombatSounds = {}
    property table LastEffects = {}
    property table PlayedEffects = {}
    property boolean Running = false
    property boolean WindPlaying = false
    property integer PlayedCombatCount = 0
    property integer SuppressedCombatCount = 0
    property integer CueCount = 0             -- 전투 소리 표(시전·보스·의식·앞모션)로 낸 수
    property table CueSeen = {}
    -- 시전음 크기 (없으면 0.3): 소환 계열은 조금 크게, 연타하는 골편은 작게
    property table CastVolumes = { raise_skeleton = 0.38, raise_mage = 0.38, shadow_summon = 0.38, elite_promote = 0.38, mark_weakness = 0.3, enfeeble = 0.3,
        soul_drain = 0.32, bone_offering = 0.32, bone_rite = 0.32, wraith_blink = 0.32, wraith_dash = 0.3, bone_shard = 0.18 }

    property Entity CurrentMap = nil
    property string CurrentBgm = ""
    property boolean WindOn = false
    property boolean CrowsOn = false
    property number NextCrow = 0
    property integer TimerId = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.Running = true
        self.CurrentMap = nil
        self.CurrentBgm = ""
        self.WindOn = false
        self.CrowsOn = false
        self.LastCombatSounds = {}
        self.LastEffects = {}
        self.PlayedEffects = {}
        self.WindPlaying = false
        self.PlayedCombatCount = 0
        self.SuppressedCombatCount = 0
        self.CueCount = 0
        self.CueSeen = {}
        self.CombatVoices = 0
        self.CombatWindowAt = -99
        self.TimerId = _TimerService:SetTimer(self, function() self:Tick() end, 0.5, true, 0.5)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        self.Running = false
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) self.TimerId = 0 end
        self.WindOn = false
        self:RefreshWind()
        _SoundService:StopSound(_GameConst.SfxCrow)
        self:StopEffects()
        if self.CurrentBgm ~= "" then _SoundService:StopBGM(true) end
        self.CurrentBgm = ""
        self.CrowsOn = false
        self.CurrentMap = nil
        self.LastCombatSounds = {}
        self.LastEffects = {}
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        if not self.Running then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.CurrentMap then self:EnterMap(map) end
        if self.CrowsOn and _UtilLogic.ElapsedSeconds >= self.NextCrow then
            self.NextCrow = _UtilLogic.ElapsedSeconds + 15 + _UtilLogic:RandomDouble() * 20
            if self.AmbienceVolume > 0 then _SoundService:PlaySound(_GameConst.SfxCrow, 0.35 * self.AmbienceVolume) end
        end
    end

    @ExecSpace("ClientOnly")
    method void EnterMap(Entity map)
        local first = self.CurrentMap == nil
        self.CurrentMap = map
        if not first then self:PlayEffect(_GameConst.SfxTeleport, 0.5) end
        ---@type MapAmbience
        local amb = map:GetComponent("script.MapAmbience")
        local bgm = ""
        local wind = false
        local hadCrows = self.CrowsOn
        self.CrowsOn = false
        if amb ~= nil then
            bgm = amb.Bgm
            -- 심도 보스 층은 보스 배경음 (DepthDirector.BossName)
            local depth = map:GetComponent("script.DepthDirector")
            ---@type DepthDirector
            local dd = depth
            if dd ~= nil and dd.BossName ~= "" then bgm = "abyssboss" end
            bgm = self:AwakeBgm(map, bgm)
            local keyed = _GameData:GetSound(bgm)
            if keyed ~= "" then bgm = keyed end
            wind = amb.Wind
            self.CrowsOn = amb.Crows
        end
        if hadCrows and not self.CrowsOn then _SoundService:StopSound(_GameConst.SfxCrow) end
        if bgm ~= self.CurrentBgm then
            self.CurrentBgm = bgm
            if bgm == "" then _SoundService:StopBGM(false) else _SoundService:PlayBGM(bgm, self.BgmVolume) end
        end
        if wind ~= self.WindOn then
            self.WindOn = wind
            self:RefreshWind()
        end
        self.NextCrow = _UtilLogic.ElapsedSeconds + 5
    end

    @ExecSpace("ClientOnly")
    method void PlayCombat(string ruid, Vector3 pos, number volume, integer priority)
        -- 100ms 안에 저우선 3개/전체 5개까지만 허용해 소환수 무리의 타격음이 경고를 덮지 않게 한다.
        local player = _UserService.LocalPlayer
        local gain = math.max(0, math.min(1, volume * self.EffectsVolume))
        if not isvalid(player) or ruid == "" or gain <= 0 then return end
        -- 화면 밖 먼 무리의 소리가 가까운 전투의 재생 한도를 먼저 쓰지 않게 한다.
        local listener = player.TransformComponent.WorldPosition
        local dx, dy = pos.x - listener.x, pos.y - listener.y
        if dx * dx + dy * dy > 144 then return end
        local now = _UtilLogic.ElapsedSeconds
        if now - self.CombatWindowAt >= 0.1 then self.CombatWindowAt = now self.CombatVoices = 0 end
        local key = ruid .. ":" .. tostring(priority)
        -- 타격음 방식 1·2 (B·A): 재생 한도를 넓혀 군단 연타도 더 자주 들린다 (config hitSoundMode, 10-23)
        local loud = _GameData.hitSoundMode >= 1
        local gap = priority > 0 and 0.035 or (loud and 0.05 or 0.09)
        local cap = priority > 0 and (loud and 8 or 5) or (loud and 6 or 3)
        if self.CombatVoices >= cap or now - (self.LastCombatSounds[key] or -99) < gap then
            self.SuppressedCombatCount = self.SuppressedCombatCount + 1
            return
        end
        self.LastCombatSounds[key] = now
        self.CombatVoices = self.CombatVoices + 1
        self.PlayedCombatCount = self.PlayedCombatCount + 1
        self.PlayedEffects[ruid] = true
        _SoundService:PlaySoundAtPos(ruid, pos, player, gain)
    end

    @ExecSpace("ClientOnly")
    method void PlayContact(string material, Vector3 pos, boolean heavy, boolean owned)
        -- 뼈는 짧은 접촉음, 살/영체는 충격음을 사용하며 내 강타를 소환수 연타보다 우선한다.
        self:PlayMonsterHit("", material, pos, heavy, owned)
    end

    @ExecSpace("ClientOnly")
    method void PlayMonsterHit(string sourceId, string material, Vector3 pos, boolean heavy, boolean owned)
        -- 맞은 몬스터의 소리. 방식 2(A)는 그 몬스터의 메이플 피격음(monster_sounds.csv), 아니면 재질별 공용음.
        -- 방식 1·2는 크기를 올린다 (예전 내 타격 0.45 · 소환수 0.22 — 군단전에서 거의 안 들렸다)
        local mode = _GameData.hitSoundMode
        local ruid = material == "bone" and _GameConst.SfxHit or _GameConst.SfxImpact
        if mode >= 2 and sourceId ~= "" then
            local sfx = _GameData:GetMonsterSfx(sourceId)
            if sfx ~= nil and sfx.hit ~= "" then ruid = sfx.hit end
        end
        local volume = owned and 0.45 or 0.22
        if mode >= 1 then volume = owned and 0.75 or 0.42 end
        if heavy then volume = volume + 0.12 end
        self:PlayCombat(ruid, pos, volume, owned and (heavy and 2 or 1) or 0)
    end

    @ExecSpace("ClientOnly")
    method void PlayMonsterDeath(string sourceId, Vector3 pos)
        -- 쓰러질 때: 방식 2(A)는 그 몬스터의 메이플 사망음, 아니면 공용 사망음 (방식 1·2는 더 크게)
        local mode = _GameData.hitSoundMode
        local ruid = _GameConst.SfxDeath
        if mode >= 2 and sourceId ~= "" then
            local sfx = _GameData:GetMonsterSfx(sourceId)
            if sfx ~= nil and sfx.die ~= "" then ruid = sfx.die end
        end
        self:PlayCombat(ruid, pos, mode >= 1 and 0.85 or 0.6, mode >= 1 and 1 or 0)
    end

    @ExecSpace("ClientOnly")
    method void PlayEffect(string ruid, number volume)
        -- 피격·성장·UI 안내는 몬스터 무리의 재생 한도와 분리한다. 같은 소리의 순간 중복만 막는다.
        local gain = math.max(0, math.min(1, volume * self.EffectsVolume))
        if ruid == "" or gain <= 0 then return end
        local now = _UtilLogic.ElapsedSeconds
        if now - (self.LastEffects[ruid] or -99) < 0.08 then return end
        self.LastEffects[ruid] = now
        self.PlayedEffects[ruid] = true
        _SoundService:PlaySound(ruid, gain)
    end

    @ExecSpace("ClientOnly")
    method void PlaySkillCue(string id)
        -- 성공한 시전의 소유자 안내음. 실패·예약 단계에서는 호출하지 않는다.
        -- 39 #9 ④ (10-29): 메인 스킬 29개 + 도약을 data/sounds.csv cast_<스킬 id> 한 표에서 (전투 소리 표 docs/design/39 부록 E). 비어 있으면 소리 없음
        local ruid = _GameData:GetSound("cast_" .. id)
        if ruid == "" then return end
        self:PlayEffect(ruid, self.CastVolumes[id] or 0.3)
        self:NoteCue("cast_" .. id)
    end

    @ExecSpace("ClientOnly")
    method void PlayBossCue(string kind, Entity source)
        -- 보스 패턴 예고음 (39 #9 ①): 이동 패턴 8종 · 궁극기 · 내려찍기. 같은 맵이면 거리와 상관없이 (보스방 어디서든 「소리로 피한다」) — data/sounds.csv boss_<kind>
        if not self:SameMap(source) then return end
        local ruid = _GameData:GetSound("boss_" .. kind)
        if ruid == "" then return end
        self:PlayEffect(ruid, 0.6)
        self:NoteCue("boss_" .. kind)
    end

    @ExecSpace("ClientOnly")
    method void PlayRiteCue(string kind, string stage, Entity source)
        -- 보스 의식 소리 (39 #9 ②): stage = start(시작·예고) / done(보스가 끝냄) / break(플레이어가 끊음).
        -- 의식마다 따로 있으면 rite_<kind>_<stage>, 없으면 공용 rite_<stage> (data/sounds.csv) · 같은 맵만
        if not self:SameMap(source) then return end
        local key = "rite_" .. kind .. "_" .. stage
        local ruid = _GameData:GetSound(key)
        if ruid == "" then
            key = "rite_" .. stage
            ruid = _GameData:GetSound(key)
        end
        if ruid == "" then return end
        self:PlayEffect(ruid, 0.6)
        self:NoteCue(key .. " (" .. kind .. ")")
    end

    @ExecSpace("ClientOnly")
    method void PlayMonsterWindup(string arch, Vector3 pos)
        -- 몬스터 공격 앞모션음 (39 #9 ③): 유형 8종(archetypes.csv) 단위 — data/sounds.csv windup_<유형>. 근처(12칸)만 · 무리 한도(PlayCombat) 안에서
        if arch == "" then return end
        local ruid = _GameData:GetSound("windup_" .. arch)
        if ruid == "" then return end
        self:PlayCombat(ruid, pos, 0.32, 0)
        self:NoteCue("windup_" .. arch)
    end

    @ExecSpace("ClientOnly")
    method boolean SameMap(Entity source)
        local me = _UserService.LocalPlayer
        return isvalid(me) and isvalid(source) and me.CurrentMap == source.CurrentMap
    end

    @ExecSpace("ClientOnly")
    method void NoteCue(string key)
        -- 전투 소리 키마다 처음 한 번만 [VRF] (골편 연타 같은 반복은 숫자만 센다)
        self.CueCount = self.CueCount + 1
        if self.CueSeen[key] then return end
        self.CueSeen[key] = true
        log("[VRF] combat cue " .. key .. " #" .. tostring(self.CueCount))
    end

    @ExecSpace("ClientOnly")
    method void StopEffects()
        for ruid, _ in pairs(self.PlayedEffects) do _SoundService:StopSound(ruid) end
        self.PlayedEffects = {}
    end

    method string AwakeBgm(Entity map, string bgm)
        -- 액트 4 군세 각성(오렌 다음 「재의 왕이 깨어났다」) 뒤에는 어느 맵이든 급박한 곡 하나로 (10-24 사용자) · 옥좌는 재의 왕 보스곡 그대로
        local p = _UserService.LocalPlayer
        if not isvalid(p) or not isvalid(map) then return bgm end
        if _GameConst:BaseMapName(map.Name) == "throne" then return bgm end
        if _AshAwakening:IsAwake(p, map) then return "awaken" end
        return bgm
    end

    @ExecSpace("ClientOnly")
    method void RefreshAwakeBgm()
        -- 각성 상태가 맵 안에서 바뀌면(깨어남 · 재의 왕 처치) 배경음을 다시 고른다
        if not isvalid(self.CurrentMap) then return end
        ---@type MapAmbience
        local amb = self.CurrentMap:GetComponent("script.MapAmbience")
        if amb == nil then return end
        local bgm = _GameData:GetSound(self:AwakeBgm(self.CurrentMap, amb.Bgm))
        if bgm ~= "" and bgm ~= self.CurrentBgm then
            self.CurrentBgm = bgm
            _SoundService:PlayBGM(bgm, self.BgmVolume)
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshDepthBgm()
        -- 심도 보스 정보가 맵 입장 뒤에 동기화돼도 배경음을 맞춘다 (같은 곡이면 그대로)
        if not isvalid(self.CurrentMap) then return end
        local depth = self.CurrentMap:GetComponent("script.DepthDirector")
        ---@type DepthDirector
        local dd = depth
        if dd == nil or dd.BossName == "" then return end
        local bgm = _GameData:GetSound("abyssboss")
        if bgm ~= "" and bgm ~= self.CurrentBgm then
            self.CurrentBgm = bgm
            _SoundService:PlayBGM(bgm, self.BgmVolume)
        end
    end

    @ExecSpace("ClientOnly")
    method void RefreshWind()
        if self.WindPlaying then _SoundService:StopSound(_GameConst.SfxWind) end
        self.WindPlaying = self.WindOn and self.AmbienceVolume > 0
        if self.WindPlaying then _SoundService:PlayLoopSound(_GameConst.SfxWind, 0.25 * self.AmbienceVolume) end
    end

    @ExecSpace("ClientOnly")
    method void SetVolumes(number bgm, number effects, number ambience)
        local oldBgm, oldEffects, oldAmbience = self.BgmVolume, self.EffectsVolume, self.AmbienceVolume
        self.BgmVolume = math.max(0, math.min(1, bgm))
        self.EffectsVolume = math.max(0, math.min(1, effects))
        self.AmbienceVolume = math.max(0, math.min(1, ambience))
        if oldBgm ~= self.BgmVolume then _SoundService:SetBGMVolume(self.BgmVolume) end
        if oldEffects > 0 and self.EffectsVolume == 0 then self:StopEffects() end
        if oldAmbience ~= self.AmbienceVolume then
            self:RefreshWind()
            if self.AmbienceVolume == 0 then _SoundService:StopSound(_GameConst.SfxCrow) end
        end
    end
end
