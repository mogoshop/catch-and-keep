-- 디아블로식 시야: 맵 전체는 어둡게(Global 조명), 플레이어·파티원·소환수·횃불 주변만 밝힌다 (클라이언트 전용).
-- 맵이 바뀌면 다시 만들고, 0.3초마다 새로 생긴 소환수·횃불·다른 플레이어에 조명을 붙인다.
@Logic
script DarkVision extends Logic

    property number ScanInterval = 0.3
    property integer TimerId = 0
    property Entity CurrentMap = nil
    property integer GlobalSerial = 0
    property table Lights = {}          -- entity id → { entity, serial }
    property boolean Active = false

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self.Lights = {}
        self.TimerId = _TimerService:SetTimerRepeat(function() self:Tick() end, self.ScanInterval)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.TimerId ~= 0 then _TimerService:ClearTimer(self.TimerId) end
        self:ClearAll()
    end

    @ExecSpace("ClientOnly")
    method void ClearAll()
        for _, l in pairs(self.Lights) do _OverlayLightService:DestroyOverlayLight(l.serial) end
        self.Lights = {}
        if self.GlobalSerial ~= 0 then _OverlayLightService:DestroyOverlayLight(self.GlobalSerial) end
        self.GlobalSerial = 0
    end

    @ExecSpace("ClientOnly")
    method void Tick()
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = player.CurrentMap
        if not isvalid(map) then return end
        if map ~= self.CurrentMap then self:EnterMap(player, map) end
        if not self.Active then return end
        -- 사라진 대상의 조명 정리
        for id, l in pairs(self.Lights) do
            if not isvalid(l.entity) or not l.entity.Enable or l.entity.CurrentMap ~= map then
                _OverlayLightService:DestroyOverlayLight(l.serial)
                self.Lights[id] = nil
            end
        end
        -- 다른 플레이어(파티원): 조금 작은 빛
        local users = _UserService:GetUsersByMapComponent(map.MapComponent)
        if users ~= nil then
            for _, u in ipairs(users) do
                if isvalid(u) and u ~= player then self:Attach(u, Color(0.95, 0.9, 0.8, 1), 0.8, 0.9, 2.8) end
            end
        end
        -- 소환수: 희미한 보랏빛
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.ShadowUnit", true)) do
            self:Attach(c.Entity, Color(0.6, 0.45, 1, 1), 0.55, 0.2, 1.3)
        end
        -- 횃불·화로
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.TorchLight", true)) do
            ---@type TorchLight
            local t = c
            self:Attach(c.Entity, t.LightColor, t.Intensity, t.Radius * 0.3, t.Radius)
        end
        -- 혼(추출 대상)은 은은하게 빛난다
        for _, c in ipairs(map:GetChildComponentsByTypeName("script.SoulOrb", true)) do
            self:Attach(c.Entity, Color(0.7, 0.55, 1, 1), 0.5, 0.1, 0.9)
        end
    end

    @ExecSpace("ClientOnly")
    method void EnterMap(Entity player, Entity map)
        -- 맵의 어둠 설정을 읽어 전체 조명 + 내 주변 빛을 만든다
        self:ClearAll()
        self.CurrentMap = map
        ---@type MapAmbience
        local amb = map:GetComponent("script.MapAmbience")
        if amb == nil then
            self.Active = false
            _OverlayLightService:SetOverlayLightEnabled(false)
            return
        end
        self.Active = true
        _OverlayLightService:SetOverlayLightEnabled(true)
        self.GlobalSerial = _OverlayLightService:SpawnGlobalTypeOverlayLight(GlobalTypeOverlayLightInfo(map, 0, amb.AmbientColor, amb.Ambient))
        local r = amb.PlayerLightRadius
        self:Attach(player, Color(1, 0.92, 0.8, 1), 1, r * 0.35, r)
        if amb.DisplayName ~= "" then _ScreenMessageLogic:PrivateMsg(amb.DisplayName) end
        log(string.format("[DarkVision] %s 밝기 %.2f", map.Name, amb.Ambient))
    end

    @ExecSpace("ClientOnly")
    method void Attach(Entity e, Color color, number intensity, number inner, number outer)
        -- 엔티티에 Spot 조명을 한 번만 붙인다
        if not isvalid(e) or not e.Enable then return end
        local id = e.Id
        if self.Lights[id] ~= nil then return end
        local info = AttachedSpotTypeOverlayLightInfo(e, 0, Vector3(0, 0.4, 0), 0, color, intensity, OverlayLightOverlapOperation.Additive, 0, inner, outer, 360, 360, 0.6)
        local serial = _OverlayLightService:SpawnSpotTypeOverlayLightAttached(info)
        if serial ~= 0 then self.Lights[id] = { entity = e, serial = serial } end
    end

end
