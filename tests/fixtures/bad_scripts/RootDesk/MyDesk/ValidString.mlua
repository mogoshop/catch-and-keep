-- 검사기 자가 테스트용 음성 대조 (올바른 코드, 기대 검출 0). 문자열 안의 메서드 모양을 선언으로 읽으면 오탐 (AD2-CHECKER-01)
@Logic
script ValidString extends Logic
    method string Describe()
        return "method void Example(integer value = 0)"
    end

    method string DescribeLong()
        local single = 'handler Fake(integer n = 1)'
        return [[
    method void LongExample(integer value = 0)
    property integer LongProp = 0
]]
    end
end
